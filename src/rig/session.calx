// A step of `place-creative`'s: the item given into the hotbar's first slot, which the bot holds,
// then used on the top of the block at x, y, z, with the sequence number `n`.
fn handed(name: str, item: str, x: i32, y: i32, z: i32, n: i32) -> Dig {
    return Dig { name: String(name), packets: [Dug.Give(36i16, item), on_top(x, y, z, n)] }
}

// The same, used on the side `face` of the block, hit `up` from its bottom.
fn handed_on_side(name: str, item: str, x: i32, y: i32, z: i32, face: i32, up: f32, n: i32) -> Dig {
    return Dig { name: String(name), packets: [Dug.Give(36i16, item), on_side(x, y, z, face, up, n)] }
}

// What `place-creative` does, step by step, on the place fixture, with an empty inventory: a row
// of blocks on the ground at z 3, turned as the bot looks down or ahead, the panes and walls
// joined, a chest and another joined to it; on their south faces, a trapdoor's top half, a lever
// on the piston, as a use on the dispenser would open it, and a torch that falls back to the
// floor beside a wall; a row at z 5 of stairs turned west, a
// lantern, redstone a redstone torch then powers, and leaves; a skull turned; and a row at z -3 of
// a hopper, an end rod, a lightning rod, an amethyst cluster, a shulker box, iron bars no box
// joins and a fence gate.
fn creative_places() -> List<Dig> {
    return [
        Dig { name: "observer", packets: [Dug.Turn(0.0f32, 60.0f32), Dug.Give(36i16, "observer"), on_top(-3, -61, 3, 1)] },
        handed("piston", "piston", -2, -61, 3, 2),
        Dig { name: "dispenser", packets: [Dug.Turn(0.0f32, 0.0f32), Dug.Give(36i16, "dispenser"), on_top(-1, -61, 3, 3)] },
        handed("barrel", "barrel", 0, -61, 3, 4),
        handed("glass-pane", "glass_pane", 1, -61, 3, 5),
        handed("wall", "cobblestone_wall", 2, -61, 3, 6),
        handed("chest", "chest", 3, -61, 3, 7),
        handed("chest-beside", "chest", 4, -61, 3, 8),
        handed_on_side("trapdoor", "oak_trapdoor", -3, -60, 3, 3, 0.8f32, 9),
        handed_on_side("lever", "lever", -2, -60, 3, 3, 0.5f32, 10),
        handed_on_side("torch-by-wall", "torch", 2, -60, 3, 3, 0.5f32, 11),
        Dig { name: "stairs-west", packets: [Dug.Turn(90.0f32, 0.0f32), Dug.Give(36i16, "oak_stairs"), on_top(-2, -61, 5, 12)] },
        Dig { name: "lantern", packets: [Dug.Turn(0.0f32, 0.0f32), Dug.Give(36i16, "lantern"), on_top(-1, -61, 5, 13)] },
        handed("redstone", "redstone", 0, -61, 5, 14),
        handed("redstone-torch", "redstone_torch", 1, -61, 5, 15),
        handed("leaves", "oak_leaves", 2, -61, 5, 16),
        Dig { name: "skull", packets: [Dug.Turn(30.0f32, 0.0f32), Dug.Give(36i16, "skeleton_skull"), on_top(0, -61, 4, 17)] },
        Dig { name: "hopper", packets: [Dug.Turn(0.0f32, 0.0f32), Dug.Give(36i16, "hopper"), on_top(-3, -61, -3, 18)] },
        handed("end-rod", "end_rod", -2, -61, -3, 19),
        handed("lightning-rod", "lightning_rod", -1, -61, -3, 20),
        handed("amethyst", "amethyst_cluster", 0, -61, -3, 21),
        handed("shulker-box", "shulker_box", 1, -61, -3, 22),
        handed("iron-bars", "iron_bars", 2, -61, -3, 23),
        handed("fence-gate", "oak_fence_gate", 3, -61, -3, 24),
    ]
}

// What `creative` sets, slot by slot of the inventory menu: stone into the hotbar, leggings on,
// the inventory's logs out, dirt into the crafting result, which isn't a slot it may set, two
// swords in one slot, a pickaxe with damage, bread that can't be eaten, and the offhand emptied.
fn creative_slots() -> List<(i16, List<u8>)> {
    return [
        (36i16, untrusted("stone", 5, none, [])),
        (7i16, untrusted("iron_leggings", 1, none, [])),
        (9i16, untrusted("air", 0, none, [])),
        (0i16, untrusted("dirt", 1, none, [])),
        (44i16, untrusted("diamond_sword", 2, none, [])),
        (37i16, untrusted("iron_pickaxe", 1, some(7), [])),
        (38i16, untrusted("bread", 3, none, [String("food")])),
        (45i16, untrusted("air", 0, none, [])),
    ]
}

fn main() {
    let given = args()
    if given.len() != 4 {
        panic("usage: session PORT VIEW SCENARIO OUT")
    }
    let port = u16.wrap(number(given[0]))
    let view_chunks = u64(in_view_count(i32.wrap(number(given[1]))))
    let scenario = given[2].copy()
    if scenario != "status" and scenario != "outdated" and scenario != "bad-name" and scenario != "stranger" and scenario != "join" and scenario != "watch" and scenario != "watch-late" and scenario != "creative" and scenario != "clicks" and scenario != "crafts" and scenario != "dig" and scenario != "dig-creative" and scenario != "place" and scenario != "place-creative" and scenario != "use" and scenario != "use-items" and scenario != "use-books" and scenario != "use-containers" and scenario != "items" and scenario != "items-saved" and scenario != "orbs" and scenario != "feed" and scenario != "attack" and scenario != "sweep" and scenario != "fall" and scenario != "checks" {
        panic("session: what's the scenario {scenario}?")
    }
    let net = Net.new()!
    let start = unsafe { Instant.now() }
    let conn = net.connect("127.0.0.1", port)!
    var bot = Bot { scenario: scenario, conn: conn, codec: Codec.new(), state: State.Handshake, out: Writer.new() }
    let kinds = builtin_entries(6)
    for i in 0..kinds.len() {
        if kinds[i] == String("cow") {
            bot.cow_type = i32.wrap(i)
        } else if kinds[i] == String("sheep") {
            bot.sheep_type = i32.wrap(i)
        } else if kinds[i] == String("item") {
            bot.item_type = i32.wrap(i)
        }
    }
    bot.start(net, port)
    var next_tick: u64 = TICK_NS
    var events = List<Event>()
    while not bot.done {
        let now = unsafe { Instant.now() }.nanos_since(start)
        let wait = if next_tick > now { i64.wrap((next_tick - now + MS - 1) / MS) } else { 0 }
        net.poll(wait, mut events)
        var closed = false
        for e in events {
            match e {
                Event.Received(c) => {
                    if c == bot.conn {
                        _ = bot.codec.read_from(net, c)
                    }
                },
                Event.Closed(c) => {
                    if c == bot.conn {
                        closed = true
                    }
                },
                _ => {},
            }
        }
        let after = unsafe { Instant.now() }.nanos_since(start)
        bot.handle(net, after)
        if closed and not bot.done {
            if not bot.closed {
                bot.mark(String("closed"))
            }
            bot.closed = true
            if bot.phase != Phase.Leave {
                bot.phase = Phase.Before
            }
        }
        if after >= next_tick {
            next_tick += TICK_NS
            if next_tick < after {
                next_tick = after + TICK_NS
            }
            bot.tick(net, after, view_chunks)
        }
    }
    let chunks = bot.chunks
    write(given[3], bot.out.into_bytes())!
    println("{chunks} chunks")
}
