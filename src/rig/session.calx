        ("#all summon squid 6.5 -62 6.5;summon squid 9.5 -62 9.5;summon squid 7.5 -62 9.5 \{Age:-24000\}", "squid-pool-squid"),
        ("summon squid -9.5 -60 -9.5", "squid-land"),
        ("", "squid-wait"),
        ("#hit-mob 0", "squid-hit"),
        ("#hit-mob 1", "squid-hit-glow"),
        ("", "squid-1"), ("", "squid-2"), ("", "squid-3"), ("", "squid-4"), ("", "squid-5"),
        ("", "squid-6"), ("", "squid-7"), ("", "squid-8"), ("", "squid-9"), ("", "squid-10"),
        ("", "squid-11"), ("", "squid-12"), ("", "squid-13"), ("", "squid-14"), ("", "squid-15"),
        ("", "squid-16"), ("", "squid-17"), ("", "squid-18"), ("", "squid-19"), ("", "squid-20"),
