        ("item replace entity @s weapon.mainhand with diamond_sword", "stand-use-armless"),
        ("#use-mob 1", "stand-use-no-arms"),
        ("item replace entity @s weapon.mainhand with iron_chestplate", "stand-use-chestplate"),
        ("#use-mob 2", "stand-use-disabled"),
        ("item replace entity @s weapon.mainhand with stone 5", "stand-use-stone"),
        ("#use-mob 0", "stand-use-one-stone"),
        ("item replace entity @s weapon.mainhand with name_tag[custom_name=\"Stan\"]", "stand-use-tag"),
