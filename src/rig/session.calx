// `hurt-save`'s steps (CAL-219), where `talk`'s are: at midnight, the bot, in survival mode with
// resistance V, summons a zombie two blocks south of it, which hits it till the session ends,
// its data saved with who hurt it last.
fn hurt_save_steps() -> List<(str, str)> {
    return [
