fn chorus_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "start"))
    packets.push(Dug.UseItemAt(0, 1, 110, "first"))
    packets.push(Dug.UseItemAt(0, 2, 180, "second"))
    packets.push(Dug.UseItemAt(0, 3, 240, "third"))
    packets.push(Dug.HoldAt(1, 300, "harming-held"))
    packets.push(Dug.UseItemAt(0, 4, 302, "harming"))
    packets.push(Dug.Mark(380, "settled"))
    packets.push(Dug.Leave(420))
    return [Dig { name: String(), packets: packets }]
}

// What `riptide` does on the pond fixture's world (CAL-214), in its water, by the server's clock:
