// What `duel` does on the duel fixture's world (CAL-162), at the spawn facing east with an iron
// sword, Mate two blocks east facing west, the sheep just south of it, by the server's clock: at
// 100 Mate joins; at 110 its third slot held, a stick whose attack swing is a 60 ticks' stab, and
// punches at the air at 130, 150 and 170, as the server's clock, sent each 20 ticks, has them 20
// apart: Mate sees the first and the third swing, not the second, which comes in the first's first
// half (CAL-186); at 180 its empty second slot held, and at 197, where `reset`, a punch, which
// doesn't swing, the third's stab in its first half still, but starts its attack strength again, so
// at 200, sent with it as one tick of the clock has them both, Mate's punched at the least
// strength, else at full; at 205 the sword held again, then at 220 Mate hit with it, a sweep that
// reaches the sheep; at 240 the sheep hit, a sweep that reaches Mate; at 255 sprinting started,
// then at 260 Mate hit as it sprints, a knockback attack, which stops it; then at 280 and 300 Mate
// hit till it dies, and at 340 once it's respawned, not at 320, as it's taken out of its level and
// asks to respawn, which of the two each server reads first a race; at 360 a step three tenths
// east, into Mate, respawned at the spawn, so each pushes the other (CAL-174); at 380 a walk east
// on the grass in quarters of a block, its steps heard by Mate; at 400 a step as it stays, and the
// bot leaves at 440, after Mate has.
fn duel_hits(reset: bool) -> List<Dig> {
    var packets: List<Dug> = [
        Dug.Mark(100, "mate-joins"),
        Dug.HoldAt(2, 110, "punch-air"),
        Dug.PunchAt(130, ""),
        Dug.PunchAt(150, ""),
        Dug.PunchAt(170, ""),
        Dug.HoldAt(1, 180, "punch-mate"),
    ]
    if reset {
        packets.push(Dug.PunchAt(197, ""))
    }
    for p in [
        Dug.HitPlayer(0, 200, ""),
        Dug.HoldAt(0, 205, "sword-mate"),
        Dug.HitPlayer(0, 220, ""),
        Dug.Hit(true, 0, 240, "sweep-sheep"),
        Dug.SprintAt(true, 255, "knock-mate"),
        Dug.HitPlayer(0, 260, ""),
    ] {
        packets.push(p.copy())
    }
    packets.push(Dug.HitPlayer(0, 280, "hit-to-death"))
    packets.push(Dug.HitPlayer(0, 300, ""))
    packets.push(Dug.HitPlayer(0, 340, ""))
    packets.push(Dug.MoveAt(0.8, -60.0, 0.5, true, 360, "push-mate"))
    var walk = List<(f64, f64, f64, bool)>()
    for i in 1..17 {
        walk.push((0.8 + f64(i) * 0.25, -60.0, 0.5, true))
    }
    moves_at(walk, 380, "walk-away", mut packets)
    packets.push(Dug.Mark(400, "after"))
    packets.push(Dug.Leave(440))
    return [Dig { name: String(), packets: packets }]
}

// What `duel-fire` does, `duel-thorns`' (CAL-185, CAL-186), is `duel`'s without the punch at 197,
// which there would weaken the punch at 200 so Mate died of its burning rather than the hit at 300,
// and was taken out of its level at 342 as the bot's hit there came, which of the two each server
// takes first a race (CAL-287).

// What Mate does in `duel` (CAL-162): it stands where it joined, marking the bot's steps at their
// game times, so each side's packets of a step line up, and leaves at 420.
fn duel_marks() -> List<Dig> {
    return [
        Dig { name: String(), packets: [
            Dug.Mark(110, "punch-air"),
            Dug.Mark(180, "punch-mate"),
            Dug.Mark(205, "sword-mate"),
            Dug.Mark(240, "sweep-sheep"),
            Dug.Mark(255, "knock-mate"),
            Dug.Mark(280, "hit-to-death"),
            Dug.Mark(360, "push-mate"),
            Dug.Mark(380, "walk-away"),
            Dug.Mark(400, "after"),
            Dug.Leave(420),
        ] },
    ]
}

// The commands the bot types in `talk` (CAL-165), Mate there from 100, each in a step of its
// own: `list`, with UUIDs too; `help`, and of `random`; `me`; `msg` to Mate, `tell` to it, and to
// no one there; `teammsg`; `trigger` of a trigger objective it may use, then again, which it
// then may not, of one it was never let use, of one that isn't a trigger and of one that isn't
// there; `random` of one number, of nothing and of too many; and a command it may not use, and
// `me` without its action. Before them, with a `/`, what it asks suggestions for: the commands
// that begin with `t`, `trigger`'s objectives, all and those that begin with `d`, `msg`'s
// targets, all and those that begin with `M`, and a range.
fn talk_steps() -> List<(str, str)> {
    return [
        ("/t", "suggest-commands"),
        ("/trigger ", "suggest-triggers"),
        ("/trigger d", "suggest-trigger-typed"),
        ("/msg ", "suggest-names"),
        ("/msg M", "suggest-name-typed"),
        ("/random value 1", "suggest-range"),
        ("list", "list"),
        ("list uuids", "list-uuids"),
        ("help", "help"),
        ("help random", "help-random"),
        ("me waves at  everyone", "me"),
        ("msg Mate hello there", "msg"),
        ("tell Mate hi", "tell"),
        ("msg Nobody hi", "msg-nobody"),
        ("teammsg go team", "teammsg"),
        ("trigger door", "trigger"),
        ("trigger door", "trigger-again"),
        ("trigger bell", "trigger-locked"),
        ("trigger kills", "trigger-invalid"),
        ("trigger nothing", "trigger-missing"),
        ("random value 5..5", "random-one"),
        ("random value ..", "random-nothing"),
        ("random roll -2147483648..2147483647", "random-many"),
        ("weather clear", "not-allowed"),
        ("me", "me-alone"),
    ]
}

// The commands the bot types in `select` (CAL-165), an operator, Mate there from 100, two
// blocks east of it, each in a step of its own: `say` with selectors that pick by name, team,
// game mode, distance, order, box, rotation, level, scores, tags, type and advancements, and
// `@s`; `gamemode` of Mate by a selector, `say` of those in creative mode, and `gamemode` of them
// back; `msg` by distance and to no one there; `gamemode` of no one there; `say` alone; and a
// selector that doesn't read in `say`'s message; then `tellraw` of text with selectors, scores,
// a translation, a hover's text and a separator in it, `title` of each kind, a unit there isn't,
// text that doesn't read and no one there; `weather` of each kind, two for so long and clear for
// as long as the level's random draws; `kill` of no one there, of Mate and of itself, each
// respawning in the two steps after, which do nothing; `tp` of itself to a place, relative to
// where it is, of Mate turned, of Mate to it, of both, along where it looks and turned relative,
// of Mate facing a place, its eyes, and of itself facing Mate, and seven that fail, facing no
// one, players not there, coordinates not all there, mixed, mixed where other arguments fail too,
// no one there and out of the world; `time` queries, paused and paused again, set twice to a
// time and to a marker, to one there isn't, moved on and back, resumed twice, its rate set twice
// and back, timelines asked after, the End's clock's, the wrong timeline for it and a clock there
// isn't, and a marker the End's clock hasn't; and what `time set` suggests; `give` of a diamond,
// of more than two stacks, of named stone, of a potion to both, of a red shield, and four that
// fail, an item there isn't, a sword that stacks, too many and none, what an item's ID, a
// component and what follows one suggest, and more dirt than its inventory takes, the rest
// dropped for it; `setblock` of stone, again, of stairs in its place, of a chest where there's
// air and of stone where there isn't, the chest broken, redstone wire set strictly then a
// redstone block by it, and three that fail, above the world, where nothing's loaded and a value
// stairs haven't; `fill` of a hollow box of glass, its outline in stone, its inside in dirt, all
// broken, air where there's air already and a box too big; and what a block's properties and a
// number's values suggest; `summon` of a pig, finalized, of a named creeper without AI, and four
// that fail, a player, above the world, a type there isn't and a list for NBT, of a chicken of a
// UUID, then again, which fails, and of a horse, finalized; `scoreboard`, each of its commands;
// and `data` (CAL-165): a storage got before there's one, merged into, twice, got whole, by a
// path and scaled, three gets that fail, more by a path, a number scaled that isn't one and none
// there, appended to, inserted into, at an index there isn't, prepended to with a string, merged
// into at a path and with what isn't a compound, set as it is, set where nothing was, set as text
// from another's, cut, from a compound, which fails, and cut past its end, another storage set
// from it and from nothing there, every element set, removed from where nothing matches and
// where something does, a set that fails after making a list on its way, which stays, got whole
// again, and the storages suggested; its own data by paths, scaled, a merge into it, which a
// player's data can't take, a merge that changes nothing and no one there; a chest's data, whole,
// by a path and scaled, a block with none, and a path that ends at a `[`; and `execute`: as Mate,
// as both and as no one, at Mate, positioned, positioned as Mate, rotated, rotated as Mate,
// facing a place and Mate's eyes, anchored at its eyes, aligned, over a heightmap, in the Nether,
// where nothing's loaded, and in a dimension there isn't; conditions as steps and at the end, of
// entities, scores, storage, blocks by a block, a tag, properties and NBT, areas of blocks, the
// dimension and loaded chunks, passing and failing; a command that fails after `as`, quietly,
// and before any fork, told; and `as` then `at`. Before them, with a
// `/`, what it asks suggestions for: a game mode, `gamemode`'s targets, after an `@`, after a
