}

// `spear-lunge`'s steps (CAL-214), as `spear-jab`'s, its iron spear with lunge II: each jab after
// hurts the spear, tires the bot and throws it forward, with lunge's sound.
fn spear_lunge_steps() -> List<(str, str)> {
    return [
        ("time set day", "spear-lunge-day"),
        ("gamemode survival", "spear-lunge-survival"),
        ("summon husk 0.5 -60 3.5 \{NoAI:1b,PersistenceRequired:1b\}", "spear-lunge-husk"),
        ("item replace entity @s weapon.mainhand with iron_spear[enchantments=\{lunge:2\}]", "spear-lunge-held"),
        ("#stab", "spear-lunge-first"),
        ("#stab", "spear-lunge-second"),
        ("", "spear-lunge-1"),
        ("", "spear-lunge-after"),
    ]
}

// `spear-duel`'s steps (CAL-214), where `duel`'s are: the bot, facing Mate two blocks east of it,
// holds an iron spear, is taken a block back west facing east, as a jab meets nothing within its
// least reach, turns east, as a jab goes along its head's look, which its turns move, and jabs
// Mate twice, each hurting it and knocking it back, then lets it be.
// Mate marks each step and leaves after.
fn spear_duel_steps() -> List<(str, str)> {
    return [
        ("item replace entity @s weapon.mainhand with iron_spear", "spear-duel-held"),
        ("tp @s -0.5 -60 0.5 -90 0", "spear-duel-back"),
        ("#turn -90 0", "spear-duel-turned"),
        ("#stab", "spear-duel-first"),
        ("#stab", "spear-duel-second"),
        ("", "spear-duel-1"),
        ("", "spear-duel-after"),
    ]
}

// `spear-magic`'s steps (CAL-214), as `spear-duel`'s, its iron spear with sharpness II, knockback
// I and fire aspect I: each jab hurts Mate the more, knocks it further back and sets it on fire.
fn spear_magic_steps() -> List<(str, str)> {
    return [
        ("item replace entity @s weapon.mainhand with iron_spear[enchantments=\{sharpness:2,knockback:1,fire_aspect:1\}]", "spear-magic-held"),
        ("tp @s -0.5 -60 0.5 -90 0", "spear-magic-back"),
        ("#turn -90 0", "spear-magic-turned"),
        ("#stab", "spear-magic-first"),
        ("#stab", "spear-magic-second"),
        ("", "spear-magic-1"),
        ("", "spear-magic-after"),
    ]
}

// `ravager-shield`'s steps (CAL-214), where `ravagers`' are: the bot, in survival mode, with
// resistance V, raises a shield facing south, then summons a ravager ten blocks south of it, which
// comes to it and hits it, each hit blocked, `applyItemBlocking`, and at random stunning it for
// 40 ticks, after which it roars, `Ravager.blockedByItem`, or knocking the bot hard back. It
// watches for 15 seconds.
fn ravager_shield_steps() -> List<(str, str)> {
    return [
        ("time set day", "ravager-shield-day"),
        ("gamemode survival", "ravager-shield-survival"),
        ("effect clear @s", "ravager-shield-clear"),
        ("effect give @s resistance 600 4 true", "ravager-shield-armor"),
        ("item replace entity @s weapon.mainhand with shield", "ravager-shield-held"),
        ("#throw 0 0", "ravager-shield-raised"),
        ("summon ravager 0.5 -60 10.5", "ravager-shield-south"),
        ("", "ravager-shield-1"), ("", "ravager-shield-2"), ("", "ravager-shield-3"), ("", "ravager-shield-4"), ("", "ravager-shield-5"),
        ("", "ravager-shield-6"), ("", "ravager-shield-7"), ("", "ravager-shield-8"), ("", "ravager-shield-9"), ("", "ravager-shield-10"),
        ("", "ravager-shield-11"), ("", "ravager-shield-12"), ("", "ravager-shield-13"), ("", "ravager-shield-14"),
        ("", "ravager-shield-after"),
    ]
}

// `hoppers`' steps (CAL-277): a hopper under a chest of raw iron and coal pushes into a furnace's
// side, which takes only the coal, a comparator reading it; a hopper above the furnace gives it
// raw iron through its top, and one below takes what it cooks from its bottom. Two hoppers one
// above the other fill a barrel, the second waiting as it's fed by the first; a hopper above a
// shulker box gives it stone but not a shulker box; a brewing stand takes nether wart from a
// hopper above it, into its reagent slot, but not stone, and blaze powder and a water bottle from
// one beside it. Once they've moved what they can, each block's data is read.
fn hoppers_steps() -> List<(str, str)> {
    return [
        ("setblock 1 -60 3 furnace", "hoppers-furnace"),
        ("setblock 0 -60 3 hopper[facing=east]", "hoppers-side-hopper"),
        ("setblock -1 -60 3 comparator[facing=west]", "hoppers-comparator"),
        ("setblock 0 -59 3 chest\{Items:[\{Slot:0b,id:\"minecraft:raw_iron\",count:3\},\{Slot:1b,id:\"minecraft:coal\",count:2\}]\}", "hoppers-chest"),
        ("setblock 1 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:\"minecraft:raw_iron\",count:2\}]\}", "hoppers-top-hopper"),
        ("setblock 1 -61 3 hopper[facing=east]", "hoppers-bottom-hopper"),
        ("setblock 0 -61 6 barrel", "hoppers-barrel"),
        ("setblock 0 -60 6 hopper[facing=down]", "hoppers-chain-low"),
        ("setblock 0 -59 6 hopper[facing=down]\{Items:[\{Slot:0b,id:\"minecraft:cobblestone\",count:4\}]\}", "hoppers-chain-high"),
        ("setblock 3 -60 3 shulker_box", "hoppers-shulker"),
        ("setblock 3 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:\"minecraft:shulker_box\",count:1\},\{Slot:1b,id:\"minecraft:stone\",count:2\}]\}", "hoppers-shulker-hopper"),
        ("setblock 5 -60 3 brewing_stand", "hoppers-brewing"),
        ("setblock 5 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:\"minecraft:stone\",count:1\},\{Slot:1b,id:\"minecraft:nether_wart\",count:2\}]\}", "hoppers-brewing-top"),
        ("setblock 4 -60 3 hopper[facing=east]\{Items:[\{Slot:0b,id:\"minecraft:blaze_powder\",count:1\},\{Slot:1b,id:\"minecraft:potion\",count:1,components:\{\"minecraft:potion_contents\":\{potion:\"minecraft:water\"\}\}\}]\}", "hoppers-brewing-side"),
        ("#wait 6", "hoppers-moving"),
        ("#wait 6", "hoppers-moved"),
        ("data get block 0 -60 3", "hoppers-data-side-hopper"),
        ("data get block 0 -59 3", "hoppers-data-chest"),
        ("data get block 1 -60 3", "hoppers-data-furnace"),
        ("data get block 1 -59 3", "hoppers-data-top-hopper"),
        ("data get block 1 -61 3", "hoppers-data-bottom-hopper"),
        ("data get block 0 -61 6", "hoppers-data-barrel"),
        ("data get block 0 -60 6", "hoppers-data-chain-low"),
        ("data get block 0 -59 6", "hoppers-data-chain-high"),
        ("data get block 3 -60 3", "hoppers-data-shulker"),
        ("data get block 3 -59 3", "hoppers-data-shulker-hopper"),
        ("data get block 5 -60 3", "hoppers-data-brewing"),
        ("data get block 5 -59 3", "hoppers-data-brewing-top"),
        ("data get block 4 -60 3", "hoppers-data-brewing-side"),
        ("", "hoppers-after"),
    ]
}

// `falling`'s steps (CAL-243): sand set in the air, which falls and lands; gravel over a torch,
// which can't land where the torch is and drops; concrete powder over water set in the ground,
// which hardens as it lands in it; an anvil, which lands with its sound; red sand summoned as a
// falling block, which lands; sand under a ledge of sand, the lower one taken away, so both fall
// in turn; then an anvil dropped ten blocks onto a husk, which it hurts, and one onto hay, and a
// pointed dripstone tip summoned to fall onto a husk, hurting it, and break.
fn falling_steps() -> List<(str, str)> {
    return [
        ("setblock 3 -55 3 sand", "falling-sand"),
        ("#wait 2", "falling-sand-landed"),
        ("setblock 5 -60 3 torch", "falling-torch"),
        ("setblock 5 -55 3 gravel", "falling-gravel"),
        ("#wait 2", "falling-gravel-dropped"),
        ("setblock 7 -61 3 water", "falling-pool"),
        ("setblock 7 -55 3 white_concrete_powder", "falling-powder"),
        ("#wait 2", "falling-powder-landed"),
        ("setblock 9 -55 3 anvil", "falling-anvil"),
        ("#wait 2", "falling-anvil-landed"),
        ("summon falling_block 11 -55 3 \{BlockState:\{Name:\"minecraft:red_sand\"\}\}", "falling-summoned"),
        ("#wait 2", "falling-summoned-landed"),
        ("fill 13 -60 3 13 -58 3 stone", "falling-stack-base"),
        ("fill 13 -57 3 13 -56 3 sand", "falling-stack"),
        ("setblock 13 -58 3 air", "falling-stack-freed"),
        ("#wait 3", "falling-stack-landed"),
        ("summon husk 15 -60 3 \{NoAI:1b,PersistenceRequired:1b\}", "falling-husk"),
        ("setblock 15 -50 3 anvil", "falling-anvil-high"),
        ("#wait 3", "falling-anvil-hit"),
        ("setblock 17 -61 3 hay_block", "falling-hay"),
        ("setblock 17 -50 3 anvil", "falling-anvil-hay"),
        ("#wait 3", "falling-anvil-hay-landed"),
        ("summon husk 19 -60 3 \{NoAI:1b,PersistenceRequired:1b\}", "falling-husk-under"),
        ("summon falling_block 19 -52 3 \{BlockState:\{Name:\"minecraft:pointed_dripstone\",Properties:\{thickness:\"tip\",vertical_direction:\"down\"\}\},HurtEntities:1b,FallHurtAmount:6.0f,FallHurtMax:40\}", "falling-stalactite"),
        ("#wait 3", "falling-stalactite-hit"),
        ("", "falling-after"),
    ]
}

// `growth`'s steps (CAL-380): by day, a sweet berry bush, nether wart on soul sand, cocoa on a
// jungle log, cactus on sand, a pumpkin stem and a melon stem on farmland with water by it, kelp in
// water, cave vines under stone and twisting vines on netherrack, each young, lit redstone ore,
// crimson nylium under stone, a propagule hanging from mangrove leaves, a pitcher crop on the
// farmland, a bamboo shoot, a vine on a wall, a chorus flower on end stone, a copper chest and a
// dried ghast in water, an oak sapling, open eyeblossoms and a potted one, which shut by day;
// then the random tick
// speed raised to 200 for 10 seconds, and back to 3, so each grows by random ticks as vanilla's do.
fn growth_steps() -> List<(str, str)> {
    return [
        ("time set day", "growth-day"),
        ("setblock 3 -60 3 sweet_berry_bush[age=0]", "growth-bush"),
        ("setblock 5 -61 3 soul_sand", "growth-soul-sand"),
        ("setblock 5 -60 3 nether_wart[age=0]", "growth-wart"),
        ("setblock 7 -60 3 jungle_log", "growth-log"),
        ("setblock 7 -60 4 cocoa[age=0,facing=north]", "growth-cocoa"),
        ("setblock 9 -61 3 sand", "growth-sand"),
        ("setblock 9 -60 3 cactus[age=0]", "growth-cactus"),
        ("fill 3 -61 6 6 -61 8 farmland[moisture=7]", "growth-farmland"),
        ("setblock 4 -61 9 water", "growth-water"),
        ("setblock 4 -60 7 pumpkin_stem[age=0]", "growth-pumpkin"),
        ("setblock 6 -60 7 melon_stem[age=0]", "growth-melon"),
        ("fill 10 -61 6 10 -57 6 glass", "growth-tank-west"),
        ("fill 12 -61 6 12 -57 6 glass", "growth-tank-east"),
        ("fill 11 -61 5 11 -57 5 glass", "growth-tank-north"),
        ("fill 11 -61 7 11 -57 7 glass", "growth-tank-south"),
        ("fill 11 -60 6 11 -57 6 water", "growth-tank-water"),
        ("setblock 11 -60 6 kelp[age=0]", "growth-kelp"),
        ("setblock 14 -55 3 stone", "growth-roof"),
        ("setblock 14 -56 3 cave_vines[age=0,berries=false]", "growth-cave-vines"),
        ("setblock 16 -61 3 netherrack", "growth-netherrack"),
        ("setblock 16 -60 3 twisting_vines[age=0]", "growth-twisting"),
        ("setblock 18 -60 3 redstone_ore[lit=true]", "growth-ore"),
        ("setblock 20 -61 3 crimson_nylium", "growth-nylium"),
        ("setblock 20 -60 3 stone", "growth-nylium-cover"),
        ("setblock 22 -55 3 mangrove_leaves[persistent=true]", "growth-mangrove-leaves"),
        ("setblock 22 -56 3 mangrove_propagule[hanging=true,age=0]", "growth-propagule"),
        ("setblock 5 -60 8 pitcher_crop[age=0]", "growth-pitcher"),
        ("setblock 24 -60 3 bamboo_sapling", "growth-bamboo"),
        ("fill 26 -60 4 30 -56 4 stone", "growth-wall"),
        ("setblock 28 -58 3 vine[south=true]", "growth-vine"),
        ("setblock 33 -61 3 end_stone", "growth-end-stone"),
        ("setblock 33 -60 3 chorus_flower[age=0]", "growth-chorus"),
        ("setblock 35 -60 3 copper_chest", "growth-copper-chest"),
        ("setblock 37 -60 3 dried_ghast[waterlogged=true]", "growth-dried-ghast"),
        ("setblock 39 -60 3 oak_sapling[stage=0]", "growth-sapling"),
        ("fill 41 -60 3 43 -60 4 open_eyeblossom", "growth-eyeblossoms"),
        ("setblock 45 -60 3 potted_open_eyeblossom", "growth-potted"),
        ("gamerule random_tick_speed 200", "growth-fast"),
        ("#wait 5", "growth-growing"),
        ("#wait 5", "growth-grown"),
        ("gamerule random_tick_speed 3", "growth-slow"),
        ("", "growth-after"),
    ]
}

// `dispensers`' steps (CAL-378): a dispenser of cobblestone and dirt powered by a button, which
// spits one of them out; an empty one, which fails; a dropper into a chest, which puts one in it,
// and one with nothing in front, which drops one. Once they've fired, each block's data is read.
// Then dispensers of arrows and of snowballs shoot them south, one of splash potions up, and one
// of TNT primes it, far off, where it bursts. A dispenser of glass bottles fills one from water in
// front, keeping the water bottle; one of glowstone charges an anchor to full, then fails.
fn dispensers_steps() -> List<(str, str)> {
    return [
        ("setblock 2 -60 3 dispenser[facing=east]\{Items:[\{Slot:0b,id:\"minecraft:cobblestone\",count:3\},\{Slot:4b,id:\"minecraft:dirt\",count:2\}]\}", "dispensers-full"),
        ("setblock 2 -59 3 stone_button[face=floor]", "dispensers-button"),
        ("setblock -2 -60 3 dispenser[facing=west]", "dispensers-empty"),
        ("setblock -2 -59 3 stone_button[face=floor]", "dispensers-empty-button"),
        ("setblock 2 -60 6 chest", "dispensers-chest"),
        ("setblock 1 -60 6 dropper[facing=east]\{Items:[\{Slot:2b,id:\"minecraft:raw_iron\",count:4\}]\}", "dispensers-dropper"),
        ("setblock 1 -59 6 stone_button[face=floor]", "dispensers-dropper-button"),
        ("setblock -2 -60 6 dropper[facing=north]\{Items:[\{Slot:0b,id:\"minecraft:gold_ingot\",count:1\}]\}", "dispensers-dropper-out"),
        ("setblock -2 -59 6 stone_button[face=floor]", "dispensers-dropper-out-button"),
        ("#use 2 -59 3", "dispensers-pressed"),
        ("#use -2 -59 3", "dispensers-empty-pressed"),
        ("#use 1 -59 6", "dispensers-dropper-pressed"),
        ("#use -2 -59 6", "dispensers-dropper-out-pressed"),
        ("#wait 2", "dispensers-firing"),
        ("data get block 2 -60 3", "dispensers-data-full"),
        ("data get block 2 -60 6", "dispensers-data-chest"),
        ("data get block 1 -60 6", "dispensers-data-dropper"),
        ("data get block -2 -60 6", "dispensers-data-dropper-out"),
        ("setblock 5 -60 -3 dispenser[facing=south]\{Items:[\{Slot:0b,id:\"minecraft:arrow\",count:1\}]\}", "dispensers-arrows"),
        ("setblock 5 -59 -3 stone_button[face=floor]", "dispensers-arrows-button"),
        ("setblock 7 -60 -3 dispenser[facing=south]\{Items:[\{Slot:0b,id:\"minecraft:snowball\",count:2\}]\}", "dispensers-snowballs"),
        ("setblock 7 -59 -3 stone_button[face=floor]", "dispensers-snowballs-button"),
        ("setblock 9 -60 -3 dispenser[facing=up]\{Items:[\{Slot:0b,id:\"minecraft:splash_potion\",count:1,components:\{\"minecraft:potion_contents\":\{potion:\"minecraft:swiftness\"\}\}\}]\}", "dispensers-potions"),
        ("setblock 10 -60 -3 stone_button[face=wall,facing=east]", "dispensers-potions-button"),
        ("#use 5 -59 -3", "dispensers-arrows-pressed"),
        ("#use 7 -59 -3", "dispensers-snowballs-pressed"),
        ("#use 10 -60 -3", "dispensers-potions-pressed"),
        ("#wait 2", "dispensers-arrows-firing"),
        ("#wait 2", "dispensers-arrows-flying"),
        ("setblock 12 -60 -3 water", "dispensers-water"),
        ("setblock 12 -60 -2 dispenser[facing=north]\{Items:[\{Slot:0b,id:\"minecraft:glass_bottle\",count:2\}]\}", "dispensers-bottles"),
        ("setblock 12 -59 -2 stone_button[face=floor]", "dispensers-bottles-button"),
        ("setblock 14 -60 -3 respawn_anchor[charges=3]", "dispensers-anchor"),
        ("setblock 14 -60 -2 dispenser[facing=north]\{Items:[\{Slot:0b,id:\"minecraft:glowstone\",count:2\}]\}", "dispensers-glowstone"),
        ("setblock 14 -59 -2 stone_button[face=floor]", "dispensers-glowstone-button"),
        ("#use 12 -59 -2", "dispensers-bottles-pressed"),
        ("#use 14 -59 -2", "dispensers-glowstone-pressed"),
        ("#wait 2", "dispensers-filling"),
        ("#use 14 -59 -2", "dispensers-glowstone-pressed-again"),
        ("#wait 2", "dispensers-anchor-full"),
        ("data get block 12 -60 -2", "dispensers-data-bottles"),
        ("data get block 14 -60 -2", "dispensers-data-glowstone"),
        ("setblock -14 -60 -3 dispenser[facing=west]\{Items:[\{Slot:0b,id:\"minecraft:tnt\",count:1\}]\}", "dispensers-tnt"),
        ("setblock -14 -59 -3 stone_button[face=floor]", "dispensers-tnt-button"),
        ("#use -14 -59 -3", "dispensers-tnt-pressed"),
        ("#wait 5", "dispensers-tnt-primed"),
        ("", "dispensers-after"),
    ]
}

// `crafter-into`'s steps (CAL-277): a crafter making sticks into a chest in front of it, into a
// furnace's side, its fuel, into a hopper with room for two of them, which throws the other two
// out, into a full hopper, which throws all four, and into an empty hopper that passes them on to a
// barrel. Once they've moved, each container's data is read.
fn crafter_into_steps() -> List<(str, str)> {
    return [
        ("setblock 1 -60 2 chest", "into-chest"),
        ("setblock 1 -60 5 furnace", "into-furnace"),
        ("setblock 1 -60 8 hopper[facing=east]\{Items:[\{Slot:0b,id:'minecraft:stone',count:64\},\{Slot:1b,id:'minecraft:stone',count:64\},\{Slot:2b,id:'minecraft:stone',count:64\},\{Slot:3b,id:'minecraft:stone',count:64\},\{Slot:4b,id:'minecraft:stick',count:62\}]\}", "into-partial-hopper"),
        ("setblock 1 -60 11 hopper[facing=east]\{Items:[\{Slot:0b,id:'minecraft:stone',count:64\},\{Slot:1b,id:'minecraft:stone',count:64\},\{Slot:2b,id:'minecraft:stone',count:64\},\{Slot:3b,id:'minecraft:stone',count:64\},\{Slot:4b,id:'minecraft:stone',count:64\}]\}", "into-full-hopper"),
        ("setblock 2 -60 14 barrel", "into-barrel"),
        ("setblock 1 -60 14 hopper[facing=east]", "into-empty-hopper"),
        ("setblock 0 -60 2 crafter[orientation=east_up]\{Items:[\{Slot:0b,id:'minecraft:oak_planks',count:1\},\{Slot:3b,id:'minecraft:oak_planks',count:1\}]\}", "into-crafter-chest"),
        ("setblock 0 -60 5 crafter[orientation=east_up]\{Items:[\{Slot:0b,id:'minecraft:oak_planks',count:1\},\{Slot:3b,id:'minecraft:oak_planks',count:1\}]\}", "into-crafter-furnace"),
        ("setblock 0 -60 8 crafter[orientation=east_up]\{Items:[\{Slot:0b,id:'minecraft:oak_planks',count:1\},\{Slot:3b,id:'minecraft:oak_planks',count:1\}]\}", "into-crafter-partial"),
        ("setblock 0 -60 11 crafter[orientation=east_up]\{Items:[\{Slot:0b,id:'minecraft:oak_planks',count:1\},\{Slot:3b,id:'minecraft:oak_planks',count:1\}]\}", "into-crafter-full"),
        ("setblock 0 -60 14 crafter[orientation=east_up]\{Items:[\{Slot:0b,id:'minecraft:oak_planks',count:1\},\{Slot:3b,id:'minecraft:oak_planks',count:1\}]\}", "into-crafter-empty"),
        ("setblock 0 -60 3 redstone_block", "into-power-chest"),
        ("setblock 0 -60 6 redstone_block", "into-power-furnace"),
        ("setblock 0 -60 9 redstone_block", "into-power-partial"),
        ("setblock 0 -60 12 redstone_block", "into-power-full"),
        ("setblock 0 -60 15 redstone_block", "into-power-empty"),
        ("#wait 2", "into-crafted"),
        ("#wait 6", "into-moved"),
        ("data get block 1 -60 2", "into-data-chest"),
        ("data get block 1 -60 5", "into-data-furnace"),
        ("data get block 1 -60 8", "into-data-partial"),
        ("data get block 1 -60 11", "into-data-full"),
        ("data get block 1 -60 14", "into-data-empty"),
        ("data get block 2 -60 14", "into-data-barrel"),
        ("data get block 0 -60 2", "into-data-crafter"),
        ("#wait 1", "into-settled"),
        ("", "into-after"),
    ]
}

// `composter-hoppers`' steps (CAL-277): a hopper above an empty composter feeding it wheat seeds
// past a stone it can't, one by one as the level's random says whether each adds a layer; one
// above a composter at 7 and one beside an empty one, which give it nothing; one below a full
// composter taking its bone meal, which empties it; a crafter above a composter putting in bread,
// and another putting in sticks, which it doesn't take, so they're thrown. Once they've moved what
// they can, each block's data is read.
fn composter_hoppers_steps() -> List<(str, str)> {
    return [
        ("setblock 8 -60 3 composter", "composting-composter"),
        ("setblock 8 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:'minecraft:stone',count:1\},\{Slot:1b,id:'minecraft:wheat_seeds',count:12\}]\}", "composting-feeder"),
        ("setblock 10 -60 3 composter[level=7]", "composting-ready"),
        ("setblock 10 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:'minecraft:wheat_seeds',count:2\}]\}", "composting-ready-feeder"),
        ("setblock 12 -60 3 composter", "composting-side"),
        ("setblock 11 -60 3 hopper[facing=east]\{Items:[\{Slot:0b,id:'minecraft:wheat_seeds',count:2\}]\}", "composting-side-feeder"),
        ("setblock 14 -60 3 composter[level=8]", "composting-full"),
        ("setblock 14 -61 3 hopper[facing=east]", "composting-taker"),
        ("setblock 16 -60 3 composter", "composting-bread"),
        ("setblock 16 -59 3 crafter[orientation=down_north]\{Items:[\{Slot:0b,id:'minecraft:wheat',count:1\},\{Slot:1b,id:'minecraft:wheat',count:1\},\{Slot:2b,id:'minecraft:wheat',count:1\}]\}", "composting-bread-crafter"),
        ("setblock 18 -60 3 composter", "composting-sticks"),
        ("setblock 18 -59 3 crafter[orientation=down_north]\{Items:[\{Slot:0b,id:'minecraft:oak_planks',count:1\},\{Slot:3b,id:'minecraft:oak_planks',count:1\}]\}", "composting-sticks-crafter"),
        ("setblock 16 -59 4 redstone_block", "composting-bread-powered"),
        ("setblock 18 -59 4 redstone_block", "composting-sticks-powered"),
        ("#wait 6", "composting"),
        ("#wait 6", "composting-more"),
        ("data get block 8 -59 3", "composting-data-feeder"),
        ("data get block 10 -59 3", "composting-data-ready-feeder"),
        ("data get block 11 -60 3", "composting-data-side-feeder"),
        ("data get block 14 -61 3", "composting-data-taker"),
        ("#wait 1", "composting-settled"),
        ("", "composting-after"),
    ]
}

// `pot-hoppers`' steps (CAL-277): a hopper above an empty decorated pot filling it with stone, a
// comparator reading it; one below a pot of diamonds taking them; and one above a pot holding a
// stick, which takes no stone. Once they've moved what they can, each block's data is read.
fn pot_hoppers_steps() -> List<(str, str)> {
    return [
        ("setblock 20 -60 3 decorated_pot", "pots-empty"),
        ("setblock 19 -60 3 comparator[facing=west]", "pots-comparator"),
        ("setblock 20 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:'minecraft:stone',count:3\}]\}", "pots-filler"),
        ("setblock 22 -60 3 decorated_pot\{item:\{id:'minecraft:diamond',count:2\}\}", "pots-diamonds"),
        ("setblock 22 -61 3 hopper[facing=east]", "pots-taker"),
        ("setblock 24 -60 3 decorated_pot\{item:\{id:'minecraft:stick',count:1\}\}", "pots-stick"),
        ("setblock 24 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:'minecraft:stone',count:1\}]\}", "pots-blocked"),
        ("#wait 4", "pots-moving"),
        ("data get block 20 -60 3", "pots-data-filled"),
        ("data get block 20 -59 3", "pots-data-filler"),
        ("data get block 22 -60 3", "pots-data-diamonds"),
        ("data get block 22 -61 3", "pots-data-taker"),
        ("data get block 24 -60 3", "pots-data-stick"),
        ("data get block 24 -59 3", "pots-data-blocked"),
        ("", "pots-after"),
    ]
}

// `bookshelf-hoppers`' steps (CAL-277): a hopper above an empty chiseled bookshelf filling it with
// books past a stone, a comparator reading it; one below a bookshelf taking its books; and one
// below another, with no empty slot and a full stack of books, which takes none. Once they've
// moved what they can, each block's data is read.
fn bookshelf_hoppers_steps() -> List<(str, str)> {
    return [
        ("setblock 26 -60 3 chiseled_bookshelf", "shelves-empty"),
        ("setblock 25 -60 3 comparator[facing=west]", "shelves-comparator"),
        ("setblock 26 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:'minecraft:stone',count:1\},\{Slot:1b,id:'minecraft:book',count:2\},\{Slot:2b,id:'minecraft:writable_book',count:1\}]\}", "shelves-filler"),
        ("setblock 28 -60 3 chiseled_bookshelf\{Items:[\{Slot:0b,id:'minecraft:book',count:1\},\{Slot:3b,id:'minecraft:book',count:1\}]\}", "shelves-books"),
        ("setblock 28 -61 3 hopper[facing=east]", "shelves-taker"),
        ("setblock 30 -60 3 chiseled_bookshelf\{Items:[\{Slot:1b,id:'minecraft:book',count:1\}]\}", "shelves-kept"),
        ("setblock 30 -61 3 hopper[facing=east]\{Items:[\{Slot:0b,id:'minecraft:stone',count:64\},\{Slot:1b,id:'minecraft:stone',count:64\},\{Slot:2b,id:'minecraft:stone',count:64\},\{Slot:3b,id:'minecraft:stone',count:63\},\{Slot:4b,id:'minecraft:book',count:64\}]\}", "shelves-no-room"),
        ("#wait 4", "shelves-moving"),
        ("data get block 26 -60 3", "shelves-data-filled"),
        ("data get block 26 -59 3", "shelves-data-filler"),
        ("data get block 28 -60 3", "shelves-data-books"),
        ("data get block 28 -61 3", "shelves-data-taker"),
        ("data get block 30 -60 3", "shelves-data-kept"),
        ("data get block 30 -61 3", "shelves-data-no-room"),
        ("", "shelves-after"),
    ]
}

// `shelf-hoppers`' steps (CAL-277): a hopper above an empty shelf filling its three slots with
// stone, dirt and more stone, a comparator reading it, and one below a shelf taking what's on it.
// Once they've moved what they can, each block's data is read.
fn shelf_hoppers_steps() -> List<(str, str)> {
    return [
        ("setblock 34 -60 3 oak_shelf", "racks-empty"),
        ("setblock 33 -60 3 comparator[facing=west]", "racks-comparator"),
        ("setblock 34 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:'minecraft:stone',count:2\},\{Slot:1b,id:'minecraft:dirt',count:1\},\{Slot:2b,id:'minecraft:glass',count:1\}]\}", "racks-filler"),
        ("setblock 36 -60 3 oak_shelf\{Items:[\{Slot:0b,id:'minecraft:apple',count:2\},\{Slot:2b,id:'minecraft:torch',count:1\}]\}", "racks-full"),
        ("setblock 36 -61 3 hopper[facing=east]", "racks-taker"),
        ("#wait 4", "racks-moving"),
        ("data get block 34 -60 3", "racks-data-filled"),
        ("data get block 34 -59 3", "racks-data-filler"),
        ("data get block 36 -60 3", "racks-data-emptied"),
        ("data get block 36 -61 3", "racks-data-taker"),
        ("", "racks-after"),
    ]
}

// `crafter-hoppers`' steps (CAL-277): a hopper above an empty crafter with a slot turned off
// filling it with stone one slot after another past that one; one above a crafter with a stone in
// each slot and two in the middle, which fills evenly; one below a crafter taking its sticks; and a
// crafter making sticks into a crafter in front of it, one by one. Once they've moved what they
// can, each block's data is read.
fn crafter_hoppers_steps() -> List<(str, str)> {
    return [
        ("setblock 38 -60 3 crafter\{disabled_slots:[I;1]\}", "grids-off"),
        ("setblock 38 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:'minecraft:stone',count:3\}]\}", "grids-filler"),
        ("setblock 40 -60 3 crafter\{Items:[\{Slot:0b,id:'minecraft:stone',count:1\},\{Slot:1b,id:'minecraft:stone',count:1\},\{Slot:2b,id:'minecraft:stone',count:1\},\{Slot:3b,id:'minecraft:stone',count:1\},\{Slot:4b,id:'minecraft:stone',count:2\},\{Slot:5b,id:'minecraft:stone',count:1\},\{Slot:6b,id:'minecraft:stone',count:1\},\{Slot:7b,id:'minecraft:stone',count:1\},\{Slot:8b,id:'minecraft:stone',count:1\}]\}", "grids-even"),
        ("setblock 40 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:'minecraft:stone',count:2\}]\}", "grids-even-filler"),
        ("setblock 42 -60 3 crafter\{Items:[\{Slot:0b,id:'minecraft:stick',count:2\}]\}", "grids-sticks"),
        ("setblock 42 -61 3 hopper[facing=east]", "grids-taker"),
        ("setblock 45 -60 3 crafter", "grids-into"),
        ("setblock 44 -60 3 crafter[orientation=east_up]\{Items:[\{Slot:0b,id:'minecraft:oak_planks',count:1\},\{Slot:3b,id:'minecraft:oak_planks',count:1\}]\}", "grids-maker"),
        ("setblock 44 -60 4 redstone_block", "grids-powered"),
        ("#wait 4", "grids-moving"),
        ("data get block 38 -60 3", "grids-data-off"),
        ("data get block 40 -60 3", "grids-data-even"),
        ("data get block 42 -60 3", "grids-data-sticks"),
        ("data get block 42 -61 3", "grids-data-taker"),
        ("data get block 45 -60 3", "grids-data-into"),
        ("", "grids-after"),
    ]
}

// `jukebox-hoppers`' steps (CAL-277): a hopper above an empty jukebox putting in a record past a
// stone, which plays, a comparator reading it; one below a jukebox whose song has ended taking
// its record; and one below another with no empty slot, which takes nothing. (A playing jukebox
// powers the hopper below it, which then takes nothing.) Once they've
// moved what they can, each block's data is read.
fn jukebox_hoppers_steps() -> List<(str, str)> {
    return [
        ("setblock 48 -60 3 jukebox", "discs-empty"),
        ("setblock 47 -60 3 comparator[facing=west]", "discs-comparator"),
        ("setblock 48 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:'minecraft:stone',count:1\},\{Slot:1b,id:'minecraft:music_disc_cat',count:1\},\{Slot:2b,id:'minecraft:music_disc_cat',count:1\}]\}", "discs-filler"),
        ("setblock 50 -60 3 jukebox[has_record=true]\{RecordItem:\{id:'minecraft:music_disc_13',count:1\}\}", "discs-playing"),
        ("setblock 50 -61 3 hopper[facing=east]", "discs-taker"),
        ("setblock 52 -60 3 jukebox[has_record=true]\{RecordItem:\{id:'minecraft:music_disc_13',count:1\}\}", "discs-kept"),
        ("setblock 52 -61 3 hopper[facing=east]\{Items:[\{Slot:0b,id:'minecraft:stone',count:1\},\{Slot:1b,id:'minecraft:stone',count:1\},\{Slot:2b,id:'minecraft:stone',count:1\},\{Slot:3b,id:'minecraft:stone',count:1\},\{Slot:4b,id:'minecraft:dirt',count:1\}]\}", "discs-no-room"),
        ("#wait 4", "discs-moving"),
        ("data get block 48 -60 3", "discs-data-played"),
        ("data get block 48 -59 3", "discs-data-filler"),
        ("data get block 50 -60 3", "discs-data-stopped"),
        ("data get block 50 -61 3", "discs-data-taker"),
        ("data get block 52 -60 3", "discs-data-kept"),
        ("data get block 52 -61 3", "discs-data-no-room"),
        ("", "discs-after"),
    ]
}

// `loot-hoppers`' steps (CAL-277): a hopper below a barrel whose loot is still to come, which makes
// it as the hopper first reads it, from the level's random, and takes from it; a hopper whose own
// loot is still to come pushing into a chest; and a hopper above a large chest whose halves' loot
// is still to come, which makes only the first half's where that holds something. Once they've
// moved what they can, each block's data is read.
fn loot_hoppers_steps() -> List<(str, str)> {
    return [
        ("setblock 56 -60 3 barrel\{LootTable:'minecraft:chests/simple_dungeon'\}", "unpacking-barrel"),
        ("setblock 56 -61 3 hopper[facing=east]", "unpacking-taker"),
        ("setblock 58 -60 3 chest", "unpacking-chest"),
        ("setblock 58 -59 3 hopper[facing=down]\{LootTable:'minecraft:chests/simple_dungeon'\}", "unpacking-hopper"),
        ("setblock 60 -60 3 chest[type=left,facing=north]\{LootTable:'minecraft:chests/simple_dungeon'\}", "unpacking-left"),
        ("setblock 61 -60 3 chest[type=right,facing=north]\{LootTable:'minecraft:chests/simple_dungeon'\}", "unpacking-right"),
        ("setblock 60 -59 3 hopper[facing=down]\{Items:[\{Slot:0b,id:'minecraft:stone',count:1\}]\}", "unpacking-filler"),
        ("#wait 2", "unpacking-moving"),
        ("data get block 56 -60 3", "unpacking-data-barrel"),
        ("data get block 56 -61 3", "unpacking-data-taker"),
        ("data get block 58 -60 3", "unpacking-data-chest"),
        ("data get block 58 -59 3", "unpacking-data-hopper"),
        ("data get block 60 -60 3", "unpacking-data-left"),
        ("data get block 61 -60 3", "unpacking-data-right"),
        ("data get block 60 -59 3", "unpacking-data-filler"),
        ("", "unpacking-after"),
    ]
}

// `maps`' steps (CAL-167): by day, the bot, in survival, sets water, logs and sand about it and
// uses one of two empty maps, which makes map 0 about where it stands, given it; holds that map,
// which draws what's about it, and its inventory's read; uses it on a red banner named `Home`, a
// white banner and a blue wall banner, whose markers it then shows, on the white banner again,
// whose marker it takes off, and breaks the red banner, whose marker goes as that column's drawn
// next; holds the saved maps 5, whose middle's
// 128 to the east, where it's shown at the edge, 6, 1,024 to the east, tracking without limit,
// where it's shown off its limits, and 7, the same without, where it isn't shown; and in
// creative uses an empty map facing west, which it keeps, given map 1.
fn maps_steps() -> List<(str, str)> {
    return [
        ("time set day", "maps-day"),
        ("gamemode survival", "maps-survival"),
        ("fill 3 -61 3 6 -61 6 water", "maps-water"),
        ("fill -6 -60 3 -4 -58 3 oak_log", "maps-logs"),
        ("fill -6 -61 -6 -3 -61 -3 sand", "maps-sand"),
        ("item replace entity @s weapon.mainhand with map 2", "maps-held"),
        ("#throw 0 0", "maps-used"),
        ("", "maps-used-after"),
        ("item replace entity @s weapon.mainhand with filled_map[map_id=0]", "maps-filled-held"),
        ("#wait 4", "maps-drawing"),
        ("data get entity @s Inventory", "maps-inventory"),
        ("setblock 2 -60 -2 red_banner\{CustomName:\{text:\"Home\",color:\"gold\"\}\}", "maps-banner-named"),
        ("setblock -2 -60 -2 white_banner", "maps-banner-white"),
        ("setblock 2 -60 2 blue_wall_banner[facing=north]", "maps-banner-wall"),
        ("#use 2 -60 -2", "maps-banner-named-on"),
        ("#use -2 -60 -2", "maps-banner-white-on"),
        ("#use 2 -60 2", "maps-banner-wall-on"),
        ("", "maps-banners-shown"),
        ("#use -2 -60 -2", "maps-banner-white-off"),
        ("setblock 2 -60 -2 air", "maps-banner-named-broken"),
        ("#wait 2", "maps-banner-named-gone"),
        ("item replace entity @s weapon.mainhand with filled_map[map_id=5]", "maps-edge-held"),
        ("", "maps-edge"),
        ("item replace entity @s weapon.mainhand with filled_map[map_id=6]", "maps-limits-held"),
        ("", "maps-limits"),
        ("item replace entity @s weapon.mainhand with filled_map[map_id=7]", "maps-gone-held"),
        ("", "maps-gone"),
        ("gamemode creative", "maps-creative"),
        ("item replace entity @s weapon.mainhand with map", "maps-creative-held"),
        ("#throw 90 0", "maps-creative-used"),
        ("", "maps-creative-after"),
        ("data get entity @s Inventory", "maps-creative-inventory"),
        ("", "maps-after"),
    ]
}

// `cartography`'s steps (CAL-338): the bot, in survival, uses an empty map, which makes map 0, and
// holds four of it; a cartography table's menu opened, `INTERACT_WITH_CARTOGRAPHY_TABLE`; the maps
// and paper shift-clicked in, which shows the map scaled; that taken by hand, made map 1 a scale
// up, the next shown at once, and put down; the next shift-clicked out, map 2, the paper used up;
// a glass pane shift-clicked in, which shows the map locked, thrown out, map 3, a locked copy;
// the pane shifted out and empty maps in, which shows two of the map, taken and put down;
// dirt shifted to the hotbar; then the menu closed, its map and empty maps given back,
// and the inventory read.
fn cartography_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "carto-survival"),
        ("item replace entity @s weapon.mainhand with map", "carto-empty"),
        ("#throw 0 0", "carto-made"),
        ("item replace entity @s hotbar.0 with filled_map[map_id=0] 4", "carto-maps"),
        ("item replace entity @s hotbar.1 with paper 2", "carto-paper"),
        ("item replace entity @s hotbar.2 with glass_pane 2", "carto-panes"),
        ("item replace entity @s hotbar.3 with map 2", "carto-empties"),
        ("item replace entity @s hotbar.4 with dirt", "carto-dirt"),
        ("setblock 0 -60 2 cartography_table", "carto-placed"),
        ("#use 0 -60 2", "carto-open"),
        ("#click 30 0 1", "carto-maps-in"),
        ("#click 31 0 1", "carto-paper-in"),
        ("#click 2 0 0", "carto-scaled-up"),
        ("#click 20 0 0", "carto-scaled-down"),
        ("#click 2 0 1", "carto-scaled-shifted"),
        ("#click 32 0 1", "carto-pane-in"),
        ("#click 2 0 4", "carto-locked-thrown"),
        ("#click 1 0 1", "carto-pane-out"),
        ("#click 33 0 1", "carto-empties-in"),
        ("#click 2 0 0", "carto-clones-up"),
        ("#click 21 0 0", "carto-clones-down"),
        ("#click 34 0 1", "carto-dirt-moved"),
        ("#close", "carto-closed"),
        ("data get entity @s Inventory", "carto-inventory"),
        ("setblock 0 -60 2 air", "carto-broken"),
        ("", "carto-after"),
    ]
}

// `clear`'s steps (CAL-255): the bot is given sticks in the hotbar, the off hand and the crafting
// grid, dirt, a helmet, a worn sword, an enchanted pickaxe and a stick with custom data. Then
// `clear` counts sticks, clears two, then by a tag, a count, damage, enchantments, custom data,
// alternatives and a negation, fails where nothing matches; `execute if items`, `unless items`
// and `if slots` count what the slots hold; fails to read an unknown item, tag,
// component and predicate, a value that doesn't read and an unclosed test, then clears the rest,
// and fails again with nothing left.
fn clear_steps() -> List<(str, str)> {
    return [
        ("item replace entity @s hotbar.0 with stick 5", "clear-sticks"),
        ("item replace entity @s weapon.offhand with stick 3", "clear-offhand"),
        ("item replace entity @s player.crafting.0 with stick 2", "clear-grid"),
        ("give @s dirt 70", "clear-dirt"),
        ("item replace entity @s armor.head with diamond_helmet", "clear-helmet"),
        ("item replace entity @s hotbar.2 with iron_sword[damage=5]", "clear-sword"),
        ("item replace entity @s hotbar.3 with diamond_pickaxe[enchantments=\{efficiency:3\}]", "clear-pickaxe"),
        ("item replace entity @s hotbar.4 with stick[custom_data=\{a:1,b:2\}]", "clear-data"),
        ("clear @s stick 0", "clear-count"),
        ("clear @s stick 2", "clear-two"),
        ("clear @s minecraft:stick[!custom_data] 0", "clear-plain"),
        ("clear @s #minecraft:dirt 10", "clear-tag"),
        ("clear @s *[count=\{min:5,max:10\}]", "clear-range"),
        ("clear @s iron_sword[damage=4]", "clear-wrong-damage"),
        ("clear @s *[damage~\{damage:\{min:4\}\}]", "clear-damage"),
        ("clear @s *[enchantments~[\{enchantments:\"minecraft:efficiency\",levels:\{min:2\}\}]]", "clear-enchanted"),
        ("clear @s *[custom_data~\{a:1\}]", "clear-custom"),
        ("clear @s diamond_helmet|dirt", "clear-not-alternatives"),
        ("clear @s *[minecraft:max_damage|count=54]", "clear-alternatives"),
        ("execute if items entity @s hotbar.* stick", "clear-if-sticks"),
        ("execute if items entity @s weapon.offhand dirt", "clear-if-fails"),
        ("execute unless items entity @s armor.head *", "clear-unless-head"),
        ("execute unless items entity @s weapon.offhand stick", "clear-unless-fails"),
        ("execute if slots entity @s hotbar.*", "clear-if-slots"),
        ("execute if items entity @s player.crafting.* stick[count=2]", "clear-if-grid"),
        ("clear @s nothing_at_all", "clear-unknown-item"),
        ("clear @s #minecraft:nothing_at_all", "clear-unknown-tag"),
        ("clear @s stick[nothing_at_all=1]", "clear-unknown-component"),
        ("clear @s stick[nothing_at_all~1]", "clear-unknown-predicate"),
        ("clear @s stick[damage=abc]", "clear-malformed"),
        ("clear @s stick[count=", "clear-unclosed"),
        ("clear @s stick[]", "clear-empty-tests"),
        ("clear", "clear-all"),
        ("clear @s", "clear-nothing"),
        ("data get entity @s Inventory", "clear-inventory"),
    ]
}

// `block-items`' steps (CAL-165): two chests side by side, a furnace and a hopper are placed; `item`
// puts stacks in the chest's slots, one past its own 27, a stack too big for a slot, a furnace's
// input and fuel, and a hopper's slot from the bot's hand; modifies one; copies a chest's into the
// bot's hand; `execute if items` and `if slots` count them; then `item` on stone, which isn't a
// container, and the chests' data read. Then `execute if biome` by a biome, a tag, ones it isn't,
// unknown ones and an unloaded place (CAL-165). Then NBT in `tellraw`: a block's, with a separator,
// plain, an entity's, a storage's read as text, one that finds nothing and an unloaded place.
fn block_items_steps() -> List<(str, str)> {
    return [
        ("setblock 2 -60 0 chest[facing=north,type=right]", "block-chest"),
        ("setblock 3 -60 0 chest[facing=north,type=left]", "block-chest-other"),
        ("setblock 2 -60 3 furnace", "block-furnace"),
        ("setblock 4 -60 3 hopper", "block-hopper"),
        ("setblock 6 -60 3 stone", "block-stone"),
        ("item replace block 2 -60 0 container.0 with stone 5", "block-replace"),
        ("item replace block 2 -60 0 container.30 with stone", "block-past"),
        ("item replace block 2 -60 0 container.26 with diamond 99", "block-last"),
        ("item replace block 2 -60 0 container.* with dirt", "block-all"),
        ("item replace block 2 -60 3 container.0 with iron_ore 3", "block-furnace-input"),
        ("item replace block 2 -60 3 container.1 with coal", "block-furnace-fuel"),
        ("item replace entity @s weapon.mainhand with gold_ingot 7", "block-held"),
        ("item replace block 4 -60 3 container.2 from entity @s weapon.mainhand", "block-from-hand"),
        ("item modify block 2 -60 0 container.0 \{function:\"minecraft:set_count\",count:12\}", "block-modify"),
        ("item replace entity @s weapon.mainhand from block 2 -60 0 container.0", "block-to-hand"),
        ("execute if items block 2 -60 0 container.* dirt", "block-if-items"),
        ("execute unless items block 2 -60 0 container.* diamond", "block-unless-items"),
        ("execute if slots block 4 -60 3 container.*", "block-if-slots"),
        ("item replace block 6 -60 3 container.0 with stone", "block-not-container"),
        ("execute if items block 6 -60 3 container.0 *", "block-not-source"),
        ("data get block 2 -60 0 Items", "block-chest-data"),
        ("data get block 3 -60 0 Items", "block-other-data"),
        ("data get block 4 -60 3 Items", "block-hopper-data"),
        ("execute if biome 0 -60 0 minecraft:plains", "biome-plains"),
        ("execute if biome 0 -60 0 #minecraft:is_overworld", "biome-tag"),
        ("execute unless biome 0 -60 0 minecraft:the_end", "biome-not-end"),
        ("execute if biome 0 -60 0 minecraft:desert", "biome-not-desert"),
        ("execute if biome 0 -60 0 minecraft:nothing_at_all", "biome-unknown"),
        ("execute if biome 0 -60 0 #minecraft:nothing_at_all", "biome-unknown-tag"),
        ("execute if biome 90000 -60 0 minecraft:plains", "biome-unloaded"),
        ("data get block 2 -60 3", "block-furnace-data"),
        ("tellraw @s \{nbt:\"Items[0]\",block:\"2 -60 0\"\}", "nbt-text-block"),
        ("tellraw @s \{nbt:\"Items[].id\",block:\"2 -60 0\",separator:\" | \"\}", "nbt-text-separator"),
        ("tellraw @s \{nbt:\"Items[0]\",block:\"4 -60 3\",plain:true\}", "nbt-text-plain"),
        ("tellraw @s \{nbt:\"SelectedItem\",entity:\"@s\"\}", "nbt-text-entity"),
        ("data modify storage minecraft:shown text set value \{text:\"hi\",color:\"red\"\}", "nbt-text-stored"),
        ("tellraw @s \{nbt:\"text\",storage:\"minecraft:shown\",interpret:true\}", "nbt-text-interpret"),
        ("tellraw @s [\"a\",\{nbt:\"nothing\",storage:\"minecraft:empty\"\},\"b\"]", "nbt-text-none"),
        ("tellraw @s \{nbt:\"Items\",block:\"90000 -60 0\"\}", "nbt-text-unloaded"),
        ("", "block-after"),
    ]
}

// `world-commands`' steps (CAL-165): `seed`; `defaultgamemode` to adventure and back; then
// `setworldspawn` where the bot is, at a place, turned, the same again, which sends nothing, and
// out of bounds; `playsound` as plain as can be, with a source, a place, a volume and a pitch,
// of a sound no registry has, too far off to be heard and too far off but heard at the least
// volume, and to everyone; and `stopsound` of every sound, of one from any source, of a source,
// and of one from a source; `swing` by the bot, again too soon, by its other hand and with
// other animations, by an armor stand, a zombie and both, and by an arrow, which doesn't live;
// `rotate` of the bot to a turn, by one, to face a place and the zombie's eyes, of the zombie,
// the stand by one, the zombie to face the bot, the arrow to face a place, and of more than one.
fn world_commands_steps() -> List<(str, str)> {
    return [
        ("seed", "world-seed"),
        ("defaultgamemode adventure", "world-default-adventure"),
        ("defaultgamemode survival", "world-default-survival"),
        ("setworldspawn", "world-spawn-here"),
        ("setworldspawn 5 -60 5", "world-spawn-at"),
        ("setworldspawn 5 -60 5 90 30", "world-spawn-turned"),
        ("setworldspawn 5 -60 5 90 30", "world-spawn-same"),
        ("setworldspawn 0 30000000 0", "world-spawn-out"),
        ("setworldspawn 0 -60 0 200 -100", "world-spawn-wrapped"),
        ("playsound minecraft:block.note_block.harp", "sound-plain"),
        ("playsound block.bell.use block @s ~ ~1 ~ 2 1.5", "sound-bell"),
        ("playsound calcite:no.such.sound ambient @s 0 -60 0", "sound-unknown"),
        ("playsound entity.cow.ambient neutral @s 200 -60 200", "sound-too-far"),
        ("playsound entity.cow.ambient neutral @s 200 -60 200 1 1 0.5", "sound-far-least"),
        ("playsound ui.button.click ui @a 0 -60 0 0.5 2 0", "sound-everyone"),
        ("stopsound @s", "stop-all"),
        ("stopsound @s * minecraft:block.bell.use", "stop-any-source"),
        ("stopsound @s block", "stop-source"),
        ("stopsound @a record music_disc.cat", "stop-source-sound"),
        ("swing", "swing-plain"),
        ("swing", "swing-again"),
        ("swing @s offhand stab 10", "swing-offhand"),
        ("swing @s mainhand none", "swing-none"),
        ("summon armor_stand 2 -60 0", "swing-stand-made"),
        ("summon zombie -2 -60 0 \{NoAI:1b\}", "swing-zombie-made"),
        ("summon arrow 0 -55 3", "swing-arrow-made"),
        ("swing @e[type=armor_stand]", "swing-stand"),
        ("swing @e[type=zombie] mainhand whack 1s", "swing-zombie"),
        ("swing @e[type=!player]", "swing-many"),
        ("swing @e[type=arrow]", "swing-not-living"),
        ("rotate @s 90 30", "rotate-set"),
        ("rotate @s ~10 ~-5", "rotate-by"),
        ("rotate @s facing 5 -60 5", "rotate-face-place"),
        ("rotate @s facing entity @e[type=zombie,limit=1] eyes", "rotate-face-zombie"),
        ("rotate @e[type=zombie,limit=1] 45 0", "rotate-zombie"),
        ("rotate @e[type=armor_stand,limit=1] ~90 ~", "rotate-stand-by"),
        ("rotate @e[type=zombie,limit=1] facing entity @s eyes", "rotate-zombie-face"),
        ("rotate @e[type=arrow,limit=1] facing 0 -60 0", "rotate-arrow-face"),
        ("rotate @e[type=zombie] 1 1", "rotate-too-many"),
        ("", "rotate-shown"),
        ("item replace entity @s weapon.mainhand with diamond_sword", "enchant-sword"),
        ("enchant @s sharpness 3", "enchant-sharp"),
        ("enchant @s sharpness 2", "enchant-lower"),
        ("enchant @s smite", "enchant-incompatible"),
        ("enchant @s sharpness 9", "enchant-too-high"),
        ("enchant @s binding_curse", "enchant-unsupported"),
        ("enchant @s unbreaking 3", "enchant-unbreaking"),
        ("item replace entity @s weapon.mainhand with air", "enchant-emptied"),
        ("enchant @s unbreaking", "enchant-itemless"),
        ("summon husk 3 -60 0 \{NoAI:1b\}", "enchant-husk-made"),
        ("item replace entity @e[type=husk,limit=1] weapon.mainhand with iron_axe", "enchant-axe"),
        ("enchant @e[type=husk] efficiency 2", "enchant-husk"),
        ("enchant @e[type=!player] unbreaking", "enchant-many"),
        ("enchant @e[type=arrow] unbreaking", "enchant-not-living"),
        ("enchant @e[type=armor_stand] unbreaking", "enchant-stand-itemless"),
        ("", "enchant-shown"),
        ("recipe give @s minecraft:oak_planks", "recipe-give"),
        ("recipe give @s oak_planks", "recipe-give-again"),
        ("recipe take @s oak_planks", "recipe-take"),
        ("recipe take @s oak_planks", "recipe-take-again"),
        ("recipe give @s minecraft:no_such_recipe", "recipe-unknown"),
