        ("summon endermite 44.5 -60 44.5 \{Lifetime:2250\}", "mite"),
        ("summon endermite 36.5 -60 44.5 \{NoAI:1b,Lifetime:2395\}", "mite-old"),
        ("", "mite-walks"),
        ("", "mite-gone"),
        // Ender pearls owned by what isn't a player (D585): a pig with no AI, turned, and a stone
