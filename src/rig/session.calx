        Dig { name: "barrel", packets: [
            on_top(0, -60, -2, 4),
            Dug.Click(4, fresh(0i16, 1i8, 0, [(0i16, plain("cobblestone", 16))], plain("cobblestone", 16))),
            Dug.Close(4),
        ] },
        Dig { name: "ender-chest", packets: [
            on_top(-2, -60, -2, 5),
            Dug.Click(5, fresh(55i16, 0i8, 1, [(55i16, nothing()), (0i16, plain("dirt", 2))], nothing())),
            Dug.Close(5),
        ] },
        Dig { name: "shulker-box", packets: [
            on_side(2, -60, -2, 4, 0.5f32, 6),
            Dug.Click(6, fresh(54i16, 0i8, 1, [(54i16, nothing()), (0i16, plain("cobblestone", 16))], nothing())),
            Dug.Close(6),
        ] },
        Dig { name: "dispenser", packets: [
