        ("#charge 0.5 -60 0.5 0.3 18", "spear-offhand-run"),
        ("#release", "spear-offhand-let-go"),
        ("", "spear-offhand-1"),
        ("", "spear-offhand-after"),
    ]
}

// `spear-dismount`'s steps (CAL-214), as `spear-charge`'s, but the husk rides a chicken twelve
