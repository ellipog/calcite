        ("data merge block ~-2 ~ ~2 \{Items:[\{Slot:0b,id:\"minecraft:stone\",count:5\}],CustomName:\"Rig\"\}", "block-data-merge-same"),
        ("data modify block ~-2 ~ ~2 Items append value \{Slot:3b,id:\"minecraft:diamond\",count:2\}", "block-data-append"),
