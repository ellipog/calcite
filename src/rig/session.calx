        ("#throw 0 0", "bundle-uses-emptying"),
        ("", "bundle-uses-emptied"),
        ("#release", "bundle-uses-let-go"),
        ("item replace entity @s weapon.mainhand with red_bundle[bundle_contents=[\{id:\"minecraft:apple\",count:5\},\{id:\"minecraft:torch\"\}]]", "bundle-uses-red-held"),
        ("#throw 90 0", "bundle-uses-red-emptying"),
        ("", "bundle-uses-red-emptied"),
        ("#release", "bundle-uses-red-let-go"),
        ("item replace entity @s weapon.mainhand with bundle", "bundle-uses-empty-held"),
        ("#throw -90 0", "bundle-uses-empty-used"),
        ("", "bundle-uses-empty-holding"),
        ("#release", "bundle-uses-empty-let-go"),
        ("", "bundle-uses-1"), ("", "bundle-uses-2"), ("", "bundle-uses-3"), ("", "bundle-uses-4"),
        ("", "bundle-uses-after"),
    ]
}

// `rocket-launches`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode,
// uses a firework rocket on the grass before it, `FireworkRocketItem.useOn`, which flies up and
// bursts, `explode`; then one that flies three times as long; then one under stone, which it hits
// and flies on against till it bursts. One summoned with a life of 15 ticks bursts too, and in
// creative mode a rocket used is used up as well.
fn rocket_launches_steps() -> List<(str, str)> {
    return [
        ("time set day", "rocket-launches-day"),
        ("gamemode survival", "rocket-launches-survival"),
        ("item replace entity @s weapon.mainhand with firework_rocket 3", "rocket-launches-held"),
        ("#use 0 -61 3", "rocket-launches-launched"),
        ("", "rocket-launches-flying"),
        ("", "rocket-launches-burst"),
        ("item replace entity @s weapon.mainhand with firework_rocket[fireworks=\{flight_duration:3\}]", "rocket-launches-long-held"),
        ("#use -2 -61 2", "rocket-launches-long-launched"),
        ("", "rocket-launches-long-flying"),
        ("", "rocket-launches-long-burst"),
        ("setblock 2 -58 2 stone", "rocket-launches-ceiling"),
        ("item replace entity @s weapon.mainhand with firework_rocket 2", "rocket-launches-ceiling-held"),
        ("#use 2 -61 2", "rocket-launches-ceiling-launched"),
        ("", "rocket-launches-ceiling-hit"),
        ("", "rocket-launches-ceiling-burst"),
        ("summon firework_rocket 3 -59 -2 \{LifeTime:15\}", "rocket-launches-summoned"),
        ("", "rocket-launches-summoned-burst"),
        ("gamemode creative", "rocket-launches-creative"),
        ("#use 0 -61 3", "rocket-launches-creative-launched"),
        ("", "rocket-launches-creative-flying"),
        ("", "rocket-launches-creative-burst"),
        ("", "rocket-launches-1"), ("", "rocket-launches-2"), ("", "rocket-launches-3"), ("", "rocket-launches-4"),
        ("", "rocket-launches-after"),
    ]
}

// `rocket-bursts`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode,
// summons a cow without AI and an armor stand before it, and a rocket of two explosions between
// them, which bursts on its second tick and hurts the cow, the stand and the bot, each by how near
// it is, `dealExplosionDamage`; then it uses a rocket of one explosion under stone, which bursts
// as it hits it, hurting the bot by its own rocket.
fn rocket_bursts_steps() -> List<(str, str)> {
    return [
        ("time set day", "rocket-bursts-day"),
        ("gamemode survival", "rocket-bursts-survival"),
        ("summon cow 0 -60 4 \{NoAI:1b\}", "rocket-bursts-cow"),
        ("summon armor_stand -2 -60 3", "rocket-bursts-stand"),
        ("summon firework_rocket 0 -60 2 \{LifeTime:1,FireworksItem:\{id:\"minecraft:firework_rocket\",count:1,components:\{\"minecraft:fireworks\":\{explosions:[\{shape:\"small_ball\"\},\{shape:\"star\"\}]\}\}\}\}", "rocket-bursts-summoned"),
        ("", "rocket-bursts-burst"),
        ("setblock 2 -58 2 stone", "rocket-bursts-ceiling"),
        ("item replace entity @s weapon.mainhand with firework_rocket[fireworks=\{explosions:[\{shape:\"burst\"\}]\}]", "rocket-bursts-held"),
        ("#use 2 -61 2", "rocket-bursts-launched"),
        ("", "rocket-bursts-ceiling-burst"),
        ("", "rocket-bursts-settled"),
        ("", "rocket-bursts-1"), ("", "rocket-bursts-2"), ("", "rocket-bursts-3"), ("", "rocket-bursts-4"),
        ("", "rocket-bursts-after"),
    ]
}

// `channeling`'s steps (CAL-326), where `lightning`'s are: by day, the bot sets a thunderstorm going
// and waits for it to come on, as the rain and the thunder rise a hundredth a tick; then, in
// survival mode, throws a trident of channeling at a lightning rod 8 blocks south, which summons a
// bolt on it, and another at a cow without AI 6 blocks west, which the trident hurts and a bolt
// it summons strikes, `item.trident.thunder` heard each time. Last it puts the fires out and sets
// stone up in the four chunks about the spawn, as `lightning` does.
fn channeling_steps() -> List<(str, str)> {
    return [
        ("time set day", "channeling-day"),
        ("weather thunder 1d", "channeling-thunder"),
        ("", "channeling-rising-1"), ("", "channeling-rising-2"), ("", "channeling-rising-3"),
        ("", "channeling-rising-4"), ("", "channeling-rising-5"), ("", "channeling-rising-6"),
        ("gamemode survival", "channeling-survival"),
        ("setblock 0 -60 8 lightning_rod", "channeling-rod"),
        ("item replace entity @s weapon.mainhand with trident[enchantments=\{channeling:1\}]", "channeling-rod-held"),
        ("#throw 0 7", "channeling-rod-readied"),
        ("#release", "channeling-rod-thrown"),
        ("", "channeling-rod-1"), ("", "channeling-rod-2"), ("", "channeling-rod-3"),
        ("summon cow -5.5 -60 0.5 \{NoAI:1b\}", "channeling-cow"),
        ("item replace entity @s weapon.mainhand with trident[enchantments=\{channeling:1\}]", "channeling-held"),
        ("#throw 90 10", "channeling-readied"),
        ("#release", "channeling-thrown"),
        ("", "channeling-1"), ("", "channeling-2"), ("", "channeling-3"), ("", "channeling-4"),
        ("gamemode creative", "channeling-creative"),
        ("fill -16 -61 -16 15 -55 15 air replace fire", "channeling-out"),
        ("fill -1 -50 -1 0 -50 0 stone", "channeling-marked"),
    ]
}

// `ride-save`'s steps (CAL-328), where `talk`'s are: by day, the bot summons an armor stand two
// blocks south with another riding it, tagged `top`, sits on that one, `ride`, and leaves on it:
// the stands go with it, saved in its data, `RootVehicle`, not with their chunk.
fn ride_save_steps() -> List<(str, str)> {
    return [
        ("time set day", "ride-save-day"),
        ("summon armor_stand 0.5 -60 2.5 \{Passengers:[\{id:armor_stand,Tags:[top]\}]\}", "ride-save-stands"),
        ("ride @s mount @e[tag=top,limit=1]", "ride-save-mounted"),
        ("", "ride-save-1"),
        ("", "ride-save-after"),
    ]
}

// `ride-back`'s steps (CAL-328): the bot joins again after `ride-save`, the stands loaded back
// from its data and it sat on the top one again as it joins, waits, and leaves on it again.
fn ride_back_steps() -> List<(str, str)> {
    return [
        ("", "ride-back-1"),
        ("", "ride-back-2"),
        ("", "ride-back-after"),
    ]
}

// `lightning`'s steps (CAL-326), where `snowballs`' are: by day, the bot, in creative mode, summons
// lightning bolts, `summon lightning_bolt`: on the grass to the east, which on normal sets fire at
// it and about it; on a lightning rod to the south, which it powers, with no fire on the rod; on
// oxidized copper to the west, among weathered copper and waxed exposed copper, which it scrapes;
// and among a creeper and a cow without AI and an armor stand to the north, which it strikes: the
// creeper powered, the cow hurt and alight, the stand left as it was; and among a pig, a
// villager and a mooshroom without AI to the north-east, the pig turned into a zombified piglin,
// the villager into a witch, the mooshroom brown. Last it puts the fires out, and sets stone up in
// the four chunks about the spawn, which saves each of them again:
// vanilla saves a chunk early by the wall clock, `saveChunksEagerly`, and a fire's tick that
// changes nothing doesn't mark it to be saved again, so a save between would keep a spent tick.
fn lightning_steps() -> List<(str, str)> {
    return [
        ("time set day", "lightning-day"),
        ("gamemode creative", "lightning-creative"),
        ("summon lightning_bolt 10 -60 0", "lightning-grass"),
        ("", "lightning-grass-1"), ("", "lightning-grass-2"),
        ("setblock 0 -61 10 lightning_rod", "lightning-rod-set"),
        ("summon lightning_bolt 0 -60 10", "lightning-rod"),
        ("", "lightning-rod-1"), ("", "lightning-rod-2"),
        ("fill -11 -61 -1 -9 -61 1 weathered_copper", "lightning-copper-set"),
        ("setblock -10 -61 0 oxidized_copper", "lightning-copper-middle"),
        ("setblock -9 -61 1 waxed_exposed_copper", "lightning-copper-waxed"),
        ("summon lightning_bolt -10 -60 0", "lightning-copper"),
        ("", "lightning-copper-1"), ("", "lightning-copper-2"),
        ("summon creeper 0 -60 -10 \{NoAI:1b\}", "lightning-creeper"),
        ("summon cow 2 -60 -10 \{NoAI:1b\}", "lightning-cow"),
        ("summon armor_stand -2 -60 -10", "lightning-stand"),
        ("summon lightning_bolt 0 -60 -10", "lightning-mobs"),
        ("", "lightning-mobs-1"), ("", "lightning-mobs-2"), ("", "lightning-mobs-3"),
        ("summon pig 10 -60 -10 \{NoAI:1b\}", "lightning-pig"),
        ("summon villager 12 -60 -10 \{NoAI:1b\}", "lightning-villager"),
        ("summon mooshroom 8 -60 -10 \{NoAI:1b\}", "lightning-mooshroom"),
        ("summon lightning_bolt 10 -60 -10", "lightning-turns"),
        ("", "lightning-turns-1"), ("", "lightning-turns-2"), ("", "lightning-turns-3"),
        ("", "lightning-1"), ("", "lightning-2"),
        ("", "lightning-after"),
        ("fill -16 -61 -16 15 -55 15 air replace fire", "lightning-out"),
        ("fill -1 -50 -1 0 -50 0 stone", "lightning-marked"),
    ]
}

// `crossbow-rockets`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode,
// holding firework rockets in its off hand, charges a crossbow, loading a rocket, lets go, and
// shoots it up and ahead, `CrossbowItem.createProjectile`, a rocket shot at an angle that isn't
// sped up, the crossbow worn by 3; then one with multishot, three rockets in a spread.
fn crossbow_rockets_steps() -> List<(str, str)> {
    return [
        ("time set day", "crossbow-rockets-day"),
        ("gamemode survival", "crossbow-rockets-survival"),
        ("item replace entity @s weapon.mainhand with crossbow", "crossbow-rockets-held"),
        ("item replace entity @s weapon.offhand with firework_rocket 4", "crossbow-rockets-rockets"),
        ("#throw 0 -30", "crossbow-rockets-charging"),
        ("", "crossbow-rockets-charged"),
        ("#release", "crossbow-rockets-let-go"),
        ("#throw 0 -30", "crossbow-rockets-fired"),
        ("", "crossbow-rockets-flying"),
        ("", "crossbow-rockets-burst"),
        ("item replace entity @s weapon.mainhand with crossbow[enchantments=\{multishot:1\}]", "crossbow-rockets-multishot-held"),
        ("#throw 90 -30", "crossbow-rockets-multishot-charging"),
        ("", "crossbow-rockets-multishot-charged"),
        ("#release", "crossbow-rockets-multishot-let-go"),
        ("#throw 90 -30", "crossbow-rockets-multishot-fired"),
        ("", "crossbow-rockets-multishot-flying"),
        ("", "crossbow-rockets-settled"),
        ("", "crossbow-rockets-1"), ("", "crossbow-rockets-2"), ("", "crossbow-rockets-3"), ("", "crossbow-rockets-4"),
        ("", "crossbow-rockets-after"),
    ]
}

// `parrot-shoulder`'s steps (CAL-201), where `wolf-anger`'s are: by day, the bot, in survival mode
// and resisting all harm, fills the end portal with stone, so none flies in, CAL-307, summons two
// parrots it owns, ordered to sit, two blocks from it either way, and waits six seconds, so
// they've been more than 100 ticks off a shoulder, `canSitOnShoulder`. Then it goes to each in
// turn and stands it up with an empty hand, and it lands on its shoulder,
// `LandOnOwnersShoulderGoal`, left then right, shown, heard from it now and then; after two
// seconds more it sets water where it stands, and in water it lets them off,
// `removeEntitiesOnShoulder`, each made again 0.7 above it. It watches for 20 seconds. It goes to
// the parrots and lets them off with water, as Calcite's `tp` and `damage` couldn't then (D818 and
// D819 can); a `#hop` lands in the tick its fall begins, never more than an eighth of a block
// fallen as its shoulders are looked at.
fn parrot_shoulder_steps() -> List<(str, str)> {
    return [
        ("time set day", "parrot-shoulder-day"),
        ("fill 3 -61 -1 5 -61 1 minecraft:stone", "parrot-shoulder-portal"),
        ("gamemode survival", "parrot-shoulder-survival"),
        ("effect clear @s", "parrot-shoulder-clear"),
        ("effect give @s resistance 600 4 true", "parrot-shoulder-armor"),
        ("summon parrot 0.5 -60 2.5 \{Owner:[I;-1155928273,798308776,-1951547997,-315148217],Variant:4,Sitting:1b\}", "parrot-shoulder-gray"),
        ("summon parrot 2.5 -60 0.5 \{Owner:[I;-1155928273,798308776,-1951547997,-315148217],Sitting:1b\}", "parrot-shoulder-red"),
        ("", "parrot-shoulder-wait-1"),
        ("", "parrot-shoulder-wait-2"),
        ("", "parrot-shoulder-wait-3"),
        ("", "parrot-shoulder-wait-4"),
        ("", "parrot-shoulder-wait-5"),
        ("", "parrot-shoulder-wait-6"),
        ("tp @s 0.5 -60 2.5", "parrot-shoulder-to-gray"),
        ("#use-mob 0", "parrot-shoulder-stand-gray"),
        ("tp @s 2.5 -60 0.5", "parrot-shoulder-to-red"),
        ("#use-mob 1", "parrot-shoulder-stand-red"),
        ("", "parrot-shoulder-sat"),
        ("", "parrot-shoulder-sat-more"),
        ("setblock 2 -60 0 minecraft:water", "parrot-shoulder-water"),
        ("", "parrot-shoulder-1"), ("", "parrot-shoulder-2"), ("", "parrot-shoulder-3"), ("", "parrot-shoulder-4"), ("", "parrot-shoulder-5"),
        ("", "parrot-shoulder-6"), ("", "parrot-shoulder-7"), ("", "parrot-shoulder-8"), ("", "parrot-shoulder-9"), ("", "parrot-shoulder-10"),
        ("", "parrot-shoulder-11"), ("", "parrot-shoulder-12"), ("", "parrot-shoulder-13"), ("", "parrot-shoulder-14"), ("", "parrot-shoulder-15"),
        ("", "parrot-shoulder-16"), ("", "parrot-shoulder-17"), ("", "parrot-shoulder-18"), ("", "parrot-shoulder-19"), ("", "parrot-shoulder-20"),
        ("", "parrot-shoulder-after"),
    ]
}

// `cat-breed`'s steps (CAL-201), where `wolves`' are: by day, the bot, in survival mode, summons two
// cats of its own, tame, `Owner`, one's collar red, the other's yellow, and holds two cod, feeding
// one to each, which puts them in love, `Animal.mobInteract`. They breed, `BreedGoal`, and their
// kitten's born tame, the bot's, its collar either's, `Cat.getBreedOffspring`. It watches for 10
// seconds.
fn cat_breed_steps() -> List<(str, str)> {
    return [
        ("time set day", "cat-breed-day"),
        ("gamemode survival", "cat-breed-survival"),
        ("summon cat -1.5 -60 0.5 \{Owner:[I;-1155928273,798308776,-1951547997,-315148217],CollarColor:14b\}", "cat-breed-red"),
        ("summon cat 0.5 -60 2.5 \{Owner:[I;-1155928273,798308776,-1951547997,-315148217],CollarColor:4b\}", "cat-breed-yellow"),
        ("item replace entity @s weapon.mainhand with cod 2", "cat-breed-cod"),
        ("#use-mob 0", "cat-breed-fed-red"),
        ("#use-mob 1", "cat-breed-fed-yellow"),
        ("", "cat-breed-1"), ("", "cat-breed-2"), ("", "cat-breed-3"), ("", "cat-breed-4"), ("", "cat-breed-5"),
        ("", "cat-breed-6"), ("", "cat-breed-7"), ("", "cat-breed-8"), ("", "cat-breed-9"), ("", "cat-breed-10"),
        ("", "cat-breed-after"),
    ]
}

// `wolf-defend`'s steps (CAL-201), where `wolves`' are: by day, the bot, in survival mode and
// resisting all harm, fills the end portal with stone, so nothing falls in early, CAL-307, and summons a wolf
// whose owner it is, tame, `Owner`, of 40 health, and a husk
// away west. The husk comes for the bot and hits it, and the wolf takes the husk up,
// `OwnerHurtByTargetGoal`, and bites it till it dies. Then the bot summons a pig without AI
// beside it and hits it, and the wolf takes the pig up, `OwnerHurtTargetGoal`, and bites it till
// it dies. Then it summons another wolf of its own, of 1 health, 10 blocks up and more than 12
// off, which teleports to it as it falls, `FollowOwnerGoal`; last, a third, 6 up and nearer, which
// falls and dies, its death told the bot, `TamableAnimal.die`. It watches for 5 seconds.
fn wolf_defend_steps() -> List<(str, str)> {
    return [
        ("time set day", "wolf-defend-day"),
        ("gamemode survival", "wolf-defend-survival"),
        ("effect give @s resistance 100 4 true", "wolf-defend-resist"),
        ("fill 3 -61 -1 5 -61 1 minecraft:stone", "wolf-defend-portal"),
        ("summon wolf -1.5 -60 3.5 \{Owner:[I;-1155928273,798308776,-1951547997,-315148217],Health:40f,attributes:[\{id:\"minecraft:max_health\",base:40d\}]\}", "wolf-defend-wolf"),
        ("summon husk -6.5 -60 -4.5", "wolf-defend-husk"),
        ("", "wolf-defend-1"), ("", "wolf-defend-2"), ("", "wolf-defend-3"), ("", "wolf-defend-4"), ("", "wolf-defend-5"),
        ("", "wolf-defend-6"), ("", "wolf-defend-7"), ("", "wolf-defend-8"), ("", "wolf-defend-9"), ("", "wolf-defend-10"),
        ("", "wolf-defend-11"), ("", "wolf-defend-12"), ("", "wolf-defend-13"), ("", "wolf-defend-14"), ("", "wolf-defend-15"),
        ("summon pig 1.5 -60 -1.5 \{NoAI:1b\}", "wolf-defend-pig"),
        ("#hit-any 2", "wolf-defend-hit"),
        ("", "wolf-defend-16"), ("", "wolf-defend-17"), ("", "wolf-defend-18"), ("", "wolf-defend-19"), ("", "wolf-defend-20"),
        ("", "wolf-defend-21"), ("", "wolf-defend-22"), ("", "wolf-defend-23"), ("", "wolf-defend-24"), ("", "wolf-defend-25"),
        ("summon wolf -6.5 -50 6.5 \{Owner:[I;-1155928273,798308776,-1951547997,-315148217],Health:1f\}", "wolf-defend-falling"),
        ("", "wolf-defend-26"), ("", "wolf-defend-27"), ("", "wolf-defend-28"), ("", "wolf-defend-29"), ("", "wolf-defend-30"),
        ("summon wolf 0.5 -54 5.5 \{Owner:[I;-1155928273,798308776,-1951547997,-315148217],Health:1f\}", "wolf-defend-dropped"),
        ("", "wolf-defend-31"), ("", "wolf-defend-32"), ("", "wolf-defend-33"), ("", "wolf-defend-34"), ("", "wolf-defend-35"),
        ("", "wolf-defend-after"),
    ]
}

// `piglin-ride`'s steps (CAL-200), where `piglins`' are: the bot, in creative mode, summons in one
// tick two baby piglins and a baby hoglin, all immune to zombification, from their data, a few
// blocks apart. A baby piglin that sees the baby hoglin, as its ticker says every 10 to 40
// seconds, `babySometimesRideBabyHoglin`, walks to it and boards it, `Mount`, the other boarding
// the first, `Piglin.startRiding`'s top passenger; each rides for 10 to 30 seconds, then gets off,
// `isBabyRidingBaby`, or where it wants to stop, `DismountOrSkipMounting`. It watches for a
// minute.
fn piglin_ride_steps() -> List<(str, str)> {
