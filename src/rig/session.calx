        ("", "cod-26"), ("", "cod-27"), ("", "cod-28"), ("", "cod-29"), ("", "cod-30"),
        ("", "cod-after"),
    ]
}

// `guardians`' steps (CAL-200), where `cod`'s are, by day, on normal: the bot, in survival mode,
// with resistance III, so the beam doesn't kill it, digs `cod`'s pool and summons a guardian in
// it; it watches for 30 seconds. The guardian finds it, more than 3 off, looks at it, aims its
// beam, entity event 21, and after 80 ticks hurts it by magic and bites it, then strolls about
// the pool, `GuardianMoveControl`, sinking idle, and aims again.
fn guardians_steps() -> List<(str, str)> {
    return [
        ("time set day", "guardians-day"),
        ("gamemode survival", "guardians-survival"),
