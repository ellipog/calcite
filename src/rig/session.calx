        ("item replace entity @s weapon.mainhand with red_dye 2", "saddles-dye"),
        ("#use-mob 2", "saddles-dyed"),
        ("#use-mob 2", "saddles-dyed-again"),
        ("", "saddles-1"), ("", "saddles-2"), ("", "saddles-3"), ("", "saddles-4"), ("", "saddles-5"),
