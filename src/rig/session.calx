// server's clock at 200 and leaves at 240.
fn hook_border() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.UseItemTurnedAt(0, 1, 180.0f32, -20.0f32, 100, "cast"))
    packets.push(Dug.UseItemTurnedAt(0, 2, 180.0f32, -20.0f32, 160, "reel"))
    packets.push(Dug.Mark(200, "settled"))
