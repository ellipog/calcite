// What `lifted` does on the `lifted` fixture's world (D515), at the spawn with empty hands and
// jump boost II and slow falling saved on it, by the server's clock from once it's loaded: a mark
// at 100 as the mobs by it move with their effects; at 150 it jumps, half a block up, which the
// server takes a fifth higher for its jump boost, and moves it on, rising and falling slowly back;
// a mark at 200; at 210 it's on the ground again where it jumped, before the server would say it's
// flown too long; a mark at 300; and it leaves at 400.
fn lifted_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "lifting"))
    packets.push(Dug.MoveAt(8.5, -59.5, 8.5, false, 150, "jump"))
    packets.push(Dug.Mark(200, "falling"))
    packets.push(Dug.MoveAt(8.5, -60.0, 8.5, true, 210, "landed"))
    packets.push(Dug.Mark(300, "fallen"))
    packets.push(Dug.Leave(400))
    return [Dig { name: String(), packets: packets }]
}

// What `undying` does on the `undying` fixture's world (D518), at the spawn at 1 health with a
// totem in its off hand, by the server's clock from once it's loaded: a mark at 100, before the
// arrow falls onto it and its totem saves it; at 120 it hits Undying, two blocks east, which
// leaves it a sliver, its attack not quite charged; at 200 again, which would kill it but for its
// totem; at 280 again, which its absorption takes; a mark at 340 as they heal; and it leaves at
// 400.
fn undying_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "arrow"))
    packets.push(Dug.HitZombie(0, 120, "hit-undying"))
    packets.push(Dug.HitZombie(0, 200, "hit-saved"))
    packets.push(Dug.HitZombie(0, 280, "hit-absorbed"))
    packets.push(Dug.Mark(340, "healed"))
    packets.push(Dug.Leave(400))
    return [Dig { name: String(), packets: packets }]
}

// What `eaten` does on the `eaten` fixture's world (D519), at the spawn, by the server's clock
// from once it's loaded, each use with a sequence number of its own: at 110 it eats an apple from
// its first hotbar slot; at 150 it holds the second and at 152 drinks a honey bottle; at 200 it
// holds the third and at 202 drinks the potion of swiftness; at 250 the fourth, the milk; at 300
// it holds the first again, starts on an apple at 302 and lets go of it at 310; at 320 it eats
// the bread in its off hand; at 360 it holds the fifth, the golden apple, and at 400 the sixth,
// the suspicious stew, both eaten full; at 450 the seventh, the potion of healing; at 500 the
// first, and at 502 it can't eat another apple, full; and it leaves at 540. Each use takes 32
// ticks, the honey bottle's 40.
fn eaten_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "start"))
    packets.push(Dug.UseItemAt(0, 1, 110, "apple"))
    packets.push(Dug.HoldAt(1, 150, "honey-held"))
    packets.push(Dug.UseItemAt(0, 2, 152, "honey"))
    packets.push(Dug.HoldAt(2, 200, "swiftness-held"))
    packets.push(Dug.UseItemAt(0, 3, 202, "swiftness"))
    packets.push(Dug.HoldAt(3, 250, "milk-held"))
    packets.push(Dug.UseItemAt(0, 4, 252, "milk"))
    packets.push(Dug.HoldAt(0, 300, "apple-held"))
    packets.push(Dug.UseItemAt(0, 5, 302, "apple-again"))
    packets.push(Dug.ReleaseAt(310, "let-go"))
    packets.push(Dug.UseItemAt(1, 6, 320, "bread"))
    packets.push(Dug.HoldAt(4, 360, "golden-held"))
    packets.push(Dug.UseItemAt(0, 7, 362, "golden"))
    packets.push(Dug.HoldAt(5, 400, "stew-held"))
    packets.push(Dug.UseItemAt(0, 8, 402, "stew"))
    packets.push(Dug.HoldAt(6, 450, "healing-held"))
    packets.push(Dug.UseItemAt(0, 9, 452, "healing"))
    packets.push(Dug.HoldAt(0, 500, "full-held"))
    packets.push(Dug.UseItemAt(0, 10, 502, "full"))
    packets.push(Dug.Leave(540))
    return [Dig { name: String(), packets: packets }]
}

// What `splash` does on the `splash` fixture's world (D527), in survival mode at the spawn with
// splash potions of poison, healing, regeneration, water and harming in its first five hotbar
// slots, by the server's clock from once it's loaded: at 120 it throws the poison east at Moo,
// the cow four blocks off, which its splash poisons, and the bot too, near enough; at 162 the
// healing south at Rot, the zombie, which it hurts; at 212 the regeneration down at its own
// feet; at 262 the water up to the north, at nothing; at 312 the harming east at Moo again, which
// hurts the cow and the bot; and it leaves at 420.
fn splash_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "start"))
    packets.push(Dug.UseItemTurnedAt(0, 1, -90.0f32, 0.0f32, 120, "poison"))
    packets.push(Dug.HoldAt(1, 160, "healing-held"))
    packets.push(Dug.UseItemTurnedAt(0, 2, 0.0f32, 0.0f32, 162, "healing"))
    packets.push(Dug.HoldAt(2, 210, "regeneration-held"))
    packets.push(Dug.UseItemTurnedAt(0, 3, 0.0f32, 90.0f32, 212, "regeneration"))
    packets.push(Dug.HoldAt(3, 260, "water-held"))
    packets.push(Dug.UseItemTurnedAt(0, 4, 180.0f32, -30.0f32, 262, "water"))
    packets.push(Dug.HoldAt(4, 310, "harming-held"))
    packets.push(Dug.UseItemTurnedAt(0, 5, -90.0f32, 0.0f32, 312, "harming"))
    packets.push(Dug.Leave(420))
    return [Dig { name: String(), packets: packets }]
}

// What `linger` does on the `splash` fixture's world (D529), in survival mode at the spawn facing
// east with lingering potions of poison, healing, regeneration, harming and slowness in its first
// five hotbar slots, by the server's clock from once it's loaded: at 120 it throws the poison at
// Moo, the cow, east of it, whose cloud poisons her each second till it's gone; at 172 the healing
// at Rot, the zombie, south of it, whose cloud hurts him; at 222 the regeneration at its own feet,
// whose cloud gives it regeneration; at 342 the harming at its own feet, whose cloud hurts it; at
// 362 the slowness up and away to the north, whose cloud lands where nothing is and stays; and it
// leaves at 480, that cloud still there.
fn linger_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "start"))
    packets.push(Dug.UseItemTurnedAt(0, 1, -90.0f32, 0.0f32, 120, "poison"))
    packets.push(Dug.HoldAt(1, 170, "healing-held"))
    packets.push(Dug.UseItemTurnedAt(0, 2, 0.0f32, 0.0f32, 172, "healing"))
    packets.push(Dug.HoldAt(2, 220, "regeneration-held"))
    packets.push(Dug.UseItemTurnedAt(0, 3, 0.0f32, 90.0f32, 222, "regeneration"))
    packets.push(Dug.HoldAt(3, 340, "harming-held"))
    packets.push(Dug.UseItemTurnedAt(0, 4, 0.0f32, 90.0f32, 342, "harming"))
