// A step of `place-creative`'s: the item given into the hotbar's first slot, which the bot holds,
// then used on the top of the block at x, y, z, with the sequence number `n`.
fn handed(name: str, item: str, x: i32, y: i32, z: i32, n: i32) -> Dig {
    return Dig { name: String(name), packets: [Dug.Give(36i16, item), on_top(x, y, z, n)] }
}

// The same, used on the side `face` of the block, hit `up` from its bottom.
fn handed_on_side(name: str, item: str, x: i32, y: i32, z: i32, face: i32, up: f32, n: i32) -> Dig {
    return Dig { name: String(name), packets: [Dug.Give(36i16, item), on_side(x, y, z, face, up, n)] }
}

