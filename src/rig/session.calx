// `bottle-fill`'s steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode, holds
// 6 glass bottles and fills one at water two blocks south, `BottleItem.use` with what it looks
// at, `getPlayerPOVHitResult` with `Fluid.SOURCE_ONLY`; then uses one at the sky and at the grass
// under it, which do nothing; then one at a waterlogged slab, which fills; then at flowing water,
// which the look passes through to the grass beyond. In creative mode it fills one, keeping the
// bottle. Then an ender dragon without AI is summoned far off and a cloud it owns beside the bot,
// and two are filled with dragon's breath, the cloud half a block less across each time.
fn bottle_fill_steps() -> List<(str, str)> {
    return [
        ("time set day", "bottle-fill-day"),
        ("gamemode survival", "bottle-fill-survival"),
        ("item replace entity @s weapon.mainhand with glass_bottle 6", "bottle-fill-give"),
        ("setblock 0 -60 2 water", "bottle-fill-water"),
        ("#throw 0 30", "bottle-fill-filled"),
        ("#throw 0 -90", "bottle-fill-sky"),
        ("#throw 0 90", "bottle-fill-grass"),
        ("setblock 0 -60 2 oak_slab[waterlogged=true]", "bottle-fill-slab"),
        ("#throw 0 30", "bottle-fill-slab-filled"),
        ("setblock 0 -60 2 water[level=4]", "bottle-fill-flowing"),
        ("#throw 0 30", "bottle-fill-flowing-used"),
        ("setblock 0 -60 2 water", "bottle-fill-water-again"),
        ("gamemode creative", "bottle-fill-creative"),
        ("#throw 0 30", "bottle-fill-creative-filled"),
        ("gamemode survival", "bottle-fill-survival-again"),
        ("summon ender_dragon 0.5 -40 48.5 \{NoAI:1b,UUID:[I;1,2,3,4]\}", "bottle-fill-dragon"),
        ("summon area_effect_cloud -1.5 -60 0.5 \{Owner:[I;1,2,3,4],Radius:3f,Duration:600\}", "bottle-fill-cloud"),
        ("#throw 0 -90", "bottle-fill-breath-1"),
        ("#throw 0 -90", "bottle-fill-breath-2"),
        ("", "bottle-fill-breathed"),
        ("", "bottle-fill-1"), ("", "bottle-fill-2"), ("", "bottle-fill-3"), ("", "bottle-fill-4"),
        ("", "bottle-fill-after"),
    ]
}

// `bucket-use`'s steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode, digs a
// hole two blocks south and one north, and sets a slab two east and powder snow two west. It
// empties a bucket of water into the south hole, `BucketItem.use` and `emptyContents`, takes it
// back with the empty bucket, `pickupBlock` of what it looks at with `Fluid.SOURCE_ONLY`, and
// empties it again; then lava into the north hole, taken back. Water waterlogs the slab, taken up
// by one of two buckets, and the other takes the powder snow; an empty bucket used at the sky and
// the dry slab does nothing. In creative mode a bucket of water is emptied into the water, then
// into the north hole, the bucket kept.
fn bucket_use_steps() -> List<(str, str)> {
    return [
        ("time set day", "bucket-use-day"),
        ("gamemode survival", "bucket-use-survival"),
        ("setblock 0 -61 2 air", "bucket-use-hole-south"),
        ("setblock 0 -61 -2 air", "bucket-use-hole-north"),
        ("setblock 2 -60 0 oak_slab", "bucket-use-slab"),
        ("setblock -2 -60 0 powder_snow", "bucket-use-snow"),
        ("item replace entity @s weapon.mainhand with water_bucket", "bucket-use-water-held"),
        ("#throw 0 45", "bucket-use-water-emptied"),
        ("#throw 0 45", "bucket-use-water-taken"),
        ("#throw 0 45", "bucket-use-water-again"),
        ("item replace entity @s weapon.mainhand with lava_bucket", "bucket-use-lava-held"),
        ("#throw 180 45", "bucket-use-lava-emptied"),
        ("#throw 180 45", "bucket-use-lava-taken"),
        ("item replace entity @s weapon.mainhand with water_bucket", "bucket-use-slab-held"),
        ("#throw -90 30", "bucket-use-slab-wet"),
        ("item replace entity @s weapon.mainhand with bucket 2", "bucket-use-buckets"),
        ("#throw -90 30", "bucket-use-slab-taken"),
        ("#throw 90 30", "bucket-use-snow-taken"),
        ("item replace entity @s weapon.mainhand with bucket", "bucket-use-empty-held"),
        ("#throw 0 -90", "bucket-use-sky"),
        ("#throw -90 30", "bucket-use-slab-dry"),
        ("gamemode creative", "bucket-use-creative"),
        ("item replace entity @s weapon.mainhand with water_bucket", "bucket-use-creative-held"),
        ("#throw 0 45", "bucket-use-creative-into-water"),
        ("#throw 180 45", "bucket-use-creative-north"),
        ("", "bucket-use-creative-after"),
        ("", "bucket-use-1"), ("", "bucket-use-2"), ("", "bucket-use-3"), ("", "bucket-use-4"), ("", "bucket-use-5"),
        ("", "bucket-use-6"),
        ("", "bucket-use-after"),
    ]
}

// `fish-buckets`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode, sets
// water in the ground two blocks south, north, east and west, and uses a fish bucket at each,
// `MobBucketItem`. A cod's to the east, where its look passes through the fixture's flowing water
// beyond the hole to the dirt under it, so it's tried there and again in the same place,
// `emptyContents`, and fails, the bucket kept. A large salmon named Sal, its `custom_name` and
// `salmon/size`, is let out to the north, too big for its hole; a tropical fish of its bucket's
// pattern to the south (CAL-322 has its colors); and a pufferfish whose `bucket_entity_data` has
// it without AI, silent and hurt to the west. Each is let out where the water is, turned a way
// drawn from the level's random, finalized for `BUCKET`, given what its bucket says, from a
// bucket, and heard, `playAmbientSound`, the bucket's own sound heard first. In creative mode it
// empties a bucket of cod into the south water, keeping it. Then the fish swim a while.
fn fish_bucket_steps() -> List<(str, str)> {
    return [
        ("time set day", "fish-buckets-day"),
        ("gamemode survival", "fish-buckets-survival"),
        ("setblock 0 -61 2 water", "fish-buckets-south"),
        ("setblock 0 -61 -2 water", "fish-buckets-north"),
        ("setblock 2 -61 0 water", "fish-buckets-east"),
        ("setblock -2 -61 0 water", "fish-buckets-west"),
        ("item replace entity @s weapon.mainhand with cod_bucket", "fish-buckets-cod-held"),
        ("#throw -90 45", "fish-buckets-cod"),
        ("item replace entity @s weapon.mainhand with salmon_bucket[custom_name=\{text:\"Sal\"\},salmon/size=\"large\"]", "fish-buckets-salmon-held"),
        ("#throw 180 45", "fish-buckets-salmon"),
        ("item replace entity @s weapon.mainhand with tropical_fish_bucket[tropical_fish/pattern=\"betty\"]", "fish-buckets-tropical-held"),
        ("#throw 0 45", "fish-buckets-tropical"),
        ("item replace entity @s weapon.mainhand with pufferfish_bucket[bucket_entity_data=\{NoAI:1b,Silent:1b,Health:1.5f\}]", "fish-buckets-puffer-held"),
        ("#throw 90 45", "fish-buckets-puffer"),
        ("gamemode creative", "fish-buckets-creative"),
        ("item replace entity @s weapon.mainhand with cod_bucket", "fish-buckets-creative-held"),
        ("#throw 0 45", "fish-buckets-creative-cod"),
        ("", "fish-buckets-1"), ("", "fish-buckets-2"), ("", "fish-buckets-3"), ("", "fish-buckets-4"), ("", "fish-buckets-5"),
        ("", "fish-buckets-6"), ("", "fish-buckets-7"), ("", "fish-buckets-8"), ("", "fish-buckets-9"), ("", "fish-buckets-10"),
        ("", "fish-buckets-11"), ("", "fish-buckets-12"), ("", "fish-buckets-13"), ("", "fish-buckets-14"), ("", "fish-buckets-15"),
        ("", "fish-buckets-16"), ("", "fish-buckets-17"), ("", "fish-buckets-18"), ("", "fish-buckets-19"), ("", "fish-buckets-20"),
        ("", "fish-buckets-after"),
    ]
}

// `armor-swap`'s steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode, puts
// on what it holds by using it, `Equippable.swapWithEquipmentSlot`: an iron chestplate, then a
// diamond one, the iron one coming to its hand, and the iron one back. Of three diamond helmets
// one's put on, two kept; of two golden ones one's put on and the diamond one goes into its
// inventory; the other golden one, the same as what's worn, does nothing. Leggings cursed with
// binding keep iron ones off, but not in creative mode, where boots are put on and kept in hand
// too. A carved pumpkin, which isn't swappable, and wolf armor, which only wolves wear, do
// nothing.
fn armor_swap_steps() -> List<(str, str)> {
    return [
        ("time set day", "armor-swap-day"),
        ("gamemode survival", "armor-swap-survival"),
        ("item replace entity @s weapon.mainhand with iron_chestplate", "armor-swap-iron-held"),
        ("#throw 0 0", "armor-swap-iron-on"),
        ("item replace entity @s weapon.mainhand with diamond_chestplate", "armor-swap-diamond-held"),
        ("#throw 0 0", "armor-swap-diamond-on"),
        ("#throw 0 0", "armor-swap-iron-back"),
        ("item replace entity @s weapon.mainhand with diamond_helmet 3", "armor-swap-helmets-held"),
        ("#throw 0 0", "armor-swap-helmet-on"),
        ("item replace entity @s weapon.mainhand with golden_helmet 2", "armor-swap-golden-held"),
        ("#throw 0 0", "armor-swap-golden-on"),
        ("#throw 0 0", "armor-swap-golden-same"),
        ("item replace entity @s armor.legs with leather_leggings[enchantments=\{binding_curse:1\}]", "armor-swap-bound"),
        ("item replace entity @s weapon.mainhand with iron_leggings", "armor-swap-leggings-held"),
        ("#throw 0 0", "armor-swap-leggings-kept-off"),
        ("item replace entity @s weapon.mainhand with carved_pumpkin", "armor-swap-pumpkin-held"),
        ("#throw 0 0", "armor-swap-pumpkin-used"),
        ("item replace entity @s weapon.mainhand with wolf_armor", "armor-swap-wolf-armor-held"),
        ("#throw 0 0", "armor-swap-wolf-armor-used"),
        ("gamemode creative", "armor-swap-creative"),
        ("item replace entity @s weapon.mainhand with iron_leggings", "armor-swap-creative-leggings-held"),
        ("#throw 0 0", "armor-swap-creative-leggings-on"),
        ("item replace entity @s weapon.mainhand with iron_boots", "armor-swap-creative-boots-held"),
        ("#throw 0 0", "armor-swap-creative-boots-on"),
        ("", "armor-swap-1"), ("", "armor-swap-2"), ("", "armor-swap-3"), ("", "armor-swap-4"),
        ("", "armor-swap-after"),
    ]
}

// `horn-spyglass`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode, looks
// through a spyglass, `SpyglassItem.use`, its sound heard, and lets go of it a few ticks on, its
// stop sound heard. Then it blows a ponder goat horn, `InstrumentItem.use`: its sound from it
// among the records' sounds, heard 256 blocks off, its cooldown of 7 seconds begun and it used
// for as long, and lets go; blows it again on its cooldown, which does nothing; and once the
// cooldown's done, blows a sing goat horn and holds it till it's done. A goat horn whose
// instrument takes durability wears.
fn horn_spyglass_steps() -> List<(str, str)> {
    return [
        ("time set day", "horn-spyglass-day"),
        ("gamemode survival", "horn-spyglass-survival"),
        ("item replace entity @s weapon.mainhand with spyglass", "horn-spyglass-spyglass-held"),
        ("#throw 0 0", "horn-spyglass-spyglass-up"),
        ("", "horn-spyglass-spyglass-looking"),
        ("#release", "horn-spyglass-spyglass-let-go"),
        ("item replace entity @s weapon.mainhand with goat_horn[instrument=\"minecraft:ponder_goat_horn\"]", "horn-spyglass-horn-held"),
        ("#throw 0 0", "horn-spyglass-horn-blown"),
        ("", "horn-spyglass-horn-playing"),
        ("#release", "horn-spyglass-horn-let-go"),
        ("#throw 0 0", "horn-spyglass-horn-cooling"),
        ("#wait 5", "horn-spyglass-horn-cooled"),
        ("item replace entity @s weapon.mainhand with goat_horn[instrument=\"minecraft:sing_goat_horn\"]", "horn-spyglass-sing-held"),
        ("#throw 0 0", "horn-spyglass-sing-blown"),
        ("#wait 8", "horn-spyglass-sing-done"),
        ("item replace entity @s weapon.mainhand with goat_horn[instrument=\{sound_event:\"minecraft:item.goat_horn.sound.2\",use_duration:1.0f,range:32.0f,durability_damage:1,description:\"worn\"\},max_damage=5]", "horn-spyglass-worn-held"),
        ("#throw 0 0", "horn-spyglass-worn-blown"),
        ("#release", "horn-spyglass-worn-let-go"),
        ("", "horn-spyglass-1"), ("", "horn-spyglass-2"), ("", "horn-spyglass-3"), ("", "horn-spyglass-4"),
        ("", "horn-spyglass-after"),
    ]
}

// `bow-shots`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode, draws a
// bow with nothing to shoot, which does nothing, `BowItem.use`; then, given arrows, draws it,
// holds it a second and lets go, `releaseUsing`, its arrow shot down at the ground before it at
// full power, crit, one of its arrows used, which lands near enough to pick up again; then a
// tipped arrow from its off hand. Its arrows taken away, `item replace` as Calcite has no
// `clear`, in creative mode it shoots one only seen, which only a creative player may pick up;
// back in survival, a bow with infinity shoots its arrow without using it, one with multishot
// three in a spread, and one at the end of its durability breaks as it shoots.
fn bow_shots_steps() -> List<(str, str)> {
    return [
        ("time set day", "bow-shots-day"),
        ("gamemode survival", "bow-shots-survival"),
        ("item replace entity @s weapon.mainhand with bow", "bow-shots-bow-held"),
        ("#throw 0 45", "bow-shots-empty-drawn"),
        ("give @s arrow 3", "bow-shots-arrows"),
        ("#throw 0 45", "bow-shots-drawn"),
        ("", "bow-shots-drawing"),
        ("#release", "bow-shots-loosed"),
        ("item replace entity @s weapon.offhand with tipped_arrow[potion_contents=\{potion:slowness\}]", "bow-shots-tipped-held"),
        ("#throw 10 45", "bow-shots-tipped-drawn"),
        ("", "bow-shots-tipped-drawing"),
        ("#release", "bow-shots-tipped-loosed"),
        ("item replace entity @s hotbar.1 with air", "bow-shots-cleared"),
        ("item replace entity @s hotbar.2 with air", "bow-shots-cleared-tipped"),
        ("gamemode creative", "bow-shots-creative"),
        ("#throw -10 45", "bow-shots-creative-drawn"),
        ("", "bow-shots-creative-drawing"),
        ("#release", "bow-shots-creative-loosed"),
        ("gamemode survival", "bow-shots-survival-again"),
        ("item replace entity @s weapon.mainhand with bow[enchantments=\{infinity:1\}]", "bow-shots-infinity-held"),
        ("give @s arrow 1", "bow-shots-one-arrow"),
        ("#throw 20 45", "bow-shots-infinity-drawn"),
        ("", "bow-shots-infinity-drawing"),
        ("#release", "bow-shots-infinity-loosed"),
        ("item replace entity @s weapon.mainhand with bow[enchantments=\{multishot:1\}]", "bow-shots-multishot-held"),
        ("#throw -20 45", "bow-shots-multishot-drawn"),
        ("", "bow-shots-multishot-drawing"),
        ("#release", "bow-shots-multishot-loosed"),
        ("item replace entity @s weapon.mainhand with bow[damage=384]", "bow-shots-worn-held"),
        ("#throw 30 45", "bow-shots-worn-drawn"),
        ("", "bow-shots-worn-drawing"),
        ("#release", "bow-shots-worn-loosed"),
        ("", "bow-shots-1"), ("", "bow-shots-2"), ("", "bow-shots-3"), ("", "bow-shots-4"),
        ("", "bow-shots-after"),
    ]
}

// `crossbow-shots`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode,
// uses a crossbow with nothing to load, which does nothing, `CrossbowItem.use`; then, given
// arrows, charges it, its loading sounds heard, `onUseTick`, loading it as it's charged, lets
// go, and uses it again, which shoots, `performShooting`, down at the ground before it, where it's
// picked up again. It lets go of one a second in, before it's charged, which leaves it unloaded,
// and charges it again; then charges and shoots one with multishot, three in a spread, and one
// with quick charge, charged sooner and heard as a quick charge.
fn crossbow_shots_steps() -> List<(str, str)> {
    return [
        ("time set day", "crossbow-shots-day"),
        ("gamemode survival", "crossbow-shots-survival"),
        ("item replace entity @s weapon.mainhand with crossbow", "crossbow-shots-held"),
        ("#throw 0 45", "crossbow-shots-empty-used"),
        ("give @s arrow 3", "crossbow-shots-arrows"),
        ("#throw 0 45", "crossbow-shots-charging"),
        ("", "crossbow-shots-charged"),
        ("", "crossbow-shots-loaded"),
        ("#release", "crossbow-shots-let-go"),
        ("#throw 0 45", "crossbow-shots-fired"),
        ("#throw 10 45", "crossbow-shots-early"),
        ("#release", "crossbow-shots-early-let-go"),
        ("#throw 10 45", "crossbow-shots-again"),
        ("", "crossbow-shots-again-charged"),
        ("#release", "crossbow-shots-again-let-go"),
        ("#throw 10 45", "crossbow-shots-again-fired"),
        ("item replace entity @s weapon.mainhand with crossbow[enchantments=\{multishot:1\}]", "crossbow-shots-multishot-held"),
        ("#throw -20 45", "crossbow-shots-multishot-charging"),
        ("", "crossbow-shots-multishot-charged"),
        ("#release", "crossbow-shots-multishot-let-go"),
        ("#throw -20 45", "crossbow-shots-multishot-fired"),
        ("item replace entity @s weapon.mainhand with crossbow[enchantments=\{quick_charge:3\}]", "crossbow-shots-quick-held"),
        ("#throw 30 45", "crossbow-shots-quick-charging"),
        ("#release", "crossbow-shots-quick-let-go"),
        ("#throw 30 45", "crossbow-shots-quick-fired"),
        ("", "crossbow-shots-1"), ("", "crossbow-shots-2"), ("", "crossbow-shots-3"), ("", "crossbow-shots-4"),
        ("", "crossbow-shots-after"),
    ]
}

// `trident-throws`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode,
// readies a trident, `TridentItem.use`, and lets go of it a second on, `releaseUsing`, throwing it
// down at the ground before it, worn by 1, where it's picked up again; then a trident whose next
// damage would break it, which it can't ready; and in creative mode one thrown that it keeps,
// which only a creative player may pick up.
fn trident_throws_steps() -> List<(str, str)> {
    return [
        ("time set day", "trident-throws-day"),
        ("gamemode survival", "trident-throws-survival"),
        ("item replace entity @s weapon.mainhand with trident", "trident-throws-held"),
        ("#throw 0 45", "trident-throws-readied"),
        ("#release", "trident-throws-thrown"),
        ("", "trident-throws-landed"),
        ("item replace entity @s weapon.mainhand with trident[damage=249]", "trident-throws-worn-held"),
        ("#throw 10 45", "trident-throws-worn-readied"),
        ("#release", "trident-throws-worn-let-go"),
        ("gamemode creative", "trident-throws-creative"),
        ("item replace entity @s weapon.mainhand with trident", "trident-throws-creative-held"),
        ("#throw -10 45", "trident-throws-creative-readied"),
        ("#release", "trident-throws-creative-thrown"),
        ("", "trident-throws-1"), ("", "trident-throws-2"), ("", "trident-throws-3"), ("", "trident-throws-4"),
        ("", "trident-throws-after"),
    ]
}

// `trident-loyalty`'s steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode,
// throws a trident of loyalty III down at the ground before it, which, 5 ticks in the ground,
// comes back to it without physics and into its hand, `ThrownTrident.tryPickup`; then one of
// loyalty I thrown out, 10 degrees up, which comes back slower.
fn trident_loyalty_steps() -> List<(str, str)> {
    return [
        ("time set day", "trident-loyalty-day"),
        ("gamemode survival", "trident-loyalty-survival"),
        ("item replace entity @s weapon.mainhand with trident[enchantments=\{loyalty:3\}]", "trident-loyalty-held"),
        ("#throw 0 45", "trident-loyalty-readied"),
        ("#release", "trident-loyalty-thrown"),
        ("", "trident-loyalty-1"), ("", "trident-loyalty-2"), ("", "trident-loyalty-3"),
        ("item replace entity @s weapon.mainhand with trident[enchantments=\{loyalty:1\}]", "trident-loyalty-far-held"),
        ("#throw 0 -10", "trident-loyalty-far-readied"),
        ("#release", "trident-loyalty-far-thrown"),
        ("", "trident-loyalty-4"), ("", "trident-loyalty-5"), ("", "trident-loyalty-6"), ("", "trident-loyalty-7"), ("", "trident-loyalty-8"),
        ("", "trident-loyalty-after"),
    ]
}

// `spectral-arrows`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode,
// with a husk without AI 4 blocks south of it, shoots a spectral arrow from a bow at him, which
// makes him glow, `SpectralArrow.doPostHurtEffects`; then one down at the ground before it, which
// stays there, saved with its `Duration`; then one toward him from a crossbow charged with it.
fn spectral_arrows_steps() -> List<(str, str)> {
    return [
        ("time set day", "spectral-arrows-day"),
        ("gamemode survival", "spectral-arrows-survival"),
        ("summon husk ~ ~ ~4 \{NoAI:1b,PersistenceRequired:1b\}", "spectral-arrows-husk"),
        ("item replace entity @s weapon.mainhand with bow", "spectral-arrows-bow"),
        ("give @s spectral_arrow 2", "spectral-arrows-given"),
        ("#throw 0 0", "spectral-arrows-drawn"),
        ("", "spectral-arrows-drawing"),
        ("#release", "spectral-arrows-loosed"),
        ("", "spectral-arrows-glowing"),
        ("#throw -30 45", "spectral-arrows-ground-drawn"),
        ("", "spectral-arrows-ground-drawing"),
        ("#release", "spectral-arrows-ground-loosed"),
        ("item replace entity @s weapon.mainhand with crossbow[charged_projectiles=[\{id:\"minecraft:spectral_arrow\",count:1\}]]", "spectral-arrows-crossbow"),
        ("#throw 0 0", "spectral-arrows-crossbow-shot"),
        ("", "spectral-arrows-1"),
        ("", "spectral-arrows-after"),
    ]
}

// `trident-drop`'s steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode,
// throws a trident of loyalty III down at the ground before it, then goes into spectator mode,
// so when it would come back, 5 ticks in the ground, it can't have it, `isAcceptibleReturnOwner`,
// and it's dropped where it was, `spawnAtLocation`; back in survival mode, the bot picks it up.
fn trident_drop_steps() -> List<(str, str)> {
    return [
        ("time set day", "trident-drop-day"),
        ("gamemode survival", "trident-drop-survival"),
        ("item replace entity @s weapon.mainhand with trident[enchantments=\{loyalty:3\}]", "trident-drop-held"),
        ("#throw 0 45", "trident-drop-readied"),
        ("#release", "trident-drop-thrown"),
        ("gamemode spectator", "trident-drop-spectating"),
        ("", "trident-drop-1"), ("", "trident-drop-2"),
        ("gamemode survival", "trident-drop-back"),
        ("", "trident-drop-3"),
        ("", "trident-drop-after"),
    ]
}

// `shields`' steps (CAL-214), where `snowballs`' are: the bot, in survival mode, with a husk
// without AI 3 blocks south of it, raises a shield facing south, `blocks_attacks`, and is hurt:
// by the husk, all of it blocked, `applyItemBlocking`; from behind, none blocked; from before it
// by less than the shield's wear threshold; by fire, which bypasses shields; then by the husk
// with an iron axe, which disables the shield 5 seconds, `disable`, after which the shield can't
// be raised.
fn shields_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "shields-survival"),
        ("summon husk ~ ~ ~3 \{NoAI:1b\}", "shields-husk"),
        ("item replace entity @s weapon.mainhand with shield", "shields-held"),
        ("#throw 0 0", "shields-raised"),
        ("damage @s 4 minecraft:mob_attack by @e[type=husk,limit=1]", "shields-blocked"),
        ("damage @s 4 minecraft:mob_attack at ~ ~ ~-5", "shields-behind"),
        ("damage @s 2 minecraft:mob_attack at ~ ~ ~5", "shields-light"),
        ("damage @s 3 minecraft:in_fire", "shields-fire"),
        ("item replace entity @e[type=husk,limit=1] weapon.mainhand with iron_axe", "shields-axe"),
        ("damage @s 4 minecraft:mob_attack by @e[type=husk,limit=1]", "shields-disabled"),
        ("#throw 0 0", "shields-cooling"),
        ("", "shields-1"), ("", "shields-2"),
        ("", "shields-after"),
    ]
}

// `book-uses`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode, opens a
// written book, `WrittenBookItem.use`, its pages marked resolved, and again, now resolved; uses a
// book and quill, which opens nothing; then uses a knowledge book of two recipes,
// `KnowledgeBookItem.use`, which it learns, the book used up; one of none, used up for nothing;
// one naming a recipe there isn't; and in creative mode one it keeps.
fn book_uses_steps() -> List<(str, str)> {
    return [
        ("time set day", "book-uses-day"),
        ("gamemode survival", "book-uses-survival"),
        ("item replace entity @s weapon.mainhand with written_book[written_book_content=\{title:\"T\",author:\"A\",pages:[\"one\",\"two\"]\}]", "book-uses-written-held"),
        ("#throw 0 0", "book-uses-written-opened"),
        ("#throw 0 0", "book-uses-written-again"),
        ("item replace entity @s weapon.mainhand with writable_book", "book-uses-writable-held"),
        ("#throw 0 0", "book-uses-writable-used"),
        ("item replace entity @s weapon.mainhand with knowledge_book[recipes=[\"minecraft:diamond_axe\",\"minecraft:bread\"]]", "book-uses-knowledge-held"),
        ("#throw 0 0", "book-uses-knowledge-used"),
        ("item replace entity @s weapon.mainhand with knowledge_book", "book-uses-empty-held"),
        ("#throw 0 0", "book-uses-empty-used"),
        ("item replace entity @s weapon.mainhand with knowledge_book[recipes=[\"minecraft:no_such_recipe\"]]", "book-uses-unknown-held"),
        ("#throw 0 0", "book-uses-unknown-used"),
        ("gamemode creative", "book-uses-creative"),
        ("item replace entity @s weapon.mainhand with knowledge_book[recipes=[\"minecraft:golden_axe\"]]", "book-uses-creative-held"),
        ("#throw 0 0", "book-uses-creative-used"),
        ("", "book-uses-1"), ("", "book-uses-2"), ("", "book-uses-3"), ("", "book-uses-4"),
        ("", "book-uses-after"),
    ]
}

// `water-placing`' steps (CAL-214), where `bottle-fill`'s are: by day, the bot, in survival mode,
// with lily pads, looks at water two blocks before it and uses one, `PlaceOnWaterBlockItem.use`,
// which goes on the water; then again, at the lily pad, which can't hold one; at the sky; and at
// flowing water, which the look goes through to the grass below. It puts frogspawn on the water
// once that's a source again, and in creative mode a lily pad it keeps.
fn water_placing_steps() -> List<(str, str)> {
    return [
        ("time set day", "water-placing-day"),
        ("gamemode survival", "water-placing-survival"),
        ("item replace entity @s weapon.mainhand with lily_pad 3", "water-placing-held"),
        ("setblock 0 -60 2 water", "water-placing-water"),
        ("#throw 0 30", "water-placing-placed"),
        ("#throw 0 30", "water-placing-on-pad"),
        ("#throw 0 -90", "water-placing-sky"),
        ("setblock 0 -59 2 air", "water-placing-cleared"),
        ("setblock 0 -60 2 water[level=4]", "water-placing-flowing"),
        ("#throw 0 30", "water-placing-flowing-used"),
        ("setblock 0 -60 2 water", "water-placing-water-again"),
        ("item replace entity @s weapon.mainhand with frogspawn", "water-placing-frogspawn-held"),
        ("#throw 0 30", "water-placing-frogspawn-placed"),
        ("setblock 0 -59 2 air", "water-placing-cleared-again"),
        ("gamemode creative", "water-placing-creative"),
        ("item replace entity @s weapon.mainhand with lily_pad", "water-placing-creative-held"),
        ("#throw 0 30", "water-placing-creative-placed"),
        ("", "water-placing-1"), ("", "water-placing-2"), ("", "water-placing-3"), ("", "water-placing-4"),
        ("", "water-placing-after"),
    ]
}

// `spawn-eggs`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode, uses a
// cow spawn egg on the grass before it, `SpawnEggItem.useOn`, a cow spawned on it, moved up and
// down to the top; one at the grass in the air, which isn't a liquid, so nothing; one in the air
// at water east of it, `SpawnEggItem.use`, a cow in the water; and a named one on short grass,
// which has no collision, so in it. In creative mode a pig spawn egg it keeps.
fn spawn_eggs_steps() -> List<(str, str)> {
    return [
        ("time set day", "spawn-eggs-day"),
        ("gamemode survival", "spawn-eggs-survival"),
        ("item replace entity @s weapon.mainhand with cow_spawn_egg 3", "spawn-eggs-held"),
        ("#use 0 -61 3", "spawn-eggs-on-grass"),
        ("#throw 0 90", "spawn-eggs-at-grass"),
        ("setblock 2 -61 0 water", "spawn-eggs-water"),
        ("#throw -90 45", "spawn-eggs-at-water"),
        ("setblock 3 -60 0 short_grass", "spawn-eggs-short-grass"),
        ("item replace entity @s weapon.mainhand with cow_spawn_egg[custom_name=\"Bess\"]", "spawn-eggs-named-held"),
        ("#use 3 -60 0", "spawn-eggs-in-short-grass"),
        ("gamemode creative", "spawn-eggs-creative"),
        ("item replace entity @s weapon.mainhand with pig_spawn_egg", "spawn-eggs-pig-held"),
        ("#use -3 -61 0", "spawn-eggs-pig-spawned"),
        ("setblock 0 -61 -2 water", "spawn-eggs-north-water"),
        ("", "spawn-eggs-1"), ("", "spawn-eggs-2"), ("", "spawn-eggs-3"), ("", "spawn-eggs-4"),
        ("", "spawn-eggs-after"),
    ]
}

// `bundle-uses`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode, uses a
// bundle of three stacks, `BundleItem.use`, holding it till all are dropped before it,
// `onUseTick`, one on the first tick and the rest every other tick from the eleventh, and lets go;
// then a red bundle of two, looking aside; then an empty bundle, which drops nothing.
fn bundle_uses_steps() -> List<(str, str)> {
    return [
        ("time set day", "bundle-uses-day"),
