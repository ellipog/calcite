// What the bot does in `talk` and `select`: each of `steps` 20 ticks after the last, from 140,
// a request for suggestions where it begins with `/`, nothing but its mark where it's empty, a use
// of the head of the bed or the straw bed of `select`'s steps where it's `#use-bed` or
// `#use-straw`, and the bed left where it's `#leave-bed` (D574), an ender pearl thrown where it
// begins with `#pearl-`, `pearl_aim` (D579), the last end crystal sent hit where it's
// `#hit-crystal` (D590), else a command, then leaves.
fn talks(steps: List<(str, str)>) -> List<Dig> {
    var packets: List<Dug> = [Dug.Mark(100, "mate-joins")]
    var at: i64 = 140
    // The uses' sequence numbers (D574).
    var sequence = 100
    for (command, step) in steps {
        if String(command).starts_with("/") {
            packets.push(Dug.SuggestAt(command, at, step))
        } else if String(command) == "#use-bed" or String(command) == "#use-straw" {
            sequence += 1
            let z = if String(command) == "#use-bed" { 20 } else { 22 }
            packets.push(Dug.UseOnAt(21, -60, z, sequence, at, step))
        } else if String(command) == "#leave-bed" {
            packets.push(Dug.LeaveBedAt(at, step))
        } else if String(command) == "#hit-crystal" {
            packets.push(Dug.HitCrystalAt(at, step))
        } else if String(command).starts_with("#pearl-") {
            let (y_rot, x_rot) = pearl_aim(command)
            sequence += 1
            packets.push(Dug.UseItemTurnedAt(0, sequence, y_rot, x_rot, at, step))
            if String(command) == "#pearl-down" {
                sequence += 1
                packets.push(Dug.UseItemTurnedAt(0, sequence, y_rot, x_rot, at, "pearl-cooling"))
            }
        } else if String(command).is_empty() {
            packets.push(Dug.Mark(at, step))
        } else {
            packets.push(Dug.CommandAt(command, at, step))
        }
        at += 20
    }
    packets.push(Dug.Mark(at, "after"))
    packets.push(Dug.Leave(at + 40))
    return [Dig { name: String(), packets: packets }]
}

// Where `select`'s bot throws an ender pearl of the step `command` (D579), its yaw and pitch:
// straight down, as `#pearl-drop` too (D583), straight up (D580), up and far to the north-west,
// a little down to the south, at a pig (D581), and a little up to the north or south.
fn pearl_aim(command: str) -> (f32, f32) {
    if String(command) == "#pearl-down" or String(command) == "#pearl-drop" {
        return (0.0f32, 90.0f32)
    } else if String(command) == "#pearl-pig" {
        return (0.0f32, 20.0f32)
    } else if String(command) == "#pearl-up" {
        return (0.0f32, -90.0f32)
    } else if String(command) == "#pearl-far" {
        return (135.0f32, -20.0f32)
    } else if String(command) == "#pearl-north" {
        return (180.0f32, -5.0f32)
    }
    return (0.0f32, -5.0f32)
}

// What Mate does in `talk` and `select`: it stands where it joined, marking the bot's `steps`,
// and leaves `stay` ticks after the last, in `select` once the bot's left, so it sees the bot's
// ender pearl taken out of the level with it (D581).
fn talk_marks(steps: List<(str, str)>, stay: i64) -> List<Dig> {
    var packets = List<Dug>()
    var at: i64 = 140
    for (_, step) in steps {
        packets.push(Dug.Mark(at, step))
        at += 20
    }
    packets.push(Dug.Mark(at, "after"))
    packets.push(Dug.Leave(at + stay))
    return [Dig { name: String(), packets: packets }]
}

// What `checks` does on the `checks` fixture's world (D420), at the spawn, by the server's clock:
// at game time 200 a move 12 blocks south in one tick, too quick, which the server sends it back
// from; at 240 one through the wall, which stops it more than a quarter of a block short, wrong;
// at 280 two steps toward the wall and one a little into it, which its box didn't meet before;
// at 320 nine blocks up, by the ladder at the wall's north end, and two north; at 360 down past
// it in moves of a block and a half, a clip of what resets a fall, which forgets the fall
// before it, so the landing doesn't hurt (D422); at 400 five blocks up in half blocks, off the
// ground, where it floats, sending nothing more, till the server kicks it for floating; it'd
// leave at 600.
fn checks() -> List<Dig> {
    let quick: List<(f64, f64, f64, bool)> = [(0.5, -60.0, 12.5, true)]
    let through: List<(f64, f64, f64, bool)> = [(2.8, -60.0, 0.5, true)]
    let into: List<(f64, f64, f64, bool)> = [(1.0, -60.0, 0.5, true), (1.5, -60.0, 0.5, true), (1.9, -60.0, 0.5, true)]
    var climb: List<(f64, f64, f64, bool)> = [(1.5, -59.0, -0.5, false), (1.5, -58.0, -1.5, false)]
    for i in 1..8 {
        climb.push((1.5, -58.0 + f64(i), -1.5, false))
    }
    var fast = List<(f64, f64, f64, bool)>()
    for i in 1..7 {
        fast.push((1.5, -51.0 - f64(i) * 1.5, -1.5, i == 6))
    }
    var up = List<(f64, f64, f64, bool)>()
    for i in 1..11 {
        up.push((1.5, -60.0 + f64(i) * 0.5, 0.5, false))
    }
    var packets = List<Dug>()
    moves_at(quick, 200, "too-quick", mut packets)
    moves_at(through, 240, "through", mut packets)
    moves_at(into, 280, "into", mut packets)
    moves_at(climb, 320, "climb", mut packets)
    moves_at(fast, 360, "past-ladder", mut packets)
    moves_at(up, 400, "float", mut packets)
    packets.push(Dug.Leave(600))
    return [Dig { name: String(), packets: packets }]
}

// The moves of `path` onto `out`, each in a client's tick of its own, at the game time `at`, the
// first in a step named `step` (D418).
fn moves_at(path: List<(f64, f64, f64, bool)>, at: i64, step: str, out: mut List<Dug>) {
    var first = true
    for (x, y, z, ground) in path {
        out.push(Dug.MoveAt(x, y, z, ground, at, if first { step } else { "" }))
        first = false
    }
}

// The ways down of a fall from `y` at x, z, each a move as a client's tick makes it, faster
// each tick to 0.875, the last to `to`, onto the ground where it `lands` (D418). Each is a
// float's eighths, so the fall adds up exactly.
fn falling(x: f64, z: f64, y: f64, to: f64, lands: bool, path: mut List<(f64, f64, f64, bool)>) {
    let steps: List<f64> = [0.125, 0.25, 0.375, 0.5, 0.625, 0.75]
    var at = y
    for s in steps {
        if at - s <= to {
            break
        }
        at = at - s
        path.push((x, at, z, false))
    }
    while at - 0.875 > to {
        at = at - 0.875
        path.push((x, at, z, false))
    }
    path.push((x, to, z, lands))
}

// What `fall` does on the `fall` fixture's world (D418), on its pillar 30 up, facing east with an
// iron sword, by the server's clock, each fall under 10 blocks, as vanilla lets a tick's moves
// go: from game time 200 it walks off east and falls nine onto the honey, which takes four
// fifths of the hurt; at 240 off the honey into the basin's water, which forgets the fall; at 280
// it climbs out onto the basin's wall, jumping as it leaves the ground; at 320 it walks off the
// wall and falls nine to the platform, hitting the cow halfway down, a critical hit; then a step
// from 360 as its health comes back, and it leaves at 480.
fn falls() -> List<Dig> {
    var honey = List<(f64, f64, f64, bool)>()
    honey.push((0.9, -30.0, 0.5, true))
    honey.push((1.4, -30.0, 0.5, false))
    honey.push((1.8, -30.125, 0.5, false))
    honey.push((2.2, -30.375, 0.5, false))
    honey.push((2.5, -30.75, 0.5, false))
    falling(2.5, 0.5, -30.75, -39.0625, true, mut honey)
    var water = List<(f64, f64, f64, bool)>()
    water.push((2.9, -39.0625, 0.5, true))
    water.push((3.4, -39.0625, 0.5, false))
    water.push((3.8, -39.1875, 0.5, false))
    water.push((4.2, -39.4375, 0.5, false))
    water.push((4.6, -39.8125, 0.5, false))
    water.push((5.0, -40.3125, 0.5, false))
    water.push((5.5, -40.9375, 0.5, false))
    falling(5.5, 0.5, -40.9375, -48.0, true, mut water)
    let climb: List<(f64, f64, f64, bool)> = [(6.2, -48.0, 0.5, true), (6.2, -47.5, 0.5, false), (6.6, -47.0, 0.5, false), (7.3, -47.0, 0.5, true)]
    var down = List<(f64, f64, f64, bool)>()
    down.push((7.7, -47.0, 0.5, true))
    down.push((8.4, -47.0, 0.5, false))
    falling(8.4, 0.5, -47.0, -51.5, false, mut down)
    var rest = List<(f64, f64, f64, bool)>()
    falling(8.4, 0.5, -51.5, -56.0, true, mut rest)
    var packets = List<Dug>()
    moves_at(honey, 200, "honey", mut packets)
    moves_at(water, 240, "water", mut packets)
    moves_at(climb, 280, "climb", mut packets)
    moves_at(down, 320, "crit-fall", mut packets)
    packets.push(Dug.Hit(false, 0, 320, ""))
    moves_at(rest, 320, "", mut packets)
    packets.push(Dug.Mark(360, "after"))
    packets.push(Dug.Leave(480))
    return [Dig { name: String(), packets: packets }]
}

// What `mace` does on the `mace` fixture's world (D443), on its pillar 12 up, facing east with a
// mace with density III and breach IV, by the server's clock: from game time 200 it walks off east
// and falls nine onto the column, smashing the zombie on the ground seven blocks down, heavy, which
// pushes the cow and the stand by him twice as far, its fall gone after, so its landing doesn't
// hurt but throws up the smash's dust; at 260 it walks off the column south and falls three to
// the ground, smashing the cow, which isn't on the ground, two and five eighths down, a smash in
// the air, which pushes the zombie; at 320 it hits him from the ground, which isn't a smash; then
// a step from 340 as what was pushed comes to rest, and it leaves at 440.
fn maces() -> List<Dig> {
    var heavy = List<(f64, f64, f64, bool)>()
    heavy.push((0.9, -48.0, 0.5, true))
    heavy.push((1.4, -48.0, 0.5, false))
    falling(1.5, 0.5, -48.0, -55.0, false, mut heavy)
    var landing = List<(f64, f64, f64, bool)>()
    falling(1.5, 0.5, -55.0, -57.0, true, mut landing)
    var light = List<(f64, f64, f64, bool)>()
    light.push((1.5, -57.0, 0.9, true))
    light.push((1.5, -57.0, 1.4, false))
    falling(1.5, 1.5, -57.0, -59.625, false, mut light)
    var ground = List<(f64, f64, f64, bool)>()
    falling(1.5, 1.5, -59.625, -60.0, true, mut ground)
    var packets = List<Dug>()
    moves_at(heavy, 200, "heavy-smash", mut packets)
    packets.push(Dug.HitZombie(0, 200, ""))
    moves_at(landing, 200, "", mut packets)
    moves_at(light, 260, "light-smash", mut packets)
    packets.push(Dug.Hit(false, 0, 260, ""))
    moves_at(ground, 260, "", mut packets)
    packets.push(Dug.HitZombie(0, 320, "ground-hit"))
    packets.push(Dug.Mark(340, "after"))
    packets.push(Dug.Leave(440))
    return [Dig { name: String(), packets: packets }]
}

// What `swim` does on the `swim` fixture's world (D444), at the spawn facing east, looking a little
// down, with bread in its hand, by the server's clock: from game time 200 it sprints east on the
// grass, a quarter of a block a tick, its sprint's particles drawing from its random, and drops a
// loaf at 212, whose throw shows what its random's drawn; at 220 it sprints on into the pool,
// sinks and, its eyes under water, swims, its pose swimming; at 240 it stops sprinting, which
// ends its swim, at 250 sprints again, swimming on to the far side, where at 265 it rises and
// climbs out onto the grass, which ends its swim; it drops another loaf at 290, and leaves at 340.
fn swims() -> List<Dig> {
    var dry = List<(f64, f64, f64, bool)>()
    for i in 1..11 {
        dry.push((0.5 + f64(i) * 0.25, -60.0, 0.5, true))
    }
    let into: List<(f64, f64, f64, bool)> = [(3.4, -60.0, 0.5, true), (3.8, -60.0, 0.5, false), (4.4, -60.0, 0.5, false), (4.6, -60.4, 0.5, false), (4.9, -61.0, 0.5, false), (5.2, -61.7, 0.5, false), (5.5, -62.4, 0.5, false), (5.8, -62.75, 0.5, false)]
    var across = List<(f64, f64, f64, bool)>()
    for i in 1..6 {
        across.push((5.8 + f64(i) * 0.4, -62.75, 0.5, false))
    }
    let slow: List<(f64, f64, f64, bool)> = [(8.2, -62.75, 0.5, false), (8.6, -62.75, 0.5, false)]
    var again = List<(f64, f64, f64, bool)>()
    for i in 1..7 {
        again.push((8.6 + f64(i) * 0.4, -62.75, 0.5, false))
    }
    let out: List<(f64, f64, f64, bool)> = [(11.0, -62.0, 0.5, false), (11.0, -61.2, 0.5, false), (11.0, -60.4, 0.5, false), (11.0, -59.8, 0.5, false), (11.6, -59.9, 0.5, false), (12.2, -60.0, 0.5, true)]
    var packets = List<Dug>()
    packets.push(Dug.SprintAt(true, 200, "sprint"))
    moves_at(dry, 200, "", mut packets)
    packets.push(Dug.DropAt(212, "drop-dry"))
    moves_at(into, 220, "into-water", mut packets)
    moves_at(across, 230, "swim", mut packets)
    packets.push(Dug.SprintAt(false, 240, "stop"))
    moves_at(slow, 242, "", mut packets)
    packets.push(Dug.SprintAt(true, 250, "swim-again"))
    moves_at(again, 252, "", mut packets)
    moves_at(out, 265, "climb-out", mut packets)
    packets.push(Dug.DropAt(290, "drop-after"))
    packets.push(Dug.Leave(340))
    return [Dig { name: String(), packets: packets }]
}

// What `frost` does on the `frost` fixture's world (D524), at the spawn facing east in boots with
// frost walker II, by the server's clock: from game time 200 it walks east on the ground, as the
// server's clock comes each second three blocks, a quarter of a block a client's tick, over the
// pool on the frosted ice each block it ends a tick in freezes around it, onto the grass beyond;
// it stays as the ice melts, and leaves at 900.
fn frosts() -> List<Dig> {
    var packets = List<Dug>()
    for burst in 0..5 {
        var path = List<(f64, f64, f64, bool)>()
        for i in 1..13 {
            path.push((0.5 + f64(burst * 12 + i) * 0.25, -60.0, 0.5, true))
        }
        moves_at(path, 200 + i64(burst) * 20, if burst == 0 { "walk" } else { "" }, mut packets)
    }
    packets.push(Dug.Leave(900))
    return [Dig { name: String(), packets: packets }]
}

// What `soul` does on the `soul` fixture's world (D525), on its soul sand facing east in boots
// with soul speed III, by the server's clock: from game time 200 it walks on the ground, as the
// server's clock comes each second three blocks, a quarter of a block a client's tick, east to
// eight blocks on, back and on again, four times over; and leaves at 760.
fn souls() -> List<Dig> {
    var packets = List<Dug>()
    for burst in 0..22 {
        var path = List<(f64, f64, f64, bool)>()
        for i in 1..13 {
            let phase = (burst * 12 + i) % 64
            let along = if phase <= 32 { phase } else { 64 - phase }
            path.push((3.5 + f64(along) * 0.25, -60.125, 0.5, true))
        }
        moves_at(path, 200 + i64(burst) * 20, if burst == 0 { "walk" } else { "" }, mut packets)
    }
    packets.push(Dug.Leave(760))
    return [Dig { name: String(), packets: packets }]
}

// What `enchant` does on the `enchant` fixture's world (D438), at the spawn facing east with an
// iron sword with smite V, by the server's clock from game time 200: the cow hit, which smite adds
// nothing to, nor to the sheep its sweep hurts; a wooden sword with sharpness I and knockback II
// taken, and the zombie hit, its damage added to, a magic critical hit, and knocked back further;
// one with fire aspect II taken, and the sheep hit, which lights it and the cow its sweep hurts;
// the smite sword taken again, and the zombie killed; then, from game time 360, a step as the cow
// and the sheep burn to death, their meat cooked, and their orbs come, till it leaves at 560.
fn enchants() -> List<Dig> {
    return [
        Dig { name: String(), packets: [
            Dug.Hit(false, 0, 200, "smite-cow"),
            Dug.HoldAt(1, 220, "hold-sharp"),
            Dug.HitZombie(0, 240, "sharp-zombie"),
            Dug.HoldAt(2, 260, "hold-fire"),
            Dug.Hit(true, 0, 280, "fire-sheep"),
            Dug.HoldAt(0, 300, "hold-smite"),
            Dug.HitZombie(0, 320, "smite-zombie"),
            Dug.Mark(360, "burn"),
            Dug.Leave(560),
        ] },
    ]
}

// What `protect` does on the `protect` fixture's world (D439), at the spawn facing east with an
// iron sword, by the server's clock from game time 200: each of the three zombies the server sent
// hit in turn, one every 20 ticks, so each is hit every 60, till game time 500, its enchanted
// armor's protection taking its share where it's against an attack; then a step as the last
// die, till it leaves at 640.
fn protects() -> List<Dig> {
    var packets = List<Dug>()
    var at = 200i64
    var k = 0usize
    while at <= 500i64 {
        packets.push(Dug.HitZombie(k, at, if at == 200i64 { "hit-zombies" } else { "" }))
        k = (k + 1usize) % 3usize
        at += 20i64
    }
    packets.push(Dug.Mark(520, "after"))
    packets.push(Dug.Leave(640))
    return [Dig { name: String(), packets: packets }]
}

// What `bane` does on the `bane` fixture's world (D512), at the spawn holding a sword with bane of
// arthropods I, by the server's clock from once it's loaded: it hits Webs, the spider without AI,
// at 200, which slows it for a second and a half, and again at 300, once that's worn off; and it
// leaves at 400.
fn bane_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "idle"))
    packets.push(Dug.HitZombie(0, 200, "hit-webs"))
    packets.push(Dug.HitZombie(0, 300, "hit-webs-again"))
    packets.push(Dug.Mark(360, "after"))
    packets.push(Dug.Leave(400))
    return [Dig { name: String(), packets: packets }]
}

// What `stand-hits` does on the `stand_hits` fixture's world (D441), at the spawn with `enchant`'s
// iron sword with smite V, by the server's clock from game time 200, each stand by where it was
// first sent, as the servers send them in an order of their own, while the two in fire and on a
// campfire burn: Bob hit, which shakes him and sweeps the bare stand beside him, knocking it
// back; hit again 30
// ticks on, which shakes him again; then 3 ticks on, which breaks him, his helmet and himself,
// named, dropped; the wooden sword with fire aspect II taken, and the stand in a chestplate hit,
// which lights it; the smite sword taken again, and the invisible stand and the marker hit, which
// no hit hurts; and the stand the first sweep knocked back hit; then a step as the lit stand burns
// to its breaking, till it leaves at 460.
fn stand_hits() -> List<Dig> {
    return [
        Dig { name: String(), packets: [
            Dug.HitStand(2.5, 0.5, 200, "hit-bob"),
            Dug.HitStand(2.5, 0.5, 230, "hit-bob-again"),
            Dug.HitStand(2.5, 0.5, 233, "break-bob"),
            Dug.HoldAt(2, 250, "hold-fire"),
            Dug.HitStand(2.5, -4.5, 270, "light-stand"),
            Dug.HoldAt(0, 300, "hold-smite"),
            Dug.HitStand(2.5, 4.5, 320, "hit-invisible"),
            Dug.HitStand(2.5, -0.5, 325, "hit-marker"),
            Dug.HitStand(2.5, 1.75, 330, "hit-swept"),
            Dug.Mark(340, "burn"),
            Dug.Leave(460),
        ] },
    ]
}

// What `thorns` does on the `thorns` fixture's world (D442), at the spawn facing east with empty
// hands, by the server's clock from game time 200: Spike, the zombie in thorns, hit three times,
// 15 ticks apart, his thorns hurting the bot back, which knocks it back and brings it into
// combat; a step as its combat ends, 300 of its ticks after its last hurt; then Spike hit every 15
// ticks from game time 600, eight times, the last of which his thorns kill it with, its death's
// message naming him; then it leaves at 715, dead, before it's taken out and respawns, which
// pairs what's around it again only where vanilla took its teleport's accept after its first
// chunks, a race of vanilla's own (`death` respawns).
fn thorns_hits() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.HitZombie(0, 200, "hit-spike"))
    packets.push(Dug.HitZombie(0, 215, ""))
    packets.push(Dug.HitZombie(0, 230, ""))
    packets.push(Dug.Mark(400, "combat-ends"))
    var at = 600i64
    while at <= 705i64 {
        packets.push(Dug.HitZombie(0, at, if at == 600i64 { "hit-to-death" } else { "" }))
        at += 15i64
    }
    packets.push(Dug.Leave(715))
    return [Dig { name: String(), packets: packets }]
}

// What `zombie` does on the `zombie` fixture's world (CAL-159), at the spawn with empty hands, by
// the server's clock, its steps from once it's loaded, as Rot never lets the server go quiet: it
// stands while Rot, the zombie six blocks east with his AI, takes it up, comes for it and hits it;
// at 200 it hits him back once, so he's hurt by it; then he hits it till it dies, and it leaves at
// 250, dead, before it's taken out of its level and respawns, as whether a respawn that quick
// comes before the dead player's chunks drop is a race of its answer (D446).
fn hunted_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "hunted"))
    packets.push(Dug.HitZombie(0, 200, "hit-back"))
    packets.push(Dug.Mark(210, "hit-to-death"))
    packets.push(Dug.Leave(250))
    return [Dig { name: String(), packets: packets }]
}

// What `villager` does on the `villager` fixture's world (CAL-160), at the spawn with empty
// hands, by the server's clock from once it's loaded: it stands by the villagers, who have no AI;
// at 200 it uses Ada, grown with no profession, who has no trades, which makes her unhappy; at
// 260 it uses Bo, a baby, which makes him unhappy; at 320 it hits Fen, a desert farmer, and at
// 380 Ada, each of whom then gossips of it; at 540 it uses Fen, who makes her offers as they're
// first asked for and trades with it, opening its merchant menu; at 544 it picks her second
// trade, an emerald for pumpkins, which moves its pumpkins into the menu; at 548 it takes the
// emerald, which trades, an orb made of it; at 550 it uses her again, which does nothing as she
// trades; at 552 it shift-clicks the emerald, which trades till its pumpkins run out; at 556
// it hits her, which prices her offers again and sends them; at 566 it closes the menu, and at
// 576 uses her again, which opens another; and it leaves at 600, with that menu open.
fn villager_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "idle"))
    packets.push(Dug.UseVillager(2.5, 0.5, 200, "use-ada"))
    packets.push(Dug.UseVillager(0.5, 2.5, 260, "use-bo"))
    packets.push(Dug.HitVillager(2.5, 2.5, 320, "hit-fen"))
    packets.push(Dug.HitVillager(2.5, 0.5, 380, "hit-ada"))
    packets.push(Dug.Mark(440, "after"))
    packets.push(Dug.UseVillager(2.5, 2.5, 540, "use-fen"))
    packets.push(Dug.SelectAt(1, 544, "pick-pumpkins"))
    // A vanilla client's guess: the emerald on the cursor and 8 of the pumpkins paid.
    packets.push(Dug.ClickAt(press(2i16, 0i8, 0, [(2i16, nothing()), (0i16, plain("pumpkin", 32))], plain("emerald", 1)), 548, "take-emerald"))
    packets.push(Dug.UseVillager(2.5, 2.5, 550, "use-fen-trading"))
    packets.push(Dug.ClickAt(press(2i16, 0i8, 1, [], plain("emerald", 1)), 552, "shift-emeralds"))
    packets.push(Dug.HitVillager(2.5, 2.5, 556, "hit-fen-trading"))
    packets.push(Dug.CloseAt(566, "close-fen"))
    packets.push(Dug.UseVillager(2.5, 2.5, 576, "use-fen-again"))
    packets.push(Dug.Leave(600))
    return [Dig { name: String(), packets: packets }]
}

