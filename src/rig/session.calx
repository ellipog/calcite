        ("kill @e[type=leash_knot,tag=dm]", "knot-gone"),
        ("setblock ~3 ~ ~-3 minecraft:air", "knot-fence-gone"),
        ("summon minecraft:lightning_bolt ~8 ~ ~8 \{Tags:[\"dm\"],Silent:1b\}", "bolt-summon"),
        ("summon minecraft:wolf ~2 ~ ~-4 \{Tags:[\"eo\"],NoAI:1b\}", "on-wolf"),
        ("data modify entity @e[type=wolf,tag=eo,limit=1] Owner set from entity @s UUID", "on-wolf-owned"),
        ("execute as @e[type=wolf,tag=eo] on owner run say mine", "on-owner"),
        ("execute as @e[type=wolf,tag=eo] on origin run say none", "on-origin-none"),
        ("summon minecraft:zombie ~3 ~ ~-4 \{Tags:[\"eo\"],NoAI:1b,PersistenceRequired:1b\}", "on-zombie"),
        ("execute as @e[type=zombie,tag=eo] on attacker run say none", "on-attacker-none"),
        ("damage @e[type=zombie,tag=eo,limit=1] 1 minecraft:mob_attack by @e[type=wolf,tag=eo,limit=1]", "on-hit"),
        ("execute as @e[type=zombie,tag=eo] on attacker run say hit", "on-attacker"),
        ("execute as @e[type=zombie,tag=eo] on target run say none", "on-target-none"),
        ("ride @e[type=zombie,tag=eo,limit=1] mount @e[type=wolf,tag=eo,limit=1]", "on-ride"),
        ("execute as @e[type=wolf,tag=eo] on passengers run say up", "on-passengers"),
        ("execute as @e[type=zombie,tag=eo] on vehicle run say down", "on-vehicle"),
        ("execute as @e[type=wolf,tag=eo] on controller run say none", "on-controller-none"),
        ("execute as @e[type=wolf,tag=eo] on passengers on vehicle on owner run say round", "on-chain"),
        ("execute on vehicle run say none", "on-player-vehicle"),
        ("execute on owner run say none", "on-player-owner"),
        ("summon minecraft:arrow ~ ~6 ~ \{Tags:[\"eo\"],NoGravity:1b\}", "on-arrow"),
        ("data modify entity @e[type=arrow,tag=eo,limit=1] Owner set from entity @s UUID", "on-arrow-owned"),
        ("execute as @e[type=arrow,tag=eo] on origin run say shot", "on-origin"),
        ("execute positioned ~5 ~ ~-5 summon minecraft:pig run tag @s add eo", "execute-summon-pig"),
        ("execute positioned ~4 ~ ~-6 summon minecraft:armor_stand run data merge entity @s \{Tags:[\"eo\"],Invisible:1b\}", "execute-summon-stand"),
        ("execute as @e[tag=eo] run say here", "execute-summon-all"),
        ("kill @e[tag=eo]", "on-gone"),
        ("tick rate 20", "tick-rate"),
        ("tick rate 0.5", "tick-rate-low"),
        ("tick step", "tick-step-unfrozen"),
        ("tick step stop", "tick-step-stop-none"),
        ("tick sprint stop", "tick-sprint-stop-none"),
        ("tick unfreeze", "tick-unfreeze-running"),
        ("summon minecraft:pig ~3 ~ ~3 \{Tags:[\"tk\"],Motion:[0.0,0.6,0.0]\}", "tick-pig"),
        // Each step's sent at a game time, which a frozen game's doesn't reach: what's done frozen
        // goes in one tick, ending with a step of a second, which takes the game to the next.
        ("#all tick freeze;summon minecraft:armor_stand ~-3 ~4 ~3 \{Tags:[\"tk\"]\};time query gametime;tick freeze;tick step 1s", "tick-freeze"),
        ("#all tick step stop;tick step stop;tick step 2;tick step 1s", "tick-step-stop"),
        ("tick unfreeze", "tick-unfreeze"),
        ("time query gametime", "tick-time-running"),
        ("kill @e[tag=tk]", "tick-gone"),
        // The admin commands (CAL-361), of names over 16 characters, which neither server looks
        // up, so each is given its offline profile, in lower case, and of the bot, who's never
        // banned or taken off a list, so they're never kicked.
        ("op NobodyAtAllHere17x", "admin-op"),
        ("op NobodyAtAllHere17x", "admin-op-again"),
        ("op Bot", "admin-op-bot"),
        ("op AnotherNobodyHere19", "admin-op-two"),
        ("/deop ", "admin-suggest-deop"),
        ("/op ", "admin-suggest-op"),
        ("deop NobodyAtAllHere17x", "admin-deop"),
        ("deop NobodyAtAllHere17x", "admin-deop-again"),
        ("deop AnotherNobodyHere19", "admin-deop-two"),
        ("ban NobodyAtAllHere17x Gone for now", "admin-ban"),
        ("ban AnotherNobodyHere19", "admin-ban-two"),
        ("ban NobodyAtAllHere17x", "admin-ban-again"),
        ("ban @e[type=pig]", "admin-ban-entities"),
        ("banlist players", "admin-banlist-players"),
        ("/pardon ", "admin-suggest-pardon"),
        ("ban-ip 10.20.30.40 Spam", "admin-ban-ip"),
        ("ban-ip 10.20.30.40", "admin-ban-ip-again"),
        ("ban-ip 10.20.30.041", "admin-ban-ip-invalid"),
        ("ban-ip Nobody", "admin-ban-ip-nobody"),
        ("ban-ip fe80::1", "admin-ban-ip-six"),
        ("banlist", "admin-banlist"),
        ("banlist ips", "admin-banlist-ips"),
        ("/pardon-ip ", "admin-suggest-pardon-ip"),
        ("pardon NobodyAtAllHere17x", "admin-pardon"),
        ("pardon NobodyAtAllHere17x", "admin-pardon-again"),
        ("pardon AnotherNobodyHere19", "admin-pardon-two"),
        ("pardon-ip 10.20.30.40", "admin-pardon-ip"),
        ("pardon-ip 10.20.30.40", "admin-pardon-ip-again"),
        ("pardon-ip nonsense", "admin-pardon-ip-invalid"),
        ("pardon-ip fe80::1", "admin-pardon-ip-six"),
        ("banlist", "admin-banlist-none"),
        ("whitelist list", "admin-whitelist-list"),
        ("whitelist add NobodyAtAllHere17x", "admin-whitelist-add"),
        ("whitelist add NobodyAtAllHere17x", "admin-whitelist-add-again"),
        ("whitelist add @s", "admin-whitelist-add-bot"),
        ("whitelist add AnotherNobodyHere19", "admin-whitelist-add-two"),
        ("whitelist list", "admin-whitelist-listed"),
        ("/whitelist remove ", "admin-suggest-whitelist-remove"),
        ("/whitelist add ", "admin-suggest-whitelist-add"),
        ("whitelist remove NobodyAtAllHere17x", "admin-whitelist-remove"),
        ("whitelist remove NobodyAtAllHere17x", "admin-whitelist-remove-again"),
        ("whitelist remove AnotherNobodyHere19", "admin-whitelist-remove-two"),
        ("whitelist on", "admin-whitelist-on-already"),
        ("whitelist off", "admin-whitelist-off"),
        ("whitelist off", "admin-whitelist-off-already"),
        ("whitelist on", "admin-whitelist-on"),
        ("whitelist reload", "admin-whitelist-reload"),
        ("whitelist list", "admin-whitelist-reloaded"),
        // `spectate` (CAL-358): not in spectator mode, then a stand watched, moved, the bot's own
        // self, stopped, the stand's death ending it, and survival again. No teleport: one while
        // watching has the bot's next move kicked as `invalid_player_movement`, by both servers.
        ("summon minecraft:armor_stand ~3 ~ ~3 \{Tags:[\"sp\"],NoGravity:1b\}", "spectate-stand"),
        ("spectate @e[type=armor_stand,tag=sp,limit=1]", "spectate-not-spectator"),
        ("gamemode spectator", "spectate-mode"),
        ("spectate @e[type=armor_stand,tag=sp,limit=1]", "spectate-start"),
        ("tp @e[type=armor_stand,tag=sp,limit=1] ~2 ~ ~", "spectate-follow"),
        ("spectate @s", "spectate-self"),
        ("spectate", "spectate-stop"),
        ("spectate @e[type=armor_stand,tag=sp,limit=1]", "spectate-again"),
        ("spectate @e[type=armor_stand,tag=sp,limit=1]", "spectate-third"),
        ("kill @e[type=armor_stand,tag=sp]", "spectate-gone"),
        ("spectate @e[type=armor_stand,tag=sp,limit=1]", "spectate-none"),
        ("gamemode survival", "spectate-survival"),
        // `debug`, `perf`, `jfr` and `fetchprofile` (CAL-363): the profiler stopped before it
        // runs, started and stopped in one tick, which leaves it starting at the next all the
        // same; `return run` of a trace; a recording that isn't running; the Flight Recorder; the
        // bot's own profile, a name no player can have, and a pig's, which it hasn't.
        ("debug stop", "debug-not-running"),
        ("#all debug start;debug start;debug stop", "debug-same-tick"),
        ("debug start", "debug-already"),
        ("return run debug function minecraft:nope", "debug-return-run"),
        ("perf stop", "perf-not-running"),
        ("jfr stop", "jfr-stop"),
        ("fetchprofile entity @s", "fetchprofile-self"),
        ("fetchprofile name NobodyAtAllHere17x", "fetchprofile-bad-name"),
        ("summon minecraft:pig ~2 ~ ~ \{Tags:[\"fp\"],NoAI:1b\}", "fetchprofile-pig"),
        ("fetchprofile entity @e[type=pig,tag=fp,limit=1]", "fetchprofile-no-profile"),
        // `compute` (CAL-364): named providers with no block and at one, a sum, a constant exact
        // and scaled, a division by zero as an int and as a float, 0 to the power of 0, a storage's
        // number, the pig's score and the bot's, a block too far, an entity that isn't there.
        ("compute default float minecraft:cooking/speed_default", "compute-named"),
        ("compute block ~ ~-1 ~ float minecraft:cooking/speed_default 10", "compute-named-block"),
        ("compute default integer minecraft:compostable/medium", "compute-named-int"),
        ("compute default integer \{type:\"minecraft:add\",inputs:[1,2,\{type:\"minecraft:mul\",inputs:[3,4]\}]\}", "compute-sum"),
        ("compute default float \{type:\"minecraft:constant\",value:2.0\}", "compute-exact"),
        ("compute default float \{type:\"minecraft:constant\",value:2.5\} 4", "compute-rounded"),
        ("compute default integer \{type:\"minecraft:div\",left:1,right:0\}", "compute-int-by-zero"),
        ("compute default float \{type:\"minecraft:div\",left:1,right:0\}", "compute-float-by-zero"),
        ("compute default integer \{type:\"minecraft:pow\",base:0,exponent:0\}", "compute-zero-pow"),
        ("data modify storage rig:compute n set value 6", "compute-store"),
        ("compute default integer \{type:\"minecraft:storage\",storage:\"rig:compute\",path:\"n\",fallback:1\}", "compute-storage"),
        ("#all scoreboard objectives add cx dummy;scoreboard players set @e[type=pig,tag=fp] cx 9;scoreboard players set @s cx 4", "compute-scores"),
        ("compute entity @e[type=pig,tag=fp,limit=1] integer \{type:\"minecraft:add\",inputs:[\{type:\"minecraft:score\",target:\"target_entity\",score:\"cx\"\},\{type:\"minecraft:score\",target:\"this\",score:\"cx\"\}]\}", "compute-score"),
        ("compute default integer \{type:\"minecraft:score\",target:\"target_entity\",score:\"cx\",fallback:-1\}", "compute-score-fallback"),
        ("compute block ~3000 ~ ~ integer \{type:\"minecraft:constant\",value:1\}", "compute-unloaded"),
        ("compute entity @e[type=cow,limit=1] integer \{type:\"minecraft:constant\",value:1\}", "compute-no-entity"),
        ("scoreboard objectives remove cx", "compute-cleared"),

        ("kill @e[type=!player]", "swing-cleared"),
        // In peaceful a bee the bot hurts doesn't take it as its target, `canAttack` (CAL-281).
        ("difficulty peaceful", "peaceful-on"),
        ("summon bee ~2 ~1 ~ \{Tags:[\"pb\"]\}", "peaceful-bee"),
        ("damage @e[type=bee,tag=pb,limit=1] 1 minecraft:player_attack by @s", "peaceful-bee-hit"),
        ("#wait 1", "peaceful-bee-waited"),
        ("data get entity @e[type=bee,tag=pb,limit=1] anger_end_time", "peaceful-bee-anger"),
        ("kill @e[type=bee]", "peaceful-bee-gone"),
        ("difficulty normal", "peaceful-off"),

        ("", "world-after"),
    ]
}

// `map-extending`'s steps (CAL-338): the bot, in survival, uses an empty map, which makes map 0;
// at a crafting table it puts the map in the grid's middle and a paper in each slot about it,
// which shows the map with `SCALE`; that's shift-clicked out, which makes map 1 a scale up; then
// the menu's closed and the inventory read.
fn map_extending_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "extend-survival"),
        ("item replace entity @s weapon.mainhand with map", "extend-empty"),
        ("#throw 0 0", "extend-made"),
        ("item replace entity @s hotbar.1 with paper 8", "extend-paper"),
        ("setblock 0 -60 2 crafting_table", "extend-placed"),
        ("#use 0 -60 2", "extend-open"),
        ("#click 37 0 0", "extend-map-up"),
        ("#click 5 0 0", "extend-map-down"),
        ("#click 38 0 0", "extend-paper-up"),
        ("#click 1 1 0", "extend-paper-1"),
        ("#click 2 1 0", "extend-paper-2"),
        ("#click 3 1 0", "extend-paper-3"),
        ("#click 4 1 0", "extend-paper-4"),
        ("#click 6 1 0", "extend-paper-6"),
        ("#click 7 1 0", "extend-paper-7"),
        ("#click 8 1 0", "extend-paper-8"),
        ("#click 9 1 0", "extend-paper-9"),
        ("#click 0 0 1", "extend-shifted"),
        ("#close", "extend-closed"),
        ("data get entity @s Inventory", "extend-inventory"),
        ("setblock 0 -60 2 air", "extend-broken"),
        ("", "extend-after"),
    ]
}

// `recipe-book`'s steps (CAL-339): the bot, in survival, learns the crafting table's, the
// stick's, the furnace's and raw iron's smelting recipes from a knowledge book, then with nine
// oak planks places the crafting table, display 339, in its inventory's grid, once, then once
// more, then as many as can be, which is no more; the furnace, 657, which it has too little for,
// putting the planks back and showing its ghost; and as many sticks, 1421, as can be. It closes
// its inventory. At a crafting table it places the crafting table, the furnace's ghost and as
// many sticks as can be, down the grid's middle, and closes it; at a furnace, with five raw iron,
// the smelting, 768, as many as can be, then once, which is no more, and closes it; then the
// furnace's data's read.
fn recipe_book_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "recipe-book-survival"),
        ("item replace entity @s weapon.mainhand with knowledge_book[recipes=[\"minecraft:crafting_table\",\"minecraft:stick\",\"minecraft:furnace\",\"minecraft:iron_ingot_from_smelting_raw_iron\"]]", "recipe-book-knowledge"),
        ("#throw 0 0", "recipe-book-learned"),
        ("item replace entity @s hotbar.0 with oak_planks 9", "recipe-book-planks"),
        ("item replace entity @s hotbar.1 with raw_iron 5", "recipe-book-iron"),
        ("#recipe-inventory 339 one", "recipe-book-table"),
        ("#recipe-inventory 339 one", "recipe-book-table-more"),
        ("#recipe-inventory 339 max", "recipe-book-table-most"),
        ("#recipe-inventory 657 one", "recipe-book-furnace-ghost"),
        ("#recipe-inventory 1421 max", "recipe-book-sticks"),
        ("#close", "recipe-book-inventory-closed"),
        ("setblock 0 -60 2 crafting_table", "recipe-book-table-placed"),
        ("#use 0 -60 2", "recipe-book-table-open"),
        ("#recipe 339 one", "recipe-book-table-in-table"),
        ("#recipe 657 one", "recipe-book-furnace-ghost-in-table"),
        ("#recipe 1421 max", "recipe-book-sticks-in-table"),
        ("#close", "recipe-book-table-closed"),
        ("setblock 0 -60 2 furnace", "recipe-book-furnace-placed"),
        ("#use 0 -60 2", "recipe-book-furnace-open"),
        ("#recipe 768 max", "recipe-book-smelt"),
        ("#recipe 768 one", "recipe-book-smelt-more"),
        ("#close", "recipe-book-furnace-closed"),
        ("data get block 0 -60 2", "recipe-book-furnace-data"),
        ("", "recipe-book-after"),
    ]
}

// `spear-kill`'s steps (CAL-331), `spear-villager`'s with the villager on its own 20 health:
// the zombie's spear kills it, and what the zombie does after is compared.
fn spear_kill_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "spear-kill-night"),
        ("gamemode creative", "spear-kill-creative"),
        ("summon villager 0.5 -60 6.5 \{NoAI:1b,PersistenceRequired:1b\}", "spear-kill-villager"),
        ("summon zombie 0.5 -60 16.5 \{PersistenceRequired:1b,equipment:\{mainhand:\{id:iron_spear,components:\{enchantments:\{sharpness:3,knockback:1,fire_aspect:1\}\}\}\}\}", "spear-kill-zombie"),
        ("", "spear-kill-1"), ("", "spear-kill-2"), ("", "spear-kill-3"), ("", "spear-kill-4"), ("", "spear-kill-5"),
        ("", "spear-kill-6"), ("", "spear-kill-7"), ("", "spear-kill-8"), ("", "spear-kill-9"), ("", "spear-kill-10"),
        ("", "spear-kill-after"),
    ]
}

// `spear-villager`'s steps (CAL-214), where `talk`'s are: at midnight, the bot, in creative mode,
// which zombies don't hunt, summons a villager without AI and with 200 health, so it lives
// through it (CAL-331), six blocks south of it and a zombie
// with an iron spear of sharpness III, knockback I and fire aspect I sixteen south, which comes
// to the villager, lowers its spear and charges, each stab hurting it the more, knocking it the
// further and setting it on fire. It watches for 15 seconds.
fn spear_villager_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "spear-villager-night"),
        ("gamemode creative", "spear-villager-creative"),
        ("summon villager 0.5 -60 6.5 \{NoAI:1b,PersistenceRequired:1b,Health:200.0f,attributes:[\{id:\"minecraft:max_health\",base:200.0d\}]\}", "spear-villager-villager"),
        ("summon zombie 0.5 -60 16.5 \{PersistenceRequired:1b,equipment:\{mainhand:\{id:iron_spear,components:\{enchantments:\{sharpness:3,knockback:1,fire_aspect:1\}\}\}\}\}", "spear-villager-zombie"),
        ("", "spear-villager-1"), ("", "spear-villager-2"), ("", "spear-villager-3"), ("", "spear-villager-4"), ("", "spear-villager-5"),
        ("", "spear-villager-6"), ("", "spear-villager-7"), ("", "spear-villager-8"), ("", "spear-villager-9"), ("", "spear-villager-10"),
        ("", "spear-villager-11"), ("", "spear-villager-12"), ("", "spear-villager-13"), ("", "spear-villager-14"),
        ("", "spear-villager-after"),
    ]
}

// `villager-thorns`' steps (CAL-214), where `talk`'s are: at midnight, the bot, in creative mode,
// summons a villager without AI and with 200 health in a diamond chestplate of thorns III six
// blocks south of it, and a zombie with an iron sword of sharpness II, knockback I and fire aspect
// I twelve south, which comes and hits her, each hit hurting her the more, knocking her the
// further and setting her on fire, and her thorns, now and then, hurting it back. It watches for
// 15 seconds.
fn villager_thorns_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "villager-thorns-night"),
        ("gamemode creative", "villager-thorns-creative"),
        ("summon villager 0.5 -60 6.5 \{NoAI:1b,PersistenceRequired:1b,Health:200.0f,attributes:[\{id:\"minecraft:max_health\",base:200.0d\}],equipment:\{chest:\{id:\"minecraft:diamond_chestplate\",count:1,components:\{\"minecraft:enchantments\":\{\"minecraft:thorns\":3\}\}\}\}\}", "villager-thorns-villager"),
        ("summon zombie 0.5 -60 12.5 \{PersistenceRequired:1b,equipment:\{mainhand:\{id:\"minecraft:iron_sword\",count:1,components:\{\"minecraft:enchantments\":\{\"minecraft:sharpness\":2,\"minecraft:knockback\":1,\"minecraft:fire_aspect\":1\}\}\}\}\}", "villager-thorns-zombie"),
        ("", "villager-thorns-1"), ("", "villager-thorns-2"), ("", "villager-thorns-3"), ("", "villager-thorns-4"), ("", "villager-thorns-5"),
        ("", "villager-thorns-6"), ("", "villager-thorns-7"), ("", "villager-thorns-8"), ("", "villager-thorns-9"), ("", "villager-thorns-10"),
        ("", "villager-thorns-11"), ("", "villager-thorns-12"), ("", "villager-thorns-13"), ("", "villager-thorns-14"),
        ("", "villager-thorns-after"),
    ]
}

// `golem-thorns`' steps (CAL-214), where `talk`'s are: at midnight, the bot, in creative mode,
// summons a zombie without AI and with 200 health in a diamond chestplate of thorns III six blocks
// south of it, and an iron golem twelve south, which comes and hits it, tossing it up, the
// zombie's thorns, now and then, hurting the golem back. It watches for 15 seconds.
fn golem_thorns_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "golem-thorns-night"),
        ("gamemode creative", "golem-thorns-creative"),
        ("summon zombie 0.5 -60 6.5 \{NoAI:1b,PersistenceRequired:1b,Health:200.0f,attributes:[\{id:\"minecraft:max_health\",base:200.0d\}],equipment:\{chest:\{id:\"minecraft:diamond_chestplate\",count:1,components:\{\"minecraft:enchantments\":\{\"minecraft:thorns\":3\}\}\}\}\}", "golem-thorns-zombie"),
        ("summon iron_golem 0.5 -60 12.5 \{PersistenceRequired:1b\}", "golem-thorns-golem"),
        ("", "golem-thorns-1"), ("", "golem-thorns-2"), ("", "golem-thorns-3"), ("", "golem-thorns-4"), ("", "golem-thorns-5"),
        ("", "golem-thorns-6"), ("", "golem-thorns-7"), ("", "golem-thorns-8"), ("", "golem-thorns-9"), ("", "golem-thorns-10"),
        ("", "golem-thorns-11"), ("", "golem-thorns-12"), ("", "golem-thorns-13"), ("", "golem-thorns-14"),
        ("", "golem-thorns-after"),
    ]
}

