        ("tp @s ~ ~ ~1", "nether-out"),
        // Entities through nether portals (D578): with the bot in the Nether by the portal it came
        // out of, summoned in the Overworld's, each taken the tick after it's in it, a pig with no
        // AI, a stone, two stone, which merge with it where they come out, an orb, which comes to
        // the bot, a splash potion and an arrow, falling. Then, the bot back in the portal, a
        // floor of obsidian built north of it with a wall two blocks off, and the air between
        // cleared, for ender pearls (D579).
        ("execute in minecraft:overworld run summon pig 32.5 -60 30.5 \{NoAI:1b\}", "travel-pig"),
        ("execute in minecraft:overworld run summon item 31.5 -60 30.5 \{Item:\{id:stone,count:1\},PickupDelay:1000\}", "travel-item"),
        ("execute in minecraft:overworld run summon item 31.5 -60 30.5 \{Item:\{id:stone,count:2\},PickupDelay:1000\}", "travel-merge"),
        ("execute in minecraft:overworld run summon experience_orb 31.5 -60 30.5 \{Value:3\}", "travel-orb"),
        ("execute in minecraft:overworld run summon splash_potion 31.5 -58 30.5", "travel-potion"),
        ("execute in minecraft:overworld run summon arrow 31.5 -58 30.5", "travel-arrow"),
        ("", "nether-cooled"),
        ("tp @s ~ ~ ~-1", "nether-in"),
        ("fill -5 97 -16 0 101 -12 obsidian", "nether-floor"),
        ("fill -5 98 -14 0 101 -12 air", "nether-air"),
        ("", "nether-waiting-3"),
        ("", "nether-waiting-4"),
        ("", "portal-back"),
        // Ender pearls (D579): five in the bot's hand away from the portal; one thrown down, which
        // takes it where it was thrown from, and another in the same tick, on its cooldown, so not
        // thrown; one far to the north-west, which takes it there as it lands; then, in creative
        // mode, which they don't hurt or use up, a wall built two blocks south of the Overworld's
        // portal, and one thrown north through the portal from by the wall, which goes into the
        // Nether and takes the bot there as it hits the wall built there; and one back south
        // through the Nether's, which takes it back as it hits this wall.
        ("tp @s 40.5 -60 40.5", "pearl-tp"),
        ("item replace entity @s weapon.mainhand with minecraft:ender_pearl 5", "pearl-give"),
        ("#pearl-down", "pearl-down"),
        ("", "pearl-down-landed"),
        ("#pearl-far", "pearl-far"),
        ("", "pearl-flying"),
        ("", "pearl-far-landed"),
        ("gamemode creative", "pearl-creative"),
        ("fill 30 -60 33 33 -57 33 obsidian", "pearl-wall"),
        ("tp @s 31.5 -60 32.5", "pearl-portal-tp"),
        ("#pearl-north", "pearl-portal"),
