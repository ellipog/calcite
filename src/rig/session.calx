// `forceload`'s steps (D622): the bot, an operator, at the end fixture's spawn, asks which chunks
// are forced, none; forces its own chunk, then again, which changes none; forces the 16 about the
// spawn, 15 of them new, and asks again; asks of a forced column and one that isn't; tries 361
// chunks, too many, a column out of the world and one written alone; lets its chunk go, twice;
// forces it again by where it is; forces a chunk in the Nether and asks there, which keeps the
// Nether ticking; then lets every chunk in the Overworld go and asks once more. The Nether's
// stays forced, saved with its tickets.
fn forceload_steps() -> List<(str, str)> {
    return [
        ("forceload query", "forceload-none"),
        ("forceload add 0 0", "forceload-add"),
        ("forceload add 0 0", "forceload-add-again"),
        ("forceload add -20 -20 20 20", "forceload-add-area"),
        ("forceload query", "forceload-list"),
        ("forceload query 5 5", "forceload-query-forced"),
        ("forceload query 100 100", "forceload-query-not"),
        ("forceload add 0 0 300 300", "forceload-too-big"),
        ("forceload add 30000000 0", "forceload-out-of-world"),
        ("forceload add 0", "forceload-incomplete"),
        ("forceload remove 0 0", "forceload-remove"),
        ("forceload remove 0 0", "forceload-remove-again"),
        ("forceload add ~ ~", "forceload-add-here"),
        ("execute in minecraft:the_nether run forceload add 40 40", "forceload-nether"),
        ("execute in minecraft:the_nether run forceload query", "forceload-nether-list"),
        ("", "forceload-nether-ticking"),
        ("forceload remove all", "forceload-remove-all"),
        ("forceload query", "forceload-none-again"),
        ("", "forceload-after"),
    ]
}

// `fight`'s steps (D625): the bot, an operator, on the end fixture's world, the End's dragon fight
// new, forces the End's chunks from -9 to 9 each way, the fight's arena and those about it, in two
// commands, as no more than 256 may be forced at once, which vanilla reads as it forces them, and
// waits as Calcite's load; then goes into the End through the end portal by the spawn, onto the
// platform, within 192 of the arena's middle, so the fight's next look for players finds it,
// shows it the fight's boss bar, and, its arena loaded, scans it: no end portal in it, nor the
// exit portal's pattern down the column at 0, 0, so the exit portal's made there, inactive, and
// with no dragon alive, the fight makes one (D626).
fn fight_steps() -> List<(str, str)> {
    return [
        ("execute in minecraft:the_end run forceload add -144 -144 -1 144", "fight-forced-west"),
        ("execute in minecraft:the_end run forceload add 0 -144 144 144", "fight-forced-east"),
        ("", "fight-loading"),
        ("", "fight-loading-more"),
        ("", "fight-loaded"),
        ("tp @s 4.5 -60.5 0.5", "fight-in"),
        ("", "fight-arrived"),
        ("", "fight-scanned"),
        ("", "fight-after"),
    ]
}

// `fight-kill`'s steps (D627): `fight`'s, the saved fight's dragon of a UUID no dragon has, no
// dragon killed in it before, and its last gateway the second, by the platform; then, the arena
// scanned and the exit portal made, a dragon summoned dead above the podium with that UUID, which
// dies for 200 ticks, its experience 12,000, telling the fight from its second tick, as its
// `aiStep` takes the fight as its own, that it's seen, the bar's progress none. Then the fight
// hears it's killed: the bar's hidden, the exit portal made active, the pillar's torches broken
// with their drops and set again, the gateway made by the platform, heard by the bot, and the egg
// set on top.
fn fight_kill_steps() -> List<(str, str)> {
    var steps = fight_steps()
    steps.push(("summon minecraft:ender_dragon 0 80 0 \{UUID:[I;1,2,3,4],Health:0.0f\}", "kill-summoned"))
    let names: List<str> = ["kill-dying-1", "kill-dying-2", "kill-dying-3", "kill-dying-4", "kill-dying-5", "kill-dying-6", "kill-dying-7", "kill-dying-8", "kill-dying-9", "kill-dying-10", "kill-dead", "kill-after"]
    for name in names {
        steps.push(("", name))
    }
    return steps
}

// `fight-abort`'s steps (CAL-167): `fight`'s, the fight saved as over, so it doesn't scan its
// arena and has no exit portal yet; then the bot, in creative mode by 0, 0, holding an end
// crystal, summons crystals where the portal's bedrock will be, 3 east, west and north of its
// middle at 0, 65, 0, where the top of the ground is, sets bedrock 3 south of it and uses the
// crystal it holds on that, which has the fight respawn its dragon, `tryRespawn`: the exit
// portal made, active, as it hasn't one, with the crystals over it; then its bedrock and end
// portals made end stone, and the portal made again, inactive; the next tick the crystals' beams
// meet over the arena, and the summoning roar's heard. Then it hits the crystal it put there,
// which explodes, breaking the others, the first of which has the fight give its respawn up, the
// portal made active again, before the explosion breaks blocks.
fn fight_abort_steps() -> List<(str, str)> {
    var steps = fight_steps()
    let more: List<(str, str)> = [
        ("gamemode creative", "abort-creative"),
        ("tp @s 0.5 66 5.5", "abort-podium"),
        ("item replace entity @s weapon.mainhand with minecraft:end_crystal", "abort-crystal"),
        ("summon end_crystal 3.5 66 0.5", "abort-east"),
        ("summon end_crystal -2.5 66 0.5", "abort-west"),
        ("summon end_crystal 0.5 66 -2.5", "abort-north"),
        ("setblock 0 65 3 minecraft:bedrock", "abort-bedrock"),
        ("#use 0 65 3", "abort-placed"),
        ("", "abort-preparing"),
        ("", "abort-preparing-more"),
        ("#hit-crystal", "abort-hit"),
        ("", "abort-after"),
    ]
    for s in more {
        steps.push(s)
    }
    return steps
}

// `fight-crystal`'s steps (CAL-167): `fight`'s, the fight's dragon of a UUID no dragon has; then
// the bot, in survival mode and resistant to all harm, by the podium, summons an end crystal 3
// south of it and the fight's dragon over it, holding its pattern, without AI so it stays there
// as it looks for the crystal nearest it, `checkCrystals`, which it does without; two steps on
// it breaks the crystal: the dragon hears of it, `onCrystalDestroyed`, hurt in its head as that
// was the one it was healed by, and, holding its pattern, it takes to strafing the bot, which
// broke it.
fn fight_crystal_steps() -> List<(str, str)> {
    var steps = fight_steps()
    let more: List<(str, str)> = [
        ("tp @s 0.5 66 5.5", "crystal-podium"),
        ("effect give @s minecraft:resistance 600 4 true", "crystal-resistant"),
        ("summon end_crystal 0.5 66 8.5", "crystal-near"),
        ("summon minecraft:ender_dragon 0 80 0 \{UUID:[I;1,2,3,4],DragonPhase:0,NoAI:1b\}", "crystal-dragon"),
        ("", "crystal-looked"),
        ("#hit-crystal", "crystal-broken"),
        ("", "crystal-strafing"),
        ("", "crystal-after"),
    ]
    for s in more {
        steps.push(s)
    }
    return steps
}

// `fight-respawn`'s steps (CAL-167): as `fight-abort`'s till the fight respawns its dragon, then
// the bot waits through the 100 ticks of the summoning roar and as the respawn builds the spikes
// again one by one, 40 ticks each, the crystals' beams on each in turn, those east, south-east,
// south, south-west and north-east of it in its sight; then through the dragon's stage, the
// beams over the arena again and the roar, till the new dragon's made, the bot told it summoned
// it, the spikes' crystals as they were and the respawn's crystals gone off, their explosions
// breaking each other and pushing the bot; it leaves as the dragon holds its pattern.
fn fight_respawn_steps() -> List<(str, str)> {
    var steps = fight_steps()
    let more: List<(str, str)> = [
        ("gamemode creative", "respawn-creative"),
        ("tp @s 0.5 66 5.5", "respawn-podium"),
        ("item replace entity @s weapon.mainhand with minecraft:end_crystal", "respawn-crystal"),
        ("summon end_crystal 3.5 66 0.5", "respawn-east"),
        ("summon end_crystal -2.5 66 0.5", "respawn-west"),
        ("summon end_crystal 0.5 66 -2.5", "respawn-north"),
        ("setblock 0 65 3 minecraft:bedrock", "respawn-bedrock"),
        ("#use 0 65 3", "respawn-placed"),
    ]
    for s in more {
        steps.push(s)
    }
    let names: List<str> = ["respawn-1", "respawn-2", "respawn-3", "respawn-4", "respawn-5", "respawn-6", "respawn-7", "respawn-8", "respawn-9", "respawn-10", "respawn-11", "respawn-12", "respawn-13", "respawn-14", "respawn-15", "respawn-16", "respawn-17", "respawn-18", "respawn-19", "respawn-20", "respawn-21", "respawn-22", "respawn-23", "respawn-24", "respawn-25", "respawn-26", "respawn-27", "respawn-28", "respawn-29", "respawn-30"]
    for name in names {
        steps.push(("", name))
    }
    return steps
}

// `compass`' steps (D603): the bot, an operator, in survival mode at the end fixture's spawn, sets
// a lodestone west of it and uses a compass on it, its only one, which tracks the lodestone; then
// one of three, which leaves two and gives it another that tracks it. Given a lodestone compass
// whose target's in the Nether, and one that isn't tracking, it breaks the lodestone, and the
// compass that tracked it loses its target as it ticks, the other two kept. Then one whose
// target's out of the world, which loses it too, and one whose target's far off where no chunk's
// been made, which loses it once the chunk's points of interest are read, as vanilla reads them
// then. In creative mode, holding one, it uses it on the lodestone set again, which keeps that and
// gives it another; then in survival, holding two, with a whole stack of those that track it and
// its inventory full, it uses one, and the new one drops. Last, an armor stand holding a compass
// that tracks the lodestone, and a zombie without AI holding another in its off hand and wearing
// one whose target's far off, where no chunk's been made; the lodestone's broken, and each loses
// its target as its equipment ticks, which those that see it are shown the tick after (D607).
fn compass_steps() -> List<(str, str)> {
    return [
        ("setblock -1 -60 1 minecraft:lodestone", "compass-lodestone"),
        ("item replace entity @s weapon.mainhand with minecraft:compass", "compass-held"),
        ("#use-frame", "compass-locked"),
        ("", "compass-pointing"),
        ("item replace entity @s weapon.mainhand with minecraft:compass 3", "compass-three"),
        ("#use-frame", "compass-another"),
        ("item replace entity @s weapon.offhand with minecraft:compass[lodestone_tracker=\{target:\{dimension:\"minecraft:the_nether\",pos:[I;0,64,0]\}\}]", "compass-nether"),
        ("item replace entity @s hotbar.8 with minecraft:compass[lodestone_tracker=\{target:\{dimension:\"minecraft:overworld\",pos:[I;-1,-60,1]\},tracked:false\}]", "compass-untracked"),
        ("setblock -1 -60 1 minecraft:air", "compass-broken"),
        ("", "compass-lost"),
        ("item replace entity @s inventory.0 with minecraft:compass[lodestone_tracker=\{target:\{dimension:\"minecraft:overworld\",pos:[I;0,400,0]\}\}]", "compass-above"),
        ("", "compass-above-lost"),
        ("item replace entity @s inventory.1 with minecraft:compass[lodestone_tracker=\{target:\{dimension:\"minecraft:overworld\",pos:[I;20000,0,20000]\}\}]", "compass-far"),
        ("", "compass-far-lost"),
        ("gamemode creative", "compass-creative"),
        ("setblock -1 -60 1 minecraft:lodestone", "compass-again"),
        ("item replace entity @s weapon.mainhand with minecraft:compass", "compass-one"),
        ("#use-frame", "compass-copied"),
        ("", "compass-kept"),
        ("gamemode survival", "compass-survival"),
        ("item replace entity @s weapon.mainhand with minecraft:compass 2", "compass-two"),
        ("item replace entity @s hotbar.2 with minecraft:compass[lodestone_tracker=\{target:\{dimension:\"minecraft:overworld\",pos:[I;-1,-60,1]\}\}] 64", "compass-stack"),
        ("give @s minecraft:stone 1920", "compass-full"),
        ("#use-frame", "compass-dropped"),
        ("", "compass-on-ground"),
        ("summon minecraft:armor_stand 1.5 -60 3.5 \{equipment:\{mainhand:\{id:\"minecraft:compass\",count:1,components:\{\"minecraft:lodestone_tracker\":\{target:\{dimension:\"minecraft:overworld\",pos:[I;-1,-60,1]\}\}\}\}\}\}", "compass-stand"),
        ("summon minecraft:zombie -1.5 -60 3.5 \{NoAI:1b,PersistenceRequired:1b,equipment:\{offhand:\{id:\"minecraft:compass\",count:1,components:\{\"minecraft:lodestone_tracker\":\{target:\{dimension:\"minecraft:overworld\",pos:[I;-1,-60,1]\}\}\}\},head:\{id:\"minecraft:compass\",count:1,components:\{\"minecraft:lodestone_tracker\":\{target:\{dimension:\"minecraft:overworld\",pos:[I;-20000,0,20000]\}\}\}\}\}\}", "compass-zombie"),
        ("", "compass-held-ticking"),
        ("setblock -1 -60 1 minecraft:air", "compass-held-broken"),
        ("", "compass-held-lost"),
        ("", "compass-held-after"),
    ]
}

// `throws`' steps (D599): the bot, an operator, in survival mode on `terrain`'s world, which
// generates structures, given two eyes of ender, throws one looking up, which finds the nearest
// stronghold and flies toward it till its life runs out, dropped as an item where it survives;
// then its last, which leaves its hand empty and still in use till it lets go; then, in creative
// mode, one more, which it keeps.
fn throw_steps() -> List<(str, str)> {
    return [
        ("item replace entity @s weapon.mainhand with minecraft:ender_eye 2", "throws-held"),
        ("#eye-up", "throws-first"),
        ("", "throws-rising"),
        ("#release", "throws-let-go"),
        ("", "throws-flying"),
        ("", "throws-first-gone"),
        ("", "throws-dropped"),
        ("#eye-up", "throws-last"),
        ("", "throws-using-nothing"),
        ("", "throws-still-using"),
        ("#release", "throws-last-let-go"),
        ("", "throws-last-gone"),
        ("", "throws-last-dropped"),
        ("gamemode creative", "throws-creative"),
        ("item replace entity @s weapon.mainhand with minecraft:ender_eye 1", "throws-creative-held"),
        ("#eye-up", "throws-creative-throw"),
        ("#release", "throws-creative-let-go"),
        ("", "throws-creative-flying"),
        ("", "throws-creative-flying-more"),
        ("", "throws-creative-gone"),
        ("", "throws-creative-after"),
    ]
}

// `locate`'s steps (D600): the bot, an operator, at the plain world's spawn, has `locate
// structure` find a plains village and the nearest of the village tag's, the stronghold, placed
// in rings, a mineshaft and buried treasure, which may start in any chunk, a mansion and an
// ancient city, which are far apart, trial chambers, a fortress, which the Overworld doesn't
// place, and an ID and a tag there are none of. Vanilla's search takes the nearest of the first
// square of sectors to have any, out to 100; Calcite's the nearest anywhere, and the fortress
// in the Nether. Then each that Calcite finds nearer than vanilla, and the fortress, searched for
// from where it found it, which vanilla's search finds there too where one starts there. Then
// `locate biome` of plains, the forest tag's, mushroom fields, which are far, the deep dark,
// underground, a crimson forest, in the Nether, and a biome and a tag there are none of; then
// each searched for from where Calcite found it, and the crimson forest from the Nether (D601).
// Then `locate poi` of a lodestone where there's none, of one set by the bot, from there and from
// 1000 blocks east, past vanilla's 256, of the village's, and of a type there's none of (D602).
fn locate_steps() -> List<(str, str)> {
    return [
        ("locate structure minecraft:village_plains", "locate-village"),
        ("locate structure #minecraft:village", "locate-villages"),
        ("locate structure minecraft:stronghold", "locate-stronghold"),
        ("locate structure minecraft:mineshaft", "locate-mineshaft"),
        ("locate structure minecraft:buried_treasure", "locate-treasure"),
        ("locate structure minecraft:mansion", "locate-mansion"),
        ("locate structure minecraft:ancient_city", "locate-city"),
        ("locate structure minecraft:trial_chambers", "locate-chambers"),
        ("locate structure minecraft:fortress", "locate-fortress"),
        ("locate structure minecraft:nothing", "locate-none"),
        ("locate structure #minecraft:nothing", "locate-no-tag"),
        ("execute positioned -1056 0 1728 run locate structure minecraft:village_plains", "locate-there-village"),
        ("execute positioned 112 0 640 run locate structure #minecraft:village", "locate-there-villages"),
        ("execute positioned 313 0 -599 run locate structure minecraft:buried_treasure", "locate-there-treasure"),
        ("execute positioned 208 0 -4640 run locate structure minecraft:mansion", "locate-there-mansion"),
        ("execute positioned -208 0 -2208 run locate structure minecraft:ancient_city", "locate-there-city"),
        ("execute in minecraft:the_nether positioned -112 0 -208 run locate structure minecraft:fortress", "locate-there-fortress"),
        ("execute in minecraft:the_nether run locate structure minecraft:fortress", "locate-nether-fortress"),
        ("locate biome minecraft:plains", "locate-plains"),
        ("locate biome #minecraft:is_forest", "locate-forest"),
        ("locate biome minecraft:mushroom_fields", "locate-mushrooms"),
        ("locate biome minecraft:deep_dark", "locate-deep-dark"),
        ("locate biome minecraft:crimson_forest", "locate-crimson"),
        ("locate biome minecraft:nothing", "locate-no-biome"),
        ("locate biome #minecraft:nothing", "locate-no-biome-tag"),
        ("execute positioned 968 63 -745 run locate biome minecraft:plains", "locate-there-plains"),
        ("execute positioned 952 63 -297 run locate biome #minecraft:is_forest", "locate-there-forest"),
        ("execute positioned -4245 63 764 run locate biome minecraft:mushroom_fields", "locate-there-mushrooms"),
        ("execute positioned 1216 -21 -317 run locate biome minecraft:deep_dark", "locate-there-deep-dark"),
        ("execute in minecraft:the_nether positioned 44 63 -21 run locate biome minecraft:crimson_forest", "locate-there-crimson"),
        ("execute in minecraft:the_nether run locate biome minecraft:crimson_forest", "locate-nether-crimson"),
        ("locate poi minecraft:lodestone", "locate-no-lodestone"),
        ("setblock ~2 ~ ~2 minecraft:lodestone", "locate-set-lodestone"),
        ("locate poi minecraft:lodestone", "locate-lodestone"),
        ("execute positioned 1000 ~ 0 run locate poi minecraft:lodestone", "locate-far-lodestone"),
        ("locate poi #minecraft:village", "locate-village-pois"),
        ("locate poi minecraft:nothing", "locate-no-poi"),
        ("", "locate-after"),
    ]
}

// `silverfish`' steps (CAL-172): the bot, an operator, in creative mode, which no monster takes
// up, lays a floor of stone east of its spawn and stands a wall of infested stone on it, with
// infested deepslate along x and infested cobblestone apart; it breaks the cobblestone with
// `setblock ... destroy`, which lets a silverfish out; then summons one poisoned, whose hurts by
// magic, `#always_triggers_silverfish`, wake its friends 20 ticks on, breaking them where mob
// griefing's on, each letting another out, or making them their hosts again where it's off; the
// silverfish go about, and where mob griefing's on, into the stone.
fn silverfish_steps() -> List<(str, str)> {
    var out: List<(str, str)> = [
        ("gamemode creative", "fish-creative"),
        ("fill 10 -61 -5 20 -61 5 minecraft:stone", "fish-floor"),
        ("fill 18 -60 -3 18 -58 3 minecraft:infested_stone", "fish-wall"),
        ("setblock 14 -60 4 minecraft:infested_deepslate[axis=x]", "fish-deepslate"),
        ("setblock 12 -60 -4 minecraft:infested_cobblestone", "fish-cobble"),
        ("setblock 12 -60 -4 minecraft:air destroy", "fish-broken"),
        ("summon silverfish 15.5 -60 0.5 \{active_effects:[\{id:\"minecraft:poison\",duration:400,amplifier:1b\}]\}", "fish-poisoned"),
    ]
    for step in ["fish-1", "fish-2", "fish-3", "fish-4", "fish-5", "fish-6", "fish-7", "fish-8", "fish-9", "fish-10",
        "fish-11", "fish-12", "fish-13", "fish-14", "fish-15", "fish-16", "fish-17", "fish-18", "fish-19", "fish-20",
        "fish-21", "fish-22", "fish-23", "fish-24", "fish-25"] {
        out.push(("", step))
    }
    return out
}

// `eggs'` steps (CAL-172), all in the chunk of its spawn, so no teleport takes it out of it:
// the bot in creative mode fences a field of stone by its spawn and lays four turtle eggs on each
// block of it; two cows fall onto them and an armor stand, which step on them as they go; the bot
// falls onto them four times from 6 up, then stands on them.
// South of the field it lays farmland, a seed on one block and a cow without AI on another, and
// falls onto the seed's from 4 up, trampling it, which pushes it and the seed up; then it stands
// on the cow's as a cow falls onto it from 10 up, trampling it, which pushes them all up.
fn egg_steps() -> List<(str, str)> {
    var out: List<(str, str)> = [
        ("gamemode creative", "eggs-creative"),
        ("fill 2 -61 2 12 -61 12 minecraft:stone", "eggs-floor"),
        ("fill 2 -60 2 12 -60 2 minecraft:oak_fence", "eggs-fence-north"),
        ("fill 2 -60 12 12 -60 12 minecraft:oak_fence", "eggs-fence-south"),
        ("fill 2 -60 3 2 -60 11 minecraft:oak_fence", "eggs-fence-west"),
        ("fill 12 -60 3 12 -60 11 minecraft:oak_fence", "eggs-fence-east"),
        ("fill 3 -60 3 11 -60 11 minecraft:turtle_egg[eggs=4]", "eggs-laid"),
        ("summon cow 7.5 -54 7.5", "eggs-cow"),
        ("summon cow 5.5 -56 4.5", "eggs-cow-2"),
        ("summon armor_stand 9.5 -55 9.5", "eggs-stand"),
        ("tp @s 4.5 -59.5625 9.5", "eggs-bot"),
        ("#hop 4.5 -59.5625 9.5 6", "eggs-hop-1"),
        ("", "eggs-hop-1-after"),
        ("#hop 4.5 -59.5625 9.5 6", "eggs-hop-2"),
        ("", "eggs-hop-2-after"),
        ("#hop 4.5 -59.5625 9.5 6", "eggs-hop-3"),
        ("", "eggs-hop-3-after"),
        ("#hop 4.5 -59.5625 9.5 6", "eggs-hop-4"),
        ("", "eggs-hop-4-after"),
    ]
    for step in ["eggs-1", "eggs-2", "eggs-3", "eggs-4", "eggs-5", "eggs-6", "eggs-7", "eggs-8", "eggs-9", "eggs-10",
        "eggs-11", "eggs-12", "eggs-13", "eggs-14", "eggs-15", "eggs-16", "eggs-17", "eggs-18", "eggs-19", "eggs-20"] {
        out.push(("", step))
    }
    out.extend([
        ("fill 3 -61 14 7 -61 14 minecraft:farmland", "farm-laid"),
        ("summon cow 6.5 -60.0625 14.5 \{NoAI:1b\}", "farm-cow"),
        ("summon item 4.5 -60.0625 14.5 \{Item:\{id:\"minecraft:wheat_seeds\",count:1\}\}", "farm-seed"),
        ("tp @s 4.5 -60.0625 14.5", "farm-bot"),
        ("#hop 4.5 -60.0625 14.5 4", "farm-hop"),
        ("", "farm-hop-after"),
        ("tp @s 6.5 -60.0625 14.5", "farm-bot-2"),
        ("summon cow 6.5 -50 14.5", "farm-falling-cow"),
        ("", "farm-1"),
        ("", "farm-2"),
        ("", "farm-3"),
    ])
    return out
}

// `cauldrons`' steps (CAL-172), in the chunk of its spawn: the bot in creative mode sets water
// cauldrons, full and with one level, and a full powder snow cauldron, and into them come a cow, a
// stick, an armor stand and an arrow, each burning, whose fire each cauldron takes, a level less,
// the powder snow one water, the one with one level empty, before it's put out; then a shulker box
// holding a stick and diamonds out of slot order and a bundle of apples and a feather burn up in
// a lava cauldron, what they hold let out where they were.
fn cauldron_steps() -> List<(str, str)> {
    var out: List<(str, str)> = [
        ("gamemode creative", "cauldron-creative"),
        ("setblock 3 -60 3 minecraft:water_cauldron[level=3]", "cauldron-water"),
        ("setblock 6 -60 3 minecraft:powder_snow_cauldron[level=3]", "cauldron-snow"),
        ("setblock 9 -60 3 minecraft:water_cauldron[level=1]", "cauldron-low"),
        ("setblock 12 -60 3 minecraft:water_cauldron[level=3]", "cauldron-full"),
        ("summon cow 3.5 -59.75 3.5 \{Fire:100s\}", "cauldron-cow"),
        ("summon item 6.5 -59.5 3.5 \{Fire:100s,Item:\{id:\"minecraft:stick\",count:1\}\}", "cauldron-stick"),
        ("summon armor_stand 9.5 -59.75 3.5 \{Fire:100s\}", "cauldron-stand"),
        ("summon arrow 12.5 -57 3.5 \{Fire:100s,Motion:[0.0,-0.5,0.0]\}", "cauldron-arrow"),
        ("setblock 3 -60 6 minecraft:lava_cauldron", "cauldron-lava"),
        ("summon item 3.5 -59.5 6.5 \{Item:\{id:\"minecraft:shulker_box\",count:1,components:\{\"minecraft:container\":[\{slot:5,item:\{id:\"minecraft:stick\",count:1\}\},\{slot:0,item:\{id:\"minecraft:diamond\",count:2\}\}]\}\}\}", "cauldron-shulker"),
        ("summon item 3.5 -59.5 6.5 \{Item:\{id:\"minecraft:bundle\",count:1,components:\{\"minecraft:bundle_contents\":[\{id:\"minecraft:apple\",count:3\},\{id:\"minecraft:feather\",count:1\}]\}\}\}", "cauldron-bundle"),
    ]
    for step in ["cauldron-1", "cauldron-2", "cauldron-3", "cauldron-4", "cauldron-5"] {
        out.push(("", step))
    }
    return out
}

// `lids`' steps (D695), in the chunk of its spawn: the bot in creative mode sets shulker boxes,
