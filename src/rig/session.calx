        ("summon cow ~4 ~ ~ \{NoAI:1b\}", "strikes-cow"),
        ("summon armor_stand ~-4 ~ ~", "strikes-stand"),
        ("summon ender_dragon ~ ~3 ~", "strikes-summoned"),
        ("", "strikes-1"),
        ("", "strikes-2"),
        ("", "strikes-3"),
        ("", "strikes-4"),
        ("", "strikes-5"),
        ("", "strikes-6"),
    ]
}

// `mob-targets`' steps (CAL-244): the bot, an operator, in creative mode, which no monster takes
// up, at midnight, so no zombie burns, summons a villager without AI 4 south of it and a zombie 12
// south, so the bot isn't in his way, who takes the villager up as he sees her, comes for her and
// hits her till she dies, as it's easy, where a zombie doesn't turn one; then an endermite
// without AI 6 west and an enderman 10 west, which takes the endermite up as it sees it, and hits
// it till it dies, its anger at it gone as it dies.
fn mob_targets_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "targets-creative"),
        ("time set 18000", "targets-midnight"),
        ("summon villager ~ ~ ~4 \{NoAI:1b\}", "targets-villager"),
        ("summon zombie ~ ~ ~12 \{PersistenceRequired:1b\}", "targets-zombie"),
