    packets.push(Dug.HitZombie(0, 200, "hit-ender"))
    packets.push(Dug.Mark(210, "taken-up"))
    packets.push(Dug.Leave(290))
    return [Dig { name: String(), packets: packets }]
}

// What `skeleton` does on the `skeleton` and `skeleton-sun` fixtures' worlds, `spider` on the
