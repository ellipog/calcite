        ("", "egg-throws-cow-hit"),
        ("#throw 0 90", "egg-throws-down-1"),
        ("#throw 0 90", "egg-throws-down-2"),
        ("#throw 0 90", "egg-throws-down-3"),
        ("#throw 0 90", "egg-throws-down-4"),
        ("#throw 0 90", "egg-throws-down-5"),
        ("#throw 0 90", "egg-throws-down-6"),
        ("#throw 0 90", "egg-throws-down-7"),
        ("#throw 0 90", "egg-throws-down-8"),
        ("#throw 0 90", "egg-throws-down-9"),
        ("#throw 0 90", "egg-throws-down-10"),
        ("#throw 0 90", "egg-throws-down-11"),
        ("#throw 0 90", "egg-throws-down-12"),
        ("", "egg-throws-down-landed"),
        ("item replace entity @s weapon.mainhand with blue_egg 16", "egg-throws-blue"),
        ("#throw 0 90", "egg-throws-blue-1"),
        ("#throw 0 90", "egg-throws-blue-2"),
        ("item replace entity @s weapon.mainhand with brown_egg 16", "egg-throws-brown"),
