}

// `end`'s steps (D586): the bot, an operator, on the end fixture's grass, taken into the end portal
// there, which takes it into the End, onto the platform made for it; then an end portal set in
// the platform's floor east of it and the bot taken into that, which, as it hasn't seen them,
// shows it the credits, after which it respawns at the world's spawn keeping all it has; then its
// spawn set by it, and again into the End, the platform made again over the portal, which is set
// again, and out through it, which takes it to where its spawn's set, as it's seen them.
// What isn't a player goes through the end portals too (D587): first, with the bot by the
// Overworld's, whose chunks tick only while it's there, summoned in it, a stone, two stone, which
// merge with it where they come out, an orb, which comes to the bot once it's there, a splash
// potion and an arrow, falling, and an armor stand, turned, which comes out facing west, none of
// them pushing the bot as it comes out among them; then, before it goes out of the End again,
// with the bot aside on the platform, summoned in the platform's portal, a pig with no AI,
// turned, an armor stand and a stone, which come out onto the world's spawn, turned by its yaw
// and pitch.
fn end_steps() -> List<(str, str)> {
    return [
        ("summon item 4.5 -60.5 0.5 \{Item:\{id:stone,count:1\},PickupDelay:1000\}", "end-item"),
        ("summon item 4.5 -60.5 0.5 \{Item:\{id:stone,count:2\},PickupDelay:1000\}", "end-merge"),
        ("summon experience_orb 4.5 -60.5 0.5 \{Value:3\}", "end-orb"),
        ("summon splash_potion 4.5 -58 0.5", "end-potion"),
        ("summon arrow 4.5 -58 0.5", "end-arrow"),
        ("summon armor_stand 4.5 -61 0.5 \{Rotation:[30f,20f]\}", "end-stand"),
        ("", "end-entities-in"),
        ("tp @s 4.5 -60.5 0.5", "end-in"),
        ("", "end-arrived"),
        ("setblock 102 48 0 minecraft:end_portal", "end-exit"),
        ("tp @s 102.5 48.5 0.5", "end-credits"),
        ("", "end-respawned"),
        ("spawnpoint @s 8 -60 8", "end-spawnpoint"),
        ("tp @s 4.5 -60.5 0.5", "end-again"),
        ("", "end-again-arrived"),
        ("setblock 102 48 0 minecraft:end_portal", "end-exit-again"),
        ("tp @s 98.5 49 -1.5", "end-aside"),
        ("summon pig 102.5 48.3 0.5 \{NoAI:1b,Rotation:[30f,20f]\}", "end-out-pig"),
        ("summon armor_stand 102.5 48.3 0.5", "end-out-stand"),
        ("summon item 102.5 48.5 0.5 \{Item:\{id:stone,count:1\},PickupDelay:1000\}", "end-out-item"),
        ("", "end-entities-out"),
        ("tp @s 102.5 48.5 0.5", "end-out"),
        ("", "end-out-arrived"),
    ]
}

// `crystals`' steps (D590): the bot, an operator, in survival mode at the end fixture's spawn
// holding stone, sets water in the grass two blocks west and summons an end crystal in it,
// invulnerable and showing no bottom, then hits it, which doesn't hurt it; then in creative mode,
// an iron sword in its hand, it hits it again, which breaks it, as a player in creative mode
// breaks what's invulnerable, sweeping, as it's on the ground and still. Vanilla's crystal then
// explodes, which Calcite's doesn't yet (CAL-182); the water about the explosion keeps its blocks,
// and creative mode keeps the bot. Then a crystal summoned there again each time (D591): an arrow
// falling onto it, which breaks it; an ender pearl falling onto it, which does too, its owner
// none, so it takes nobody anywhere; and a splash potion falling onto it, which splashes there,
// its contents none, so the crystal stays.
fn crystal_steps() -> List<(str, str)> {
    return [
        ("setblock -2 -61 0 minecraft:water", "crystal-water"),
        ("summon end_crystal -1.5 -61 0.5 \{Invulnerable:1b,ShowBottom:0b\}", "crystal-summoned"),
        ("#hit-crystal", "crystal-hit"),
        ("gamemode creative", "crystal-creative"),
        ("item replace entity @s weapon.mainhand with minecraft:iron_sword", "crystal-sword"),
        ("#hit-crystal", "crystal-broken"),
        ("summon end_crystal -1.5 -61 0.5", "crystal-again"),
        ("summon arrow -1.5 -57.5 0.5 \{Motion:[0.0,-1.0,0.0]\}", "crystal-shot"),
        ("summon end_crystal -1.5 -61 0.5", "crystal-third"),
        ("summon ender_pearl -1.5 -57.5 0.5 \{Motion:[0.0,-1.0,0.0]\}", "crystal-pearled"),
        ("summon end_crystal -1.5 -61 0.5", "crystal-fourth"),
        ("summon splash_potion -1.5 -57.5 0.5 \{Motion:[0.0,-1.0,0.0]\}", "crystal-splashed"),
        ("", "crystal-after"),
    ]
}

// `gateways`' steps (D592): the bot, an operator, at the end fixture's spawn, sets an end gateway
