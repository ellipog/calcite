// `smithing`'s steps (CAL-338): a smithing table's menu opened, `INTERACT_WITH_SMITHING_TABLE`;
// a netherite upgrade template, an enchanted, damaged diamond sword and netherite ingots
// shift-clicked in, the netherite sword they make shift-clicked out, using one of each; the
// template and ingot shifted out; dirt, which goes in none, shifted to the inventory; an iron
// chestplate trimmed with gold by a sentry template, taken by hand, then put back, which it has
// already, so nothing comes and its error shows; a diamond chestplate trimmed, taken by a hotbar
// key; the gold given back as it's closed; then the menu closed as the table's broken.
fn smithing_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "smith-survival"),
        ("item replace entity @s hotbar.0 with netherite_upgrade_smithing_template 2", "smith-template"),
        ("item replace entity @s hotbar.1 with diamond_sword[enchantments=\{sharpness:2\},damage=10]", "smith-sword"),
        ("item replace entity @s hotbar.2 with netherite_ingot 2", "smith-ingots"),
        ("item replace entity @s hotbar.3 with sentry_armor_trim_smithing_template 2", "smith-sentry"),
        ("item replace entity @s hotbar.4 with iron_chestplate", "smith-iron"),
        ("item replace entity @s hotbar.5 with gold_ingot 3", "smith-gold"),
        ("item replace entity @s hotbar.6 with dirt 2", "smith-dirt"),
        ("item replace entity @s hotbar.7 with diamond_chestplate", "smith-diamond"),
        ("setblock 0 -60 2 smithing_table", "smith-placed"),
        ("#use 0 -60 2", "smith-open"),
        ("#click 31 0 1", "smith-template-in"),
        ("#click 32 0 1", "smith-sword-in"),
        ("#click 33 0 1", "smith-ingots-in"),
        ("#click 3 0 1", "smith-upgraded"),
        ("#click 0 0 1", "smith-template-out"),
        ("#click 2 0 1", "smith-ingot-out"),
        ("#click 37 0 1", "smith-dirt-moved"),
        ("#click 34 0 1", "smith-sentry-in"),
        ("#click 35 0 1", "smith-iron-in"),
        ("#click 36 0 1", "smith-gold-in"),
        ("#click 3 0 0", "smith-trim-up"),
        ("#click 20 0 0", "smith-trim-down"),
        ("#click 20 0 1", "smith-trimmed-in"),
        ("#click 1 0 1", "smith-trimmed-out"),
        ("#click 38 0 1", "smith-diamond-in"),
        ("#click 3 2 2", "smith-swapped"),
        ("#close", "smith-closed"),
        ("#use 0 -60 2", "smith-reopen"),
        ("#click 4 0 1", "smith-in-again"),
        ("setblock 0 -60 2 air", "smith-broken"),
        ("", "smith-after"),
    ]
}

// `loom`'s steps (CAL-338): a loom's menu opened, `INTERACT_WITH_LOOM`; two white banners and red
// dye shift-clicked in, which shows the patterns needing no item, none picked; one picked, and one
// there isn't; its result taken by hand, the next made at once, and put down; a flower banner
// pattern shifted in, its only pattern picked, and the result shifted out, the last banner gone;
// the pattern shifted out; a banner with 6 layers, which shows nothing, and a pattern picked for
// it anyway, which adds a seventh, taken; dirt, which goes in none, shifted to the inventory; the
// dye given back as it's closed; then the menu closed as the loom's broken.
fn loom_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "loom-survival"),
        ("item replace entity @s hotbar.0 with white_banner 2", "loom-banners"),
        ("item replace entity @s hotbar.1 with red_dye 3", "loom-dye"),
        ("item replace entity @s hotbar.2 with flower_banner_pattern", "loom-flower"),
        ("item replace entity @s hotbar.3 with blue_banner[banner_patterns=[\{pattern:'minecraft:stripe_bottom',color:red\},\{pattern:'minecraft:stripe_bottom',color:red\},\{pattern:'minecraft:stripe_bottom',color:red\},\{pattern:'minecraft:stripe_bottom',color:red\},\{pattern:'minecraft:stripe_bottom',color:red\},\{pattern:'minecraft:stripe_bottom',color:red\}]]", "loom-full"),
        ("item replace entity @s hotbar.4 with dirt 2", "loom-dirt"),
        ("setblock 0 -60 2 loom", "loom-placed"),
        ("#use 0 -60 2", "loom-open"),
        ("#click 31 0 1", "loom-banners-in"),
        ("#click 32 0 1", "loom-dye-in"),
        ("#button 3", "loom-pick"),
        ("#button 99", "loom-pick-none"),
        ("#click 3 0 0", "loom-take"),
        ("#click 20 0 0", "loom-put"),
        ("#click 33 0 1", "loom-flower-in"),
        ("#click 3 0 1", "loom-shifted"),
        ("#click 2 0 1", "loom-flower-out"),
        ("#click 34 0 1", "loom-full-in"),
        ("#button 0", "loom-seventh"),
        ("#click 3 0 0", "loom-seventh-up"),
        ("#click 21 0 0", "loom-seventh-down"),
        ("#click 35 0 1", "loom-dirt-moved"),
        ("#close", "loom-closed"),
        ("#use 0 -60 2", "loom-reopen"),
        ("#click 32 0 1", "loom-in-again"),
        ("setblock 0 -60 2 air", "loom-broken"),
        ("", "loom-after"),
    ]
}

// `crafter-menu`'s steps (CAL-338): a crafter's menu opened, which counts no statistic; planks
// shift-clicked in; a slot turned off, one with something in it that can't be, and one turned on
// again; planks split into two slots, which shows sticks in its result, one refused by the slot
// turned off; its result clicked and shift-clicked, which it doesn't give; a slot shifted out;
// then the menu closed, and the crafter replaced with air with it open, which keeps its items.
fn crafter_menu_steps() -> List<(str, str)> {
    return [
        ("gamemode survival", "crafter-survival"),
        ("item replace entity @s hotbar.0 with oak_planks 4", "crafter-planks"),
        ("item replace entity @s hotbar.1 with dirt 2", "crafter-dirt"),
        ("setblock 0 -60 2 crafter", "crafter-placed"),
        ("#use 0 -60 2", "crafter-open"),
        ("#click 36 0 1", "crafter-planks-in"),
        ("#slot-state 1 off", "crafter-off"),
        ("#slot-state 0 off", "crafter-off-full"),
        ("#slot-state 2 off", "crafter-off-other"),
        ("#slot-state 2 on", "crafter-on"),
        ("#click 0 1 0", "crafter-half-up"),
        ("#click 3 1 0", "crafter-one-down"),
        ("#click 1 1 0", "crafter-refused"),
        ("#click 4 0 0", "crafter-rest-down"),
        ("#click 45 0 0", "crafter-result-click"),
        ("#click 45 0 1", "crafter-result-shift"),
        ("#click 3 0 1", "crafter-shifted-out"),
        ("#click 37 0 1", "crafter-dirt-in"),
        ("#close", "crafter-closed"),
        ("#use 0 -60 2", "crafter-reopen"),
        ("setblock 0 -60 2 air", "crafter-broken"),
        ("", "crafter-after"),
    ]
}

// `crafter-craft`'s steps (CAL-338): a crafter facing east with planks over planks powered by a
// redstone block, which throws sticks out of its front and uses one of each; unpowered and powered
// again with one plank left, which makes nothing and fails; one facing up with a honey bottle,
// which throws sugar and then its glass bottle; and one making a crafter, which awards
// `crafters_crafting_crafters` to the player by it; then the items left to settle.
fn crafter_craft_steps() -> List<(str, str)> {
    return [
        ("setblock 0 -60 2 crafter[orientation=east_up]\{Items:[\{Slot:0b,id:'minecraft:oak_planks',count:2\},\{Slot:3b,id:'minecraft:oak_planks',count:1\}]\}", "craft-placed"),
        ("setblock 0 -60 3 redstone_block", "craft-powered"),
        ("#wait 8", "craft-crafted"),
        ("data get block 0 -60 2", "craft-data"),
        ("setblock 0 -60 3 air", "craft-unpowered"),
        ("#wait 4", "craft-done"),
        ("setblock 0 -60 3 redstone_block", "craft-again"),
        ("#wait 8", "craft-failed"),
        ("setblock 0 -60 3 air", "craft-off"),
        ("setblock 0 -60 2 crafter[orientation=up_north]\{Items:[\{Slot:4b,id:'minecraft:honey_bottle',count:1\}]\}", "craft-honey"),
        ("setblock 0 -60 3 redstone_block", "craft-honey-powered"),
        ("#wait 8", "craft-sugar"),
        ("data get block 0 -60 2", "craft-honey-data"),
        ("setblock 0 -60 3 air", "craft-honey-off"),
        ("setblock 0 -60 2 crafter[orientation=east_up]\{Items:[\{Slot:0b,id:'minecraft:iron_ingot',count:1\},\{Slot:1b,id:'minecraft:iron_ingot',count:1\},\{Slot:2b,id:'minecraft:iron_ingot',count:1\},\{Slot:3b,id:'minecraft:iron_ingot',count:1\},\{Slot:4b,id:'minecraft:crafting_table',count:1\},\{Slot:5b,id:'minecraft:iron_ingot',count:1\},\{Slot:6b,id:'minecraft:redstone',count:1\},\{Slot:7b,id:'minecraft:dropper',count:1\},\{Slot:8b,id:'minecraft:redstone',count:1\}]\}", "craft-crafter"),
        ("setblock 0 -60 3 redstone_block", "craft-crafter-powered"),
        ("#wait 8", "craft-crafter-made"),
        ("#wait 10", "craft-settling"),
        ("#wait 10", "craft-settled"),
        ("", "craft-after"),
    ]
}

// `loot-unpack`'s steps (CAL-335): a comparator by a barrel whose loot is to come told of a block
// placed beside it, which reads the barrel and makes its loot; one by a double chest the same
// way, each half's loot made in its order; a decorated pot's loot made as it's used with an empty
// hand, and another's as it's broken; and a crafter with a loot table powered, which crafts
// nothing and makes none.
fn loot_unpack_steps() -> List<(str, str)> {
    return [
        ("setblock 0 -60 2 barrel\{LootTable:\"minecraft:chests/simple_dungeon\",LootTableSeed:5L\}", "loot-barrel"),
        ("setblock 0 -60 3 comparator[facing=north]", "loot-barrel-comparator"),
        ("setblock 1 -60 3 stone", "loot-barrel-read"),
        ("data get block 0 -60 2", "loot-barrel-data"),
        ("setblock 5 -60 2 chest[facing=south,type=left]\{LootTable:\"minecraft:chests/simple_dungeon\",LootTableSeed:2L\}", "loot-chest-left"),
        ("setblock 4 -60 2 chest[facing=south,type=right]\{LootTable:\"minecraft:chests/abandoned_mineshaft\",LootTableSeed:3L\}", "loot-chest-right"),
        ("setblock 4 -60 3 comparator[facing=north]", "loot-chest-comparator"),
        ("setblock 3 -60 3 stone", "loot-chest-read"),
        ("data get block 4 -60 2", "loot-chest-right-data"),
        ("data get block 5 -60 2", "loot-chest-left-data"),
        ("setblock -2 -60 2 decorated_pot\{LootTable:\"minecraft:pots/trial_chambers/corridor\",LootTableSeed:9L\}", "loot-pot"),
        ("#use -2 -60 2", "loot-pot-used"),
        ("data get block -2 -60 2", "loot-pot-data"),
        ("setblock -2 -60 0 decorated_pot\{LootTable:\"minecraft:pots/trial_chambers/corridor\",LootTableSeed:11L\}", "loot-pot-other"),
        ("setblock -2 -60 0 air destroy", "loot-pot-broken"),
        ("setblock 2 -60 -2 crafter\{LootTable:\"minecraft:chests/simple_dungeon\",LootTableSeed:4L\}", "loot-crafter"),
        ("setblock 2 -60 -3 redstone_block", "loot-crafter-powered"),
        ("#wait 8", "loot-crafter-failed"),
        ("data get block 2 -60 -2", "loot-crafter-data"),
        ("", "loot-after"),
    ]
}

// `hive-shear`'s steps (CAL-333): in survival mode with shears, a hive full of honey with a bee in
// it sheared, which drops its honeycomb, wears the shears and lets its bee out, angry; one with
// little honey, which does nothing; and one over a lit campfire, which keeps its bee.
fn hive_shear_steps() -> List<(str, str)> {
    return [
        ("time set day", "shear-day"),
        ("gamemode survival", "shear-survival"),
        ("item replace entity @s weapon.mainhand with shears", "shear-shears"),
        ("setblock 0 -60 2 beehive[facing=north,honey_level=5]\{bees:[\{entity_data:\{id:\"minecraft:bee\"\},ticks_in_hive:0,min_ticks_in_hive:2400\}]\}", "shear-hive"),
        ("#use 0 -60 2", "shear-sheared"),
        ("data get block 0 -60 2", "shear-hive-data"),
        ("setblock 2 -60 2 beehive[facing=north,honey_level=3]", "shear-low"),
        ("#use 2 -60 2", "shear-low-used"),
        ("setblock 1 -60 5 campfire", "shear-campfire"),
        ("setblock 1 -58 5 beehive[facing=north,honey_level=5]\{bees:[\{entity_data:\{id:\"minecraft:bee\"\},ticks_in_hive:0,min_ticks_in_hive:2400\}]\}", "shear-smoked"),
        ("#use 1 -58 5", "shear-smoked-sheared"),
        ("data get block 1 -58 5", "shear-smoked-data"),
        // Berries picked with an empty hand (CAL-310): a grown bush's, a younger one's, one with
        // none, and cave vines'.
        ("item replace entity @s weapon.mainhand with air", "berries-hand"),
        ("setblock -2 -60 2 sweet_berry_bush[age=3]", "berries-bush"),
        ("#use -2 -60 2", "berries-picked"),
        ("setblock -3 -60 2 sweet_berry_bush[age=2]", "berries-young-bush"),
        ("#use -3 -60 2", "berries-young-picked"),
        ("setblock -2 -60 4 sweet_berry_bush[age=1]", "berries-bare"),
        ("#use -2 -60 4", "berries-bare-used"),
        ("setblock -4 -57 2 stone", "berries-roof"),
        ("setblock -4 -58 2 cave_vines[berries=true]", "berries-vines"),
        ("#use -4 -58 2", "berries-vines-picked"),
        ("#wait 10", "shear-wait"),
        ("", "shear-after"),
    ]
}

// `item-modifiers`'s steps (CAL-320): `item modify` on the bot's held items with the modifiers
// Calcite ports: a sword named, as its custom name and its item name, given lore appended, inserted
// and replaced, damaged to half and by a quarter more, given custom data merged, components set
// and one taken away, enchanted and an enchantment raised, its tooltips toggled, and made a golden
// sword; a book enchanted, an ominous bottle's amplifier set past its most, and a chest given a
// loot table; a written book given a cover and pages, a writable book pages, a banner patterns,
// a stick custom model data, a goat horn an instrument, a firework star an explosion and a rocket
// its flight and explosions; a stone's name copied from the bot, which has none, a player head
// filled with the bot's profile, the bot's data copied into custom data, a sword's attributes set
// and replaced, and a bundle's, a chest's and a crossbow's contents set and modified; each looked
// at with `data get`.
fn item_modifier_steps() -> List<(str, str)> {
    return [
        ("item replace entity @s weapon.mainhand with iron_sword", "mod-sword"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_name\",name:\"Edge\"\}", "mod-name"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_name\",name:\{text:\"Blade\",color:\"red\"\},target:\"item_name\"\}", "mod-item-name"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_lore\",lore:[\"one\",\"two\"],mode:\"append\"\}", "mod-lore"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_lore\",lore:[\"zero\"],mode:\"insert\",offset:0\}", "mod-lore-insert"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_lore\",lore:[\"middle\"],mode:\"replace_section\",offset:1,size:1\}", "mod-lore-section"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_damage\",damage:0.5\}", "mod-damage"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_damage\",damage:-0.25,add:true\}", "mod-damage-add"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_custom_data\",tag:\{a:1,b:\{c:2\}\}\}", "mod-custom"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_custom_data\",tag:\"\{b:\{d:3\}\}\"\}", "mod-custom-merge"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_components\",components:\{\"minecraft:rarity\":\"epic\",\"!minecraft:attribute_modifiers\":\{\}\}\}", "mod-components"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_enchantments\",enchantments:\{sharpness:3,\"minecraft:unbreaking\":2\}\}", "mod-enchant"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_enchantments\",enchantments:\{sharpness:2\},add:true\}", "mod-enchant-add"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:toggle_tooltips\",toggles:\{\"minecraft:enchantments\":false,\"minecraft:lore\":false\}\}", "mod-tooltips"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:toggle_tooltips\",toggles:\{\"minecraft:lore\":true\}\}", "mod-tooltips-back"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_item\",item:\"golden_sword\"\}", "mod-item"),
        ("data get entity @s SelectedItem", "mod-sword-data"),
        ("item replace entity @s weapon.mainhand with book", "mod-book"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_enchantments\",enchantments:\{\"minecraft:mending\":1\}\}", "mod-book-enchant"),
        ("data get entity @s SelectedItem", "mod-book-data"),
        ("item replace entity @s weapon.mainhand with ominous_bottle", "mod-bottle"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_ominous_bottle_amplifier\",amplifier:9\}", "mod-bottle-amplifier"),
        ("data get entity @s SelectedItem", "mod-bottle-data"),
        ("item replace entity @s weapon.mainhand with chest", "mod-chest"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_loot_table\",name:\"chests/simple_dungeon\",seed:7L\}", "mod-chest-loot"),
        ("data get entity @s SelectedItem", "mod-chest-data"),
        ("item replace entity @s weapon.mainhand with written_book", "mod-written"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_book_cover\",title:\"Tale\",author:\"Bot\",generation:1\}", "mod-cover"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_written_book_pages\",pages:[\"first\",\{text:\"second\",bold:true\}],mode:\"append\"\}", "mod-written-pages"),
        ("data get entity @s SelectedItem", "mod-written-data"),
        ("item replace entity @s weapon.mainhand with writable_book", "mod-writable"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_writable_book_pages\",pages:[\"a\",\"b\"],mode:\"append\"\}", "mod-writable-pages"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_writable_book_pages\",pages:[\"c\"],mode:\"insert\",offset:1\}", "mod-writable-insert"),
        ("data get entity @s SelectedItem", "mod-writable-data"),
        ("item replace entity @s weapon.mainhand with white_banner", "mod-banner"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_banner_pattern\",patterns:[\{pattern:\"minecraft:stripe_top\",color:\"red\"\}],append:false\}", "mod-banner-set"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_banner_pattern\",patterns:[\{pattern:\"minecraft:cross\",color:\"blue\"\}],append:true\}", "mod-banner-append"),
        ("data get entity @s SelectedItem", "mod-banner-data"),
        ("item replace entity @s weapon.mainhand with stick", "mod-stick"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_custom_model_data\",floats:\{values:[1.5,2],mode:\"append\"\},flags:\{values:[true,false],mode:\"append\"\},strings:\{values:[\"x\"],mode:\"append\"\},colors:\{values:[16711680],mode:\"append\"\}\}", "mod-model"),
        ("data get entity @s SelectedItem", "mod-model-data"),
        ("item replace entity @s weapon.mainhand with goat_horn", "mod-horn"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_instrument\",options:\"#minecraft:goat_horns\"\}", "mod-horn-set"),
        ("data get entity @s SelectedItem", "mod-horn-data"),
        ("item replace entity @s weapon.mainhand with firework_star", "mod-star"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_firework_explosion\",shape:\"star\",colors:[I;255,65280],trail:true\}", "mod-star-set"),
        ("data get entity @s SelectedItem", "mod-star-data"),
        ("item replace entity @s weapon.mainhand with firework_rocket", "mod-rocket"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_fireworks\",flight_duration:2,explosions:\{values:[\{shape:\"burst\",has_twinkle:true\}],mode:\"append\"\}\}", "mod-rocket-set"),
        ("data get entity @s SelectedItem", "mod-rocket-data"),
        ("item replace entity @s weapon.mainhand with stone", "mod-stone"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_name\",name:\"Rock\"\}", "mod-stone-name"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:copy_name\",source:\"this\"\}", "mod-copy-name"),
        ("data get entity @s SelectedItem", "mod-copy-name-data"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:copy_custom_data\",source:\"this\",ops:[\{source:\"XpLevel\",target:\"lv\",op:\"replace\"\},\{source:\"abilities\",target:\"ab\",op:\"merge\"\},\{source:\"SelectedItemSlot\",target:\"slots\",op:\"append\"\},\{source:\"SelectedItemSlot\",target:\"slots\",op:\"append\"\},\{source:\"Missing\",target:\"none\",op:\"replace\"\}]\}", "mod-copy-data"),
        ("data get entity @s SelectedItem", "mod-copy-data-data"),
        ("item replace entity @s weapon.mainhand with player_head", "mod-head"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:fill_player_head\",entity:\"this\"\}", "mod-head-fill"),
        ("data get entity @s SelectedItem", "mod-head-data"),
        ("item replace entity @s weapon.mainhand with diamond_sword", "mod-sword-attributes"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_attributes\",replace:false,modifiers:[\{id:\"calcite:a\",attribute:\"minecraft:armor\",operation:\"add_value\",amount:\{type:\"minecraft:uniform\",min:1,max:3\},slot:[\"head\",\"chest\"]\},\{id:\"minecraft:base_attack_damage\",attribute:\"minecraft:attack_damage\",operation:\"add_value\",amount:10,slot:\"mainhand\"\}]\}", "mod-attributes-add"),
        ("data get entity @s SelectedItem", "mod-attributes-add-data"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_attributes\",modifiers:[\{id:\"b\",attribute:\"max_health\",operation:\"add_multiplied_base\",amount:0.5,slot:\"any\"\}]\}", "mod-attributes-replace"),
        ("data get entity @s SelectedItem", "mod-attributes-replace-data"),
        ("item replace entity @s weapon.mainhand with bundle", "mod-bundle"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_contents\",component:\"bundle_contents\",entries:[\{type:\"minecraft:item\",name:\"minecraft:ender_pearl\",modifier:\{type:\"minecraft:set_count\",count:3\}\},\{type:\"minecraft:item\",name:\"minecraft:stone\",modifier:\{type:\"minecraft:set_count\",count:40\}\},\{type:\"minecraft:item\",name:\"minecraft:ender_pearl\",modifier:\{type:\"minecraft:set_count\",count:2\}\},\{type:\"minecraft:item\",name:\"minecraft:diamond_sword\"\},\{type:\"minecraft:item\",name:\"minecraft:shulker_box\"\}]\}", "mod-bundle-set"),
        ("data get entity @s SelectedItem", "mod-bundle-set-data"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:modify_contents\",component:\"bundle_contents\",modifier:\{type:\"minecraft:set_count\",count:1\}\}", "mod-bundle-modify"),
        ("data get entity @s SelectedItem", "mod-bundle-modify-data"),
        ("item replace entity @s weapon.mainhand with chest", "mod-chest-contents"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_contents\",component:\"container\",entries:[\{type:\"minecraft:item\",name:\"minecraft:stone\",modifier:\{type:\"minecraft:set_count\",count:70\}\},\{type:\"minecraft:item\",name:\"minecraft:dirt\",modifier:\{type:\"minecraft:set_count\",count:0\}\},\{type:\"minecraft:item\",name:\"minecraft:apple\"\}]\}", "mod-chest-set"),
        ("data get entity @s SelectedItem", "mod-chest-set-data"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:modify_contents\",component:\"container\",modifier:\{type:\"minecraft:set_count\",count:100\}\}", "mod-chest-modify"),
        ("data get entity @s SelectedItem", "mod-chest-modify-data"),
        ("item replace entity @s weapon.mainhand with crossbow", "mod-crossbow"),
        ("item modify entity @s weapon.mainhand \{type:\"minecraft:set_contents\",component:\"charged_projectiles\",entries:[\{type:\"minecraft:item\",name:\"minecraft:arrow\"\},\{type:\"minecraft:item\",name:\"minecraft:firework_rocket\"\}]\}", "mod-crossbow-set"),
        ("data get entity @s SelectedItem", "mod-crossbow-data"),
        ("", "mod-after"),
    ]
}

// `place-commands`' steps (CAL-362), where `locate`'s are: `place` of features, templates,
// jigsaws and structures about the bot, in a world that generates, as Calcite places them only
// where there's a generator.
fn place_commands_steps() -> List<(str, str)> {
    return [
        // `place feature` (CAL-362): a tree, a patch of flowers, an ore, one written out, a tree in
        // the air, and one unknown and one too far.
        ("place feature minecraft:oak ~5 ~ ~5", "place-oak"),
        ("place feature minecraft:flower_default ~-5 ~ ~-5", "place-flowers"),
        ("place feature minecraft:ore_iron ~ ~-4 ~", "place-ore"),
        ("place feature \{type:\"minecraft:simple_block\",to_place:\{type:\"minecraft:simple\",state:\{Name:\"minecraft:gold_block\"\}\}\} ~-3 ~ ~3", "place-inline"),
        ("place feature minecraft:birch ~3 ~30 ~-3", "place-air"),
        ("place feature minecraft:nope", "place-unknown"),
        ("place feature minecraft:oak ~2000 ~ ~", "place-unloaded"),
        // `place template` (CAL-362): as it is, turned and mirrored, by half its blocks from a
        // seed, strict, and one unknown, a rotation that isn't, and one too far.
        ("place template minecraft:igloo/top ~6 ~ ~-8", "template-igloo"),
        ("place template minecraft:igloo/top ~-14 ~ ~-8 clockwise_90 left_right", "template-turned"),
        ("place template minecraft:igloo/top ~6 ~ ~-20 none none 0.5 7", "template-integrity"),
        ("place template minecraft:igloo/top ~-14 ~ ~-20 180 front_back 1 3 strict", "template-strict"),
        ("place template minecraft:nope", "template-invalid"),
        ("place template minecraft:igloo/top ~ ~ ~ sideways", "template-bad-rotation"),
        ("place template minecraft:igloo/top ~3000 ~ ~", "template-unloaded"),
        // `place jigsaw` and `place structure` (CAL-362): a village's well and the street it leads
        // to, a pool that isn't, a jigsaw no piece has; an igloo and a desert well's structure
        // where neither would be, and one that isn't.
        ("place jigsaw minecraft:village/plains/town_centers minecraft:bottom 2 ~20 ~ ~20", "jigsaw-village"),
        ("place jigsaw minecraft:nope minecraft:bottom 2", "jigsaw-invalid"),
        ("place jigsaw minecraft:village/plains/town_centers minecraft:nothing 2 ~-20 ~ ~20", "jigsaw-failed"),
        ("place structure minecraft:igloo ~-24 ~ ~-24", "structure-igloo"),
        ("place structure minecraft:swamp_hut ~24 ~ ~-24", "structure-hut"),
        ("place structure minecraft:nope", "structure-invalid"),
        // The templates `place template` suggests (CAL-371).
        ("/place template minecraft:igloo/", "suggest-template"),
        // `test` (CAL-365): a test block of a test that isn't made, one too big, the place looked
        // at, a selector that matches none and a test with no block, the test that isn't reset,
        // cleared within 20; then `always_pass`'s made, located, reset, the one looked at cleared,
        // those near cleared, and `stop`.
        ("test create rig:box 3", "test-create"),
        ("test create rig:box 49", "test-too-large"),
        ("test pos", "test-pos"),
        ("test locate rig:*", "test-locate-none"),
        ("test locate *", "test-locate-unplaced"),
        ("test resetclosest", "test-reset-unknown"),
        ("test clearall 20", "test-clear"),
        ("test create always_pass", "test-create-pass"),
        ("test locate always_pass", "test-locate"),
        ("test resetthese", "test-reset"),
        ("test clearthat", "test-clear-that"),
        ("test clearthese", "test-cleared"),
        // `test run` and its kin (CAL-365): `always_pass` run, the nearest run where it is, the
        // failed ones of which there are none, it run twice and twice over, then cleared.
        ("test run always_pass", "test-run"),
        ("test runclosest", "test-run-closest"),
        ("test runfailed", "test-run-failed"),
        ("test run always_pass 2", "test-run-twice"),
        ("test runmultiple always_pass 2", "test-run-multiple"),
        ("test clearthese", "test-run-cleared"),
        ("test stop", "test-stop"),
    ]
}

// `structure-piece`'s steps (CAL-221), where `locate`'s are: the bot forces the chunk of the
// taiga village `locate` finds and, once it's there, tests whether the block under the top of
// the village's middle is in its `structures`: as `village_taiga`, not as `village_plains`, as
// one of a list with `fortress`, named without its namespace; by the tags `#village` and
// `#on_taiga_village_maps`, which hold it, and `#cats_spawn_in`, which doesn't (CAL-334); and
// whether the air far over it is.
fn structure_piece_steps() -> List<(str, str)> {
    return [
        ("forceload add -272 656", "structure-piece-forced"),
        ("", "structure-piece-1"), ("", "structure-piece-2"), ("", "structure-piece-3"), ("", "structure-piece-4"), ("", "structure-piece-5"),
        ("execute positioned -272 0 656 positioned over world_surface positioned ~ ~-1 ~ if predicate \{type:\"minecraft:location_check\",predicate:\{structures:\"minecraft:village_taiga\"\}\}", "structure-piece-taiga"),
        ("execute positioned -272 0 656 positioned over world_surface positioned ~ ~-1 ~ if predicate \{type:\"minecraft:location_check\",predicate:\{structures:\"minecraft:village_plains\"\}\}", "structure-piece-plains"),
        ("execute positioned -272 0 656 positioned over world_surface positioned ~ ~-1 ~ if predicate \{type:\"minecraft:location_check\",predicate:\{structures:[\"minecraft:fortress\",\"village_taiga\"]\}\}", "structure-piece-list"),
        ("execute positioned -272 0 656 positioned over world_surface positioned ~ ~-1 ~ if predicate \{type:\"minecraft:location_check\",predicate:\{structures:\"#minecraft:village\"\}\}", "structure-piece-tag"),
        ("execute positioned -272 0 656 positioned over world_surface positioned ~ ~-1 ~ if predicate \{type:\"minecraft:location_check\",predicate:\{structures:\"#minecraft:on_taiga_village_maps\"\}\}", "structure-piece-map-tag"),
        ("execute positioned -272 0 656 positioned over world_surface positioned ~ ~-1 ~ if predicate \{type:\"minecraft:location_check\",predicate:\{structures:\"#minecraft:cats_spawn_in\"\}\}", "structure-piece-other-tag"),
        ("execute positioned -272 300 656 if predicate \{type:\"minecraft:location_check\",predicate:\{structures:\"minecraft:village_taiga\"\}\}", "structure-piece-sky"),
        ("forceload remove -272 656", "structure-piece-let-go"),
        ("", "structure-piece-after"),
    ]
}

// `spear-unseat`'s steps (CAL-214), where `talk`'s are: at midnight, the bot, in survival mode
// with resistance V, rides an armor stand by `ride`, with another three blocks south, and
// summons a zombie with an iron spear sixteen blocks south, which comes, lowers it and charges,
// its spear meeting the stand in its way, which shakes or breaks, and the bot, which it knocks
// off its seat. It watches for 15 seconds.
fn spear_unseat_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "spear-unseat-night"),
        ("gamemode survival", "spear-unseat-survival"),
        ("effect give @s resistance 600 4 true", "spear-unseat-armor"),
        ("summon armor_stand 0.5 -60 0.5", "spear-unseat-seat"),
        ("ride @s mount @e[type=armor_stand,limit=1,sort=nearest]", "spear-unseat-mounted"),
        ("summon armor_stand 0.5 -60 3.5", "spear-unseat-stand"),
        ("summon zombie 0.5 -60 9.5 \{PersistenceRequired:1b,equipment:\{mainhand:\{id:\"minecraft:iron_spear\",count:1\}\}\}", "spear-unseat-zombie"),
        ("", "spear-unseat-1"), ("", "spear-unseat-2"), ("", "spear-unseat-3"), ("", "spear-unseat-4"), ("", "spear-unseat-5"),
        ("", "spear-unseat-6"), ("", "spear-unseat-7"), ("", "spear-unseat-8"), ("", "spear-unseat-9"), ("", "spear-unseat-10"),
        ("", "spear-unseat-11"), ("", "spear-unseat-12"), ("", "spear-unseat-13"), ("", "spear-unseat-14"),
        ("ride @s dismount", "spear-unseat-off"),
        ("", "spear-unseat-after"),
    ]
}

// `ravager-stand`'s steps (CAL-214), as `ravager-shield`'s with an armor stand a block east of the
// bot, which each roar knocks away and doesn't hurt.
fn ravager_stand_steps() -> List<(str, str)> {
    return [
        ("time set day", "ravager-stand-day"),
        ("gamemode survival", "ravager-stand-survival"),
        ("effect clear @s", "ravager-stand-clear"),
        ("effect give @s resistance 600 4 true", "ravager-stand-armor"),
        ("item replace entity @s weapon.mainhand with shield", "ravager-stand-held"),
        ("#throw 0 0", "ravager-stand-raised"),
        ("summon armor_stand 1.5 -60 0.5", "ravager-stand-stand"),
        ("summon ravager 0.5 -60 10.5", "ravager-stand-south"),
        ("", "ravager-stand-1"), ("", "ravager-stand-2"), ("", "ravager-stand-3"), ("", "ravager-stand-4"), ("", "ravager-stand-5"),
        ("", "ravager-stand-6"), ("", "ravager-stand-7"), ("", "ravager-stand-8"), ("", "ravager-stand-9"), ("", "ravager-stand-10"),
        ("", "ravager-stand-11"), ("", "ravager-stand-12"), ("", "ravager-stand-13"), ("", "ravager-stand-14"),
        ("", "ravager-stand-after"),
    ]
}

// `zoglin-shield`'s steps (CAL-214), as `ravager-shield`'s with a zoglin, whose hits the shield
// blocks and which throws the bot each time, `Zoglin.blockedByItem`, in place of a mob's push.
// It watches for 15 seconds.
fn zoglin_shield_steps() -> List<(str, str)> {
    return [
        ("time set day", "zoglin-shield-day"),
        ("gamemode survival", "zoglin-shield-survival"),
        ("effect clear @s", "zoglin-shield-clear"),
        ("effect give @s resistance 600 4 true", "zoglin-shield-armor"),
        ("item replace entity @s weapon.mainhand with shield", "zoglin-shield-held"),
        ("#throw 0 0", "zoglin-shield-raised"),
        ("summon zoglin 0.5 -60 10.5", "zoglin-shield-south"),
        ("", "zoglin-shield-1"), ("", "zoglin-shield-2"), ("", "zoglin-shield-3"), ("", "zoglin-shield-4"), ("", "zoglin-shield-5"),
        ("", "zoglin-shield-6"), ("", "zoglin-shield-7"), ("", "zoglin-shield-8"), ("", "zoglin-shield-9"), ("", "zoglin-shield-10"),
        ("", "zoglin-shield-11"), ("", "zoglin-shield-12"), ("", "zoglin-shield-13"), ("", "zoglin-shield-14"),
        ("", "zoglin-shield-after"),
    ]
}

// `ravaged`'s steps (CAL-200), where `ravagers`' are: the bot, in survival mode, with resistance
// V, stands on a pillar of stone two blocks high, behind a wall of persistent oak leaves two high
// across its way south, and summons a ravager ten blocks south of it, which sees it over the wall,
// comes to it through the leaves, which cost it nothing on its way, breaks those it runs into,
// with their drops, and hits it. It watches for 15 seconds.
fn ravaged_steps() -> List<(str, str)> {
    return [
        ("time set day", "ravaged-day"),
        ("gamemode survival", "ravaged-survival"),
        ("effect clear @s", "ravaged-clear"),
        ("effect give @s resistance 600 4 true", "ravaged-armor"),
        ("fill 0 -60 0 0 -59 0 stone", "ravaged-pillar"),
        ("tp @s 0.5 -58 0.5", "ravaged-up"),
        ("fill -6 -60 4 6 -59 4 oak_leaves[persistent=true]", "ravaged-leaves"),
        ("summon ravager 0.5 -60 10.5", "ravaged-ravager"),
        ("", "ravaged-1"), ("", "ravaged-2"), ("", "ravaged-3"), ("", "ravaged-4"), ("", "ravaged-5"),
        ("", "ravaged-6"), ("", "ravaged-7"), ("", "ravaged-8"), ("", "ravaged-9"), ("", "ravaged-10"),
        ("", "ravaged-11"), ("", "ravaged-12"), ("", "ravaged-13"), ("", "ravaged-14"),
        ("", "ravaged-after"),
    ]
}

// `vexes`' steps (CAL-200), where `ravagers`' are: the bot, in survival mode, with resistance V,
// summons a vex two blocks up and six south of it, given an iron sword as it spawns, which flies
// through what's in its way, takes the bot up, charges it, heard, and hits it where their boxes
// meet, `VexChargeAttackGoal`. It watches for 12 seconds.
fn vexes_steps() -> List<(str, str)> {
    return [
        ("time set day", "vexes-day"),
        ("gamemode survival", "vexes-survival"),
        ("effect clear @s", "vexes-clear"),
        ("effect give @s resistance 600 4 true", "vexes-armor"),
        ("summon vex 0.5 -58 6.5", "vexes-south"),
        ("", "vexes-1"), ("", "vexes-2"), ("", "vexes-3"), ("", "vexes-4"), ("", "vexes-5"),
        ("", "vexes-6"), ("", "vexes-7"), ("", "vexes-8"), ("", "vexes-9"), ("", "vexes-10"),
        ("", "vexes-11"),
        ("", "vexes-after"),
    ]
}

// `vexbound`'s steps (CAL-200), where `vexes`' are: the bot, in creative mode, which it doesn't
// take up, summons a vex eight blocks south of it, bound to a block above there and with 60 ticks
// of life, which moves about within 7 of that block, `VexRandomMoveGoal`, and, its life run out,
// starves, hurt by 1 every 20 ticks, until it dies, dropping its experience but not its sword. It
