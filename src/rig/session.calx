        ("#use-mob 0", "llama-chest-chested"),
        ("item replace entity @s weapon.mainhand with hay_block", "llama-chest-hay"),
        ("#use-mob 0", "llama-chest-fed-hay"),
        ("summon llama -1.5 -60 1.5", "llama-chest-wild"),
        ("item replace entity @s weapon.mainhand with wheat", "llama-chest-wheat"),
        ("#use-mob 1", "llama-chest-fed-wheat"),
        ("", "llama-chest-1"), ("", "llama-chest-2"), ("", "llama-chest-3"), ("", "llama-chest-4"), ("", "llama-chest-5"),
        ("", "llama-chest-6"), ("", "llama-chest-7"), ("", "llama-chest-8"),
        ("", "llama-chest-after"),
    ]
}

