        ("effect clear @s", "withered-clear"),
        ("effect give @s resistance 600 4 true", "withered-armor"),
        ("summon wither_skeleton 0.5 -60 8.5", "withered-sword"),
        ("summon wither_skeleton -10.5 -60 0.5 \{equipment:\{mainhand:\{id:\"minecraft:bow\",count:1\}\}\}", "withered-archer"),
        ("", "withered-1"), ("", "withered-2"), ("", "withered-3"), ("", "withered-4"), ("", "withered-5"), ("", "withered-6"),
        ("", "withered-7"), ("", "withered-8"), ("", "withered-9"), ("", "withered-10"), ("", "withered-11"),
        ("", "withered-after"),
    ]
}

