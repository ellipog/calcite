}

// What `rod-hooks` does on the pond fixture's world (CAL-214), `rod-casts`' bot an operator,
// each use facing as it says, which turns the bot so: an armor stand summoned at 100 between it
// and the water, two blocks south; at 200 it casts facing south and level, the hook falling
// into the stand, `setHookedEntity`, and following it, and reels in at 240, pulling it,
// `pullEntity`. The stand killed at 270, a cod summoned on the grass by the water at 280; at
// 300 it casts 45 degrees down, the hook falling onto the cod, and reels in at 330; at 360 it
// casts east, 30 degrees down, onto the grass, and reels in at 400, the hook on the ground; it
// marks the server's clock at 440 and leaves at 480.
fn rod_hooks() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.CommandAt("summon armor_stand 0.5 -60 3.5", 100, "stand"))
    packets.push(Dug.UseItemTurnedAt(0, 1, 0.0f32, 0.0f32, 200, "cast"))
    packets.push(Dug.UseItemTurnedAt(0, 2, 0.0f32, 0.0f32, 240, "reel"))
    packets.push(Dug.CommandAt("kill @e[type=armor_stand]", 270, "stand-gone"))
    packets.push(Dug.CommandAt("summon item 0.5 -60 3.2 \{Item:\{id:\"minecraft:cod\",count:1\}\}", 280, "cod"))
    packets.push(Dug.UseItemTurnedAt(0, 3, 0.0f32, 45.0f32, 300, "cast-cod"))
    packets.push(Dug.UseItemTurnedAt(0, 4, 0.0f32, 45.0f32, 330, "reel-cod"))
    packets.push(Dug.UseItemTurnedAt(0, 5, -90.0f32, 30.0f32, 360, "cast-grass"))
    packets.push(Dug.UseItemTurnedAt(0, 6, -90.0f32, 30.0f32, 400, "reel-grass"))
    packets.push(Dug.Mark(440, "settled"))
    packets.push(Dug.Leave(480))
    return [Dig { name: String(), packets: packets }]
}

// What `chorus` does on the eaten fixture's world (CAL-214), by the server's clock: at 110 it
