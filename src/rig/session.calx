        ("setblock 5 -60 5 glass", "spawnpoint-glass"),
        ("kill", "spawnpoint-blocked"),
        ("", "spawnpoint-blocked-respawns"),
        ("", "spawnpoint-blocked-respawned"),
        // Nether portals (D577): a frame of obsidian along x, two by three inside, lit with fire;
        // the bot in it till it's taken to the Nether, which builds a portal there; out of that
        // one a block and back in once its cooldown's out, till it's taken back to the one it
