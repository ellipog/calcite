        handed("wall", "cobblestone_wall", 2, -61, 3, 6),
        handed("chest", "chest", 3, -61, 3, 7),
        handed("chest-beside", "chest", 4, -61, 3, 8),
        handed_on_side("trapdoor", "oak_trapdoor", -3, -60, 3, 3, 0.8f32, 9),
        handed_on_side("lever", "lever", -2, -60, 3, 3, 0.5f32, 10),
        handed_on_side("torch-by-wall", "torch", 2, -60, 3, 3, 0.5f32, 11),
        Dig { name: "stairs-west", packets: [Dug.Turn(90.0f32, 0.0f32), Dug.Give(36i16, "oak_stairs"), on_top(-2, -61, 5, 12)] },
        Dig { name: "lantern", packets: [Dug.Turn(0.0f32, 0.0f32), Dug.Give(36i16, "lantern"), on_top(-1, -61, 5, 13)] },
        handed("redstone", "redstone", 0, -61, 5, 14),
        handed("redstone-torch", "redstone_torch", 1, -61, 5, 15),
        handed("leaves", "oak_leaves", 2, -61, 5, 16),
        Dig { name: "skull", packets: [Dug.Turn(30.0f32, 0.0f32), Dug.Give(36i16, "skeleton_skull"), on_top(0, -61, 4, 17)] },
        Dig { name: "hopper", packets: [Dug.Turn(0.0f32, 0.0f32), Dug.Give(36i16, "hopper"), on_top(-3, -61, -3, 18)] },
        handed("end-rod", "end_rod", -2, -61, -3, 19),
        handed("lightning-rod", "lightning_rod", -1, -61, -3, 20),
        handed("amethyst", "amethyst_cluster", 0, -61, -3, 21),
        handed("shulker-box", "shulker_box", 1, -61, -3, 22),
        handed("iron-bars", "iron_bars", 2, -61, -3, 23),
        handed("fence-gate", "oak_fence_gate", 3, -61, -3, 24),
    ]
}

// What `creative` sets, slot by slot of the inventory menu: stone into the hotbar, leggings on,
// the inventory's logs out, dirt into the crafting result, which isn't a slot it may set, two
// swords in one slot, a pickaxe with damage, bread that can't be eaten, and the offhand emptied.
fn creative_slots() -> List<(i16, List<u8>)> {
    return [
        (36i16, untrusted("stone", 5, none, [])),
        (7i16, untrusted("iron_leggings", 1, none, [])),
        (9i16, untrusted("air", 0, none, [])),
        (0i16, untrusted("dirt", 1, none, [])),
        (44i16, untrusted("diamond_sword", 2, none, [])),
        (37i16, untrusted("iron_pickaxe", 1, some(7), [])),
        (38i16, untrusted("bread", 3, none, [String("food")])),
        (45i16, untrusted("air", 0, none, [])),
    ]
}

fn main() {
    let given = args()
    if given.len() != 4 and given.len() != 5 {
        panic("usage: session PORT VIEW SCENARIO OUT [MATE_OUT]")
    }
    let port = u16.wrap(number(given[0]))
    let view_chunks = u64(in_view_count(i32.wrap(number(given[1]))))
    let scenario = given[2].copy()
    if not known_scenario(scenario) {
        panic("session: what's the scenario {scenario}?")
    }
    if (scenario == "duel" or scenario == "talk" or scenario == "select") and given.len() != 5 {
        panic("session: {scenario} needs where Mate's packets go")
    }
    let net = Net.new()!
    let start = unsafe { Instant.now() }
    var bots = List<Bot>()
    bots.push(new_bot(net, port, scenario.copy(), String("Bot")))
    if scenario == "duel" or scenario == "talk" or scenario == "select" {
        bots[0].mate_at = 100
    }
    bots[0].start(net, port)
    var next_tick: u64 = TICK_NS
    var events = List<Event>()
    while not all_done(bots) {
        // Mate joins once the bot's seen the game time it's to (CAL-162).
        if bots.len() == 1 and bots[0].mate_due {
            bots.push(new_bot(net, port, "{scenario}-mate", String("Mate")))
            bots[1].start(net, port)
        }
        let now = unsafe { Instant.now() }.nanos_since(start)
        var due = next_tick
        for b in bots {
            if not b.held.is_empty() and b.held_until < due {
                due = b.held_until
            }
        }
        let wait = if due > now { i64.wrap((due - now + MS - 1) / MS) } else { 0 }
        net.poll(wait, mut events)
        var closed = List<bool>()
        for _ in 0..bots.len() {
            closed.push(false)
        }
        for e in events {
            match e {
                Event.Received(c) => {
                    for k in 0..bots.len() {
                        if c == bots[k].conn {
                            _ = bots[k].codec.read_from(net, c)
                        }
                    }
                },
                Event.Closed(c) => {
                    for k in 0..bots.len() {
                        if c == bots[k].conn {
                            closed[k] = true
                        }
                    }
                },
                _ => {},
            }
        }
        let after = unsafe { Instant.now() }.nanos_since(start)
        for k in 0..bots.len() {
            bots[k].handle(net, after)
            bots[k].answer_held(net, after)
            if closed[k] and not bots[k].done {
                if not bots[k].closed {
                    bots[k].mark(String("closed"))
                }
                bots[k].closed = true
                if bots[k].phase != Phase.Leave {
                    bots[k].phase = Phase.Before
                }
            }
        }
        if after >= next_tick {
            next_tick += TICK_NS
            if next_tick < after {
                next_tick = after + TICK_NS
            }
            for k in 0..bots.len() {
                bots[k].tick(net, after, view_chunks)
            }
        }
    }
    let chunks = bots[0].chunks
    let left_at = bots[0].left_at
    let first = bots.remove(0)
    write(given[3], first.out.into_bytes())!
    if not bots.is_empty() {
        let mate = bots.remove(0)
        write(given[4], mate.out.into_bytes())!
    }
    // Where it left by the server's clock, when, which the runner waits on the server's pause
    // for, so both servers run the same ticks after it (D506).
    if left_at >= 0 {
        println("{chunks} chunks, left at game time {left_at}")
    } else {
        println("{chunks} chunks")
    }
}

// A bot for the scenario `scenario` logging in as `name`, connected, knowing the entity types it
// looks for by their IDs.
fn new_bot(net: Net, port: u16, scenario: own String, name: own String) -> Bot {
    let conn = net.connect("127.0.0.1", port)!
    var bot = Bot { scenario: scenario, name: name, conn: conn, codec: Codec.new(), state: State.Handshake, out: Writer.new() }
    let kinds = builtin_entries(6)
    for i in 0..kinds.len() {
        if kinds[i] == String("cow") {
            bot.cow_type = i32.wrap(i)
        } else if kinds[i] == String("sheep") {
            bot.sheep_type = i32.wrap(i)
        } else if kinds[i] == String("item") {
            bot.item_type = i32.wrap(i)
        } else if kinds[i] == String("zombie") {
            bot.zombie_type = i32.wrap(i)
        } else if kinds[i] == String("enderman") {
            bot.ender_type = i32.wrap(i)
        } else if kinds[i] == String("armadillo") {
            bot.armadillo_type = i32.wrap(i)
        } else if kinds[i] == String("spider") {
            bot.spider_type = i32.wrap(i)
        } else if kinds[i] == String("villager") {
            bot.villager_type = i32.wrap(i)
        } else if kinds[i] == String("armor_stand") {
            bot.stand_type = i32.wrap(i)
        } else if kinds[i] == String("end_crystal") {
            bot.crystal_type = i32.wrap(i)
        } else if kinds[i] == String("player") {
            bot.player_type = i32.wrap(i)
        }
    }
    return bot
}

// Whether every bot's done.
fn all_done(bots: List<Bot>) -> bool {
    for b in bots {
        if not b.done {
            return false
        }
    }
    return true
}

// Whether the bot knows the scenario `scenario`.
fn known_scenario(scenario: String) -> bool {
    let names: List<str> = ["status", "outdated", "bad-name", "stranger", "join", "watch", "watch-late", "creative", "clicks", "crafts", "dig", "dig-creative", "place", "place-creative", "use", "use-items", "use-books", "use-containers", "items", "items-saved", "orbs", "feed", "attack", "sweep", "enchant", "protect", "stand-hits", "thorns", "fall", "mace", "swim", "checks", "duel", "zombie", "arrows", "skeleton", "spider", "creeper", "enderman", "ender", "armadillo", "brush", "villager", "villagers", "compost", "asleep", "breed", "hearsay", "bell", "bane", "tipped", "dosed", "lifted", "undying", "eaten", "beacons", "beacon-menu", "traders", "frost", "soul", "splash", "linger", "talk", "select", "mites", "end", "crystals", "gateways"]
    for n in names {
        if scenario == String(n) {
            return true
        }
    }
    return false
}
