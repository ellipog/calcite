        // AI, a stone, two stone, which merge with it where they come out, an orb, which comes to
        // the bot, a splash potion and an arrow, falling. Then, the bot back in the portal, a
        // floor of obsidian built north of it with a wall two blocks off, and the air between
        // cleared, for ender pearls (D579).
        ("execute in minecraft:overworld run summon pig 32.5 -60 30.5 \{NoAI:1b\}", "travel-pig"),
        ("execute in minecraft:overworld run summon item 31.5 -60 30.5 \{Item:\{id:stone,count:1\},PickupDelay:1000\}", "travel-item"),
        ("execute in minecraft:overworld run summon item 31.5 -60 30.5 \{Item:\{id:stone,count:2\},PickupDelay:1000\}", "travel-merge"),
        ("execute in minecraft:overworld run summon experience_orb 31.5 -60 30.5 \{Value:3\}", "travel-orb"),
