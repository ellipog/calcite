// `turtle-eggs`' steps (CAL-201), where `wolves`' are: the bot, in creative mode, fills the end
// portal with stone, CAL-307, lays sand and sets turtle eggs on it, three about to hatch and one
// just laid, sets the time to when eggs hatch, 21100, `turtle_egg_hatch_chance`, and random ticks
// to 100 a section, so they crack, `entity.turtle.egg_crack`, and hatch, `TurtleEggBlock.randomTick`,
// each egg's break shown and a baby turtle made at it, its home there. A zombie wearing a helmet
// takes up the babies on land, `Turtle.BABY_ON_LAND_SELECTOR`, and goes for the eggs,
// `ZombieAttackTurtleEggGoal`, as the babies go to water. It watches for 20 seconds.
fn turtle_eggs_steps() -> List<(str, str)> {
    return [
        ("fill 3 -61 -1 5 -61 1 minecraft:stone", "turtle-eggs-portal"),
        ("gamemode creative", "turtle-eggs-creative"),
        ("fill -3 -61 2 3 -61 8 minecraft:sand", "turtle-eggs-sand"),
        ("fill 5 -62 2 9 -61 8 minecraft:water", "turtle-eggs-pool"),
        ("setblock 0 -60 5 minecraft:turtle_egg[eggs=3,hatch=2]", "turtle-eggs-three"),
        ("setblock -2 -60 3 minecraft:turtle_egg[eggs=1,hatch=0]", "turtle-eggs-one"),
        ("summon zombie -9.5 -60 9.5 \{equipment:\{head:\{id:\"minecraft:leather_helmet\",count:1\}\}\}", "turtle-eggs-zombie"),
        ("gamerule random_tick_speed 100", "turtle-eggs-ticks"),
        ("time set 21100", "turtle-eggs-time"),
        ("", "turtle-eggs-1"), ("", "turtle-eggs-2"), ("", "turtle-eggs-3"), ("", "turtle-eggs-4"), ("", "turtle-eggs-5"),
        ("", "turtle-eggs-6"), ("", "turtle-eggs-7"), ("", "turtle-eggs-8"), ("", "turtle-eggs-9"), ("", "turtle-eggs-10"),
        ("", "turtle-eggs-11"), ("", "turtle-eggs-12"), ("", "turtle-eggs-13"), ("", "turtle-eggs-14"), ("", "turtle-eggs-15"),
