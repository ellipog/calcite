    ]
}

// `fishing`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival
// mode, fills a pool 3 blocks across just east of it and summons a cod named Bubbles and a silent
// one there without AI in one tick; then takes the first in a water bucket, a bucket of cod of its
// name and health; and, in creative mode, the second, keeping its water bucket. It watches for 5
// seconds.
fn fishing_steps() -> List<(str, str)> {
    return [
