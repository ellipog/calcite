        ("", "beeflight-6"), ("", "beeflight-7"), ("", "beeflight-8"), ("", "beeflight-9"), ("", "beeflight-10"),
        ("", "beeflight-11"), ("", "beeflight-12"), ("", "beeflight-13"), ("", "beeflight-14"), ("", "beeflight-15"),
        ("", "beeflight-16"), ("", "beeflight-17"), ("", "beeflight-18"), ("", "beeflight-19"), ("", "beeflight-20"),
        ("", "beeflight-21"), ("", "beeflight-22"), ("", "beeflight-23"), ("", "beeflight-24"), ("", "beeflight-25"),
        ("", "beeflight-26"), ("", "beeflight-27"), ("", "beeflight-28"), ("", "beeflight-29"), ("", "beeflight-30"),
        ("", "beeflight-after"),
    ]
}

// `hives`' steps (CAL-177), where `riding`'s are, by day: the bot in creative mode sets hives with
// bees without AI in them: a hive whose bee's time in it is up, which lets it out past its front;
// a nest with honey 4 whose bee brought nectar, which delivers it, filling the nest; a hive facing
// stone, whose bee stays till the stone's gone; and a hive that knows a flower, whose baby bee
// comes out grown, knowing it, and whose other bee stays in a while longer, buzzing as the level's
// random says; then it watches them for 10 seconds. Every hive's empty as the level's saved, as
// what a hive holds counts its ticks without its chunk changed, so it's saved as of whenever the
// chunk last was, which vanilla paces by the clock.
fn hive_steps() -> List<(str, str)> {
    return [
        ("time set day", "hives-day"),
        ("gamemode creative", "hives-creative"),
        ("setblock 2 -60 12 beehive[facing=south]\{bees:[\{entity_data:\{id:\"minecraft:bee\",NoAI:1b\},ticks_in_hive:590,min_ticks_in_hive:600\}]\}", "hives-due"),
        ("setblock 6 -60 12 bee_nest[facing=east,honey_level=4]\{bees:[\{entity_data:\{id:\"minecraft:bee\",NoAI:1b,HasNectar:1b,CropsGrownSincePollination:4\},ticks_in_hive:2390,min_ticks_in_hive:2400\}]\}", "hives-honey"),
        ("setblock 10 -60 11 stone", "hives-stone"),
        ("setblock 10 -60 12 beehive[facing=north]\{bees:[\{entity_data:\{id:\"minecraft:bee\",NoAI:1b\},ticks_in_hive:590,min_ticks_in_hive:600\}]\}", "hives-blocked"),
        ("setblock 14 -60 12 beehive[facing=south]\{flower_pos:[I;14,-60,16],bees:[\{entity_data:\{id:\"minecraft:bee\",NoAI:1b,Age:-300,InLove:500\},ticks_in_hive:590,min_ticks_in_hive:600\},\{entity_data:\{id:\"minecraft:bee\",NoAI:1b\},ticks_in_hive:450,min_ticks_in_hive:600\}]\}", "hives-flower"),
        ("", "hives-1"), ("", "hives-2"), ("", "hives-3"),
        ("setblock 10 -60 11 air", "hives-unblocked"),
        ("", "hives-4"), ("", "hives-5"),
        ("", "hives-6"), ("", "hives-7"), ("", "hives-8"), ("", "hives-9"), ("", "hives-10"),
        ("", "hives-after"),
    ]
}

// `snowstep`'s steps (CAL-176), where `riding`'s are, at midnight: the bot in creative mode lays
// oak planks, covers their west half with a layer of snow, and summons a horse on each half, which
// stroll; a horse's step on the planks is wood's, and under snow the snow's, as
// `AbstractHorse.playStepSound` has it; then it watches them for 40 seconds.
fn snowstep_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "snowstep-night"),
        ("gamemode creative", "snowstep-creative"),
        ("fill 0 -61 6 12 -61 16 oak_planks", "snowstep-planks"),
        ("fill 0 -60 6 6 -60 16 snow", "snowstep-snow"),
        ("summon horse 3.5 -60 11.5", "snowstep-snowy"),
        ("summon horse 9.5 -60 11.5", "snowstep-bare"),
        ("", "snowstep-1"), ("", "snowstep-2"), ("", "snowstep-3"), ("", "snowstep-4"), ("", "snowstep-5"),
        ("", "snowstep-6"), ("", "snowstep-7"), ("", "snowstep-8"), ("", "snowstep-9"), ("", "snowstep-10"),
        ("", "snowstep-11"), ("", "snowstep-12"), ("", "snowstep-13"), ("", "snowstep-14"), ("", "snowstep-15"),
        ("", "snowstep-16"), ("", "snowstep-17"), ("", "snowstep-18"), ("", "snowstep-19"), ("", "snowstep-20"),
        ("", "snowstep-21"), ("", "snowstep-22"), ("", "snowstep-23"), ("", "snowstep-24"), ("", "snowstep-25"),
        ("", "snowstep-26"), ("", "snowstep-27"), ("", "snowstep-28"), ("", "snowstep-29"), ("", "snowstep-30"),
        ("", "snowstep-31"), ("", "snowstep-32"), ("", "snowstep-33"), ("", "snowstep-34"), ("", "snowstep-35"),
        ("", "snowstep-36"), ("", "snowstep-37"), ("", "snowstep-38"), ("", "snowstep-39"), ("", "snowstep-40"),
        ("", "snowstep-after"),
    ]
}

// `split-rider`'s steps (CAL-175), where `riding`'s are: the bot in creative mode summons a slime
// of size 2 without AI at 1 health, ridden by a chicken without AI, and an arrow flying into it
// from the west, which kills it; as it's taken out it splits into small slimes, the chicken
// getting off as the first is made, `SPLIT_ON_DEATH`; then it watches them for 8 seconds.
fn split_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "split-creative"),
        ("summon slime 5.5 -60 5.5 \{Size:1,Health:1.0f,NoAI:1b,Passengers:[\{id:\"minecraft:chicken\",NoAI:1b\}]\}", "split-slime"),
        ("summon arrow 2.5 -59.5 5.5 \{Motion:[1.5d,0.0d,0.0d]\}", "split-arrow"),
        ("", "split-1"),
        ("", "split-2"),
        ("", "split-3"),
        ("", "split-4"),
        ("", "split-5"),
        ("", "split-6"),
        ("", "split-7"),
        ("", "split-8"),
        ("", "split-after"),
    ]
}

