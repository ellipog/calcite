        ("item replace entity @s weapon.mainhand with golden_dandelion 4", "agelock-dandelions"),
        ("#use-mob 0", "agelock-lock"),
        ("#use-mob 0", "agelock-too-soon"),
        ("item replace entity @s weapon.mainhand with wheat 2", "agelock-wheat"),
        ("#use-mob 0", "agelock-fed"),
        ("", "agelock-wait-1"), ("", "agelock-wait-2"), ("", "agelock-wait-3"),
        ("item replace entity @s weapon.mainhand with golden_dandelion 4", "agelock-dandelions-again"),
        ("#use-mob 0", "agelock-unlock"),
        ("#use-mob 1", "agelock-lamb"),
        ("#use-mob 2", "agelock-grown"),
        ("", "agelock-1"), ("", "agelock-2"), ("", "agelock-3"), ("", "agelock-4"), ("", "agelock-5"),
        ("", "agelock-after"),
    ]
}

// `saddles`' steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival mode,
// summons a pig, a piglet, a sheep and a saddled pig without AI around it in one tick; then puts
// a saddle on the pig, and tries one on the piglet, which can't wear it; shears the saddled pig's
// saddle off and the pig's, each dropped; and dyes the sheep red, then tries red again, which
// does nothing. It watches for 5 seconds, picking up what falls near it.
fn saddles_steps() -> List<(str, str)> {
    return [
