        ("", "stand-use-1"), ("", "stand-use-2"), ("", "stand-use-3"), ("", "stand-use-4"), ("", "stand-use-5"),
        ("", "stand-use-after"),
    ]
}

// `leads`' steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival mode,
// summons a cow, a sheep, a pig and a zombie without AI in one tick, west, north and south of it,
// away from the end portal east of the spawn, which would take a lead dropped in; leashes the
// cow, and tries the zombie, which can't be; walks 8 blocks south, in its chunk, whose chunks
// around it stay the same, the cow pulled toward it, then 5 more, its leash breaking, and back;
// leashes the cow and the sheep again, then, sneaking, ties both to the pig; cuts them from it
// with shears; leashes the sheep and lets it go; and, in creative mode, leashes the cow, lets it
// go, which drops nothing, and leashes it again. It watches for 5 seconds.
fn leads_steps() -> List<(str, str)> {
    return [
        ("time set day", "leads-day"),
        ("gamemode survival", "leads-survival"),
        ("#all summon cow -2.5 -60 0.5 \{NoAI:1b\};summon sheep 0.5 -60 3.5 \{NoAI:1b\};summon pig -1.5 -60 2.5 \{NoAI:1b\};summon zombie 0.5 -60 -2.5 \{NoAI:1b\}", "leads-mobs"),
        ("item replace entity @s weapon.mainhand with lead 8", "leads-lead"),
        ("#use-mob 0", "leads-cow"),
        ("#use-mob 3", "leads-zombie"),
        ("#move 0.5 -60 8.5", "leads-away"),
        ("", "leads-pulled"),
        ("#move 0.5 -60 13.5", "leads-far"),
        ("", "leads-snapped"),
        ("#move 0.5 -60 5.5", "leads-coming"),
        ("#move 0.5 -60 0.5", "leads-back"),
        ("#use-mob 0", "leads-cow-again"),
        ("#use-mob 1", "leads-sheep"),
        ("#sneak-use-mob 2", "leads-to-pig"),
        ("item replace entity @s weapon.mainhand with shears", "leads-shears"),
        ("#use-mob 2", "leads-cut"),
        ("item replace entity @s weapon.mainhand with lead 2", "leads-lead-again"),
        ("#use-mob 1", "leads-sheep-again"),
        ("#use-mob 1", "leads-untied"),
        ("gamemode creative", "leads-creative"),
        ("#use-mob 0", "leads-creative-cow"),
        ("#use-mob 0", "leads-creative-untied"),
        ("#use-mob 0", "leads-kept"),
        ("", "leads-1"), ("", "leads-2"), ("", "leads-3"), ("", "leads-4"), ("", "leads-5"),
        ("", "leads-after"),
    ]
}

// `leashwalk`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival
// mode, summons a cow and a sheep with their AI west and north of it, away from the end portal
// east of the spawn, and leashes both; it stands for 10 seconds, the two strolling about it in
