// `plates`' steps (D701), in the chunk of its spawn south of the end portal: the bot in creative
// mode sets an oak pressure plate with a redstone lamp beside it, a stone one in a pen of glass,
// a light and a heavy weighted one; onto the oak and the stone plates go sticks, then a cow into
// the pen, a marker armor stand, an apple and bread onto the light plate, and an armor stand and
// an arrow shot down onto the heavy one; then the bot, in survival mode, stands on the light
// plate, taking its items, then on the oak plate, taking its stick, and leaves it.
fn plate_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "plates-creative"),
        ("tp @s 9.5 -60 12.5", "plates-bot"),
        ("fill 1 -61 5 14 -61 9 minecraft:stone", "plates-ground"),
        ("setblock 3 -60 7 minecraft:oak_pressure_plate", "plates-oak"),
        ("setblock 4 -60 7 minecraft:redstone_lamp", "plates-lamp"),
        ("fill 6 -60 6 8 -59 8 minecraft:glass", "plates-pen"),
        ("setblock 7 -60 7 minecraft:stone_pressure_plate", "plates-stone"),
        ("setblock 7 -59 7 minecraft:air", "plates-pen-open"),
        ("setblock 11 -60 7 minecraft:light_weighted_pressure_plate", "plates-gold"),
        ("setblock 13 -60 7 minecraft:heavy_weighted_pressure_plate", "plates-iron"),
        ("summon item 3.5 -59 7.5 \{Item:\{id:\"minecraft:stick\",count:1\}\}", "plates-stick"),
        ("summon item 7.5 -59 7.5 \{Item:\{id:\"minecraft:stick\",count:1\}\}", "plates-stick-2"),
        ("", "plates-1"),
        ("summon cow 7.5 -59 7.5", "plates-cow"),
        ("summon armor_stand 11.5 -60 7.5 \{Marker:1b\}", "plates-marker"),
        ("summon item 11.5 -59 7.5 \{Item:\{id:\"minecraft:apple\",count:1\}\}", "plates-apple"),
        ("summon item 11.5 -59 7.5 \{Item:\{id:\"minecraft:bread\",count:1\}\}", "plates-bread"),
        ("summon armor_stand 13.5 -59 7.5", "plates-stand"),
        ("summon arrow 13.5 -57 7.5 \{Motion:[0.0,-0.5,0.0]\}", "plates-arrow"),
        ("", "plates-2"),
        ("gamemode survival", "plates-survival"),
        ("tp @s 11.5 -60 7.5", "plates-bot-gold"),
        ("", "plates-bot-gold-1"),
        ("tp @s 3.5 -60 7.5", "plates-bot-on"),
        ("", "plates-bot-1"),
        ("tp @s 3.5 -60 10.5", "plates-bot-off"),
        ("", "plates-bot-2"),
        ("", "plates-after"),
    ]
}

// `trips`' steps (D702), in the chunk of its spawn south of the end portal: the bot in creative
// mode sets three lines of tripwire between hooks on stone; onto the first falls a stick, onto
// the second an armor stand; then the bot, in survival mode, stands on the first, taking its
// stick, and leaves it, then stands on the third and leaves it.
fn trip_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "trips-creative"),
        ("tp @s 9.5 -60 15.5", "trips-bot"),
        ("fill 0 -61 5 14 -61 15 minecraft:stone", "trips-ground"),
        ("setblock 1 -60 7 minecraft:stone", "trips-post"),
        ("setblock 7 -60 7 minecraft:stone", "trips-post-2"),
        ("setblock 1 -60 10 minecraft:stone", "trips-post-3"),
        ("setblock 7 -60 10 minecraft:stone", "trips-post-4"),
        ("setblock 1 -60 13 minecraft:stone", "trips-post-5"),
        ("setblock 7 -60 13 minecraft:stone", "trips-post-6"),
        ("setblock 2 -60 7 minecraft:tripwire_hook[facing=east]", "trips-hook"),
        ("setblock 6 -60 7 minecraft:tripwire_hook[facing=west]", "trips-hook-2"),
        ("setblock 2 -60 10 minecraft:tripwire_hook[facing=east]", "trips-hook-3"),
        ("setblock 6 -60 10 minecraft:tripwire_hook[facing=west]", "trips-hook-4"),
        ("setblock 2 -60 13 minecraft:tripwire_hook[facing=east]", "trips-hook-5"),
        ("setblock 6 -60 13 minecraft:tripwire_hook[facing=west]", "trips-hook-6"),
        ("fill 3 -60 7 5 -60 7 minecraft:tripwire", "trips-wire"),
        ("fill 3 -60 10 5 -60 10 minecraft:tripwire", "trips-wire-2"),
        ("fill 3 -60 13 5 -60 13 minecraft:tripwire", "trips-wire-3"),
        ("summon item 4.5 -59 7.5 \{Item:\{id:\"minecraft:stick\",count:1\}\}", "trips-stick"),
        ("", "trips-1"),
        ("summon armor_stand 3.5 -59 10.5", "trips-stand"),
        ("", "trips-2"),
        ("gamemode survival", "trips-survival"),
        ("tp @s 4.5 -60 7.5", "trips-bot-on"),
        ("", "trips-bot-1"),
        ("tp @s 4.5 -60 4.5", "trips-bot-off"),
        ("", "trips-bot-2"),
        ("tp @s 4.5 -60 13.5", "trips-bot-across"),
        ("tp @s 4.5 -60 15.5", "trips-bot-beyond"),
        ("", "trips-bot-3"),
        ("", "trips-after"),
    ]
}

// `dripleaves`' steps (D703), in the chunk of its spawn south of the end portal: the bot in
// creative mode sets big dripleaves on clay, one open, one in a pen of glass, one beside a block
// of redstone and one for itself; onto the first falls a stick, into the pen a cow and onto the
// powered one an armor stand, the leaves tilting and coming back as they're left; then the bot,
// in survival mode, stands on its own leaf and leaves it.
fn leaf_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "leaves-creative"),
        ("tp @s 9.5 -60 15.5", "leaves-bot"),
        ("fill 0 -61 5 14 -61 15 minecraft:stone", "leaves-ground"),
        ("setblock 3 -61 7 minecraft:clay", "leaves-clay"),
        ("setblock 7 -61 7 minecraft:clay", "leaves-clay-2"),
        ("setblock 11 -61 7 minecraft:clay", "leaves-clay-3"),
        ("setblock 4 -61 13 minecraft:clay", "leaves-clay-4"),
        ("fill 6 -60 6 8 -58 8 minecraft:glass", "leaves-pen"),
        ("fill 7 -60 7 7 -58 7 minecraft:air", "leaves-pen-open"),
        ("setblock 3 -60 7 minecraft:big_dripleaf", "leaves-leaf"),
        ("setblock 7 -60 7 minecraft:big_dripleaf", "leaves-leaf-2"),
        ("setblock 11 -60 7 minecraft:big_dripleaf", "leaves-leaf-3"),
        ("setblock 12 -60 7 minecraft:redstone_block", "leaves-power"),
        ("setblock 4 -60 13 minecraft:big_dripleaf", "leaves-leaf-4"),
        ("summon item 3.5 -58.5 7.5 \{Item:\{id:\"minecraft:stick\",count:1\}\}", "leaves-stick"),
        ("summon cow 7.5 -58.9 7.5", "leaves-cow"),
        ("summon armor_stand 11.5 -58.9 7.5", "leaves-stand"),
        ("", "leaves-1"),
        ("", "leaves-2"),
        ("", "leaves-3"),
        ("", "leaves-4"),
        ("", "leaves-5"),
        ("", "leaves-6"),
        ("gamemode survival", "leaves-survival"),
        ("tp @s 4.5 -59.0625 13.5", "leaves-bot-on"),
        ("", "leaves-bot-1"),
        ("", "leaves-bot-2"),
        ("tp @s 4.5 -60 15.5", "leaves-bot-off"),
        ("", "leaves-bot-3"),
        ("", "leaves-after"),
    ]
}

// `rails`' steps (D704), in the chunk of its spawn south of the end portal: the bot in creative
// mode sets two detector rails on stone, each with a redstone lamp past where a comparator goes,
// then the comparators reading them, set powered though nothing powers them; onto the first falls
// a stick, its comparator told and so let go; then the bot, in survival mode, stands on the
// second and leaves it.
fn rail_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "rails-creative"),
        ("tp @s 9.5 -60 15.5", "rails-bot"),
        ("fill 0 -61 5 14 -61 15 minecraft:stone", "rails-ground"),
        ("setblock 3 -60 7 minecraft:detector_rail[shape=east_west]", "rails-rail"),
        ("setblock 3 -60 11 minecraft:detector_rail[shape=east_west]", "rails-rail-2"),
        ("setblock 5 -60 7 minecraft:redstone_lamp", "rails-lamp"),
        ("setblock 5 -60 11 minecraft:redstone_lamp", "rails-lamp-2"),
        ("setblock 4 -60 7 minecraft:comparator[facing=west,powered=true]", "rails-comparator"),
        ("setblock 4 -60 11 minecraft:comparator[facing=west,powered=true]", "rails-comparator-2"),
        ("summon item 3.5 -59.5 7.5 \{Item:\{id:\"minecraft:stick\",count:1\}\}", "rails-stick"),
        ("", "rails-1"),
        ("", "rails-2"),
        ("gamemode survival", "rails-survival"),
        ("tp @s 3.5 -60 11.5", "rails-bot-on"),
        ("", "rails-bot-1"),
        ("tp @s 3.5 -60 13.5", "rails-bot-off"),
        ("", "rails-bot-2"),
        ("", "rails-after"),
    ]
}

// `lid-riders`' steps (D705), in the chunk of its spawn south of the end portal: the bot in
// creative mode sets a shulker box facing up and one facing east; stands on the first and opens
// it, its lid pushing the bot up; then, in survival mode, stands by the second and opens it, its
// lid pushing the bot east.
fn rider_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "riders-creative"),
        ("fill 0 -61 5 14 -61 15 minecraft:stone", "riders-ground"),
        ("setblock 3 -60 7 minecraft:shulker_box[facing=up]", "riders-up"),
        ("setblock 6 -60 11 minecraft:shulker_box[facing=east]", "riders-east"),
        ("tp @s 3.5 -59 7.5", "riders-bot-on"),
        ("#use 3 -60 7", "riders-open-up"),
        ("", "riders-opened-up"),
        ("gamemode survival", "riders-survival"),
        ("tp @s 7.4 -60 11.5", "riders-bot-by"),
        ("#use 6 -60 11", "riders-open-east"),
        ("", "riders-opened-east"),
        ("", "riders-after"),
    ]
}

// `lid-ceiling`'s steps (D706), in the chunk of its spawn south of the end portal: the bot in
// creative mode sets a shulker box facing down just over where its head will be, stands under
// it and opens it, the lid coming down into where it stands, so it fits only crouching.
fn ceiling_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "ceiling-creative"),
        ("fill 0 -61 5 14 -61 15 minecraft:stone", "ceiling-ground"),
        ("setblock 3 -58 7 minecraft:shulker_box[facing=down]", "ceiling-box"),
        ("tp @s 3.5 -60 7.5", "ceiling-bot-under"),
        ("#use 3 -58 7", "ceiling-open"),
        ("", "ceiling-opened"),
        ("", "ceiling-after"),
    ]
}

// `snowfall`'s steps (D707), in the chunk of its spawn south of the end portal: the bot in
// creative mode sets powder snow a block deep in stone, then drops sticks onto it from six
// heights and cows from three, so that some, fallen more than 2.5 blocks, are in the top tenth
// of the snow at a tick's end before they land in it.
fn snowfall_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "snowfall-creative"),
        ("tp @s 7.5 -60 15.5", "snowfall-bot"),
        ("fill 0 -62 5 14 -61 13 minecraft:stone", "snowfall-ground"),
        ("fill 2 -61 7 12 -61 7 minecraft:powder_snow", "snowfall-snow"),
        ("fill 2 -61 11 12 -61 11 minecraft:powder_snow", "snowfall-snow-2"),
        ("summon item 2.5 -56.0 7.5 \{Item:\{id:\"minecraft:stick\",count:1\}\}", "snowfall-stick"),
        ("summon item 4.5 -55.3 7.5 \{Item:\{id:\"minecraft:stick\",count:1\}\}", "snowfall-stick-2"),
        ("summon item 6.5 -54.1 7.5 \{Item:\{id:\"minecraft:stick\",count:1\}\}", "snowfall-stick-3"),
        ("summon item 8.5 -52.7 7.5 \{Item:\{id:\"minecraft:stick\",count:1\}\}", "snowfall-stick-4"),
        ("summon item 10.5 -51.2 7.5 \{Item:\{id:\"minecraft:stick\",count:1\}\}", "snowfall-stick-5"),
        ("summon item 12.5 -49.6 7.5 \{Item:\{id:\"minecraft:stick\",count:1\}\}", "snowfall-stick-6"),
        ("summon cow 3.5 -55.5 11.5", "snowfall-cow"),
        ("summon cow 7.5 -53.2 11.5", "snowfall-cow-2"),
        ("summon cow 11.5 -50.4 11.5", "snowfall-cow-3"),
        ("", "snowfall-1"),
        ("", "snowfall-2"),
        ("", "snowfall-after"),
    ]
}

// `riding`'s steps (D708), in the chunk of its spawn south of the end portal: the bot in creative
// mode summons a chicken ridden by an armor stand and a pig ridden by a small slime, which
// doesn't steer it, both to wander; a spider without AI turned 30 degrees ridden by a skeleton,
// and a chicken turned 45 ridden by a baby zombie, neither with AI, for where each sits; and a
// stick about to despawn ridden by a small armor stand, which gets off as it goes.
fn riding_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "riding-creative"),
        ("tp @s 7.5 -60 15.5", "riding-bot"),
        ("summon chicken 3.5 -60 8.5 \{Passengers:[\{id:\"minecraft:armor_stand\"\}]\}", "riding-chicken"),
        ("summon pig 7.5 -60 8.5 \{Passengers:[\{id:\"minecraft:slime\",Size:0\}]\}", "riding-pig"),
        ("summon spider 11.5 -60 8.5 \{NoAI:1b,Rotation:[30.0f,0.0f],Passengers:[\{id:\"minecraft:skeleton\",NoAI:1b\}]\}", "riding-spider"),
        ("summon chicken 3.5 -60 4.5 \{NoAI:1b,Rotation:[45.0f,0.0f],Passengers:[\{id:\"minecraft:zombie\",IsBaby:1b,NoAI:1b\}]\}", "riding-jockey"),
        ("summon item 11.5 -58.0 4.5 \{Item:\{id:\"minecraft:stick\",count:1\},Age:5900,Passengers:[\{id:\"minecraft:armor_stand\",Small:1b\}]\}", "riding-stick"),
        ("", "riding-1"),
        ("", "riding-2"),
        ("", "riding-3"),
        ("", "riding-4"),
        ("", "riding-5"),
        ("", "riding-6"),
        ("", "riding-after"),
    ]
}

// `jockeys`' steps (D709), where `riding`'s are, its mobs dropping nothing: the bot in creative
// mode, standing where `riding`'s does, in the chunk it joined in, opens a trench to the void 32
// blocks along, sets a chicken without AI 3 blocks south of each of its blocks, then fifteen
// times a second apart summons a zombie over each, to fall out of the world; a baby among them 1
