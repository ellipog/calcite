// `bees`' steps (CAL-177), where `riding`'s are: the bot in creative mode summons bees without AI,
// one on the ground, one 4 blocks up, which falls and takes no damage, a baby, one with nectar,
// which drips it as its random says, knowing a hive and a flower, and one that's stung; an arrow
// flies into the first from the west; then it watches them for 10 seconds.
fn bee_steps() -> List<(str, str)> {
    return [
        ("gamemode creative", "bees-creative"),
        ("summon bee 2.5 -60 8.5 \{NoAI:1b\}", "bees-ground"),
        ("summon bee 4.5 -56 8.5 \{NoAI:1b\}", "bees-aloft"),
        ("summon bee 6.5 -60 8.5 \{NoAI:1b,Age:-24000\}", "bees-baby"),
        ("summon bee 8.5 -60 8.5 \{NoAI:1b,HasNectar:1b,CropsGrownSincePollination:3,TicksSincePollination:40,CannotEnterHiveTicks:100,hive_pos:[I;0,-60,0],flower_pos:[I;1,-60,12]\}", "bees-nectar"),
        ("summon bee 10.5 -60 8.5 \{NoAI:1b,HasStung:1b\}", "bees-stung"),
        ("", "bees-1"),
        ("summon arrow -0.5 -59.75 8.5 \{Motion:[1.5d,0.0d,0.0d]\}", "bees-arrow"),
        ("", "bees-2"), ("", "bees-3"), ("", "bees-4"), ("", "bees-5"), ("", "bees-6"),
        ("", "bees-7"), ("", "bees-8"), ("", "bees-9"), ("", "bees-10"),
        ("", "bees-after"),
    ]
}

// `beealert`'s steps (CAL-177), where `riding`'s are, by day, on normal: the bot, in survival
// mode, summons four bees in one tick, one just east of it, two near and one far off, then hits
// the first, which targets it, `BeeHurtByOtherGoal`, and, seeing it, alerts the bees near,
// `alertOther`, but not the far one, past its follow range; they sting it, poisoning it, as it
// watches for 20 seconds.
fn beealert_steps() -> List<(str, str)> {
    return [
        ("time set day", "beealert-day"),
        ("gamemode survival", "beealert-survival"),
        ("#all summon bee 1.5 -59.5 0.5;summon bee 4.5 -59 4.5;summon bee -3.5 -59 -2.5;summon bee 60.5 -59 0.5", "beealert-bees"),
        ("#hit-mob 0", "beealert-hit"),
        ("", "beealert-1"), ("", "beealert-2"), ("", "beealert-3"), ("", "beealert-4"), ("", "beealert-5"),
        ("", "beealert-6"), ("", "beealert-7"), ("", "beealert-8"), ("", "beealert-9"), ("", "beealert-10"),
        ("", "beealert-11"), ("", "beealert-12"), ("", "beealert-13"), ("", "beealert-14"), ("", "beealert-15"),
        ("", "beealert-16"), ("", "beealert-17"), ("", "beealert-18"), ("", "beealert-19"), ("", "beealert-20"),
        ("", "beealert-after"),
    ]
}

// `cod`'s steps (CAL-178), where `riding`'s are, by day, on normal: the bot, in survival mode, digs
// a pool of water 11 blocks across and 3 deep just south-east of it and summons three cod in it
// and one on the grass far north-west of it, all in one tick; it watches them for 30 seconds.
// Those in the pool swim about, `FishSwimGoal`, flee it, `AvoidEntityGoal`, and school,
// `FollowFlockLeaderGoal`; the one on the grass flops, running out of air, and drowns.
fn cod_steps() -> List<(str, str)> {
    return [
        ("time set day", "cod-day"),
        ("gamemode survival", "cod-survival"),
        ("fill 2 -63 2 12 -61 12 water", "cod-pool"),
        ("#all summon cod 5.5 -62 5.5;summon cod 7.5 -62 6.5;summon cod 9.5 -62 9.5;summon cod -9.5 -60 -9.5", "cod-fish"),
        ("", "cod-1"), ("", "cod-2"), ("", "cod-3"), ("", "cod-4"), ("", "cod-5"),
        ("", "cod-6"), ("", "cod-7"), ("", "cod-8"), ("", "cod-9"), ("", "cod-10"),
