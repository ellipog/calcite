// `spear-charge`'s steps (CAL-214), where `talk`'s are: by day, the bot, in survival mode,
// summons a husk without AI eight blocks south of it, holds an iron spear and readies it facing
// south, and once its delay's past runs south at 6 blocks a second, its spear meeting the husk,
// knocking it back and hurting it, then lets go. It watches for 2 seconds.
fn spear_charge_steps() -> List<(str, str)> {
    return [
        ("time set day", "spear-charge-day"),
        ("gamemode survival", "spear-charge-survival"),
        ("summon husk 0.5 -60 8.5 \{NoAI:1b,PersistenceRequired:1b\}", "spear-charge-husk"),
        ("item replace entity @s weapon.mainhand with iron_spear", "spear-charge-held"),
        ("#throw 0 0", "spear-charge-readied"),
        ("#charge 0.5 -60 0.5 0.3 18", "spear-charge-run"),
        ("#release", "spear-charge-let-go"),
        ("", "spear-charge-1"),
        ("", "spear-charge-after"),
    ]
}

// `spear-ride`'s steps (CAL-214), where `talk`'s are: by day, the bot, in survival mode, summons a
// husk without AI eight blocks south of it and an armor stand where it is, rides the stand by
// `ride`, holds an iron spear and readies it facing south and 35 degrees down, as it sits high,
// and once its delay's past the stand's pushed south at 2 blocks a tick, the spear meeting the
// husk with the stand's speed, as the bot doesn't steer it; then it lets go and gets off by
// command, and `ride` refuses to mount it on itself, a player, and to dismount the husk, which
// rides nothing.
fn spear_ride_steps() -> List<(str, str)> {
    return [
        ("time set day", "spear-ride-day"),
        ("gamemode survival", "spear-ride-survival"),
        ("summon husk 0.5 -60 8.5 \{NoAI:1b,PersistenceRequired:1b\}", "spear-ride-husk"),
        ("summon armor_stand 0.5 -60 0.5", "spear-ride-stand"),
        ("ride @s mount @e[type=armor_stand,limit=1]", "spear-ride-mounted"),
        ("item replace entity @s weapon.mainhand with iron_spear", "spear-ride-held"),
        ("#throw 0 35", "spear-ride-readied"),
        ("data merge entity @e[type=armor_stand,limit=1] \{Motion:[0.0d,0.0d,2.0d]\}", "spear-ride-pushed"),
        ("#release", "spear-ride-let-go"),
        ("ride @s dismount", "spear-ride-off"),
        ("ride @s mount @s", "spear-ride-player"),
        ("ride @e[type=husk,limit=1] dismount", "spear-ride-not-riding"),
        ("", "spear-ride-1"),
        ("", "spear-ride-after"),
    ]
}

// `spear-offhand`'s steps (CAL-214), as `spear-charge`'s, the iron spear in the bot's off hand
// with a diamond sword in its main, whose damage the charge doesn't take: the spear meets the
// husk, is worn in the off hand and counted used.
fn spear_offhand_steps() -> List<(str, str)> {
    return [
