// `steering`'s steps (D710), where `riding`'s are, at midnight, so no mob burns: the bot in
// creative mode, which no mob goes for, summons a chicken ridden by a baby zombie, a spider
// ridden by a skeleton and a zombie horse ridden by a zombie, each rider steering what it rides
// as it strolls and looks about, and a pig ridden by a slime, which doesn't steer it, then
// watches them for ten seconds.
fn steering_steps() -> List<(str, str)> {
    return [
        ("time set midnight", "steering-night"),
        ("gamemode creative", "steering-creative"),
        ("tp @s 7.5 -60 15.5", "steering-bot"),
        ("summon chicken 3.5 -60 6.5 \{Passengers:[\{id:\"minecraft:zombie\",IsBaby:1b\}]\}", "steering-chicken"),
        ("summon spider 11.5 -60 6.5 \{Passengers:[\{id:\"minecraft:skeleton\"\}]\}", "steering-spider"),
        ("summon zombie_horse 7.5 -60 3.5 \{Passengers:[\{id:\"minecraft:zombie\"\}]\}", "steering-horse"),
        ("summon pig 3.5 -60 11.5 \{Passengers:[\{id:\"minecraft:slime\",Size:0\}]\}", "steering-pig"),
        ("", "steering-1"),
        ("", "steering-2"),
        ("", "steering-3"),
        ("", "steering-4"),
        ("", "steering-5"),
        ("", "steering-6"),
        ("", "steering-7"),
        ("", "steering-8"),
        ("", "steering-9"),
        ("", "steering-10"),
        ("", "steering-after"),
    ]
}

// `freezing`'s steps (CAL-175), where `riding`'s are, at midnight: the bot in creative mode fills
// a patch of powder snow two blocks deep and summons a skeleton in it, which freezes for 140
// ticks, then shakes for 300 more and becomes a stray, with level event 1048; and a stray beside
// it on the grass, to stroll and look about as one; then watches them for 26 seconds.
