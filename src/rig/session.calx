// What the bot does in `talk` and `select`: each of `steps` 20 ticks after the last, from 140,
// a request for suggestions where it begins with `/`, nothing but its mark where it's empty, a use
// of the head of the bed or the straw bed of `select`'s steps where it's `#use-bed` or
// `#use-straw`, and the bed left where it's `#leave-bed` (D574), a use of the top of `eyes`'
// empty frame where it's `#use-frame` (D596), what it holds used looking at that frame or up
// where it's `#eye-frame` or `#eye-up`, and let go of where it's `#release` (D597), an ender
// pearl thrown where it begins with `#pearl-`, `pearl_aim` (D579), the last end crystal sent hit
// where it's `#hit-crystal` (D590), the last ender dragon where it's `#hit-dragon` (D608), its
// part of the place `k` where it's `#hit-part k` (CAL-167), the main hand used on the top of the
// block at x, y, z where it's `#use x y z` (CAL-182), what the main hand holds used facing a yaw
// and pitch where it's `#throw yaw pitch`, and a hop up from x, y, z and back where it's
// `#hop x y z h`, `hop_paths` (D666), else a command, then leaves.
fn talks(steps: List<(str, str)>) -> List<Dig> {
    var packets: List<Dug> = [Dug.Mark(100, "mate-joins")]
    var at: i64 = 140
    // The uses' sequence numbers (D574).
    var sequence = 100
    for (command, step) in steps {
        if String(command).starts_with("/") {
            packets.push(Dug.SuggestAt(command, at, step))
        } else if String(command).starts_with("#use ") {
            sequence += 1
            let (x, y, z) = use_place(command)
            packets.push(Dug.UseOnAt(x, y, z, sequence, at, step))
        } else if String(command).starts_with("#use-mob ") or String(command).starts_with("#sneak-use-mob ") {
            // A use of the main hand on the `k`th mob of any kind (CAL-179), sneaking or not.
            let parts = String(command).split_whitespace()
            let k = if parts.len() == 2 { usize.parse(parts[1].copy()) ?? 0 } else { 0 }
            packets.push(Dug.UseMob(k, String(command).starts_with("#sneak-"), at, step))
        } else if command == "#sneak" or command == "#unsneak" {
            // Shift held, or let go, `ServerboundPlayerInput` (CAL-179).
            packets.push(Dug.ShiftAt(command == "#sneak", at, step))
        } else if String(command).starts_with("#input ") {
            // The keys held, `ServerboundPlayerInput`'s flags (CAL-179).
            let parts = String(command).split_whitespace()
            if parts.len() == 2 {
                packets.push(Dug.InputAt(u8.parse(parts[1].copy()) ?? 0u8, at, step))
            }
        } else if String(command).starts_with("#ride ") {
            // What the bot steers moved from x, y, z by dz along z each client tick, n of them,
            // each on the ground (CAL-179).
            let parts = String(command).split_whitespace()
            if parts.len() == 6 {
                let x = f64.parse(parts[1].copy()) ?? 0.0
                let y = f64.parse(parts[2].copy()) ?? 0.0
                let z = f64.parse(parts[3].copy()) ?? 0.0
                let dz = f64.parse(parts[4].copy()) ?? 0.0
                let n = i32.parse(parts[5].copy()) ?? 0
                for k in 1..=n {
                    packets.push(Dug.RideAt(x, y, z + dz * f64(k), true, at, if k == 1 { step } else { "" }))
                }
            }
        } else if String(command).starts_with("#charge ") {
            // The bot moved from x, y, z by dz along z each client tick, n of them, each on the
            // ground, as it runs with a spear readied (CAL-214).
            let parts = String(command).split_whitespace()
            if parts.len() == 6 {
                let x = f64.parse(parts[1].copy()) ?? 0.0
                let y = f64.parse(parts[2].copy()) ?? 0.0
                let z = f64.parse(parts[3].copy()) ?? 0.0
                let dz = f64.parse(parts[4].copy()) ?? 0.0
                let n = i32.parse(parts[5].copy()) ?? 0
                var path = List<(f64, f64, f64)>()
                for k in 1..=n {
                    path.push((x, y, z + dz * f64(k)))
                }
                packets.push(Dug.RunAt(path, at, step))
            }
        } else if String(command).starts_with("#move ") {
            // A move to x, y, z on the ground in one client tick (CAL-179).
            let parts = String(command).split_whitespace()
            if parts.len() == 4 {
                let x = f64.parse(parts[1].copy()) ?? 0.0
                let y = f64.parse(parts[2].copy()) ?? 0.0
                let z = f64.parse(parts[3].copy()) ?? 0.0
                packets.push(Dug.MoveAt(x, y, z, true, at, step))
            }
        } else if String(command).starts_with("#hit-mob ") {
            // A hit on the `k`th mob `HitZombie` counts (CAL-177).
            let parts = String(command).split_whitespace()
            let k = if parts.len() == 2 { usize.parse(parts[1].copy()) ?? 0 } else { 0 }
            packets.push(Dug.HitZombie(k, at, step))
        } else if String(command).starts_with("#hit-any ") {
            // A hit on the `k`th mob of any kind (CAL-179).
            let parts = String(command).split_whitespace()
            let k = if parts.len() == 2 { usize.parse(parts[1].copy()) ?? 0 } else { 0 }
            packets.push(Dug.HitAnyAt(k, at, step))
        } else if String(command).starts_with("#hit-move ") {
            // A hit on the `k`th mob `HitZombie` counts, then a move to x, y, z on the ground, in
            // the same client tick, before its goals see the hit (CAL-179).
            let parts = String(command).split_whitespace()
            if parts.len() == 5 {
                let k = usize.parse(parts[1].copy()) ?? 0
                let x = f64.parse(parts[2].copy()) ?? 0.0
                let y = f64.parse(parts[3].copy()) ?? 0.0
                let z = f64.parse(parts[4].copy()) ?? 0.0
                packets.push(Dug.HitZombie(k, at, step))
                packets.push(Dug.MoveAt(x, y, z, true, at, ""))
            }
        } else if String(command).starts_with("#dig ") {
            // `START_DESTROY_BLOCK` on the block at x, y, z (CAL-177).
            sequence += 1
            let (x, y, z) = use_place(command)
            packets.push(Dug.DigAt(x, y, z, sequence, at, step))
        } else if String(command).starts_with("#throw-off ") {
            // `#throw`'s with the off hand (CAL-214).
            sequence += 1
            let (y_rot, x_rot) = throw_aim(command)
            packets.push(Dug.UseItemTurnedAt(1, sequence, y_rot, x_rot, at, step))
        } else if String(command).starts_with("#throw ") {
            sequence += 1
            let (y_rot, x_rot) = throw_aim(command)
            packets.push(Dug.UseItemTurnedAt(0, sequence, y_rot, x_rot, at, step))
        } else if String(command).starts_with("#hop ") {
            let (up, down) = hop_paths(command)
            moves_at(up, at, step, mut packets)
            moves_at(down, at + 20, "", mut packets)
        } else if String(command) == "#use-bed" or String(command) == "#use-straw" {
            sequence += 1
            let z = if String(command) == "#use-bed" { 20 } else { 22 }
            packets.push(Dug.UseOnAt(21, -60, z, sequence, at, step))
        } else if String(command) == "#use-frame" {
            sequence += 1
            packets.push(Dug.UseOnAt(-1, -60, 1, sequence, at, step))
        } else if String(command) == "#eye-frame" or String(command) == "#eye-up" {
            sequence += 1
            let (y_rot, x_rot) = if String(command) == "#eye-frame" { (45.0f32, 38.0f32) } else { (0.0f32, -90.0f32) }
            packets.push(Dug.UseItemTurnedAt(0, sequence, y_rot, x_rot, at, step))
        } else if String(command) == "#release" {
            packets.push(Dug.ReleaseAt(at, step))
        } else if String(command).starts_with("#turn ") {
            // A turn to a yaw and pitch, which a player's head follows (CAL-214).
            let (y_rot, x_rot) = throw_aim(command)
            packets.push(Dug.TurnAt(y_rot, x_rot, at, step))
        } else if String(command) == "#stab" {
            // A jab with what the main hand holds, `STAB` (CAL-214).
            packets.push(Dug.StabAt(at, step))
        } else if String(command) == "#leave-bed" {
            packets.push(Dug.LeaveBedAt(at, step))
        } else if String(command).starts_with("#click ") {
            // A click on the open menu's slot, with a button and an input, `ClickType`'s ordinal,
            // saying no slot changed and nothing carried, so the server sends what did (CAL-179).
            let parts = String(command).split_whitespace()
            if parts.len() == 4 {
                let slot = i16.parse(parts[1].copy()) ?? 0i16
                let button = i8.parse(parts[2].copy()) ?? 0i8
                let input = i32.parse(parts[3].copy()) ?? 0
                packets.push(Dug.ClickAt(press(slot, button, input, [], nothing()), at, step))
            }
        } else if String(command).starts_with("#button ") {
            // A button clicked in the open menu, by its ID, as a stonecutter's recipe's picked
            // (CAL-338).
            let parts = String(command).split_whitespace()
            if parts.len() == 2 {
                packets.push(Dug.ButtonAt(i32.parse(parts[1].copy()) ?? 0, at, step))
            }
        } else if String(command).starts_with("#recipe ") or String(command).starts_with("#recipe-inventory ") {
            // A recipe placed from the recipe book, by its display's number and `max` or `one`, in
            // the open menu, or with `#recipe-inventory` the inventory's (CAL-339).
            let parts = String(command).split_whitespace()
            if parts.len() == 3 {
                packets.push(Dug.RecipeAt(i32.parse(parts[1].copy()) ?? 0, parts[2] == "max", parts[0] == "#recipe-inventory", at, step))
            }
        } else if String(command).starts_with("#slot-state ") {
            // A crafter's slot turned on or off, by its place and `on` or `off` (CAL-338).
            let parts = String(command).split_whitespace()
            if parts.len() == 3 {
                packets.push(Dug.SlotStateAt(i32.parse(parts[1].copy()) ?? 0, parts[2] == "on", at, step))
            }
        } else if String(command) == "#rename" or String(command).starts_with("#rename ") {
            // A name typed in an anvil's menu, all after the word, nothing where there's nothing
            // (CAL-338).
            let typed = if String(command).len() > 8 { String(command)[8..].copy() } else { String() }
            packets.push(Dug.RenameAt(typed, at, step))
        } else if String(command) == "#close" {
            packets.push(Dug.CloseAt(at, step))
        } else if String(command) == "#open-inventory" {
            // What the bot rides's inventory opened, `OPEN_INVENTORY` (CAL-179).
            packets.push(Dug.PlayerCommandAt(5, 0, at, step))
        } else if String(command).starts_with("#ride-jump ") {
            // What the bot steers jumped with a strength, `START_RIDING_JUMP` (CAL-179).
            let parts = String(command).split_whitespace()
            let strength = if parts.len() == 2 { i32.parse(parts[1].copy()) ?? 0 } else { 0 }
            packets.push(Dug.PlayerCommandAt(3, strength, at, step))
        } else if String(command).starts_with("#jump-leap ") {
            // What the bot steers jumped with a strength, `START_RIDING_JUMP`, and in the same
            // tick its leap begun, `leap_moves` (CAL-179).
            let parts = String(command).split_whitespace()
            if parts.len() == 7 {
                packets.push(Dug.PlayerCommandAt(3, i32.parse(parts[1].copy()) ?? 0, at, step))
                leap_moves(parts[2..7], at, mut packets)
            }
        } else if String(command).starts_with("#leap ") {
            let parts = String(command).split_whitespace()
            if parts.len() == 6 {
                packets.push(Dug.Mark(at, step))
                leap_moves(parts[1..6], at, mut packets)
            }
        } else if String(command) == "#hit-crystal" {
            packets.push(Dug.HitCrystalAt(at, step))
        } else if String(command) == "#hit-dragon" {
            packets.push(Dug.HitDragonAt(at, step))
        } else if String(command).starts_with("#hit-part ") {
            let k = i32.parse(String(command).split_whitespace()[1].copy()) ?? 0
            packets.push(Dug.HitPartAt(k, at, step))
        } else if String(command).starts_with("#pearl-") {
            let (y_rot, x_rot) = pearl_aim(command)
            sequence += 1
            packets.push(Dug.UseItemTurnedAt(0, sequence, y_rot, x_rot, at, step))
            if String(command) == "#pearl-down" {
                sequence += 1
                packets.push(Dug.UseItemTurnedAt(0, sequence, y_rot, x_rot, at, "pearl-cooling"))
            }
        } else if String(command).starts_with("#all ") {
            // Commands sent in one tick, split at `;`, the first marked as the step (D709).
            packets.push(Dug.CommandsAt(command, at, step))
        } else if String(command).starts_with("#wait ") {
            // A mark, then `n` seconds' wait in all, not one, under the step's 20, `STEP_LIMIT`
            // (CAL-200).
            let parts = String(command).split_whitespace()
            let n = if parts.len() == 2 { i32.parse(parts[1].copy()) ?? 1 } else { 1 }
            packets.push(Dug.Mark(at, step))
            at += 20 * i64(n - 1)
        } else if String(command).is_empty() {
            packets.push(Dug.Mark(at, step))
        } else {
            packets.push(Dug.CommandAt(command, at, step))
        }
        at += 20
    }
    packets.push(Dug.Mark(at, "after"))
    packets.push(Dug.Leave(at + 40))
    return [Dig { name: String(), packets: packets }]
}

// The moves of a leap of what the bot steers, a `#leap x y z dz v` step of `talks` (CAL-179):
// from x, y, z, by dz along z each client tick, up at v at first and falling as a horse does,
// `travel`'s gravity and drag, off the ground till it's down at y again, on the ground there.
fn leap_moves(parts: List<String>, at: i64, packets: mut List<Dug>) {
    let x = f64.parse(parts[0].copy()) ?? 0.0
    let base = f64.parse(parts[1].copy()) ?? 0.0
    var z = f64.parse(parts[2].copy()) ?? 0.0
    let dz = f64.parse(parts[3].copy()) ?? 0.0
    var v = f64.parse(parts[4].copy()) ?? 0.0
    var y = base
    for _ in 0..60 {
        y += v
        v = (v - 0.08) * 0.98
        z += dz
        let down = y <= base
        packets.push(Dug.RideAt(x, if down { base } else { y }, z, down, at, ""))
        if down {
            return
        }
    }
}

// The block a `#use x y z` step of `talks` uses the main hand on (CAL-182), or a `#dig x y z`
// step digs (CAL-177), 0, 0, 0 where it doesn't say.
fn use_place(command: str) -> (i32, i32, i32) {
    let parts = String(command).split_whitespace()
    if parts.len() != 4 {
        return (0, 0, 0)
    }
    let x = i32.parse(parts[1].copy()) ?? 0
    let y = i32.parse(parts[2].copy()) ?? 0
    let z = i32.parse(parts[3].copy()) ?? 0
    return (x, y, z)
}

// The moves of a `#hop x y z h` step of `talks` (D666), each in a client's tick of its own: from
// x, y, z up 2 blocks a tick to `h` above and an eighth down, a fall begun; then, sent 20 ticks
// on, down again as `falling` falls, onto the ground where it began. Its moves come in one of the
// server's ticks, as the steps are sent by its clock, which a fall begun and landed in one never
// starts, `trackStartFallingPosition`. None where it doesn't say.
fn hop_paths(command: str) -> (List<(f64, f64, f64, bool)>, List<(f64, f64, f64, bool)>) {
    var up = List<(f64, f64, f64, bool)>()
    var down = List<(f64, f64, f64, bool)>()
    let parts = String(command).split_whitespace()
    if parts.len() != 5 {
        return (up, down)
    }
    let x = f64.parse(parts[1].copy()) ?? 0.0
    let y = f64.parse(parts[2].copy()) ?? 0.0
    let z = f64.parse(parts[3].copy()) ?? 0.0
    let h = f64.parse(parts[4].copy()) ?? 0.0
    var at = y
    while at + 2.0 <= y + h {
        at = at + 2.0
        up.push((x, at, z, false))
    }
    at = at - 0.125
    up.push((x, at, z, false))
    falling(x, z, at, y, true, mut down)
    return (up, down)
}

// The yaw and pitch a `#throw yaw pitch` step of `talks` uses the main hand facing (CAL-182),
// none where it doesn't say.
fn throw_aim(command: str) -> (f32, f32) {
    let parts = String(command).split_whitespace()
    if parts.len() != 3 {
        return (0.0f32, 0.0f32)
    }
    let y_rot = f32.parse(parts[1].copy()) ?? 0.0f32
    let x_rot = f32.parse(parts[2].copy()) ?? 0.0f32
    return (y_rot, x_rot)
}

// Where `select`'s bot throws an ender pearl of the step `command` (D579), its yaw and pitch:
// straight down, as `#pearl-drop` too (D583), straight up (D580), up and far to the north-west,
// a little down to the south, at a pig (D581), and a little up to the north or south.
fn pearl_aim(command: str) -> (f32, f32) {
    if String(command) == "#pearl-down" or String(command) == "#pearl-drop" {
        return (0.0f32, 90.0f32)
    } else if String(command) == "#pearl-pig" {
        return (0.0f32, 20.0f32)
    } else if String(command) == "#pearl-up" {
        return (0.0f32, -90.0f32)
    } else if String(command) == "#pearl-far" {
        return (135.0f32, -20.0f32)
    } else if String(command) == "#pearl-north" {
        return (180.0f32, -5.0f32)
    }
    return (0.0f32, -5.0f32)
}

// What Mate does in `talk` and `select`: it stands where it joined, marking the bot's `steps`,
// and leaves `stay` ticks after the last, in `select` once the bot's left, so it sees the bot's
// ender pearl taken out of the level with it (D581).
fn talk_marks(steps: List<(str, str)>, stay: i64) -> List<Dig> {
    var packets = List<Dug>()
    var at: i64 = 140
    for (_, step) in steps {
        packets.push(Dug.Mark(at, step))
        at += 20
    }
    packets.push(Dug.Mark(at, "after"))
    packets.push(Dug.Leave(at + stay))
    return [Dig { name: String(), packets: packets }]
}

// What `checks` does on the `checks` fixture's world (D420), at the spawn, by the server's clock:
// at game time 200 a move 12 blocks south in one tick, too quick, which the server sends it back
// from; at 240 one through the wall, which stops it more than a quarter of a block short, wrong;
// at 280 two steps toward the wall and one a little into it, which its box didn't meet before;
// at 320 nine blocks up, by the ladder at the wall's north end, and two north; at 360 down past
// it in moves of a block and a half, a clip of what resets a fall, which forgets the fall
// before it, so the landing doesn't hurt (D422); at 400 five blocks up in half blocks, off the
// ground, where it floats, sending nothing more, till the server kicks it for floating; it'd
// leave at 600.
fn checks() -> List<Dig> {
    let quick: List<(f64, f64, f64, bool)> = [(0.5, -60.0, 12.5, true)]
    let through: List<(f64, f64, f64, bool)> = [(2.8, -60.0, 0.5, true)]
    let into: List<(f64, f64, f64, bool)> = [(1.0, -60.0, 0.5, true), (1.5, -60.0, 0.5, true), (1.9, -60.0, 0.5, true)]
    var climb: List<(f64, f64, f64, bool)> = [(1.5, -59.0, -0.5, false), (1.5, -58.0, -1.5, false)]
    for i in 1..8 {
        climb.push((1.5, -58.0 + f64(i), -1.5, false))
    }
    var fast = List<(f64, f64, f64, bool)>()
    for i in 1..7 {
        fast.push((1.5, -51.0 - f64(i) * 1.5, -1.5, i == 6))
    }
    var up = List<(f64, f64, f64, bool)>()
    for i in 1..11 {
        up.push((1.5, -60.0 + f64(i) * 0.5, 0.5, false))
    }
    var packets = List<Dug>()
    moves_at(quick, 200, "too-quick", mut packets)
    moves_at(through, 240, "through", mut packets)
    moves_at(into, 280, "into", mut packets)
    moves_at(climb, 320, "climb", mut packets)
    moves_at(fast, 360, "past-ladder", mut packets)
    moves_at(up, 400, "float", mut packets)
    packets.push(Dug.Leave(600))
    return [Dig { name: String(), packets: packets }]
}

// The moves of `path` onto `out`, each in a client's tick of its own, at the game time `at`, the
// first in a step named `step` (D418).
fn moves_at(path: List<(f64, f64, f64, bool)>, at: i64, step: str, out: mut List<Dug>) {
    var first = true
    for (x, y, z, ground) in path {
        out.push(Dug.MoveAt(x, y, z, ground, at, if first { step } else { "" }))
        first = false
    }
}

// The ways down of a fall from `y` at x, z, each a move as a client's tick makes it, faster
// each tick to 0.875, the last to `to`, onto the ground where it `lands` (D418). Each is a
// float's eighths, so the fall adds up exactly.
fn falling(x: f64, z: f64, y: f64, to: f64, lands: bool, path: mut List<(f64, f64, f64, bool)>) {
    let steps: List<f64> = [0.125, 0.25, 0.375, 0.5, 0.625, 0.75]
    var at = y
    for s in steps {
        if at - s <= to {
            break
        }
        at = at - s
        path.push((x, at, z, false))
    }
    while at - 0.875 > to {
        at = at - 0.875
        path.push((x, at, z, false))
    }
    path.push((x, to, z, lands))
}

// What `fall` does on the `fall` fixture's world (D418), on its pillar 30 up, facing east with an
// iron sword, by the server's clock, each fall under 10 blocks, as vanilla lets a tick's moves
// go: from game time 200 it walks off east and falls nine onto the honey, which takes four
// fifths of the hurt; at 240 off the honey into the basin's water, which forgets the fall; at 280
// it climbs out onto the basin's wall, jumping as it leaves the ground; at 320 it walks off the
// wall and falls nine to the platform, hitting the cow halfway down, a critical hit; then a step
// from 360 as its health comes back, and it leaves at 480.
fn falls() -> List<Dig> {
    var honey = List<(f64, f64, f64, bool)>()
    honey.push((0.9, -30.0, 0.5, true))
    honey.push((1.4, -30.0, 0.5, false))
    honey.push((1.8, -30.125, 0.5, false))
    honey.push((2.2, -30.375, 0.5, false))
    honey.push((2.5, -30.75, 0.5, false))
    falling(2.5, 0.5, -30.75, -39.0625, true, mut honey)
    var water = List<(f64, f64, f64, bool)>()
    water.push((2.9, -39.0625, 0.5, true))
    water.push((3.4, -39.0625, 0.5, false))
    water.push((3.8, -39.1875, 0.5, false))
    water.push((4.2, -39.4375, 0.5, false))
    water.push((4.6, -39.8125, 0.5, false))
    water.push((5.0, -40.3125, 0.5, false))
    water.push((5.5, -40.9375, 0.5, false))
    falling(5.5, 0.5, -40.9375, -48.0, true, mut water)
    let climb: List<(f64, f64, f64, bool)> = [(6.2, -48.0, 0.5, true), (6.2, -47.5, 0.5, false), (6.6, -47.0, 0.5, false), (7.3, -47.0, 0.5, true)]
    var down = List<(f64, f64, f64, bool)>()
    down.push((7.7, -47.0, 0.5, true))
    down.push((8.4, -47.0, 0.5, false))
    falling(8.4, 0.5, -47.0, -51.5, false, mut down)
    var rest = List<(f64, f64, f64, bool)>()
    falling(8.4, 0.5, -51.5, -56.0, true, mut rest)
    var packets = List<Dug>()
    moves_at(honey, 200, "honey", mut packets)
    moves_at(water, 240, "water", mut packets)
    moves_at(climb, 280, "climb", mut packets)
    moves_at(down, 320, "crit-fall", mut packets)
    packets.push(Dug.Hit(false, 0, 320, ""))
    moves_at(rest, 320, "", mut packets)
    packets.push(Dug.Mark(360, "after"))
    packets.push(Dug.Leave(480))
    return [Dig { name: String(), packets: packets }]
}

// What `smashes` does on the `mace` fixture's world (CAL-185): `mace`'s, with Mate, joined at 100,
// standing north-west of the zombie within 3.5 of him, so the heavy smash on him at 200 pushes
// Mate as well, `MaceItem.knockback`, and the light one on the cow at 260 doesn't, as it's too
// far; then at 330, from the ground, a hit on Mate, who's within reach, its breach IV against
// Mate's iron chestplate; and it leaves at 440, after Mate has.
fn smashes() -> List<Dig> {
    var heavy = List<(f64, f64, f64, bool)>()
    heavy.push((0.9, -48.0, 2.5, true))
    heavy.push((1.4, -48.0, 2.5, false))
    falling(1.5, 2.5, -48.0, -55.0, false, mut heavy)
    var landing = List<(f64, f64, f64, bool)>()
    falling(1.5, 2.5, -55.0, -57.0, true, mut landing)
    var light = List<(f64, f64, f64, bool)>()
    light.push((1.5, -57.0, 2.9, true))
    light.push((1.5, -57.0, 3.4, false))
    falling(1.5, 3.5, -57.0, -59.625, false, mut light)
    var ground = List<(f64, f64, f64, bool)>()
    falling(1.5, 3.5, -59.625, -60.0, true, mut ground)
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "mate-joins"))
    moves_at(heavy, 200, "heavy-smash", mut packets)
    packets.push(Dug.HitZombie(0, 200, ""))
    moves_at(landing, 200, "", mut packets)
    moves_at(light, 260, "light-smash", mut packets)
    packets.push(Dug.Hit(false, 0, 260, ""))
    moves_at(ground, 260, "", mut packets)
    packets.push(Dug.HitZombie(0, 320, "ground-hit"))
    packets.push(Dug.HitPlayer(0, 330, "breach-mate"))
    packets.push(Dug.Mark(340, "after"))
    packets.push(Dug.Leave(440))
    return [Dig { name: String(), packets: packets }]
}

// What Mate does in `smashes` (CAL-185): it stands where it joined, marking the bot's steps at
// their game times, and leaves at 420.
fn smash_marks() -> List<Dig> {
    return [
        Dig { name: String(), packets: [
            Dug.Mark(200, "heavy-smash"),
            Dug.Mark(260, "light-smash"),
            Dug.Mark(320, "ground-hit"),
            Dug.Mark(330, "breach-mate"),
            Dug.Mark(340, "after"),
            Dug.Leave(420),
        ] },
    ]
}

// What `glide` does on the glide fixture's world (CAL-286), on the pillar facing east and 20
// degrees down in an elytra, Mate by its way, by the server's clock: at 100 Mate joins; at 200 it
// walks off east and falls a block, then asks to glide, `START_FALL_FLYING`, as all of that comes in
// one tick; then it sends nothing more, so the server's travel glides it, `travelFallFlying`, as
// its tracker sends Mate its motion each tick (CAL-187), its elytra worn each 20 ticks of it, till
// it lands or flies into the wall; a step from 300, and it leaves at 440, after Mate has.
fn glides() -> List<Dig> {
    var off = List<(f64, f64, f64, bool)>()
    off.push((0.9, -40.0, 0.5, true))
    off.push((1.4, -40.0, 0.5, false))
    falling(2.0, 0.5, -40.0, -41.0, false, mut off)
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "mate-joins"))
    packets.push(Dug.TurnAt(-90.0f32, 20.0f32, 200, "glide"))
    moves_at(off, 200, "", mut packets)
    packets.push(Dug.GlideAt(200, ""))
    packets.push(Dug.GlideAt(260, "stop"))
    packets.push(Dug.Mark(300, "after"))
    packets.push(Dug.Leave(440))
    return [Dig { name: String(), packets: packets }]
}

// What `glide-boost` does on the glide fixture's world (CAL-214), as `glide` does without Mate,
// firework rockets in its hand: at 200 it walks off the pillar and asks to glide; at 205 it uses a
// rocket, `FireworkRocketItem.use`, stuck to it, which boosts it each tick it glides till it
// bursts, and at 225 another; a step from 300, and it leaves at 440.
fn glide_boosts() -> List<Dig> {
    var off = List<(f64, f64, f64, bool)>()
    off.push((0.9, -40.0, 0.5, true))
    off.push((1.4, -40.0, 0.5, false))
    falling(2.0, 0.5, -40.0, -41.0, false, mut off)
    var packets = List<Dug>()
    packets.push(Dug.TurnAt(-90.0f32, 20.0f32, 200, "glide"))
    moves_at(off, 200, "", mut packets)
    packets.push(Dug.GlideAt(200, ""))
    packets.push(Dug.UseItemAt(0, 1, 205, "boost"))
    packets.push(Dug.UseItemAt(0, 2, 225, "boost-again"))
    packets.push(Dug.Mark(300, "after"))
    packets.push(Dug.Leave(440))
    return [Dig { name: String(), packets: packets }]
}

// What `rod-casts` does on the pond fixture's world (CAL-214): with a fishing rod of lure III,
// each use facing south and level, as `UseItemAt` sends it and turns the bot, it casts at 200, `FishingRodItem.use`, reels the hook in
// from the water at 230 with nothing on it, casts again at 240 and reels in at 572, as a fish
// bites, marking the server's clock at 640 and leaving at 700.
fn rod_casts() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.UseItemAt(0, 1, 200, "cast"))
    packets.push(Dug.UseItemAt(0, 2, 230, "reel-early"))
    packets.push(Dug.UseItemAt(0, 3, 240, "cast-again"))
    packets.push(Dug.UseItemAt(0, 4, 572, "reel"))
    packets.push(Dug.Mark(640, "settled"))
    packets.push(Dug.Leave(700))
    return [Dig { name: String(), packets: packets }]
}

// What `hook-border` does on the arrow-border fixture's world (CAL-214): at 100 it casts north,
