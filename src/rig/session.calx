    var packets = List<Dug>()
    packets.push(Dug.TurnAt(-90.0f32, 46.0f32, 110, "stare"))
    packets.push(Dug.Mark(250, "angry"))
    packets.push(Dug.Leave(400))
    return [Dig { name: String(), packets: packets }]
}

// What `ender` does on the `ender-ground` and `enderman` fixtures' worlds (CAL-159), at the spawn
