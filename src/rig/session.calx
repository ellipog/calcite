}

// `dolphin`'s steps (CAL-201), where `pufferfish`'s are: the bot, in survival mode, with resistance
// III and cod in hand, fills the end portal with stone, CAL-307, digs `cod`'s pool and a small one
// just east of it, which meet, and summons a dolphin and a baby one in the second, beside it, and
// another dolphin in the first. At once it feeds the dolphin beside it a cod, which, given a fish,
// looks for treasure, `DolphinSwimToTreasureGoal`, and with no structures stops, and the baby,
// which grows, then hits the dolphin, which goes for it, `HurtByTargetGoal`, alerting the others.
// Then a dolphin on land, nearly dry, `Moistness`, which hops till it dries out, `dry_out`, and a
// cod in the first pool, which the dolphins go for, `MoveToItemGoal`. The dolphins swim about,
// `RandomSwimmingGoal`, by `SmoothSwimmingMoveControl`, and jump out of the water,
// `DolphinJumpGoal`. It watches for 30 seconds.
fn dolphin_steps() -> List<(str, str)> {
    return [
        ("fill 3 -61 -1 5 -61 1 minecraft:stone", "dolphin-portal"),
        ("time set day", "dolphin-day"),
        ("gamemode survival", "dolphin-survival"),
        ("effect give @s resistance 600 2 true", "dolphin-armor"),
        ("fill 2 -63 2 12 -61 12 water", "dolphin-pool"),
        ("fill 1 -62 -1 3 -61 1 water", "dolphin-small-pool"),
        ("item replace entity @s weapon.mainhand with cod 4", "dolphin-cod"),
        ("#all summon dolphin 2.0 -62 -0.5;summon dolphin 2.0 -62 0.5 \{Age:-24000\};summon dolphin 7.5 -62 7.5", "dolphin-near"),
        ("#use-mob 0", "dolphin-fed"),
        ("#use-mob 1", "dolphin-fed-baby"),
        ("#hit-mob 0", "dolphin-hit"),
        ("summon dolphin -9.5 -60 -9.5 \{Moistness:40\}", "dolphin-land"),
        ("summon item 9.5 -62 9.5 \{Item:\{id:\"minecraft:cod\",count:1\}\}", "dolphin-item"),
        ("", "dolphin-wait"),
        ("", "dolphin-1"), ("", "dolphin-2"), ("", "dolphin-3"), ("", "dolphin-4"), ("", "dolphin-5"),
        ("", "dolphin-6"), ("", "dolphin-7"), ("", "dolphin-8"), ("", "dolphin-9"), ("", "dolphin-10"),
        ("", "dolphin-11"), ("", "dolphin-12"), ("", "dolphin-13"), ("", "dolphin-14"), ("", "dolphin-15"),
        ("", "dolphin-16"), ("", "dolphin-17"), ("", "dolphin-18"), ("", "dolphin-19"), ("", "dolphin-20"),
        ("", "dolphin-21"), ("", "dolphin-22"), ("", "dolphin-23"), ("", "dolphin-24"), ("", "dolphin-25"),
        ("", "dolphin-26"), ("", "dolphin-27"), ("", "dolphin-28"), ("", "dolphin-29"), ("", "dolphin-30"),
        ("", "dolphin-after"),
    ]
}

// `golem-build`'s steps (CAL-201), where `snow-golems`' are: by day, the bot, in creative mode,
// stacks two snow blocks north-west of it and sets a carved pumpkin on them by command, which
// builds a snow golem, `CarvedPumpkinBlock.trySpawnGolem`, its blocks heard broken; then builds an
// iron golem's T of iron blocks south-west of it and puts a carved pumpkin on it by hand, which
// builds an iron golem made by a player, `setPlayerCreated`, the bot told it summoned it,
// `SUMMONED_ENTITY`. Then a jack o'lantern on one snow block, which builds nothing, and one on
// two, which builds a snow golem. It watches for 10 seconds.
fn golem_build_steps() -> List<(str, str)> {
    return [
        ("time set day", "golem-build-day"),
        ("gamemode creative", "golem-build-creative"),
        ("fill -3 -60 -3 -3 -59 -3 snow_block", "golem-build-snow"),
        ("setblock -3 -58 -3 carved_pumpkin", "golem-build-snow-golem"),
        ("#all fill -2 -60 3 -2 -59 3 iron_block;fill -3 -59 3 -1 -59 3 iron_block", "golem-build-iron"),
        ("item replace entity @s weapon.mainhand with carved_pumpkin", "golem-build-pumpkin"),
        ("#use -2 -59 3", "golem-build-iron-golem"),
        ("#all setblock 1 -60 -3 snow_block;fill 2 -60 -3 2 -59 -3 snow_block", "golem-build-snow-again"),
        ("item replace entity @s weapon.mainhand with jack_o_lantern", "golem-build-lantern"),
        ("#use 1 -60 -3", "golem-build-lantern-short"),
        ("#use 2 -59 -3", "golem-build-lantern-golem"),
        ("", "golem-build-1"), ("", "golem-build-2"), ("", "golem-build-3"), ("", "golem-build-4"), ("", "golem-build-5"),
        ("", "golem-build-6"), ("", "golem-build-7"), ("", "golem-build-8"), ("", "golem-build-9"), ("", "golem-build-10"),
        ("", "golem-build-after"),
    ]
}

// `selectors`' steps (CAL-165), where `golem-build`'s are: by day, the bot summons two zombies
// without AI, one tagged and one named, two armor stands, one tagged, and two items, then picks
// them with selectors of entities that aren't players, `EntitySelector.findEntities`: counts
// them, `execute if entity`, names them, `say`, the nearest, `@n`, and in order of distance;
// summons a pig at a stand, `execute at`, sets gold under the furthest, `execute positioned as`,
// kills the pig as itself, `execute as`, then the items, the named zombie, the tagged one and
// each stand as itself, and at last finds nothing left to kill. It watches for 3 seconds.
fn selectors_steps() -> List<(str, str)> {
    return [
        ("time set day", "selectors-day"),
        ("#all summon zombie 3.5 -60 -3.5 \{NoAI:1b,Tags:[\"a\"]\};summon zombie 5.5 -60 -3.5 \{NoAI:1b,CustomName:\"Bob\"\};summon armor_stand -3.5 -60 3.5 \{Tags:[\"b\"]\};summon armor_stand -5.5 -60 3.5;summon item 1.5 -60 4.5 \{Item:\{id:\"minecraft:stone\",count:1\}\};summon item 2.5 -60 4.5 \{Item:\{id:\"minecraft:dirt\",count:2\}\}", "selectors-summon"),
        ("execute if entity @e[type=zombie]", "selectors-count"),
        ("execute if entity @e[type=zombie,distance=..5]", "selectors-count-near"),
        ("execute if entity @e[tag=none]", "selectors-count-none"),
        ("say @e[type=armor_stand]", "selectors-stands"),
        ("say @e[type=item,sort=nearest]", "selectors-items"),
        ("say @n[type=!player]", "selectors-nearest"),
        ("say @e[type=!player,sort=furthest,limit=2]", "selectors-furthest"),
        ("say @e[type=zombie,name=Bob]", "selectors-named"),
        ("execute at @e[type=armor_stand,tag=b] run summon pig ~ ~ ~1 \{NoAI:1b\}", "selectors-pig"),
        ("execute positioned as @e[type=armor_stand,limit=1,sort=furthest] run setblock ~ ~-1 ~ gold_block", "selectors-gold"),
        ("execute as @e[type=pig] at @s run kill @s", "selectors-kill-pig"),
        ("kill @e[type=item]", "selectors-kill-items"),
        ("kill @e[type=zombie,name=Bob]", "selectors-kill-named"),
        ("kill @e[type=zombie,tag=a,limit=1]", "selectors-kill-tagged"),
        ("execute as @e[type=armor_stand] run kill", "selectors-kill-stands"),
        ("kill @e[type=!player]", "selectors-kill-none"),
        ("", "selectors-1"), ("", "selectors-2"), ("", "selectors-3"),
        ("", "selectors-after"),
    ]
}

// `entity-commands`' steps (CAL-165), where `selectors`' are: by day, the bot summons a tagged
// zombie and a pig, both without AI, and an armor stand with a name, then runs commands on them
// with selectors: gives the zombie speed and every one glowing, `effect give`, and clears the
// zombie's speed and the pig's every effect, `effect clear`; sets and adds their scores, lists
// the zombie's and shows them in text, `score`, and their names, `selector`; reads the pig's
// health and the zombie's tags, `data get entity`; goes to the pig, `tp @s @e`, and back facing
// the zombie's eyes; then kills the zombie and lists the holders left. It watches for 3 seconds.
fn entity_commands_steps() -> List<(str, str)> {
    return [
        ("time set day", "entity-commands-day"),
        ("#all summon zombie 3.5 -60 -3.5 \{NoAI:1b,Tags:[\"a\"]\};summon armor_stand -3.5 -60 3.5 \{CustomName:\"Stand\"\};summon pig 5.5 -60 3.5 \{NoAI:1b\}", "entity-commands-summon"),
        ("effect give @e[type=zombie] minecraft:speed 30 1", "entity-commands-speed"),
        ("effect give @e[type=!player] minecraft:glowing 10", "entity-commands-glowing"),
        ("effect clear @e[type=zombie] minecraft:speed", "entity-commands-clear-speed"),
        ("effect clear @e[type=pig]", "entity-commands-clear-pig"),
        ("scoreboard objectives add t dummy", "entity-commands-objective"),
        ("scoreboard players set @e[type=!player] t 7", "entity-commands-set"),
        ("scoreboard players add @e[tag=a] t 3", "entity-commands-add"),
        ("scoreboard players list @e[type=zombie]", "entity-commands-list-zombie"),
        ("tellraw @s \{\"score\":\{\"name\":\"@e[type=zombie]\",\"objective\":\"t\"\}\}", "entity-commands-score-text"),
        ("tellraw @s \{\"selector\":\"@e[type=!player,sort=nearest]\"\}", "entity-commands-selector-text"),
        ("data get entity @e[type=pig,limit=1] Health", "entity-commands-pig-health"),
        ("data get entity @e[type=zombie,limit=1] Tags", "entity-commands-zombie-tags"),
        ("tp @s @e[type=pig,limit=1]", "entity-commands-to-pig"),
        ("tp @s 0.5 -60 0.5 facing entity @e[type=zombie,limit=1] eyes", "entity-commands-facing"),
        ("kill @e[type=zombie]", "entity-commands-kill"),
        ("scoreboard players list", "entity-commands-list"),
        ("", "entity-commands-1"), ("", "entity-commands-2"), ("", "entity-commands-3"),
        ("", "entity-commands-after"),
    ]
}

// `entity-tp`'s steps (CAL-165), where `selectors`' are: by day, the bot summons a tagged pig
// without AI, carrying a chicken without AI, another pig, an armor stand and two stones apart,
// then teleports them: the pigs to a place, the tagged one taking its chicken with it, then
// along by a block from where the bot is and turned; the chicken off it; the armor stand turned,
// then facing a place and facing the bot's eyes; the stones, one after the other, to the same
// place, where they merge; and the pig to the bot, `tp @e @s`, and by a block as itself, `execute
// as ... at @s run tp`. It watches for 3 seconds.
fn entity_tp_steps() -> List<(str, str)> {
    return [
        ("time set day", "entity-tp-day"),
        ("#all summon pig 3.5 -60 3.5 \{NoAI:1b,Tags:[\"r\"],Passengers:[\{id:\"minecraft:chicken\",NoAI:1b\}]\};summon pig 5.5 -60 -2.5 \{NoAI:1b\};summon armor_stand -3.5 -60 3.5;summon item 4.5 -60 -4.5 \{Item:\{id:\"minecraft:stone\",count:1\}\};summon item -4.5 -60 -4.5 \{Item:\{id:\"minecraft:stone\",count:2\}\}", "entity-tp-summon"),
        ("tp @e[type=pig] 2.5 -60 -2.5", "entity-tp-pigs"),
        ("tp @e[type=pig,tag=r] ~1 ~ ~ ~30 ~", "entity-tp-along"),
        ("tp @e[type=chicken] -2.5 -60 -0.5", "entity-tp-chicken"),
        ("tp @e[type=armor_stand] 1.5 -60 1.5 90 10", "entity-tp-turned"),
        ("tp @e[type=armor_stand] 1.5 -60 1.5 facing 0.5 -59 0.5", "entity-tp-facing"),
        ("tp @e[type=armor_stand] -1.5 -60 1.5 facing entity @s eyes", "entity-tp-facing-bot"),
        ("tp @e[type=item] 0.5 -60 -2.5", "entity-tp-stones"),
        ("tp @e[type=pig,tag=!r] @s", "entity-tp-to-bot"),
        ("execute as @e[type=pig,tag=r] at @s run tp ~ ~ ~1", "entity-tp-as-itself"),
        ("", "entity-tp-1"), ("", "entity-tp-2"), ("", "entity-tp-3"),
        ("", "entity-tp-after"),
    ]
}

// `entity-damage`'s steps (CAL-165), where `selectors`' are: by day, the bot summons a zombie
// and a pig without AI and a cow, then runs `damage`: the zombie by 2, generic; by 3 of
// `in_fire` from a place; by 4 of `mob_attack` dealt by the pig; by 5 of `arrow` dealt by the
// pig and caused by the bot; the bot by 1 of `mob_attack` dealt by the zombie; a type that isn't
// one; the pig to death by 20 of `player_attack` dealt by the bot, which drops what a player's
// kill does; then the cow by 1, twice at once, the second within its hurt's cooldown. It watches
// for 3 seconds.
fn entity_damage_steps() -> List<(str, str)> {
    return [
        ("time set day", "entity-damage-day"),
        ("#all summon zombie 3.5 -60 -3.5 \{NoAI:1b\};summon pig 5.5 -60 3.5 \{NoAI:1b\};summon cow -3.5 -60 3.5", "entity-damage-summon"),
        ("damage @e[type=zombie,limit=1] 2", "entity-damage-generic"),
        ("damage @e[type=zombie,limit=1] 3 minecraft:in_fire at 3.5 -60 0.5", "entity-damage-at"),
        ("damage @e[type=zombie,limit=1] 4 minecraft:mob_attack by @e[type=pig,limit=1]", "entity-damage-by"),
        ("damage @e[type=zombie,limit=1] 5 minecraft:arrow by @e[type=pig,limit=1] from @s", "entity-damage-from"),
        ("damage @s 1 minecraft:mob_attack by @e[type=zombie,limit=1]", "entity-damage-bot"),
        ("damage @s 1 minecraft:nothing_here", "entity-damage-unknown"),
        ("damage @e[type=pig,limit=1] 20 minecraft:player_attack by @s", "entity-damage-pig"),
        ("#all damage @e[type=cow,limit=1] 1;damage @e[type=cow,limit=1] 1", "entity-damage-cow"),
        ("", "entity-damage-1"), ("", "entity-damage-2"), ("", "entity-damage-3"),
        ("", "entity-damage-after"),
    ]
}

// `entity-tags`' steps (CAL-165), where `selectors`' are: the bot summons a pig without AI with
// a tag and an armor stand, then runs `tag`: lists the pig's and the stand's; gives every one a
// tag, itself among them, and the pig more; gives the pig one it has, which fails; lists the
// pig's, the stand's and everyone's; takes one off the pig and one no one has, which fails; and
// reads the pig's tags as it saves them, `data get`, in the order its set goes over them.
fn entity_tags_steps() -> List<(str, str)> {
    return [
        ("#all summon pig 3.5 -60 3.5 \{NoAI:1b,Tags:[\"old\"]\};summon armor_stand -3.5 -60 3.5", "entity-tags-summon"),
        ("tag @e[type=pig] list", "entity-tags-list-pig"),
        ("tag @e[type=armor_stand] list", "entity-tags-list-stand"),
        ("tag @e add every", "entity-tags-every"),
        ("#all tag @e[type=pig] add zeta;tag @e[type=pig] add alpha;tag @e[type=pig] add m3;tag @e[type=pig] add Bee", "entity-tags-more"),
        ("tag @e[type=pig] add alpha", "entity-tags-again"),
        ("tag @e[type=pig] list", "entity-tags-list-pig-after"),
        ("tag @s list", "entity-tags-list-self"),
        ("tag @e list", "entity-tags-list-all"),
        ("tag @e[type=pig] remove zeta", "entity-tags-remove"),
        ("tag @e remove nobody", "entity-tags-remove-none"),
        ("data get entity @e[type=pig,limit=1] Tags", "entity-tags-saved"),
        ("tag @e[tag=every] remove every", "entity-tags-remove-every"),
        ("", "entity-tags-1"), ("", "entity-tags-2"),
        ("", "entity-tags-after"),
    ]
}

// `entity-items`' steps (CAL-165), where `selectors`' are: by day, the bot summons a zombie and a
// pig without AI and an armor stand, then runs `item` on them: a helmet on the zombie's head; a
// stone on its chest, which doesn't fit and fails; a sword in its hand; a chestplate on the
// stand; boots on every one, the bot among them; a saddle on the pig; five stone in the zombie's
// offhand, cut to two, `item modify`; and the bot's first hotbar slot given a copy of them, `from
// entity`. It watches for 3 seconds. A name, `set_name`, isn't in Calcite yet (CAL-320).
fn entity_items_steps() -> List<(str, str)> {
    return [
        ("time set day", "entity-items-day"),
        ("#all summon zombie 3.5 -60 -3.5 \{NoAI:1b\};summon pig 5.5 -60 3.5 \{NoAI:1b\};summon armor_stand -3.5 -60 3.5", "entity-items-summon"),
        ("item replace entity @e[type=zombie] armor.head with minecraft:diamond_helmet", "entity-items-helmet"),
        ("item replace entity @e[type=zombie] armor.chest with minecraft:stone", "entity-items-stone"),
        ("item replace entity @e[type=zombie] weapon.mainhand with minecraft:iron_sword", "entity-items-sword"),
        ("item replace entity @e[type=armor_stand] armor.chest with minecraft:leather_chestplate", "entity-items-stand"),
        ("item replace entity @e armor.feet with minecraft:diamond_boots", "entity-items-boots"),
        ("item replace entity @e[type=pig] saddle with minecraft:saddle", "entity-items-saddle"),
        ("item replace entity @e[type=zombie] weapon.offhand with minecraft:stone 5", "entity-items-offhand"),
        ("item modify entity @e[type=zombie] weapon.offhand \{type:\"minecraft:set_count\",count:2\}", "entity-items-modify"),
        ("item replace entity @s hotbar.0 from entity @e[type=zombie,limit=1] weapon.offhand", "entity-items-from"),
        ("", "entity-items-1"), ("", "entity-items-2"), ("", "entity-items-3"),
        ("", "entity-items-after"),
    ]
}

// `entity-nbt`'s steps (CAL-165), where `selectors`' are: by day, the bot summons a tagged zombie
// and a pig without AI, an invisible armor stand and three stones, then picks them by their data,
// `nbt`: those without AI, those without, `!`, the tagged one by its list of tags, the stones by
// their count, the zombie by its health, by where it is, the bot by its slot and its empty
// inventory, and none by a value no one has.
fn entity_nbt_steps() -> List<(str, str)> {
    return [
        ("time set day", "entity-nbt-day"),
        ("#all summon zombie 3.5 -60 -3.5 \{NoAI:1b,Tags:[\"a\",\"b\"]\};summon pig 5.5 -60 3.5 \{NoAI:1b\};summon armor_stand -3.5 -60 3.5 \{Invisible:1b\};summon item 0.5 -60 -3.5 \{Item:\{id:\"minecraft:stone\",count:3\}\}", "entity-nbt-summon"),
        ("say @e[nbt=\{NoAI:1b\}]", "entity-nbt-no-ai"),
        ("say @e[type=!player,nbt=!\{NoAI:1b\}]", "entity-nbt-not-no-ai"),
        ("tag @e[nbt=\{Tags:[\"b\"]\}] list", "entity-nbt-tags"),
        ("execute if entity @e[type=item,nbt=\{Item:\{count:3\}\}]", "entity-nbt-stones"),
        ("say @e[type=zombie,nbt=\{Health:20.0f\}]", "entity-nbt-health"),
        ("say @e[nbt=\{Pos:[3.5d,-60.0d,-3.5d]\}]", "entity-nbt-pos"),
        ("say @a[nbt=\{SelectedItemSlot:0\}]", "entity-nbt-slot"),
        ("say @s[nbt=\{Inventory:[]\}]", "entity-nbt-inventory"),
        ("execute if entity @e[nbt=\{Invisible:0b,NoAI:1b,Tags:[\"c\"]\}]", "entity-nbt-none"),
        ("", "entity-nbt-1"), ("", "entity-nbt-2"),
        ("", "entity-nbt-after"),
    ]
}

// `entity-predicate`'s steps (CAL-165), where `selectors`' are: by day, the bot summons a zombie
// and a pig without AI and an armor stand, then picks them by the rig pack's predicates,
// `predicate`: the player, those that aren't, `!`, none by one that never holds, none by one
// there isn't, nor by it turned round, the pig in the overworld, two tests in a row, `@s` run as
// the pig, and those a coin picks, which draws from the level's random for each in turn.
fn entity_predicate_steps() -> List<(str, str)> {
    return [
        ("time set day", "entity-predicate-day"),
        ("#all summon zombie 3.5 -60 -5.5 \{NoAI:1b\};summon pig 5.5 -60 5.5 \{NoAI:1b\};summon armor_stand -5.5 -60 3.5", "entity-predicate-summon"),
        ("say @e[predicate=rig:player]", "entity-predicate-player"),
        ("say @e[predicate=!rig:player]", "entity-predicate-not-player"),
        ("execute if entity @e[predicate=rig:never]", "entity-predicate-never"),
        ("execute if entity @e[predicate=rig:nope]", "entity-predicate-unknown"),
        ("execute if entity @e[predicate=!rig:nope]", "entity-predicate-unknown-inverted"),
        ("say @e[type=pig,predicate=rig:overworld]", "entity-predicate-overworld"),
        ("say @e[predicate=rig:always,predicate=!rig:player,type=!armor_stand]", "entity-predicate-two"),
        ("execute as @e[type=pig] run say @s[predicate=!rig:player]", "entity-predicate-as-pig"),
        ("execute if entity @e[predicate=rig:coin]", "entity-predicate-coin"),
        ("", "entity-predicate-1"), ("", "entity-predicate-2"),
        ("", "entity-predicate-after"),
    ]
}

// `entity-data`'s steps (CAL-165), where `selectors`' are: by day, the bot summons a zombie and a
// pig without AI, an armor stand and three stones, then changes their data, `data merge` and
// `data modify`, each loaded onto the entity as it is: the pig named, the zombie's health, the
// stand small with arms, the stones diamonds, the pig moved, a merge that changes nothing, a tag
// added to the zombie and listed, a helmet put on it, the pig's name taken off, and the diamonds
// made none, which takes them away.
fn entity_data_steps() -> List<(str, str)> {
    return [
        ("time set day", "entity-data-day"),
        ("#all summon zombie 3.5 -60 -5.5 \{NoAI:1b\};summon pig 5.5 -60 5.5 \{NoAI:1b\};summon armor_stand -5.5 -60 3.5;summon item 0.5 -60 -3.5 \{Item:\{id:\"minecraft:stone\",count:3\}\}", "entity-data-summon"),
        ("data merge entity @e[type=pig,limit=1] \{CustomName:\"Bob\",CustomNameVisible:1b\}", "entity-data-name"),
        ("data modify entity @e[type=zombie,limit=1] Health set value 5.0f", "entity-data-health"),
        ("data merge entity @e[type=armor_stand,limit=1] \{ShowArms:1b,Small:1b\}", "entity-data-stand"),
        ("data merge entity @e[type=item,limit=1] \{Item:\{id:\"minecraft:diamond\",count:2\}\}", "entity-data-item"),
        ("data merge entity @e[type=pig,limit=1] \{Pos:[2.5d,-60.0d,2.5d]\}", "entity-data-move"),
        ("data merge entity @e[type=pig,limit=1] \{NoAI:1b\}", "entity-data-unchanged"),
        ("data modify entity @e[type=zombie,limit=1] Tags append value \"x\"", "entity-data-tag"),
        ("tag @e[type=zombie,limit=1] list", "entity-data-tags"),
        ("data merge entity @e[type=zombie,limit=1] \{equipment:\{head:\{id:\"minecraft:diamond_helmet\",count:1\}\}\}", "entity-data-helmet"),
        ("data remove entity @e[type=pig,limit=1] CustomName", "entity-data-unnamed"),
        ("say @e[type=!player]", "entity-data-named"),
        ("data merge entity @e[type=item,limit=1] \{Item:\{count:0\}\}", "entity-data-none"),
        ("", "entity-data-1"), ("", "entity-data-2"), ("", "entity-data-3"),
        ("", "entity-data-after"),
    ]
}

// `egg-throws`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode, holds
// 16 eggs and summons a cow without AI south of it. It throws one at the cow, which hurts it by
// none, `ThrownEgg.onHitEntity`, and a dozen straight down, each breaking on the ground, event 3,
// and hatching a baby chicken one time in eight, `ThrownEgg.onHit`, drawn from the egg's own
// random, put where a baby has room; then blue eggs and brown eggs, whose chickens are cold and
// warm, two of each down, and one high to the east. Then an egg summoned above the ground falls
// and breaks.
