        ("summon egg 3.5 -57 6.5", "egg-throws-summoned"),
        ("", "egg-throws-summoned-1"),
        ("", "egg-throws-summoned-2"),
        ("", "egg-throws-summoned-3"),
        ("", "egg-throws-1"), ("", "egg-throws-2"), ("", "egg-throws-3"), ("", "egg-throws-4"),
        ("", "egg-throws-after"),
    ]
}

// `xp-bottles`' steps (CAL-214), where `snowballs`' are: by day, the bot, in survival mode, holds
