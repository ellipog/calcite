        ("gamemode creative", "fishing-creative"),
        ("item replace entity @s weapon.mainhand with water_bucket", "fishing-bucket-again"),
        ("#use-mob 1", "fishing-caught-again"),
        ("", "fishing-1"), ("", "fishing-2"), ("", "fishing-3"), ("", "fishing-4"), ("", "fishing-5"),
        ("", "fishing-after"),
    ]
}

// `stand-use`'s steps (CAL-179), where `riding`'s are, by day, on normal: the bot, in survival mode,
// summons an armor stand with arms, one without and one with every slot disabled around it in one
// tick; then puts a sword in the first's hand and takes it back with an empty hand; puts a helmet
// on the second and tries a sword, which it has no arms for; tries a chestplate on the third,
// which is disabled; puts one of five stone in the first's hand; names the second; and, in
// creative mode, puts boots on the first, keeping them. It watches for 5 seconds.
