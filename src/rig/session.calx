    packets.push(Dug.UseItemTurnedAt(0, 5, 180.0f32, -30.0f32, 362, "slowness"))
    packets.push(Dug.Leave(480))
    return [Dig { name: String(), packets: packets }]
}

// What `beacons` does on the `beacons` fixture's world (D520), in creative mode at the spawn with
// stone in its hand, by the server's clock from once it's loaded, while the beacons about it pulse
// every 80 ticks: at 300 it breaks a corner of the base of the beacon of speed, which goes off as
// its levels are next read; at 400 it puts stone on the red stained glass over the beacon of jump
// boost, which cuts its beam, so it gives nothing more but keeps its levels; and it leaves at 560.
fn beacons_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "start"))
    packets.push(Dug.DigAt(3, -61, 7, 1, 300, "base-broken"))
    packets.push(Dug.UseOnAt(2, -58, 2, 2, 400, "beam-cut"))
    packets.push(Dug.Mark(480, "cut"))
    packets.push(Dug.Leave(560))
    return [Dig { name: String(), packets: packets }]
}

// What `beacon-menu` does on the `beacons` fixture's world (D521), in survival mode at the spawn
// with an iron ingot, a gold ingot and four emeralds in its first three hotbar slots, by the
// server's clock from once it's loaded: at 150 it uses the beacon of jump boost, two levels, which
// opens its menu; at 170 it shift-clicks the iron ingot into its payment slot, and at 190 picks
// speed alone, which takes it, the beacon's power select sound played; at 260 it shift-clicks the
// gold ingot in, and at 280 closes the menu, which drops it; at 300 it opens the menu again, at
// 320 shift-clicks the four emeralds, which go into the inventory, more than one, and at 340
// closes it; and it leaves at 480, the beacon giving speed now.
// What `traders` does on the `enchanted` and `dyed` fixtures' worlds (D522, D523), by the server's
// clock from once it's loaded: it uses each of the eight villagers around it in turn, from 100 and
// every 40 ticks, east, south, south-east, west, north, north-west, north-east and south-west of
// it, their offers made as it does and shown, and closes each one's trades 20 ticks after; and it
// leaves at 460.
fn traders_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(60, "idle"))
    let at: List<(f64, f64, str, str)> = [
        (6.5, 4.5, "use-1", "close-1"), (4.5, 6.5, "use-2", "close-2"),
        (6.5, 6.5, "use-3", "close-3"), (2.5, 4.5, "use-4", "close-4"),
        (4.5, 2.5, "use-5", "close-5"), (2.5, 2.5, "use-6", "close-6"),
        (6.5, 2.5, "use-7", "close-7"), (2.5, 6.5, "use-8", "close-8"),
    ]
    var t: i64 = 100
    for (x, z, used, closed) in at {
        packets.push(Dug.UseVillager(x, z, t, used))
        packets.push(Dug.CloseAt(t + 20, closed))
        t += 40
    }
    packets.push(Dug.Leave(460))
    return [Dig { name: String(), packets: packets }]
}

fn beacon_menu_steps() -> List<Dig> {
    var packets = List<Dug>()
    packets.push(Dug.Mark(100, "start"))
    packets.push(Dug.UseOnAt(2, -59, 2, 1, 150, "open"))
    packets.push(Dug.ClickAt(press(28i16, 0i8, 1, [(0i16, plain("iron_ingot", 1)), (28i16, nothing())], nothing()), 170, "pay-iron"))
    packets.push(Dug.SetBeaconAt(effect_number("speed"), -1, 190, "speed"))
    packets.push(Dug.ClickAt(press(29i16, 0i8, 1, [(0i16, plain("gold_ingot", 1)), (29i16, nothing())], nothing()), 260, "pay-gold"))
    packets.push(Dug.CloseAt(280, "close-paid"))
    packets.push(Dug.UseOnAt(2, -59, 2, 2, 300, "reopen"))
    packets.push(Dug.ClickAt(press(30i16, 0i8, 1, [(1i16, plain("emerald", 4)), (30i16, nothing())], nothing()), 320, "emeralds"))
    packets.push(Dug.CloseAt(340, "close"))
    packets.push(Dug.Leave(480))
    return [Dig { name: String(), packets: packets }]
}

// The ID of the effect `name` in the `mob_effect` registry, as `ServerboundSetBeacon` writes it
// (D521).
fn effect_number(name: str) -> i32 {
    let names = builtin_entries(3)
    for i in 0..names.len() {
        if names[i] == String(name) {
            return i32.wrap(i)
        }
    }
    panic("there's no effect {name}")
}

// The effect of the ID `id`, none for -1, as `ServerboundSetBeacon` has it (D521).
fn effect_ref(id: i32) -> EffectId? {
    if id < 0 {
        return none
    }
    return some(EffectId { id: id })
}

// What `enderman` does on the `enderman` fixture's world (CAL-159), on its pillar at the spawn
// with nothing in its hands, by the server's clock from once it's loaded: at 110, once the levels
// are seeded again, it turns east and 46 degrees down, to stare at Ender's eyes; Ender takes it up
// and teleports away, then comes back for it, angry; at 250 a mark as it goes; and it leaves at
