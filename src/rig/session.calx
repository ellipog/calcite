        ("item replace entity @s hotbar.3 with dirt 2", "ench-dirt"),
        ("item replace entity @s hotbar.4 with diamond_pickaxe[enchantments=\{efficiency:1\}]", "ench-pickaxe"),
        ("item replace entity @s hotbar.5 with golden_hoe", "ench-hoe"),
        ("item replace entity @s hotbar.6 with stone_sword", "ench-stone-sword"),
        ("fill -2 -60 1 2 -59 5 bookshelf", "ench-shelves"),
        ("fill -1 -60 2 1 -59 4 air", "ench-hollow"),
        ("setblock 0 -60 3 enchanting_table", "ench-placed"),
        ("#use 0 -60 3", "ench-open"),
        ("#click 29 0 1", "ench-sword-in"),
        ("#click 30 0 1", "ench-lapis-in"),
        ("#button 2", "ench-third"),
        ("#click 0 0 1", "ench-sword-out"),
        ("#click 31 0 1", "ench-book-in"),
        ("#button 0", "ench-book"),
        ("#click 0 0 1", "ench-book-out"),
        ("#click 32 0 1", "ench-dirt-in"),
        ("#button 0", "ench-dirt-none"),
        ("#click 0 0 1", "ench-dirt-out"),
        ("#click 33 0 1", "ench-pickaxe-in"),
        ("#button 0", "ench-pickaxe-none"),
        ("#click 0 0 1", "ench-pickaxe-out"),
        ("xp set @s 0 levels", "ench-no-levels"),
        ("#click 34 0 1", "ench-hoe-in"),
        ("#button 0", "ench-hoe-poor"),
        ("xp set @s 2 levels", "ench-few-levels"),
        ("#button 1", "ench-hoe-second"),
        ("#button 0", "ench-hoe-first"),
        ("#button 5", "ench-no-button"),
        ("#close", "ench-closed"),
        ("xp set @s 30 levels", "ench-levels-again"),
        ("fill -2 -60 1 2 -59 1 air", "ench-north-gone"),
        ("fill -2 -60 5 2 -59 5 air", "ench-south-gone"),
        ("fill -2 -59 2 2 -59 4 air", "ench-top-gone"),
        ("setblock 1 -60 3 torch", "ench-torch"),
        ("#use 0 -60 3", "ench-reopen"),
        ("#click 30 0 1", "ench-lapis-back"),
        ("#click 31 0 0", "ench-books-up"),
        ("#click 0 0 0", "ench-book-down"),
        ("#click 31 0 0", "ench-books-back"),
        ("#click 0 0 1", "ench-book-out-again"),
        ("#click 35 0 0", "ench-stone-up"),
        ("#click 0 0 0", "ench-stone-down"),
        ("#button 1", "ench-stone-second"),
        ("setblock 0 -60 3 air", "ench-broken"),
        ("", "ench-after"),
    ]
}

// `anvil`'s steps (CAL-338): an anvil's menu opened, `INTERACT_WITH_ANVIL`; a damaged iron sword
// repaired by four of five iron ingots and taken by a shift-click, its levels taken, the last
// ingot shifted out; a sword with sharpness III given a book of it, sharpness IV, taken by hand;
// a sword with smite given sharpness, which can't be with it; two damaged swords mended together
// and renamed; dirt renamed alone, all of it, the dirt kept, then renamed and taken ten times
// more, which wears the anvil; a name the same as the item's, then
// none, which takes its name off; too few levels to take it; the inputs given back as it's closed;
// then the menu closed as the anvil's broken.
