/// The `registries` probe (rig/PROTOCOL.md): what Calcite sends a client in configuration, from
/// the vanilla data pack in the pinned server jar at oracle/jars/, loaded on the first case and
/// kept.
module rig.registries

import json.tree.{Json, Member, as_string, take}
import pack.resources.{KnownPack, Pack, Resources}
import pack.vanilla.{vanilla_pack}
import registry.registries.{Registries}
import registry.registry.{Registry}
import rig.frame.{Outcome}
import server.log.{Entry}

/// What the probe loads once.
pub struct Loaded {
    known: List<KnownPack>
    registries: Registries
}

/// Loads the registries, or says why it can't.
pub fn load_registries() -> Loaded ! String {
    var logs = List<Entry>()
    let pack = try vanilla_pack(String("oracle/jars/server-26.3.jar"))
    let packs: List<Pack> = [pack]
    let resources = Resources.new(packs)
    let registries = Registries.load(resources, mut logs) else fail String("the registries didn't load")
    return Loaded { known: resources.known_packs(), registries: registries }
}

pub fn run_registries(input: own List<Member>, loaded: Loaded) -> Outcome {
    var i = input
    let op = as_string(take(mut i, "op") ?? Json.Null) ?? String()
    if op == "known_packs" {
        var packs = List<Json>()
        for k in loaded.known {
            packs.push(Json.Array([Json.Str(k.namespace.copy()), Json.Str(k.id.copy()), Json.Str(k.version.copy())]))
        }
        return Outcome.Done { output: [Member { key: "packs", value: Json.Array(packs) }], blobs: [] }
    }
    if op == "synced" {
        var out = List<Json>()
        for r in loaded.registries.synced {
            var entries = List<Json>()
            for k in 0..r.entries.len() {
                // An entry from a pack the client knows goes without its data.
                let known = match r.packs[k] {
                    some(_) => true,
                    none => false,
                }
                entries.push(Json.Array([Json.Str(r.entries[k].to_string()), Json.Bool(not known)]))
            }
            out.push(Json.Object([Member { key: "name", value: Json.Str(r.name.to_string()) }, Member { key: "entries", value: Json.Array(entries) }]))
        }
        return Outcome.Done { output: [Member { key: "registries", value: Json.Array(out) }], blobs: [] }
    }
    if op == "tags" {
        let name = as_string(take(mut i, "registry") ?? Json.Null) else return Outcome.Failed(String("`registry` must be a string"))
        var tags = List<Json>()
        for r in loaded.registries.synced {
            add_tags(r, name, mut tags)
        }
        for r in loaded.registries.builtin {
            add_tags(r, name, mut tags)
        }
        return Outcome.Done { output: [Member { key: "tags", value: Json.Array(tags) }], blobs: [] }
    }
    return Outcome.Failed("unknown `op`: `{op}`")
}

// The tags of `r` if it's the registry named `name`, by name in string order.
fn add_tags(r: Registry, name: String, tags: mut List<Json>) {
    if r.name.to_string() != name {
        return
    }
    var named = List<(String, usize)>()
    for k in 0..r.tags.len() {
        named.push((r.tags[k].name.to_string(), k))
    }
    named.sort()
    for (n, k) in named {
        var values = List<Json>()
        for v in r.tags[k].values {
            values.push(Json.Number("{v}"))
        }
        tags.push(Json.Array([Json.Str(n.copy()), Json.Array(values)]))
    }
}
