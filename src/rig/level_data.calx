/// The `level_data` probe (rig/PROTOCOL.md): `storage.level`'s `level.dat`, the SNBT of its
/// `Data` compound read and written back, as a server reads it as it starts and writes it as it
/// saves. The blob is what was logged, which is nothing, then the NBT written, with `LastPlayed`
/// 0.
module rig.level_data

import json.tree.{Json, Member, as_string, take}
import nbt.snbt.{parse_compound}
import nbt.tag.{Tag}
import rig.frame.{Outcome}
import storage.level.{LevelData}

pub fn run_level_data(input: own List<Member>, blobs: List<List<u8>>) -> Outcome {
    if not blobs.is_empty() {
        return Outcome.Failed("`level_data` takes no blobs")
    }
    var fields = input
    let snbt = as_string(take(mut fields, "snbt") ?? Json.Null) else return Outcome.Failed("`snbt` must be a string")
    let data = match parse_compound(snbt) {
        ok(Tag.Compound(tags)) => tags,
        ok(_) => return Outcome.Failed("`snbt` isn't a compound"),
        err(e) => return Outcome.Failed("`snbt` isn't a compound: {e.context()}"),
    }
    var bytes = List<u8>()
    LevelData.parse(data).write(0).write_unnamed(mut bytes)
    // No lines, then the NBT.
    var out: List<u8> = [0, 0, 0, 0]
    put_i32(mut out, i32.wrap(bytes.len()))
    for b in bytes {
        out.push(b)
    }
    return Outcome.Done { output: [], blobs: [out] }
}

fn put_i32(out: mut List<u8>, v: i32) {
    out.push(u8.wrap(v >> 24))
    out.push(u8.wrap(v >> 16))
    out.push(u8.wrap(v >> 8))
    out.push(u8.wrap(v))
}
