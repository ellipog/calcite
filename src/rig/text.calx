/// The `text` probe (rig/PROTOCOL.md): a text component read from JSON, as Gson's
/// `JsonParser.parseString` reads it, or from SNBT, as `TagParser.parseFully` does, through
/// `ComponentSerialization.CODEC` against the vanilla data pack's registries, and written back
/// to JSON as `GsonHelper.toStableString` writes it, with its keys sorted, as plain text with
/// vanilla's `en_us`, and to NBT (CAL-103, D368).
module rig.text

import chat.language.{Language}
import json.gson.{JsonWriter}
import json.strict.{parse_lenient}
import json.tree.{Json, Member, as_string, parse, take}
import nbt.snbt.{parse as parse_snbt}
import registry.codec.{Codecs}
import registry.codecs.{component_of, text_raw}
import registry.components.{component_patch}
import registry.registries.{Registries}
import rig.frame.{Outcome}
import rig.nbt.{load_language}
import world.states.{StateCodec}

/// Runs a case: `json` or `snbt`, the component.
pub fn run_text(input: own List<Member>, registries: Registries, lang: mut Language?) -> Outcome {
    var fields = input
    if lang == none {
        match load_language() {
            ok(l) => lang = some(l),
            err(message) => return Outcome.Failed(message),
        }
    }
    var codecs = Codecs.new()
    if let b = registries.find_builtin(String("block")) {
        codecs.states = some(StateCodec.new(registries.builtin[b]))
    }
    codecs.lang = lang.copy()
    codecs.frozen = true
    _ = text_raw(mut codecs)
    _ = component_patch(mut codecs)
    var value = Json.Null
    if let text = as_string(take(mut fields, "json") ?? Json.Null) {
        match parse_lenient(text) {
            ok(v) => value = v,
            err(_) => return Outcome.Done { output: rejection(String("JsonSyntaxException"), String()), blobs: [] },
        }
    } else if let text = as_string(take(mut fields, "snbt") ?? Json.Null) {
        match parse_snbt(text) {
            ok(tag) => value = tag.to_typed_json(),
            err(e) => {
                let said = match lang {
                    some(l) => e.text(l),
                    none => String(),
                }
                return Outcome.Done { output: rejection(String("CommandSyntaxException"), said), blobs: [] }
            },
        }
        codecs.nbt = true
    } else {
        return Outcome.Failed(String("`text` needs `json` or `snbt`"))
    }
    let component = match component_of(codecs, value, registries) {
        ok(c) => c,
        err(message) => return Outcome.Done { output: [Member { key: "error", value: Json.Str(message) }], blobs: [] },
    }
    let written = parse(component.to_json()) else return Outcome.Failed(String("the component's JSON doesn't parse"))
    var w = JsonWriter.new()
    w.tree(sorted(written))
    let plain = match lang {
        some(l) => component.get_string(l),
        none => String(),
    }
    var bytes = List<u8>()
    match component.to_nbt().write_any(mut bytes) {
        ok => {},
        err(message) => return Outcome.Failed(message),
    }
    let output: List<Member> = [
        Member { key: "json", value: Json.Str(w.into_string()) },
        Member { key: "plain", value: Json.Str(plain) },
    ]
    return Outcome.Done { output: output, blobs: [bytes] }
}

// `value` with each object's members in the order of their keys, as `toStableString` writes
// them, by `String.compareTo`.
fn sorted(value: Json) -> Json {
    return match value {
        Json.Object(members) => {
            var out = List<Member>()
            for m in members {
                var at = out.len()
                while at > 0 and before(m.key, out[at - 1].key) {
                    at -= 1
                }
                out.insert(at, Member { key: m.key.copy(), value: sorted(m.value) })
            }
            Json.Object(out)
        },
        Json.Array(items) => {
            var out = List<Json>()
            for item in items {
                out.push(sorted(item))
            }
            Json.Array(out)
        },
        _ => value.copy(),
    }
}

// Whether `a` comes before `b` as Java's `String.compareTo` orders them, by UTF-16 units, which
// UTF-8's bytes keep for the keys a component has, all ASCII.
fn before(a: String, b: String) -> bool {
    let n = a.len().min(b.len())
    for i in 0..n {
        if a.byte_at(i) != b.byte_at(i) {
            return a.byte_at(i) < b.byte_at(i)
        }
    }
    return a.len() < b.len()
}

// A rejection as the vanilla adapter writes one: the exception's simple class name and message.
fn rejection(exception: own String, message: own String) -> List<Member> {
    return [Member { key: "exception", value: Json.Str(exception) }, Member { key: "error", value: Json.Str(message) }]
}
