/// Calcite's rig adapter (rig/PROTOCOL.md): runs the probes Calcite implements on Calcite's own
/// code, so the rig can compare each result with vanilla's.
module rig.adapter

import chat.language.{Language}
import rig.frame.{Outcome, read_frame, write_frame}
import rig.chunk.{run_chunk}
import rig.chunk_nbt.{run_chunk_nbt}
import rig.level_data.{run_level_data}
import rig.collections.{run_collections}
import json.tree.{Json, Member, as_string, take}
import rig.nbt.{run_nbt}
import rig.palette.{run_palette}
import rig.region.{run_region}
import rig.registries.{Loaded, load_registries, run_registries}
import rig.rng.{run_rng}
import rig.world_folder.{run_world_folder}
import server.play.{block_states, flat_blocks}
import storage.chunk.{ChunkFormat}

fn main() {
    // The registries, the language and the chunk format load on the first case that needs them,
    // and stay.
    var loaded: Loaded? = none
    var lang: Language? = none
    var format: ChunkFormat? = none
    loop {
        let frame = read_frame() else return
        var header = frame.header
        let kind = as_string(take(mut header, "type") ?? Json.Null) ?? String()
        if kind == "hello" {
            hello()
        } else if kind == "run" {
            run(header, frame.blobs, mut loaded, mut lang, mut format)
        } else if kind == "bye" {
            write_frame([Member { key: "type", value: Json.Str("bye") }], [])
            return
        } else {
            let id = take(mut header, "id") ?? Json.Null
            reply(id, Outcome.Failed("unknown message type `{kind}`"))
        }
    }
}

fn hello() {
    let probes: List<Member> = [
        Member { key: "ping", value: Json.Number("1") },
        Member { key: "rng", value: Json.Number("1") },
        Member { key: "collections", value: Json.Number("1") },
        Member { key: "registries", value: Json.Number("1") },
        Member { key: "nbt", value: Json.Number("1") },
        Member { key: "palette", value: Json.Number("1") },
        Member { key: "chunk", value: Json.Number("1") },
        Member { key: "region", value: Json.Number("1") },
        Member { key: "chunk_nbt", value: Json.Number("1") },
        Member { key: "level_data", value: Json.Number("1") },
        Member { key: "world_folder", value: Json.Number("1") },
    ]
    let about: List<Member> = [Member { key: "language", value: Json.Str("calx") }]
    let header: List<Member> = [
        Member { key: "type", value: Json.Str("hello") },
        Member { key: "protocol", value: Json.Number("1") },
        Member { key: "adapter", value: Json.Str("calcite") },
        Member { key: "game_version", value: Json.Str("26.3") },
        Member { key: "probes", value: Json.Object(probes) },
        Member { key: "about", value: Json.Object(about) },
    ]
    write_frame(header, [])
}

fn run(header: own List<Member>, blobs: own List<List<u8>>, loaded: mut Loaded?, lang: mut Language?, format: mut ChunkFormat?) {
    var h = header
    let id = take(mut h, "id") ?? Json.Null
    let probe = as_string(take(mut h, "probe") ?? Json.Null) ?? String()
    var input: List<Member> = []
    if let value = take(mut h, "input") {
        match value {
            Json.Object(members) => input = members,
            _ => {
                reply(id, Outcome.Failed("`input` must be an object"))
                return
            }
        }
    }
    let outcome = if probe == "ping" {
        let echo = take(mut input, "echo") ?? Json.Null
        Outcome.Done { output: [Member { key: "echo", value: echo }], blobs: blobs }
    } else if probe == "rng" {
        run_rng(input)
    } else if probe == "collections" {
        run_collections(input)
    } else if probe == "nbt" {
        run_nbt(input, blobs, mut lang)
    } else if probe == "palette" {
        run_palette(input, blobs)
    } else if probe == "region" {
        run_region(input, blobs)
    } else if probe == "level_data" {
        run_level_data(input, blobs)
    } else if probe == "world_folder" {
        run_world_folder(input, blobs)
    } else if probe == "registries" or probe == "chunk" or probe == "chunk_nbt" {
        if loaded == none {
            match load_registries() {
                ok(l) => loaded = some(l),
                err(message) => {
                    reply(id, Outcome.Failed(message))
                    return
                },
            }
        }
        match loaded {
            some(l) => if probe == "registries" {
                run_registries(input, l)
            } else if probe == "chunk" {
                chunk_with(input, blobs, l)
            } else {
                if format == none {
                    match ChunkFormat.new(l.registries) {
                        ok(f) => format = some(f),
                        err(message) => {
                            reply(id, Outcome.Failed(message))
                            return
                        },
                    }
                }
                match format {
                    some(f) => run_chunk_nbt(input, blobs, f),
                    none => Outcome.Failed(String("the chunk format didn't load")),
                }
            },
            none => Outcome.Failed(String("the registries didn't load")),
        }
    } else {
        Outcome.Unimplemented("Calcite has no `{probe}` probe yet")
    }
    reply(id, outcome)
}

// The `chunk` probe, with the block tags and biomes of the loaded registries.
fn chunk_with(input: own List<Member>, blobs: List<List<u8>>, loaded: Loaded) -> Outcome {
    let table = match block_states(loaded.registries) {
        ok(t) => t,
        err(message) => return Outcome.Failed(message),
    }
    let plains = match flat_blocks(loaded.registries) {
        ok(b) => b.biome,
        err(message) => return Outcome.Failed(message),
    }
    return run_chunk(input, blobs, table, plains)
}

fn reply(id: own Json, outcome: own Outcome) {
    var header: List<Member> = [
        Member { key: "type", value: Json.Str("result") },
        Member { key: "id", value: id },
    ]
    match outcome {
        Outcome.Done { output, blobs } => {
            header.push(Member { key: "status", value: Json.Str("ok") })
            header.push(Member { key: "output", value: Json.Object(output) })
            write_frame(header, blobs)
        }
        Outcome.Unimplemented(message) => {
            header.push(Member { key: "status", value: Json.Str("unimplemented") })
            header.push(Member { key: "output", value: Json.Object([]) })
            header.push(Member { key: "message", value: Json.Str(message) })
            write_frame(header, [])
        }
        Outcome.Failed(message) => {
            header.push(Member { key: "status", value: Json.Str("error") })
            header.push(Member { key: "output", value: Json.Object([]) })
            header.push(Member { key: "message", value: Json.Str(message) })
            write_frame(header, [])
        }
    }
}
