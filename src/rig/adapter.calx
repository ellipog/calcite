/// Calcite's rig adapter (rig/PROTOCOL.md): runs the probes Calcite implements on Calcite's own
/// code, so the rig can compare each result with vanilla's.
module rig.adapter

import rig.frame.{Outcome, read_frame, write_frame}
import rig.collections.{run_collections}
import rig.json.{Json, Member, as_string, take}
import rig.rng.{run_rng}

fn main() {
    loop {
        let frame = read_frame() else return
        var header = frame.header
        let kind = as_string(take(mut header, "type") ?? Json.Null) ?? String()
        if kind == "hello" {
            hello()
        } else if kind == "run" {
            run(header, frame.blobs)
        } else if kind == "bye" {
            write_frame([Member { key: "type", value: Json.Str("bye") }], [])
            return
        } else {
            let id = take(mut header, "id") ?? Json.Null
            reply(id, Outcome.Failed("unknown message type `{kind}`"))
        }
    }
}

fn hello() {
    let probes: List<Member> = [
        Member { key: "ping", value: Json.Number("1") },
        Member { key: "rng", value: Json.Number("1") },
        Member { key: "collections", value: Json.Number("1") },
    ]
    let about: List<Member> = [Member { key: "language", value: Json.Str("calx") }]
    let header: List<Member> = [
        Member { key: "type", value: Json.Str("hello") },
        Member { key: "protocol", value: Json.Number("1") },
        Member { key: "adapter", value: Json.Str("calcite") },
        Member { key: "game_version", value: Json.Str("26.3") },
        Member { key: "probes", value: Json.Object(probes) },
        Member { key: "about", value: Json.Object(about) },
    ]
    write_frame(header, [])
}

fn run(header: own List<Member>, blobs: own List<List<u8>>) {
    var h = header
    let id = take(mut h, "id") ?? Json.Null
    let probe = as_string(take(mut h, "probe") ?? Json.Null) ?? String()
    var input: List<Member> = []
    if let value = take(mut h, "input") {
        match value {
            Json.Object(members) => input = members,
            _ => {
                reply(id, Outcome.Failed("`input` must be an object"))
                return
            }
        }
    }
    let outcome = if probe == "ping" {
        let echo = take(mut input, "echo") ?? Json.Null
        Outcome.Done { output: [Member { key: "echo", value: echo }], blobs: blobs }
    } else if probe == "rng" {
        run_rng(input)
    } else if probe == "collections" {
        run_collections(input)
    } else {
        Outcome.Unimplemented("Calcite has no `{probe}` probe yet")
    }
    reply(id, outcome)
}

fn reply(id: own Json, outcome: own Outcome) {
    var header: List<Member> = [
        Member { key: "type", value: Json.Str("result") },
        Member { key: "id", value: id },
    ]
    match outcome {
        Outcome.Done { output, blobs } => {
            header.push(Member { key: "status", value: Json.Str("ok") })
            header.push(Member { key: "output", value: Json.Object(output) })
            write_frame(header, blobs)
        }
        Outcome.Unimplemented(message) => {
            header.push(Member { key: "status", value: Json.Str("unimplemented") })
            header.push(Member { key: "output", value: Json.Object([]) })
            header.push(Member { key: "message", value: Json.Str(message) })
            write_frame(header, [])
        }
        Outcome.Failed(message) => {
            header.push(Member { key: "status", value: Json.Str("error") })
            header.push(Member { key: "output", value: Json.Object([]) })
            header.push(Member { key: "message", value: Json.Str(message) })
            write_frame(header, [])
        }
    }
}
