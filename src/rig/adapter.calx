/// Calcite's rig adapter (rig/PROTOCOL.md): runs the probes Calcite implements on Calcite's own
/// code, so the rig can compare each result with vanilla's.
module rig.adapter

import chat.language.{Language}
import rig.block_entity.{run_block_entity}
import rig.datafix.{run_datafix}
import rig.frame.{Outcome, read_frame, write_frame}
import rig.biomes.{run_biomes}
import rig.chunk.{run_chunk}
import rig.chunk_nbt.{run_chunk_nbt}
import rig.level_data.{run_level_data}
import rig.collections.{run_collections}
import rig.density.{run_density}
import rig.distance.{run_distance}
import rig.entities_poi.{run_entities_poi}
import rig.features.{run_features}
import json.tree.{Json, Member, as_string, take}
import rig.levels.{run_levels}
import rig.light.{run_light}
import rig.nbt.{run_nbt}
import rig.noise.{run_noise}
import pack.vanilla.{vanilla_jar}
import pack.data.{Data}
import std.zip.{Zip}
import rig.packs.{run_packs}
import rig.palette.{run_palette}
import rig.region.{run_region}
import rig.registries.{Loaded, load_vanilla, run_registries}
import rig.math.{run_math, run_mth}
import rig.rng.{run_rng}
import rig.spawn.{run_spawn}
import rig.structures.{run_structures}
import rig.surface.{run_carvers, run_surface}
import rig.terrain.{run_terrain}
import rig.tickets.{run_tickets}
import rig.world_folder.{run_world_folder}
import rig.allow_list.{run_allow_list}
import server.play.{block_states, flat_blocks}
import storage.chunk.{ChunkFormat}
import world.states.{StateCodec}

fn main() {
    // The registries, the language, the chunk format and vanilla's data load on the first case
    // that needs them, and stay.
    var loaded: Loaded? = none
    var lang: Language? = none
    var format: ChunkFormat? = none
    var data: Zip? = none
    // The same jar as worldgen reads it.
    var gen: Data? = none
    loop {
        let frame = read_frame() else return
        var header = frame.header
        let kind = as_string(take(mut header, "type") ?? Json.Null) ?? String()
        if kind == "hello" {
            hello()
        } else if kind == "run" {
            run(header, frame.blobs, mut loaded, mut lang, mut format, mut data, mut gen)
        } else if kind == "bye" {
            write_frame([Member { key: "type", value: Json.Str("bye") }], [])
            return
        } else {
            let id = take(mut header, "id") ?? Json.Null
            reply(id, Outcome.Failed("unknown message type `{kind}`"))
        }
    }
}

fn hello() {
    let probes: List<Member> = [
        Member { key: "ping", value: Json.Number("1") },
        Member { key: "rng", value: Json.Number("1") },
        Member { key: "collections", value: Json.Number("1") },
        Member { key: "registries", value: Json.Number("2") },
        Member { key: "nbt", value: Json.Number("1") },
        Member { key: "palette", value: Json.Number("1") },
        Member { key: "chunk", value: Json.Number("1") },
        Member { key: "region", value: Json.Number("1") },
        Member { key: "chunk_nbt", value: Json.Number("1") },
        Member { key: "level_data", value: Json.Number("1") },
        Member { key: "world_folder", value: Json.Number("5") },
        Member { key: "allow_list", value: Json.Number("1") },
        Member { key: "entities_poi", value: Json.Number("1") },
        Member { key: "tickets", value: Json.Number("1") },
        Member { key: "levels", value: Json.Number("1") },
        Member { key: "distance", value: Json.Number("1") },
        Member { key: "light", value: Json.Number("1") },
        Member { key: "spawn", value: Json.Number("1") },
        Member { key: "packs", value: Json.Number("2") },
        Member { key: "noise", value: Json.Number("1") },
        Member { key: "density", value: Json.Number("1") },
        Member { key: "biomes", value: Json.Number("1") },
        Member { key: "terrain", value: Json.Number("1") },
        Member { key: "surface", value: Json.Number("1") },
        Member { key: "carvers", value: Json.Number("1") },
        Member { key: "features", value: Json.Number("4") },
        Member { key: "structures", value: Json.Number("2") },
        Member { key: "math", value: Json.Number("2") },
        Member { key: "strictmath", value: Json.Number("2") },
        Member { key: "mth", value: Json.Number("2") },
        Member { key: "datafix", value: Json.Number("1") },
        Member { key: "block_entity", value: Json.Number("1") },
    ]
    let about: List<Member> = [Member { key: "language", value: Json.Str("calx") }]
    let header: List<Member> = [
        Member { key: "type", value: Json.Str("hello") },
        Member { key: "protocol", value: Json.Number("1") },
        Member { key: "adapter", value: Json.Str("calcite") },
        Member { key: "game_version", value: Json.Str("26.3") },
        Member { key: "probes", value: Json.Object(probes) },
        Member { key: "about", value: Json.Object(about) },
    ]
    write_frame(header, [])
}

fn run(header: own List<Member>, blobs: own List<List<u8>>, loaded: mut Loaded?, lang: mut Language?, format: mut ChunkFormat?, data: mut Zip?, gen: mut Data?) {
    var h = header
    let id = take(mut h, "id") ?? Json.Null
    let probe = as_string(take(mut h, "probe") ?? Json.Null) ?? String()
    var input: List<Member> = []
    if let value = take(mut h, "input") {
        match value {
            Json.Object(members) => input = members,
            _ => {
                reply(id, Outcome.Failed("`input` must be an object"))
                return
            }
        }
    }
    let outcome = if probe == "ping" {
        let echo = take(mut input, "echo") ?? Json.Null
        Outcome.Done { output: [Member { key: "echo", value: echo }], blobs: blobs }
    } else if probe == "rng" {
        run_rng(input)
    } else if probe == "collections" {
        run_collections(input)
    } else if probe == "nbt" {
        run_nbt(input, blobs, mut lang)
    } else if probe == "block_entity" {
        run_block_entity(input)
    } else if probe == "datafix" {
        run_datafix(input, blobs)
    } else if probe == "palette" {
        run_palette(input, blobs)
    } else if probe == "region" {
        run_region(input, blobs)
    } else if probe == "level_data" {
        run_level_data(input, blobs)
    } else if probe == "world_folder" {
        run_world_folder(input, blobs)
    } else if probe == "allow_list" {
        run_allow_list(input, blobs)
    } else if probe == "tickets" {
        run_tickets(input, blobs)
    } else if probe == "levels" {
        run_levels(input, blobs)
    } else if probe == "distance" {
        run_distance(input, blobs)
    } else if probe == "light" {
        run_light(input, blobs)
    } else if probe == "noise" {
        run_noise(input, blobs)
    } else if probe == "math" or probe == "strictmath" {
        run_math(input, blobs)
    } else if probe == "mth" {
        run_mth(input, blobs)
    } else if probe == "biomes" or probe == "terrain" or probe == "surface" or probe == "carvers" or probe == "features" or probe == "structures" {
        if data == none {
            match vanilla_jar(String("oracle/jars/server-26.3.jar")) {
                ok(z) => data = some(z),
                err(message) => {
                    reply(id, Outcome.Failed(message))
                    return
                },
            }
        }
        if loaded == none {
            match load_vanilla() {
                ok(l) => loaded = some(l),
                err(message) => {
                    reply(id, Outcome.Failed(message))
                    return
                },
            }
        }
        if gen == none {
            if let z = data {
                gen = some(Data.of_zip(z.copy()))
            }
        }
        match gen {
            some(z) => match loaded {
                some(l) => if probe == "biomes" {
                    biomes_with(input, blobs, z, l)
                } else if probe == "terrain" {
                    terrain_with(input, blobs, z, l)
                } else if probe == "features" {
                    features_with(input, blobs, z, l)
                } else if probe == "structures" {
                    structures_with(input, blobs, z, l)
                } else {
                    surface_with(input, blobs, z, l, probe == "carvers")
                },
                none => Outcome.Failed(String("the registries didn't load")),
            },
            none => Outcome.Failed(String("vanilla's data didn't load")),
        }
    } else if probe == "packs" or probe == "density" {
        if data == none {
            match vanilla_jar(String("oracle/jars/server-26.3.jar")) {
                ok(z) => data = some(z),
                err(message) => {
                    reply(id, Outcome.Failed(message))
                    return
                },
            }
        }
        if probe == "density" and gen == none {
            if let z = data {
                gen = some(Data.of_zip(z.copy()))
            }
        }
        if probe == "density" {
            match gen {
                some(g) => run_density(input, blobs, g),
                none => Outcome.Failed(String("vanilla's data didn't load")),
            }
        } else {
            match data {
                some(z) => run_packs(input, blobs, z),
                none => Outcome.Failed(String("vanilla's data didn't load")),
            }
        }
    } else if probe == "registries" or probe == "chunk" or probe == "chunk_nbt" or probe == "entities_poi" or probe == "spawn" {
        if loaded == none {
            match load_vanilla() {
                ok(l) => loaded = some(l),
                err(message) => {
                    reply(id, Outcome.Failed(message))
                    return
                },
            }
        }
        match loaded {
            some(l) => if probe == "registries" {
                run_registries(input, l)
            } else if probe == "chunk" {
                chunk_with(input, blobs, l)
            } else if probe == "entities_poi" {
                run_entities_poi(input, blobs, l.registries)
            } else if probe == "spawn" {
                match block_states(l.registries) {
                    ok(table) => run_spawn(input, blobs, table),
                    err(message) => Outcome.Failed(message),
                }
            } else {
                if format == none {
                    match ChunkFormat.new(l.registries) {
                        ok(f) => format = some(f),
                        err(message) => {
                            reply(id, Outcome.Failed(message))
                            return
                        },
                    }
                }
                match format {
                    some(f) => run_chunk_nbt(input, blobs, f),
                    none => Outcome.Failed(String("the chunk format didn't load")),
                }
            },
            none => Outcome.Failed(String("the registries didn't load")),
        }
    } else {
        Outcome.Unimplemented("Calcite has no `{probe}` probe yet")
    }
    reply(id, outcome)
}

// The `biomes` probe, with vanilla's data and the loaded biome registry.
fn biomes_with(input: own List<Member>, blobs: List<List<u8>>, zip: Data, loaded: Loaded) -> Outcome {
    let b = loaded.registries.find(String("worldgen/biome")) else return Outcome.Failed(String("there's no biome registry"))
    return run_biomes(input, blobs, zip, loaded.registries.synced[b])
}

// The `terrain` probe, with vanilla's data, and the block states and block tags of the loaded
// registries.
fn terrain_with(input: own List<Member>, blobs: List<List<u8>>, zip: Data, loaded: Loaded) -> Outcome {
    let b = loaded.registries.find_builtin(String("block")) else return Outcome.Failed(String("there's no block registry"))
    let table = match block_states(loaded.registries) {
        ok(t) => t,
        err(message) => return Outcome.Failed(message),
    }
    return run_terrain(input, blobs, zip, StateCodec.new(loaded.registries.builtin[b]), table)
}

// The `surface` probe, or the `carvers` probe if `carve`, with vanilla's data, the block states
// and block tags, and the biome registry.
fn surface_with(input: own List<Member>, blobs: List<List<u8>>, zip: Data, loaded: Loaded, carve: bool) -> Outcome {
    let b = loaded.registries.find_builtin(String("block")) else return Outcome.Failed(String("there's no block registry"))
    let biomes = loaded.registries.find(String("worldgen/biome")) else return Outcome.Failed(String("there's no biome registry"))
    let table = match block_states(loaded.registries) {
        ok(t) => t,
        err(message) => return Outcome.Failed(message),
    }
    if carve {
        let uncarvable = loaded.registries.builtin[b].tag_values(String("uncarvable"))
        return run_carvers(input, blobs, zip, StateCodec.new(loaded.registries.builtin[b]), table, loaded.registries.synced[biomes], uncarvable)
    }
    return run_surface(input, blobs, zip, StateCodec.new(loaded.registries.builtin[b]), table, loaded.registries.synced[biomes])
}

// The `features` probe, with vanilla's data and the block, fluid and biome registries.
fn features_with(input: own List<Member>, blobs: List<List<u8>>, zip: Data, loaded: Loaded) -> Outcome {
    let b = loaded.registries.find_builtin(String("block")) else return Outcome.Failed(String("there's no block registry"))
    let f = loaded.registries.find_builtin(String("fluid")) else return Outcome.Failed(String("there's no fluid registry"))
    let biomes = loaded.registries.find(String("worldgen/biome")) else return Outcome.Failed(String("there's no biome registry"))
    let table = match block_states(loaded.registries) {
        ok(t) => t,
        err(message) => return Outcome.Failed(message),
    }
    let uncarvable = loaded.registries.builtin[b].tag_values(String("uncarvable"))
    return run_features(input, blobs, zip, loaded.registries.builtin[b], loaded.registries.builtin[f], loaded.registries.synced[biomes], table, uncarvable)
}

// The `structures` probe, with vanilla's data and the block, fluid and biome registries.
fn structures_with(input: own List<Member>, blobs: List<List<u8>>, zip: Data, loaded: Loaded) -> Outcome {
    let b = loaded.registries.find_builtin(String("block")) else return Outcome.Failed(String("there's no block registry"))
    let f = loaded.registries.find_builtin(String("fluid")) else return Outcome.Failed(String("there's no fluid registry"))
    let biomes = loaded.registries.find(String("worldgen/biome")) else return Outcome.Failed(String("there's no biome registry"))
    let table = match block_states(loaded.registries) {
        ok(t) => t,
        err(message) => return Outcome.Failed(message),
    }
    return run_structures(input, blobs, zip, loaded.registries.builtin[b], loaded.registries.builtin[f], loaded.registries.synced[biomes], table)
}

// The `chunk` probe, with the block tags and biomes of the loaded registries.
fn chunk_with(input: own List<Member>, blobs: List<List<u8>>, loaded: Loaded) -> Outcome {
    let table = match block_states(loaded.registries) {
        ok(t) => t,
        err(message) => return Outcome.Failed(message),
    }
    let plains = match flat_blocks(loaded.registries) {
        ok(b) => b.biome,
        err(message) => return Outcome.Failed(message),
    }
    return run_chunk(input, blobs, table, plains)
}

fn reply(id: own Json, outcome: own Outcome) {
    var header: List<Member> = [
        Member { key: "type", value: Json.Str("result") },
        Member { key: "id", value: id },
    ]
    match outcome {
        Outcome.Done { output, blobs } => {
            header.push(Member { key: "status", value: Json.Str("ok") })
            header.push(Member { key: "output", value: Json.Object(output) })
            write_frame(header, blobs)
        }
        Outcome.Unimplemented(message) => {
            header.push(Member { key: "status", value: Json.Str("unimplemented") })
            header.push(Member { key: "output", value: Json.Object([]) })
            header.push(Member { key: "message", value: Json.Str(message) })
            write_frame(header, [])
        }
        Outcome.Failed(message) => {
            header.push(Member { key: "status", value: Json.Str("error") })
            header.push(Member { key: "output", value: Json.Object([]) })
            header.push(Member { key: "message", value: Json.Str(message) })
            write_frame(header, [])
        }
    }
}
