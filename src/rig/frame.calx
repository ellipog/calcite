/// The rig's frames (rig/PROTOCOL.md): a 4-byte big-endian header length, the JSON header,
/// then the blobs the header's `blobs` field lists.
module rig.frame

import rig.json.{Json, Member, as_i32, parse_object, push_text, take, write_object}
import std.io.{flush, read_exact, write}

/// One message, its `blobs` field read and removed from the header.
pub struct Frame {
    pub header: List<Member>
    pub blobs: List<List<u8>>
}

/// What a probe gives for one case.
pub enum Outcome {
    /// The probe ran, and this is its result. A rejection by the game is a result too.
    Done { output: List<Member>, blobs: List<List<u8>> }
    /// The adapter knows the probe but not this part of it.
    Unimplemented(String)
    /// The case is wrong, or the adapter failed.
    Failed(String)
}

/// The next frame from standard input, or `none` at its end. A frame that breaks the protocol
/// panics, since nothing after it can be trusted.
pub fn read_frame() -> Frame? {
    var head: List<u8> = []
    if not read_exact(mut head, 4) {
        return none
    }
    let length = (u32(head[0]) << 24) | (u32(head[1]) << 16) | (u32(head[2]) << 8) | u32(head[3])
    var bytes: List<u8> = []
    if not read_exact(mut bytes, usize(length)) {
        panic("input ended inside a frame's header")
    }
    let text = String.from_utf8(bytes) else panic("a frame's header isn't UTF-8")
    var header = parse_object(text) else panic("a frame's header isn't a JSON object")
    var blobs: List<List<u8>> = []
    if let sizes = take(mut header, "blobs") {
        match sizes {
            Json.Array(items) => {
                for item in items {
                    let size = as_i32(item) else panic("a blob length isn't a 32-bit integer")
                    if size < 0 {
                        panic("a blob length is negative")
                    }
                    var blob: List<u8> = []
                    if not read_exact(mut blob, usize.wrap(size)) {
                        panic("input ended inside a blob")
                    }
                    blobs.push(blob)
                }
            }
            _ => panic("a frame's `blobs` isn't an array"),
        }
    }
    return some(Frame { header: header, blobs: blobs })
}

/// Writes a frame to standard output and flushes it, adding the `blobs` field.
pub fn write_frame(header: List<Member>, blobs: List<List<u8>>) {
    var text: List<u8> = []
    write_object(mut text, header)
    _ = text.pop()
    if not header.is_empty() {
        push_text(mut text, ",")
    }
    push_text(mut text, "\"blobs\":[")
    let n = blobs.len()
    for i in 0..n {
        if i > 0 {
            push_text(mut text, ",")
        }
        push_text(mut text, "{blobs[i].len()}")
    }
    push_text(mut text, "]\}")
    let length = u32.wrap(text.len())
    let prefix: List<u8> = [u8.wrap(length >> 24), u8.wrap(length >> 16), u8.wrap(length >> 8), u8.wrap(length)]
    write(prefix)
    write(text)
    for blob in blobs {
        write(blob)
    }
    flush()
}
