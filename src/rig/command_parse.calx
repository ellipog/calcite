/// The `command_parse` probe (rig/PROTOCOL.md): a command read as a dedicated server's
/// `CommandDispatcher.parse` reads it, `command.dispatcher.parse` over vanilla's tree, with the
/// vanilla data pack's registries for its arguments to look up, for a source of a permission
/// level; and the error `Commands.finishParsing` fails it with, `finish` (CAL-367).
module rig.command_parse

import command.dispatcher.{Argument, BlockNames, BlockTag, ResourceNames, Tree, Value, entity_type_names, entity_types, finish, parse}
import command.item_test.{HOLDS}
import nbt.tag.{Tag}
import json.tree.{Json, Member, as_i32, as_string, take}
import registry.components.{ItemCodecs}
import registry.loot_tables.{LootCodecs}
import registry.registries.{Registries}
import resources.identifier.{Identifier}
import rig.frame.{Outcome}
import server.commands.{registry_resource_names}
import world.states.{StateCodec}

/// The tree a case reads against: vanilla's commands, the names their resource arguments look up
/// of `r`, and the codecs their items, loot and blocks read with, made once. It reads as the
/// validation context vanilla's probe reads with: every tag there, and the reloadable registries
/// not looked up.
pub fn command_tree(r: Shared<Registries>) -> Tree {
    var t = Tree.vanilla()
    var clocks = List<Identifier>()
    if let at = r.value.find(String("world_clock")) {
        clocks = r.value.synced[at].entries.copy()
    }
    var timelines = List<Identifier>()
    if let at = r.value.find(String("timeline")) {
        timelines = r.value.synced[at].entries.copy()
    }
    var names: List<ResourceNames> = [ResourceNames { registry: String("minecraft:world_clock"), names: clocks }, ResourceNames { registry: String("minecraft:timeline"), names: timelines }, entity_type_names()]
    registry_resource_names(r.value, mut names)
    t.resources = names
    var items = ItemCodecs.new(r.copy())
    items.every_tag = true
    t.items = some(Shared(items))
    t.loot = some(Shared(LootCodecs.new(r.copy())))
    t.validating = true
    if let b = r.value.find_builtin(String("block")) {
        let states = StateCodec.new(r.value.builtin[b])
        var tags = List<BlockTag>()
        for tag in r.value.builtin[b].tags {
            tags.push(BlockTag { name: tag.name.copy(), blocks: tag.values.copy() })
        }
        t.blocks = some(Shared(BlockNames { states: states, entities: List<u32>(), tags: tags, every_tag: true }))
    }
    return t
}

/// Runs a case: `input`, the command without its `/`, and `level`, the source's permission
/// level, 0 to 4. The output is each context read, from the root and after each redirect, its
/// nodes and arguments by name with where they are, and whether it has a command; where reading
/// stopped; and the error, by its cursor, with its message as NBT, or null. What Calcite reads
/// only as the command runs, which vanilla reads here, is unimplemented, `unread`.
pub fn run_command_parse(input: own List<Member>, t: Tree) -> Outcome {
    var fields = input
    let text = as_string(take(mut fields, "input") ?? Json.Null) else return Outcome.Failed(String("`input` must be a string"))
    let level = as_i32(take(mut fields, "level") ?? Json.Null) else return Outcome.Failed(String("`level` must be a number"))
    if level < 0 or level > 4 {
        return Outcome.Failed(String("`level` must be 0 to 4"))
    }
    let p = parse(t, text, level, entity_types())
    for c in p.contexts {
        for a in c.arguments {
            if let why = unread(a) {
                return Outcome.Unimplemented(why)
            }
        }
    }
    var contexts = List<Json>()
    for c in p.contexts {
        var nodes = List<Json>()
        for n in c.nodes {
            nodes.push(read_at(t.nodes[n.node].name.copy(), n.start, n.end))
        }
        var arguments = List<Json>()
        for a in c.arguments {
            arguments.push(read_at(a.name.copy(), a.start, a.end))
        }
        let members: List<Member> = [
            Member { key: "nodes", value: Json.Array(nodes) },
            Member { key: "arguments", value: Json.Array(arguments) },
            Member { key: "command", value: Json.Bool(c.command != none) },
        ]
        contexts.push(Json.Object(members))
    }
    var output: List<Member> = [
        Member { key: "contexts", value: Json.Array(contexts) },
        Member { key: "cursor", value: number(p.reader.at) },
    ]
    match finish(p) {
        ok(_) => {
            output.push(Member { key: "error", value: Json.Null })
            return Outcome.Done { output: output, blobs: [] }
        },
        err(e) => {
            // No place in the input is -1, as `CommandSyntaxException` keeps it.
            let cursor = if e.cursor == 4294967295 { Json.Number(String("-1")) } else { number(e.cursor) }
            output.push(Member { key: "error", value: Json.Object([Member { key: "cursor", value: cursor }]) })
            var bytes = List<u8>()
            match e.message.to_nbt().write_any(mut bytes) {
                ok => {},
                err(message) => return Outcome.Failed(message),
            }
            return Outcome.Done { output: output, blobs: [bytes] }
        },
    }
}

// What of the argument `a` Calcite doesn't read as vanilla's parse does, but as the command runs:
// a feature given whole, which the generator reads (CAL-373), and a data component predicate's
// value in an item predicate, which `world.loot` tests (CAL-355).
fn unread(a: Argument) -> String? {
    if let Value.Loot(tag) = a.value {
        if a.name == "feature" {
            if let Tag.Compound(_) = tag {
                return some(String("Reading a feature given whole as place reads its arguments (CAL-373)"))
            }
        }
    }
    if let Value.ItemTest(test) = a.value {
        for terms in test.all {
            for term in terms {
                if term.kind == HOLDS {
                    return some(String("Reading a data component predicate's value in an item predicate (CAL-355)"))
                }
            }
        }
    }
    return none
}

// A node or an argument read: its name, and where it starts and ends.
fn read_at(name: own String, start: usize, end: usize) -> Json {
    return Json.Array([Json.Str(name), number(start), number(end)])
}

fn number(n: usize) -> Json {
    return Json.Number("{n}")
}
