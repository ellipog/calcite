/// The `allow_list` probe (rig/PROTOCOL.md): `allowed_symlinks.txt`, from the case's blob, read
/// by `storage.symlinks` as a server reads it as it starts, then asked about each of a list of
/// link targets, which the rig compares with what vanilla's `LevelStorageSource.parseValidator`
/// gives for the same file and targets.
module rig.allow_list

import json.tree.{Json, Member, as_string, take}
import rig.frame.{Outcome}
import server.log.{Entry, Level}
import std.fs.{remove_dir_all, separator, temp_dir, write}
import storage.symlinks.{read_allow_list}

pub fn run_allow_list(input: own List<Member>, blobs: List<List<u8>>) -> Outcome {
    var fields = input
    let paths_value = take(mut fields, "paths") else return Outcome.Failed("missing field `paths`")
    let items = match paths_value {
        Json.Array(items) => items,
        _ => return Outcome.Failed("`paths` must be an array"),
    }
    var paths = List<String>()
    for k in 0..items.len() {
        let p = as_string(items[k]) else return Outcome.Failed("path {k} must be a string")
        paths.push(p)
    }
    if blobs.len() > 1 {
        return Outcome.Failed("one blob at most, the file")
    }
    let universe = match temp_dir() {
        ok(d) => d,
        err(_) => return Outcome.Failed("no temporary folder"),
    }
    let file = "{universe}{separator()}allowed_symlinks.txt"
    var out: List<u8> = []
    var failed: String? = none
    if blobs.len() == 1 {
        match write(file, blobs[0]) {
            ok => {},
            err(_) => failed = some(String("the file wasn't written")),
        }
    }
    if failed == none {
        var lines = List<Entry>()
        var allow = read_allow_list(file, mut lines)
        put_lines(mut out, mut lines)
        for p in paths {
            let yes = allow.matches(p, mut lines)
            put_lines(mut out, mut lines)
            out.push(if yes { 1 } else { 0 })
        }
    }
    match remove_dir_all(universe) {
        ok => {},
        err(_) => return Outcome.Failed("the folder wasn't removed"),
    }
    if let message = failed {
        return Outcome.Failed(message)
    }
    return Outcome.Done { output: [], blobs: [out] }
}

// What was logged, by level and message, then forgotten.
fn put_lines(out: mut List<u8>, lines: mut List<Entry>) {
    put_i32(mut out, i32.wrap(lines.len()))
    for line in lines {
        out.push(match line.level {
            Level.Warn => 1,
            Level.Error => 2,
            _ => 0,
        })
        let bytes = line.message.to_bytes()
        put_i32(mut out, i32.wrap(bytes.len()))
        for b in bytes {
            out.push(b)
        }
    }
    lines.clear()
}

fn put_i32(out: mut List<u8>, v: i32) {
    out.push(u8.wrap(v >> 24))
    out.push(u8.wrap(v >> 16))
    out.push(u8.wrap(v >> 8))
    out.push(u8.wrap(v))
}
