/// The `chunk_nbt` probe (rig/PROTOCOL.md): `storage.chunk`'s chunks, read from the SNBT of a
/// chunk's NBT for a world of `sections` sections from `min_y` up and written back, as a chunk is
/// read from its region file and saved again. The blob is what was logged, then the NBT written,
/// or nothing if there's no chunk, or what was thrown.
module rig.chunk_nbt

import json.tree.{Json, Member, as_i32, as_string, take}
import nbt.snbt.{parse_compound}
import nbt.tag.{Tag}
import rig.frame.{Outcome}
import server.log.{Entry, Level}
import storage.chunk.{ChunkData, ChunkError, ChunkFormat}

pub fn run_chunk_nbt(input: own List<Member>, blobs: List<List<u8>>, format: ChunkFormat) -> Outcome {
    if not blobs.is_empty() {
        return Outcome.Failed("`chunk_nbt` takes no blobs")
    }
    var fields = input
    let min_y = as_i32(take(mut fields, "min_y") ?? Json.Null) else return Outcome.Failed("`min_y` must be a 32-bit integer")
    let sections = as_i32(take(mut fields, "sections") ?? Json.Null) else return Outcome.Failed("`sections` must be a 32-bit integer")
    if (min_y & 15) != 0 or min_y < -2032 or sections < 1 or i64(min_y) + i64(sections) * 16 > 2032 {
        return Outcome.Failed("`min_y` must be a multiple of 16 and the sections inside -2032 to 2032")
    }
    let snbt = as_string(take(mut fields, "snbt") ?? Json.Null) else return Outcome.Failed("`snbt` must be a string")
    let root = match parse_compound(snbt) {
        ok(Tag.Compound(tags)) => tags,
        ok(_) => return Outcome.Failed("`snbt` isn't a compound"),
        err(e) => return Outcome.Failed("`snbt` isn't a compound: {e.context()}"),
    }
    var lines = List<Entry>()
    var out = List<u8>()
    var written: List<u8>? = none
    var thrown: ChunkError? = none
    match chunk(format, min_y >> 4, sections, root, mut lines) {
        ok(bytes) => written = bytes,
        err(e) => thrown = some(e),
    }
    put_i32(mut out, i32.wrap(lines.len()))
    for line in lines {
        out.push(match line.level {
            Level.Warn => 1,
            Level.Error => 2,
            _ => 0,
        })
        put_message(mut out, line.message)
    }
    if let e = thrown {
        out.push(2)
        put_message(mut out, e.exception)
        put_message(mut out, e.message)
    } else if let bytes = written {
        out.push(1)
        put_i32(mut out, i32.wrap(bytes.len()))
        for b in bytes {
            out.push(b)
        }
    } else {
        out.push(0)
    }
    return Outcome.Done { output: [], blobs: [out] }
}

// The chunk read and written as it's saved, or `none` if there's no chunk.
fn chunk(format: ChunkFormat, min_section: i32, sections: i32, root: own JavaHashMap<String, Tag>, lines: mut List<Entry>) -> List<u8>? ! ChunkError {
    let data = try ChunkData.parse(format, min_section, sections, root, mut lines) else return none
    let tag = try data.write(format)
    var bytes = List<u8>()
    tag.write_unnamed(mut bytes)
    return some(bytes)
}

fn put_message(out: mut List<u8>, text: String) {
    let bytes = text.to_bytes()
    put_i32(mut out, i32.wrap(bytes.len()))
    for b in bytes {
        out.push(b)
    }
}

fn put_i32(out: mut List<u8>, v: i32) {
    out.push(u8.wrap(v >> 24))
    out.push(u8.wrap(v >> 16))
    out.push(u8.wrap(v >> 8))
    out.push(u8.wrap(v))
}
