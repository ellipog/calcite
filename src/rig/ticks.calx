/// The `ticks` probe (rig/PROTOCOL.md): a level's scheduled ticks in `world.ticks`, through the
/// case's operations, with the ticks each `tick` runs in the order it runs them, all to one blob,
/// as the vanilla adapter writes vanilla's own `LevelTicks` (D322).
module rig.ticks

import json.tree.{Json, Member, as_i32, as_string, take}
import rig.frame.{Outcome}
import storage.chunk.{SavedTick}
import world.pos.{ChunkPos}
import world.ticks.{ChunkTicks, LevelTicks, ScheduledTick}

pub fn run_ticks(input: own List<Member>, blobs: List<List<u8>>) -> Outcome {
    if not blobs.is_empty() {
        return Outcome.Failed("`ticks` takes no blobs")
    }
    var fields = input
    let value = take(mut fields, "ops") else return Outcome.Failed("missing field `ops`")
    let ops = match value {
        Json.Array(items) => items,
        _ => return Outcome.Failed("`ops` must be an array"),
    }
    var level = LevelTicks.new()
    // The chunks with ticks, in the order they were added, as the adapter keeps them.
    var chunks = List<i64>()
    var out = List<u8>()
    var error = String()
    for i in 0..ops.len() {
        if not run_op(mut level, mut chunks, ops, i, mut out, mut error) {
            return Outcome.Failed(error)
        }
    }
    return Outcome.Done { output: [], blobs: [out] }
}

// Runs operation `i`, writing what it gives to `out`, or gives `false` with the error if the case
// doesn't say it as the probe does.
fn run_op(level: mut LevelTicks, chunks: mut List<i64>, ops: List<Json>, i: usize, out: mut List<u8>, error: mut String) -> bool {
    let items = match ops[i] {
        Json.Array(items) => items.copy(),
        _ => {
            error = "operation {i} must be a non-empty array"
            return false
        },
    }
    if items.is_empty() {
        error = "operation {i} must be a non-empty array"
        return false
    }
    let name = as_string(items[0]) else {
        error = "operation {i}'s name must be a string"
        return false
    }
    if name == "add" {
        if not expect(items, i, 3, mut error) {
            return false
        }
        let x = int_of(items, i, 1, mut error) else return false
        let z = int_of(items, i, 2, mut error) else return false
        let k = ChunkPos { x: x, z: z }.pack()
        let ticks = match items[3] {
            Json.Null => ChunkTicks.new(),
            _ => {
                let saved = saved_of(items, i, mut error) else return false
                ChunkTicks.saved(saved)
            },
        }
        forget(mut chunks, k)
        chunks.push(k)
        level.add_container(k, ticks)
    } else if name == "remove" {
        if not expect(items, i, 2, mut error) {
            return false
        }
        let x = int_of(items, i, 1, mut error) else return false
        let z = int_of(items, i, 2, mut error) else return false
        let k = ChunkPos { x: x, z: z }.pack()
        forget(mut chunks, k)
        _ = level.remove_container(k)
    } else if name == "schedule" {
        if not expect(items, i, 7, mut error) {
            return false
        }
        let kind = kind_of(items, i, 1, mut error) else return false
        let x = int_of(items, i, 2, mut error) else return false
        let y = int_of(items, i, 3, mut error) else return false
        let z = int_of(items, i, 4, mut error) else return false
        let trigger = long_of(items, i, 5, mut error) else return false
        let priority = int_of(items, i, 6, mut error) else return false
        let sub = long_of(items, i, 7, mut error) else return false
        _ = level.schedule(ScheduledTick { kind: kind, x: x, y: y, z: z, trigger: trigger, priority: clamped(priority), sub: sub })
    } else if name == "unpack" or name == "pack" {
        if not expect(items, i, 3, mut error) {
            return false
        }
        let x = int_of(items, i, 1, mut error) else return false
        let z = int_of(items, i, 2, mut error) else return false
        let time = long_of(items, i, 3, mut error) else return false
        let k = ChunkPos { x: x, z: z }.pack()
        if not level.has_container(k) {
            error = "operation {i}: that chunk has no ticks"
            return false
        }
        if name == "unpack" {
            level.unpack(k, time)
        } else {
            let saved = level.pack(k, time) ?? List<SavedTick>()
            put_i32(mut out, i32.wrap(saved.len()))
            for t in saved {
                put_i32(mut out, i32.wrap(t.kind))
                put_i32(mut out, t.x)
                put_i32(mut out, t.y)
                put_i32(mut out, t.z)
                put_i32(mut out, t.delay)
                put_i32(mut out, t.priority)
            }
        }
    } else if name == "has" {
        if not expect(items, i, 4, mut error) {
            return false
        }
        let kind = kind_of(items, i, 1, mut error) else return false
        let x = int_of(items, i, 2, mut error) else return false
        let y = int_of(items, i, 3, mut error) else return false
        let z = int_of(items, i, 4, mut error) else return false
        out.push(if level.has(kind, x, y, z) { 1 } else { 0 })
    } else if name == "count" {
        if not expect(items, i, 0, mut error) {
            return false
        }
        put_i32(mut out, i32.wrap(level.count()))
    } else if name == "tick" {
        if not expect(items, i, 3, mut error) {
            return false
        }
        let time = long_of(items, i, 1, mut error) else return false
        let max = int_of(items, i, 2, mut error) else return false
        let ticking = ticking_of(items, i, mut error) else return false
        let ran = level.collect(time, usize.wrap(max.max(0)), ticking)
        put_i32(mut out, i32.wrap(ran.len()))
        for t in ran {
            put_i32(mut out, i32.wrap(t.kind))
            put_i32(mut out, t.x)
            put_i32(mut out, t.y)
            put_i32(mut out, t.z)
        }
    } else if name == "dump" {
        if not expect(items, i, 0, mut error) {
            return false
        }
        dump(level, chunks, mut out)
    } else {
        error = "operation {i}: no operation `{name}`"
        return false
    }
    return true
}

// The times each chunk's first tick is due at, in the table's order, an `int` count and each
// chunk and time as `long`s; then each chunk with ticks, in the order they were added, as its
// chunk, its ticks scheduled in its queue's order, an `int` count and each tick, and its count.
fn dump(level: LevelTicks, chunks: List<i64>, out: mut List<u8>) {
    let next = level.next_ticks()
    put_i32(mut out, i32.wrap(next.len()))
    for (k, at) in next {
        put_i64(mut out, k)
        put_i64(mut out, at)
    }
    put_i32(mut out, i32.wrap(chunks.len()))
    for k in chunks {
        put_i64(mut out, k)
        let queue = level.scheduled(k)
        put_i32(mut out, i32.wrap(queue.len()))
        for t in queue {
            put_i32(mut out, i32.wrap(t.kind))
            put_i32(mut out, t.x)
            put_i32(mut out, t.y)
            put_i32(mut out, t.z)
            put_i64(mut out, t.trigger)
            put_i32(mut out, t.priority)
            put_i64(mut out, t.sub)
        }
        put_i32(mut out, i32.wrap(level.count_in(k)))
    }
}

// Takes `k` out of `chunks`, if it's there.
fn forget(chunks: mut List<i64>, k: i64) {
    var kept = List<i64>()
    for c in chunks {
        if c != k {
            kept.push(c)
        }
    }
    chunks = kept
}

// A priority as `TickPriority.byValue` takes it: those past either end are the end.
fn clamped(priority: i32) -> i32 {
    return priority.max(-3).min(3)
}

fn expect(items: List<Json>, i: usize, n: usize, error: mut String) -> bool {
    if items.len() == n + 1 {
        return true
    }
    error = "operation {i} takes {n} arguments"
    return false
}

fn int_of(items: List<Json>, i: usize, k: usize, error: mut String) -> i32? {
    if let v = as_i32(items[k]) {
        return some(v)
    }
    error = "operation {i}'s argument {k} must be a 32-bit integer"
    return none
}

// A `long`, given as its decimal string.
fn long_of(items: List<Json>, i: usize, k: usize, error: mut String) -> i64? {
    if let text = as_string(items[k]) {
        if let v = i64.parse(text) {
            return some(v)
        }
    }
    error = "operation {i}'s argument {k} must be a string holding a 64-bit integer"
    return none
}

fn kind_of(items: List<Json>, i: usize, k: usize, error: mut String) -> u32? {
    let v = int_of(items, i, k, mut error) else return none
    if v < 0 or v > 127 {
        error = "operation {i}: a kind is 0 to 127"
        return none
    }
    return some(u32.wrap(v))
}

// The saved ticks of an `add`, each `[kind, x, y, z, delay, priority]`.
fn saved_of(items: List<Json>, i: usize, error: mut String) -> List<SavedTick>? {
    let list = match items[3] {
        Json.Array(list) => list.copy(),
        _ => {
            error = "operation {i}'s saved ticks must be an array or null"
            return none
        },
    }
    var out = List<SavedTick>()
    for t in list {
        let n = match t {
            Json.Array(n) => n.copy(),
            _ => {
                error = "operation {i}'s saved ticks each take 6 numbers"
                return none
            },
        }
        if n.len() != 6 {
            error = "operation {i}'s saved ticks each take 6 numbers"
            return none
        }
        var v = List<i32>()
        for e in n {
            let x = as_i32(e) else {
                error = "operation {i}'s saved ticks each take 6 numbers"
                return none
            }
            v.push(x)
        }
        if v[0] < 0 or v[0] > 127 {
            error = "operation {i}: a kind is 0 to 127"
            return none
        }
        out.push(SavedTick { kind: u32.wrap(v[0]), x: v[1], y: v[2], z: v[3], delay: v[4], priority: clamped(v[5]) })
    }
    return some(out)
}

// The chunks a `tick` says tick, each `[x, z]`.
fn ticking_of(items: List<Json>, i: usize, error: mut String) -> OpenHashSet<i64>? {
    let list = match items[3] {
        Json.Array(list) => list.copy(),
        _ => {
            error = "operation {i}'s ticking chunks must be an array"
            return none
        },
    }
    var out = OpenHashSet<i64>()
    for c in list {
        let xz = match c {
            Json.Array(xz) => xz.copy(),
            _ => {
                error = "operation {i}'s ticking chunks must each be [x, z]"
                return none
            },
        }
        if xz.len() != 2 {
            error = "operation {i}'s ticking chunks must each be [x, z]"
            return none
        }
        let x = as_i32(xz[0]) else {
            error = "operation {i}'s ticking chunks must each be [x, z]"
            return none
        }
        let z = as_i32(xz[1]) else {
            error = "operation {i}'s ticking chunks must each be [x, z]"
            return none
        }
        out.insert(ChunkPos { x: x, z: z }.pack())
    }
    return some(out)
}

fn put_i32(out: mut List<u8>, v: i32) {
    out.push(u8.wrap(v >> 24))
    out.push(u8.wrap(v >> 16))
    out.push(u8.wrap(v >> 8))
    out.push(u8.wrap(v))
}

fn put_i64(out: mut List<u8>, v: i64) {
    put_i32(mut out, i32.wrap(v >> 32))
    put_i32(mut out, i32.wrap(v))
}
