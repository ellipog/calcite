/// The `stats` probe (CAL-164): a player's statistics as `world.stats` keeps them, read from the
/// case's `json` as a player's file is read as they join, then its `ops` run in turn, `award`,
/// `mark_all_dirty`, `send` and `save`, each as vanilla's adapter runs it on `ServerStatsCounter`.
module rig.stats

import json.strict.{parse_strict}
import json.tree.{Json, Member, as_i32, as_string, take}
import registry.components.{ItemCodecs}
import rig.frame.{Outcome}
import server.log.{Entry, Level}
import storage.progress.{Kind, ProgressFiles}
import world.stats.{PlayerStats, registry_of, stat_ids}

pub fn run_stats(input: own List<Member>, items: Shared<ItemCodecs>) -> Outcome {
    var i = input
    let codecs = items.value.copy()
    var json: Json? = none
    if let given = take(mut i, "json") {
        let text = as_string(given) else return Outcome.Failed(String("`json` must be a string"))
        match parse_strict(text.to_bytes()) {
            ok(j) => json = some(j),
            err(_) => return Outcome.Failed(String("`json` isn't JSON")),
        }
    }
    var lines = List<Entry>()
    // Where the player's file is, as vanilla's adapter names it without its folder.
    var stats = PlayerStats.loaded(codecs.copy(), json, String("players/stats/player.json"), mut lines)
    var output = List<Member>()
    output.push(Member { key: String("lines"), value: shown(mut lines) })
    let ops = match take(mut i, "ops") {
        some(Json.Array(a)) => a,
        none => List<Json>(),
        _ => return Outcome.Failed(String("`ops` must be a list")),
    }
    var results = List<Json>()
    for k in 0..ops.len() {
        let Json.Array(op) = ops[k] else return Outcome.Failed("operation {k} isn't a list with its name first")
        if op.is_empty() {
            return Outcome.Failed("operation {k} isn't a list with its name first")
        }
        let name = as_string(op[0].copy()) ?? String()
        if name == "award" {
            if op.len() != 4 {
                return Outcome.Failed("operation {k}: `award` takes a type, a value and a count")
            }
            let kind = as_string(op[1].copy()) ?? String()
            let value = as_string(op[2].copy()) ?? String()
            let by = as_i32(op[3].copy()) else return Outcome.Failed("operation {k}: the count isn't an int")
            if registry_of(kind.copy()) == none or stat_ids(codecs.copy(), kind.copy(), value.copy()) == none {
                return Outcome.Failed("operation {k}: no stat `{kind}` `{value}`")
            }
            stats.award(kind, value, by)
        } else if name == "mark_all_dirty" {
            stats.mark_all_dirty()
        } else if name == "send" {
            var sent = List<Json>()
            for c in stats.take_dirty() {
                sent.push(Json.Array([Json.Str(c.kind.copy()), Json.Str(c.value.copy()), Json.Number("{c.count}")]))
            }
            results.push(Json.Object([Member { key: String("sent"), value: Json.Array(sent) }]))
        } else if name == "save" {
            let files = ProgressFiles.at(Kind.Stats, String("players/stats"))
            let text = files.text(stats.to_json())
            var none_logged = List<Entry>()
            results.push(Json.Object([
                Member { key: String("saved"), value: Json.Str(text) },
                Member { key: String("lines"), value: shown(mut none_logged) },
            ]))
        } else {
            return Outcome.Failed("operation {k}: no operation `{name}`")
        }
    }
    output.push(Member { key: String("results"), value: Json.Array(results) })
    return Outcome.Done { output: output, blobs: [] }
}

// The lines logged, each its level and its message, as vanilla's adapter gives them.
fn shown(lines: mut List<Entry>) -> Json {
    var out = List<Json>()
    for e in lines {
        let level = match e.level {
            Level.Info => "INFO",
            Level.Warn => "WARN",
            Level.Error => "ERROR",
        }
        out.push(Json.Str("{level} {e.message}"))
    }
    lines.clear()
    return Json.Array(out)
}
