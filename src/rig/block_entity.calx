/// The `block_entity` probe (rig/PROTOCOL.md): a block entity loaded from data and saved again, as
/// `worldgen.block_entities.loaded` gives what a structure template's block entities save, with
/// their items read against the vanilla data pack's registries (D367).
module rig.block_entity

import json.tree.{Json, Member, as_string, take}
import nbt.snbt.{parse_compound}
import nbt.tag.{Tag}
import registry.components.{ItemCodecs}
import rig.frame.{Outcome}
import worldgen.block_entities.{loaded}

/// Runs a case: `id` is the block entity's type, `snbt` its data.
pub fn run_block_entity(input: own List<Member>, items: Shared<ItemCodecs>) -> Outcome {
    var i = input
    let id = as_string(take(mut i, "id") ?? Json.Null) else return Outcome.Failed(String("`id` must be a string"))
    let text = as_string(take(mut i, "snbt") ?? Json.Null) else return Outcome.Failed(String("`snbt` must be a string"))
    let data = match parse_compound(text) {
        ok(Tag.Compound(m)) => m,
        _ => return Outcome.Failed(String("`snbt` doesn't parse")),
    }
    return match loaded(id, data, some(items.copy())) {
        ok(saved) => Outcome.Done { output: [Member { key: "snbt", value: Json.Str(Tag.Compound(saved).to_snbt()) }], blobs: [] },
        err(why) => Outcome.Unimplemented(why),
    }
}
