/// The `distance` probe (rig/PROTOCOL.md): `world.distance`' manager, with its tickets, its
/// trackers, its player ticket dispatcher and its holders, through the case's operations, each
/// result written to one blob, as the vanilla adapter runs vanilla's own `DistanceManager`. The
/// dispatcher's jobs and the main thread's tasks run when the case says, as the adapter runs
/// vanilla's two executors by hand.
module rig.distance

import json.tree.{Json, Member, as_i32, as_string, take}
import rig.frame.{Outcome}
import world.distance.{DistanceManager, Holder, Nearby}
import world.pos.{ChunkPos}
import world.tickets.{Ticket, TicketStorage, TicketType}

pub fn run_distance(input: own List<Member>, blobs: List<List<u8>>) -> Outcome {
    if not blobs.is_empty() {
        return Outcome.Failed("`distance` takes no blobs")
    }
    var fields = input
    let value = take(mut fields, "ops") else return Outcome.Failed("missing field `ops`")
    let ops = match value {
        Json.Array(items) => items,
        _ => return Outcome.Failed("`ops` must be an array"),
    }
    var dm = DistanceManager.new(TicketStorage.new())
    // The players the case has named, as the adapter makes one the first time it's named.
    var players = Set<i32>()
    var out = List<u8>()
    for k in 0..ops.len() {
        match run_op(mut dm, mut players, ops, k, mut out) {
            ok => {},
            err(message) => return Outcome.Failed(message),
        }
    }
    return Outcome.Done { output: [], blobs: [out] }
}

fn run_op(dm: mut DistanceManager, players: mut Set<i32>, ops: List<Json>, k: usize, out: mut List<u8>) ! String {
    let items = try items_of(ops, k)
    let name = as_string(items[0]) ?? String()
    if name == "player" {
        try expect(items, k, 3)
        let player = try int_of(items, k, 1)
        players.insert(player)
        dm.add_player(try chunk_of(items, k, 2), player)
    } else if name == "unplayer" {
        try expect(items, k, 3)
        let player = try int_of(items, k, 1)
        if not players.contains(player) {
            fail "operation {k}: no player {player}"
        }
        dm.remove_player(try chunk_of(items, k, 2), player)
    } else if name == "view" {
        try expect(items, k, 1)
        dm.update_player_tickets(try int_of(items, k, 1))
    } else if name == "simulation" {
        try expect(items, k, 1)
        dm.update_simulation_distance(try int_of(items, k, 1))
    } else if name == "ticket" or name == "unticket" {
        try expect(items, k, 4)
        let kind = try type_of(items, k, 1)
        let ticket = Ticket.new(kind, try int_of(items, k, 2))
        let chunk = try chunk_of(items, k, 3)
        put_bool(mut out, if name == "ticket" { dm.add_ticket(chunk, ticket) } else { dm.remove_ticket(chunk, ticket) })
    } else if name == "update" {
        try expect(items, k, 0)
        put_bool(mut out, dm.run_all_updates())
    } else if name == "promote" {
        try expect(items, k, 0)
        put_bool(mut out, dm.promote())
    } else if name == "dispatch" or name == "main" {
        try expect(items, k, 1)
        let most = try int_of(items, k, 1)
        var ran = 0
        while ran < most and (if name == "dispatch" { dm.run_dispatcher() } else { dm.run_main() }) {
            ran += 1
        }
        put_i32(mut out, ran)
    } else if name == "ready" {
        try expect(items, k, 2)
        put_bool(mut out, dm.entity_ticking_ready(try chunk_of(items, k, 1)))
    } else if name == "ready_first" {
        try expect(items, k, 1)
        let most = try int_of(items, k, 1)
        var readied = 0
        for chunk in dm.holder_chunks() {
            if readied >= most {
                break
            }
            if dm.entity_ticking_ready(chunk) {
                readied += 1
            }
        }
        put_i32(mut out, readied)
    } else if name == "drop" {
        try expect(items, k, 0)
        let moved = dm.drop_unloaded()
        put_i32(mut out, i32.wrap(moved.len()))
        for chunk in moved {
            put_i64(mut out, chunk)
        }
    } else if name == "unload" {
        try expect(items, k, 1)
        let most = try int_of(items, k, 1)
        var ran = 0
        while ran < most and dm.unload_next() {
            ran += 1
        }
        put_i32(mut out, ran)
    } else if name == "nearby" {
        try expect(items, k, 2)
        let nearby = dm.players_nearby(try chunk_of(items, k, 1))
        out.push(match nearby {
            Nearby.Yes => 0,
            Nearby.Check => 1,
            Nearby.No => 2,
        })
    } else if name == "spawn_count" {
        try expect(items, k, 0)
        put_i32(mut out, i32.wrap(dm.natural_spawn_chunk_count()))
    } else if name == "brief" or name == "dump" {
        try expect(items, k, 0)
        dump(dm, mut out, name == "dump")
    } else {
        fail "operation {k}: no operation `{name}`"
    }
}

// What the manager, its dispatcher and the holders keep, each table in its order, and if
// `full`, the trackers' levels too.
fn dump(dm: DistanceManager, out: mut List<u8>, full: bool) {
    let updating = dm.holder_chunks()
    put_i32(mut out, i32.wrap(updating.len()))
    for chunk in updating {
        let h = dm.holder(chunk) ?? Holder { serial: 0, ticket_level: 0 }
        put_holder(mut out, chunk, h)
    }
    let pending = dm.unloading_chunks()
    put_i32(mut out, i32.wrap(pending.len()))
    for chunk in pending {
        let h = dm.unloading(chunk) ?? Holder { serial: 0, ticket_level: 0 }
        put_holder(mut out, chunk, h)
    }
    put_longs(mut out, dm.dropping_chunks())
    put_i32(mut out, i32.wrap(dm.unloads_queued()))
    put_bool(mut out, dm.holders_modified())
    put_longs(mut out, dm.releasing_chunks())
    put_bool(mut out, dm.dispatcher_sleeping())
    put_longs(mut out, dm.executing_chunks())
    let top = dm.task_queue_top()
    put_i32(mut out, top)
    for level in 0..46 {
        let at = dm.queued_tasks(level)
        if at.is_empty() {
            continue
        }
        put_i32(mut out, level)
        put_pairs(mut out, at)
    }
    put_i32(mut out, -1)
    for n in dm.queued_jobs() {
        put_i32(mut out, i32.wrap(n))
    }
    let chunks = dm.tickets.chunks()
    put_i32(mut out, i32.wrap(chunks.len()))
    for chunk in chunks {
        let tickets = dm.tickets.tickets_at(chunk)
        put_i64(mut out, chunk)
        put_i32(mut out, i32.wrap(tickets.len()))
        for t in tickets {
            out.push(u8(t.kind))
            put_i32(mut out, t.level)
            put_i64(mut out, t.ticks_left)
        }
    }
    put_text(mut out, dm.debug_status())
    if not full {
        return
    }
    put_pairs(mut out, dm.simulation_levels())
    put_pairs(mut out, dm.spawn_distances())
    put_pairs(mut out, dm.player_distances())
    put_pairs(mut out, dm.queued_levels())
    put_i32(mut out, dm.view_distance())
    put_i32(mut out, dm.simulation_distance())
}

// A holder: its chunk, its ticket level, where its chunk is in ticking its entities, and how
// many releases wait for that.
fn put_holder(out: mut List<u8>, chunk: i64, h: Holder) {
    put_i64(mut out, chunk)
    put_i32(mut out, h.ticket_level)
    out.push(u8(h.ticking))
    put_i32(mut out, h.waiting)
}

// --- reading operations -------------------------------------------------------------------------

fn items_of(ops: List<Json>, k: usize) -> List<Json> ! String {
    match ops[k] {
        Json.Array(items) => {
            if not items.is_empty() and as_string(items[0]) != none {
                return items.copy()
            }
        },
        _ => {},
    }
    fail "operation {k} must be a non-empty array named by a string"
}

fn expect(items: List<Json>, k: usize, n: usize) ! String {
    if items.len() != n + 1 {
        fail "operation {k} takes {n} arguments"
    }
}

fn int_of(items: List<Json>, k: usize, i: usize) -> i32 ! String {
    let n = as_i32(items[i]) else fail "operation {k}'s argument {i} must be a 32-bit integer"
    return n
}

// Arguments `i` and `i + 1`, a chunk's `x` and `z`, packed.
fn chunk_of(items: List<Json>, k: usize, i: usize) -> i64 ! String {
    let x = try int_of(items, k, i)
    let z = try int_of(items, k, i + 1)
    return ChunkPos { x: x, z: z }.pack()
}

// Argument `i`, a ticket type, by its name without `minecraft:`.
fn type_of(items: List<Json>, k: usize, i: usize) -> TicketType ! String {
    let name = as_string(items[i]) else fail "operation {k}'s ticket type must be a string"
    for n in 0..9 {
        if let kind = TicketType.try_from(u8.wrap(n)) {
            if name == String(kind.name()) {
                return kind
            }
        }
    }
    fail "operation {k}: no ticket type `{name}`"
}

// --- writing results ----------------------------------------------------------------------------

fn put_bool(out: mut List<u8>, b: bool) {
    out.push(if b { 1 } else { 0 })
}

fn put_i32(out: mut List<u8>, v: i32) {
    out.push(u8.wrap(v >> 24))
    out.push(u8.wrap(v >> 16))
    out.push(u8.wrap(v >> 8))
    out.push(u8.wrap(v))
}

fn put_i64(out: mut List<u8>, v: i64) {
    put_i32(mut out, i32.wrap(v >> 32))
    put_i32(mut out, i32.wrap(v))
}

// A count, then each chunk.
fn put_longs(out: mut List<u8>, chunks: List<i64>) {
    put_i32(mut out, i32.wrap(chunks.len()))
    for c in chunks {
        put_i64(mut out, c)
    }
}

// A count, then each chunk and its number.
fn put_pairs(out: mut List<u8>, pairs: List<(i64, i32)>) {
    put_i32(mut out, i32.wrap(pairs.len()))
    for p in pairs {
        let (chunk, n) = p
        put_i64(mut out, chunk)
        put_i32(mut out, n)
    }
}

// An `int` length, then the text in UTF-8.
fn put_text(out: mut List<u8>, text: String) {
    let bytes = text.to_bytes()
    put_i32(mut out, i32.wrap(bytes.len()))
    for b in bytes {
        out.push(b)
    }
}
