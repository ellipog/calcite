/// The `rng` probe (rig/PROTOCOL.md): a sequence of operations on one of vanilla's random
/// sources, each result written to one blob.
module rig.rng

import random.legacy.{LegacyPositional, LegacyRandom}
import random.source.{Bits, RandomSource}
import random.worldgen.{WorldgenRandom}
import random.xoroshiro.{XoroshiroPositional, XoroshiroRandom}
import rig.frame.{Outcome}
import json.tree.{Json, Member, as_i32, as_string, take}

/// The source the operations run on. `single_threaded` is `Legacy`, since it gives the same
/// numbers.
enum Source {
    Legacy(LegacyRandom)
    Xoroshiro(XoroshiroRandom)
    WorldLegacy(WorldgenRandom<LegacyRandom>)
    WorldXoroshiro(WorldgenRandom<XoroshiroRandom>)
}

enum Positional {
    Legacy(LegacyPositional)
    Xoroshiro(XoroshiroPositional)
}

/// One operation, its arguments read.
enum Op {
    NextInt
    NextIntBelow(i32)
    NextIntRange(i32, i32)
    NextIntBetween(i32, i32)
    NextLong
    NextBoolean
    NextFloat
    NextDouble
    NextGaussian
    Triangle(f64, f64)
    SetSeed(i64)
    Consume(i32)
    Fork
    At(i32, i32, i32)
    FromHashOf(String)
    FromSeed(i64)
    DecorationSeed(i64, i32, i32)
    FeatureSeed(i64, i32, i32)
    LargeFeatureSeed(i64, i32, i32)
    LargeFeatureWithSalt(i64, i32, i32, i32)
}

/// What an operation did.
enum Step {
    /// It ran, and the operations go on with this source.
    Next(Source)
    /// The game threw `IllegalArgumentException` with this message.
    Threw(String)
    /// It doesn't apply to this source.
    Wrong
}

pub fn run_rng(input: own List<Member>) -> Outcome {
    var fields = input
    var error = String()
    let source = create(mut fields, mut error) else return Outcome.Failed(error)
    let ops_value = take(mut fields, "ops") else return Outcome.Failed("missing field `ops`")
    let ops = match ops_value {
        Json.Array(items) => items,
        _ => return Outcome.Failed("`ops` must be an array"),
    }
    var current = source
    var out: List<u8> = []
    let n = ops.len()
    for i in 0..n {
        let op = parse_op(ops[i], i, mut error) else return Outcome.Failed(error)
        match apply(current, op, mut out) {
            Step.Next(next) => current = next,
            Step.Threw(message) => {
                let output: List<Member> = [
                    Member { key: "exception", value: Json.Str("IllegalArgumentException") },
                    Member { key: "error", value: Json.Str(message) },
                    Member { key: "at", value: Json.Number("{i}") },
                ]
                return Outcome.Done { output: output, blobs: [out] }
            }
            Step.Wrong => {
                let name = name_of(ops[i])
                return Outcome.Failed("operation {i}: `{name}` needs a worldgen source")
            }
        }
    }
    return Outcome.Done { output: [], blobs: [out] }
}

fn create(fields: mut List<Member>, error: mut String) -> Source? {
    let kind = string_field(mut fields, "kind", mut error) else return none
    if kind == "xoroshiro128" {
        let lo = long_field(mut fields, "seed_lo", mut error) else return none
        let hi = long_field(mut fields, "seed_hi", mut error) else return none
        return some(Source.Xoroshiro(XoroshiroRandom.of(lo, hi)))
    }
    let seed = long_field(mut fields, "seed", mut error) else return none
    return match kind {
        "legacy" | "single_threaded" => some(Source.Legacy(LegacyRandom.new(seed))),
        "xoroshiro" => some(Source.Xoroshiro(XoroshiroRandom.new(seed))),
        "worldgen_legacy" => some(Source.WorldLegacy(WorldgenRandom.new(LegacyRandom.new(seed)))),
        "worldgen_xoroshiro" => some(Source.WorldXoroshiro(WorldgenRandom.new(XoroshiroRandom.new(seed)))),
        _ => {
            error = "unknown kind `{kind}`"
            none
        }
    }
}

fn string_field(fields: mut List<Member>, name: String, error: mut String) -> String? {
    if let value = take(mut fields, name) {
        if let s = as_string(value) {
            return some(s)
        }
        error = "`{name}` must be a string"
        return none
    }
    error = "missing field `{name}`"
    return none
}

/// A 64-bit field, which the protocol writes as a decimal string.
fn long_field(fields: mut List<Member>, name: String, error: mut String) -> i64? {
    let text = string_field(mut fields, name, mut error) else return none
    if let v = i64.parse(text) {
        return some(v)
    }
    error = "`{name}` must be a decimal 64-bit integer"
    return none
}

// --- reading operations -------------------------------------------------------------------------

/// The name of an operation that parsed, so its first element is a string.
fn name_of(item: Json) -> String {
    return match item {
        Json.Array(items) => as_string(items[0]) ?? String(),
        _ => String(),
    }
}

fn parse_op(item: Json, index: usize, error: mut String) -> Op? {
    match item {
        Json.Array(items) => {
            if not items.is_empty() {
                return op_from(items, index, mut error)
            }
        }
        _ => {}
    }
    error = "operation {index} must be a non-empty array"
    return none
}

fn op_from(items: List<Json>, index: usize, error: mut String) -> Op? {
    let name = as_string(items[0]) else {
        error = "operation {index}'s name must be a string"
        return none
    }
    let arity = items.len() - 1
    let want: usize = match name {
        "nextInt" => if arity == 0 { 0 } else { 1 },
        "nextLong" | "nextBoolean" | "nextFloat" | "nextDouble" | "nextGaussian" | "fork" => 0,
        "setSeed" | "consume" | "fromHashOf" | "fromSeed" => 1,
        "nextIntRange" | "nextIntBetween" | "triangle" => 2,
        "at" | "setDecorationSeed" | "setFeatureSeed" | "setLargeFeatureSeed" => 3,
        "setLargeFeatureWithSalt" => 4,
        _ => {
            error = "operation {index}: unknown `{name}`"
            return none
        }
    }
    if arity != want {
        error = "operation {index}: `{name}` takes {want} arguments, got {arity}"
        return none
    }
    // The arguments, read in order so that the first bad one is the one reported: a seed or
    // the triangle's doubles or a name first, then the ints.
    var long: i64 = 0
    var doubles: [f64; 2] = [0.0; 2]
    var text = String()
    var k: usize = 1
    let seeded = match name {
        "setSeed" | "fromSeed" | "setDecorationSeed" | "setFeatureSeed" | "setLargeFeatureSeed" | "setLargeFeatureWithSalt" => true,
        _ => false,
    }
    if seeded {
        let seed = long_arg(items, 1, index, mut error) else return none
        long = seed
        k = 2
    } else if name == "triangle" {
        let mean = double_arg(items, 1, index, mut error) else return none
        let spread = double_arg(items, 2, index, mut error) else return none
        doubles = [mean, spread]
        k = 3
    } else if name == "fromHashOf" {
        let given = string_arg(items, 1, index, mut error) else return none
        text = given
        k = 2
    }
    var ints: [i32; 3] = [0; 3]
    var count: usize = 0
    while k <= arity {
        let v = int_arg(items, k, index, mut error) else return none
        ints[count] = v
        count += 1
        k += 1
    }
    let op = match name {
        "nextInt" => if arity == 0 { Op.NextInt } else { Op.NextIntBelow(ints[0]) },
        "nextIntRange" => Op.NextIntRange(ints[0], ints[1]),
        "nextIntBetween" => Op.NextIntBetween(ints[0], ints[1]),
        "nextLong" => Op.NextLong,
        "nextBoolean" => Op.NextBoolean,
        "nextFloat" => Op.NextFloat,
        "nextDouble" => Op.NextDouble,
        "nextGaussian" => Op.NextGaussian,
        "triangle" => Op.Triangle(doubles[0], doubles[1]),
        "setSeed" => Op.SetSeed(long),
        "consume" => Op.Consume(ints[0]),
        "fork" => Op.Fork,
        "at" => Op.At(ints[0], ints[1], ints[2]),
        "fromHashOf" => Op.FromHashOf(text),
        "fromSeed" => Op.FromSeed(long),
        "setDecorationSeed" => Op.DecorationSeed(long, ints[0], ints[1]),
        "setFeatureSeed" => Op.FeatureSeed(long, ints[0], ints[1]),
        "setLargeFeatureSeed" => Op.LargeFeatureSeed(long, ints[0], ints[1]),
        _ => Op.LargeFeatureWithSalt(long, ints[0], ints[1], ints[2]),
    }
    return some(op)
}

fn int_arg(items: List<Json>, k: usize, index: usize, error: mut String) -> i32? {
    let is_number = match items[k] {
        Json.Number(_) => true,
        _ => false,
    }
    if not is_number {
        error = "operation {index} argument {k} must be a number"
        return none
    }
    if let v = as_i32(items[k]) {
        return some(v)
    }
    error = "operation {index} argument {k} must be a 32-bit integer"
    return none
}

fn string_arg(items: List<Json>, k: usize, index: usize, error: mut String) -> String? {
    if let s = as_string(items[k]) {
        return some(s)
    }
    error = "operation {index} argument {k} must be a string"
    return none
}

fn long_arg(items: List<Json>, k: usize, index: usize, error: mut String) -> i64? {
    let text = string_arg(items, k, index, mut error) else return none
    if let v = i64.parse(text) {
        return some(v)
    }
    error = "operation {index} argument {k} must be a decimal 64-bit integer"
    return none
}

fn double_arg(items: List<Json>, k: usize, index: usize, error: mut String) -> f64? {
    let text = string_arg(items, k, index, mut error) else return none
    if let v = f64.parse(text) {
        return some(v)
    }
    error = "operation {index} argument {k} must be a decimal number"
    return none
}

// --- running them -------------------------------------------------------------------------------

/// What the probe needs from each kind of source besides its numbers.
interface Probed {
    /// The source `fork` gives.
    fn forked(mut self) -> Source
    /// The factory `forkPositional` gives.
    fn positional(mut self) -> Positional
    /// This source, as the probe holds it.
    fn wrapped(self) -> Source
}

impl Probed for LegacyRandom {
    fn forked(mut self) -> Source {
        return Source.Legacy(self.fork())
    }
    fn positional(mut self) -> Positional {
        return Positional.Legacy(self.fork_positional())
    }
    fn wrapped(self) -> Source {
        return Source.Legacy(self)
    }
}

impl Probed for XoroshiroRandom {
    fn forked(mut self) -> Source {
        return Source.Xoroshiro(self.fork())
    }
    fn positional(mut self) -> Positional {
        return Positional.Xoroshiro(self.fork_positional())
    }
    fn wrapped(self) -> Source {
        return Source.Xoroshiro(self)
    }
}

/// A worldgen source forks its inner source, as vanilla's does.
impl Probed for WorldgenRandom<LegacyRandom> {
    fn forked(mut self) -> Source {
        return Source.Legacy(self.source.fork())
    }
    fn positional(mut self) -> Positional {
        return Positional.Legacy(self.source.fork_positional())
    }
    fn wrapped(self) -> Source {
        return Source.WorldLegacy(self)
    }
}

impl Probed for WorldgenRandom<XoroshiroRandom> {
    fn forked(mut self) -> Source {
        return Source.Xoroshiro(self.source.fork())
    }
    fn positional(mut self) -> Positional {
        return Positional.Xoroshiro(self.source.fork_positional())
    }
    fn wrapped(self) -> Source {
        return Source.WorldXoroshiro(self)
    }
}

fn apply(source: Source, op: Op, out: mut List<u8>) -> Step {
    return match source {
        Source.Legacy(r) => run_op(r, op, mut out),
        Source.Xoroshiro(r) => run_op(r, op, mut out),
        Source.WorldLegacy(w) => if is_seeding(op) { Step.Next(Source.WorldLegacy(reseed(w, op, mut out))) } else { run_op(w, op, mut out) },
        Source.WorldXoroshiro(w) => if is_seeding(op) { Step.Next(Source.WorldXoroshiro(reseed(w, op, mut out))) } else { run_op(w, op, mut out) },
    }
}

/// Whether the operation is one of `WorldgenRandom`'s own.
fn is_seeding(op: Op) -> bool {
    return match op {
        DecorationSeed(_, _, _) | FeatureSeed(_, _, _) | LargeFeatureSeed(_, _, _) | LargeFeatureWithSalt(_, _, _, _) => true,
        _ => false,
    }
}

fn reseed<T: RandomSource + Bits>(w: own WorldgenRandom<T>, op: Op, out: mut List<u8>) -> WorldgenRandom<T> {
    var s = w
    match op {
        DecorationSeed(seed, x, z) => put_u64(mut out, u64.wrap(s.set_decoration_seed(seed, x, z))),
        FeatureSeed(seed, index, decoration) => s.set_feature_seed(seed, index, decoration),
        LargeFeatureSeed(seed, x, z) => s.set_large_feature_seed(seed, x, z),
        LargeFeatureWithSalt(seed, x, z, salt) => s.set_large_feature_with_salt(seed, x, z, salt),
        _ => {}
    }
    return s
}

/// Runs an operation any source has. The bounds vanilla rejects are checked here, before the
/// source would panic on them.
fn run_op<T: RandomSource + Probed>(r: own T, op: Op, out: mut List<u8>) -> Step {
    var s = r
    match op {
        NextInt => put_u32(mut out, u32.wrap(s.next_int())),
        NextIntBelow(bound) => {
            if bound <= 0 {
                return Step.Threw("Bound must be positive")
            }
            put_u32(mut out, u32.wrap(s.next_int_below(bound)))
        }
        NextIntRange(origin, bound) => {
            if origin >= bound {
                return Step.Threw("bound - origin is non positive")
            }
            if bound - origin <= 0 {
                return Step.Threw("Bound must be positive")
            }
            put_u32(mut out, u32.wrap(s.next_int_range(origin, bound)))
        }
        NextIntBetween(min, max) => {
            if max - min + 1 <= 0 {
                return Step.Threw("Bound must be positive")
            }
            put_u32(mut out, u32.wrap(s.next_int_between(min, max)))
        }
        NextLong => put_u64(mut out, u64.wrap(s.next_long())),
        NextBoolean => out.push(if s.next_boolean() { 1 } else { 0 }),
        NextFloat => put_u32(mut out, s.next_float().to_bits()),
        NextDouble => put_u64(mut out, s.next_double().to_bits()),
        NextGaussian => put_u64(mut out, s.next_gaussian().to_bits()),
        Triangle(mean, spread) => put_u64(mut out, s.triangle(mean, spread).to_bits()),
        SetSeed(seed) => s.set_seed(seed),
        Consume(count) => s.consume(count),
        Fork => return Step.Next(s.forked()),
        At(x, y, z) => {
            return Step.Next(match s.positional() {
                Positional.Legacy(p) => Source.Legacy(p.at(x, y, z)),
                Positional.Xoroshiro(p) => Source.Xoroshiro(p.at(x, y, z)),
            })
        }
        FromHashOf(name) => {
            return Step.Next(match s.positional() {
                Positional.Legacy(p) => Source.Legacy(p.from_hash_of(name)),
                Positional.Xoroshiro(p) => Source.Xoroshiro(p.from_hash_of(name)),
            })
        }
        FromSeed(seed) => {
            return Step.Next(match s.positional() {
                Positional.Legacy(_) => Source.Legacy(LegacyPositional.from_seed(seed)),
                Positional.Xoroshiro(p) => Source.Xoroshiro(p.from_seed(seed)),
            })
        }
        DecorationSeed(_, _, _) | FeatureSeed(_, _, _) | LargeFeatureSeed(_, _, _) | LargeFeatureWithSalt(_, _, _, _) => return Step.Wrong,
    }
    return Step.Next(s.wrapped())
}

fn put_u32(out: mut List<u8>, v: u32) {
    out.push(u8.wrap(v >> 24))
    out.push(u8.wrap(v >> 16))
    out.push(u8.wrap(v >> 8))
    out.push(u8.wrap(v))
}

fn put_u64(out: mut List<u8>, v: u64) {
    put_u32(mut out, u32.wrap(v >> 32))
    put_u32(mut out, u32.wrap(v))
}
