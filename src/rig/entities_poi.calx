/// The `entities_poi` probe (rig/PROTOCOL.md): `storage.entities`' entity chunks and
/// `storage.poi`'s POI chunks, read from SNBT as a chunk of a world's `entities` or `poi` folder
/// is read, and written as it's saved. The blob is what was logged, then what was read or
/// written.
module rig.entities_poi

import json.tree.{Json, Member, as_i32, as_string, take}
import nbt.snbt.{parse_compound}
import nbt.tag.{Tag}
import registry.registries.{Registries}
import rig.frame.{Outcome}
import server.log.{Entry, Level}
import storage.entities.{EntityChunk, Placed, logger, write_entities}
import storage.poi.{PoiChunk, PoiFormat}
import world.pos.{ChunkPos}

pub fn run_entities_poi(input: own List<Member>, blobs: List<List<u8>>, registries: Registries) -> Outcome {
    if not blobs.is_empty() {
        return Outcome.Failed("`entities_poi` takes no blobs")
    }
    var fields = input
    let op = as_string(take(mut fields, "op") ?? Json.Null) else return Outcome.Failed("`op` must be a string")
    let x = as_i32(take(mut fields, "x") ?? Json.Null) else return Outcome.Failed("`x` must be a 32-bit integer")
    let z = as_i32(take(mut fields, "z") ?? Json.Null) else return Outcome.Failed("`z` must be a 32-bit integer")
    let pos = ChunkPos { x: x, z: z }
    var root: JavaHashMap<String, Tag>? = none
    if let value = take(mut fields, "snbt") {
        let snbt = as_string(value) else return Outcome.Failed("`snbt` must be a string")
        match parse_compound(snbt) {
            ok(Tag.Compound(tags)) => root = some(tags),
            ok(_) => return Outcome.Failed("`snbt` isn't a compound"),
            err(e) => return Outcome.Failed("`snbt` isn't a compound: {e.context()}"),
        }
    }
    var lines = List<Entry>()
    var after = List<u8>()
    if op == "entities_load" {
        load(pos, root, mut lines, mut after)
    } else if op == "entities_save" {
        let given = root else return Outcome.Failed("`entities_save` takes `snbt`")
        save(pos, given, mut after)
    } else if op == "poi" {
        let min_y = as_i32(take(mut fields, "min_y") ?? Json.Null) else return Outcome.Failed("`min_y` must be a 32-bit integer")
        let sections = as_i32(take(mut fields, "sections") ?? Json.Null) else return Outcome.Failed("`sections` must be a 32-bit integer")
        if (min_y & 15) != 0 or min_y < -2032 or sections < 1 or i64(min_y) + i64(sections) * 16 > 2032 {
            return Outcome.Failed("`min_y` must be a multiple of 16 and the sections inside -2032 to 2032")
        }
        let format = match PoiFormat.new(registries) {
            ok(f) => f,
            err(message) => return Outcome.Failed(message),
        }
        let chunk = match root {
            some(tags) => PoiChunk.read(format, pos, min_y >> 4, sections, tags, mut lines),
            none => PoiChunk.empty(min_y >> 4, sections),
        }
        put_root(mut after, chunk.write(format))
    } else {
        return Outcome.Failed("no operation `{op}`")
    }
    var out = List<u8>()
    put_i32(mut out, i32.wrap(lines.len()))
    for line in lines {
        out.push(match line.level {
            Level.Warn => 1,
            Level.Error => 2,
            _ => 0,
        })
        put_message(mut out, line.message)
    }
    for b in after {
        out.push(b)
    }
    return Outcome.Done { output: [], blobs: [out] }
}

// An entity chunk read as `loadEntities` reads it, up to its entities: 0 for no chunk, or 1,
// then what's reported to the server, then each entity's compound.
fn load(pos: ChunkPos, root: own JavaHashMap<String, Tag>?, lines: mut List<Entry>, out: mut List<u8>) {
    let tags = root else {
        out.push(0)
        return
    }
    let chunk = EntityChunk.read(pos, tags, mut lines)
    if let line = chunk.problems.close(logger()) {
        lines.push(line)
    }
    out.push(1)
    match chunk.placed {
        Placed.Right => out.push(0),
        Placed.Misplaced(at) => {
            out.push(1)
            put_i32(mut out, at.x)
            put_i32(mut out, at.z)
        },
        Placed.Unreadable => out.push(2),
    }
    put_i32(mut out, i32.wrap(chunk.entities.len()))
    for entity in chunk.entities {
        put_root(mut out, Tag.Compound(entity.tag.copy()))
    }
}

// An entity chunk saved as `storeEntities` saves it, with the case's `Entities` as the
// entities' tags: 0 if there's none, which stores nothing, or 1, then the chunk's NBT.
fn save(pos: ChunkPos, given: own JavaHashMap<String, Tag>, out: mut List<u8>) {
    var tags = given
    var entities: List<Tag>? = none
    match tags.remove("Entities") {
        some(Tag.List(items)) => entities = some(items),
        some(_) => entities = some(List<Tag>()),
        none => {},
    }
    match write_entities(pos, entities) {
        some(tag) => {
            out.push(1)
            put_root(mut out, tag)
        },
        none => out.push(0),
    }
}

// An `int` length, then the tag as a file's root.
fn put_root(out: mut List<u8>, tag: Tag) {
    var bytes = List<u8>()
    tag.write_unnamed(mut bytes)
    put_i32(mut out, i32.wrap(bytes.len()))
    for b in bytes {
        out.push(b)
    }
}

fn put_message(out: mut List<u8>, text: String) {
    let bytes = text.to_bytes()
    put_i32(mut out, i32.wrap(bytes.len()))
    for b in bytes {
        out.push(b)
    }
}

fn put_i32(out: mut List<u8>, v: i32) {
    out.push(u8.wrap(v >> 24))
    out.push(u8.wrap(v >> 16))
    out.push(u8.wrap(v >> 8))
    out.push(u8.wrap(v))
}
