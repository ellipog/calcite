/// The `levels` probe (rig/PROTOCOL.md): `world.levels`' graph, with its levels and sources kept
/// in maps as the case says, through the case's operations, with each level set written as it's
/// set, all to one blob, as the vanilla adapter runs vanilla's own `ChunkTracker`.
module rig.levels

import json.tree.{Json, Member, as_i32, as_string, take}
import rig.frame.{Outcome}
import world.levels.{ChunkLevels, ChunkTracker, LevelSources}
import world.pos.{ChunkPos}

// A tracker's levels in a fastutil map, as the simulation and player trackers keep theirs: a
// chunk with none is at `unset`, and one set at `keep_below` or above is taken out. The blob
// has each level the graph sets as it sets it: a 1, the chunk and the level.
struct Levels {
    at: OpenHashMap<i64, i32> = OpenHashMap<i64, i32>()
    unset: i32
    keep_below: i32
    out: List<u8> = List<u8>()
}

impl Levels {
    fn keep(mut self, chunk: i64, level: i32) {
        if level >= self.keep_below {
            _ = self.at.remove(chunk)
        } else {
            self.at.insert(chunk, level)
        }
    }
}

impl ChunkLevels for Levels {
    fn level(self, chunk: i64) -> i32 {
        return self.at.get(chunk) ?? self.unset
    }

    fn set_level(mut self, chunk: i64, level: i32) {
        self.out.push(1)
        put_i64(mut self.out, chunk)
        put_i32(mut self.out, level)
        self.keep(chunk, level)
    }
}

// Each chunk's source level, as its tickets or its players give it, and `unset` for one with
// none.
struct Sources {
    at: Map<i64, i32> = Map<i64, i32>()
    unset: i32
}

impl LevelSources<Sources> for Levels {
    fn source_level(self, sources: Sources, chunk: i64) -> i32 {
        return sources.at.get(chunk) ?? sources.unset
    }
}

pub fn run_levels(input: own List<Member>, blobs: List<List<u8>>) -> Outcome {
    if not blobs.is_empty() {
        return Outcome.Failed("`levels` takes no blobs")
    }
    var fields = input
    let value = take(mut fields, "ops") else return Outcome.Failed("missing field `ops`")
    let ops = match value {
        Json.Array(items) => items,
        _ => return Outcome.Failed("`ops` must be an array"),
    }
    let count = as_i32(take(mut fields, "level_count") ?? Json.Null) else return Outcome.Failed("`level_count` must be a 32-bit integer")
    if count < 2 or count > 253 {
        return Outcome.Failed("`level_count` must be from 2 to 253")
    }
    let unset = as_i32(take(mut fields, "unset") ?? Json.Null) else return Outcome.Failed("`unset` must be a 32-bit integer")
    let keep_below = as_i32(take(mut fields, "keep_below") ?? Json.Null) else return Outcome.Failed("`keep_below` must be a 32-bit integer")
    let no_source = as_i32(take(mut fields, "no_source") ?? Json.Null) else return Outcome.Failed("`no_source` must be a 32-bit integer")
    var graph = ChunkTracker.new(count)
    var levels = Levels { unset: unset, keep_below: keep_below }
    var sources = Sources { unset: no_source }
    for k in 0..ops.len() {
        // Each operation's levels set come first, as they're set, then a 0 and its result.
        var after = List<u8>()
        match run_op(mut graph, mut levels, mut sources, ops, k, mut after) {
            ok => {},
            err(message) => return Outcome.Failed(message),
        }
        levels.out.push(0)
        for b in after {
            levels.out.push(b)
        }
    }
    return Outcome.Done { output: [], blobs: [levels.out] }
}

fn run_op(graph: mut ChunkTracker, levels: mut Levels, sources: mut Sources, ops: List<Json>, k: usize, after: mut List<u8>) ! String {
    let items = try items_of(ops, k)
    let name = as_string(items[0]) ?? String()
    if name == "source" {
        try expect(items, k, 3)
        let chunk = try chunk_of(items, k)
        sources.at.insert(chunk, try int_of(items, k, 3))
    } else if name == "unsource" {
        try expect(items, k, 2)
        _ = sources.at.remove(try chunk_of(items, k))
    } else if name == "update" {
        try expect(items, k, 4)
        let chunk = try chunk_of(items, k)
        let level = try int_of(items, k, 3)
        let only_decreased = match items[4] {
            Json.Bool(b) => b,
            _ => fail "{what(k, 4)} must be a boolean",
        }
        graph.update(chunk, level, only_decreased, levels)
    } else if name == "set" {
        try expect(items, k, 3)
        let chunk = try chunk_of(items, k)
        levels.keep(chunk, try int_of(items, k, 3))
    } else if name == "run" {
        try expect(items, k, 1)
        let count = try int_of(items, k, 1)
        put_i32(mut after, graph.run_updates(count, mut levels, sources))
    } else if name == "dump" {
        try expect(items, k, 0)
        after.push(if graph.has_work() { 1 } else { 0 })
        put_i32(mut after, i32.wrap(graph.queue_size()))
        put_i32(mut after, i32.wrap(levels.at.len()))
        for (chunk, level) in levels.at {
            put_i64(mut after, chunk)
            put_i32(mut after, level)
        }
    } else {
        fail "operation {k}: no operation `{name}`"
    }
}

fn items_of(ops: List<Json>, k: usize) -> List<Json> ! String {
    match ops[k] {
        Json.Array(items) => {
            if not items.is_empty() and as_string(items[0]) != none {
                return items.copy()
            }
        },
        _ => {},
    }
    fail "operation {k} must be a non-empty array named by a string"
}

fn what(k: usize, i: usize) -> String {
    return "operation {k}'s argument {i}"
}

fn expect(items: List<Json>, k: usize, n: usize) ! String {
    if items.len() != n + 1 {
        fail "operation {k}: `{as_string(items[0]) ?? String()}` takes {n} arguments, got {items.len() - 1}"
    }
}

fn int_of(items: List<Json>, k: usize, i: usize) -> i32 ! String {
    let n = as_i32(items[i]) else fail "{what(k, i)} must be a 32-bit integer"
    return n
}

// Arguments 1 and 2, the chunk's `x` and `z`, packed.
fn chunk_of(items: List<Json>, k: usize) -> i64 ! String {
    let x = try int_of(items, k, 1)
    let z = try int_of(items, k, 2)
    return ChunkPos { x: x, z: z }.pack()
}

fn put_i32(out: mut List<u8>, v: i32) {
    out.push(u8.wrap(v >> 24))
    out.push(u8.wrap(v >> 16))
    out.push(u8.wrap(v >> 8))
    out.push(u8.wrap(v))
}

fn put_i64(out: mut List<u8>, v: i64) {
    put_i32(mut out, i32.wrap(v >> 32))
    put_i32(mut out, i32.wrap(v))
}
