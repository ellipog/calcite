/// JSON for the rig's frame headers (rig/PROTOCOL.md): a parser, a writer, and lookups.
module rig.json

/// A JSON value.
pub enum Json {
    Null
    Bool(bool)
    /// A number, as its JSON text, so that echoing one loses nothing to rounding.
    Number(String)
    Str(String)
    Array(List<Json>)
    Object(List<Member>)
}

/// One member of an object, in the order the text had them.
pub struct Member {
    pub key: String
    pub value: Json
}

/// The deepest nesting `parse` accepts, so that a hostile header can't exhaust the stack.
const MAX_DEPTH: i32 = 64

/// The JSON object in `text`, or `none` if the text isn't one.
pub fn parse_object(text: String) -> List<Member>? {
    var at: usize = 0
    skip_space(text, mut at)
    let members = object(text, mut at, 0) else return none
    skip_space(text, mut at)
    if at != text.len() {
        return none
    }
    return some(members)
}

/// Removes the member named `key` and gives its value, or `none` if there's no such member.
pub fn take(members: mut List<Member>, key: String) -> Json? {
    let n = members.len()
    for i in 0..n {
        if members[i].key == key {
            let member = members.swap_remove(i)
            return some(member.value)
        }
    }
    return none
}

/// The text of a JSON string, or `none` for any other value.
pub fn as_string(value: Json) -> String? {
    return match value {
        Json.Str(s) => some(s.copy()),
        _ => none,
    }
}

/// A JSON number that's an `i32` exactly, as Java's `BigDecimal.intValueExact`: `5`, `5.0`
/// and `5e0` are all 5, but `5.5` and `3e9` are `none`.
pub fn as_i32(value: Json) -> i32? {
    let text = match value {
        Json.Number(t) => t.copy(),
        _ => return none,
    }
    return exact_i32(text)
}

/// Adds the value to `out` as compact JSON. Text that isn't ASCII is written as itself.
pub fn write(out: mut List<u8>, value: Json) {
    match value {
        Json.Null => push_text(mut out, "null"),
        Json.Bool(b) => push_text(mut out, if b { "true" } else { "false" }),
        Json.Number(t) => push_text(mut out, t),
        Json.Str(s) => write_string(mut out, s),
        Json.Array(items) => {
            push_text(mut out, "[")
            let n = items.len()
            for i in 0..n {
                if i > 0 {
                    push_text(mut out, ",")
                }
                write(mut out, items[i])
            }
            push_text(mut out, "]")
        }
        Json.Object(members) => write_object(mut out, members),
    }
}

pub fn write_object(out: mut List<u8>, members: List<Member>) {
    push_text(mut out, "\{")
    let n = members.len()
    for i in 0..n {
        if i > 0 {
            push_text(mut out, ",")
        }
        write_string(mut out, members[i].key)
        push_text(mut out, ":")
        write(mut out, members[i].value)
    }
    push_text(mut out, "\}")
}

/// Adds `s` as a JSON string, escaping quotes, backslashes and control characters.
pub fn write_string(out: mut List<u8>, s: String) {
    let hex = "0123456789abcdef"
    push_text(mut out, "\"")
    let n = s.len()
    for i in 0..n {
        let b = s.byte_at(i)
        if rune(b) == '"' or rune(b) == '\\' {
            push_text(mut out, "\\")
            out.push(b)
        } else if rune(b) == '\n' {
            push_text(mut out, "\\n")
        } else if b < 0x20 {
            push_text(mut out, "\\u00")
            out.push(hex.byte_at(usize(b / 16)))
            out.push(hex.byte_at(usize(b % 16)))
        } else {
            out.push(b)
        }
    }
    push_text(mut out, "\"")
}

/// Adds the bytes of `s`.
pub fn push_text(out: mut List<u8>, s: String) {
    let n = s.len()
    out.reserve(n)
    for i in 0..n {
        out.push(s.byte_at(i))
    }
}

// --- parsing ------------------------------------------------------------------------------------

fn skip_space(text: String, at: mut usize) {
    while at < text.len() {
        let b = text.byte_at(at)
        if rune(b) != ' ' and rune(b) != '\t' and rune(b) != '\n' and rune(b) != '\r' {
            return
        }
        at += 1
    }
}

/// Whether the next byte is `b`, stepping past it if so.
fn eat(text: String, at: mut usize, b: rune) -> bool {
    if at < text.len() and rune(text.byte_at(at)) == b {
        at += 1
        return true
    }
    return false
}

/// Whether `word` comes next, stepping past it if so.
fn eat_word(text: String, at: mut usize, word: String) -> bool {
    let n = word.len()
    if at + n > text.len() {
        return false
    }
    for i in 0..n {
        if text.byte_at(at + i) != word.byte_at(i) {
            return false
        }
    }
    at += n
    return true
}

fn parse_value(text: String, at: mut usize, depth: i32) -> Json? {
    if depth > MAX_DEPTH or at >= text.len() {
        return none
    }
    let b = text.byte_at(at)
    if rune(b) == '{' {
        let members = object(text, mut at, depth + 1) else return none
        return some(Json.Object(members))
    }
    if rune(b) == '[' {
        at += 1
        var items: List<Json> = []
        skip_space(text, mut at)
        if eat(text, mut at, ']') {
            return some(Json.Array(items))
        }
        loop {
            skip_space(text, mut at)
            let item = parse_value(text, mut at, depth + 1) else return none
            items.push(item)
            skip_space(text, mut at)
            if eat(text, mut at, ']') {
                return some(Json.Array(items))
            }
            if not eat(text, mut at, ',') {
                return none
            }
        }
    }
    if rune(b) == '"' {
        let s = string(text, mut at) else return none
        return some(Json.Str(s))
    }
    if eat_word(text, mut at, "null") {
        return some(Json.Null)
    }
    if eat_word(text, mut at, "true") {
        return some(Json.Bool(true))
    }
    if eat_word(text, mut at, "false") {
        return some(Json.Bool(false))
    }
    let t = number(text, mut at) else return none
    return some(Json.Number(t))
}

fn object(text: String, at: mut usize, depth: i32) -> List<Member>? {
    if depth > MAX_DEPTH or not eat(text, mut at, '{') {
        return none
    }
    var members: List<Member> = []
    skip_space(text, mut at)
    if eat(text, mut at, '}') {
        return some(members)
    }
    loop {
        skip_space(text, mut at)
        let key = string(text, mut at) else return none
        skip_space(text, mut at)
        if not eat(text, mut at, ':') {
            return none
        }
        skip_space(text, mut at)
        let v = parse_value(text, mut at, depth + 1) else return none
        members.push(Member { key: key, value: v })
        skip_space(text, mut at)
        if eat(text, mut at, '}') {
            return some(members)
        }
        if not eat(text, mut at, ',') {
            return none
        }
    }
}

/// A string literal, its escapes decoded. `text` is UTF-8 already, so bytes other than escapes
/// are copied as they are.
fn string(text: String, at: mut usize) -> String? {
    if not eat(text, mut at, '"') {
        return none
    }
    var bytes: List<u8> = []
    loop {
        if at >= text.len() {
            return none
        }
        let b = text.byte_at(at)
        at += 1
        if rune(b) == '"' {
            return String.from_utf8(bytes)
        }
        if b < 0x20 {
            return none
        }
        if rune(b) != '\\' {
            bytes.push(b)
            continue
        }
        if at >= text.len() {
            return none
        }
        let e = text.byte_at(at)
        at += 1
        if rune(e) == '"' or rune(e) == '\\' or rune(e) == '/' {
            bytes.push(e)
        } else if rune(e) == 'b' {
            bytes.push(0x08)
        } else if rune(e) == 'f' {
            bytes.push(0x0C)
        } else if rune(e) == 'n' {
            bytes.push(0x0A)
        } else if rune(e) == 'r' {
            bytes.push(0x0D)
        } else if rune(e) == 't' {
            bytes.push(0x09)
        } else if rune(e) == 'u' {
            var cp = hex4(text, mut at) else return none
            if cp >= 0xD800 and cp < 0xDC00 {
                // A high surrogate, which must be followed by an escaped low one.
                if not eat_word(text, mut at, "\\u") {
                    return none
                }
                let low = hex4(text, mut at) else return none
                if low < 0xDC00 or low >= 0xE000 {
                    return none
                }
                cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00)
            } else if cp >= 0xDC00 and cp < 0xE000 {
                return none
            }
            push_utf8(mut bytes, cp)
        } else {
            return none
        }
    }
}

fn hex4(text: String, at: mut usize) -> i32? {
    if at + 4 > text.len() {
        return none
    }
    var v = 0
    let four: usize = 4
    for i in 0..four {
        let b = i32(text.byte_at(at + i))
        let d = if b >= 0x30 and b <= 0x39 {
            b - 0x30
        } else if b >= 0x61 and b <= 0x66 {
            b - 0x61 + 10
        } else if b >= 0x41 and b <= 0x46 {
            b - 0x41 + 10
        } else {
            return none
        }
        v = v * 16 + d
    }
    at += 4
    return some(v)
}

/// Adds the code point `cp`, which isn't a surrogate, as UTF-8.
fn push_utf8(bytes: mut List<u8>, cp: i32) {
    if cp < 0x80 {
        bytes.push(u8.wrap(cp))
    } else if cp < 0x800 {
        bytes.push(u8.wrap(0xC0 | (cp >> 6)))
        bytes.push(u8.wrap(0x80 | (cp & 0x3F)))
    } else if cp < 0x10000 {
        bytes.push(u8.wrap(0xE0 | (cp >> 12)))
        bytes.push(u8.wrap(0x80 | ((cp >> 6) & 0x3F)))
        bytes.push(u8.wrap(0x80 | (cp & 0x3F)))
    } else {
        bytes.push(u8.wrap(0xF0 | (cp >> 18)))
        bytes.push(u8.wrap(0x80 | ((cp >> 12) & 0x3F)))
        bytes.push(u8.wrap(0x80 | ((cp >> 6) & 0x3F)))
        bytes.push(u8.wrap(0x80 | (cp & 0x3F)))
    }
}

/// A number's text, checked against JSON's grammar: `-`, digits without a leading zero, then
/// an optional fraction and exponent.
fn number(text: String, at: mut usize) -> String? {
    let start = at
    _ = eat(text, mut at, '-')
    if eat(text, mut at, '0') {
        // A leading zero stands alone.
    } else if skip_digits(text, mut at) == 0 {
        return none
    }
    if eat(text, mut at, '.') and skip_digits(text, mut at) == 0 {
        return none
    }
    if eat(text, mut at, 'e') or eat(text, mut at, 'E') {
        if not eat(text, mut at, '+') {
            _ = eat(text, mut at, '-')
        }
        if skip_digits(text, mut at) == 0 {
            return none
        }
    }
    var bytes: List<u8> = []
    for i in start..at {
        bytes.push(text.byte_at(i))
    }
    return String.from_utf8(bytes)
}

/// Steps past ASCII digits, and says how many.
fn skip_digits(text: String, at: mut usize) -> usize {
    let start = at
    while at < text.len() and rune(text.byte_at(at)) >= '0' and rune(text.byte_at(at)) <= '9' {
        at += 1
    }
    return at - start
}

/// The `i32` a valid JSON number's text is exactly, if it's one.
fn exact_i32(text: String) -> i32? {
    // The number is `digits` times 10 to the `scale`, its fraction's digits moved into
    // `digits`. Leading zeros don't count, and trailing ones raise the scale.
    var negative = false
    var digits: List<u8> = []
    var scale = 0
    var i: usize = 0
    let n = text.len()
    if rune(text.byte_at(0)) == '-' {
        negative = true
        i = 1
    }
    var fraction = false
    while i < n {
        let b = text.byte_at(i)
        if rune(b) == '.' {
            fraction = true
        } else if rune(b) == 'e' or rune(b) == 'E' {
            break
        } else {
            if fraction {
                scale -= 1
            }
            if not (digits.is_empty() and rune(b) == '0') {
                digits.push(b - 0x30)
            }
        }
        i += 1
    }
    if i < n {
        // The exponent. Any that matters for an i32 is small; a long one means the value is 0
        // or too large, which the digit count below tells apart.
        i += 1
        var exp_negative = false
        if rune(text.byte_at(i)) == '-' or rune(text.byte_at(i)) == '+' {
            exp_negative = rune(text.byte_at(i)) == '-'
            i += 1
        }
        var exp = 0
        while i < n {
            if exp < 1000000 {
                exp = exp * 10 + i32(text.byte_at(i)) - 0x30
            }
            i += 1
        }
        scale += if exp_negative { -exp } else { exp }
    }
    if digits.is_empty() {
        return some(0)
    }
    while scale < 0 {
        let last = digits.pop() ?? 0
        if last != 0 {
            return none
        }
        scale += 1
        if digits.is_empty() {
            return some(0)
        }
    }
    if digits.len() + usize.wrap(scale) > 10 {
        return none
    }
    var v: i64 = 0
    for d in digits {
        v = v * 10 + i64(d)
    }
    for _ in 0..scale {
        v *= 10
    }
    if negative {
        v = -v
    }
    if v < -2147483648 or v > 2147483647 {
        return none
    }
    return some(i32.wrap(v))
}
