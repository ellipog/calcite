/// The `math`, `strictmath` and `mth` probes (rig/PROTOCOL.md): Java's `Math` and `StrictMath`
/// over a blob of arguments, and Minecraft's `Mth` helpers that use tables or bit tricks.
///
/// Calcite's math is `StrictMath`'s, fdlibm's, for both: vanilla's reference configuration runs
/// with HotSpot's intrinsics off, where `Math` gives exactly `StrictMath`'s results but for the
/// sign of a NaN, which the probes don't compare (D60, D208).
module rig.math

import json.tree.{Json, Member, as_string, take}
import math.mth.{AsinTable, SinTable, fast_inv_sqrt, floor, wrap_degrees}
import random.source.{position_seed}
import rig.frame.{Outcome}
import std.java.math.{acos, asin, atan, atan2, cbrt, cos, cosh, exp, expm1, hypot, log, log10, log1p, pow, sin, sinh, tan, tanh}

/// The `math` and `strictmath` probes, which Calcite answers alike.
pub fn run_math(input: own List<Member>, blobs: List<List<u8>>) -> Outcome {
    var fields = input
    let value = take(mut fields, "fn") else return Outcome.Failed("missing field `fn`")
    let name = as_string(value) else return Outcome.Failed("`fn` must be a string")
    let binary = name == "atan2" or name == "pow" or name == "hypot"
    if not binary and not unary_known(name) {
        return Outcome.Failed("unknown function `{name}`")
    }
    let size: usize = if binary { 16 } else { 8 }
    let blob = match records(blobs, size) {
        ok(b) => b,
        err(e) => return Outcome.Failed(e),
    }
    var out = List<u8>()
    var at: usize = 0
    while at < blob.len() {
        let a = double_at(blob, at)
        let r = if binary {
            let b = double_at(blob, at + 8)
            if name == "atan2" { atan2(a, b) } else if name == "pow" { pow(a, b) } else { hypot(a, b) }
        } else {
            unary(name, a)
        }
        put_u64(mut out, double_bits(r))
        at += size
    }
    let output: List<Member> = []
    return Outcome.Done { output: output, blobs: [out] }
}

fn unary_known(name: String) -> bool {
    let names = ["sin", "cos", "tan", "asin", "acos", "atan", "exp", "log", "log10", "log1p", "expm1", "sqrt", "cbrt", "sinh", "cosh", "tanh"]
    for n in names {
        if name == String(n) {
            return true
        }
    }
    return false
}

fn unary(name: String, v: f64) -> f64 {
    if name == "sin" {
        return sin(v)
    }
    if name == "cos" {
        return cos(v)
    }
    if name == "tan" {
        return tan(v)
    }
    if name == "asin" {
        return asin(v)
    }
    if name == "acos" {
        return acos(v)
    }
    if name == "atan" {
        return atan(v)
    }
    if name == "exp" {
        return exp(v)
    }
    if name == "log" {
        return log(v)
    }
    if name == "log10" {
        return log10(v)
    }
    if name == "log1p" {
        return log1p(v)
    }
    if name == "expm1" {
        return expm1(v)
    }
    if name == "sqrt" {
        return v.sqrt()
    }
    if name == "cbrt" {
        return cbrt(v)
    }
    if name == "sinh" {
        return sinh(v)
    }
    if name == "cosh" {
        return cosh(v)
    }
    return tanh(v)
}

/// The `mth` probe.
pub fn run_mth(input: own List<Member>, blobs: List<List<u8>>) -> Outcome {
    var fields = input
    let value = take(mut fields, "fn") else return Outcome.Failed("missing field `fn`")
    let name = as_string(value) else return Outcome.Failed("`fn` must be a string")
    var out = List<u8>()
    if name == "sin_table" {
        if blobs.len() != 0 {
            return Outcome.Failed("`sin_table` takes no blobs")
        }
        let table = SinTable.new()
        for i in 0..65536 {
            put_u32(mut out, float_bits(table.entry(usize.wrap(i))))
        }
    } else if name == "sin" or name == "cos" {
        let blob = match records(blobs, 8) {
            ok(b) => b,
            err(e) => return Outcome.Failed(e),
        }
        let table = SinTable.new()
        var at: usize = 0
        while at < blob.len() {
            let x = double_at(blob, at)
            let r = if name == "sin" { table.sin(x) } else { table.cos(x) }
            put_u32(mut out, float_bits(r))
            at += 8
        }
    } else if name == "atan2" {
        let blob = match records(blobs, 16) {
            ok(b) => b,
            err(e) => return Outcome.Failed(e),
        }
        let table = AsinTable.new()
        var at: usize = 0
        while at < blob.len() {
            let r = table.atan2(double_at(blob, at), double_at(blob, at + 8)) else return out_of_bounds()
            put_u64(mut out, double_bits(r))
            at += 16
        }
    } else if name == "fast_inv_sqrt" {
        let blob = match records(blobs, 8) {
            ok(b) => b,
            err(e) => return Outcome.Failed(e),
        }
        var at: usize = 0
        while at < blob.len() {
            put_u64(mut out, double_bits(fast_inv_sqrt(double_at(blob, at))))
            at += 8
        }
    } else if name == "wrap_degrees" {
        let blob = match records(blobs, 4) {
            ok(b) => b,
            err(e) => return Outcome.Failed(e),
        }
        var at: usize = 0
        while at < blob.len() {
            put_u32(mut out, float_bits(wrap_degrees(f32.from_bits(u32_at(blob, at)))))
            at += 4
        }
    } else if name == "floor" {
        let blob = match records(blobs, 8) {
            ok(b) => b,
            err(e) => return Outcome.Failed(e),
        }
        var at: usize = 0
        while at < blob.len() {
            put_u32(mut out, u32.wrap(floor(double_at(blob, at))))
            at += 8
        }
    } else if name == "get_seed" {
        let blob = match records(blobs, 12) {
            ok(b) => b,
            err(e) => return Outcome.Failed(e),
        }
        var at: usize = 0
        while at < blob.len() {
            let x = i32.wrap(u32_at(blob, at))
            let y = i32.wrap(u32_at(blob, at + 4))
            let z = i32.wrap(u32_at(blob, at + 8))
            put_u64(mut out, u64.wrap(position_seed(x, y, z)))
            at += 12
        }
    } else {
        return Outcome.Failed("unknown function `{name}`")
    }
    let output: List<Member> = []
    return Outcome.Done { output: output, blobs: [out] }
}

/// What vanilla's adapter reports when `Mth.atan2`'s table index is out of range.
fn out_of_bounds() -> Outcome {
    let output: List<Member> = [
        Member { key: "exception", value: Json.Str("ArrayIndexOutOfBoundsException") },
        Member { key: "error", value: Json.Str("Index out of bounds for length 257") },
    ]
    return Outcome.Done { output: output, blobs: [] }
}

/// The one blob, if its length is a whole number of records.
fn records(blobs: List<List<u8>>, size: usize) -> List<u8> ! String {
    if blobs.len() != 1 {
        fail "expected 1 blob, got {blobs.len()}"
    }
    if blobs[0].len() % size != 0 {
        fail "blob length {blobs[0].len()} isn't a multiple of {size}"
    }
    return blobs[0].copy()
}

/// A double's bits as `Double.doubleToLongBits` gives them: every NaN as one, since no code
/// sees a NaN's sign or payload (D198, D208).
fn double_bits(v: f64) -> u64 {
    if v.is_nan() {
        return 0x7ff8000000000000
    }
    return v.to_bits()
}

/// A float's bits as `Float.floatToIntBits` gives them.
fn float_bits(v: f32) -> u32 {
    if v.is_nan() {
        return 0x7fc00000
    }
    return v.to_bits()
}

fn double_at(blob: List<u8>, at: usize) -> f64 {
    var bits: u64 = 0
    for k in 0..8 {
        bits = (bits << 8) | u64(blob[at + usize.wrap(k)])
    }
    return f64.from_bits(bits)
}

fn u32_at(blob: List<u8>, at: usize) -> u32 {
    var bits: u32 = 0
    for k in 0..4 {
        bits = (bits << 8) | u32(blob[at + usize.wrap(k)])
    }
    return bits
}

fn put_u32(out: mut List<u8>, v: u32) {
    out.push(u8.wrap(v >> 24))
    out.push(u8.wrap(v >> 16))
    out.push(u8.wrap(v >> 8))
    out.push(u8.wrap(v))
}

fn put_u64(out: mut List<u8>, v: u64) {
    put_u32(mut out, u32.wrap(v >> 32))
    put_u32(mut out, u32.wrap(v))
}
