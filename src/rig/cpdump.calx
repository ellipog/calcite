module rig.cpdump

// Scratch: for each failing command_parse case, its input, vanilla's output and Calcite's.

import std.fs.{read_text}
import std.env.{args}
import json.tree.{Json, as_string, get, parse, write, write_object}
import java.base64.{decode}
import rig.frame.{Outcome}
import rig.registries.{load_vanilla}
import rig.command_parse.{command_tree, run_command_parse}

fn printable(bytes: List<u8>) -> String {
    var out = List<u8>()
    var run = List<u8>()
    for b in bytes {
        if b >= 32 and b < 127 {
            run.push(b)
        } else {
            if run.len() >= 3 {
                if not out.is_empty() {
                    out.push(124)
                }
                for c in run {
                    out.push(c)
                }
            }
            run.clear()
        }
    }
    if run.len() >= 3 {
        if not out.is_empty() {
            out.push(124)
        }
        for c in run {
            out.push(c)
        }
    }
    return String.from_utf8(out) ?? String("?")
}

fn text_of(value: Json) -> String {
    var out = List<u8>()
    write(mut out, value)
    return String.from_utf8(out) ?? String("?")
}

pub fn main() {
    let a = args()
    let fails = read_text(a[0].copy())! ?? String("")
    let cases = read_text(a[1].copy())! ?? String("")
    let golden = read_text(a[2].copy())! ?? String("")
    var wanted = Map<String, bool>()
    for line in fails.split("\n") {
        if not line.trim().is_empty() {
            wanted.insert(line.trim(), true)
        }
    }
    var inputs = Map<String, Json>()
    let root = parse(cases) ?? Json.Null
    let Json.Object(top) = root else return
    let Json.Array(list) = get(top, String("cases")) ?? Json.Null else return
    for c in list {
        let Json.Object(m) = c else continue
        let id = as_string(get(m, String("id")) ?? Json.Null) ?? String("")
        if wanted.contains(id) {
            inputs.insert(id, get(m, String("input")) ?? Json.Null)
        }
    }
    let loaded = load_vanilla()!
    let t = command_tree(Shared(loaded.registries.copy()))
    for line in golden.split("\n") {
        let Json.Object(g) = parse(line.copy()) ?? Json.Null else continue
        let id = as_string(get(g, String("id")) ?? Json.Null) ?? String("")
        if not inputs.contains(id) {
            continue
        }
        let input = inputs[id].copy()
        let Json.Object(fields) = input.copy() else continue
        println("== {id}: {text_of(get(fields, String("input")) ?? Json.Null)}")
        println("  vanilla: {text_of(get(g, String("output")) ?? Json.Null)}")
        if let Json.Array(blobs) = get(g, String("blobs")) ?? Json.Null {
            for b in blobs {
                println("     blob: {printable(decode(as_string(b) ?? String("")) ?? List<u8>())}")
            }
        }
        match run_command_parse(fields, t) {
            Outcome.Done { output, blobs } => {
                var out = List<u8>()
                write_object(mut out, output)
                println("  calcite: {String.from_utf8(out) ?? String("?")}")
                for b in blobs {
                    println("     blob: {printable(b)}")
                }
            },
            _ => print("  calcite: failed"),
        }
    }
}
