/// The `items` probe (rig/PROTOCOL.md): an item stack read as vanilla's `ItemStack.CODEC` reads
/// one from a data pack's JSON, against the vanilla data pack's registries, complete, as a
/// server's are once its packs have loaded, and written to NBT as `writeAnyTag` writes it
/// (CAL-77, D362). Reading one from NBT or from the network, and writing one to the network,
/// Calcite doesn't do yet.
module rig.items

import chat.language.{Language}
import json.tree.{Json, Member, as_string, parse, take}
import nbt.tag.{Tag}
import registry.codec.{Codecs, Refs}
import registry.components.{item_stack, read_item_defaults}
import registry.registries.{Registries}
import rig.frame.{Outcome}
import rig.nbt.{load_language}
import world.states.{StateCodec}

pub fn run_items(input: own List<Member>, registries: Registries, lang: mut Language?) -> Outcome {
    var fields = input
    let from = as_string(take(mut fields, "from") ?? Json.Null) ?? String()
    let to = as_string(take(mut fields, "to") ?? Json.Null) ?? String()
    if from != "json" {
        return Outcome.Unimplemented("Calcite reads an item stack from `{from}` not yet")
    }
    if to != "nbt" {
        return Outcome.Unimplemented("Calcite writes an item stack to `{to}` not yet")
    }
    let text = as_string(take(mut fields, "value") ?? Json.Null) else return Outcome.Failed(String("`value` must be a string"))
    let value = parse(text) else return Outcome.Failed(String("`value` isn't JSON"))
    if lang == none {
        match load_language() {
            ok(l) => lang = some(l),
            err(message) => return Outcome.Failed(message),
        }
    }
    var codecs = Codecs.new()
    if let b = registries.find_builtin(String("block")) {
        codecs.states = some(StateCodec.new(registries.builtin[b]))
    }
    codecs.lang = lang.copy()
    codecs.frozen = true
    let at = item_stack(mut codecs)
    match read_item_defaults(codecs, registries) {
        ok(d) => codecs.item_defaults = d,
        err(message) => return Outcome.Failed(message),
    }
    var refs = Refs.new()
    var read = codecs.read(at, value, registries, mut refs)
    var output = List<Member>()
    if let e = read.error.take() {
        output.push(Member { key: "error", value: Json.Str(e) })
        output.push(Member { key: "partial", value: Json.Bool(read.value != none) })
        return Outcome.Done { output: output, blobs: [] }
    }
    let tag = read.value.take() ?? Tag.End
    output.push(Member { key: "empty", value: Json.Bool(false) })
    var bytes = List<u8>()
    match tag.write_any(mut bytes) {
        ok => {},
        err(message) => return Outcome.Failed(message),
    }
    return Outcome.Done { output: output, blobs: [bytes] }
}
