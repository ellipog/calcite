/// The `items` probe (rig/PROTOCOL.md): an item stack read as vanilla's `ItemStack.CODEC` reads
/// one, from a data pack's JSON or from SNBT, as a save's NBT is read, or as
/// `ItemStack.OPTIONAL_STREAM_CODEC` reads one from the network, against the vanilla data pack's
/// registries, complete, as a server's are once its packs have loaded, and written to NBT as
/// `writeAnyTag` writes it, or to the network, a stack from the network as `world.item` reads and
/// sends it (CAL-77, D362, D363, D364, D366), or hashed as a slot's `HashedStack` is, each component
/// its patch sets written with its codec to `HashOps` (D373).
module rig.items

import chat.language.{Language}
import hash.ops.{hash_tag}
import json.tree.{Json, Member, as_string, parse, take}
import nbt.snbt.{parse as parse_snbt}
import nbt.tag.{Tag}
import protocol.wire.{Reader, Writer}
import registry.codec.{Codecs, Refs}
import registry.components.{apply_wire, item_stack, read_item_defaults}
import registry.registries.{Registries}
import registry.streams.{Decoded, Streams, WireStack}
import rig.frame.{Outcome}
import rig.nbt.{load_language}
import world.item.{ItemStack}
import world.states.{StateCodec}

pub fn run_items(input: own List<Member>, blobs: List<List<u8>>, registries: Registries, lang: mut Language?) -> Outcome {
    var fields = input
    let from = as_string(take(mut fields, "from") ?? Json.Null) ?? String()
    let to = as_string(take(mut fields, "to") ?? Json.Null) ?? String()
    if from != "json" and from != "snbt" and from != "wire" {
        return Outcome.Failed("`from` must be `json`, `snbt` or `wire`, not `{from}`")
    }
    if to != "nbt" and to != "wire" and to != "hash" {
        return Outcome.Failed("`to` must be `nbt`, `wire` or `hash`, not `{to}`")
    }
    if lang == none {
        match load_language() {
            ok(l) => lang = some(l),
            err(message) => return Outcome.Failed(message),
        }
    }
    var codecs = Codecs.new()
    if let b = registries.find_builtin(String("block")) {
        codecs.states = some(StateCodec.new(registries.builtin[b]))
    }
    codecs.lang = lang.copy()
    codecs.frozen = true
    let at = item_stack(mut codecs)
    match read_item_defaults(codecs, registries) {
        ok(d) => codecs.item_defaults = d,
        err(message) => return Outcome.Failed(message),
    }
    // The defaults are JSON; what's read from a save or the network is NBT, which the stream
    // codecs decode with the codecs as they read it.
    codecs.nbt = from != "json"
    let streams = Streams.new()
    var output = List<Member>()
    var wire_stack: WireStack? = none
    var value = Json.Null
    if from == "wire" {
        if blobs.len() != 1 {
            return Outcome.Failed(String("`wire` takes one blob"))
        }
        let total = blobs[0].len()
        var rd = Reader.new(blobs[0].copy())
        if to == "wire" {
            return sent_again(mut rd, total, streams, mut codecs, registries)
        }
        let decoded = streams.read_stack(mut rd, codecs, registries)
        // Vanilla says what's left before whether it's empty.
        match decoded {
            Decoded.Bad(message) => {
                output.push(Member { key: "error", value: Json.Str(java_exception(message, total)) })
                return Outcome.Done { output: output, blobs: [] }
            },
            Decoded.Missing(name) => return Outcome.Unimplemented("Calcite reads the stream of {name} not yet"),
            _ => {},
        }
        if rd.left() != 0 {
            output.push(Member { key: "left", value: Json.Number("{rd.left()}") })
        }
        match decoded {
            Decoded.Stack(s) => wire_stack = some(s),
            _ => {
                output.push(Member { key: "empty", value: Json.Bool(true) })
                return Outcome.Done { output: output, blobs: [] }
            },
        }
    } else {
        let text = as_string(take(mut fields, "value") ?? Json.Null) else return Outcome.Failed(String("`value` must be a string"))
        if from == "json" {
            let json = parse(text) else return Outcome.Failed(String("`value` isn't JSON"))
            value = json
        } else {
            match parse_snbt(text) {
                ok(tag) => value = tag.to_typed_json(),
                err(_) => return Outcome.Failed(String("`value` isn't SNBT")),
            }
        }
    }
    if let s = wire_stack {
        let applied = apply_wire(mut codecs, s, registries)
        output.push(Member { key: "empty", value: Json.Bool(false) })
        if to == "hash" {
            // What vanilla's encoder can't write, a type that isn't saved or a value its codec
            // doesn't take, hashes as the encoder's error.
            var patch = List<(String, Tag)>()
            var errors = List<(String, String)>()
            codecs.writing = true
            for (k, v, raw) in applied.patch {
                patch.push((k.copy(), v.copy()))
                if k.starts_with("!") {
                    continue
                }
                match codecs.find("component {k}") {
                    some(place) => {
                        var refs = Refs.new()
                        if let e = codecs.read(place, raw, registries, mut refs).error {
                            errors.push((k.copy(), "error: {e}"))
                        }
                    },
                    none => errors.push((k.copy(), "error: Component of type {k} is not encodable")),
                }
            }
            codecs.writing = false
            codecs.nbt = true
            output.push(Member { key: "hash", value: hashed(codecs, registries, s.item, s.count, patch, errors) })
            return Outcome.Done { output: output, blobs: [] }
        }
        if let e = applied.error {
            output.push(Member { key: "write_error", value: Json.Str(e.copy()) })
            return Outcome.Done { output: output, blobs: [] }
        }
        return written(output, applied.nbt ?? Tag.End)
    }
    var refs = Refs.new()
    var read = codecs.read(at, value, registries, mut refs)
    if let e = read.error.take() {
        output.push(Member { key: "error", value: Json.Str(e) })
        output.push(Member { key: "partial", value: Json.Bool(read.value != none) })
        return Outcome.Done { output: output, blobs: [] }
    }
    let tag = read.value.take() ?? Tag.End
    output.push(Member { key: "empty", value: Json.Bool(false) })
    if to == "hash" {
        // An alternative is picked by reading what was written back, as NBT.
        codecs.nbt = true
        let Tag.Compound(m) = tag else return Outcome.Failed(String("the stack read isn't a compound"))
        let item = match m["id"] {
            Tag.Str(i) => i.copy(),
            _ => String(),
        }
        let count = if not m.contains("count") { 1 } else {
            match m["count"] {
                Tag.Int(n) => n,
                _ => 1,
            }
        }
        var patch = List<(String, Tag)>()
        if m.contains("components") {
            match m["components"] {
                Tag.Compound(p) => {
                    for (k, v) in p {
                        patch.push((k.copy(), v.copy()))
                    }
                },
                _ => {},
            }
        }
        output.push(Member { key: "hash", value: hashed(codecs, registries, item, count, patch, List<(String, String)>()) })
        return Outcome.Done { output: output, blobs: [] }
    }
    if to == "wire" {
        var w = Writer.new()
        streams.write_stack(some(tag), value, registries, mut w)
        if let problem = w.problem() {
            output.push(Member { key: "write_error", value: Json.Str(problem) })
            return Outcome.Done { output: output, blobs: [] }
        }
        return Outcome.Done { output: output, blobs: [w.into_bytes()] }
    }
    return written(output, tag)
}

// A stack off the network as `world.item` reads it, made with `c`, and sent again, as a
// packet's is, reading `total` bytes from `rd`.
fn sent_again(rd: mut Reader, total: usize, streams: Streams, c: mut Codecs, registries: Registries) -> Outcome {
    var output = List<Member>()
    let stack = match ItemStack.read(mut rd, streams, mut c, registries) {
        ok(s) => s,
        err(e) => {
            if e.message.starts_with("Calcite reads the stream of ") {
                return Outcome.Unimplemented(e.message)
            }
            output.push(Member { key: "error", value: Json.Str(java_exception(e.message, total)) })
            return Outcome.Done { output: output, blobs: [] }
        },
    }
    // Vanilla says what's left before whether it's empty.
    if rd.left() != 0 {
        output.push(Member { key: "left", value: Json.Number("{rd.left()}") })
    }
    output.push(Member { key: "empty", value: Json.Bool(stack.is_empty()) })
    var w = Writer.new()
    stack.sent(streams, registries).write(mut w)
    if let problem = w.problem() {
        output.push(Member { key: "write_error", value: Json.Str(problem) })
        return Outcome.Done { output: output, blobs: [] }
    }
    return Outcome.Done { output: output, blobs: [w.into_bytes()] }
}

// The stack as a slot's `HashedStack` has it, as the vanilla adapter writes it: its item, its
// count, each component its patch sets, by its type's ID in order, with its value hashed with its
// codec, or the error in `errors` for one vanilla's encoder can't write, and each type its patch
// takes away, in order.
fn hashed(c: Codecs, r: Registries, item: String, count: i32, patch: List<(String, Tag)>, errors: List<(String, String)>) -> Json {
    var names = List<String>()
    var removed = List<String>()
    for (k, _) in patch {
        if k.starts_with("!") {
            removed.push(k[1..].copy())
        } else {
            names.push(k.copy())
        }
    }
    names.sort()
    removed.sort()
    var added = List<Member>()
    for name in names {
        for (k, v) in patch {
            if k == name {
                var failed: String? = none
                for (n, e) in errors {
                    if n == name {
                        failed = some(e.copy())
                    }
                }
                if let e = failed {
                    added.push(Member { key: name.copy(), value: Json.Str(e) })
                    break
                }
                let h = match c.find("component {k}") {
                    some(at) => c.hash(at, v, r),
                    none => hash_tag(v),
                }
                added.push(Member { key: name.copy(), value: Json.Number("{i32.wrap(h)}") })
                break
            }
        }
    }
    var gone = List<Json>()
    for k in removed {
        gone.push(Json.Str(k.copy()))
    }
    return Json.Object([
        Member { key: "item", value: Json.Str(item.copy()) },
        Member { key: "count", value: Json.Number("{count}") },
        Member { key: "added", value: Json.Object(added) },
        Member { key: "removed", value: Json.Array(gone) },
    ])
}

// The output with the stack's NBT, as `writeAnyTag` writes it.
fn written(output: own List<Member>, tag: Tag) -> Outcome {
    var bytes = List<u8>()
    match tag.write_any(mut bytes) {
        ok => {},
        err(message) => return Outcome.Failed(message),
    }
    return Outcome.Done { output: output, blobs: [bytes] }
}

// What vanilla's decoder throws for a stack the network's bytes don't hold, as `toString` gives
// it, from Calcite's message for it, reading `total` bytes from Netty's wrapped array: a read past
// the end is Netty's `IndexOutOfBoundsException`, and too many elements or a string too long is
// a `DecoderException`.
fn java_exception(message: String, total: usize) -> String {
    if message.starts_with("not enough bytes: ") {
        // "not enough bytes: <wanted> wanted, <left> left"
        var numbers = List<usize>()
        var n: usize = 0
        var digits = false
        for i in 18..message.len() {
            let b = message.byte_at(i)
            if b >= 48 and b <= 57 {
                n = n * 10 + usize(b - 48)
                digits = true
            } else if digits {
                numbers.push(n)
                n = 0
                digits = false
            }
        }
        if numbers.len() == 2 {
            let at = total - numbers[1]
            return "java.lang.IndexOutOfBoundsException: readerIndex({at}) + length({numbers[0]}) exceeds writerIndex({total}): UnpooledHeapByteBuf(ridx: {at}, widx: {total}, cap: {total}/{total})"
        }
    }
    if message.contains("elements exceeded max size of") or message.starts_with("The received") or message.starts_with("Not enough bytes in buffer") {
        return "io.netty.handler.codec.DecoderException: {message}"
    }
    if message.starts_with("ReportedNbtException") {
        return "net.minecraft.nbt.{message}"
    }
    return message.copy()
}
