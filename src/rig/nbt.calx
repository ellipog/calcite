/// The `nbt` probe (rig/PROTOCOL.md): a tag read from binary NBT by nbt.tag, or from SNBT by
/// nbt.snbt, then printed as SNBT and written back in network and file form.
module rig.nbt

import chat.language.{Language}
import json.tree.{Json, Member, as_string, take}
import nbt.snbt.{SyntaxError, parse, parse_compound}
import nbt.tag.{Accounter, Tag, read_any}
import pack.vanilla.{vanilla_language, vanilla_pack}
import rig.frame.{Outcome}
import server.log.{Entry}

/// The language SNBT's errors are said in, vanilla's, from the pinned server jar at
/// oracle/jars/.
pub fn load_language() -> Language ! String {
    var logs = List<Entry>()
    let pack = try vanilla_pack(String("oracle/jars/server-26.3.jar"))
    let lang = try vanilla_language(pack, mut logs)
    return lang
}

/// Runs a case. SNBT is read as vanilla's `TagParser.parseCompoundFully` reads it for `snbt`,
/// and as `parseFully` does for `snbt_any`. The language loads into `lang` on the first error
/// that needs it, and stays.
pub fn run_nbt(input: own List<Member>, blobs: own List<List<u8>>, lang: mut Language?) -> Outcome {
    var i = input
    let from = as_string(take(mut i, "from") ?? Json.Null) ?? String()
    if from == "snbt" or from == "snbt_any" {
        let text = as_string(take(mut i, "snbt") ?? Json.Null) else return Outcome.Failed(String("`snbt` must be a string"))
        if from == "snbt" {
            return match parse_compound(text) {
                ok(tag) => describe(tag),
                err(e) => syntax(e, mut lang),
            }
        }
        return match parse(text) {
            ok(tag) => describe(tag),
            err(e) => syntax(e, mut lang),
        }
    }
    if from != "binary" {
        return Outcome.Failed("unknown `from`: `{from}`")
    }
    if blobs.len() != 1 {
        return Outcome.Failed(String("`binary` takes one blob"))
    }
    var at: usize = 0
    var accounter = Accounter.unlimited()
    let tag = match read_any(blobs[0], mut at, mut accounter) {
        ok(t) => t,
        err(e) => return Outcome.Done { output: rejection(e.exception, e.message), blobs: [] },
    }
    return describe(tag)
}

// A rejection of SNBT, as brigadier's `CommandSyntaxException` says it in vanilla's language.
fn syntax(e: SyntaxError, lang: mut Language?) -> Outcome {
    if lang == none {
        match load_language() {
            ok(l) => lang = some(l),
            err(message) => return Outcome.Failed(message),
        }
    }
    let said = match lang {
        some(l) => e.text(l),
        none => String(),
    }
    return Outcome.Done { output: rejection(String("CommandSyntaxException"), said), blobs: [] }
}

// What the probe says of a tag: its SNBT, its type, whether it can be written in network form,
// and that form and the file form.
fn describe(tag: Tag) -> Outcome {
    var output: List<Member> = [
        Member { key: "snbt", value: Json.Str(tag.to_snbt()) },
        Member { key: "type", value: Json.Number("{tag.id()}") },
    ]
    var network = List<u8>()
    match tag.write_any(mut network) {
        ok => output.push(Member { key: "network", value: Json.Str("ok") }),
        err(message) => output.push(Member { key: "network", value: Json.Object(rejection(String("UTFDataFormatException"), message)) }),
    }
    var file = List<u8>()
    tag.write_unnamed(mut file)
    return Outcome.Done { output: output, blobs: [network, file] }
}

// A rejection as the vanilla adapter writes one: the exception's simple class name and message.
fn rejection(exception: own String, message: own String) -> List<Member> {
    return [Member { key: "exception", value: Json.Str(exception) }, Member { key: "error", value: Json.Str(message) }]
}
