/// The `nbt` probe (rig/PROTOCOL.md): a tag read from binary NBT, then printed as SNBT and
/// written back in network and file form, by nbt.tag. SNBT input waits for the SNBT parser.
module rig.nbt

import json.tree.{Json, Member, as_string, take}
import nbt.tag.{Accounter, read_any}
import rig.frame.{Outcome}

pub fn run_nbt(input: own List<Member>, blobs: own List<List<u8>>) -> Outcome {
    var i = input
    let from = as_string(take(mut i, "from") ?? Json.Null) ?? String()
    if from == "snbt" or from == "snbt_any" {
        return Outcome.Unimplemented(String("Calcite can't parse SNBT yet"))
    }
    if from != "binary" {
        return Outcome.Failed("unknown `from`: `{from}`")
    }
    if blobs.len() != 1 {
        return Outcome.Failed(String("`binary` takes one blob"))
    }
    var at: usize = 0
    var accounter = Accounter.unlimited()
    let tag = match read_any(blobs[0], mut at, mut accounter) {
        ok(t) => t,
        err(e) => return Outcome.Done { output: rejection(e.exception, e.message), blobs: [] },
    }
    var output: List<Member> = [
        Member { key: "snbt", value: Json.Str(tag.to_snbt()) },
        Member { key: "type", value: Json.Number("{tag.id()}") },
    ]
    var network = List<u8>()
    match tag.write_any(mut network) {
        ok => output.push(Member { key: "network", value: Json.Str("ok") }),
        err(message) => output.push(Member { key: "network", value: Json.Object(rejection(String("UTFDataFormatException"), message)) }),
    }
    var file = List<u8>()
    tag.write_unnamed(mut file)
    return Outcome.Done { output: output, blobs: [network, file] }
}

// A rejection as the vanilla adapter writes one: the exception's simple class name and message.
fn rejection(exception: own String, message: own String) -> List<Member> {
    return [Member { key: "exception", value: Json.Str(exception) }, Member { key: "error", value: Json.Str(message) }]
}
