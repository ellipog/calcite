/// The `datafix` probe (rig/PROTOCOL.md): data saved by an older game, upgraded by datafix's
/// port of vanilla's data fixes, as a structure template is when it loads.
module rig.datafix

import datafix.fixes.{fix_structure}
import json.tree.{Json, Member, as_string, take}
import nbt.snbt.{parse_compound}
import nbt.tag.{Accounter, Tag}
import rig.frame.{Outcome}
import storage.world.{read_gzipped}

/// Runs a case: `type` is `structure`; the data is `snbt`, or a gzipped NBT file as the blob;
/// `version` is the data version it's from, or else its `DataVersion`, 500 without one.
pub fn run_datafix(input: own List<Member>, blobs: own List<List<u8>>) -> Outcome {
    var i = input
    let kind = as_string(take(mut i, "type") ?? Json.Null) ?? String()
    if kind != "structure" {
        return Outcome.Failed("unknown `type`: `{kind}`")
    }
    var root = JavaHashMap<String, Tag>()
    if let s = take(mut i, "snbt") {
        let text = as_string(s) else return Outcome.Failed(String("`snbt` must be a string"))
        match parse_compound(text) {
            ok(Tag.Compound(m)) => root = m,
            ok(_) => return Outcome.Failed(String("`snbt` must be a compound")),
            err(_) => return Outcome.Failed(String("`snbt` doesn't parse")),
        }
    } else {
        if blobs.len() != 1 {
            return Outcome.Failed(String("the data is one blob"))
        }
        var accounter = Accounter.unlimited()
        match read_gzipped(blobs[0], mut accounter) {
            ok(m) => root = m,
            err(e) => return Outcome.Failed("the blob doesn't read: {e}"),
        }
    }
    var from = 500
    if let v = take(mut i, "version") {
        // A data version is an int64 of the protocol, so a string of digits.
        let text = as_string(v) else return Outcome.Failed(String("`version` must be a string"))
        let long = i64.parse(text) else return Outcome.Failed(String("`version` must be a decimal 64-bit integer"))
        // The vanilla probe's `(int)` cast.
        from = i32.wrap(long)
    } else if root.contains("DataVersion") {
        from = root["DataVersion"].number_int() ?? 500
    }
    let fixed = match fix_structure(root, from) {
        ok(some(m)) => m,
        // Vanilla's fixer throws, and the template doesn't load.
        ok(none) => return Outcome.Done { output: [Member { key: "loads", value: Json.Bool(false) }], blobs: [] },
        err(why) => return Outcome.Failed(why),
    }
    return Outcome.Done { output: [Member { key: "snbt", value: Json.Str(Tag.Compound(fixed).to_snbt()) }], blobs: [] }
}
