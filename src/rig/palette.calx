/// The `palette` probe (rig/PROTOCOL.md): std.palette's containers and bit storage, run by a
/// list of operations, each result written to one blob, which the rig compares with what
/// vanilla's PalettedContainer and SimpleBitStorage give for the same operations.
module rig.palette

import rig.frame.{Outcome}
import json.tree.{Json, Member, as_i32, as_string, push_text, take}
import std.palette.{BitStorage, Error, Packed, PalettedContainer, Strategy}

pub fn run_palette(input: own List<Member>, blobs: List<List<u8>>) -> Outcome {
    if not blobs.is_empty() {
        return Outcome.Failed("`palette` takes no blobs")
    }
    var fields = input
    let ops_value = take(mut fields, "ops") else return Outcome.Failed("missing field `ops`")
    let ops = match ops_value {
        Json.Array(items) => items,
        _ => return Outcome.Failed("`ops` must be an array"),
    }
    let of = as_string(take(mut fields, "of") ?? Json.Null) ?? String()
    var out: List<u8> = []
    if of == "container" {
        match container(mut fields, ops, mut out) {
            ok => {},
            err(message) => return Outcome.Failed(message),
        }
    } else if of == "storage" {
        match storage(mut fields, ops, mut out) {
            ok => {},
            err(message) => return Outcome.Failed(message),
        }
    } else {
        return Outcome.Failed("`of` must be container or storage")
    }
    return Outcome.Done { output: [], blobs: [out] }
}

/// The probe's 64-bit LCG: each draw is the top 31 bits of the next state.
struct Draws {
    x: i64
}

impl Draws {
    fn next(mut self) -> i32 {
        self.x = self.x * 6364136223846793005 + 1442695040888963407
        return i32.wrap(self.x >>> 33)
    }
}

// --- containers ---------------------------------------------------------------------------------

fn container(fields: mut List<Member>, ops: List<Json>, out: mut List<u8>) ! String {
    let registry = as_i32(take(mut fields, "registry") ?? Json.Null) else fail String("`registry` must be a 32-bit integer")
    if registry < 1 or registry > 1048576 {
        fail String("`registry` must be from 1 to 1048576")
    }
    let kind = as_string(take(mut fields, "strategy") ?? Json.Null) ?? String()
    let strategy = if kind == "block_states" {
        Strategy.block_states(u32.wrap(registry))
    } else if kind == "biomes" {
        Strategy.biomes(u32.wrap(registry))
    } else {
        fail String("`strategy` must be block_states or biomes")
    }
    let first = try value_of(take(mut fields, "value") ?? Json.Null, registry, String("`value`"))
    let entries = i32.wrap(strategy.size())
    var c = PalettedContainer.new(first, strategy)
    for k in 0..ops.len() {
        let items = try items_of(ops, k)
        let name = as_string(items[0]) ?? String()
        if name == "set" {
            try expect(items, k, 2)
            let i = try index_of(items, k, 1, entries)
            c.set_at(i, try value_of(items[2], registry, what(k, 2)))
        } else if name == "get" {
            try expect(items, k, 1)
            put_u32(mut out, c.get_at(try index_of(items, k, 1, entries)))
        } else if name == "get_and_set" {
            try expect(items, k, 2)
            let i = try index_of(items, k, 1, entries)
            put_u32(mut out, c.get_and_set_at(i, try value_of(items[2], registry, what(k, 2))))
        } else if name == "random_sets" {
            try expect(items, k, 4)
            var draws = try draws_of(items, k)
            let count = try number_of(items, k, 2)
            let low = i32.wrap(try value_of(items[3], registry, what(k, 3)))
            let high = try number_of(items, k, 4)
            if high <= low or high > registry {
                fail "{what(k, 4)} must be above the low value and at most the registry's size"
            }
            for _ in 0..count {
                let i = draws.next() % entries
                let v = low + draws.next() % (high - low)
                c.set_at(usize.wrap(i), u32.wrap(v))
            }
        } else if name == "bits" {
            try expect(items, k, 0)
            put_u32(mut out, u32.wrap(c.bits()))
        } else if name == "write" {
            try expect(items, k, 0)
            var sent: List<u8> = []
            c.write(mut sent)
            put_size(mut out, sent.len())
            for b in sent {
                out.push(b)
            }
        } else if name == "pack" {
            try expect(items, k, 0)
            let packed = c.pack()
            put_size(mut out, packed.palette.len())
            for v in packed.palette {
                put_u32(mut out, v)
            }
            if let data = packed.data {
                out.push(1)
                put_longs(mut out, data)
            } else {
                out.push(0)
            }
        } else if name == "unpack" {
            try expect(items, k, 2)
            var palette: List<u32> = []
            match items[1] {
                Json.Array(values) => {
                    for v in values {
                        palette.push(try value_of(v, registry, "{what(k, 1)}'s entry"))
                    }
                },
                _ => fail "{what(k, 1)} must be an array",
            }
            let data: List<i64>? = match items[2] {
                Json.Null => none,
                _ => some(try longs_of(items[2], what(k, 2))),
            }
            unpacked(mut c, strategy, Packed { palette: palette, data: data }, mut out)
        } else if name == "repack" {
            try expect(items, k, 0)
            let packed = c.pack()
            unpacked(mut c, strategy, packed, mut out)
        } else if name == "counts" {
            try expect(items, k, 0)
            // Vanilla gives its counts in a hash map's order, so the probe sorts them.
            var counts = c.counts()
            counts.sort()
            put_size(mut out, counts.len())
            for (v, n) in counts {
                put_u32(mut out, v)
                put_size(mut out, n)
            }
        } else {
            fail "operation {k}: a container has no `{name}`"
        }
    }
}

/// Replaces `c` with what `packed` unpacks to, writing 0, or 1 and the message if it fails.
fn unpacked(c: mut PalettedContainer, strategy: Strategy, packed: own Packed, out: mut List<u8>) {
    match PalettedContainer.unpack(strategy, packed) {
        ok(u) => {
            c = u
            out.push(0)
        },
        err(e) => {
            out.push(1)
            put_text(mut out, unpack_message(e))
        },
    }
}

/// What vanilla's `DataResult` says for the same failure. Vanilla doesn't fail for an empty
/// palette or an index past its end (D163), so those messages are Calcite's own.
fn unpack_message(e: Error) -> String {
    return match e {
        Error.Empty => String("the palette is empty"),
        Error.MissingData => String("Missing values for non-zero storage"),
        Error.Length { got, expected } => "Failed to read PalettedContainer: {length_message(got, expected)}",
        Error.Index { at, index } => "value {at} is palette index {index}, past the palette's end",
    }
}

fn length_message(got: usize, expected: usize) -> String {
    return "Invalid length given for storage, got: {got} but expected: {expected}"
}

// --- bit storage --------------------------------------------------------------------------------

fn storage(fields: mut List<Member>, ops: List<Json>, out: mut List<u8>) ! String {
    let bits = as_i32(take(mut fields, "bits") ?? Json.Null) else fail String("`bits` must be a 32-bit integer")
    let size = as_i32(take(mut fields, "size") ?? Json.Null) else fail String("`size` must be a 32-bit integer")
    if bits < 1 or bits > 32 {
        fail String("`bits` must be from 1 to 32")
    }
    if size < 0 or size > 4096 {
        fail String("`size` must be from 0 to 4096")
    }
    let mask = (1i64 << bits) - 1
    var s = BitStorage.new(bits, usize.wrap(size))
    for k in 0..ops.len() {
        let items = try items_of(ops, k)
        let name = as_string(items[0]) ?? String()
        if name == "set" {
            try expect(items, k, 2)
            let i = try index_of(items, k, 1, size)
            s.set(i, try fitting(items, k, 2, mask))
        } else if name == "fill" {
            try expect(items, k, 1)
            s.fill(try fitting(items, k, 1, mask))
        } else if name == "get" {
            try expect(items, k, 1)
            put_u32(mut out, s.get(try index_of(items, k, 1, size)))
        } else if name == "get_and_set" {
            try expect(items, k, 2)
            let i = try index_of(items, k, 1, size)
            put_u32(mut out, s.get_and_set(i, try fitting(items, k, 2, mask)))
        } else if name == "random_sets" {
            try expect(items, k, 4)
            if size == 0 {
                fail "operation {k}: an empty storage has nowhere to set"
            }
            var draws = try draws_of(items, k)
            let count = try number_of(items, k, 2)
            let low = i64(try fitting(items, k, 3, mask))
            let high = i64(try number_of(items, k, 4))
            if high <= low or high - 1 > mask {
                fail "{what(k, 4)} must be above the low value and fit the bits"
            }
            for _ in 0..count {
                let i = draws.next() % size
                s.set(usize.wrap(i), u32.wrap(low + i64(draws.next()) % (high - low)))
            }
        } else if name == "longs" {
            try expect(items, k, 0)
            put_longs(mut out, s.longs())
        } else if name == "values" {
            try expect(items, k, 0)
            let values = s.values()
            put_size(mut out, values.len())
            for v in values {
                put_u32(mut out, v)
            }
        } else if name == "load" {
            try expect(items, k, 1)
            match BitStorage.from_longs(bits, usize.wrap(size), try longs_of(items[1], what(k, 1))) {
                ok(loaded) => {
                    s = loaded
                    out.push(0)
                },
                err(e) => {
                    out.push(1)
                    put_text(mut out, match e {
                        Error.Length { got, expected } => length_message(got, expected),
                        _ => String("the storage didn't load"),
                    })
                },
            }
        } else {
            fail "operation {k}: a storage has no `{name}`"
        }
    }
}

// --- reading operations -------------------------------------------------------------------------

/// Operation `k`'s items, a non-empty array named by a string.
fn items_of(ops: List<Json>, k: usize) -> List<Json> ! String {
    match ops[k] {
        Json.Array(items) => {
            if not items.is_empty() and as_string(items[0]) != none {
                return items.copy()
            }
        },
        _ => {},
    }
    fail "operation {k} must be a non-empty array named by a string"
}

fn what(k: usize, i: usize) -> String {
    return "operation {k}'s argument {i}"
}

fn expect(items: List<Json>, k: usize, n: usize) ! String {
    if items.len() != n + 1 {
        fail "operation {k}: `{as_string(items[0]) ?? String()}` takes {n} arguments, got {items.len() - 1}"
    }
}

fn number_of(items: List<Json>, k: usize, i: usize) -> i32 ! String {
    let n = as_i32(items[i]) else fail "{what(k, i)} must be a 32-bit integer"
    return n
}

/// Argument `i`, an index below `size`.
fn index_of(items: List<Json>, k: usize, i: usize, size: i32) -> usize ! String {
    let n = try number_of(items, k, i)
    if n < 0 or n >= size {
        fail "{what(k, i)} must be an index below {size}"
    }
    return usize.wrap(n)
}

/// A registry value: an ID below the registry's size.
fn value_of(item: Json, registry: i32, label: String) -> u32 ! String {
    let id = as_i32(item) else fail "{label} must be a 32-bit integer"
    if id < 0 or id >= registry {
        fail "{label} must be from 0 to {registry - 1}"
    }
    return u32.wrap(id)
}

/// Argument `i`, a value that fits in the storage's bits.
fn fitting(items: List<Json>, k: usize, i: usize, mask: i64) -> u32 ! String {
    let v = try number_of(items, k, i)
    if v < 0 or i64(v) > mask {
        fail "{what(k, i)} must be from 0 to {mask}"
    }
    return u32.wrap(v)
}

/// The LCG seeded by argument 1, a long written as a string.
fn draws_of(items: List<Json>, k: usize) -> Draws ! String {
    let seed = i64.parse(as_string(items[1]) ?? String()) else fail "{what(k, 1)} must be a long written as a string"
    return Draws { x: seed }
}

fn longs_of(item: Json, label: String) -> List<i64> ! String {
    var longs: List<i64> = []
    match item {
        Json.Array(values) => {
            for v in values {
                let l = i64.parse(as_string(v) ?? String()) else fail "{label}'s long must be written as a string"
                longs.push(l)
            }
        },
        _ => fail "{label} must be an array or null",
    }
    return longs
}

// --- writing results ----------------------------------------------------------------------------

fn put_u32(out: mut List<u8>, v: u32) {
    out.push(u8.wrap(v >> 24))
    out.push(u8.wrap(v >> 16))
    out.push(u8.wrap(v >> 8))
    out.push(u8.wrap(v))
}

fn put_size(out: mut List<u8>, n: usize) {
    put_u32(mut out, u32.wrap(n))
}

fn put_longs(out: mut List<u8>, longs: List<i64>) {
    put_size(mut out, longs.len())
    for l in longs {
        put_u32(mut out, u32.wrap(l >> 32))
        put_u32(mut out, u32.wrap(l))
    }
}

/// An `int` length, then the text as UTF-8.
fn put_text(out: mut List<u8>, text: String) {
    put_size(mut out, text.len())
    push_text(mut out, text)
}
