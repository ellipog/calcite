/// The `light` probe (rig/PROTOCOL.md): `world.light`'s engines over chunks the case makes, run
/// by a list of operations, each result written to one blob, which the rig compares with what
/// vanilla's `LevelLightEngine` gives for the same operations.
module rig.light

import json.tree.{Json, Member, as_i32, as_string, take}
import protocol.wire.{Writer}
import rig.frame.{Outcome}
import world.chunk.{BlockStates, Chunk}
import world.light.{Layer, Light, LightChunks, LightStates, SkySources, light_sources}

// How far from 0 a chunk may be, each way.
const CHUNKS: i32 = 1000

pub fn run_light(input: own List<Member>, blobs: List<List<u8>>) -> Outcome {
    if not blobs.is_empty() {
        return Outcome.Failed("`light` takes no blobs")
    }
    var fields = input
    let ops_value = take(mut fields, "ops") else return Outcome.Failed("missing field `ops`")
    let ops = match ops_value {
        Json.Array(items) => items,
        _ => return Outcome.Failed("`ops` must be an array"),
    }
    let min_y = as_i32(take(mut fields, "min_y") ?? Json.Null) else return Outcome.Failed("`min_y` must be a 32-bit integer")
    let sections = as_i32(take(mut fields, "sections") ?? Json.Null) else return Outcome.Failed("`sections` must be a 32-bit integer")
    if min_y & 15 != 0 or min_y < -2032 or sections < 1 or sections > 254 or min_y + sections * 16 > 2032 {
        return Outcome.Failed("`min_y` must be a multiple of 16 and the sections inside -2032 to 2032")
    }
    let sky = as_i32(take(mut fields, "sky") ?? Json.Null) ?? -1
    if sky != 0 and sky != 1 {
        return Outcome.Failed("`sky` must be 0 or 1")
    }
    var out: List<u8> = []
    match run_ops(min_y, sections, sky == 1, ops, mut out) {
        ok => {},
        err(message) => return Outcome.Failed(message),
    }
    return Outcome.Done { output: [], blobs: [out] }
}

/// The probe's 64-bit LCG, as `palette`'s.
struct Draws {
    x: i64
}

impl Draws {
    fn next(mut self) -> i32 {
        self.x = self.x * 6364136223846793005 + 1442695040888963407
        return i32.wrap(self.x >>> 33)
    }
}

fn key(chunk_x: i32, chunk_z: i32) -> i64 {
    return (i64(chunk_x) << 32) | (i64(chunk_z) & 0xFFFFFFFF)
}

/// The case's chunks, each with its sky sources, as vanilla's `LightChunkGetter` gives them.
struct World {
    table: BlockStates
    states: LightStates
    min_y: i32
    sections: i32
    chunks: Map<i64, Chunk> = Map<i64, Chunk>()
    sources: Map<i64, SkySources> = Map<i64, SkySources>()
}

impl LightChunks for World {
    fn light_state(self, x: i32, y: i32, z: i32) -> u32? {
        let k = key(x >> 4, z >> 4)
        if not self.chunks.contains(k) {
            return none
        }
        return some(self.chunks[k].block(x & 15, y, z & 15))
    }

    fn lowest_sky_source(self, x: i32, z: i32) -> i32? {
        let k = key(x >> 4, z >> 4)
        if not self.sources.contains(k) {
            return none
        }
        return some(self.sources[k].lowest_source_y(x & 15, z & 15))
    }

    fn highest_sky_source(self, chunk_x: i32, chunk_z: i32) -> i32? {
        let k = key(chunk_x, chunk_z)
        if not self.sources.contains(k) {
            return none
        }
        return some(self.sources[k].highest_lowest_source_y())
    }

    fn light_sources_in(self, chunk_x: i32, chunk_z: i32) -> List<i64> {
        let k = key(chunk_x, chunk_z)
        if not self.chunks.contains(k) {
            return []
        }
        return light_sources(self.chunks[k], self.states, chunk_x, chunk_z)
    }
}

fn run_ops(min_y: i32, sections: i32, sky: bool, ops: List<Json>, out: mut List<u8>) ! String {
    // The block tags don't matter to light, so the table has none.
    var world = World { table: BlockStates.new([], [], 1), states: LightStates.new(), min_y: min_y, sections: sections }
    var light = Light.new(min_y, sections * 16, sky)
    let top = min_y + sections * 16 - 1
    let min_section = min_y >> 4
    let max_section = min_section + sections - 1
    let states = i32.wrap(world.table.len())
    let low = -CHUNKS * 16
    let high = CHUNKS * 16 + 15
    for k in 0..ops.len() {
        let items = try items_of(ops, k)
        let name = as_string(items[0]) ?? String()
        if name == "chunk" {
            try expect(items, k, 2)
            let cx = try within(items, k, 1, -CHUNKS, CHUNKS)
            let cz = try within(items, k, 2, -CHUNKS, CHUNKS)
            if world.chunks.contains(key(cx, cz)) {
                fail "operation {k}: there's a chunk at {cx}, {cz} already"
            }
            world.chunks.insert(key(cx, cz), Chunk.new(world.table, min_y, sections, 0))
            world.sources.insert(key(cx, cz), SkySources.new(min_y))
        } else if name == "fill" {
            // Every block from one corner to the other, y, then x, then z, with nothing told.
            try expect(items, k, 7)
            let x0 = try within(items, k, 1, low, high)
            let y0 = try within(items, k, 2, min_y, top)
            let z0 = try within(items, k, 3, low, high)
            let x1 = try within(items, k, 4, x0, x0 + 255)
            let y1 = try within(items, k, 5, y0, top)
            let z1 = try within(items, k, 6, z0, z0 + 255)
            let state = u32.wrap(try within(items, k, 7, 0, states - 1))
            for y in y0..y1 + 1 {
                for x in x0..x1 + 1 {
                    for z in z0..z1 + 1 {
                        try put(mut world, k, x, y, z, state)
                    }
                }
            }
        } else if name == "random" {
            // `count` states from the list, each at a block in the box, set with nothing told or
            // as `LevelChunk` sets it, by `tell`.
            try expect(items, k, 10)
            let tell = try within(items, k, 1, 0, 1) == 1
            var draws = Draws { x: try seed(items, k, 2) }
            let count = try within(items, k, 3, 0, 1 << 20)
            var list: List<u32> = []
            match items[4] {
                Json.Array(values) => {
                    for v in values {
                        let id = as_i32(v) ?? -1
                        if id < 0 or id >= states {
                            fail "{what(k, 4)}'s entries must be block state IDs, from 0 to {states - 1}"
                        }
                        list.push(u32.wrap(id))
                    }
                },
                _ => {},
            }
            if list.is_empty() {
                fail "{what(k, 4)} must be a non-empty array of block state IDs"
            }
            let x0 = try within(items, k, 5, low, high)
            let y0 = try within(items, k, 6, min_y, top)
            let z0 = try within(items, k, 7, low, high)
            let x1 = try within(items, k, 8, x0, x0 + 255)
            let y1 = try within(items, k, 9, y0, top)
            let z1 = try within(items, k, 10, z0, z0 + 255)
            let n = i32.wrap(list.len())
            for _ in 0..count {
                let x = x0 + draws.next() % (x1 - x0 + 1)
                let y = y0 + draws.next() % (y1 - y0 + 1)
                let z = z0 + draws.next() % (z1 - z0 + 1)
                let state = list[usize.wrap(draws.next() % n)]
                if tell {
                    _ = try set(mut world, mut light, k, x, y, z, state)
                } else {
                    try put(mut world, k, x, y, z, state)
                }
            }
        } else if name == "set" {
            try expect(items, k, 4)
            let x = try within(items, k, 1, low, high)
            let y = try within(items, k, 2, min_y, top)
            let z = try within(items, k, 3, low, high)
            let state = u32.wrap(try within(items, k, 4, 0, states - 1))
            match try set(mut world, mut light, k, x, y, z, state) {
                some(old) => put_i32(mut out, i32.wrap(old)),
                none => put_i32(mut out, -1),
            }
        } else if name == "sources" {
            // `initializeLightSources`, as the INITIALIZE_LIGHT status does first.
            try expect(items, k, 2)
            let cx = try within(items, k, 1, -CHUNKS, CHUNKS)
            let cz = try within(items, k, 2, -CHUNKS, CHUNKS)
            let c = try chunk_key(world, k, cx * 16, cz * 16)
            world.sources[c].fill_from(world.chunks[c], world.states)
        } else if name == "sections" {
            // What `ThreadedLevelLightEngine.initializeLight` tells first: each section with a
            // block that isn't air.
            try expect(items, k, 2)
            let cx = try within(items, k, 1, -CHUNKS, CHUNKS)
            let cz = try within(items, k, 2, -CHUNKS, CHUNKS)
            let c = try chunk_key(world, k, cx * 16, cz * 16)
            for i in 0..world.chunks[c].section_count() {
                if not world.chunks[c].section_only_air(i) {
                    light.update_section_status(cx, min_section + i32.wrap(i), cz, false)
                }
            }
        } else if name == "status" {
            try expect(items, k, 4)
            let sx = try within(items, k, 1, -CHUNKS, CHUNKS)
            let sy = try within(items, k, 2, min_section - 1, max_section + 1)
            let sz = try within(items, k, 3, -CHUNKS, CHUNKS)
            light.update_section_status(sx, sy, sz, try within(items, k, 4, 0, 1) == 1)
        } else if name == "enable" {
            try expect(items, k, 3)
            let cx = try within(items, k, 1, -CHUNKS, CHUNKS)
            let cz = try within(items, k, 2, -CHUNKS, CHUNKS)
            light.set_light_enabled(world, cx, cz, try within(items, k, 3, 0, 1) == 1)
        } else if name == "retain" {
            try expect(items, k, 3)
            let cx = try within(items, k, 1, -CHUNKS, CHUNKS)
            let cz = try within(items, k, 2, -CHUNKS, CHUNKS)
            light.retain_data(cx, cz, try within(items, k, 3, 0, 1) == 1)
        } else if name == "propagate" {
            try expect(items, k, 2)
            let cx = try within(items, k, 1, -CHUNKS, CHUNKS)
            let cz = try within(items, k, 2, -CHUNKS, CHUNKS)
            light.propagate_light_sources(world.states, world, cx, cz)
        } else if name == "check" {
            try expect(items, k, 3)
            let x = try within(items, k, 1, low, high)
            let y = try within(items, k, 2, min_y - 16, top + 16)
            let z = try within(items, k, 3, low, high)
            light.check_block(x, y, z)
        } else if name == "queue" {
            // Light for a section, as a save gives it: none, a layer of one level, or 2048 bytes
            // drawn from a seed.
            try expect(items, k, 6)
            let sky_layer = try within(items, k, 1, 0, 1) == 1
            let sx = try within(items, k, 2, -CHUNKS, CHUNKS)
            let sy = try within(items, k, 3, min_section - 1, max_section + 1)
            let sz = try within(items, k, 4, -CHUNKS, CHUNKS)
            let kind = try within(items, k, 5, 0, 2)
            if kind == 0 {
                light.queue_section_data(sky_layer, sx, sy, sz, none)
            } else if kind == 1 {
                light.queue_section_data(sky_layer, sx, sy, sz, some(Layer.filled(try within(items, k, 6, 0, 15))))
            } else {
                var draws = Draws { x: try seed(items, k, 6) }
                var bytes: List<u8> = []
                bytes.reserve(2048)
                for _ in 0..2048 {
                    bytes.push(u8.wrap(draws.next()))
                }
                light.queue_section_data(sky_layer, sx, sy, sz, some(Layer.of(bytes)))
            }
        } else if name == "run" {
            try expect(items, k, 0)
            put_i32(mut out, light.run(world.states, world))
        } else if name == "work" {
            try expect(items, k, 0)
            out.push(if light.has_work() { 1 } else { 0 })
        } else if name == "on" {
            try expect(items, k, 2)
            let cx = try within(items, k, 1, -CHUNKS, CHUNKS)
            let cz = try within(items, k, 2, -CHUNKS, CHUNKS)
            out.push(if light.light_on(cx, cz) { 1 } else { 0 })
        } else if name == "value" {
            try expect(items, k, 4)
            let sky_layer = try within(items, k, 1, 0, 1) == 1
            let x = try within(items, k, 2, low, high)
            let y = try within(items, k, 3, min_y - 64, top + 64)
            let z = try within(items, k, 4, low, high)
            out.push(u8.wrap(light.value(sky_layer, x, y, z)))
        } else if name == "layer" {
            // A section's light as a packet takes it: 0 for none, 1 for an empty layer, or 2 and
            // its bytes.
            try expect(items, k, 4)
            let sky_layer = try within(items, k, 1, 0, 1) == 1
            let sx = try within(items, k, 2, -CHUNKS, CHUNKS)
            let sy = try within(items, k, 3, min_section - 1, max_section + 1)
            let sz = try within(items, k, 4, -CHUNKS, CHUNKS)
            let kind = light.layer_kind(sky_layer, sx, sy, sz)
            out.push(u8.wrap(kind))
            if kind == 2 {
                for b in light.layer_bytes(sky_layer, sx, sy, sz) {
                    out.push(b)
                }
            }
        } else if name == "light" {
            // The chunk's light as `level_chunk_with_light` sends it.
            try expect(items, k, 2)
            let cx = try within(items, k, 1, -CHUNKS, CHUNKS)
            let cz = try within(items, k, 2, -CHUNKS, CHUNKS)
            var w = Writer.new()
            light.light_data(cx, cz).write(mut w)
            let sent = w.into_bytes()
            put_i32(mut out, i32.wrap(sent.len()))
            for b in sent {
                out.push(b)
            }
        } else {
            fail "operation {k}: unknown `{name}`"
        }
    }
}

fn chunk_key(world: World, k: usize, x: i32, z: i32) -> i64 ! String {
    let c = key(x >> 4, z >> 4)
    if not world.chunks.contains(c) {
        fail "operation {k}: there's no chunk at {x >> 4}, {z >> 4}"
    }
    return c
}

// A block set with nothing told, as generation sets them before light.
fn put(world: mut World, k: usize, x: i32, y: i32, z: i32, state: u32) ! String {
    let c = try chunk_key(world, k, x, z)
    _ = world.chunks[c].set_block(world.table, x & 15, y, z & 15, state)
}

// A block set as `LevelChunk.setBlockState` sets it, telling light: the old state, or `none` if
// nothing changed.
fn set(world: mut World, light: mut Light, k: usize, x: i32, y: i32, z: i32, state: u32) -> u32? ! String {
    let c = try chunk_key(world, k, x, z)
    let was_empty = world.chunks[c].section_only_air(usize.wrap((y - world.min_y) >> 4))
    let old = world.chunks[c].set_block(world.table, x & 15, y, z & 15, state) else return none
    light.block_set(world.states, world.chunks[c], mut world.sources[c], x >> 4, z >> 4, x & 15, y, z & 15, old, state, was_empty)
    return some(old)
}

fn items_of(ops: List<Json>, k: usize) -> List<Json> ! String {
    match ops[k] {
        Json.Array(items) => {
            if not items.is_empty() and as_string(items[0]) != none {
                return items.copy()
            }
        },
        _ => {},
    }
    fail "operation {k} must be a non-empty array named by a string"
}

fn what(k: usize, i: usize) -> String {
    return "operation {k}'s argument {i}"
}

fn expect(items: List<Json>, k: usize, n: usize) ! String {
    if items.len() != n + 1 {
        fail "operation {k}: `{as_string(items[0]) ?? String()}` takes {n} arguments, got {items.len() - 1}"
    }
}

/// Argument `i`, a number from `low` to `high`, both included.
fn within(items: List<Json>, k: usize, i: usize, low: i32, high: i32) -> i32 ! String {
    let n = as_i32(items[i]) else fail "{what(k, i)} must be a 32-bit integer"
    if n < low or n > high {
        fail "{what(k, i)} must be from {low} to {high}"
    }
    return n
}

/// Argument `i`, a long written as a string.
fn seed(items: List<Json>, k: usize, i: usize) -> i64 ! String {
    let s = i64.parse(as_string(items[i]) ?? String()) else fail "{what(k, i)} must be a long written as a string"
    return s
}

fn put_i32(out: mut List<u8>, v: i32) {
    out.push(u8.wrap(v >> 24))
    out.push(u8.wrap(v >> 16))
    out.push(u8.wrap(v >> 8))
    out.push(u8.wrap(v))
}
