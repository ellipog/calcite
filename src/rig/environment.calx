/// The `environment` probe (rig/PROTOCOL.md): `world.environment`'s dimension values of the
/// attributes the case reads, at each record's clocks and weather, as the vanilla adapter reads
/// vanilla's own `EnvironmentAttributeSystem` (D313).
///
/// The layers are a dimension type's, from the loaded registries' full contents as the server
/// builds a level's, or a map of attributes and timelines given as a data pack writes them, read
/// with the registries' codecs. Each record is the ticks every clock has run, an `i64`, then the
/// rain and thunder levels, `f32`s. Each attribute read is written as its float's bits, every NaN
/// as one, or a byte for a boolean.
module rig.environment

import json.tree.{Json, Member, as_string, take}
import nbt.tag.{Tag}
import protocol.wire.{Reader, Writer}
import registry.codec.{Codecs, Refs}
import registry.codecs.{attribute_map_codec, full_codec}
import registry.network.{network_codec}
import registry.registries.{Registries}
import resources.identifier.{Identifier}
import rig.frame.{Outcome}
import server.play.{environment_of}
import world.clocks.{Clocks}
import world.environment.{Environment, Kind, find, kind_at}

pub fn run_environment(input: own List<Member>, blobs: List<List<u8>>, registries: Registries) -> Outcome {
    var fields = input
    let weather = match take(mut fields, "weather") {
        some(Json.Bool(b)) => b,
        _ => return Outcome.Failed(String("`weather` must be a boolean")),
    }
    let names = match take(mut fields, "read") {
        some(Json.Array(items)) => items,
        _ => return Outcome.Failed(String("`read` must be an array")),
    }
    var read = List<usize>()
    for n in names {
        let name = as_string(n) else return Outcome.Failed(String("`read` must hold identifiers"))
        let at = find(name) else return Outcome.Failed("`{name}` is neither a float nor a boolean")
        read.push(at)
    }
    var clock_names = List<Identifier>()
    if let c = registries.find(String("world_clock")) {
        clock_names = registries.synced[c].entries.copy()
    }
    var env = match take(mut fields, "type") {
        some(t) => {
            let name = as_string(t) else return Outcome.Failed(String("`type` must be an identifier"))
            let id = match Identifier.parse(name.copy()) {
                ok(i) => i,
                err(_) => return Outcome.Failed(String("`type` must be an identifier")),
            }
            let r = registries.find(String("dimension_type")) else return Outcome.Failed(String("there's no dimension_type registry"))
            let type_id = registries.synced[r].id(id) else return Outcome.Failed("no dimension type `{name}`")
            match environment_of(registries, type_id, weather) {
                ok(e) => e,
                err(message) => return Outcome.Failed(message),
            }
        },
        none => match given(mut fields, registries, clock_names, weather) {
            ok(e) => e,
            err(message) => return Outcome.Failed(message),
        },
    }
    if blobs.len() != 1 or blobs[0].len() % 16 != 0 {
        return Outcome.Failed(String("`environment` takes one blob of 16-byte records"))
    }
    var clocks = Clocks.new(clock_names)
    var r = Reader.new(blobs[0].copy())
    var w = Writer.new()
    while r.left() > 0 {
        // The blob is whole records, so these all read.
        let ticks = r.i64()!
        let rain = r.f32()!
        let thunder = r.f32()!
        for c in 0..clocks.clocks.len() {
            clocks.clocks[c].total_ticks = ticks
        }
        // A new tick, as `ServerLevel.tick` starts one.
        env.invalidate()
        for at in read {
            let v = env.value(at, clocks, rain, thunder)
            if kind_at(at) == Kind.Float {
                w.i32(i32.wrap(if v.number.is_nan() { 0x7fc00000u32 } else { v.number.to_bits() }))
            } else {
                w.u8(if v.flag { 1u8 } else { 0u8 })
            }
        }
    }
    return Outcome.Done { output: [], blobs: [w.into_bytes()] }
}

// The environment of `attributes_map` and `timelines`, as a data pack writes a dimension type's
// map and its timelines, read with the codecs the registries read them with.
fn given(fields: mut List<Member>, registries: Registries, clocks: List<Identifier>, weather: bool) -> Environment ! String {
    var codecs = Codecs.new()
    _ = network_codec(mut codecs, String("timeline"))
    let map_codec = attribute_map_codec(mut codecs)
    let timeline_codec = full_codec(codecs, String("timeline")) else fail String("no codec for timelines")
    var refs = Refs.new()
    var attributes = Tag.End
    if let m = take(mut fields, "attributes_map") {
        attributes = try read_with(codecs, map_codec, m, registries, mut refs, "`attributes_map`")
    }
    var timelines = List<Tag>()
    if let list = take(mut fields, "timelines") {
        let Json.Array(items) = list else fail String("`timelines` must be an array")
        for i in 0..items.len() {
            timelines.push(try read_with(codecs, timeline_codec, items[i], registries, mut refs, "`timelines`[{i}]"))
        }
    }
    return Environment.build(attributes, timelines, clocks, weather)
}

fn read_with(codecs: Codecs, codec: usize, value: Json, registries: Registries, refs: mut Refs, what: String) -> Tag ! String {
    var got = codecs.read(codec, value, registries, mut refs)
    if let t = got.thrown.take() {
        fail "{what} doesn't read: {t}"
    }
    if let e = got.error.take() {
        fail "{what} doesn't read: {e}"
    }
    let v = got.value.take() else fail "{what} doesn't read"
    return v
}
