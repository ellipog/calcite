/// Scratch, for CAL-88: makes the terrain of N×N chunks from CX, CZ on one thread, with no
/// structures, and says how long each took on average, with a hash of what it made. Not a test.
///
///     calx run --release src/terrain_bench.calx -- SEED CX CZ N
module terrain_bench

import pack.vanilla.{vanilla_data}
import rig.registries.{load_vanilla}
import server.log.{Entry}
import server.play.{block_states}
import std.env.{args}
import std.time.{Instant}
import worldgen.generator.{BLOCK_SHIFT, GenSetup, Job, Made, TerrainJob, Worker}
import worldgen.references.{chunk_key}

fn number(s: String) -> i64 {
    var n: i64 = 0
    var neg = false
    for i in 0..s.len() {
        let c = s.byte_at(i)
        if c == 45 {
            neg = true
        } else {
            n = n * 10 + i64(c - 48)
        }
    }
    return if neg { -n } else { n }
}

fn main() ! String {
    let a = args()
    let seed = number(a[0])
    let cx0 = i32.wrap(number(a[1]))
    let cz0 = i32.wrap(number(a[2]))
    let n = i32.wrap(number(a[3]))
    let loaded = try load_vanilla()
    var lines = List<Entry>()
    let zip = try vanilla_data(String("build/fly/cache/vanilla-26.3.data"), mut lines)
    let b = loaded.registries.find_builtin(String("block")) else fail String("no block registry")
    let f = loaded.registries.find_builtin(String("fluid")) else fail String("no fluid registry")
    let bi = loaded.registries.find(String("worldgen/biome")) else fail String("no biome registry")
    let table = try block_states(loaded.registries)
    let uncarvable = loaded.registries.builtin[b].tag_values(String("uncarvable"))
    let setup = GenSetup { settings: String("minecraft:overworld"), blocks: loaded.registries.builtin[b].copy(), fluids: loaded.registries.builtin[f].copy(), biomes: loaded.registries.synced[bi].copy(), table: table, uncarvable: uncarvable, seed: seed }
    var w = try Worker.new(zip, setup)
    // The biomes of every chunk 1 or less from the square, by block.
    var biomes = Map<i64, List<i32>>()
    let t0 = unsafe { Instant.now() }
    for bz in (cz0 - 1) >> BLOCK_SHIFT..((cz0 + n) >> BLOCK_SHIFT) + 1 {
        for bx in (cx0 - 1) >> BLOCK_SHIFT..((cx0 + n) >> BLOCK_SHIFT) + 1 {
            match w.run(Job.Biomes(bx, bz)) {
                Made.Biomes(_, _, made, _) => {
                    var rest = made
                    for z in bz << BLOCK_SHIFT..(bz + 1) << BLOCK_SHIFT {
                        for x in bx << BLOCK_SHIFT..(bx + 1) << BLOCK_SHIFT {
                            biomes.insert(chunk_key(x, z), rest.remove(0))
                        }
                    }
                },
                _ => fail String("not biomes"),
            }
        }
    }
    let t1 = unsafe { Instant.now() }
    println("biomes in {t1.secs_since(t0)} s")
    var hash: u64 = 14695981039346656037u64
    var count = 0
    for cz in cz0..cz0 + n {
        for cx in cx0..cx0 + n {
            var around = List<List<i32>>()
            for dz in -1..2 {
                for dx in -1..2 {
                    around.push(biomes[chunk_key(cx + dx, cz + dz)].copy())
                }
            }
            match w.run(Job.Terrain(TerrainJob { x: cx, z: cz, beard: none, biomes: around })) {
                Made.Terrain(_, _, made, problems) => {
                    for p in problems {
                        println("problem: {p}")
                    }
                    for s in made.filled.states {
                        hash = (hash ^ u64(s)).wrapping_mul(1099511628211u64)
                    }
                    count += 1
                },
                _ => fail String("not terrain"),
            }
        }
    }
    let t2 = unsafe { Instant.now() }
    println("{count} chunks' terrain in {t2.secs_since(t1)} s: {t2.secs_since(t1) * 1000.0 / f64(count)} ms each")
    println("hash {hash}")
}
