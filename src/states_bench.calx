/// Scratch: how long `LightStates.new()` takes. Not committed.
module states_bench

import std.time.{Instant}
import world.light.{LightStates}

fn main() {
    let start = unsafe { Instant.now() }
    let s = LightStates.new()
    let one = unsafe { Instant.now() }
    var n = 0
    for _ in 0..20 {
        let again = LightStates.new()
        n += again.dampening(1)
    }
    let end = unsafe { Instant.now() }
    println("first {one.nanos_since(start) / 1000} us, then {end.nanos_since(one) / 20000} us each ({n + s.dampening(1)})")
}
