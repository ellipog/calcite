/// Scratch, for CAL-73: answers the cases in a file as build/scratch/regex/AskHex.java does,
/// with java.regex. Not a test.
///
///     calx run --release src/regex_diff.calx -- cases.hex
module regex_diff

import java.regex.{Pattern}
import std.env.{args}
import std.fs.{read_text}

fn digit(b: u8) -> u32 {
    let v = u32(b)
    if v <= 57 {
        return v - 48
    }
    return (v | 32) - 87
}

fn unhex(s: String) -> List<u16> {
    var out = List<u16>()
    var i: usize = 0
    while i + 4 <= s.len() {
        var v: u32 = 0
        for k in 0usize..4 {
            v = v * 16 + digit(s.byte_at(i + k))
        }
        out.push(u16.wrap(v))
        i += 4
    }
    return out
}

fn text_of(units: List<u16>) -> String {
    var out = String()
    var i: usize = 0
    while i < units.len() {
        var c = u32(units[i])
        i += 1
        if c >= 0xD800 and c <= 0xDBFF and i < units.len() {
            let d = u32(units[i])
            if d >= 0xDC00 and d <= 0xDFFF {
                c = 0x10000 + ((c - 0xD800) << 10) + (d - 0xDC00)
                i += 1
            }
        }
        out.push(rune.try_from(c) ?? '?')
    }
    return out
}

fn hex(s: String) -> String {
    let digits = "0123456789abcdef"
    var out = String()
    for c in s.chars() {
        let v = u32(c)
        var shift: u32 = 12
        loop {
            let d = usize((v >> shift) & 15)
            out.push_str(digits[d..d + 1])
            if shift == 0 {
                break
            }
            shift -= 4
        }
    }
    return out
}

fn number(s: String) -> u32 {
    var n: u32 = 0
    for i in 0usize..s.len() {
        n = n * 10 + u32(s.byte_at(i) - 48)
    }
    return n
}

fn main() {
    let a = args()
    let text = read_text(a[0].copy())! ?? String("")
    var out = String()
    var start: usize = 0
    while start < text.len() {
        var end = start
        while end < text.len() and text.byte_at(end) != 10 {
            end += 1
        }
        let line = text[start..end]
        start = end + 1
        if line.is_empty() {
            continue
        }
        let t1 = line.find("\t")!
        let rest = line[t1 + 1..]
        let t2 = rest.find("\t") ?? rest.len()
        let flags = number(line[..t1])
        let pattern = text_of(unhex(rest[..t2]))
        let input = if t2 < rest.len() { unhex(rest[t2 + 1..]) } else { List<u16>() }
        match Pattern.compile(pattern, flags) {
            ok(p) => {
                out.push_str(if p.matches_units(input) { "match" } else { "no" })
            },
            err(e) => {
                if e.unsupported {
                    out.push_str("unsupported {e.index}")
                } else {
                    out.push_str("error {hex(e.description)} {e.index}")
                }
            },
        }
        out.push('\n')
    }
    print(out)
}
