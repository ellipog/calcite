/// Where a connection is in the protocol, and which way a packet goes. A packet's ID means
/// something only for one state and one direction.
module protocol.state

/// A connection's protocol state. Each starts in `Handshake`, whose one packet says whether it
/// wants `Status` or `Login`. `Login` leads to `Configuration`, and that to `Play`, which can go
/// back to `Configuration`.
pub enum State {
    Handshake
    Status
    Login
    Configuration
    Play
}

/// Which way a packet goes: to the server, or to the client.
pub enum Bound {
    Serverbound
    Clientbound
}
