/// The handshake: the first packet of every connection, which says what the client wants next.
module protocol.handshake

import protocol.codegen.{packet, packets, wire_enum}
import protocol.state.{State, Bound}

/// What a client wants after its handshake, as vanilla's `ClientIntent`.
@wire_enum("Unknown connection intent")
pub enum ClientIntent: i32 {
    Status = 1
    Login = 2
    Transfer = 3
}

/// The handshake, vanilla's `ClientIntentionPacket`: the client's protocol version, the address
/// it was told to connect to, and what it wants.
@packet(Bound.Serverbound, "intention")
pub struct ClientIntention {
    @varint
    pub protocol_version: i32
    @max(255)
    pub host_name: String
    pub port: u16
    pub intention: ClientIntent
}

/// Every packet a client can send in the handshake.
@packets(State.Handshake, Bound.Serverbound)
pub enum HandshakeIn {
    Intention(ClientIntention)
}
