/// The login state: the player's name, encryption, compression and their profile.
module protocol.login

import auth.profile.{GameProfile}
import java.uuid.{Uuid}
import protocol.codegen.{packet, packets}
import protocol.state.{State, Bound}
import resources.identifier.{Identifier}

/// The player's name and UUID, vanilla's `ServerboundHelloPacket`.
@packet(Bound.Serverbound, "hello")
pub struct ServerboundHello {
    @max(16)
    pub name: String
    pub profile_id: Uuid
}

/// The shared secret and the challenge, each encrypted with the server's public key,
/// vanilla's `ServerboundKeyPacket`.
@packet(Bound.Serverbound, "key")
pub struct ServerboundKey {
    pub key_bytes: List<u8>
    pub encrypted_challenge: List<u8>
}

/// The answer to a custom query, vanilla's `ServerboundCustomQueryAnswerPacket`. Vanilla reads
/// every byte after the transaction ID as the payload, including the flag that says whether
/// there is one, and so does Calcite.
@packet(Bound.Serverbound, "custom_query_answer")
pub struct ServerboundCustomQueryAnswer {
    @varint
    pub transaction_id: i32
    @rest
    @max(1048576)
    pub payload: List<u8>
}

/// Says the client has the profile and is moving to configuration, vanilla's
/// `ServerboundLoginAcknowledgedPacket`.
@packet(Bound.Serverbound, "login_acknowledged")
pub struct ServerboundLoginAcknowledged {}

/// A cookie the server asked for, or none if the client has none by that key, vanilla's
/// `ServerboundCookieResponsePacket`.
@packet(Bound.Serverbound, "cookie_response")
pub struct ServerboundCookieResponse {
    pub key: Identifier
    @max(5120)
    pub payload: List<u8>?
}

/// Ends the login with a reason, as a text component in JSON, vanilla's
/// `ClientboundLoginDisconnectPacket`.
@packet(Bound.Clientbound, "login_disconnect")
pub struct ClientboundLoginDisconnect {
    @max(262144)
    pub reason_json: String
}

/// Starts encryption: the server's public key and a challenge, vanilla's
/// `ClientboundHelloPacket`. `server_id` is always empty since 1.7.
@packet(Bound.Clientbound, "hello")
pub struct ClientboundHello {
    @max(20)
    pub server_id: String
    pub public_key: List<u8>
    pub challenge: List<u8>
    pub should_authenticate: bool
}

/// The player's profile, which ends the login, vanilla's `ClientboundLoginFinishedPacket`.
@packet(Bound.Clientbound, "login_finished")
pub struct ClientboundLoginFinished {
    pub profile: GameProfile
    pub session_id: Uuid
}

/// Turns on compression for packets of at least `threshold` bytes, vanilla's
/// `ClientboundLoginCompressionPacket`.
@packet(Bound.Clientbound, "login_compression")
pub struct ClientboundLoginCompression {
    @varint
    pub threshold: i32
}

/// A query on a channel, vanilla's `ClientboundCustomQueryPacket`.
@packet(Bound.Clientbound, "custom_query")
pub struct ClientboundCustomQuery {
    @varint
    pub transaction_id: i32
    pub channel: Identifier
    @rest
    @max(1048576)
    pub payload: List<u8>
}

/// Asks for the cookie stored by `key`, vanilla's `ClientboundCookieRequestPacket`.
@packet(Bound.Clientbound, "cookie_request")
pub struct ClientboundCookieRequest {
    pub key: Identifier
}

/// Every packet a client can send in the login state.
@packets(State.Login, Bound.Serverbound)
pub enum LoginIn {
    Hello(ServerboundHello)
    Key(ServerboundKey)
    CustomQueryAnswer(ServerboundCustomQueryAnswer)
    LoginAcknowledged(ServerboundLoginAcknowledged)
    CookieResponse(ServerboundCookieResponse)
}
