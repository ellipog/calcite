/// Frames: each packet on the wire is its length as a VarInt of at most 3 bytes, then that many
/// bytes, as vanilla's `Varint21FrameDecoder` reads them and `Varint21LengthFieldPrepender`
/// writes them.
module protocol.frame

import protocol.wire.{DecodeError, Writer}
import std.net.{Net, Conn}

/// The longest frame: what a 3-byte VarInt holds.
pub const MAX_FRAME: usize = 2097151

/// Collects a connection's bytes as they arrive, and gives back whole frames.
pub struct FrameReader {
    data: List<u8>
    at: usize
}

impl FrameReader {
    pub fn new() -> FrameReader {
        return FrameReader { data: List<u8>(), at: 0 }
    }

    /// Takes the bytes that arrived on `c`, and says how many there were. Frames are then taken
    /// with `next`.
    pub fn read_from(mut self, net: Net, c: Conn) -> usize {
        return net.read(c, mut self.data)
    }

    /// Adds bytes as if they'd arrived.
    pub fn push(mut self, bytes: List<u8>) {
        for b in bytes {
            self.data.push(b)
        }
    }

    /// The bytes not yet taken as frames.
    pub fn waiting(self) -> usize {
        return self.data.len() - self.at
    }

    /// The bytes not yet taken, without taking them.
    pub fn peek(self) -> List<u8> {
        var out = List<u8>()
        for i in self.at..self.data.len() {
            out.push(self.data[i])
        }
        return out
    }

    /// The next whole frame's body, or `none` until all of it has arrived. Fails as vanilla does
    /// on a length longer than 3 bytes or of 0, after which the connection is broken.
    pub fn next(mut self) -> List<u8>? ! DecodeError {
        let left = self.data.len() - self.at
        var bits: i32 = 0
        var header: usize = 0
        loop {
            if header == 3 {
                fail DecodeError { message: "length wider than 21-bit" }
            }
            if header == left {
                self.compact()
                return none
            }
            let b = self.data[self.at + header]
            bits |= i32(b & 0x7F) << (7 * i32.wrap(header))
            header += 1
            if b & 0x80 == 0 {
                break
            }
        }
        let length = usize.wrap(bits)
        if length == 0 {
            fail DecodeError { message: "Frame length cannot be zero" }
        }
        if left - header < length {
            self.compact()
            return none
        }
        let start = self.at + header
        var body = List<u8>()
        body.reserve(length)
        unsafe {
            let from = self.data.as_ptr().add(start)
            let to = body.as_mut_ptr()
            for i in 0..length {
                to.add(i).write(from.add(i).read())
            }
            body.set_len(length)
        }
        self.at = start + length
        return some(body)
    }

    // Drops the bytes already taken once they're most of the buffer, so it doesn't grow forever.
    fn compact(mut self) {
        if self.at == 0 or self.at < self.data.len() - self.at {
            return
        }
        let keep = self.data.len() - self.at
        for i in 0..keep {
            self.data[i] = self.data[self.at + i]
        }
        self.data.truncate(keep)
        self.at = 0
    }
}

/// `body` as a frame: its length, then itself. A body longer than `MAX_FRAME` can't be one, and
/// gives vanilla's message instead.
pub fn frame(body: List<u8>) -> List<u8> ! String {
    if body.len() > MAX_FRAME {
        fail "Packet too large: size {body.len()} is over 8"
    }
    var w = Writer.new()
    w.varint(i32.wrap(body.len()))
    w.raw(body)
    return w.into_bytes()
}
