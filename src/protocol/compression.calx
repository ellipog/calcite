/// Packet compression, which the login turns on, as vanilla's `CompressionEncoder` and
/// `CompressionDecoder` do it: inside each frame, the packet's length as a VarInt then the packet
/// deflated with zlib, or a VarInt 0 then the packet as it is if it's shorter than the threshold.
module protocol.compression

import protocol.wire.{DecodeError, Reader, Writer}
import std.zlib.{Format, Error, compress_into, decompress_into}

/// The longest a packet can be before compression, in either direction.
pub const MAX_UNCOMPRESSED: usize = 8388608

/// The packet as a compressed frame's body: deflated at level 6, Java's default, unless it's
/// shorter than `threshold`. A packet over `MAX_UNCOMPRESSED` fails with vanilla's message.
pub fn compress(packet: List<u8>, threshold: i32) -> List<u8> ! String {
    let n = packet.len()
    if n > MAX_UNCOMPRESSED {
        fail "Packet too big (is {n}, should be less than 8388608)"
    }
    var w = Writer.new()
    if threshold > 0 and n < usize.wrap(threshold) {
        w.varint(0)
        w.raw(packet)
        return w.into_bytes()
    }
    w.varint(i32.wrap(n))
    var out = w.into_bytes()
    compress_into(packet, 0, n, Format.Zlib, 6, mut out)
    return out
}

/// The packet in a compressed frame's body, which a client sent with `threshold` on. It fails as
/// vanilla's decoder does: a packet sent compressed must be at least the threshold long and at
/// most `MAX_UNCOMPRESSED`, and must inflate to the length it gives. Bytes past that length are
/// ignored, as vanilla's `Inflater` stops when its buffer is full.
pub fn decompress(body: own List<u8>, threshold: i32) -> List<u8> ! DecodeError {
    let total = body.len()
    var r = Reader.new(body)
    let declared = try r.varint()
    if declared == 0 {
        return r.rest()
    }
    if declared < threshold {
        fail DecodeError { message: "Badly compressed packet - size of {declared} is below server threshold of {threshold}" }
    }
    if declared > 8388608 {
        fail DecodeError { message: "Badly compressed packet - size of {declared} is larger than protocol maximum of 8388608" }
    }
    let start = total - r.left()
    let data = r.into_bytes()
    let want = usize.wrap(declared)
    var out = List<u8>()
    out.reserve(want)
    match decompress_into(data, start, total, Format.Zlib, want, mut out) {
        ok(_) => {},
        // Java's `Inflater` gives what it has for a stream that stops short, and nothing for one
        // that wants a dictionary, so the length check below reports both.
        err(Error.Truncated) => {},
        err(Error.Dictionary) => {},
        err(Error.Checksum) => fail DecodeError { message: "java.util.zip.DataFormatException: incorrect data check" },
        err(_) => fail DecodeError { message: "java.util.zip.DataFormatException: {header_problem(data, start, total)}" },
    }
    if out.len() != want {
        fail DecodeError { message: "Badly compressed packet - actual length of uncompressed payload {out.len()} is does not match declared size {declared}" }
    }
    return out
}

// What zlib says of a stream it can't read. The header's three checks and the first block's
// type are zlib's own; past those, zlib names the part of the deflate data that's wrong, which
// Calcite doesn't, so it says only that it's invalid.
fn header_problem(data: List<u8>, from: usize, to: usize) -> String {
    if to - from >= 2 {
        let cmf = u32(data[from])
        let flg = u32(data[from + 1])
        if (cmf * 256 + flg) % 31 != 0 {
            return String("incorrect header check")
        }
        if cmf & 15 != 8 {
            return String("unknown compression method")
        }
        if (cmf >> 4) + 8 > 15 {
            return String("invalid window size")
        }
        if to - from >= 3 and (u32(data[from + 2]) >> 1) & 3 == 3 {
            return String("invalid block type")
        }
    }
    return String("invalid deflate data")
}
