/// The status state: the server list's query, and its ping.
module protocol.status

import protocol.codegen.{packet, packets}
import protocol.state.{State, Bound}

/// Asks for the server's status, vanilla's `ServerboundStatusRequestPacket`.
@packet(Bound.Serverbound, "status_request")
pub struct ServerboundStatusRequest {}

/// A ping, whose `time` the server sends back, vanilla's `ServerboundPingRequestPacket`.
@packet(Bound.Serverbound, "ping_request")
pub struct ServerboundPingRequest {
    pub time: i64
}

/// The server's status as JSON, vanilla's `ClientboundStatusResponsePacket`: its description,
/// players, version and icon.
@packet(Bound.Clientbound, "status_response")
pub struct ClientboundStatusResponse {
    @max(32767)
    pub json: String
}

/// The answer to a ping, with its `time`, vanilla's `ClientboundPongResponsePacket`.
@packet(Bound.Clientbound, "pong_response")
pub struct ClientboundPongResponse {
    pub time: i64
}

/// Every packet a client can send in the status state.
@packets(State.Status, Bound.Serverbound)
pub enum StatusIn {
    StatusRequest(ServerboundStatusRequest)
    PingRequest(ServerboundPingRequest)
}
