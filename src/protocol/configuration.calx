/// The configuration state's own packets: the known packs, the registries, the enabled features,
/// the code of conduct and finishing, then `ConfigurationIn`, every packet a client can send in
/// configuration, with those it shares with play from protocol.common.
module protocol.configuration

import nbt.tag.{Tag}
import pack.resources.{KnownPack}
import protocol.codegen.{packet, packets, wire}
import protocol.common.{ServerboundClientInformation, ServerboundCustomClickAction, ServerboundCustomPayload, ServerboundKeepAlive, ServerboundPong, ServerboundResourcePack}
import protocol.login.{ServerboundCookieResponse}
import protocol.state.{State, Bound}
import resources.identifier.{Identifier}

/// Says the client is ready to play, vanilla's `ServerboundFinishConfigurationPacket`.
@packet(Bound.Serverbound, "finish_configuration")
pub struct ServerboundFinishConfiguration {}

/// The packs the client has of those the server offered, vanilla's
/// `ServerboundSelectKnownPacks`.
@packet(Bound.Serverbound, "select_known_packs")
pub struct ServerboundSelectKnownPacks {
    @max(64)
    pub packs: List<KnownPack>
}

/// Says the player accepts the server's code of conduct, vanilla's
/// `ServerboundAcceptCodeOfConductPacket`.
@packet(Bound.Serverbound, "accept_code_of_conduct")
pub struct ServerboundAcceptCodeOfConduct {}

/// Ends configuration, vanilla's `ClientboundFinishConfigurationPacket`.
@packet(Bound.Clientbound, "finish_configuration")
pub struct ClientboundFinishConfiguration {}

/// Clears the client's chat, vanilla's `ClientboundResetChatPacket`.
@packet(Bound.Clientbound, "reset_chat")
pub struct ClientboundResetChat {}

/// One of a registry's entries in `registry_data`: its ID, and its contents unless the client
/// has the pack it's from, vanilla's `RegistrySynchronization.PackedRegistryEntry`.
@wire
pub struct RegistryEntry {
    pub id: Identifier
    pub data: Tag?
}

/// A synchronized registry's entries in the order of their IDs, vanilla's
/// `ClientboundRegistryDataPacket`.
@packet(Bound.Clientbound, "registry_data")
pub struct ClientboundRegistryData {
    pub registry: Identifier
    pub entries: List<RegistryEntry>
}

/// The feature flags the world has on, such as `minecraft:vanilla`, vanilla's
/// `ClientboundUpdateEnabledFeaturesPacket`.
@packet(Bound.Clientbound, "update_enabled_features")
pub struct ClientboundUpdateEnabledFeatures {
    pub features: List<Identifier>
}

/// The packs the server's data comes from, so the client says which it has, vanilla's
/// `ClientboundSelectKnownPacks`.
@packet(Bound.Clientbound, "select_known_packs")
pub struct ClientboundSelectKnownPacks {
    pub packs: List<KnownPack>
}

/// The server's code of conduct, which the player accepts before they join, vanilla's
/// `ClientboundCodeOfConductPacket`.
@packet(Bound.Clientbound, "code_of_conduct")
pub struct ClientboundCodeOfConduct {
    pub code: String
}

/// Every packet a client can send in the configuration state.
@packets(State.Configuration, Bound.Serverbound)
pub enum ConfigurationIn {
    ClientInformation(ServerboundClientInformation)
    CookieResponse(ServerboundCookieResponse)
    CustomPayload(ServerboundCustomPayload)
    FinishConfiguration(ServerboundFinishConfiguration)
    KeepAlive(ServerboundKeepAlive)
    Pong(ServerboundPong)
    ResourcePack(ServerboundResourcePack)
    SelectKnownPacks(ServerboundSelectKnownPacks)
    CustomClickAction(ServerboundCustomClickAction)
    AcceptCodeOfConduct(ServerboundAcceptCodeOfConduct)
}
