/// The packets the configuration and play states share, vanilla's `common` packets: keep-alives,
/// pings, plugin channels, resource packs, server links and disconnecting. Cookies are in
/// protocol.login, which has them too.
module protocol.common

import chat.component.{Component}
import java.uuid.{Uuid}
import nbt.tag.{Accounter, Tag}
import protocol.codegen.{packet, wire, wire_enum}
import protocol.state.{Bound}
import protocol.wire.{Reader, Writer, DecodeError, Wire}
import resources.identifier.{Identifier}

/// What the client says about itself, vanilla's `ClientInformation`: sent in configuration and
/// whenever its settings change.
@wire
pub struct ClientInformation {
    /// Its language, such as `en_us`.
    @max(16)
    pub language: String
    pub view_distance: i8
    pub chat_visibility: ChatVisibility
    pub chat_colors: bool
    /// Which parts of the skin show, a bit for each.
    pub model_customisation: u8
    pub main_hand: HumanoidArm
    pub text_filtering_enabled: bool
    /// Whether the player may be listed among those online, in the server list.
    pub allows_listing: bool
    pub particle_status: ParticleStatus
}

impl ClientInformation {
    /// What the server assumes until the client says, as vanilla's `createDefault`.
    pub fn default() -> ClientInformation {
        return ClientInformation { language: String("en_us"), view_distance: 2, chat_visibility: ChatVisibility.Full, chat_colors: true, model_customisation: 0, main_hand: HumanoidArm.Right, text_filtering_enabled: false, allows_listing: false, particle_status: ParticleStatus.All }
    }
}

/// Which chat the player sees, vanilla's `ChatVisiblity`.
pub enum ChatVisibility {
    Full
    System
    Hidden
}

/// The player's main hand, vanilla's `HumanoidArm`.
pub enum HumanoidArm {
    Left
    Right
}

/// How many particles the client shows, vanilla's `ParticleStatus`.
pub enum ParticleStatus {
    All
    Decreased
    Minimal
}

// An ID out of range wraps around, as vanilla's `ByIdMap.OutOfBoundsStrategy.WRAP`.
fn wrapped(id: i32, n: i32) -> i32 {
    return ((id % n) + n) % n
}

impl Wire for ChatVisibility {
    fn read(r: mut Reader) -> ChatVisibility ! DecodeError {
        let id = wrapped(try r.varint(), 3)
        return if id == 0 { ChatVisibility.Full } else if id == 1 { ChatVisibility.System } else { ChatVisibility.Hidden }
    }

    fn write(self, w: mut Writer) {
        w.varint(match self {
            ChatVisibility.Full => 0,
            ChatVisibility.System => 1,
            ChatVisibility.Hidden => 2,
        })
    }
}

impl Wire for HumanoidArm {
    // An ID out of range is the first, as `OutOfBoundsStrategy.ZERO`.
    fn read(r: mut Reader) -> HumanoidArm ! DecodeError {
        return if try r.varint() == 1 { HumanoidArm.Right } else { HumanoidArm.Left }
    }

    fn write(self, w: mut Writer) {
        w.varint(match self {
            HumanoidArm.Left => 0,
            HumanoidArm.Right => 1,
        })
    }
}

impl Wire for ParticleStatus {
    fn read(r: mut Reader) -> ParticleStatus ! DecodeError {
        let id = wrapped(try r.varint(), 3)
        return if id == 0 { ParticleStatus.All } else if id == 1 { ParticleStatus.Decreased } else { ParticleStatus.Minimal }
    }

    fn write(self, w: mut Writer) {
        w.varint(match self {
            ParticleStatus.All => 0,
            ParticleStatus.Decreased => 1,
            ParticleStatus.Minimal => 2,
        })
    }
}

/// The client's information, vanilla's `ServerboundClientInformationPacket`.
@packet(Bound.Serverbound, "client_information")
pub struct ServerboundClientInformation {
    pub information: ClientInformation
}

/// A message on a plugin channel, vanilla's `ServerboundCustomPayloadPacket`. Vanilla reads
/// `minecraft:brand` as a string and drops the rest, at most 32767 bytes of them.
@packet(Bound.Serverbound, "custom_payload")
pub struct ServerboundCustomPayload {
    pub channel: Identifier
    @rest
    @max(32767)
    pub payload: List<u8>
}

/// The answer to a keep-alive, vanilla's `ServerboundKeepAlivePacket`.
@packet(Bound.Serverbound, "keep_alive")
pub struct ServerboundKeepAlive {
    pub challenge: i64
}

/// The answer to a ping, vanilla's `ServerboundPongPacket`.
@packet(Bound.Serverbound, "pong")
pub struct ServerboundPong {
    pub token: i32
}

/// What the client did with a resource pack, vanilla's `ServerboundResourcePackPacket.Action`.
@wire_enum("Unknown resource pack action")
pub enum ResourcePackAction {
    SuccessfullyLoaded
    Declined
    FailedDownload
    Accepted
    Downloaded
    InvalidUrl
    FailedReload
    Discarded
}

impl ResourcePackAction {
    /// Whether the client is done with the pack, as vanilla's `isTerminal`.
    pub fn is_terminal(self) -> bool {
        return self != ResourcePackAction.Accepted and self != ResourcePackAction.Downloaded
    }
}

/// What happened to a resource pack the server sent, vanilla's `ServerboundResourcePackPacket`.
@packet(Bound.Serverbound, "resource_pack")
pub struct ServerboundResourcePack {
    pub pack: Uuid
    pub action: ResourcePackAction
}

/// A click on a dialog's or a text's custom action, vanilla's
/// `ServerboundCustomClickActionPacket`.
@packet(Bound.Serverbound, "custom_click_action")
pub struct ServerboundCustomClickAction {
    pub action: Identifier
    pub payload: ClickPayload
}

/// What a custom click action carries, as vanilla's `UNTRUSTED_TAG_CODEC` reads it: its length
/// as a VarInt, at most 65536 bytes, then NBT that may take at most 32768 bytes and 16 levels,
/// or `End` for none.
pub struct ClickPayload {
    pub tag: Tag?
}

impl Wire for ClickPayload {
    fn read(r: mut Reader) -> ClickPayload ! DecodeError {
        let size = try r.varint()
        if size > 65536 {
            fail DecodeError { message: "Buffer size {size} is larger than allowed limit of 65536" }
        }
        if size < 0 or usize.wrap(size) > r.left() {
            fail DecodeError { message: "Buffer size {size} is outside the packet" }
        }
        var slice = Reader.new(try r.bytes(usize.wrap(size)))
        let tag = try slice.nbt(Accounter.new(32768, 16))
        return ClickPayload { tag: if tag.id() == 0 { none } else { some(tag) } }
    }

    fn write(self, w: mut Writer) {
        var inner = Writer.new()
        match self.tag {
            some(t) => inner.nbt(t),
            none => inner.nbt(Tag.End),
        }
        w.byte_array(inner.into_bytes())
    }
}

/// A message on a plugin channel, vanilla's `ClientboundCustomPayloadPacket`, such as the
/// server's brand on `minecraft:brand`.
@packet(Bound.Clientbound, "custom_payload")
pub struct ClientboundCustomPayload {
    pub channel: Identifier
    @rest
    @max(1048576)
    pub payload: List<u8>
}

impl ClientboundCustomPayload {
    /// The server's brand, which the client shows in its debug screen, vanilla's `BrandPayload`.
    pub fn brand(name: String) -> ClientboundCustomPayload {
        var w = Writer.new()
        w.string(name, 32767)
        return ClientboundCustomPayload { channel: Identifier { namespace: "minecraft", path: "brand" }, payload: w.into_bytes() }
    }
}

/// Ends the connection with a reason, vanilla's `ClientboundDisconnectPacket`.
@packet(Bound.Clientbound, "disconnect")
pub struct ClientboundDisconnect {
    pub reason: Component
}

/// A keep-alive, which the client answers with the same challenge, vanilla's
/// `ClientboundKeepAlivePacket`.
@packet(Bound.Clientbound, "keep_alive")
pub struct ClientboundKeepAlive {
    pub challenge: i64
}

/// A ping, which the client answers with a pong, vanilla's `ClientboundPingPacket`.
@packet(Bound.Clientbound, "ping")
pub struct ClientboundPing {
    pub token: i32
}

/// Takes away a resource pack, or all of them, vanilla's `ClientboundResourcePackPopPacket`.
@packet(Bound.Clientbound, "resource_pack_pop")
pub struct ClientboundResourcePackPop {
    pub pack: Uuid?
}

/// Offers a resource pack, vanilla's `ClientboundResourcePackPushPacket`.
@packet(Bound.Clientbound, "resource_pack_push")
pub struct ClientboundResourcePackPush {
    pub pack: Uuid
    pub url: String
    /// Its SHA-1 in hex, or empty.
    @max(40)
    pub hash: String
    pub required: bool
    pub prompt: Component?
}

/// Has the client keep a cookie, vanilla's `ClientboundStoreCookiePacket`.
@packet(Bound.Clientbound, "store_cookie")
pub struct ClientboundStoreCookie {
    pub key: Identifier
    @max(5120)
    pub payload: List<u8>
}

/// Sends the client to another server, vanilla's `ClientboundTransferPacket`.
@packet(Bound.Clientbound, "transfer")
pub struct ClientboundTransfer {
    pub host: String
    @varint
    pub port: i32
}

/// A tag's entries by their IDs, in `update_tags`.
@wire
pub struct TagIds {
    pub name: Identifier
    @varint
    pub ids: List<i32>
}

/// A registry's tags, in `update_tags`.
@wire
pub struct RegistryTags {
    pub registry: Identifier
    pub tags: List<TagIds>
}

/// Every registry's tags, vanilla's `ClientboundUpdateTagsPacket`.
@packet(Bound.Clientbound, "update_tags")
pub struct ClientboundUpdateTags {
    pub registries: List<RegistryTags>
}

/// One of the server's links, vanilla's `ServerLinks.UntrustedEntry`: a known kind, such as
/// `0` for bug reports, or a name, then the link.
pub struct ServerLink {
    pub kind: LinkKind
    pub link: String
}

/// What a server link is: one of vanilla's `KnownLinkType`s by its ID, or a name of its own.
pub enum LinkKind {
    Known(i32)
    Named(Component)
}

impl Wire for ServerLink {
    fn read(r: mut Reader) -> ServerLink ! DecodeError {
        let kind = if try r.bool() {
            // An ID out of range is the first, as `OutOfBoundsStrategy.ZERO`.
            let id = try r.varint()
            LinkKind.Known(if id >= 0 and id <= 9 { id } else { 0 })
        } else {
            LinkKind.Named(try Component.read(mut r))
        }
        return ServerLink { kind: kind, link: try r.string(32767) }
    }

    fn write(self, w: mut Writer) {
        match self.kind {
            LinkKind.Known(id) => {
                w.bool(true)
                w.varint(id)
            },
            LinkKind.Named(name) => {
                w.bool(false)
                name.write(mut w)
            },
        }
        w.string(self.link, 32767)
    }
}

/// The server's links, which the client shows in its pause menu, vanilla's
/// `ClientboundServerLinksPacket`.
@packet(Bound.Clientbound, "server_links")
pub struct ClientboundServerLinks {
    pub links: List<ServerLink>
}

/// Closes the dialog the client shows, vanilla's `ClientboundClearDialogPacket`.
@packet(Bound.Clientbound, "clear_dialog")
pub struct ClientboundClearDialog {}
