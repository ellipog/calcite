/// Chat's packets, and the parts of messages they carry as vanilla's codecs write them: a
/// message's signature, what a client has seen, a signed message's body, a filter's mask and a
/// message's type with who sent it.
module protocol.chat

import chat.component.{Component}
import java.base64.{encode}
import java.uuid.{Uuid}
import protocol.codegen.{packet, wire}
import protocol.state.{Bound, State}
import protocol.wire.{DecodeError, Reader, Wire, Writer}

/// A message's signature, vanilla's `MessageSignature`: 256 bytes, with no length before them.
pub struct MessageSignature {
    pub bytes: List<u8>
}

/// The bytes a signature always has.
pub const SIGNATURE_BYTES: usize = 256

impl MessageSignature {
    /// The signature in Base64, as its `toString` writes it.
    pub fn to_string(self) -> String {
        return encode(self.bytes)
    }
}

impl Wire for MessageSignature {
    fn read(r: mut Reader) -> MessageSignature ! DecodeError {
        return MessageSignature { bytes: try r.bytes(SIGNATURE_BYTES) }
    }

    fn write(self, w: mut Writer) {
        w.raw(self.bytes)
    }
}

/// What a client says it has seen of the signed messages it was sent, vanilla's
/// `LastSeenMessages.Update`: how far its window of the last 20 moved on, which of the 20 it
/// acknowledges, a bit each, and a checksum of those, or 0 for none.
pub struct LastSeenUpdate {
    pub offset: i32
    /// The window's bits, 20 of them in 3 bytes, the first in the low bit of the first byte, as
    /// `ByteBufCodecs.fixedBitSet(20)` reads them.
    pub acknowledged: List<u8>
    pub checksum: i8
}

impl LastSeenUpdate {
    /// An update that moves nothing on and acknowledges nothing, as a client sends when it has
    /// seen no signed message.
    pub fn empty() -> LastSeenUpdate {
        return LastSeenUpdate { offset: 0, acknowledged: [0, 0, 0], checksum: 0 }
    }
}

impl Wire for LastSeenUpdate {
    fn read(r: mut Reader) -> LastSeenUpdate ! DecodeError {
        let offset = try r.varint()
        let acknowledged = try r.bytes(3)
        return LastSeenUpdate { offset: offset, acknowledged: acknowledged, checksum: try r.i8() }
    }

    fn write(self, w: mut Writer) {
        w.varint(self.offset)
        w.raw(self.acknowledged)
        w.i8(self.checksum)
    }
}

/// A message the player typed, vanilla's `ServerboundChatPacket`: its text, when it was sent in
/// milliseconds since 1970, the salt and signature of a signed one, and what the client has seen.
@packet(Bound.Serverbound, "chat")
pub struct ServerboundChat {
    @max(256)
    pub message: String
    pub time_stamp: i64
    pub salt: i64
    pub signature: MessageSignature?
    pub last_seen: LastSeenUpdate
}

/// How far the client's window of messages it has seen moved on, vanilla's
/// `ServerboundChatAckPacket`.
@packet(Bound.Serverbound, "chat_ack")
pub struct ServerboundChatAck {
    @varint
    pub offset: i32
}

/// A command the player typed, without its `/`, vanilla's `ServerboundChatCommandPacket`.
@packet(Bound.Serverbound, "chat_command")
pub struct ServerboundChatCommand {
    pub command: String
}

/// A signature in a message a client is sent, vanilla's `MessageSignature.Packed`: by its place
/// in the client's cache of signatures, or whole when it isn't there.
pub struct PackedSignature {
    /// Its place in the cache, or -1 for one sent whole.
    pub id: i32
    pub full: MessageSignature?
}

impl Wire for PackedSignature {
    fn read(r: mut Reader) -> PackedSignature ! DecodeError {
        let id = try r.varint() - 1
        if id == -1 {
            return PackedSignature { id: id, full: some(try MessageSignature.read(mut r)) }
        }
        return PackedSignature { id: id, full: none }
    }

    fn write(self, w: mut Writer) {
        w.varint(self.id + 1)
        if self.id == -1 {
            if let s = self.full {
                s.write(mut w)
            }
        }
    }
}

/// What was signed of a message, as a client is sent it, vanilla's `SignedMessageBody.Packed`:
/// its text, when it was sent, its salt and the signatures its sender had last seen.
@wire
pub struct SignedBody {
    @max(256)
    pub content: String
    /// Milliseconds since 1970.
    pub time_stamp: i64
    pub salt: i64
    @max(20)
    pub last_seen: List<PackedSignature>
}

/// What of a message a filter hid, vanilla's `FilterMask`: nothing, everything, or the
/// characters whose bits are set, as a `BitSet`'s bytes.
pub enum FilterMask {
    PassThrough
    FullyFiltered
    PartiallyFiltered(List<u8>)
}

impl Wire for FilterMask {
    fn read(r: mut Reader) -> FilterMask ! DecodeError {
        let kind = try r.varint()
        if kind == 1 {
            return FilterMask.FullyFiltered
        }
        if kind == 2 {
            return FilterMask.PartiallyFiltered(try r.byte_array_in_left())
        }
        // `ByIdMap.continuous` with `ZERO` takes any other ID as the first type.
        return FilterMask.PassThrough
    }

    fn write(self, w: mut Writer) {
        match self {
            FilterMask.PassThrough => w.varint(0),
            FilterMask.FullyFiltered => w.varint(1),
            FilterMask.PartiallyFiltered(bits) => {
                w.varint(2)
                w.byte_array(bits)
            },
        }
    }
}

/// A message's type and who it's from, vanilla's `ChatType.Bound`: the type by its ID in the
/// `chat_type` registry, the sender's name, and who it's to, if anyone.
pub struct ChatTypeBound {
    pub chat_type: i32
    pub name: Component
    pub target_name: Component?
}

impl Wire for ChatTypeBound {
    fn read(r: mut Reader) -> ChatTypeBound ! DecodeError {
        // A registry holder is its ID and 1, or 0 and then the type itself, which Calcite
        // never sends.
        let holder = try r.varint()
        if holder == 0 {
            fail DecodeError { message: String("a chat type sent whole") }
        }
        let name = try Component.read(mut r)
        let target: Component? = if try r.bool() { some(try Component.read(mut r)) } else { none }
        return ChatTypeBound { chat_type: holder - 1, name: name, target_name: target }
    }

    fn write(self, w: mut Writer) {
        w.varint(self.chat_type + 1)
        self.name.write(mut w)
        match self.target_name {
            some(t) => {
                w.bool(true)
                t.write(mut w)
            },
            none => w.bool(false),
        }
    }
}

/// A player's message, vanilla's `ClientboundPlayerChatPacket`: the message's place among all
/// those the client was sent, its sender and its place among theirs, its signature if it's
/// signed, what was signed, the text shown instead if a decorator changed it, what a filter hid,
/// and its type.
@packet(Bound.Clientbound, "player_chat")
pub struct ClientboundPlayerChat {
    @varint
    pub global_index: i32
    pub sender: Uuid
    @varint
    pub index: i32
    pub signature: MessageSignature?
    pub body: SignedBody
    pub unsigned_content: Component?
    pub filter_mask: FilterMask
    pub chat_type: ChatTypeBound
}
