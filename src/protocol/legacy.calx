/// The server list ping of clients before 1.7, which vanilla still answers, as its
/// `LegacyQueryHandler` does: it looks at the first bytes a connection sends, and if they're an
/// old ping, answers with a kick message that holds the status, and closes.
module protocol.legacy

/// What a connection's first bytes are.
pub enum Legacy {
    /// Not an old ping: the connection speaks the protocol of today.
    Modern
    /// The ping of a client before 1.3: `FE` alone.
    V0
    /// The ping of a client from 1.4 to 1.6: `FE 01`, with 1.6's `MC|PingHost` payload or not.
    V1
}

/// What the bytes of a connection's first read are. Anything that isn't a whole, well-formed
/// old ping is `Modern`, as in vanilla, which passes it on to the protocol of today.
pub fn classify(bytes: List<u8>) -> Legacy {
    let n = bytes.len()
    if n == 0 or bytes[0] != 0xFE {
        return Legacy.Modern
    }
    if n == 1 {
        return Legacy.V0
    }
    if bytes[1] != 1 {
        return Legacy.Modern
    }
    if n == 2 {
        return Legacy.V1
    }
    return if is_ping_host(bytes) { Legacy.V1 } else { Legacy.Modern }
}

// 1.6's payload after `FE 01`: `FA`, the channel `MC|PingHost`, the payload's length, which must
// be every byte left, then a protocol version of at least 73, the host, and a port that fits.
fn is_ping_host(bytes: List<u8>) -> bool {
    var at: usize = 2
    if bytes[at] != 0xFA {
        return false
    }
    at += 1
    let channel = legacy_string(bytes, mut at) else return false
    if channel != "MC|PingHost" or at + 2 > bytes.len() {
        return false
    }
    let size = usize.wrap((i32(bytes[at]) << 8) | i32(bytes[at + 1]))
    at += 2
    if bytes.len() - at != size or at >= bytes.len() {
        return false
    }
    let protocol = bytes[at]
    at += 1
    if protocol < 73 {
        return false
    }
    if legacy_string(bytes, mut at) == none or at + 4 > bytes.len() {
        return false
    }
    let port = (i32(bytes[at]) << 24) | (i32(bytes[at + 1]) << 16) | (i32(bytes[at + 2]) << 8) | i32(bytes[at + 3])
    return port <= 65535
}

// A string as the old protocol wrote it: its UTF-16 units as a signed short, then the units,
// big-endian. `none` where vanilla's read would throw.
fn legacy_string(bytes: List<u8>, at: mut usize) -> String? {
    if at + 2 > bytes.len() {
        return none
    }
    let units = (i32(bytes[at]) << 8) | i32(bytes[at + 1])
    at += 2
    if units >= 0x8000 {
        return none
    }
    let n = usize.wrap(units)
    if at + n * 2 > bytes.len() {
        return none
    }
    var text = String()
    var i: usize = 0
    while i < n {
        let unit = (u32(bytes[at + i * 2]) << 8) | u32(bytes[at + i * 2 + 1])
        var cp = unit
        if unit >= 0xD800 and unit <= 0xDBFF and i + 1 < n {
            let low = (u32(bytes[at + i * 2 + 2]) << 8) | u32(bytes[at + i * 2 + 3])
            if low >= 0xDC00 and low <= 0xDFFF {
                cp = 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)
                i += 1
            }
        }
        text.push(rune.try_from(cp) ?? '\u{FFFD}')
        i += 1
    }
    at += n * 2
    return some(text)
}

/// The answer to an old ping of `kind`, which isn't `Modern`: a kick packet, `FF`, whose
/// message holds the server's status, as vanilla's `createVersion0Response` and
/// `createVersion1Response` write it.
pub fn response(kind: Legacy, version: String, motd: String, online: i32, max: i32) -> List<u8> {
    let text = match kind {
        Legacy.V0 => "{motd}§{online}§{max}",
        _ => "§1\0127\0{version}\0{motd}\0{online}\0{max}",
    }
    var out = List<u8>()
    out.push(0xFF)
    let units = u16.wrap(text.utf16_len())
    out.push(u8.wrap(i32(units) >> 8))
    out.push(u8.wrap(units))
    for c in text.chars() {
        let u = u16(c)
        out.push(u8.wrap(i32(u) >> 8))
        out.push(u8.wrap(u))
    }
    return out
}
