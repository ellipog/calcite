}

/// A click in a container, vanilla's `ServerboundContainerClickPacket`: the container, the state
/// the client last had, the slot, the button, the kind of click, a `ContainerInput` by its ID,
/// then, in `rest`, the slots the click changed on the client, a map of slots to `HashedStack`s,
/// and what its cursor then carries, which are read with the registries, by `world.menu`
/// (D374).
@packet(Bound.Serverbound, "container_click")
pub struct ServerboundContainerClick {
    @varint
    pub container_id: i32
    @varint
    pub state_id: i32
    pub slot: i16
