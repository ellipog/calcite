    pub furnace: BookTab
    pub blast_furnace: BookTab
    pub smoker: BookTab
}

/// Recipes the player knows, vanilla's `ClientboundRecipeBookAddPacket` entries. Calcite has no
/// recipes until Phase 6, so it sends none, and can't read any.
pub struct BookRecipes {}

impl Wire for BookRecipes {
    fn read(r: mut Reader) -> BookRecipes ! DecodeError {
        if try r.varint() != 0 {
            fail DecodeError { message: "Calcite can't read recipe book entries yet" }
        }
        return BookRecipes {}
    }

    fn write(self, w: mut Writer) {
        w.varint(0)
    }
}

/// Adds to the player's recipe book, or replaces it, vanilla's `ClientboundRecipeBookAddPacket`.
@packet(Bound.Clientbound, "recipe_book_add")
pub struct ClientboundRecipeBookAdd {
    pub recipes: BookRecipes
    pub replace: bool
}

