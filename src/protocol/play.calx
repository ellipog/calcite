/// A use of what one hand holds on a block, vanilla's `ServerboundUseItemOnPacket` (CAL-139): the
/// hand, 0 for the main and 1 for the off, any other the main, as `ByIdMap`'s `ZERO` has it; the
/// block hit; the face hit, by its 3D data value, which `Direction`'s `BY_ID` wraps; where on the
/// block it was hit, from its least corner, in floats; whether the eyes were inside it; whether the
/// world border was hit, which the server doesn't read; and the sequence number the server acks.
@packet(Bound.Serverbound, "use_item_on")
pub struct ServerboundUseItemOn {
    @varint
    pub hand: i32
    pub pos: BlockPos
    @varint
    pub direction: i32
    pub cursor_x: f32
    pub cursor_y: f32
    pub cursor_z: f32
    pub inside: bool
    pub border: bool
    @varint
    pub sequence: i32
}

/// Something the player did with a block or what they hold, vanilla's
/// `ServerboundPlayerActionPacket` (D376): the action, by its place in `Action`'s order, digging
/// a block from 0 to 3, then dropping, letting go, swapping hands and stabbing; the block; the
/// face, by its 3D data value, which `Direction.from3DDataValue` takes modulo 6; and the sequence
/// number the server acks, as a block it digs comes to be changed.
@packet(Bound.Serverbound, "player_action")
pub struct ServerboundPlayerAction {
    @varint
    pub action: i32
    pub pos: BlockPos
    pub direction: u8
    @varint
    pub sequence: i32
}

