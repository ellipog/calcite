@packet(Bound.Serverbound, "player_loaded")
pub struct ServerboundPlayerLoaded {}

/// A creative player put a stack in a slot of their inventory menu, or threw one out where the
/// slot is under 0, vanilla's `ServerboundSetCreativeModeSlotPacket`. The stack is read with the
/// registries, as `ItemStack.OPTIONAL_UNTRUSTED_STREAM_CODEC` reads it, by
/// `ItemCodecs.read_untrusted` (D372).
@packet(Bound.Serverbound, "set_creative_mode_slot")
pub struct ServerboundSetCreativeModeSlot {
    pub slot: i16
    @rest
