/// The play state's packets: those the server sends a player as they join a world and play in
/// it, then `PlayIn`, the packets of play's a client sends that Calcite reads so far, with those
/// it shares with configuration from protocol.common. A packet it doesn't read yet is skipped
/// whole: `PlayIn.reads` says which it reads.
module protocol.play

import auth.profile.{ProfileProperty}
import chat.component.{Component}
import java.uuid.{Uuid}
import nbt.tag.{Accounter, Tag}
import protocol.codegen.{packet, packets, wire}
import protocol.chat.{ServerboundChat, ServerboundChatAck, ServerboundChatCommand}
import protocol.common.{ServerboundClientInformation, ServerboundCustomClickAction, ServerboundCustomPayload, ServerboundKeepAlive, ServerboundPong, ServerboundResourcePack}
import protocol.login.{ServerboundCookieResponse}
import protocol.state.{State, Bound}
import protocol.wire.{Reader, Writer, DecodeError, Wire}
import resources.identifier.{Identifier}
import world.item.{ItemStack}
import world.modes.{Difficulty, GameType, PreviousGameType}
import world.pos.{BlockPos, ChunkPos}

/// A dimension and a block in it, vanilla's `GlobalPos`.
@wire
pub struct GlobalPos {
    pub dimension: Identifier
    pub pos: BlockPos
}

/// What a client needs of the dimension it spawns in, vanilla's `CommonPlayerSpawnInfo`.
@wire
pub struct SpawnInfo {
    /// The dimension's type, by its ID in the `dimension_type` registry.
    @varint
    pub dimension_type: i32
    pub dimension: Identifier
    /// The world's seed as `BiomeManager.obfuscateSeed` hides it, which the client's biome
    /// blending uses.
    pub seed: i64
    pub game_type: GameType
    pub previous_game_type: PreviousGameType
    pub is_debug: bool
    pub is_flat: bool
    pub last_death_location: GlobalPos?
    @varint
    pub portal_cooldown: i32
    @varint
    pub sea_level: i32
}

/// The first packet of play: the player's entity and the world they're in, vanilla's
/// `ClientboundLoginPacket`.
@packet(Bound.Clientbound, "login")
pub struct ClientboundLogin {
    pub player_id: i32
    pub hardcore: bool
    /// Every dimension the server has.
    pub levels: List<Identifier>
    @varint
    pub max_players: i32
    /// The server's view distance, in chunks.
    @varint
    pub chunk_radius: i32
    @varint
    pub simulation_distance: i32
    pub reduced_debug_info: bool
    pub show_death_screen: bool
    pub do_limited_crafting: bool
    pub spawn: SpawnInfo
    pub online_mode: bool
    pub enforces_secure_chat: bool
}

/// The world's difficulty, vanilla's `ClientboundChangeDifficultyPacket`.
@packet(Bound.Clientbound, "change_difficulty")
pub struct ClientboundChangeDifficulty {
    pub difficulty: Difficulty
    pub locked: bool
}

/// What a player may do, vanilla's `Abilities`: sent as a byte of flags, invulnerable 1, flying
/// 2, may fly 4 and builds instantly 8, then the speeds.
pub struct Abilities {
    pub invulnerable: bool = false
    pub flying: bool = false
    pub may_fly: bool = false
    pub instabuild: bool = false
    pub flying_speed: f32 = 0.05
    pub walking_speed: f32 = 0.1
}

impl Abilities {
    /// A player's abilities in `mode`, as `GameType.updatePlayerAbilities` sets them.
    pub fn of(mode: GameType) -> Abilities {
        return match mode {
            GameType.Creative => Abilities { invulnerable: true, may_fly: true, instabuild: true },
            GameType.Spectator => Abilities { invulnerable: true, flying: true, may_fly: true },
            _ => Abilities(),
        }
    }
}

impl Wire for Abilities {
    fn read(r: mut Reader) -> Abilities ! DecodeError {
        let flags = try r.u8()
        let flying_speed = try r.f32()
        let walking_speed = try r.f32()
        return Abilities { invulnerable: flags & 1 != 0, flying: flags & 2 != 0, may_fly: flags & 4 != 0, instabuild: flags & 8 != 0, flying_speed: flying_speed, walking_speed: walking_speed }
    }

    fn write(self, w: mut Writer) {
        var flags: u8 = 0
        if self.invulnerable {
            flags |= 1
        }
        if self.flying {
            flags |= 2
        }
        if self.may_fly {
            flags |= 4
        }
        if self.instabuild {
            flags |= 8
        }
        w.u8(flags)
        w.f32(self.flying_speed)
        w.f32(self.walking_speed)
    }
}

/// The player's abilities, vanilla's `ClientboundPlayerAbilitiesPacket`.
@packet(Bound.Clientbound, "player_abilities")
pub struct ClientboundPlayerAbilities {
    pub abilities: Abilities
}

/// The hotbar slot the player holds, vanilla's `ClientboundSetHeldSlotPacket`.
@packet(Bound.Clientbound, "set_held_slot")
pub struct ClientboundSetHeldSlot {
    @varint
    pub slot: i32
}

/// The items that fit a kind of slot, such as a furnace's fuel, by their IDs, vanilla's
/// `RecipePropertySet`.
@wire
pub struct ItemSet {
    pub key: Identifier
    @varint
    pub items: List<i32>
}

/// The stonecutter's recipes, vanilla's `SelectableRecipe.SingleInputSet`. Calcite has no
/// recipes until Phase 6, so it sends none, and can't read any.
pub struct StonecutterRecipes {}

impl Wire for StonecutterRecipes {
    fn read(r: mut Reader) -> StonecutterRecipes ! DecodeError {
        if try r.varint() != 0 {
            fail DecodeError { message: "Calcite can't read stonecutter recipes yet" }
        }
        return StonecutterRecipes {}
    }

    fn write(self, w: mut Writer) {
        w.varint(0)
    }
}

/// What the client needs of the server's recipes, vanilla's `ClientboundUpdateRecipesPacket`.
@packet(Bound.Clientbound, "update_recipes")
pub struct ClientboundUpdateRecipes {
    pub item_sets: List<ItemSet>
    pub stonecutter: StonecutterRecipes
}

/// Something that happened to an entity, vanilla's `ClientboundEntityEventPacket`, such as a
/// player's permission level, 24 to 28.
@packet(Bound.Clientbound, "entity_event")
pub struct ClientboundEntityEvent {
    pub entity_id: i32
    pub event: i8
}

/// What a node of the command tree is: the root, which every command starts from, or a word.
/// Calcite has no commands with arguments until Phase 6.
pub enum NodeKind {
    Root
    Literal(String)
}

/// A node of the command tree, vanilla's `ClientboundCommandsPacket.Entry`: its kind, whether a
/// command may end there, the nodes that may follow it and the one it redirects to, by their
/// places in the packet's list.
pub struct CommandNode {
    pub kind: NodeKind
    pub executable: bool = false
    /// Whether it needs a permission the player may not have, so the client asks the server.
    pub restricted: bool = false
    pub children: List<i32>
    pub redirect: i32? = none
}

impl Wire for CommandNode {
    fn read(r: mut Reader) -> CommandNode ! DecodeError {
        let flags = try r.u8()
        let left = r.left()
        let count = try r.count(left)
        var children = List<i32>()
        for _ in 0..count {
            children.push(try r.varint())
        }
        var redirect: i32? = none
        if flags & 8 != 0 {
            redirect = some(try r.varint())
        }
        let kind = match flags & 3 {
            0 => NodeKind.Root,
            1 => NodeKind.Literal(try r.string(32767)),
            _ => {
                fail DecodeError { message: "Calcite can't read command arguments yet" }
            },
        }
        return CommandNode { kind: kind, executable: flags & 4 != 0, restricted: flags & 32 != 0, children: children, redirect: redirect }
    }

    fn write(self, w: mut Writer) {
        var flags: u8 = match self.kind {
            NodeKind.Root => 0,
            NodeKind.Literal(_) => 1,
        }
        if self.executable {
            flags |= 4
        }
        if self.redirect != none {
            flags |= 8
        }
        if self.restricted {
            flags |= 32
        }
        w.u8(flags)
        w.count(self.children.len())
        for c in self.children {
            w.varint(c)
        }
        if let to = self.redirect {
            w.varint(to)
        }
        match self.kind {
            NodeKind.Literal(word) => w.string(word, 32767),
            NodeKind.Root => {},
        }
    }
}

/// The commands the player may use, as a tree, vanilla's `ClientboundCommandsPacket`.
@packet(Bound.Clientbound, "commands")
pub struct ClientboundCommands {
    pub nodes: List<CommandNode>
    @varint
    pub root: i32
}

