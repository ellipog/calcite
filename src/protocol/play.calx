    pub relatives: i32
}

/// The server list's description and icon, which the client shows in its pause menu, vanilla's
/// `ClientboundServerDataPacket`.
@packet(Bound.Clientbound, "server_data")
pub struct ClientboundServerData {
    pub motd: Component
    pub icon: List<u8>?
}

/// A player's chat session, which signs their messages, vanilla's `RemoteChatSession.Data`: its
/// ID, and the key Mojang gave the player with its expiry and Mojang's signature.
@wire
pub struct ChatSession {
    pub session_id: Uuid
    /// When the key expires, in milliseconds since 1970.
    pub expires_at: i64
    @max(512)
    pub key: List<u8>
    @max(4096)
    pub key_signature: List<u8>
}

/// A player in the tab list, vanilla's `ClientboundPlayerInfoUpdatePacket.Entry`.
pub struct PlayerEntry {
    pub id: Uuid
    pub name: String = String()
    pub properties: List<ProfileProperty> = []
    pub chat_session: ChatSession? = none
    pub game_type: GameType = GameType.Survival
    pub listed: bool = false
    pub latency: i32 = 0
    pub display_name: Component? = none
    pub list_order: i32 = 0
    pub show_hat: bool = false
}

/// What a `player_info_update` changes, a bit for each, vanilla's
/// `ClientboundPlayerInfoUpdatePacket.Action`s by their places.
pub const ADD_PLAYER: u8 = 1
pub const INITIALIZE_CHAT: u8 = 2
pub const UPDATE_GAME_MODE: u8 = 4
pub const UPDATE_LISTED: u8 = 8
pub const UPDATE_LATENCY: u8 = 16
pub const UPDATE_DISPLAY_NAME: u8 = 32
pub const UPDATE_LIST_ORDER: u8 = 64
pub const UPDATE_HAT: u8 = 128

/// Players' tab list entries and what's sent of them: each entry's UUID, then for each action,
/// in order, its part.
pub struct PlayerInfo {
    pub actions: u8
    pub entries: List<PlayerEntry>
}

impl PlayerInfo {
    /// Everything of each player, as `createPlayerInitializing`.
    pub fn initializing(entries: own List<PlayerEntry>) -> PlayerInfo {
        return PlayerInfo { actions: 255, entries: entries }
    }
}

impl Wire for PlayerInfo {
    fn read(r: mut Reader) -> PlayerInfo ! DecodeError {
        let actions = try r.u8()
        let left = r.left()
        let count = try r.count(left)
        var entries = List<PlayerEntry>()
        for _ in 0..count {
            var e = PlayerEntry { id: try r.uuid() }
            if actions & ADD_PLAYER != 0 {
                e.name = try r.string(16)
                let n = try r.count(16)
                for _ in 0..n {
                    e.properties.push(try ProfileProperty.read(mut r))
                }
            }
            if actions & INITIALIZE_CHAT != 0 {
                if try r.bool() {
                    e.chat_session = some(try ChatSession.read(mut r))
                }
            }
            if actions & UPDATE_GAME_MODE != 0 {
                e.game_type = try GameType.read(mut r)
            }
            if actions & UPDATE_LISTED != 0 {
                e.listed = try r.bool()
            }
            if actions & UPDATE_LATENCY != 0 {
                e.latency = try r.varint()
            }
            if actions & UPDATE_DISPLAY_NAME != 0 {
                if try r.bool() {
                    e.display_name = some(try Component.read(mut r))
                }
            }
            if actions & UPDATE_LIST_ORDER != 0 {
                e.list_order = try r.varint()
            }
            if actions & UPDATE_HAT != 0 {
                e.show_hat = try r.bool()
            }
            entries.push(e)
        }
        return PlayerInfo { actions: actions, entries: entries }
    }

    fn write(self, w: mut Writer) {
        w.u8(self.actions)
        w.count(self.entries.len())
        for e in self.entries {
            w.uuid(e.id)
            if self.actions & ADD_PLAYER != 0 {
                w.string(e.name, 16)
                w.count_at_most(e.properties.len(), 16)
                for p in e.properties {
                    p.write(mut w)
                }
            }
            if self.actions & INITIALIZE_CHAT != 0 {
                match e.chat_session {
                    some(s) => {
                        w.bool(true)
                        s.write(mut w)
                    },
                    none => w.bool(false),
                }
            }
            if self.actions & UPDATE_GAME_MODE != 0 {
                e.game_type.write(mut w)
            }
            if self.actions & UPDATE_LISTED != 0 {
                w.bool(e.listed)
            }
            if self.actions & UPDATE_LATENCY != 0 {
                w.varint(e.latency)
            }
            if self.actions & UPDATE_DISPLAY_NAME != 0 {
                match e.display_name {
                    some(c) => {
                        w.bool(true)
                        c.write(mut w)
                    },
                    none => w.bool(false),
                }
            }
            if self.actions & UPDATE_LIST_ORDER != 0 {
                w.varint(e.list_order)
            }
            if self.actions & UPDATE_HAT != 0 {
                w.bool(e.show_hat)
            }
        }
    }
}

/// Adds players to the tab list or changes them, vanilla's `ClientboundPlayerInfoUpdatePacket`.
@packet(Bound.Clientbound, "player_info_update")
pub struct ClientboundPlayerInfoUpdate {
    pub info: PlayerInfo
}

/// Takes players off the tab list, vanilla's `ClientboundPlayerInfoRemovePacket`.
@packet(Bound.Clientbound, "player_info_remove")
pub struct ClientboundPlayerInfoRemove {
    pub profile_ids: List<Uuid>
}

/// The world border, vanilla's `ClientboundInitializeBorderPacket`.
@packet(Bound.Clientbound, "initialize_border")
pub struct ClientboundInitializeBorder {
    pub center_x: f64
    pub center_z: f64
    pub old_size: f64
    pub new_size: f64
    /// How long it takes to get from the old size to the new, in milliseconds.
    @varint
    pub lerp_time: i64
    @varint
    pub absolute_max_size: i32
    @varint
    pub warning_blocks: i32
    /// How many seconds before the border reaches a player they're warned.
    @varint
    pub warning_time: i32
}

impl ClientboundInitializeBorder {
    /// A new world's border, as `WorldBorder.Settings.DEFAULT` makes it.
    pub fn default() -> ClientboundInitializeBorder {
        let size = f64(f32.nearest(59999968.0))
        return ClientboundInitializeBorder { center_x: 0.0, center_z: 0.0, old_size: size, new_size: size, lerp_time: 0, absolute_max_size: 29999984, warning_blocks: 5, warning_time: 300 }
    }
}

/// One of the world's clocks, vanilla's `ClockNetworkState`, by its ID in the `world_clock`
/// registry: how far it has run, and how fast it runs, 0 when it's stopped.
@wire
pub struct ClockUpdate {
    @varint
    pub clock: i32
    @varint
    pub total_ticks: i64
    pub partial_tick: f32
    pub rate: f32
}

/// The world's age in ticks and its clocks, vanilla's `ClientboundSetTimePacket`.
@packet(Bound.Clientbound, "set_time")
pub struct ClientboundSetTime {
    pub game_time: i64
    pub clocks: List<ClockUpdate>
}

/// Where the compass points and players respawn, vanilla's
