    pub overlay: bool
}

/// Puts the player at a place, which the client accepts with the same ID, vanilla's
/// `ClientboundPlayerPositionPacket`.
@packet(Bound.Clientbound, "player_position")
pub struct ClientboundPlayerPosition {
    @varint
    pub teleport_id: i32
    pub x: f64
    pub y: f64
    pub z: f64
    pub delta_x: f64
    pub delta_y: f64
    pub delta_z: f64
    pub y_rot: f32
    pub x_rot: f32
