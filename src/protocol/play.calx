    pub event: i8
}

/// What a node of the command tree is: the root, which every command starts from, or a word.
/// What a node of the command tree is: the root, a word, or an argument, with its name, its
/// type's ID in `command_argument_type` and the type's properties as `ArgumentTypeInfo` writes
/// them. Calcite's arguments ask the server for no suggestions.
pub enum NodeKind {
    Root
    Literal(String)
    Argument { name: String, parser: i32, properties: List<u8> }
}

/// A node of the command tree, vanilla's `ClientboundCommandsPacket.Entry`: its kind, whether a
/// command may end there, the nodes that may follow it and the one it redirects to, by their
/// places in the packet's list.
pub struct CommandNode {
    pub kind: NodeKind
    pub executable: bool = false
    /// Whether it needs a permission the player may not have, so the client asks the server.
    pub restricted: bool = false
    pub children: List<i32>
    pub redirect: i32? = none
}

impl Wire for CommandNode {
    fn read(r: mut Reader) -> CommandNode ! DecodeError {
        let flags = try r.u8()
        let left = r.left()
        let count = try r.count(left)
        var children = List<i32>()
        for _ in 0..count {
            children.push(try r.varint())
        }
        var redirect: i32? = none
        if flags & 8 != 0 {
            redirect = some(try r.varint())
        }
        let kind = match flags & 3 {
            0 => NodeKind.Root,
            1 => NodeKind.Literal(try r.string(32767)),
            2 => {
                let name = try r.string(32767)
                let parser = try r.varint()
                let properties = try argument_properties(mut r, parser)
                if flags & 16 != 0 {
                    _ = try r.string(32767)
                }
                NodeKind.Argument { name: name, parser: parser, properties: properties }
            },
            _ => {
                fail DecodeError { message: "a command node of an unknown kind" }
            },
        }
        return CommandNode { kind: kind, executable: flags & 4 != 0, restricted: flags & 32 != 0, children: children, redirect: redirect }
    }

    fn write(self, w: mut Writer) {
        var flags: u8 = match self.kind {
            NodeKind.Root => 0,
            NodeKind.Literal(_) => 1,
            NodeKind.Argument { .. } => 2,
        }
        if self.executable {
            flags |= 4
        }
        if self.redirect != none {
            flags |= 8
        }
        if self.restricted {
            flags |= 32
        }
        w.u8(flags)
        w.count(self.children.len())
        for c in self.children {
            w.varint(c)
        }
        if let to = self.redirect {
            w.varint(to)
        }
        match self.kind {
            NodeKind.Literal(word) => w.string(word, 32767),
            NodeKind.Argument { name, parser, properties } => {
                w.string(name, 32767)
                w.varint(parser)
                w.raw(properties)
            },
            NodeKind.Root => {},
        }
    }
}

// The properties of an argument whose type is `parser`, for the types Calcite sends: a number's
// flags and bounds, a float's, a double's or an integer's, an entity's flags, and none for a game
// mode or a dimension. Read only to check what's sent.
fn argument_properties(r: mut Reader, parser: i32) -> List<u8> ! DecodeError {
    var out = List<u8>()
    // `brigadier:float`, `double` and `integer`, 1, 2 and 3, and the size of each bound.
    if parser >= 1 and parser <= 3 {
        let size = if parser == 2 { 8 } else { 4 }
        let flags = try r.u8()
        out.push(flags)
        var n = 0
        if flags & 1 != 0 {
            n += size
        }
        if flags & 2 != 0 {
            n += size
        }
        for _ in 0..n {
            out.push(try r.u8())
        }
    } else if parser == 6 {
        out.push(try r.u8())
    }
    return out
}

/// The commands the player may use, as a tree, vanilla's `ClientboundCommandsPacket`.
@packet(Bound.Clientbound, "commands")
pub struct ClientboundCommands {
    pub nodes: List<CommandNode>
    @varint
    pub root: i32
}

/// Whether one of the recipe book's tabs is open and shows only what can be made, vanilla's
/// `RecipeBookSettings.TypeSettings`.
@wire
pub struct BookTab {
    pub open: bool
    pub filtering: bool
}

/// The recipe book's tabs, vanilla's `ClientboundRecipeBookSettingsPacket`.
@packet(Bound.Clientbound, "recipe_book_settings")
pub struct ClientboundRecipeBookSettings {
    pub crafting: BookTab
    pub furnace: BookTab
    pub blast_furnace: BookTab
    pub smoker: BookTab
}

/// Recipes the player knows, vanilla's `ClientboundRecipeBookAddPacket` entries. Calcite has no
/// recipes until Phase 6, so it sends none, and can't read any.
pub struct BookRecipes {}

impl Wire for BookRecipes {
    fn read(r: mut Reader) -> BookRecipes ! DecodeError {
        if try r.varint() != 0 {
            fail DecodeError { message: "Calcite can't read recipe book entries yet" }
        }
        return BookRecipes {}
    }

    fn write(self, w: mut Writer) {
        w.varint(0)
    }
}

/// Adds to the player's recipe book, or replaces it, vanilla's `ClientboundRecipeBookAddPacket`.
@packet(Bound.Clientbound, "recipe_book_add")
pub struct ClientboundRecipeBookAdd {
    pub recipes: BookRecipes
    pub replace: bool
}

