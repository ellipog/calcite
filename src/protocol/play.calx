    @varint
    pub collector_id: i32
    @varint
    pub amount: i32
}

/// A block's event, vanilla's `ClientboundBlockEventPacket` (CAL-125), which the client runs as
/// the server did, `triggerEvent`, as a piston's moving: where, its two numbers, each a byte, and
/// the block's ID.
@packet(Bound.Clientbound, "block_event")
pub struct ClientboundBlockEvent {
    pub pos: BlockPos
    pub b0: u8
    pub b1: u8
    @varint
    pub block: i32
}

/// A sound at a place, vanilla's `ClientboundSoundPacket` (CAL-125): the sound, its ID in the
/// `sound_event` registry plus one, its source, `SoundSource`'s ordinal, where, eight to a block,
/// its volume and pitch, and the seed its variant is picked with.
@packet(Bound.Clientbound, "sound")
pub struct ClientboundSound {
    @varint
    pub sound: i32
    @varint
    pub source: i32
    pub x: i32
    pub y: i32
    pub z: i32
    pub volume: f32
    pub pitch: f32
    pub seed: i64
}

/// The blocks that changed in a section, vanilla's `ClientboundSectionBlocksUpdatePacket` (D321):
/// the section's position, as `SectionPos.asLong` packs it, and each block's state's ID above its
/// place in the section, `x << 8 | z << 4 | y` in the low 12 bits, a VarLong each.
@packet(Bound.Clientbound, "section_blocks_update")
pub struct ClientboundSectionBlocksUpdate {
    pub section: i64
    @varint
    pub blocks: List<i64>
}

/// One of a chunk's heightmaps, by its type's ID, as `Heightmap.Types` numbers them, with its
/// heights packed in longs.
@wire
pub struct Heightmap {
    @varint
    pub kind: i32
    pub data: List<i64>
}

/// A block entity in a chunk, vanilla's `ClientboundLevelChunkPacketData.BlockEntityInfo`: where
/// in the chunk it is, its type's ID and what the client sees of its data.
pub struct BlockEntityInfo {
    /// Its `x` in the chunk in the high 4 bits, its `z` in the low.
    pub packed_xz: u8
    pub y: i16
    /// Its type's ID in the `block_entity_type` registry.
    pub kind: i32
    pub data: Tag?
}

impl Wire for BlockEntityInfo {
    fn read(r: mut Reader) -> BlockEntityInfo ! DecodeError {
        let packed_xz = try r.u8()
        let y = try r.i16()
        let kind = try r.varint()
        let tag = try r.nbt(Accounter.with_quota(2097152))
        return BlockEntityInfo { packed_xz: packed_xz, y: y, kind: kind, data: if tag.id() == 0 { none } else { some(tag) } }
    }

    fn write(self, w: mut Writer) {
        w.u8(self.packed_xz)
        w.i16(self.y)
        w.varint(self.kind)
        match self.data {
            some(t) => w.nbt(t),
            none => w.nbt(Tag.End),
        }
    }
}

/// A chunk's blocks, vanilla's `ClientboundLevelChunkPacketData`: the heightmaps the client
/// uses, each section in turn, and the block entities.
@wire
pub struct ChunkData {
    pub heightmaps: List<Heightmap>
    @max(2097152)
    pub sections: List<u8>
    pub block_entities: List<BlockEntityInfo>
}

/// A section's light, a nibble a block, vanilla's `DataLayer`.
@wire
pub struct LightLayer {
    @max(2048)
    pub data: List<u8>
}

/// A chunk's light, vanilla's `ClientboundLightUpdatePacketData`: for sky and block light, which
/// of its sections, one below the world to one above, have light and which have none, then the
/// light of those that have it. Each set of sections is a `BitSet`'s bytes, as vanilla's
/// `ByteBufCodecs.BIT_SET` writes it: the bits from the lowest, 8 to a byte, low bit first,
/// without the zero bytes at the end, as `BitSet.toByteArray` gives them.
@wire
pub struct LightData {
    pub sky_mask: List<u8>
    pub block_mask: List<u8>
    pub empty_sky_mask: List<u8>
    pub empty_block_mask: List<u8>
    pub sky: List<LightLayer>
    pub block: List<LightLayer>
}

/// The light of a chunk's sections that changed, vanilla's `ClientboundLightUpdatePacket`, which a
/// player with the chunk on the edge of their view is sent, as they haven't what's beside it to
/// light it with themselves (D342).
@packet(Bound.Clientbound, "light_update")
pub struct ClientboundLightUpdate {
    @varint
    pub x: i32
    @varint
    pub z: i32
    pub light: LightData
}

/// A chunk, with its light, vanilla's `ClientboundLevelChunkWithLightPacket`.
@packet(Bound.Clientbound, "level_chunk_with_light")
pub struct ClientboundLevelChunkWithLight {
    pub x: i32
    pub z: i32
    pub chunk: ChunkData
    pub light: LightData
}

