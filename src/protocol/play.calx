    pub pos: BlockPos
    pub data: i32
    pub global: bool
}

/// Particles at a place, vanilla's `ClientboundLevelParticlesPacket` (CAL-143): the particle, its
/// ID in the `particle_type` registry, of a type with no options; whether it's sent from further
/// and shown whatever the client's particle setting, `overrideLimiter`, and shown however many the
/// client has, `alwaysShow`; where; how far they spread each way; their most speed each way; how
/// many, none for one whose spread is its motion; and `RandomizationType`'s ID.
@packet(Bound.Clientbound, "level_particles")
pub struct ClientboundLevelParticles {
    @varint
    pub particle: i32
    pub override_limiter: bool
    pub always_show: bool
    pub x: f64
    pub y: f64
    pub z: f64
    pub x_dist: f32
    pub y_dist: f32
    pub z_dist: f32
    pub x_speed: f32
    pub y_speed: f32
    pub z_speed: f32
    @varint
    pub count: i32
    @varint
    pub randomization: i32
}

/// An entity's arm swung, vanilla's `ClientboundSwingAnimationPacket` (CAL-143): the entity, the
/// hand, `InteractionHand`'s ID, and its `SwingAnimation`, its type's ID and how many ticks it
/// lasts.
@packet(Bound.Clientbound, "swing_animation")
pub struct ClientboundSwingAnimation {
    @varint
    pub entity_id: i32
    @varint
