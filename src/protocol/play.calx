/// The play state's packets: those the server sends a player as they join a world and play in
/// it, then `PlayIn`, the packets of play's a client sends that Calcite reads so far, with those
/// it shares with configuration from protocol.common. A packet it doesn't read yet is skipped
/// whole: `PlayIn.reads` says which it reads.
module protocol.play

import auth.profile.{ProfileProperty}
import chat.component.{Component}
import java.uuid.{Uuid}
import nbt.tag.{Accounter, Tag}
import protocol.codegen.{packet, packets, wire}
import protocol.chat.{ChatSession, ServerboundChat, ServerboundChatAck, ServerboundChatCommand, ServerboundChatCommandSigned, ServerboundChatSessionUpdate}
import protocol.common.{ServerboundClientInformation, ServerboundCustomClickAction, ServerboundCustomPayload, ServerboundKeepAlive, ServerboundPong, ServerboundResourcePack}
import protocol.login.{ServerboundCookieResponse}
import protocol.state.{State, Bound}
import protocol.wire.{Reader, Writer, DecodeError, Wire}
import resources.identifier.{Identifier}
import world.item.{SentStack}
import world.modes.{Difficulty, GameType, PreviousGameType}
import world.pos.{BlockPos, ChunkPos}
import world.recipes.{Stonecutting}

/// A dimension and a block in it, vanilla's `GlobalPos`.
@wire
pub struct GlobalPos {
    pub dimension: Identifier
    pub pos: BlockPos
}

/// What a client needs of the dimension it spawns in, vanilla's `CommonPlayerSpawnInfo`.
@wire
pub struct SpawnInfo {
    /// The dimension's type, by its ID in the `dimension_type` registry.
    @varint
    pub dimension_type: i32
    pub dimension: Identifier
    /// The world's seed as `BiomeManager.obfuscateSeed` hides it, which the client's biome
    /// blending uses.
    pub seed: i64
    pub game_type: GameType
    pub previous_game_type: PreviousGameType
    pub is_debug: bool
    pub is_flat: bool
    pub last_death_location: GlobalPos?
    @varint
    pub portal_cooldown: i32
    @varint
    pub sea_level: i32
}

/// The first packet of play: the player's entity and the world they're in, vanilla's
/// `ClientboundLoginPacket`.
@packet(Bound.Clientbound, "login")
pub struct ClientboundLogin {
    pub player_id: i32
    pub hardcore: bool
    /// Every dimension the server has.
    pub levels: List<Identifier>
    @varint
    pub max_players: i32
    /// The server's view distance, in chunks.
    @varint
    pub chunk_radius: i32
    @varint
    pub simulation_distance: i32
    pub reduced_debug_info: bool
    pub show_death_screen: bool
    pub do_limited_crafting: bool
    pub spawn: SpawnInfo
    pub online_mode: bool
    pub enforces_secure_chat: bool
}

/// The player is in another dimension, or has respawned, vanilla's `ClientboundRespawnPacket`:
/// the dimension, and which of their entity's data the client keeps.
@packet(Bound.Clientbound, "respawn")
pub struct ClientboundRespawn {
    pub spawn: SpawnInfo
    pub data_to_keep: u8
}

/// What a client keeps of the player's entity across a respawn packet, a bit each: its attribute
/// modifiers 1 and its entity data 2. A player who changes dimension keeps both,
/// `KEEP_ALL_DATA`.
pub const KEEP_ALL_DATA: u8 = 3

/// The world's difficulty, vanilla's `ClientboundChangeDifficultyPacket`.
@packet(Bound.Clientbound, "change_difficulty")
pub struct ClientboundChangeDifficulty {
    pub difficulty: Difficulty
    pub locked: bool
}

/// What a player may do, vanilla's `Abilities`: sent as a byte of flags, invulnerable 1, flying
/// 2, may fly 4 and builds instantly 8, then the speeds.
pub struct Abilities {
    pub invulnerable: bool = false
    pub flying: bool = false
    pub may_fly: bool = false
    pub instabuild: bool = false
    pub flying_speed: f32 = 0.05
    pub walking_speed: f32 = 0.1
    /// Whether they may place blocks, which isn't sent, only saved: not in adventure or
    /// spectator.
    pub may_build: bool = true
}

impl Abilities {
    /// A player's abilities in `mode`, as `GameType.updatePlayerAbilities` sets them.
    pub fn of(mode: GameType) -> Abilities {
        return match mode {
            GameType.Creative => Abilities { invulnerable: true, may_fly: true, instabuild: true },
            GameType.Spectator => Abilities { invulnerable: true, flying: true, may_fly: true },
            _ => Abilities(),
        }
    }

    /// The abilities changed for `mode`, as `GameType.updatePlayerAbilities` changes them: a
    /// creative player keeps flying if they were, and the speeds stay.
    pub fn update(mut self, mode: GameType) {
        match mode {
            GameType.Creative => {
                self.may_fly = true
                self.instabuild = true
                self.invulnerable = true
            },
            GameType.Spectator => {
                self.may_fly = true
                self.instabuild = false
                self.invulnerable = true
                self.flying = true
            },
            _ => {
                self.may_fly = false
                self.instabuild = false
                self.invulnerable = false
                self.flying = false
            },
        }
        self.may_build = mode != GameType.Adventure and mode != GameType.Spectator
    }
}

impl Wire for Abilities {
    fn read(r: mut Reader) -> Abilities ! DecodeError {
        let flags = try r.u8()
        let flying_speed = try r.f32()
        let walking_speed = try r.f32()
        return Abilities { invulnerable: flags & 1 != 0, flying: flags & 2 != 0, may_fly: flags & 4 != 0, instabuild: flags & 8 != 0, flying_speed: flying_speed, walking_speed: walking_speed }
    }

    fn write(self, w: mut Writer) {
        var flags: u8 = 0
        if self.invulnerable {
            flags |= 1
        }
        if self.flying {
            flags |= 2
        }
        if self.may_fly {
            flags |= 4
        }
        if self.instabuild {
            flags |= 8
        }
        w.u8(flags)
        w.f32(self.flying_speed)
        w.f32(self.walking_speed)
    }
}

/// The player's abilities, vanilla's `ClientboundPlayerAbilitiesPacket`.
@packet(Bound.Clientbound, "player_abilities")
pub struct ClientboundPlayerAbilities {
    pub abilities: Abilities
}

