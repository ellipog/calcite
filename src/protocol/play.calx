/// One of a chunk's heightmaps, by its type's ID, as `Heightmap.Types` numbers them, with its
/// heights packed in longs.
@wire
pub struct Heightmap {
    @varint
    pub kind: i32
    pub data: List<i64>
}

/// A block entity in a chunk, vanilla's `ClientboundLevelChunkPacketData.BlockEntityInfo`: where
/// in the chunk it is, its type's ID and what the client sees of its data.
pub struct BlockEntityInfo {
    /// Its `x` in the chunk in the high 4 bits, its `z` in the low.
    pub packed_xz: u8
    pub y: i16
    /// Its type's ID in the `block_entity_type` registry.
    pub kind: i32
    pub data: Tag?
}

impl Wire for BlockEntityInfo {
    fn read(r: mut Reader) -> BlockEntityInfo ! DecodeError {
        let packed_xz = try r.u8()
        let y = try r.i16()
        let kind = try r.varint()
        let tag = try r.nbt(Accounter.with_quota(2097152))
        return BlockEntityInfo { packed_xz: packed_xz, y: y, kind: kind, data: if tag.id() == 0 { none } else { some(tag) } }
    }

    fn write(self, w: mut Writer) {
        w.u8(self.packed_xz)
        w.i16(self.y)
        w.varint(self.kind)
        match self.data {
            some(t) => w.nbt(t),
            none => w.nbt(Tag.End),
        }
    }
}

/// A chunk's blocks, vanilla's `ClientboundLevelChunkPacketData`: the heightmaps the client
/// uses, each section in turn, and the block entities.
@wire
pub struct ChunkData {
    pub heightmaps: List<Heightmap>
    @max(2097152)
    pub sections: List<u8>
    pub block_entities: List<BlockEntityInfo>
}

/// A section's light, a nibble a block, vanilla's `DataLayer`.
@wire
pub struct LightLayer {
    @max(2048)
    pub data: List<u8>
}

/// A chunk's light, vanilla's `ClientboundLightUpdatePacketData`: for sky and block light, which
/// of its sections, one below the world to one above, have light and which have none, as bit
/// sets in longs, then the light of those that have it.
@wire
pub struct LightData {
    pub sky_mask: List<i64>
    pub block_mask: List<i64>
    pub empty_sky_mask: List<i64>
    pub empty_block_mask: List<i64>
    pub sky: List<LightLayer>
    pub block: List<LightLayer>
}

/// A chunk, with its light, vanilla's `ClientboundLevelChunkWithLightPacket`.
@packet(Bound.Clientbound, "level_chunk_with_light")
pub struct ClientboundLevelChunkWithLight {
    pub x: i32
    pub z: i32
    pub chunk: ChunkData
    pub light: LightData
}

/// Everything in a container, vanilla's `ClientboundContainerSetContentPacket`: the player's
/// inventory is container 0.
@packet(Bound.Clientbound, "container_set_content")
pub struct ClientboundContainerSetContent {
    @varint
    pub container_id: i32
    /// Counts the server's changes, so the client knows what its clicks were on.
    @varint
