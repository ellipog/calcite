/// The float vector math vanilla's shots and a shulker's look go by, JOML's (CAL-200):
/// `Vector3f`'s `normalize`, `cross`, `dot` and `rotateAxis`, `Quaternionf`'s `identity`,
/// `rotationX`, `rotationXYZ` and `transform`, and `org.joml.Math`'s `sin`, `cosFromSin` and `sqrt`, without its
/// fast math or `Math.fma`, as JOML 1.10.9 has them, step for step in floats. JOML is MIT
/// licensed, Copyright (c) 2015-2024 Richard Greenlees, Kai Burjack.
module math.joml

import std.java.math.{sin}

/// `Vector3f.rotateY` of x, y, z by `angle` (CAL-274): its sine and `cosFromSin`, then x and z
/// turned about the y axis, each in floats.
pub fn rotate_y(x: f32, y: f32, z: f32, angle: f32) -> (f32, f32, f32) {
    let s = sin_f(angle)
    let c = cos_from_sin(s, angle)
    return (x * c + z * s, y, -x * s + z * c)
}

/// A `Vector3f`.
pub struct Vec3f {
    pub x: f32
    pub y: f32
    pub z: f32
}

// `Math.sqrt(float)`: the double square root, as a float.
fn sqrt_f(v: f32) -> f32 {
    return f32.nearest(f64(v).sqrt())
}

// `Math.sin(float)`: the double sine, as a float.
fn sin_f(v: f32) -> f32 {
    return f32.nearest(sin(f64(v)))
}

// `Math.cosFromSin(sin, angle)`, `cosFromSinInternal`: the root of 1 less the sine's square,
// negative where the angle a quarter turn on, less its whole turns, `(int)` toward 0, is half a
// turn or more.
fn cos_from_sin(s: f32, angle: f32) -> f32 {
    let c = sqrt_f(1.0f32 - s * s)
    let a = angle + 1.5707964f32
    let q = f64(a / 6.2831855f32)
    let turns = i32.saturate(if q < 0.0 { -((-q).floor()) } else { q.floor() })
    var b = a - f32.nearest(turns) * 6.2831855f32
    if f64(b) < 0.0 {
        b = 6.2831855f32 + b
    }
    if b >= 3.1415927f32 {
        return -c
    }
    return c
}

// `Math.cosFromSin(double sin, double angle)`, `cosFromSinInternal`, in doubles, as
// `cos_from_sin` is in floats (CAL-214).
fn cos_from_sin_d(s: f64, angle: f64) -> f64 {
    let c = (1.0 - s * s).sqrt()
    let a = angle + 1.5707963267948966
    let q = a / 6.283185307179586
    let turns = i32.saturate(if q < 0.0 { -((-q).floor()) } else { q.floor() })
    var b = a - f64(turns) * 6.283185307179586
    if b < 0.0 {
        b = 6.283185307179586 + b
    }
    if b >= 3.141592653589793 {
        return -c
    }
    return c
}

impl Vec3f {
    /// `normalize`: scaled by the inverse root of its length's square, `invsqrt` of x's square
    /// added to y's and z's.
    pub fn normalized(self) -> Vec3f {
        let length = self.x * self.x + (self.y * self.y + self.z * self.z)
        let scale = 1.0f32 / sqrt_f(length)
        return Vec3f { x: self.x * scale, y: self.y * scale, z: self.z * scale }
    }

    /// `dot(v)`, x's product added to y's added to z's, `fma`.
    pub fn dot(self, v: Vec3f) -> f32 {
        return self.x * v.x + (self.y * v.y + self.z * v.z)
    }

    /// `cross(v)`, each part `fma` of one product and the other's negation.
    pub fn cross(self, v: Vec3f) -> Vec3f {
        let x = self.y * v.z + -self.z * v.y
        let y = self.z * v.x + -self.x * v.z
        let z = self.x * v.y + -self.y * v.x
        return Vec3f { x: x, y: y, z: z }
    }

    /// `lengthSquared`.
    pub fn length_squared(self) -> f32 {
        return self.x * self.x + (self.y * self.y + self.z * self.z)
    }

    /// `rotateAxisInternal(angle, x, y, z)`: turned `angle` radians about the axis, as its
    /// quaternion from half the angle's sine and `cosFromSin` turns it. `rotateAxis` turns about a
    /// unit axis along x, y or z its own way, `rotateX` and the rest, which `axis_aligned` says.
    pub fn rotated(self, angle: f32, ax: f32, ay: f32, az: f32) -> Vec3f {
        let half = angle * 0.5f32
        let s = sin_f(half)
        let qx = ax * s
        let qy = ay * s
        let qz = az * s
        let qw = cos_from_sin(s, half)
        let w2 = qw * qw
        let x2 = qx * qx
        let y2 = qy * qy
        let z2 = qz * qz
        let zw = qz * qw
        let xy = qx * qy
        let xz = qx * qz
        let yw = qy * qw
        let yz = qy * qz
        let xw = qx * qw
        let nx = (w2 + x2 - z2 - y2) * self.x + (-zw + xy - zw + xy) * self.y + (yw + xz + xz + yw) * self.z
        let ny = (xy + zw + zw + xy) * self.x + (y2 - z2 + w2 - x2) * self.y + (yz + yz - xw - xw) * self.z
        let nz = (xz - yw + xz - yw) * self.x + (yz + yz + xw + xw) * self.y + (z2 - y2 - x2 + w2) * self.z
        return Vec3f { x: nx, y: ny, z: nz }
    }
}

/// Whether `rotateAxis` about x, y, z would turn about a unit axis along x, y or z its own way,
/// `absEqualsOne` of the one part not 0.
pub fn axis_aligned(x: f32, y: f32, z: f32) -> bool {
    let one = (x == 0.0f32 and y == 0.0f32) or (x == 0.0f32 and z == 0.0f32) or (y == 0.0f32 and z == 0.0f32)
    if not one {
        return false
    }
    let a = if x != 0.0f32 { x } else if y != 0.0f32 { y } else { z }
    return a == 1.0f32 or a == -1.0f32
}

/// A `Quaternionf`, x, y, z and w (CAL-200).
pub struct Quatf {
    pub x: f32
    pub y: f32
    pub z: f32
    pub w: f32
}

impl Quatf {
    /// `new Quaternionf()`, no turn.
    pub fn identity() -> Quatf {
        return Quatf { x: 0.0f32, y: 0.0f32, z: 0.0f32, w: 1.0f32 }
    }

    /// `setAngleAxis(double angle, double x, double y, double z)` (CAL-214): half the angle's
    /// sine, in doubles, times each part of the axis, which isn't made a unit long, as floats;
    /// and `cosFromSin` of it as w.
    pub fn angle_axis(angle: f64, x: f64, y: f64, z: f64) -> Quatf {
        let s = sin(angle * 0.5)
        return Quatf { x: f32.nearest(x * s), y: f32.nearest(y * s), z: f32.nearest(z * s), w: f32.nearest(cos_from_sin_d(s, angle * 0.5)) }
    }

    /// `rotationX(angle)`: `angle` radians about x, from half the angle's sine and `cosFromSin`.
    pub fn rotation_x(angle: f32) -> Quatf {
        let s = sin_f(angle * 0.5f32)
        let c = cos_from_sin(s, angle * 0.5f32)
        return Quatf { x: s, y: 0.0f32, z: 0.0f32, w: c }
    }

    /// `rotationY(angle)`: `angle` radians about y, from half the angle's sine and `cosFromSin`
    /// (CAL-214).
    pub fn rotation_y(angle: f32) -> Quatf {
        let s = sin_f(angle * 0.5f32)
        let c = cos_from_sin(s, angle * 0.5f32)
        return Quatf { x: 0.0f32, y: s, z: 0.0f32, w: c }
    }

    /// `rotateX(angle)`: it turned `angle` radians more about x, as JOML puts the parts together
    /// (CAL-214).
    pub fn rotate_x(self, angle: f32) -> Quatf {
        let s = sin_f(angle * 0.5f32)
        let c = cos_from_sin(s, angle * 0.5f32)
        return Quatf { x: self.w * s + self.x * c, y: self.y * c + self.z * s, z: self.z * c - self.y * s, w: self.w * c - self.x * s }
    }

    /// `transform(double x, double y, double z, Vector3d dest)` (CAL-214): as `transform`, its
    /// float parts times the doubles, `fma`s here plain products and sums, exact where two of
    /// them are none.
    pub fn transform_d(self, x: f64, y: f64, z: f64) -> (f64, f64, f64) {
        let xx = self.x * self.x
        let yy = self.y * self.y
        let zz = self.z * self.z
        let ww = self.w * self.w
        let xy = self.x * self.y
        let xz = self.x * self.z
        let yz = self.y * self.z
        let xw = self.x * self.w
        let zw = self.z * self.w
        let yw = self.y * self.w
        let k = 1.0f32 / (xx + yy + zz + ww)
        let nx = f64((xx - yy - zz + ww) * k) * x + (f64(2.0f32 * (xy - zw) * k) * y + f64(2.0f32 * (xz + yw) * k) * z)
        let ny = f64(2.0f32 * (xy + zw) * k) * x + (f64((yy - xx - zz + ww) * k) * y + f64(2.0f32 * (yz - xw) * k) * z)
        let nz = f64(2.0f32 * (xz - yw) * k) * x + (f64(2.0f32 * (yz + xw) * k) * y + f64((zz - xx - yy + ww) * k) * z)
        return (nx, ny, nz)
    }

    /// `rotationXYZ(ax, ay, az)`: about x, then y, then z, each half angle's sine and
    /// `cosFromSin` put together as JOML puts them.
    pub fn rotation_xyz(ax: f32, ay: f32, az: f32) -> Quatf {
        let sx = sin_f(ax * 0.5f32)
        let cx = cos_from_sin(sx, ax * 0.5f32)
        let sy = sin_f(ay * 0.5f32)
        let cy = cos_from_sin(sy, ay * 0.5f32)
        let sz = sin_f(az * 0.5f32)
        let cz = cos_from_sin(sz, az * 0.5f32)
        let cycz = cy * cz
        let sysz = sy * sz
        let sycz = sy * cz
        let cysz = cy * sz
        return Quatf { w: cx * cycz - sx * sysz, x: sx * cycz + cx * sysz, y: cx * sycz - sx * cysz, z: cx * cysz + sx * sycz }
    }

    /// `transform(v)`: `v` turned by it, divided by its length's square, `k`, each part the `fma`s
    /// JOML chains, here plain products and sums.
    pub fn transform(self, v: Vec3f) -> Vec3f {
        let xx = self.x * self.x
        let yy = self.y * self.y
        let zz = self.z * self.z
        let ww = self.w * self.w
        let xy = self.x * self.y
        let xz = self.x * self.z
        let yz = self.y * self.z
        let xw = self.x * self.w
        let zw = self.z * self.w
        let yw = self.y * self.w
        let k = 1.0f32 / (xx + yy + zz + ww)
        let nx = (xx - yy - zz + ww) * k * v.x + (2.0f32 * (xy - zw) * k * v.y + (2.0f32 * (xz + yw) * k) * v.z)
        let ny = 2.0f32 * (xy + zw) * k * v.x + ((yy - xx - zz + ww) * k * v.y + (2.0f32 * (yz - xw) * k) * v.z)
        let nz = 2.0f32 * (xz - yw) * k * v.x + (2.0f32 * (yz + xw) * k * v.y + ((zz - xx - yy + ww) * k) * v.z)
        return Vec3f { x: nx, y: ny, z: nz }
    }
}
