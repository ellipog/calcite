/// Minecraft's `Mth`, where it isn't plain arithmetic: the sine table the game turns angles
/// through, its own arctangent from a table of arcsines, the inverse square root by bit trick,
/// angles wrapped to a half turn either way, and rounding down as the game does.
module math.mth

import std.java.math.{asin, cos, sin}

/// How many table steps make a radian: 65536 to a turn.
const SIN_SCALE: f64 = 10430.378350470453

/// `Mth.SIN`: the sine of each of 65536 steps of a turn, each `(float) Math.sin` of the step's
/// angle. Built once and passed to what turns angles, as the language keeps no global state. Its
/// 256 KiB are shared: a copy reads the same table, so the threads that each have a copy, such as
/// the generator's workers, keep one in the processor's cache, not one each (D255).
pub struct SinTable {
    values: Shared<List<f32>>
}

impl SinTable {
    pub fn new() -> SinTable {
        var values: List<f32> = [0.0f32; 65536]
        for i in 0..65536 {
            values[usize.wrap(i)] = f32.nearest(sin(f64(i) / SIN_SCALE))
        }
        return SinTable { values: Shared(values) }
    }

    /// The table's entry `i`, of 65536.
    pub fn entry(self, i: usize) -> f32 {
        return self.values.value[i]
    }

    /// `Mth.sin`: the entry at the angle's step, the step cast to a `long` and taken mod 65536.
    pub fn sin(self, angle: f64) -> f32 {
        return self.values.value[usize.wrap(i64.saturate(angle * SIN_SCALE) & 65535)]
    }

    /// `Mth.cos`: the entry a quarter turn on.
    pub fn cos(self, angle: f64) -> f32 {
        return self.values.value[usize.wrap(i64.saturate(angle * SIN_SCALE + 16384.0) & 65535)]
    }
}

/// `Mth.cos` without the table, for what turns an angle now and then: the entry `SinTable.cos`
/// reads, made as the table makes it (CAL-130).
pub fn table_cos(angle: f64) -> f32 {
    let step = i64.saturate(angle * SIN_SCALE + 16384.0) & 65535
    return f32.nearest(sin(f64.nearest(step) / SIN_SCALE))
}

/// `Mth.sin` without the table, as `table_cos` (CAL-139).
pub fn table_sin(angle: f64) -> f32 {
    let step = i64.saturate(angle * SIN_SCALE) & 65535
    return f32.nearest(sin(f64.nearest(step) / SIN_SCALE))
}

/// `Mth.FRAC_BIAS`: 2^44, which a number from 0 to 1 is added to, to round it to 1/256 and
/// read the 256ths off its low bits.
const FRAC_BIAS: f64 = 17592186044416.0
/// `Math.PI` and `Math.PI / 2`.
const PI: f64 = 3.141592653589793
const HALF_PI: f64 = 1.5707963267948966
/// `Mth.RAD_TO_DEG`: 180 over `(float) Math.PI` in float, which an angle in radians is multiplied
/// by once in double, what the decompiler shows as `* 180.0F / (float)Math.PI` (D415, D442).
pub const RAD_TO_DEG: f64 = 57.2957763671875

/// `Mth.ASIN_TAB` and `COS_TAB`: the arcsine of each 256th from 0 to 1, and its cosine, which
/// `Mth.atan2` starts from.
pub struct AsinTable {
    asin: List<f64>
    cos: List<f64>
}

impl AsinTable {
    pub fn new() -> AsinTable {
        var a: List<f64> = [0.0; 257]
        var c: List<f64> = [0.0; 257]
        for i in 0..257 {
            let v = asin(f64(i) / 256.0)
            c[usize.wrap(i)] = cos(v)
            a[usize.wrap(i)] = v
        }
        return AsinTable { asin: a, cos: c }
    }

    /// `Mth.atan2`: the angle from the nearest 256th's arcsine, corrected by a cubic, then
    /// turned into its octant. None where vanilla's index falls outside the table and Java
    /// throws `ArrayIndexOutOfBoundsException`, which no finite or infinite argument reaches.
    pub fn atan2(self, y0: f64, x0: f64) -> f64? {
        let d2 = x0 * x0 + y0 * y0
        if d2.is_nan() {
            return some(f64.NAN)
        }
        let o = octant(y0, x0, d2)
        if o.index < 0 or o.index > 256 {
            return none
        }
        return some(o.angle(self.asin[usize.wrap(o.index)], self.cos[usize.wrap(o.index)]))
    }
}

// What `Mth.atan2` makes of its point before the table: the point turned into the first octant
// and onto the unit circle, which turns it went through, and the 256th of the table it reads.
struct Octant {
    x: f64
    y: f64
    yp: f64
    index: i32
    steep: bool
    neg_x: bool
    neg_y: bool
}

fn octant(y0: f64, x0: f64, d2: f64) -> Octant {
    var y = y0
    var x = x0
    let neg_y = y < 0.0
    if neg_y {
        y = -y
    }
    let neg_x = x < 0.0
    if neg_x {
        x = -x
    }
    let steep = y > x
    if steep {
        let t = x
        x = y
        y = t
    }
    let rinv = fast_inv_sqrt(d2)
    x *= rinv
    y *= rinv
    let yp = FRAC_BIAS + y
    return Octant { x: x, y: y, yp: yp, index: i32.wrap(yp.to_bits()), steep: steep, neg_x: neg_x, neg_y: neg_y }
}

impl Octant {
    // The angle from the table's arcsine and cosine at its 256th, corrected by a cubic and turned
    // back out of the first octant.
    fn angle(self, phi: f64, c_phi: f64) -> f64 {
        let s_phi = self.yp - FRAC_BIAS
        let sd = self.y * c_phi - self.x * s_phi
        let d = (6.0 + sd * sd) * sd * 0.16666666666666666
        var theta = phi + d
        if self.steep {
            theta = HALF_PI - theta
        }
        if self.neg_x {
            theta = PI - theta
        }
        if self.neg_y {
            theta = -theta
        }
        return theta
    }
}

/// `Mth.atan2` without the table, for what turns toward a place now and then, as a mob's
/// controls do: the entries `AsinTable` reads, made as it makes them (CAL-157).
pub fn table_atan2(y0: f64, x0: f64) -> f64? {
    let d2 = x0 * x0 + y0 * y0
    if d2.is_nan() {
        return some(f64.NAN)
    }
    let o = octant(y0, x0, d2)
    if o.index < 0 or o.index > 256 {
        return none
    }
    let v = asin(f64(o.index) / 256.0)
    return some(o.angle(v, cos(v)))
}

/// `Mth.fastInvSqrt`: the inverse square root from the bits' magic guess and one step of
/// Newton's method.
pub fn fast_inv_sqrt(v: f64) -> f64 {
    let half = 0.5 * v
    let i = 6910469410427058090 - (i64.wrap(v.to_bits()) >> 1)
    let x = f64.from_bits(u64.wrap(i))
    return x * (1.5 - half * x * x)
}

/// `Mth.wrapDegrees(float)`: the angle within -180 up to 180, from its remainder by a turn.
pub fn wrap_degrees(angle: f32) -> f32 {
    var a = angle % 360.0f32
    if a >= 180.0f32 {
        a -= 360.0f32
    }
    if a < -180.0f32 {
        a += 360.0f32
    }
    return a
}

/// `Mth.wrapDegrees(double)`: as `wrap_degrees`, in doubles (CAL-160).
pub fn wrap_degrees_f64(angle: f64) -> f64 {
    var a = angle % 360.0
    if a >= 180.0 {
        a -= 360.0
    }
    if a < -180.0 {
        a += 360.0
    }
    return a
}

/// `Math.round(float)`: the nearest whole number, halves up, saturating, NaN to 0 (CAL-163).
pub fn round_float(v: f32) -> i32 {
    let d = f64(v)
    if d.is_nan() {
        return 0
    }
    let down = d.floor()
    return i32.saturate(if d - down >= 0.5 { down + 1.0 } else { down })
}

/// `Math.round(double)`: the nearest whole number, halves up, saturating, NaN to 0 (CAL-164).
pub fn round_double(v: f64) -> i64 {
    if v.is_nan() {
        return 0
    }
    let down = v.floor()
    return i64.saturate(if v - down >= 0.5 { down + 1.0 } else { down })
}

/// `Mth.floor(double)`: `(int) Math.floor(v)`, saturating, NaN to 0.
pub fn floor(v: f64) -> i32 {
    return i32.saturate(v.floor())
}
