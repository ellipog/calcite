/// Scratch: times `world.light` on flat chunks and on random terrain. Not committed.
module light_bench

import std.time.{Instant}
import world.chunk.{BlockStates, Chunk}
import world.light.{Light, LightChunks, LightStates, SkySources, light_sources}

const MIN_Y: i32 = -64
const SECTIONS: i32 = 24

fn key(chunk_x: i32, chunk_z: i32) -> i64 {
    return (i64(chunk_x) << 32) | (i64(chunk_z) & 0xFFFFFFFF)
}

struct World {
    table: BlockStates
    states: LightStates
    chunks: Map<i64, Chunk> = Map<i64, Chunk>()
    sources: Map<i64, SkySources> = Map<i64, SkySources>()
}

impl World {
    fn put(mut self, x: i32, y: i32, z: i32, state: u32) {
        _ = self.chunks[key(x >> 4, z >> 4)].set_block(self.table, x & 15, y, z & 15, state)
    }
}

impl LightChunks for World {
    fn light_state(self, x: i32, y: i32, z: i32) -> u32? {
        let k = key(x >> 4, z >> 4)
        if not self.chunks.contains(k) {
            return none
        }
        return some(self.chunks[k].block(x & 15, y, z & 15))
    }

    fn lowest_sky_source(self, x: i32, z: i32) -> i32? {
        let k = key(x >> 4, z >> 4)
        if not self.sources.contains(k) {
            return none
        }
        return some(self.sources[k].lowest_source_y(x & 15, z & 15))
    }

    fn highest_sky_source(self, chunk_x: i32, chunk_z: i32) -> i32? {
        let k = key(chunk_x, chunk_z)
        if not self.sources.contains(k) {
            return none
        }
        return some(self.sources[k].highest_lowest_source_y())
    }

    fn light_sources_in(self, chunk_x: i32, chunk_z: i32) -> List<i64> {
        let k = key(chunk_x, chunk_z)
        if not self.chunks.contains(k) {
            return []
        }
        return light_sources(self.chunks[k], self.states, chunk_x, chunk_z)
    }
}

fn make(radius: i32, count: i32) -> World {
    var world = World { table: BlockStates.new([], [], 1), states: LightStates.new() }
    for cx in -radius..radius + 1 {
        for cz in -radius..radius + 1 {
            world.chunks.insert(key(cx, cz), Chunk.new(world.table, MIN_Y, SECTIONS, 0))
            world.sources.insert(key(cx, cz), SkySources.new(MIN_Y))
            var y = MIN_Y
            for state in [88u32, 10u32, 10u32, 9u32] {
                for x in 0..16 {
                    for z in 0..16 {
                        world.put(cx * 16 + x, y, cz * 16 + z, state)
                    }
                }
                y += 1
            }
        }
    }
    let pool = [0u32, 0u32, 0u32, 1u32, 1u32, 661u32, 294u32, 89u32, 8686u32, 4926u32, 105u32, 15178u32, 15180u32, 5474u32]
    var x: u64 = 12345
    let side = radius * 32 + 16
    for _ in 0..count {
        x = x * 6364136223846793005 + 1442695040888963407
        let a = i32.wrap(x >> 33)
        x = x * 6364136223846793005 + 1442695040888963407
        let b = i32.wrap(x >> 33)
        x = x * 6364136223846793005 + 1442695040888963407
        let c = i32.wrap(x >> 33)
        x = x * 6364136223846793005 + 1442695040888963407
        let d = i32.wrap(x >> 33)
        world.put(-radius * 16 + a % side, -60 + b % 100, -radius * 16 + c % side, pool[usize.wrap(d % 14)])
    }
    for cx in -radius..radius + 1 {
        for cz in -radius..radius + 1 {
            let k = key(cx, cz)
            world.sources[k].fill_from(world.chunks[k], world.states)
        }
    }
    return world
}

fn light_all(world: World, radius: i32) -> i32 {
    let begin = unsafe { Instant.now() }
    var light = Light.new(MIN_Y, SECTIONS * 16, true)
    for cx in -radius..radius + 1 {
        for cz in -radius..radius + 1 {
            let k = key(cx, cz)
            for i in 0..world.chunks[k].section_count() {
                if not world.chunks[k].section_only_air(i) {
                    light.update_section_status(cx, (MIN_Y >> 4) + i32.wrap(i), cz, false)
                }
            }
            _ = light.run(world.states, world)
            light.set_light_enabled(world, cx, cz, false)
            light.retain_data(cx, cz, false)
        }
    }
    if radius == 4 {
        println("  first half {unsafe { Instant.now() }.nanos_since(begin) / 1000} us")
    }
    let mid = unsafe { Instant.now() }
    var count = 0
    var prop: u64 = 0
    for cx in -radius..radius + 1 {
        for cz in -radius..radius + 1 {
            let a = unsafe { Instant.now() }
            light.propagate_light_sources(world.states, world, cx, cz)
            prop += unsafe { Instant.now() }.nanos_since(a)
            count += light.run(world.states, world)
        }
    }
    if radius == 4 {
        println("  second half {unsafe { Instant.now() }.nanos_since(mid) / 1000} us, propagate_light_sources {prop / 1000} us")
    }
    return count
}

fn time(name: String, world: World, radius: i32, runs: i32) {
    var best: u64 = u64.MAX
    var total: u64 = 0
    var count = 0
    for _ in 0..runs {
        let start = unsafe { Instant.now() }
        count = light_all(world, radius)
        let took = unsafe { Instant.now() }.nanos_since(start)
        total += took
        if took < best {
            best = took
        }
    }
    println("{name}: best {best / 1000} us, mean {total / u64.wrap(runs) / 1000} us, {count} entries")
}

fn sources_time(world: mut World, radius: i32) {
    let start = unsafe { Instant.now() }
    for _ in 0..10 {
        for cx in -radius..radius + 1 {
            for cz in -radius..radius + 1 {
                let k = key(cx, cz)
                world.sources[k].fill_from(world.chunks[k], world.states)
            }
        }
    }
    let took = unsafe { Instant.now() }.nanos_since(start)
    println("fill_from x{(2 * radius + 1) * (2 * radius + 1)}: {took / 10 / 1000} us")
    let s2 = unsafe { Instant.now() }
    let states = LightStates.new()
    println("LightStates.new: {unsafe { Instant.now() }.nanos_since(s2) / 1000} us {states.dampening(1)}")
}

fn lookups(world: World, radius: i32) {
    let start = unsafe { Instant.now() }
    var sum = 0
    for cx in -radius..radius + 1 {
        for cz in -radius..radius + 1 {
            for z in -1..17 {
                for x in -1..17 {
                    sum += world.lowest_sky_source(cx * 16 + x, cz * 16 + z) ?? 0
                }
            }
        }
    }
    println("lookups x{(2 * radius + 1) * (2 * radius + 1) * 324}: {unsafe { Instant.now() }.nanos_since(start) / 1000} us {sum}")
}

fn main() {
    var flat = make(4, 0)
    lookups(flat, 4)
    lookups(flat, 4)
    sources_time(mut flat, 4)
    time("flat 9x9", flat, 4, 30)
    let terrain = make(3, 40000)
    time("terrain 7x7", terrain, 3, 10)
}
