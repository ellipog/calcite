// A player on their way to another dimension: their entity, the dimension, by its place in the
// world's, where in it they're going, and the source who sent them, if it's not they (CAL-69).
struct Travel {
    entity_id: i32
    to: usize
    x: f64
    z: f64
    told: Source?
}

/// How long a connection may send nothing before it's closed, as vanilla's
/// `ReadTimeoutHandler(30)`.
pub const READ_TIMEOUT_NS: u64 = 30000000000

/// How many ticks a login may take before it's closed, as vanilla's `MAX_TICKS_BEFORE_LOGIN`.
pub const MAX_LOGIN_TICKS: i32 = 600

/// How often a player is sent a keep-alive, in milliseconds, as vanilla's
/// `LATENCY_CHECK_INTERVAL`. One still unanswered when the next is due ends the connection.
pub const KEEP_ALIVE_MS: i64 = 15000

/// What the server list shows, and how the server answers it.
pub struct StatusInfo {
    /// Whether the server answers the server list, from `enable-status`.
    pub enabled: bool
    /// What the status response says. Its description and icon are what a player is sent as
    /// they join, for their pause menu.
    pub status: ServerStatus
    /// The description as text, for the old ping.
    pub motd: String
}

/// How often the status is rebuilt, as vanilla's `STATUS_EXPIRE_TIME_NANOS`: 5 seconds.
pub const STATUS_EXPIRE_NS: u64 = 5000000000

/// How the server lets players in, from server.properties.
pub struct LoginSettings {
    /// Whether players are authenticated with Mojang's session server, from `online-mode`.
    pub online_mode: bool
    /// Whether players another server sends here are let in, from `accepts-transfers`.
    pub accepts_transfers: bool
    /// The length from which packets are compressed, or a negative number for no compression,
    /// from `network-compression-threshold`.
    pub compression_threshold: i32
    /// Whether the log shows players' addresses, from `log-ips`.
    pub log_ips: bool
    /// Whether the session server is given a player's address, so it can refuse a player who
    /// joins from another address than they logged in from, from `prevent-proxy-connections`.
    pub prevent_proxy_connections: bool
    /// The secret of the Velocity proxy players are let in through, with the player data its
    /// modern forwarding sends, or `none` to let them in as vanilla does, from calcite.properties.
    pub velocity_secret: String?
    /// The packets a second a connection may average before it's kicked, or 0 for no limit, from
    /// `rate-limit`.
    pub rate_limit: i32 = 0
    /// The fewest milliseconds between two tries to log in from one address, or 0 to let every
    /// try in, from calcite.properties' `login-throttle`.
    pub login_throttle: i32 = 0
}

/// What a connection is doing: which of vanilla's packet listeners it has.
enum Phase {
    Handshake
    Status
    Login
    Configuration
    Play
}

/// A step of configuration, one of vanilla's `ConfigurationTask`s, in the order they run.
enum Task {
    /// The registries: the client says which of the server's packs it has, then gets what it
    /// lacks.
    SynchronizeRegistries
    /// The code of conduct, which the player accepts.
    CodeOfConduct
    /// The resource pack, which the client loads or declines.
    ResourcePack
    /// The player's place in the world, made ready.
    PrepareSpawn
    /// Configuration ends, and the client says it's ready to play.
    JoinWorld
}

// The task as vanilla's `ConfigurationTask.Type` writes it, or `null` for none.
fn task_name(t: Task?) -> String {
    let task = t else return String("null")
    return match task {
        Task.SynchronizeRegistries => String("synchronize_registries"),
        Task.CodeOfConduct => String("server_code_of_conduct"),
        Task.ResourcePack => String("server_resource_pack"),
        Task.PrepareSpawn => String("prepare_spawn"),
        Task.JoinWorld => String("join_world"),
    }
}

fn is(t: Task?, want: Task) -> bool {
    if let task = t {
        return task == want
    }
    return false
}

/// Where a login is, vanilla's `ServerLoginPacketListenerImpl.State`.
enum LoginState {
    /// Waiting for the client's hello.
    Hello
    /// Waiting for the client's encryption response.
    Key
    /// Waiting for the player data a Velocity proxy forwards.
    Forwarding
    /// Waiting for Mojang's session server.
    Authenticating
    /// The player has a profile, which the next tick checks.
    Verifying
    /// The profile was sent, and the client is to acknowledge it.
    ProtocolSwitching
    /// The client is in configuration.
    Accepted
}

struct Connection {
    conn: Conn
    codec: Decoder
    // What it's to send, and whether it's on the list of connections to flush.
    out: Outbox
    listed: bool
    phase: Phase
    // Whether anything has arrived yet, since only the first read can be an old ping.
    started: bool
    status_requested: bool
    // When the connection last sent something, in the caller's nanoseconds.
    last_read: u64
    // Whether the server has closed it, and waits for its `Closed` event.
    closing: bool
    // The address the connection is from, and as vanilla logs it, such as `/127.0.0.1:50412`,
    // or `IP hidden`.
    peer: Address?
    address: String
    // The IP a ban of an address is checked against, as `IpBanList` cuts it from the address.
    ban_ip: String
    login: LoginState
    login_ticks: i32
    // Whether another server sent the player here.
    transferred: bool
    // The 4 random bytes the client is to send back encrypted, as vanilla's `challenge`.
    challenge: List<u8>
    // The transaction ID of the query that asks a Velocity proxy for the player's data.
    query_id: i32
    // The name the client gave, and the profile it's let in with.
    name: String?
    profile: GameProfile?
    // Why the server ended it, which is logged once it's gone.
    reason: Component?
    // In configuration: the tasks to come and the one going, and what the client said of itself.
    tasks: List<Task>
    task: Task?
    information: ClientInformation
    // The last keep-alive, in milliseconds on the caller's clock, which is its challenge too,
    // whether it's unanswered, and the connection's latency, as vanilla's listener keeps them.
    keep_alive_time: i64
    keep_alive_pending: bool
    latency: i32
    // The state of what the server sends, which is play's once configuration is done.
    outbound: State
    // In play: the player in the world.
    player: Player
    // The ticks it's had, the packets it was handled since its last second, and their average
    // a second, as vanilla's `Connection` counts them for `rate-limit`.
    ticks: i32 = 0
    received: i32 = 0
    average_received: f32 = 0.0
    // Where the player joins, as the spawn task works it out.
    prepare: Prepare = Prepare()
    // Whether the packet that ends configuration waits for the next tick, so what came after it
    // isn't read until it's run, as vanilla's `ProtocolSwapHandler` stops reading till the play
    // protocol is set up (CAL-150).
    held: bool = false
    // Whether the client closed it, which the tick's connections find, as vanilla's
    // `ServerConnectionListener.tick` finds a connection that isn't connected and hands it to its
    // listener's `onDisconnect`: till then the player's still in the world, and is sent nothing
    // (CAL-151).
    gone: bool = false
    // Whether its listener's been told it's gone, `onDisconnect`, as vanilla's connection keeps
    // `disconnectionHandled`: the player's out of the world, and it waits only for its `Closed`
    // event. One the server closed is handled in the tick's connections after, as vanilla's
    // `handleDisconnection` waits for its channel to close (D445).
    handled: bool = false
}

// Where a joining player goes, as vanilla's `PrepareSpawnTask` works it out: the search for the
// place, until it's found, then the place, the spawn ticket added around it, and the chunks there
// full, after which each configuration tick adds the ticket again, as the task goes from
// `Preparing` to `Ready`.
struct Prepare {
    // Whether it's waiting for the generator to find a new world's spawn, to start from.
    awaiting: bool = false
    // The search, and the candidate whose chunk is loading to be checked.
    search: SpawnSearch? = none
    candidate: Candidate? = none
    // Whether the place is found, and the place and the angle the player faces.
    found: bool = false
    x: f64 = 0.0
    y: f64 = 0.0
    z: f64 = 0.0
    y_rot: f32 = 0.0
    x_rot: f32 = 0.0
    // Whether the spawn ticket's been added, and whether the chunks around the place are full.
    ticketed: bool = false
    ready: bool = false
    // The player's data as it was read, if they have any.
    data: JavaHashMap<String, Tag>? = none
    // The dimension the place is in, by its place in the world's: where they were saved, or the
    // Overworld (CAL-69).
    dim: usize = 0
    // Whether a respawn's waiting on the chunks of the block its spawn was set by, and whether
    // that block's missing, which the player's told, their spawn forgotten (D576).
    block: bool = false
    missing: bool = false
    // Whether it's where an end portal takes the player out of the End, not a respawn, as
    // `getPortalDestination` asks `findRespawnPositionAndUseSpawnBlock`; whether the block their
    // spawn's set by is kept as it is, `consumeSpawnBlock` false, as it is for that and for the
    // respawn after the credits; and whether the respawn keeps all they have, as that one does,
    // `keepAllPlayerData` (D586).
    portal: bool = false
    keep_block: bool = false
    keep_all: bool = false
}

impl Prepare {
    // The place is `x`, `y`, `z`.
    fn place(mut self, x: f64, y: f64, z: f64) {
        self.found = true
        self.x = x
        self.y = y
        self.z = z
        self.search = none
        self.candidate = none
    }

    // The chunk the place is in, `ChunkPos.containing(BlockPos.containing(pos))`.
    fn chunk(self) -> ChunkPos {
        return ChunkPos.containing(self.x, self.z)
    }
}

// A player in the world, as their `ServerPlayer` and its listener hold them.
// A container's menu a player has open (CAL-144): its container ID; what it's of, as its block
// opened it; the menu's state, the cursor and what the client's been sent; its state ID,
// `incrementStateId`; and whether it opened for a spectator, whose opening isn't counted.
struct OpenContainer {
    id: i32
    opening: Opening
    menu: Menu
    state: i32 = 0
    spectator: bool = false
    // A crafting table's result and grid, which its menu holds, as no block entity does (CAL-147),
    // or a merchant's payments and what its trade gives; and a merchant's menu's trade picked,
    // `selectionHint`, and the offer its payments buy, `activeOffer` (CAL-160).
    held: List<Tag?> = List<Tag?>()
    hint: i32 = 0
    active: i32 = -1
    // A beacon's menu's data slots as the client last had them, `remoteDataSlots` (D521).
    data: List<i32> = List<i32>()
}

struct Player {
    entity_id: i32 = 0
    x: f64 = 0.0
    y: f64 = 0.0
    z: f64 = 0.0
    y_rot: f32 = 0.0
    x_rot: f32 = 0.0
    // The ticks the listener has run, as its `tickCount`, which go on as they respawn.
    tick_count: i32 = 0
    // The player's own ticks, `Entity.tickCount`, counted up as their level's entities tick,
    // `commonTick`, from 0 for each player made, a respawn's too, which peaceful's healing, their
    // hurts' record, their level-ups' sound and their steps' chime read (D433).
    own_ticks: i32 = 0
    // Their advancements, `PlayerAdvancements`, which a respawn keeps, as the player list keeps
    // them by player (CAL-164).
    advancements: PlayerAdvancements = PlayerAdvancements()
    // Their recipe book, `ServerRecipeBook`, which a respawn keeps, `restoreFrom` (CAL-164).
    recipe_book: RecipeBook = RecipeBook()
    // Their statistics, `ServerStatsCounter`, which a respawn keeps, as the player list keeps them
    // by player (CAL-164).
    stats: PlayerStats = PlayerStats()
    // What `doTick` last set their scores of `health`, `food`, `air`, `armor`, `xp` and `level`
    // to, `lastRecorded...`, none until it first does, as for each player made (CAL-164).
    recorded_health: f32? = none
    recorded_food: i32? = none
    recorded_air: i32? = none
    recorded_armor: i32? = none
    recorded_xp: i32? = none
    recorded_level: i32? = none
    // Where they were and their tick as levitation began on them, `levitationStartPos` and
    // `levitationStartTime`, till it's taken off, which `LEVITATION` reads (CAL-164).
    levitation_start: (f64, f64, f64)? = none
    levitation_time: i32 = 0
    // Their fire, `remainingFireTicks`, as they're saved with it, `Fire`, below nought the ticks
    // fire waits to light them; and where they were as their level ticked them, `oldPosition`,
    // from which a tick they don't move is their blocks' move (D434).
    fire: i32 = 0
    old_x: f64 = 0.0
    old_y: f64 = 0.0
    old_z: f64 = 0.0
    // The last teleport's ID, whether the client has yet to accept it, and the tick it was
    // sent, as vanilla's `awaitingTeleport`, `awaitingPositionFromClient` and
    // `awaitingTeleportTime`; and where it sent them, which their own tick may take them back
    // from before the client accepts it (D574).
    teleport_id: i32 = 0
    awaiting: bool = false
    awaiting_time: i32 = 0
    awaiting_x: f64 = 0.0
    awaiting_y: f64 = 0.0
    awaiting_z: f64 = 0.0
    // Whether a move with a position came since the client's last tick ended, and any move,
    // `receivedMovementThisTick`; and what the last of them came to, `lastKnownClientMovement`,
    // nothing once a client's tick ends without one (D417).
    position_this_tick: bool = false
    moved_this_tick: bool = false
    known_x: f64 = 0.0
    known_y: f64 = 0.0
    known_z: f64 = 0.0
    // The chunk the player's view is around, and how many chunks it reaches.
    center_x: i32 = 0
    center_z: i32 = 0
    view: i32 = 0
    // The section the player's tickets were last put in, `lastSectionPos`.
    section_x: i32 = 0
    section_y: i32 = 0
    section_z: i32 = 0
    sender: ChunkSender = ChunkSender()
    // The view distance the client last asked for that was logged, for `force-view-distance`.
    asked: i32 = -1
    // The signed messages the player was sent that their messages say they've seen, the place
    // of the next message they're sent among all those they were, and how fast they've sent
    // messages and commands lately.
    last_seen: LastSeenValidator = LastSeenValidator()
    next_chat_index: i32 = 0
    chat_spam: Throttler = Throttler()
    command_spam: Throttler = Throttler()
    // The request for suggestions waiting, by its ID, and whether the budget of one a tick is
    // left, as `ServerCommandSuggestionsProvider` keeps them (CAL-165).
    suggest_request: (i32, String)? = none
    suggest_budget: bool = false
    // The player's chat session, once the services' signature of its key is checked, and where
    // their signed messages are in its chain, as the listener's `chatSession` and
    // `signedMessageDecoder`; without a session their messages are unsigned. Then the
    // signatures their client keeps of the messages it was sent, as `messageSignatureCache`.
    session: ChatSession? = none
    chain: Chain = Chain()
    signatures: SignatureCache = SignatureCache()
    // Their data as it was read as they joined, which their saves keep what Calcite doesn't know
    // of in, or `none` for a player new to the world.
    data: JavaHashMap<String, Tag>? = none
    // Their game mode and the one before it, as `ServerPlayerGameMode` keeps them, and what they
    // may do, as their `Abilities` (D239).
    mode: GameType = GameType.Survival
    previous_mode: GameType? = none
    abilities: Abilities = Abilities()
    // Their permission level, from ops.json as they joined, and when they joined, which orders
    // the players as vanilla's player list does.
    level: i32 = 0
    joined: u64 = 0
    // The dimension they're in, by its place in the world's (CAL-69), and when they came into
    // its level, which orders its players as `ServerLevel.players()` has them (D314).
    dim: usize = 0
    entered: u64 = 0
    // The hotbar slot they hold, and the inventory menu's state, which goes up each time its
    // slots are sent, as `AbstractContainerMenu.incrementStateId` counts it.
    selected: i32 = 0
    menu_state: i32 = 0
    // What's in their inventory and on them (D372), and their inventory menu's cursor and what
    // the server knows of their client's slots (D374).
    inventory: Inventory = Inventory()
    menu: Menu = Menu()
    // The container's menu they have open, `containerMenu` where it isn't the inventory menu,
    // and the last container ID given, `containerCounter`; and what they keep in ender chests
    // (CAL-144).
    container: OpenContainer? = none
    container_counter: i32 = 0
    ender: EnderChest = EnderChest()
    // Their attributes, what they wore and held as it last looked, `lastEquipmentItems`, and
    // whether their data was saved before 26.3, whose `attributes` are written back as they
    // were (D375).
    attributes: Attributes = Attributes()
    worn: List<Tag?> = List<Tag?>()
    old_attributes: bool = false
    // Whether they're on the ground, as the last move let through said, `onGround`, and whether
    // their eyes were in water as their fluids were last looked at, `isEyeInFluid`, which a move
    // out of water looks at again (D444); the block they dig, as their game mode keeps it; and the
    // last of their block changes to ack, `ackBlockChangesUpTo`, -1 for none (D376).
    on_ground: bool = false
    eye_in_water: bool = false
    digging: Digging = Digging()
    ack: i32 = -1
    // Whether they hold shift, as their last input said, `isShiftKeyDown` (CAL-139).
    shift: bool = false
    // Their synced entity data, and their food and experience, with what was last sent of them
    // (CAL-141).
    entity_data: EntityData = EntityData()
    status: Status = Status()
    // Their effects (D514), as `LivingEntity` keeps them.
    effects: PlayerEffects = PlayerEffects()
    // Their entity's random, seeded as they joined, which the motion of what they drop draws
    // from (CAL-148).
    random: LegacyRandom? = none
    // The ticks till they may take another orb, `takeXpDelay`, and the tick they last levelled up
    // to a fifth level with its sound, `lastLevelUpTime` (CAL-154).
    take_xp_delay: i32 = 0
    last_level_up: i32 = 0
    // The ticks till an arrow in them goes, `removeArrowTime` (CAL-159).
    remove_arrow_time: i32 = 0
    // What they use, `useItem`, and the ticks of its use left, `useItemRemaining` (D519); whether
    // they use it, and with which hand, are their living flags', in their entity data.
    use_item: Tag? = none
    use_remaining: i32 = 0
    // How long since they last attacked or changed what's in their main hand,
    // `attackStrengthTicker`, and what was there as it last looked, `lastItemInMainHand` (D416).
    attack_ticker: i32 = 0
    last_main_hand: Tag? = none
    // Their item cooldowns, `ItemCooldowns` (D579), which a respawn's new player doesn't keep.
    cooldowns: ItemCooldowns = ItemCooldowns()
    // Which player they are, as vanilla's `ServerPlayer` objects are each their own, the next
    // of the server's as they join and as they respawn anew: the ender pearls among theirs,
    // `enderPearls`, are those of it, `registered` (D580).
    serial: i64 = 0
    // Their movement speed as their last tick had it, `getSpeed` (D417).
    speed: f32 = 0.0
    // How far they've fallen, `fallDistance`, whether they were in water as they were last looked
    // at, `wasTouchingWater`, how deep in water and lava they were then (D419), and whether their
    // first tick's gone, `firstTick` (D418); the block they stand on, `mainSupportingBlockPos`,
    // and whether they stood on none as they last landed, `onGroundNoBlocks`; their motion as the
    // server has it, `getDeltaMovement`, and whether their tracker's to send it them,
    // `syncVelocity`; whether their last move went into something across, `horizontalCollision`,
    // as their client said, and up or down, and down, as the server found it moving them,
    // `verticalCollision` and `verticalCollisionBelow`, and their body as the server moves them,
    // made as it first does (D419); how long till a hurt counts whole again,
    // `damageCooldownTime`, and the last hurt's damage, `lastHurt`; the ticks till their client's
    // taken to have loaded, `clientLoadedTimeoutTimer`, none once it says it has; and the tick
    // the blocks under them were last sent them again, `lastSupportedBlocksSend` (D419).
    fall: f64 = 0.0
    in_water: bool = false
    water: f64 = 0.0
    lava: f64 = 0.0
    based: bool = false
    support: (i32, i32, i32)? = none
    no_blocks: bool = false
    vx: f64 = 0.0
    vy: f64 = 0.0
    vz: f64 = 0.0
    sync_velocity: bool = false
    horizontal_collision: bool = false
    vertical_collision: bool = false
    vertical_below: bool = false
    body: Living? = none
    damage_cooldown: i32 = 0
    last_hurt: f32 = 0.0
    load_timer: i32 = 60
    support_sent: i32 = 0
    // The impulse they were last given, as a mace's smash gives one (D443): the ticks left of its
    // grace, `currentImpulseContextResetGraceTime`, and where it was given,
    // `currentImpulseImpactPos`, below which a fall hurts them only from there; and whether their
    // next landing throws up a smash's dust, `spawnExtraParticlesOnFall`.
    impulse_grace: i32 = 0
    impulse_at: (f64, f64, f64)? = none
    extra_fall_particles: bool = false
    // What's hurt them lately, `CombatTracker`, and where they were last on what's climbable since
    // they were on the ground, `lastClimbablePos`; dead, the ticks since, `deathTime`, whether
    // they're out of their level, as they are 20 ticks after, and whether their client's waiting
    // to respawn, `waitingForRespawn`; and where they last died, `lastDeathLocation`, its
    // dimension and block, which their spawn info tells their client (D427). The living entity
    // that hurt them last, by its ID, and their tick then, `lastHurtByMob` and
    // `lastHurtByMobTimestamp`, with its name as it was, which a death message gives it credit by
    // (D442).
    combat: CombatTracker = CombatTracker()
    hurt_by_mob: (i32, i32)? = none
    hurt_by_mob_name: Component? = none
    // Their tick when a mob last hurt them, or when they forgot it, `lastHurtByMobTimestamp`
    // as `setLastHurtByMob` sets it, even to none, which an ender dragon's wing reads (D615).
    hurt_by_mob_stamp: i32 = 0
    // The player who hurt them last, by their UUID, and the ticks that's remembered for,
    // `lastHurtByPlayer` and `lastHurtByPlayerMemoryTime`, who has the credit for their death
    // before any mob, `getKillCredit` (CAL-164).
    hurt_by_player: (i64, i64)? = none
    hurt_by_player_memory: i32 = 0
    last_climbable: (i32, i32, i32)? = none
    death_time: i32 = 0
    removed: bool = false
    waiting_for_respawn: bool = false
    last_death: GlobalPos? = none
    // Whether they've asked to respawn and the server's waiting on where, which holds its tick
    // (D428).
    respawning: bool = false
    // What their death took from their main hand, and the item it was dropped as, where it was,
    // which the attack whose aftermath killed them wears after, as vanilla's `postHurtEnemy`
    // wears the stack `Player.attack` took, the drop's by then (D450).
    hand_taken: Tag? = none
    hand_drop: i32? = none
    // Where the player was as their tick began, `firstGoodX`, and where the server last took
    // them, `lastGoodX`; how many moves they've sent, `receivedMovePacketCount`, and had sent as
    // their last tick ended, `knownMovePacketCount`; and whether their client has them floating,
    // `clientIsFloating`, and for how many ticks, `aboveGroundTickCount` (D420); none kept of
    // where they are till it first is.
    first_good: (f64, f64, f64)? = none
    last_good: (f64, f64, f64)? = none
    move_packets: i32 = 0
    known_packets: i32 = 0
    floating: bool = false
    floating_ticks: i32 = 0
    // Their head's yaw, `yHeadRot`, their yaw as their tick last left it, a teleport or their
    // data; and whether their tracker's to send their motion and place on its next run,
    // `needsSync`, as their data being read, a knockback and a jump have it (CAL-174).
    y_head_rot: f32 = 0.0
    needs_sync: bool = false
    // The block they were in as their tick last looked, `lastPos`, none till it first does; and
    // the location-changed effects of their enchantments that hold,
    // `activeLocationDependentEnchantments`, in the order they came to (D524).
    last_pos: (i32, i32, i32)? = none
    located: List<ActiveLocated> = List<ActiveLocated>()
    // The bed they sleep in, by its head, `getSleepingPos`, which their data says too; and their
    // sleep's ticks, `sleepCounter`, to 100 asleep, then on to 110 once they're up, saved as
    // `SleepTimer`; and where they respawn, `respawnConfig`, as a bed sets it (D574).
    sleeping: (i32, i32, i32)? = none
    sleep_counter: i32 = 0
    respawn: RespawnConfig? = none
    // Their portal's cooldown, `portalCooldown`, saved as `PortalCooldown`; the nether portal
    // they're in, `portalProcess`; whether they're on their way to another dimension,
    // `isChangingDimension`, till their client accepts a teleport; and where they went into the
    // Nether from the Overworld, `enteredNetherPosition`, saved as `entered_nether_pos`. Then the
    // chunks a portal's search found there as it began, `hasChunk`, in the dimension at its
    // index, till the tick's portal's handled; and the path their tracker kept as they left a
    // level, their interpolation tracker's, which their tracker in the next takes up (D577).
    portal_cooldown: i32 = 0
    portal: PortalProcess? = none
    changing_dimension: bool = false
    entered_nether: (f64, f64, f64)? = none
    portal_known: (usize, Set<i64>)? = none
    carried_path: (List<PathStep>, i32)? = none
    // Whether they've won the game, `wonGame`, taken out of the End through its portal and shown
    // the credits, till they ask to respawn; and whether they've seen them, `seenCredits`, saved
    // so, as they aren't shown them again (D586).
    won_game: bool = false
    seen_credits: bool = false
}

// What a nether portal's way reads of what it takes, a player or an entity (D578): the dimension
// it's in, where it is, how big, how far it had fallen, whether it holds shift, `isDescending`,
// whether it's a spectator, and the block it went into the portal at, `entryPosition`; and
// whether it's an end portal's way (D587).
struct Traveller {
    from: usize
    x: f64
    y: f64
    z: f64
    width: f32
    height: f32
    fall: f64
    descending: bool
    spectator: bool
    entry: (i32, i32, i32)
    end: bool
    gateway: bool = false
}

// Where a portal takes a player (D577): the dimension, the place and the turn it adds to theirs;
// and the portal it found there, whose chunk its ticket's put at, none for one it made, whose
// ticket's put where they come out. The pitch an end portal adds, and whether its yaw is theirs
// whatever theirs was, `Relative` without `Y_ROT` (D587).
struct PortalExit {
    to: usize
    x: f64
    y: f64
    z: f64
    y_rot: f32
    found: (i32, i32, i32)?
    x_rot: f32 = 0.0f32
    absolute: bool = false
}

// The chunks about where a nether portal aims that were kept as the entity `id` of the level at
// `d` began its way through it, as `portal_ready_for` finds them for `createPortal` (D578).
struct PortalKnown {
    d: usize
    id: i32
    known: (usize, Set<i64>)
}

// An entity chunk of the level at `d` read at `pos` while the tick held for a nether portal's
// way, with what its read logged, `io`, and what it got, to be made into its entities once the
// tick's done (D579).
struct HeldRead {
    d: usize
    pos: ChunkPos
    io: List<Entry>
    got: ChunkRead
}

// Where a player respawns, `ServerPlayer.RespawnConfig` (D574): the place, `RespawnData`, and
// whether it's forced.
struct RespawnConfig {
    spawn: Spawn
    forced: bool = false
}

impl RespawnConfig {
    // `isSamePosition`: the same dimension and block.
    fn same_place(self, other: RespawnConfig?) -> bool {
        let o = other else return false
        return o.spawn.dimension.namespace == self.spawn.dimension.namespace and o.spawn.dimension.path == self.spawn.dimension.path and o.spawn.pos.x == self.spawn.pos.x and o.spawn.pos.y == self.spawn.pos.y and o.spawn.pos.z == self.spawn.pos.z
    }

    // `RespawnConfig.CODEC`'s: `RespawnData`'s dimension, block, yaw and pitch, and `forced` where
    // it is, as `optionalFieldOf` leaves out its default.
    fn tag(self) -> Tag {
        var m = JavaHashMap<String, Tag>()
        m.insert(String("dimension"), Tag.Str(self.spawn.dimension.to_string()))
        m.insert(String("pos"), Tag.IntArray([self.spawn.pos.x, self.spawn.pos.y, self.spawn.pos.z]))
        m.insert(String("yaw"), Tag.float(self.spawn.yaw))
        m.insert(String("pitch"), Tag.float(self.spawn.pitch))
        if self.forced {
            m.insert(String("forced"), Tag.Byte(1i8))
        }
        return Tag.Compound(m)
    }

    // What `respawn` holds, as the codec reads it, none where it doesn't read: a dimension, a
    // block of three, a yaw from -180 to 180 and a pitch from -90 to 90.
    fn read(tag: Tag) -> RespawnConfig? {
        let Tag.Compound(m) = tag else return none
        if not m.contains("dimension") or not m.contains("pos") or not m.contains("yaw") or not m.contains("pitch") {
            return none
        }
        let Tag.Str(name) = m["dimension"] else return none
        let dimension = match Identifier.parse(name.copy()) {
            ok(i) => i,
            err(_) => return none,
        }
        let Tag.IntArray(p) = m["pos"] else return none
        if p.len() != 3 {
            return none
        }
        let yaw = match m["yaw"] {
            Tag.Float(v) => v,
            _ => return none,
        }
        let pitch = match m["pitch"] {
            Tag.Float(v) => v,
            _ => return none,
        }
        if not (yaw >= -180.0f32 and yaw <= 180.0f32) or not (pitch >= -90.0f32 and pitch <= 90.0f32) {
            return none
        }
        let forced = m.contains("forced") and (m["forced"].number_bool() ?? false)
        return some(RespawnConfig { spawn: Spawn { dimension: dimension, pos: BlockPos { x: p[0], y: p[1], z: p[2] }, yaw: yaw, pitch: pitch }, forced: forced })
    }
}

// A location-changed effect of an enchantment on what a player has in the equipment slot `slot`
// that holds, `entry` (D524).
struct ActiveLocated {
    slot: usize
    entry: LocatedEntry
}

// A level's item entities and its entities' trackers (CAL-148): the items, as `world.entities`
// keeps them; each entity's tracker in `ChunkMap.entityMap`'s order, by its ID, `true` for a
// player's; and each entity's tracker, a player's too (CAL-174).
//
// And its entity chunks, as `PersistentEntitySectionManager` keeps them: the chunks that are
// accessible, `chunkVisibility` other than hidden; those whose entities were read, `true`, or are
// asked for, `false`, `chunkLoadStatuses`, a chunk that's in neither being fresh; those to unload
// once they can be saved, `chunksToUnload`; those known to have no entities,
// `EntityStorage.emptyChunks`; what was read of each, waiting for the level's tick to come in,
// `loadingInbox`; the entities read that Calcite doesn't have yet, by the IDs below 0 their places
// in the items' sections have, saved again as they were read, and the last of those IDs; the
// thread that reads and writes them; and whether the server's stopping, and the thread's been
// told to close. And its locator bar's waypoints (CAL-174).
struct LevelEntities {
    list: Entities = Entities()
    tracked: OpenHashMap<i32, bool> = OpenHashMap<i32, bool>()
    trackers: Map<i32, Tracker> = Map<i32, Tracker>()
    visible: OpenHashSet<i64> = OpenHashSet<i64>()
    loads: OpenHashMap<i64, bool> = OpenHashMap<i64, bool>()
    to_unload: OpenHashSet<i64> = OpenHashSet<i64>()
    empty: OpenHashSet<i64> = OpenHashSet<i64>()
    inbox: List<ReadEntities> = List<ReadEntities>()
    kept: Map<i32, Tag> = Map<i32, Tag>()
    // Of the kept, those natural spawning counts (CAL-156): their types' IDs and their places
    // across.
    kept_mobs: Map<i32, (i32, f64, f64)> = Map<i32, (i32, f64, f64)>()
    last_kept: i32 = 0
    // The mobs each chunk spawned as it generated, saved as `ProtoChunk.addEntity` saves them,
    // till it comes to be full and they're loaded again (CAL-161).
    generated: OpenHashMap<i64, List<Tag>> = OpenHashMap<i64, List<Tag>>()
    jobs: EntityJobs? = none
    stopping: bool = false
    saved_all: bool = false
    closed: bool = false
    waypoints: Waypoints = Waypoints()
}

// A particle's options as its type writes them: a block state's ID, or nothing for a type
// without (CAL-155).
fn particle_option(state: i32) -> List<u8> {
    if state < 0 {
        return List<u8>()
    }
    var w = Writer.new()
    w.varint(state)
    return w.into_bytes()
}

// What the player has in the equipment slot `slot`, `getItemBySlot`: the main hand the hotbar
// slot they hold.
fn worn_in(con: Connection, slot: usize) -> Tag? {
    if slot == 0 {
        return con.player.inventory.selected(con.player.selected)
    }
    if slot >= con.player.inventory.equipment.len() {
        return none
    }
    return con.player.inventory.equipment[slot].copy()
}

// What the player wears and holds by slot, in `slot_names`' order, as `getItemBySlot` gives it
// (D439).
fn worn_by(con: Connection) -> List<Tag?> {
    var out = List<Tag?>()
    for slot in 0usize..8usize {
        out.push(worn_in(con, slot))
    }
    return out
}

// Where the location-changed effect `wanted` in the slot `slot` is among those active on the
// player, `activeLocationDependentEnchantments`' (D524), none where it isn't.
fn located_at(con: Connection, slot: usize, wanted: LocatedEntry) -> usize? {
    for i in 0..con.player.located.len() {
        if con.player.located[i].slot == slot and con.player.located[i].entry.enchantment == wanted.enchantment and con.player.located[i].entry.index == wanted.index {
            return some(i)
        }
    }
    return none
}

// An attribute's modifier of a location-changed effect put on the player as the effect begins to
// hold, `addTransientModifier` (D524): its ID for the slot, its amount and its operation, by name.
fn put_located(con: mut Connection, id: String, name: String, amount: f64, operation: String) {
    let a = attribute_id(name.copy()) else return
    let modifier = match Identifier.parse(id.copy()) {
        ok(i) => i,
        err(_) => return,
    }
    let names = operation_names()
    var op = 0
    for i in 0..names.len() {
        if names[i] == operation {
            op = i32.wrap(i)
        }
    }
    con.player.attributes.replace(a, Modifier { id: modifier, amount: amount, operation: op })
}

// What the location-changed effect `gone` undoes as it stops holding for the player,
// `onDeactivated` (D524): its attributes' modifiers taken off.
fn located_off(con: mut Connection, gone: LocatedEntry) {
    for what in gone.what {
        if let Located.Attribute(id, name, _, _) = what {
            let a = attribute_id(name.copy()) else continue
            match Identifier.parse(id.copy()) {
                ok(i) => con.player.attributes.take_off(a, i),
                err(_) => {},
            }
        }
    }
}

// `PositionSource.getCoordinate` of a particle effect's position `source` (D525): `position`,
// or with `in_bounding_box` `center` and a double from `random` across `span` scaled, then its
// offset.
fn particle_coordinate<R: RandomSource>(source: Tag?, position: f64, center: f64, span: f32, random: mut R) -> f64 {
    let Tag.Compound(m) = source.copy() ?? Tag.End else return position
    let scale = if m.contains("scale") { m["scale"].number_float() ?? 1.0f32 } else { 1.0f32 }
    let offset = if m.contains("offset") { m["offset"].number_float() ?? 0.0f32 } else { 0.0f32 }
    let kind = match m["type"] {
        Tag.Str(k) => k.copy(),
        _ => String(),
    }
    let at = if kind == "in_bounding_box" { center + (random.next_double() - 0.5) * f64(span * scale) } else { position }
    return at + f64(offset)
}

// `VelocitySource.getVelocity` of a particle effect's velocity `source` for the movement
// `movement` (D525): scaled by its `movement_scale`, and its `base` drawn from `random`.
fn particle_velocity<R: RandomSource>(source: Tag?, movement: f64, random: mut R) -> f64 {
    let Tag.Compound(m) = source.copy() ?? Tag.End else return 0.0
    let scale = if m.contains("movement_scale") { m["movement_scale"].number_float() ?? 0.0f32 } else { 0.0f32 }
    let base = if m.contains("base") { float_sample(mut random, m["base"].copy()) } else { 0.0f32 }
    return movement * f64(scale) + f64(base)
}

// The text `key` of `m`, empty where it isn't text (D525).
fn text_of_tag(m: JavaHashMap<String, Tag>, key: str) -> String {
    if not m.contains(key) {
        return String()
    }
    return match m[key] {
        Tag.Str(v) => v.copy(),
        _ => String(),
    }
}

// Puts `stack` in the equipment slot `slot`, `setItemSlot`.
fn set_worn(con: mut Connection, slot: usize, stack: own Tag) {
    if slot == 0 {
        let held = usize.wrap(con.player.selected)
        if held < con.player.inventory.items.len() {
            con.player.inventory.items[held] = some(stack)
        }
        return
    }
    if slot < con.player.inventory.equipment.len() {
        con.player.inventory.equipment[slot] = some(stack)
    }
}

// `getXpNeededForNextLevel`: what the level after `level` needs, the sums an int's.
fn xp_needed(level: i32) -> i32 {
    if level >= 30 {
        return 112i32.wrapping_add((level - 30).wrapping_mul(9))
    }
    if level >= 15 {
        return 37i32.wrapping_add((level - 15).wrapping_mul(5))
    }
    return 7i32.wrapping_add(level.wrapping_mul(2))
}

// Where a kept entity was saved, its `Pos`, as `Entity.load` reads it, or the origin, which places
// it in its section as `addEntity` does.
fn kept_place(tag: Tag) -> (f64, f64, f64) {
    let Tag.Compound(m) = tag else return (0.0, 0.0, 0.0)
    if not m.contains("Pos") {
        return (0.0, 0.0, 0.0)
    }
    let Tag.List(pos) = m["Pos"] else return (0.0, 0.0, 0.0)
    if pos.len() != 3 {
        return (0.0, 0.0, 0.0)
    }
    let x = pos[0].number_double() ?? 0.0
    let y = pos[1].number_double() ?? 0.0
    let z = pos[2].number_double() ?? 0.0
    return (x, y, z)
}

// What was read of an entity chunk, as `loadEntities` makes it: its entities in the order they
// were saved, the items, orbs and armor stands made and the rest's tags, which Calcite keeps as
// they were.
struct ReadEntities {
    pos: ChunkPos
    entities: List<ReadEntity>
}

enum ReadEntity {
    Item(ItemEntity)
    Orb(ExperienceOrb)
    Stand(ArmorStand)
    Mob(Mob)
    Arrow(Arrow)
    Thrown(ThrownItem)
    Cloud(EffectCloud)
    Crystal(EndCrystal)
    Eye(EyeOfEnder)
    Fireball(DragonFireball)
    Kept(Tag)
}

// What owns an arrow as its hit reads it, `getOwner` (CAL-159): its entity ID; where it's a
// player, their UUID, slot, whether they're in creative and may build; whether it's a mob, living
// and not a player; its name as a death message shows it, and the name of what's in its main
// hand, where that has one of its own; and it to loot, as what it hits reads it.
struct Shooter {
    id: i32
    player: (i64, i64)? = none
    slot: usize? = none
    creative: bool = false
    may_build: bool = true
    mob: bool = false
    name: Component? = none
    weapon: Component? = none
    loot: LootEntity? = none
}

// Natural spawning's maker of mobs in a level (CAL-156): the server's next IDs and seeds while a
// chunk spawns; the living and farm animals' facts, lent for the chunk; the types it makes, each
// with its kind; the boxes of what blocks building in the level as its spawning began, and of
// each mob made since; the mobs made in the chunk, for the server to add after it; and the riders
// made as a mob's finalized, added after it.
struct MobMaking {
    lf: LivingFacts? = none
    facts: MobFacts? = none
    kinds: List<(i32, i32)>
    ids: i32 = 0
    base: i64? = none
    seeds: i64 = 0
    now: u64 = 0
    blocking: List<Aabb>
    made: List<Mob> = List<Mob>()
    riders: List<Mob> = List<Mob>()
    // The world's loot, which spawn equipment is enchanted from (D522).
    loot: Shared<Loot>? = none
}

impl MobMaker for MobMaking {
    fn make(mut self, type_id: i32, x: f64, y: f64, z: f64) -> Mob? {
        var species: i32? = none
        for (t, s) in self.kinds {
            if t == type_id {
                species = some(s)
            }
        }
        let kind = species else return none
        let living = match self.lf {
            some(_) => true,
            none => false,
        }
        let farm = match self.facts {
            some(_) => true,
            none => false,
        }
        if not living or not farm {
            return none
        }
        self.ids += 1
        let id = self.ids
        let (seed, seeds) = seeded(self.base, self.seeds, self.now, id)
        self.seeds = seeds
        let lf = self.lf else return none
        let facts = self.facts else return none
        return some(Mob.made(lf, facts, kind, u32.wrap(type_id), id, seed, x, y, z))
    }

    fn spawning_in(self, mob: mut Mob, biome: i32) {
        if let facts = self.facts {
            mob.spawning_in(facts, biome)
        }
    }

    fn unobstructed(self, b: Aabb) -> bool {
        for o in self.blocking {
            if o.intersects(b.min_x, b.min_y, b.min_z, b.max_x, b.max_y, b.max_z) {
                return false
            }
        }
        return true
    }

    fn add(mut self, mob: own Mob) {
        self.blocking.push(mob.living.body.bounding_box())
        self.made.push(mob)
        let riders = self.riders.copy()
        self.riders.clear()
        for r in riders {
            self.blocking.push(r.living.body.bounding_box())
            self.made.push(r.copy())
        }
    }
}

impl Making for MobMaking {
    fn make_kind(mut self, species: i32, x: f64, y: f64, z: f64, biome: i32) -> Mob? {
        var type_id: i32? = none
        for (t, s) in self.kinds {
            if s == species {
                type_id = some(t)
            }
        }
        let id = type_id else return none
        var mob = self.make(id, x, y, z) else return none
        self.spawning_in(mut mob, biome)
        return some(mob)
    }

    fn add_made(mut self, mob: own Mob) {
        self.blocking.push(mob.living.body.bounding_box())
        self.made.push(mob)
    }

    fn add_passenger(mut self, mob: own Mob) {
        self.riders.push(mob)
    }

    fn add_effect(mut self, mob: mut Mob, e: ActiveEffect) {
        if let lf = self.lf {
            var unheard = List<EntitySound>()
            _ = mob.add_effect(lf, e, mut unheard)
        }
    }

    fn world_loot(self) -> Shared<Loot>? {
        return self.loot.copy()
    }
}

// How far, in sectors, a search for the nearest structure spread at random looks, as an eye of
// ender's does, `MAX_STRUCTURE_SEARCH_RADIUS` (D599).
const STRUCTURE_SEARCH_RADIUS: i32 = 100

// How long `locate structure` waits for its search before it lets the tick go on and answers
// when it's done (D600), in nanoseconds: most are done by then, and answered at once, as
// vanilla's are.
const LOCATE_WAIT_NANOS: u64 = 25000000

// What a `locate structure` is for (D600): the tag `key`, where `tag`, or the structure.
fn sought_of(key: Identifier, tag: bool) -> Sought {
    if tag {
        return Sought.Tag(key.to_string())
    }
    return Sought.One(key.to_string())
}

// The seed of a new entity `id`'s random, and the server's own next (CAL-148): with
// `level-random-seed`, `base`, its ID mixed with it, as the rig's agent seeds vanilla's;
// otherwise the next of the server's own, `seeds`, started from `now` the first time.
fn seeded(base: i64?, seeds: i64, now: u64, id: i32) -> (i64, i64) {
    if let b = base {
        return (mix_stafford13(b ^ i64(id)), seeds)
    }
    var next = seeds
    if next == 0 {
        next = i64.wrap(now) + 1
    }
    next += -7046029254386353131
    return (mix_stafford13(next), next)
}

// A string as a translation's argument (CAL-165).
fn named_text(text: own String) -> Argument {
    return Argument.Text(Component.literal(text))
}

// How `drop_from` leaves an item a player drops: as it's made, for them alone at once, or fake.
const DROP_ANY: i32 = 0
const DROP_THEIRS: i32 = 1
const DROP_FAKE: i32 = 2

// `ItemInput.createItemStack(1)` of `input`, with the items' codecs `items` (CAL-165): one of its
// item with its patch applied to the item's components, as `ItemStack.CODEC` writes it, or why
// it isn't one, `validateStrict`: damageable and stackable both, or a stack it holds of more than
// that stack's most. A bundle's weight isn't checked yet. Air's is an empty stack, none, whatever
// its patch, which `validateStrict` passes, as an empty stack has no components (D604).
fn made_stack(items: ItemCodecs, input: ItemInput) -> Tag? ! String {
    if input.item == "minecraft:air" {
        return none
    }
    var patch = JavaHashMap<String, Tag>()
    for (name, value) in input.patch {
        patch.insert(name.copy(), value.copy())
    }
    var fields = JavaHashMap<String, Tag>()
    fields.insert(String("id"), Tag.Str(input.item.copy()))
    fields.insert(String("count"), Tag.Int(1))
    fields.insert(String("components"), Tag.Compound(patch))
    let stack = items.stack(Tag.Compound(fields), false) else fail "Calcite can't make {input.item} with those components"
    if items.component(stack.copy(), String("minecraft:max_damage")) != none and items.max_stack_size(stack.copy()) > 1 {
        fail String("Item cannot be both damageable and stackable")
    }
    for held in held_stacks(items, stack.copy()) {
        let n = count_of(held.copy())
        let most = items.max_stack_size(held)
        if n > most {
            fail "Item stack with count of {n} was larger than maximum: {most}"
        }
    }
    return some(stack)
}

// The stack an item argument of air stands for in what a command says of it (D604): air's ID,
// one of it, which `shown_stack` shows as an empty stack.
fn air_stack() -> Tag {
    var m = JavaHashMap<String, Tag>()
    m.insert(String("id"), Tag.Str(String("minecraft:air")))
    m.insert(String("count"), Tag.Int(1))
    return Tag.Compound(m)
}

// Whether `stack` is air's, an empty stack, `isEmpty` (D604).
fn is_air(stack: Tag) -> bool {
    let Tag.Compound(m) = stack else return false
    return (text_field(m, "id") ?? String()) == "minecraft:air"
}

// The stacks the stack `stack` holds, `validateComponents` checks: its container's, its bundle's
// and its charged projectiles, as their codecs write them.
fn held_stacks(items: ItemCodecs, stack: Tag) -> List<Tag> {
    var out = List<Tag>()
    if let Tag.List(slots) = items.component(stack.copy(), String("minecraft:container")) {
        for s in slots {
            if let Tag.Compound(m) = s {
                if m.contains("item") {
                    out.push(m["item"].copy())
                }
            }
        }
    }
    for name in ["minecraft:bundle_contents", "minecraft:charged_projectiles"] {
        if let Tag.List(each) = items.component(stack.copy(), String(name)) {
            for s in each {
                out.push(s.copy())
            }
        }
    }
    return out
}

// `ItemStack.getDisplayName` of `stack`, as `ItemStack.CODEC` writes it, with the items' codecs
// `items` (CAL-165): its name, `getHoverName`, its custom name, in italics, else a written book's
// title, else its item's name, `getName`; in its rarity's color, raised where it's enchanted.
fn shown_stack(items: ItemCodecs, stack: Tag) -> Component {
    // An empty stack's, air's: no custom name, as it has no components, but its item's own name,
    // `AirItem.getName`, from the item's components; in brackets with no color and nothing to
    // hover over (D604).
    if is_air(stack.copy()) {
        var name = Component.empty()
        name.extra.push(item_name(items, air_stack()))
        return Component.translatable(String("chat.square_brackets"), [name])
    }
    var hover = item_name(items, stack.copy())
    var custom = false
    if let named = items.component(stack.copy(), String("minecraft:custom_name")) {
        custom = true
        match Component.from_nbt(named) {
            ok(c) => hover = c,
            err(_) => {},
        }
    } else if let title = book_title(items.component(stack.copy(), String("minecraft:written_book_content"))) {
        hover = Component.literal(title)
    }
    var rarity: String? = none
    if let Tag.Str(r) = items.component(stack.copy(), String("minecraft:rarity")) {
        rarity = some(r.copy())
    }
    var enchanted = false
    if let Tag.Compound(m) = items.component(stack.copy(), String("minecraft:enchantments")) {
        enchanted = not m.is_empty()
    }
    return stack_display_name(stack, hover, custom, rarity, enchanted)
}

// A written book's title, `title().raw()`, where it isn't blank, from its content as its codec
// writes it, its title a string or its raw and filtered forms.
fn book_title(content: Tag?) -> String? {
    let Tag.Compound(m) = content else return none
    if not m.contains("title") {
        return none
    }
    let raw = match m["title"] {
        Tag.Str(s) => s.copy(),
        Tag.Compound(t) => match text_field(t, "raw") {
            some(s) => s,
            none => return none,
        },
        _ => return none,
    }
    // `StringUtil.isBlank`: nothing but what `Character.isWhitespace` takes.
    for u in units_of(raw.copy()) {
        if not is_whitespace(u) {
            return some(raw)
        }
    }
    return none
}

// The string `key` holds in `m`, where it holds one.
fn text_field(m: JavaHashMap<String, Tag>, key: str) -> String? {
    if not m.contains(key) {
        return none
    }
    return match m[key] {
        Tag.Str(s) => some(s.copy()),
        _ => none,
    }
}

// `Item.getName(stack)`: its `item_name`, but for the items that name themselves: a potion's,
// splash or lingering potion's or tipped arrow's by its contents, the custom name they give or
// their potion's own name, `Potion.name`, which is its ID's without `long_` or `strong_`; a
// player's head by its profile's name; a compass that tracks a lodestone; and a shield by its
// base's color.
fn item_name(items: ItemCodecs, stack: Tag) -> Component {
    let Tag.Compound(m) = stack.copy() else return Component.empty()
    let item = text_field(m, "id") ?? String()
    let path = if item.starts_with("minecraft:") { item[10..].copy() } else { item.copy() }
    if path == "potion" or path == "splash_potion" or path == "lingering_potion" or path == "tipped_arrow" {
        if let contents = items.component(stack.copy(), String("minecraft:potion_contents")) {
            var suffix = String("empty")
            var potion: String? = none
            match contents {
                Tag.Str(p) => potion = some(p.copy()),
                Tag.Compound(c) => {
                    potion = text_field(c, "potion")
                    if let n = text_field(c, "custom_name") {
                        return Component.translatable("item.minecraft.{path}.effect.{n}", [])
                    }
                },
                _ => {},
            }
            if let p = potion {
                var name = match Identifier.parse(p.copy()) {
                    ok(id) => id.path.copy(),
                    err(_) => p.copy(),
                }
                if name.starts_with("long_") {
                    name = name[5..].copy()
                } else if name.starts_with("strong_") {
                    name = name[7..].copy()
                }
                suffix = name
            }
            return Component.translatable("item.minecraft.{path}.effect.{suffix}", [])
        }
    }
    if path == "player_head" {
        match items.component(stack.copy(), String("minecraft:profile")) {
            some(Tag.Str(name)) => return Component.translatable("block.minecraft.player_head.named", [Component.literal(name.copy())]),
            some(Tag.Compound(p)) => {
                if let name = text_field(p, "name") {
                    return Component.translatable("block.minecraft.player_head.named", [Component.literal(name)])
                }
            },
            _ => {},
        }
    }
    if path == "compass" and items.component(stack.copy(), String("minecraft:lodestone_tracker")) != none {
        return Component.translatable("item.minecraft.lodestone_compass", [])
    }
    if path == "shield" {
        if let Tag.Str(color) = items.component(stack.copy(), String("minecraft:base_color")) {
            return Component.translatable("item.minecraft.shield.{color}", [])
        }
    }
    if let named = items.component(stack, String("minecraft:item_name")) {
        match Component.from_nbt(named) {
            ok(c) => return c,
            err(_) => {},
        }
    }
    return Component.empty()
}

// What a teleported player's turned toward (CAL-165): a place, or the feet, or the eyes where
// it's `true`, of the player in a slot.
enum Toward {
    Place(f64, f64, f64)
    Player(usize, bool)
}

// A configuration or play packet that waits for the next tick, with the connection it came on
// (CAL-150).
struct Scheduled {
    conn: Conn
    packet: Inbound
}

enum Inbound {
    Configuration(ConfigurationIn)
    Play(PlayIn)
}

// A creative slot's stack as it's read: nothing to read it by, a component whose stream Calcite
// doesn't read yet, why it doesn't read, or the stack and whether its count is no more than its
// item stacks to.
enum CreativeStack {
    Unready
    Unread(String)
    Fault(String)
    Read(Tag?, bool)
}

// A container click's slots and cursor as they're read: nothing to read them by, why they don't
// read, or the click.
enum ClickRead {
    Unready
    Fault(String)
    Read(Click)
}

// A command, or a game mode picked with F3 and F4, from the player in a slot, which runs once
// their connection is back in its slot (D239).
enum Queued {
    /// A command, with the messages its player signed for its message arguments, by name.
    Command(usize, String, List<(String, ChatMessage)>)
    /// The player's request for suggestions waiting, answered where their budget's left
    /// (CAL-165).
    Suggest(usize)
    Mode(usize, GameType)
}

// Every command, and the entity types a selector may name (CAL-165).
struct CommandSet {
    tree: Tree
    types: Registry
}

// A message a command sends as its source's, `OutgoingChatMessage`: one the player sent, signed
// or not, with what's shown in its place where that's different, or the text as no one's,
// disguised (CAL-165).
enum Outgoing {
    Player(ChatMessage, Component?)
    Disguised(Component)
}

impl Outgoing {
    // `decoratedContent`.
    fn content(self) -> Component {
        return match self {
            Outgoing.Player(m, shown) => shown.copy() ?? Component.literal(m.body.content),
            Outgoing.Disguised(c) => c.copy(),
        }
    }

    // `verifyChatTrusted`: signed, and not expired.
    fn trusted(self, now: i64) -> bool {
        return match self {
            Outgoing.Player(m, _) => m.trusted(now),
            Outgoing.Disguised(_) => false,
        }
    }
}

// Who hears what a command says, vanilla's `CommandSource`: the console, or the player in a slot.
enum Output {
    Console
    Player(usize)
}

// A command's source, vanilla's `CommandSourceStack` (CAL-165): who hears what it says; the
// player it runs as, if any, whose name it goes by; where it runs from, as it looks, a pitch and
// a yaw, in which level, by its place among the world's; whether its anchor is the entity's eyes
// rather than its feet; its permission level; what's told what each command it runs gives, its
// result callback, by its place among the command queue's `callbacks` plus one, 0 for none
// (D566, D567); and whether what it says is kept to itself, `withSuppressedOutput`, as a
// function's commands' is (D567). `execute` changes each but the output.
struct Source {
    output: Output
    entity: usize?
    x: f64
    y: f64
    z: f64
    x_rot: f32
    y_rot: f32
    dim: usize
    eyes: bool = false
    level: i32
    callback: usize = 0
    silent: bool = false
}

// A `locate structure` search (D600): its source, the player who asked by their entity's ID,
// where one did, what it's for as written, the dimensions searched, the one being searched, the
// block it's searched about there, and where the answer comes, where it's searched off the tick;
// and whether it's `locate biome`'s, for the biomes it names, by their IDs (D601), or `locate
// poi`'s, for the types of points of interest it names, by whether each's wanted (D602).
struct Locating {
    source: Source
    by: i32?
    key: Identifier
    tag: bool
    tried: List<usize>
    dim: usize
    x: i32
    y: i32
    z: i32
    reply: Receiver<Nearest>
    biome: bool = false
    biomes: List<i32> = List<i32>()
    poi: bool = false
    pois: List<bool> = List<bool>()
}

// How many chunks out from its own `locate poi` has the points of interest of known before it
// looks, as `getInSquare` has those within `LOCATE_RANGE` (D602).
const POI_REACH_CHUNKS: i32 = 17

// Where a `store` stores, as its step found it (D566): the scores of the holders found of an
// objective, by its name; or the tag at a path of a data target, of a type, the value scaled.
enum StoreTo {
    Score(List<HolderFound>, String)
    // A boss bar, by its ID and the UUID of the one found, and whether it's its value (D606).
    Bossbar(Identifier, Uuid, bool)
    Data(Accessor, NbtPath, String, f64)
}

// A result callback, vanilla's `CommandResultCallback` (D566, D567), told whether a command ran
// and what it gave: an `execute store`'s, storing the result, or the success, where its step
// found; two in turn, by place plus one, as `chain` makes them; a function's result said to a
// source, `commands.function.result`, then another told, `decorateOutputIfNeeded`; or a sum of
// functions' results, by place, added to.
enum Callback {
    Store(bool, StoreTo)
    Chain(usize, usize)
    Signal(Source, Identifier, usize)
    Add(usize)
}

// A frame of the command queue, vanilla's `Frame` (D567): how deep it is; what's told what it
// returns, a callback by place plus one; and what returning from it throws away of what's
// queued: what's at `discard_from` or deeper, or everything for -1, the top frame's.
struct QueueFrame {
    depth: i32
    back: usize
    discard_from: i32
}

// A command as the queue runs it (D567): its steps, what it runs at its end, and the messages
// its player signed for its message arguments.
struct Plan {
    steps: List<ExecuteStep>
    end: ExecuteEnd
    signed: List<(String, ChatMessage)>
}

// What the command queue runs (D567), vanilla's entry actions, each naming a plan, a list of
// sources, a function or a sum by its place: a command for a source to run from its first step,
// `BuildContexts.TopLevel`; a function's line, `BuildContexts.Unbound`, or its lines from one on,
// `ContinuationTask`; the rest of a command's steps from one on for the sources there, with the
// one that ran it and its modifiers, `Continuation`; the end of a command run by a source,
// `ExecuteCommand`, or by the sources from one on; a function called for a source, with what's
// told what it returns and whether returning from it returns from the frame it's called in,
// `CallFunction`; a failure returned from the frame, `FallthroughTask`; and functions' results'
// sum told a callback, where there's one.
enum Action {
    Command(Source, usize)
    Line(usize, usize, Source)
    Lines(usize, usize, Source)
    Steps(Source, usize, usize, usize, u8)
    Run(Source, usize, u8)
    Runs(usize, usize, usize, u8)
    Call(usize, Source, usize, bool)
    Fallthrough
    Sum(usize, usize)
}

// An entry of the command queue, `CommandQueueEntry`: its frame, by place, and what it runs.
struct QueueEntry {
    frame: usize
    action: Action
}

// `ChainModifiers`: forked, and returning (D567).
const FORKED: u8 = 1
const RETURNING: u8 = 2

// The most commands a queue runs, the `max_command_sequence_length` rule's default, which Calcite
// doesn't read yet (D567).
const COMMAND_LIMIT: i32 = 65536

// The most entries a queue holds, `MAX_QUEUE_DEPTH` (D567).
const QUEUE_LIMIT: usize = 10000000

// `ClientboundGameEventPacket.CHANGE_GAME_MODE`.
const CHANGE_GAME_MODE: u8 = 3

// Vanilla's flying speed, which `calcite flyspeed` multiplies.
const FLYING_SPEED: f32 = 0.05f32

// A login's check with the session server. It goes on if the player leaves, as vanilla's
// authenticator thread does, and logs what it comes to either way.
struct Check {
    conn: Conn
    // The thread vanilla runs it on, `User Authenticator #1` and up.
    thread: String
    // The player as the log names them, and the name they gave.
    user: String
    name: String
    join: JoinCheck
}

/// Every connection the server accepted, on a `Net` that may hold other connections too, such
/// as a test's client, through a link that may record what comes in or replay it.
pub struct Network {
    link: Link
    connections: List<Connection?>
    status: StatusInfo
    settings: LoginSettings
    lang: Language
    services: Services
    // The status response's JSON, and when it's next rebuilt, on the caller's clock.
    status_json: String
    status_due: u64
    // The server's key pair and its public key as the client is sent it, once the first online
    // login needs them, from the queue they come on from the thread making them.
    key: RsaKey?
    public_key: List<u8>
    coming: Receiver<RsaKey>
    checks: List<Check>
    // How many authenticators have started, which numbers their threads.
    authenticators: i32
    // The session ID every login is given, made when the first needs it and dropped once there
    // are no connections, as vanilla's `ServerConnectionListener.getSessionId`.
    session: Uuid?
    // What configuration sends every player.
    configuration: Configuration
    // The world players join and each of its dimensions' chunks, in the world's order, and the
    // players on their way to another, waiting for where they're going to load (CAL-69), the
    // last entity ID given out, and the server's ticks.
    world: World
    levels: List<Level>
    travels: List<Travel> = List<Travel>()
    // Every player's chunks nearest first, for the widest view yet.
    spiral: Spiral
    entity_ids: i32
    ticks: i32
    // The wall clock's time, which players' messages are stamped with.
    clock: Timestamp
    logs: List<Entry>
    // The codec threads, and the connections with something to send since the last flush.
    sending: Sending
    to_flush: List<Conn>
    // When each address last tried to log in, for `login-throttle`, by its IP.
    last_logins: Map<String, u64>
    // Who may join: the whitelist, ops and bans.
    access: Access
    // The server is stopping: its players have been told, and it ticks no more.
    halted: bool
    // The lines typed into the console, which the tick's connections run, `consoleInput`, and
    // whether a stop's come, which stops the server once its tick is done, as `halt(false)` has
    // vanilla's loop stop running (D432).
    console_lines: List<String> = List<String>()
    stop_due: bool = false
    // Where players new to the world spawn, the world's `level.dat`'s, and how far around it,
    // `respawn_radius`; the world's player files, which a replay hasn't; and what collisions see
    // of each block state, made for the first search.
    respawn: Spawn
    respawn_radius: i32 = DEFAULT_RESPAWN_RADIUS
    // Whether the generator is still finding a new world's spawn, which players new to it wait
    // for.
    spawn_pending: bool = false
    players: PlayerFiles? = none
    // The world's players' advancements, `players/advancements`, and statistics, `players/stats`,
    // which a replay hasn't (CAL-164).
    progress_files: ProgressFiles? = none
    stats_files: ProgressFiles? = none
    // The world's saved data, `data`, which command storage is read from as it's first asked
    // for, and which a replay hasn't (CAL-165).
    data_files: SavedFiles? = none
    collisions: CollisionStates? = none
    // Whether each block state is a liquid, which players' poses pass through, made from the
    // block facts when a pose is first fitted (CAL-141).
    liquids: List<bool> = List<bool>()
    // The world's `level.dat` as it was read, or a new world's, which is saved with what's
    // changed, or `none` for a test's world, which saves none; the world gen settings' `data`,
    // saved at the first save, as `MinecraftServer` marks them to be as it starts (D238); the
    // level's name, as the lines that save it name it; the saver, which a replay hasn't; and the
    // ticks until the next autosave, as `ticksUntilAutosave`.
    level_data: LevelData? = none
    world_gen: Tag? = none
    // Whether the world generates structures, its `generate_structures`, which a search for one
    // reads, as `findNearestMapStructure` does (D597).
    structures_on: bool = true
    // Whether, replaying, the entity chunks come from the log, as the recording opened its
    // `entities` folders (CAL-148).
    entities_logged: bool = false
    // The commands waiting for their players' connections, and how many players have joined.
    queued: Deque<Queued> = Deque<Queued>()
    // Every command, made the first time one's read (CAL-165).
    commands: CommandSet? = none
    // The command queue, vanilla's `ExecutionContext` (D567): whether one runs, and whether it's
    // held too many entries; its entries, the front last; those the entry running queues, put in
    // front once it's run; its frames; the depth of the entry running; how many more commands it
    // may run; and the result callbacks, commands, lists of sources and sums its entries name by
    // place, all let go once it's done.
    queue_running: bool = false
    queue_overflow: bool = false
    queue: List<QueueEntry> = List<QueueEntry>()
    queue_new: List<QueueEntry> = List<QueueEntry>()
    frames: List<QueueFrame> = List<QueueFrame>()
    queue_depth: i32 = 0
    quota: i32 = 0
    callbacks: List<Callback> = List<Callback>()
    plans: List<Plan> = List<Plan>()
    source_lists: List<List<Source>> = List<List<Source>>()
    sums: List<(bool, i32)> = List<(bool, i32)>()
    // The world's functions, read at the first tick, and their IDs and tags, by their places in
    // `functions`; those `#minecraft:tick` runs each tick; and whether those of
    // `#minecraft:load` are still to run, `postReload` (D567).
    functions_read: bool = false
    functions: List<Function> = List<Function>()
    // How many of `functions` are the world's; those past them are made from macro functions
    // for the queue running, and let go once it's done (D568).
    functions_loaded: usize = 0
    function_names: Registry? = none
    ticking: List<usize> = List<usize>()
    post_reload: bool = false
    // Whether the functions `/reload` read are yet to take the library's place, which they do
    // once nothing running holds the places of those it has: the command queue, and the loops
    // that run `#minecraft:tick`'s and those scheduled, `function_loops` deep (D572).
    library_due: bool = false
    function_loops: i32 = 0
    // The packs the repository has, as it last found them: as the server started, unless
    // `/reload` or `datapack list` has found them since, `available` (D573).
    packs_known: List<Found>? = none
    // The configuration and play packets that wait for the next tick, in the order they came on
    // every connection, as `PacketProcessor` holds them (CAL-150).
    scheduled: Deque<Scheduled> = Deque<Scheduled>()
    joins: u64 = 0
    // How many times a player has come into a level, which orders each level's players.
    entries: u64 = 0
    level_name: String = "world"
    saving: Saving? = none
    autosave_in: i32 = AUTOSAVE_TICKS
    // Pregenerating (CAL-71, D275): the tasks running, a dimension's at most, in the order they
    // started; what each source has chosen for the next it starts, by `source_key`; how often the
    // console's told how they go, in nanoseconds, and whether it's told at all; when they were
    // last saved, on the caller's clock; and whether there's been one since the server started,
    // so a world that never has one isn't given their file.
    pregens: List<Run> = List<Run>()
    choices: Map<String, Choice> = Map<String, Choice>()
    pregen_every: u64 = PREGEN_LOG_EVERY
    pregen_silent: bool = false
    pregen_saved_at: u64 = 0
    pregen_touched: bool = false
    // The caller's clock at the last tick.
    now: u64 = 0
    // The regions the players are in (CAL-63, D283).
    layout: Layout = Layout()
    // Pausing when empty (CAL-105): `pause-when-empty-seconds`, 0 for never, as a test's network
    // has it until it's set, and the ticks there have been no players, as `emptyTicks` counts
    // them; and the ticks since everyone was last told everyone's latency, as
    // `sendAllPlayerInfoIn` counts them.
    pause_when_empty: i32 = 0
    empty_ticks: i32 = 0
    player_info_in: i32 = 0
    // With `--rng-reseed`, the game time from which each level's random is seeded again and the
    // base it's seeded from, and the levels whose have been (D316).
    reseed: (i64, i64)? = none
    reseeded: List<bool> = List<bool>()
    // Whether each mob's state is written to `trace` as its tick is done (CAL-159).
    tracing: bool = false
    trace: String = String()
    // The chunks each level's saved tickets load, which the first tick waits for (D319).
    preparing: List<List<ChunkPos>> = List<List<ChunkPos>>()
    // The `sound_event` registry's IDs by name, which a sound's packet sends it by, made as the
    // first is sent (CAL-125).
    sound_ids: OpenHashMap<String, i32> = OpenHashMap<String, i32>()
    // The `particle_type` registry's IDs by name, which particles' packets send them by, made as
    // the first are sent (CAL-143).
    particle_ids: OpenHashMap<String, i32> = OpenHashMap<String, i32>()
    // The codecs players' items are read and written with, and their streams, made as the first
    // player joins, once the world has its registries (D372).
    items: ItemCodecs? = none
    // The world's loot, made the first time a level's given its block facts, once the world has
    // its registries, and which level has the random sequences, lent to it as it runs, or none
    // where the world has them (CAL-153).
    loot: Shared<Loot>? = none
    sequences_at: usize? = none
    // The scores sent every player while one's taken out of the connections, to be sent them
    // after, where they're being kept (CAL-164).
    held_scores: List<List<u8>>? = none
    // Whether the levels have the world's jukebox songs yet (CAL-143).
    songs_given: bool = false
    // Whether the block a player's using swung their arm, `SUCCESS_SERVER`, until it's sent them
    // (CAL-143).
    server_swing: bool = false
    // Whether the item the player used, not on a block or an entity, came to `SUCCESS`, which
    // swings their hand for those who see them (D579), or to `SUCCESS_SERVER`, which swings it
    // for them too, as an eye of ender thrown does (D599).
    use_swung: bool = false
    use_swung_self: bool = false
    // The `locate structure` searches not yet answered (D600).
    locating: List<Locating> = List<Locating>()
    // The UUID and entity ID of the player throwing what's being added, out of the connections
    // as they throw it, its owner as those who see it are told (D579).
    thrower: ((i64, i64), i32)? = none
    // The players' serials given so far, `Player.serial` (D580).
    serials: i64 = 0
    // The mob lent out of its level's list as it hurts a player, by its ID, as loot and a
    // criterion's predicates read it, so the hurt's and the death's triggers find it (CAL-164).
    lent_mob: (i32, LootEntity)? = none
    // The attack a player's packet asked for, by their connection's slot and the entity ID of what
    // they attack, made once their connection's back among the others, `attack_deferred`, so
    // the players it hurts are heard by them as by everyone (CAL-162).
    attacking: (usize, i32)? = none
    // The chunk, of a level and packed, whose generation's entities are being added as it comes
    // to be full, which vanilla's are as the chunk's promoted, `postLoadProtoChunk`, before it can
    // be ready to send; so they pair with whoever's view has it as it isn't sent yet (D589).
    coming_full: (usize, i64)? = none
    // What placing blocks reads of vanilla's tables, made the first time a block's used (CAL-139).
    placing: PlaceFacts? = none
    streams: Streams? = none
    // Each level's item entities and its entities' trackers, by its place in the world's, taken
    // out while they're worked on; what items read of the blocks, made as the first ticks; and
    // what entities' randoms are seeded from, `level-random-seed`, or else the server's own
    // seeds (CAL-148).
    entities: List<LevelEntities?> = List<LevelEntities?>()
    // The chunks each entity's nether portal way kept as it began, this tick's (D578).
    portal_known_of: List<PortalKnown> = List<PortalKnown>()
    // Whether the tick's holding for what a nether portal's way reads, and the entity chunks
    // read while it held, made into their entities once the tick's done (D579).
    portal_held: bool = false
    reads_held: List<HeldRead> = List<HeldRead>()
    // The entities this tick's to take through end gateways with no exit in the End, by level and
    // ID, with the gateway and where each is, whose exits are made as their ticks begin (D595).
    gateway_makes: List<(usize, i32, (i32, i32, i32), (f64, f64))> = List<(usize, i32, (i32, i32, i32), (f64, f64))>()
    movement: MovementStates? = none
    item_facts: BodyFacts? = none
    living_facts: LivingFacts? = none
    // What making the farm animals reads of the registries, made the first time it's needed
    // (CAL-156).
    mob_facts: MobFacts? = none
    // Natural spawning's count of a level's mobs and its maker of mobs, while the level's chunks
    // tick (CAL-156).
    spawn_state: SpawnState? = none
    making: MobMaking? = none
    entity_base: i64? = none
    entity_seeds: i64 = 0
}

/// How often the console's told how pregenerating goes, until `pregen quiet` says otherwise:
/// every 5 seconds.
pub const PREGEN_LOG_EVERY: u64 = 5000000000

// How often the pregen tasks are saved while they run, besides when one starts, pauses, carries
// on, is cancelled or is done, and with each save of the world: every 30 seconds.
const PREGEN_SAVE_EVERY: u64 = 30000000000

/// The ticks from one autosave to the next, as `computeNextAutosaveInterval` makes them at 20
/// ticks a second: 300 seconds' worth, and at least 100.
pub const AUTOSAVE_TICKS: i32 = 6000

/// A queue that already holds `key`, for a network whose key pair is made before it starts.
pub fn key_ready(key: own RsaKey) -> Receiver<RsaKey> {
    let keys = Receiver<RsaKey>()
    var to = keys.sender()
    to.send(key)
    return keys
}

impl Network {
    /// The network on `link`, which authenticates players with `services` in online mode, with
    /// the key pair that comes on `keys` as the server's, configures them with `configuration`
    /// and lets them into `world`. Only an online login needs the key pair, so the first waits
    /// for it, and the server can listen while another thread makes it.
    pub fn new(link: own Link, status: own StatusInfo, settings: own LoginSettings, lang: own Language, services: own Services, keys: own Receiver<RsaKey>, configuration: own Configuration, world: own World) -> Network {
        // The tickets reach the view distance, as `setServerViewDistance` has them. Vanilla
        // keeps it from 2 to 32, and Calcite doesn't yet (CAL-58); past 32 is the same as 32.
        var given = world
        var levels = List<Level>()
        for d in 0..given.dims.len() {
            var level = Level.new(given.settings.chunk_radius(), given.settings.simulation_distance)
            level.set_dimension(d, given.dims[d].id.to_string())
            level.set_bounds(given.dims[d].min_y, given.dims[d].height, given.settings.hashed_seed)
            level.set_flat_light(given.dims[d].ground.light())
            // Whether it's the End, which its end gateways ask from its first tick, and that its
            // chunks' entities load, which its block entities and ticks wait on (D595).
            level.entities_load = true
            level.the_end = given.dims[d].id.namespace == "minecraft" and given.dims[d].id.path == String("the_end")
            if let flat = given.dims[d].ground.take_chunk() {
                level.ground(flat)
            }
            levels.push(level)
        }
        var network = Network { link: link, connections: List<Connection?>(), status: status, settings: settings, lang: lang, services: services, status_json: String(), status_due: 0, key: none, public_key: List<u8>(), coming: keys, checks: List<Check>(), authenticators: 0, session: none, configuration: configuration, world: given, levels: levels, spiral: Spiral(), entity_ids: 0, ticks: 0, clock: Timestamp { unix_ms: 0 }, logs: List<Entry>(), sending: Sending.new(), to_flush: List<Conn>(), last_logins: Map<String, u64>(), access: Access.empty(false), halted: false, respawn: Spawn { dimension: overworld(), pos: BlockPos { x: 0, y: SURFACE_Y, z: 0 }, yaw: 0.0f32, pitch: 0.0f32 } }
        network.rebuild_status()
        return network
    }

    /// Sets where players new to the world spawn, `respawn`, as `level.dat` has it, and how far
    /// around it, `respawn_radius`, as the world's game rules have it, and the player files their
    /// saved places are read from, which a replay hasn't. Until it's set, players spawn at the
    /// flat world's 0, 0, 10 around, as in a world that's new.
    pub fn set_spawn(mut self, respawn: own Spawn, respawn_radius: i32, players: own PlayerFiles?) {
        self.respawn = respawn
        self.respawn_radius = respawn_radius
        self.players = players
    }

    /// Sets the folder of the world's players' advancements, which a replay hasn't (CAL-164).
    pub fn set_progress(mut self, files: own ProgressFiles?) {
        self.progress_files = files
    }

    /// Sets the folder of the world's players' statistics, which a replay hasn't (CAL-164).
    pub fn set_stats(mut self, files: own ProgressFiles?) {
        self.stats_files = files
    }

    /// Sets who may join, which is everyone until it's set.
    pub fn set_access(mut self, access: own Access) {
        self.access = access
    }

    /// Sets the world's `level.dat` as it was read, or `none` for a world without one, and the
    /// level's name, its `LevelName` or `level-name`. The game time goes on from the one it
    /// saved, and `brand`, the server's, is added to its brands, and it's marked modded, as
    /// `setModdedInfo` marks it for a server whose brand isn't vanilla's.
    pub fn set_level(mut self, level: own LevelData?, name: own String, brand: own String) {
        self.level_name = name
        if let given = level {
            var data = given
            self.world.game_time = data.time
            if not data.brands.contains(brand) {
                data.brands.push(brand)
            }
            data.modded = true
            self.level_data = some(data)
        }
    }

    /// Sets what the world saved of its weather, clocks and borders, and what else the tick reads
    /// (CAL-105), once `set_level` has set the game time: each dimension's border is set up then,
    /// as `applyInitialSettings` sets it up, each level's random is seeded, and each level that
    /// can have weather has its rain and thunder as `prepareWeather` sets them.
    pub fn set_world_state(mut self, state: own WorldState) {
        let WorldState { weather: weather, clocks: clocks, borders: given_borders, advance_time: advance_time, advance_weather: weather_on, pause_when_empty: pause_when_empty, max_world_size: max_world_size, max_chained: max_chained, water_source_conversion: water_converts, lava_source_conversion: lava_converts, seeds: given_seeds, spawn_rules: spawn_rules, random_tick_speed: random_tick_speed, fire_spread_radius: fire_spread_radius, max_snow: max_snow, natural_regeneration: natural_regeneration, cramming: cramming, sleeping_percentage: sleeping_percentage, max_block_modifications: max_block_modifications, trader: trader, trader_seed: trader_seed, tickets: given_tickets, sequences: sequences, block_drops: block_drops, mob_griefing: mob_griefing, mob_drops: mob_drops, damage_rules: damage_rules, movement_check: movement_check, allow_flight: allow_flight, portal_delay: portal_delay, portal_creative_delay: portal_creative_delay, nether_portals: nether_portals, pearls_vanish: pearls_vanish, keep_inventory: keep_inventory, show_death_messages: show_death_messages, show_advancement_messages: show_advancement_messages, pvp: pvp, locator_bar: locator_bar, universal_anger: universal_anger, forgive_dead_players: forgive_dead_players, projectiles_can_break_blocks: projectiles_can_break_blocks, scoreboard: scoreboard, scheduled: scheduled, boss_bars: boss_bars, fights: given_fights } = state
        var borders = given_borders
        var seeds = given_seeds
        var fights = given_fights
        self.world.weather = weather
        self.world.clocks = clocks
        self.world.advance_time = advance_time
        self.world.advance_weather = weather_on
        self.world.spawn_rules = spawn_rules
        self.world.random_tick_speed = random_tick_speed
        self.world.fire_spread_radius = fire_spread_radius
        self.world.max_snow = max_snow
        self.world.natural_regeneration = natural_regeneration
        self.world.cramming = cramming
        self.world.sleeping_percentage = sleeping_percentage
        self.world.max_block_modifications = max_block_modifications
        self.world.sequences = some(sequences)
        self.world.scoreboard = scoreboard
        self.world.scheduled = scheduled
        self.world.boss_bars = boss_bars
        self.world.block_drops = block_drops
        self.world.mob_griefing = mob_griefing
        self.world.mob_drops = mob_drops
        self.world.damage_rules = damage_rules
        self.world.movement_check = movement_check
        self.world.portal_delay = portal_delay
        self.world.portal_creative_delay = portal_creative_delay
        self.world.nether_portals = nether_portals
        self.world.pearls_vanish = pearls_vanish
        self.world.keep_inventory = keep_inventory
        self.world.show_death_messages = show_death_messages
        self.world.show_advancement_messages = show_advancement_messages
        self.world.pvp = pvp
        self.world.locator_bar = locator_bar
        self.world.universal_anger = universal_anger
        self.world.forgive_dead_players = forgive_dead_players
        self.world.projectiles_can_break_blocks = projectiles_can_break_blocks
        self.world.allow_flight = allow_flight
        var tickets = given_tickets
        self.world.spawners = Spawners.new(trader_seed, trader)
        self.pause_when_empty = pause_when_empty
        for d in 0..self.world.dims.len() {
            let settings = if borders.is_empty() { BorderSettings.default() } else { borders.remove(0) }
            self.world.dims[d].border = Border.new(settings, self.world.game_time, max_world_size)
            // Its dragon fight, as it saved it or new (D586).
            let fight: DragonFight? = if fights.is_empty() { none } else { fights.remove(0) }
            if self.world.dims[d].dragon_fight {
                self.world.dims[d].fight = some(fight ?? DragonFight())
            }
            if not tickets.is_empty() {
                if let saved = tickets.remove(0) {
                    self.levels[d].load_tickets(saved)
                }
            }
            self.levels[d].game_time = self.world.game_time
            self.levels[d].max_chained = max_chained
            self.levels[d].water_source_conversion = water_converts
            self.levels[d].lava_source_conversion = lava_converts
            let seed = if seeds.is_empty() { 0i64 } else { seeds.remove(0) }
            self.levels[d].set_random(TapedRandom.new(seed))
            self.world.dims[d].block_random.value = i32.wrap(seed)
            if self.world.dims[d].weathered {
                self.world.dims[d].weather = WeatherLevels.prepared(self.world.weather)
            }
            // Its dragon fight's `init`, once its weather's ready: its boss bar's UUID drawn
            // from the level's random, `createInsecureUUID`, and its gateways shuffled with the
            // world's seed where it has none (D623).
            if let f = self.world.dims[d].fight.take() {
                var kept = f
                var r = self.levels[d].lend_random()
                let most = (r.next_long() & -61441) | 16384
                let least = (r.next_long() & 4611686018427387903) | i64.MIN
                self.levels[d].give_back_random(r)
                kept.init(Uuid.new(most, least), self.world.seed)
                self.world.dims[d].fight = some(kept)
            }
            // As the level's made, once its weather is ready.
            self.world.dims[d].update_sky_brightness(self.world.clocks)
        }
    }

    /// Has each entity's random seeded from its ID and `base`, `level-random-seed`, as the rig's
    /// agent seeds vanilla's, rather than from the server's own seeds (CAL-148).
    pub fn seed_entities(mut self, base: i64) {
        self.entity_base = some(base)
    }

    /// Has each level's random seeded again from `base`, as `level-random-seed` seeded it as the
    /// level was made, the first time the level's tick starts at game time `at` or later, as the
    /// rig's agent does with `reseed` (D316). The two servers' draws line up again from there,
    /// whatever each drew before, such as while the player's chunks loaded, which vanilla's workers
    /// take their own time over.
    pub fn reseed_levels(mut self, at: i64, base: i64) {
        self.reseed = some((at, base))
        self.reseeded = List<bool>()
        for _ in 0..self.world.dims.len() {
            self.reseeded.push(false)
        }
    }

    /// Has each mob's state written as its tick is done from now on, which `take_trace` hands
    /// out, for `--entity-trace` (CAL-159).
    pub fn trace_entities(mut self) {
        self.tracing = true
    }

    // The entity trace's line for the player as their own tick is done, `doTick`, before they're
    // put back where their client has them, as the rig agent's trace writes vanilla's, their
    // body's turn and what they're told to walk as 0 (CAL-159).
    fn trace_player(mut self, con: Connection) {
        let time = self.world.game_time
        let line = "{time} {con.player.entity_id} {con.player.x} {con.player.y} {con.player.z} {con.player.vx} {con.player.vy} {con.player.vz} {con.player.y_rot} {con.player.x_rot} {con.player.y_head_rot} 0.0 0.0 0.0 {con.player.speed} {con.player.on_ground}\n"
        self.trace.push_str(line)
    }

    /// The entity trace's lines since this was last asked, a mob's state a line (CAL-159).
    pub fn take_trace(mut self) -> String {
        let out = self.trace.copy()
        self.trace = String()
        return out
    }

    /// Has each level's random write each value it draws to the RNG tape from now on, which
    /// `take_tape` hands out (D312).
    pub fn tape_levels(mut self) {
        for d in 0..self.levels.len() {
            let name = self.world.dims[d].id.to_string()
            self.levels[d].tape_random(name)
        }
    }

    /// The RNG tape's lines since this was last asked: each value a level's random drew, a line
    /// each, the level, the game time, the bits and the value, as the rig's agent writes
    /// vanilla's (D311). With `ending`, a line `# end LEVEL TIME` follows for each level, with the
    /// game time now.
    pub fn take_tape(mut self, ending: bool) -> String {
        var out = String()
        for d in 0..self.levels.len() {
            out.push_str(self.levels[d].take_random_lines())
        }
        if ending {
            for d in self.world.dims {
                out.push_str("# end {d.id.to_string()} {self.world.game_time}\n")
            }
        }
        return out
    }

    /// Carries on with the pregen tasks `data/calcite/pregen.dat` kept, each with the name of
    /// the dimension it's in, as they were: running, or paused. One in a dimension the world
    /// hasn't, or in one that already has one, is dropped, with a warning.
    pub fn set_pregen(mut self, tasks: own List<(String, PregenTask)>) {
        var all = tasks
        while not all.is_empty() {
            let (id, task) = all.remove(0)
            var dim: usize? = none
            match Identifier.parse(id) {
                ok(name) => dim = self.world.dimension_of(name),
                err(_) => {},
            }
            let d = dim else {
                self.logs.push(Entry.warn("Pregen in {id} is dropped: the world has no such dimension"))
                continue
            }
            if self.pregen_in(d) != none {
                self.logs.push(Entry.warn("Pregen in {id} is dropped: there's another there"))
                continue
            }
            var run = Run { dim: d, id: id, task: task, starter: none }
            run.told_tenths = run.tenths()
            let state = if run.task.paused { "is paused" } else { "carries on" }
            self.logs.push(Entry.info("Pregen in {run.id} {state}: {run.task.progress()}"))
            self.pregens.push(run)
            self.pregen_touched = true
        }
    }

    // The place among the tasks of the one in the dimension at `dim`.
    fn pregen_in(self, dim: usize) -> usize? {
        for i in 0..self.pregens.len() {
            if self.pregens[i].dim == dim {
                return some(i)
            }
        }
        return none
    }

    /// How the pregen tasks go, for the dashboard: the share of their chunks done, in tenths of a
    /// percent, and how many they do a second, or `none` where there are none.
    pub fn pregen_shown(self) -> (u64, u64)? {
        if self.pregens.is_empty() {
            return none
        }
        var done: u64 = 0
        var total: u64 = 0
        var rate = 0.0
        for r in self.pregens {
            done += r.task.done.min(r.task.total)
            total += r.task.total
            if not r.task.paused {
                rate += r.task.rate() ?? 0.0
            }
        }
        let share: u64 = if total == 0 { 1000 } else { done * 1000 / total }
        return some((share, u64.wrap(i64.saturate((rate + 0.5).floor()).max(0))))
    }

    /// Sets the world gen settings' `data`, which the first save writes, and whether the world
    /// generates structures, `structures` (D597).
    pub fn set_world_gen(mut self, data: own Tag, structures: bool) {
        self.world_gen = some(data)
        self.structures_on = structures
    }

    /// Saves players' data to `players`, and the world's `level.dat` to its folder at `world`,
    /// from now on, on the saver's thread (D189). Until this, and replaying, nothing is saved.
    pub fn open_saving(mut self, players: own PlayerFiles, world: own String) {
        self.data_files = some(SavedFiles.at(join_path(world, "data")))
        match self.link.waker() {
            ok(waker) => self.saving = some(Saving.start(players, world, waker)),
            err(_) => self.logs.push(Entry.error("Can't save the world: there's nothing to wake the server's poll with")),
        }
    }

    /// How many saves are handed to the saver whose lines the server hasn't taken: the server
    /// isn't to end until there are none.
    pub fn saves_away(self) -> usize {
        var n: usize = 0
        for level in self.levels {
            n += level.chunks_closing()
            n += level.pois_closing()
        }
        if let s = self.saving {
            n += s.away()
        }
        // Each level's entity chunks, until they're saved and their thread's closed (CAL-148).
        for slot in self.entities {
            if let es = slot {
                if es.stopping and not es.closed {
                    n += 1
                }
                if let jobs = es.jobs {
                    n += jobs.closing()
                }
            }
        }
        return n
    }

    /// Reads each dimension's chunks from the region files in its folder in `regions`, in the
    /// world's order, from now on, as the world's folder is open, each on an IO thread and chunk
    /// workers of its own that start with its first chunk, and generates those that aren't
    /// saved, unless it's a flat world's Overworld. Replaying, there's no folder, and `regions`
    /// is empty: the chunks the recording read come from its log, if it read any, and those it
    /// generated are generated again. Until this, every chunk is flat, and
    /// they all are if the world was made without its registries, as a test's, or there's
    /// nothing to wake the server's poll with as they're read.
    ///
    /// A world whose spawn isn't chosen yet, as a new one's isn't, has it chosen, as `createLevels`
    /// chooses it when `level.dat` isn't `initialized`: a world that generates has its generator
    /// find it, as `setInitialSpawn` does, and players new to it wait for that, and a flat one's
    /// is its 0, 0.
    pub fn open_world(mut self, regions: List<String>) {
        var all_jobs = List<ChunkJobs?>()
        var reads = false
        for d in 0..self.world.dims.len() {
            var jobs: ChunkJobs? = none
            var context: ChunkContext? = none
            if let c = self.world.dims[d].context {
                context = some(c.copy())
            }
            if d < regions.len() {
                if let made = context {
                    match self.link.waker() {
                        ok(waker) => {
                            var j = ChunkJobs.new(regions[d].copy(), made.copy(), self.world.dims[d].gen.copy(), waker, self.world.settings.chunk_workers)
                            if let path = self.world.settings.stage_times {
                                j.set_stage_times(if d == 0 { path.copy() } else { "{path}.{d}" })
                            }
                            jobs = some(j)
                            reads = true
                        },
                        err(_) => self.logs.push(Entry.error("Can't read the world's chunks, so they're generated: there's nothing to wake the server's poll with")),
                    }
                }
            }
            all_jobs.push(jobs)
        }
        if not self.link.world(reads) {
            return
        }
        for d in 0..self.world.dims.len() {
            var context: ChunkContext? = none
            if let c = self.world.dims[d].context {
                context = some(c.copy())
            }
            let made = context else return
            let jobs = all_jobs[d].take()
            self.levels[d].open(jobs, made, self.world.dims[d].gen.copy())
            // Replaying, light runs here, a step each time the recording's light took one (D264).
            if not reads {
                self.levels[d].light_as_recorded()
            }
        }
        var chosen = true
        if let d = self.level_data {
            chosen = d.initialized
        }
        if chosen {
            return
        }
        if self.levels[0].generates() {
            self.spawn_pending = true
            self.levels[0].ask_spawn()
        } else {
            let pos = self.respawn.pos
            self.found_spawn(pos)
        }
    }

    // A new world's spawn is chosen: players new to the world start from it, and `level.dat`
    // keeps it, as `setInitialSpawn` sets it, facing south, and is `initialized`.
    fn found_spawn(mut self, pos: BlockPos) {
        self.respawn = Spawn { dimension: overworld(), pos: pos, yaw: 0.0f32, pitch: 0.0f32 }
        self.spawn_pending = false
        if let kept = self.level_data.take() {
            var data = kept
            data.spawn = self.respawn.copy()
            data.initialized = true
            self.level_data = some(data)
        }
    }

    /// Sets the wall clock's time, which the caller reads before it hands over what happened, as
    /// vanilla reads `Instant.now()` as it handles each message.
    pub fn set_clock(mut self, now: Timestamp) {
        self.link.clock(now)
        self.clock = now
    }

    /// Listens on `host` and `port`, as vanilla's `startTcpServerListener`. An empty host is
    /// every address.
    pub fn listen(self, host: String, port: u16) -> u16 ! NetError {
        return try self.link.listen(host, port)
    }

    /// Replaces what the server list shows, as vanilla rebuilds it every 5 seconds.
    pub fn set_status(mut self, status: own StatusInfo) {
        self.status = status
        self.rebuild_status()
    }

    // The status as `buildServerStatus` makes it, with whether secure chat is enforced, which
    // changes once the services' keys come.
    fn rebuild_status(mut self) {
        self.status.status.enforces_secure_chat = self.enforces_secure_chat()
        self.status_json = self.status.status.to_json()
    }

    /// What happened since the last call that's worth logging, oldest first.
    pub fn take_logs(mut self) -> List<Entry> {
        var out = List<Entry>()
        for e in self.logs {
            self.link.logged(e)
            out.push(Entry { level: e.level, message: e.message.copy(), thread: e.thread.copy(), look: e.look.copy() })
        }
        self.logs.clear()
        return out
    }

    /// The public keys of Mojang's services, once they've been fetched.
    pub fn service_keys(self) -> KeySet? {
        return self.services.key_set()
    }

    /// What the link recorded since this was last called, which is the input log when the pieces
    /// are joined: nothing unless the link records.
    pub fn take_log(mut self) -> List<u8> {
        return self.link.take_log()
    }

    /// Hands the server the next input of the log its link replays, as the server's loop handed
    /// it over as it ran (D21). False once the log has run out, or the server has gone another
    /// way than it did as it was recorded, which `report` says. The caller takes the logs as the
    /// loop did, which checks them.
    pub fn replay_step(mut self) -> bool {
        let input = self.link.next_input() else {
            self.link.finish()
            return false
        }
        match input {
            Input.Event(e, now) => _ = self.handle(e, now),
            Input.Tick(now) => self.tick(now),
            Input.Sweep(now) => self.sweep(now),
            Input.Clock(t) => self.set_clock(t),
            Input.Command(line) => self.command(line),
            Input.Halt => self.halt(),
            Input.Region(d, region, lines, presence) => {
                if d >= self.levels.len() or not self.levels[d].read_region(region, lines, presence) {
                    self.link.diverged("the IO thread said which chunks region {region.x}, {region.z} of dimension {d} has, which the server didn't ask")
                    return true
                }
                self.level_lines()
                self.levels[d].dispatch()
            },
            Input.Saved(lines) => {
                for e in lines {
                    self.logs.push(e.copy())
                }
            },
            Input.Spawn(pos) => {
                if not self.spawn_pending {
                    self.link.diverged("the generator found a spawn the server didn't ask for")
                }
                self.found_spawn(pos)
            },
            Input.Light(d, covered) => {
                if d >= self.levels.len() or not self.levels[d].replay_light(covered) {
                    self.link.diverged("light took a step over {covered} asks of dimension {d}, which the server hadn't asked")
                    return true
                }
                self.level_lines()
                // As `light_done` spawns what the step's light lets spawn (CAL-161).
                self.generation_spawns(d)
                self.levels[d].dispatch()
            },
            Input.Chunk(d, pos, io, bytes) => {
                if d >= self.levels.len() {
                    self.link.diverged("the IO thread read chunk {pos.x}, {pos.z} of dimension {d}, which the server hasn't")
                    return true
                }
                // What the workers made of what the IO thread read is made again here, from it.
                var made = List<Entry>()
                let loaded = self.levels[d].make(pos, bytes, mut made)
                let given = self.fresh_ids(d, pos, loaded)
                if not self.levels[d].read_chunk(pos, io, given, made) {
                    self.link.diverged("the IO thread read chunk {pos.x}, {pos.z} of dimension {d}, which the server didn't ask for")
                }
                self.level_lines()
                self.levels[d].dispatch()
            },
            Input.Withdrawn(d, pos, io, made) => {
                if d >= self.levels.len() or not self.levels[d].withdrawn(pos, io, made) {
                    self.link.diverged("the generator handed back chunk {pos.x}, {pos.z} of dimension {d} unmade, which the server didn't ask for")
                    return true
                }
                self.level_lines()
                self.levels[d].dispatch()
            },
            Input.Pois(d, pos, io, got) => {
                if d >= self.levels.len() or not self.levels[d].pois_read(pos, io, got) {
                    self.link.diverged("the POI IO thread read POI chunk {pos.x}, {pos.z} of dimension {d}, which the server didn't ask for")
                    return true
                }
                self.level_lines()
                self.levels[d].dispatch()
            },
            Input.Entities(d, pos, io, got) => {
                if d >= self.levels.len() or not self.entity_chunk_read(d, pos, io, got) {
                    self.link.diverged("the entities' IO thread read entity chunk {pos.x}, {pos.z} of dimension {d}, which the server didn't ask for")
                    return true
                }
                if self.halted {
                    self.stop_entities(d)
                }
            },
        }
        return true
    }

    /// A line typed into the console, kept for the next tick, as vanilla's `handleConsoleInput`
    /// keeps it, whose connections run it, `console_inputs` (D432).
    pub fn command(mut self, line: String) {
        self.link.command(line)
        self.console_lines.push(line.copy())
    }

    // `handleConsoleInputs`, after the tick's connections, as the dedicated server's
    // `tickConnection` runs it (D432): each line typed into the console since, in the order it
    // came, as a command from the console, which may run any, as `Commands.performPrefixedCommand`
    // runs it: without a leading `/`, read as brigadier reads it against the commands Calcite has
    // (`server.commands`), and what it says logged (P6.6 brings the rest of vanilla's).
    fn console_inputs(mut self) {
        while not self.console_lines.is_empty() {
            let line = self.console_lines.remove(0)
            let input = if line.starts_with("/") { line[1..] } else { line.copy() }
            let source = self.console_source()
            self.run_command(source, input, [])
        }
    }

    // Stops the server once the tick a stop came in is done, as vanilla's loop stops once
    // `halt(false)` has it no longer running (D432).
    fn stop_if_due(mut self) {
        if self.stop_due and not self.halted {
            self.stop_due = false
            self.stop()
        }
    }

    /// Stops the server at the console's request, as vanilla's shutdown hook halts it at Ctrl+C:
    /// with no command's answer.
    pub fn halt(mut self) {
        self.link.halt()
        self.stop()
    }

    /// Whether the server is stopping: it has told its players, and ticks no more.
    pub fn stopping(self) -> bool {
        return self.halted
    }

    /// The players in the world, as the console's bar counts them.
    pub fn players_online(self) -> usize {
        var n: usize = 0
        for slot in 0..self.connections.len() {
            if self.playing(slot) {
                n += 1
            }
        }
        return n
    }

    /// `max-players`, as the server list says it.
    pub fn max_players(self) -> i32 {
        return self.world.settings.max_players
    }

    /// The chunks the players' views hold between them, which the console's bar counts as the
    /// loaded ones: vanilla keeps a chunk loaded while a player's view holds it, and the flat
    /// world has no others.
    pub fn chunks_in_view(self) -> usize {
        var views = List<(ChunkPos, i32)>()
        for c in self.connections {
            if let con = c {
                if in_world(con) and con.player.view > 0 {
                    views.push((ChunkPos { x: con.player.center_x, z: con.player.center_z }, con.player.view))
                }
            }
        }
        return chunks_held(views)
    }

    /// How many connections the server has closed that aren't gone yet.
    pub fn closing(self) -> usize {
        var n: usize = 0
        for c in self.connections {
            if let con = c {
                if con.closing {
                    n += 1
                }
            }
        }
        return n
    }

    // What vanilla's `MinecraftServer.stopServer` does that Calcite has: it says so, saves each
    // player, as `PlayerList.saveAll` does, then tells them the server closed, as `removeAll`
    // does, and closes their connections; then it saves the world, the overworld, the one level
    // Calcite has, and `level.dat`, with vanilla's lines. Connections still logging in or being
    // configured are left, as vanilla leaves them, to end with the process. The server ends once
    // the saver has written it all.
    fn stop(mut self) {
        if self.halted {
            return
        }
        self.halted = true
        self.logs.push(Entry.info(String("Stopping server")).calcite(Look.Words(String("Stopping"))))
        self.logs.push(Entry.info(String("Saving players")).calcite(Look.Quiet))
        self.save_players()
        for i in 0..self.connections.len() {
            if not self.playing(i) {
                continue
            }
            var con = self.connections[i].take() else continue
            // One the client closed, which no tick will find now, is gone (CAL-151).
            if con.gone {
                self.lost(con)
                continue
            }
            self.tell(mut con, Component.translatable("multiplayer.disconnect.server_shutdown", []))
            self.close(mut con)
            // Their ender pearls go with them before the levels are saved, as `removeAll`'s
            // `PlayerList.remove` takes them, so no chunk saves them (D580).
            self.unload_pearls(con)
            self.connections[i] = some(con)
        }
        if self.pregen_touched {
            self.save_pregen()
        }
        self.logs.push(Entry.info(String("Saving worlds")).calcite(Look.Words(String("Saving the world"))))
        for d in 0..self.levels.len() {
            let id = self.world.dims[d].id.to_string()
            self.logs.push(Entry.info("Saving chunks for level 'ServerLevel[{self.level_name}]'/{id}").calcite(Look.Quiet))
            self.levels[d].close_chunks()
            // And its points of interest, `poiManager.flushAll` (CAL-160).
            self.levels[d].close_pois()
            // Then its entities, `entityManager.saveAll` (CAL-148).
            var es = self.take_entities(d)
            es.stopping = true
            self.put_entities(d, es)
            self.stop_entities(d)
        }
        self.save_level()
        self.flush()
    }

    // An autosave, as `autoSave` saves: each player, then each level's chunks changed in play,
    // as `saveAllChunks(false)` saves them (CAL-145), then the world, logging nothing.
    fn autosave(mut self) {
        self.autosave_in = AUTOSAVE_TICKS
        self.save_players()
        for d in 0..self.levels.len() {
            self.levels[d].save_eagerly(i64.wrap(self.now / 1000000), true)
            // Then its entities, `entityManager.autoSave` (CAL-148).
            self.save_entity_chunks(d)
        }
        self.save_level()
        if self.pregen_touched {
            self.save_pregen()
        }
    }

    // Saves the pregen tasks, as they are, to `data/calcite/pregen.dat`.
    fn save_pregen(mut self) {
        self.pregen_saved_at = self.now
        var saving = self.saving.take() else return
        saving.save(Save.Data(pregen_saved_id(), pregen_data(self.pregens)))
        self.saving = some(saving)
    }

    // Steps each pregen task, then settles the level it holds its chunks in, so what it started
    // is asked for this tick. The console's told how each goes every `pregen_every`, unless
    // they're silent, and the player who started one each time another tenth of it is done.
    // One that's done says so, and goes.
    fn pregen_tick(mut self, now: u64) {
        if self.pregens.is_empty() {
            return
        }
        var i: usize = 0
        while i < self.pregens.len() {
            let d = self.pregens[i].dim
            var run = self.pregens.remove(i)
            let give_way = self.levels[d].players_loading()
            run.task.step(mut self.levels[d], now, give_way)
            self.levels[d].pump()
            if run.task.finished() {
                let line = run.done_line()
                self.logs.push(Entry.info(line.copy()))
                if let who = run.starter {
                    self.tell_player(who, Component.literal(line))
                }
                self.save_pregen()
                continue
            }
            if not self.pregen_silent and not run.task.paused {
                if now >= run.logged_at + self.pregen_every {
                    run.logged_at = now
                    self.logs.push(Entry.info(run.line()))
                }
                let tenths = run.tenths()
                if tenths > run.told_tenths {
                    run.told_tenths = tenths
                    if let who = run.starter {
                        self.tell_player(who, Component.literal(run.line()).colored("gray"))
                    }
                }
            }
            self.pregens.insert(i, run)
            i += 1
        }
        if not self.pregens.is_empty() and now >= self.pregen_saved_at + PREGEN_SAVE_EVERY {
            self.save_pregen()
        }
    }

    // A system message to the player in play whose UUID is `id`, if they're on.
    fn tell_player(mut self, id: Uuid, message: own Component) {
        for slot in 0..self.connections.len() {
            var found = false
            if let c = self.connections[slot] {
                if let p = c.profile {
                    found = p.id == id and in_world(c)
                }
            }
            if found {
                self.tell_slot(slot, message)
                return
            }
        }
    }

    // Saves each player in the world, as `PlayerList.saveAll` does.
    fn save_players(mut self) {
        for i in 0..self.connections.len() {
            if not self.playing(i) {
                continue
            }
            let con = self.connections[i].take() else continue
            self.save_player(con)
            self.connections[i] = some(con)
        }
    }

    // Saves the player's data, as `PlayerList.save` does: as it was read as they joined, or a
    // new player's, with where they are now (D189); then their statistics and their advancements
    // (CAL-164).
    fn save_player(mut self, con: Connection) {
        self.save_player_as(con, con.player.stats)
    }

    // `save_player` with `stats` for the player's statistics.
    fn save_player_as(mut self, con: Connection, stats: PlayerStats) {
        let p = con.profile else return
        var saving = self.saving.take() else return
        let dimension = self.world.dims[con.player.dim].id.to_string()
        var tag = player_tag(con.player, p.id, dimension)
        // Their ender pearls, `saveEnderPearls`, where they have any, none kept of those they
        // joined with (D580).
        _ = tag.remove("ender_pearls")
        let pearls = self.saved_pearls(con)
        if not pearls.is_empty() {
            tag.insert(String("ender_pearls"), Tag.List(pearls))
        }
        // Their recipe book, `ServerRecipeBook.pack` (CAL-164).
        if let shared = self.world.recipes.copy() {
            tag.insert(String("recipeBook"), con.player.recipe_book.pack(shared.value))
        }
        saving.save(Save.Player(p.id, p.name.copy(), Tag.Compound(tag)))
        // Then their statistics, `ServerStatsCounter.save` (CAL-164).
        if let s = self.stats_save(con, stats) {
            saving.save(s)
        }
        // Then their advancements, `PlayerAdvancements.save` (CAL-164).
        if let a = self.world.advancements {
            if let files = self.progress_files {
                let offset = unsafe { self.clock.local_offset() }
                let members = con.player.advancements.to_json(a.value, offset)
                saving.save(Save.Progress(files.copy(), files.file(p.id.to_string()), members))
            }
        }
        self.saving = some(saving)
    }

    // `ServerStatsCounter.save` of `stats`, the statistics of `con`'s player, to the file they
    // were read from, else their UUID's (CAL-164): their stats as `toJson` writes them.
    fn stats_save(self, con: Connection, stats: PlayerStats) -> Save? {
        let p = con.profile else return none
        let files = self.stats_files else return none
        let path = if stats.file.is_empty() { files.file(p.id.to_string()) } else { stats.file.copy() }
        return some(Save.Progress(files.copy(), path, stats.to_json()))
    }

    // Saves `level.dat`, as `saveDataTag` does, with the game time and the wall clock's time now,
    // then the world gen settings, the first time, as `saveAndJoin` saves what's marked.
    fn save_level(mut self) {
        var saving = self.saving.take() else return
        if let kept = self.level_data.take() {
            var data = kept
            data.time = self.world.game_time
            saving.save(Save.Level(data.write(self.clock.unix_ms)))
            self.level_data = some(data)
        }
        if let data = self.world_gen.take() {
            saving.save(Save.Data(world_gen_id(), data))
        }
        // The weather, the clocks, the wandering trader's data (D314) and each dimension's
        // border, if they've changed since they were saved, as `saveAndJoin` saves what's
        // marked (CAL-105).
        if self.world.weather.dirty {
            self.world.weather.dirty = false
            saving.save(Save.Data(weather_id(), self.world.weather.pack()))
        }
        if self.world.clocks.dirty {
            self.world.clocks.dirty = false
            saving.save(Save.Data(clocks_id(), self.world.clocks.pack()))
        }
        if self.world.spawners.trader.dirty {
            self.world.spawners.trader.dirty = false
            saving.save(Save.Data(trader_id(), self.world.spawners.trader.pack()))
        }
        // The random sequences, drawn from or made afresh, back in the world from the level
        // they were lent to (CAL-153).
        if let taken = self.take_sequences() {
            var s = taken
            if s.dirty {
                s.dirty = false
                saving.save(Save.Data(sequences_id(), s.pack()))
            }
            self.world.sequences = some(s)
        }
        // The scoreboard, where it's changed from what it was read or last saved as, as
        // `storeToSaveDataIfDirty` and `setData` save it, or new (CAL-164).
        if let packed = self.world.scoreboard.take_save() {
            saving.save(Save.Data(scoreboard_id(), packed))
        }
        // Each namespace of command storage that's changed (CAL-165).
        for (id, packed) in self.world.storage.take_saves() {
            saving.save(Save.Data(id.copy(), packed.copy()))
        }
        // The functions `schedule` has waiting, where they've changed (D569).
        if self.world.scheduled.dirty {
            let packed = self.world.scheduled.pack()
            saving.save(Save.Data(scheduled_id(), packed))
        }
        // The boss bars, where they've changed (D606).
        if let packed = self.world.boss_bars.take_save() {
            saving.save(Save.Data(boss_bars_id(), packed))
        }
        for d in 0..self.world.dims.len() {
            if self.world.dims[d].border.dirty {
                self.world.dims[d].border.dirty = false
                saving.save(Save.DimensionData(self.world.dims[d].id.copy(), border_id(), self.world.dims[d].border.pack()))
            }
            // Its tickets, as vanilla saves the `TicketStorage` it marks as a ticket that
            // persists comes or goes (D319).
            if d < self.levels.len() {
                if let packed = self.levels[d].take_dirty_tickets() {
                    saving.save(Save.DimensionData(self.world.dims[d].id.copy(), tickets_id(), packed))
                }
            }
            // Its dragon fight, where it's changed (D623).
            if let f = self.world.dims[d].fight.take() {
                var fight = f
                if let packed = fight.take_save() {
                    saving.save(Save.DimensionData(self.world.dims[d].id.copy(), fight_id(), packed))
                }
                self.world.dims[d].fight = some(fight)
            }
        }
        self.saving = some(saving)
    }

    // Takes in what the saver's saves logged, recording it as the server's loop hands it over.
    fn saves_done(mut self) {
        var saving = self.saving.take() else return
        var done = saving.take_done()
        self.saving = some(saving)
        while let lines = done.pop_first() {
            self.link.saved(lines)
            for e in lines {
                self.logs.push(e.copy())
            }
        }
    }

    // Waits for the saver to write what it's been handed, so a player's data is read once their
    // last save is on the disk. What the saves logged is taken in later, as ever.
    fn wait_saves(mut self) {
        var saving = self.saving.take() else return
        saving.wait()
        self.saving = some(saving)
    }

    /// Replays the rest of the log, taking the logs after each input, and says what it found.
    pub fn replay_all(mut self) -> Report {
        while self.replay_step() {
            _ = self.take_logs()
        }
        return self.report()
    }

    /// What the replay found: whether the server sent and logged what it did as it was
    /// recorded, and where it first didn't.
    pub fn report(self) -> Report {
        return self.link.report()
    }

    /// How many connections are open.
    pub fn open(self) -> usize {
        var n: usize = 0
        for c in self.connections {
            if c != none {
                n += 1
            }
        }
        return n
    }

    /// Handles one event from the `Net`'s poll, at `now` nanoseconds on the caller's clock, and
    /// says whether it was the server's: an event about any other connection is left alone, and
    /// `Woken` is everyone's, since anything with a waker may have woken the poll. What the
    /// server sends because of it is flushed.
    pub fn handle(mut self, e: Event, now: u64) -> bool {
        match e {
            Event.Accepted(c) => {
                self.link.accepted(c, now)
                let slot = c.slot()
                while self.connections.len() <= slot {
                    self.connections.push(none)
                }
                // One the client closed that the tick hasn't found yet, whose slot this one has,
                // is gone now (CAL-151).
                if let old = self.connections[slot].take() {
                    self.lost(old)
                }
                let peer = self.link.peer(c)
                let address = if self.settings.log_ips { java_address(peer) } else { String("IP hidden") }
                self.connections[slot] = some(Connection { conn: c, codec: Decoder.new(), out: Outbox.new(), listed: false, phase: Phase.Handshake, started: false, status_requested: false, last_read: now, closing: false, peer: peer, address: address, ban_ip: ban_ip(java_address(peer)), login: LoginState.Hello, login_ticks: 0, transferred: false, challenge: List<u8>(), query_id: 0, name: none, profile: none, reason: none, tasks: List<Task>(), task: none, information: ClientInformation.default(), keep_alive_time: 0, keep_alive_pending: false, latency: 0, outbound: State.Login, player: Player() })
                return true
            },
            Event.Received(c) => {
                if not self.owns(c) {
                    return false
                }
                self.link.received(c, now)
                self.receive(c, now)
                self.flush()
                return true
            },
            Event.Closed(c) => {
                if not self.owns(c) {
                    return false
                }
                self.link.closed(c, now)
                let slot = c.slot()
                var con = self.connections[slot].take() else return true
                // One whose listener isn't told yet waits for the tick's connections, with the
                // player still in the world (CAL-151), the server's closing it or not, as
                // vanilla's `disconnect` hands it to `handleDisconnection` while its channel's
                // still open, which does nothing till the channel's closed (D445). One told
                // already, or any once the server's stopped and ticks no more, is gone now.
                if not con.handled and not self.halted {
                    con.gone = true
                    self.connections[slot] = some(con)
                    return true
                }
                self.lost(con)
                self.flush()
                return true
            },
            Event.Connected(_) => return false,
            Event.Woken => {
                self.sent()
                self.pois_read()
                self.chunks_read()
                self.entities_read()
                self.light_done()
                self.saves_done()
                self.flush()
                return false
            },
        }
    }

    /// Activates each level's saved tickets, as `prepareLevels` has each level's
    /// `activateAllDeactivatedTickets`, and keeps the chunks they load that weren't to be full,
    /// which the first tick waits for, as `ChunkLoadCounter` has `prepareLevels` wait (D319).
    pub fn prepare_levels(mut self) {
        self.preparing.clear()
        for d in 0..self.levels.len() {
            self.preparing.push(self.levels[d].activate_saved_tickets())
        }
        self.dispatch_all()
    }

    // Whether the chunks the saved tickets load are all full, which the first tick waits for,
    // as `prepareLevels` waits before the server's loop starts (D319), with the light of those
    // whose blocks tick (D320).
    fn prepared(mut self) -> bool {
        if self.preparing.is_empty() {
            return true
        }
        for d in 0..self.preparing.len() {
            if d < self.levels.len() {
                self.levels[d].pump()
                if not self.levels[d].all_full(self.preparing[d]) {
                    return false
                }
                // And the light of the chunks whose blocks tick, which their random ticks read,
                // as vanilla's chunks have theirs once they're full (D320).
                let ticking = self.levels[d].block_ticking_chunks()
                self.levels[d].keep_light(ticking.copy())
                if not self.levels[d].has_light(ticking) {
                    return false
                }
            }
        }
        self.preparing.clear()
        return true
    }

    /// One server tick, at `now` nanoseconds on the caller's clock, as vanilla's `tickServer`
    /// runs it (CAL-105), once the checks with the session server that are done have been acted
    /// on and Mojang's services fetched from as they're due: until the chunks the saved tickets
    /// load are full, nothing ticks (D319); then the packets held for the tick run, as
    /// `processPacketsAndTick` runs them first (CAL-150); a server that's had no players for
    /// `pause-when-empty-seconds` ticks only its connections, until someone joins; else the tick
    /// is `tick_children`'s, then the status is rebuilt if it's 5 seconds old, and the autosave
    /// counts down. Then the levels settle, as vanilla's do while it waits for the next tick
    /// (D446). A stop that came in the tick stops the server once it's done (D432).
    pub fn tick(mut self, now: u64) {
        self.link.tick(now)
        self.services.tick(now, mut self.logs, mut self.link)
        self.authenticate()
        self.now = now
        if not self.prepared() {
            self.dispatch_all()
            self.flush()
            return
        }
        // The tick starts, where vanilla's main-thread executor doesn't run: a chunk that comes
        // to a ticking level ticks from the pass after it (D447).
        self.set_in_tick(true)
        self.run_scheduled(now)
        self.locates_in()
        // A respawn waiting on where it goes holds the tick, as vanilla's thread waits on its
        // search (D428).
        // And a portal waiting on what its way reads, as vanilla's waits in the player's tick
        // (D577). And a dragon fight's scan waiting on its arena's chunks (D625).
        if self.respawns_wait() or self.portals_wait() or self.fights_wait() {
            self.set_in_tick(false)
            self.dispatch_all()
            self.flush()
            return
        }
        if self.paused() {
            self.tick_connections(now)
            self.set_in_tick(false)
            self.held_reads_in()
            self.settle_between()
            self.stop_if_due()
            self.dispatch_all()
            self.flush()
            return
        }
        self.ticks += 1
        self.tick_children(now)
        // The status is rebuilt every 5 seconds, as `tickServer` rebuilds it after the tick.
        if now >= self.status_due {
            self.status_due = now + STATUS_EXPIRE_NS
            self.rebuild_status()
        }
        // The autosave, as `tickServer` counts down to it after the tick, which a server that's
        // stopped and saved has no more of.
        self.autosave_in -= 1
        if self.autosave_in <= 0 and not self.halted {
            self.autosave()
        }
        // What the tick changed of the levels' tickets settles before the next, as vanilla's
        // server, waiting for it, runs `pollTask`, whose chunk sources run
        // `runDistanceManagerUpdates` while it has time: a dead player taken out of their level
        // drops their chunks now, before a respawn in the next tick raises them (D446). It's the
        // main-thread pass in which the chunks that came to tick in the tick come in (D447).
        // Before it, the server's own tasks, as its `pollTask` runs them first: the entity
        // chunks read while the tick held for a portal's way made into their entities (D579).
        self.set_in_tick(false)
        self.held_reads_in()
        self.settle_between()
        self.stop_if_due()
        self.dispatch_all()
        self.flush()
    }

    // The entity chunks read while the tick held for what a nether portal's way reads, made into
    // their entities now, in the order they were read (D579): vanilla's thread, waiting on a
    // chunk in an entity's tick, runs its chunk source's tasks alone, `managedBlock`, and makes
    // what was read into entities, with their IDs, among its own tasks between ticks, so after
    // what the portal took has its new ID.
    fn held_reads_in(mut self) {
        self.portal_held = false
        if self.reads_held.is_empty() {
            return
        }
        let held = self.reads_held.copy()
        self.reads_held.clear()
        for r in held {
            self.link.entities_read(r.d, r.pos, r.io, r.got)
            _ = self.entity_chunk_read(r.d, r.pos, r.io, r.got)
            if self.halted {
                self.stop_entities(r.d)
            }
        }
    }

    // Whether the server's paused this tick, as `tickServer` pauses one that's had no players for
    // `pause-when-empty-seconds`, saying so and saving once as it does. Pregenerating keeps it
    // going, as a task needs its ticks, and Chunky keeps vanilla's going.
    fn paused(mut self) -> bool {
        // `pauseWhenEmptySeconds() * 20` and `emptyTicks++`, in Java's ints, which wrap.
        let threshold = self.pause_when_empty.wrapping_mul(20)
        if threshold <= 0 {
            return false
        }
        if self.players_online() == 0 and self.pregens.is_empty() {
            self.empty_ticks = self.empty_ticks.wrapping_add(1)
        } else {
            self.empty_ticks = 0
        }
        if self.empty_ticks < threshold {
            return false
        }
        if self.empty_ticks == threshold {
            self.logs.push(Entry.info("Server empty for {self.pause_when_empty} seconds, pausing"))
            self.autosave()
        }
        return true
    }

    // The server's part of a tick, as `tickChildren` runs it: the functions (D567); the clocks;
    // every 20 ticks the
    // players told the game time; each level's tick, in the world's order; the pregen tasks'
    // steps; the connections; the players' latency every 601 ticks; then each player is sent the
    // chunks that are due, in the world phase.
    fn tick_children(mut self, now: u64) {
        self.tick_functions()
        self.world.clocks.tick(self.world.advance_time)
        if self.ticks % 20 == 0 {
            let time = encode_play(ClientboundSetTime { game_time: self.world.game_time, clocks: [] })
            self.broadcast(time)
            self.forget_logins(now)
        }
        for d in 0..self.levels.len() {
            self.tick_level(d)
            // What the codec threads have encoded goes as the tick goes on (D576).
            self.send_encoded()
        }
        self.pregen_tick(now)
        self.level_lines()
        self.dispatch_all()
        self.tick_connections(now)
        self.travel()
        self.tick_player_list()
        self.send_encoded()
        // The world phase: each region in turn, by ID, and its players by entity ID, once the
        // layout's been worked out from where everyone is now.
        self.lay_out()
        for r in 0..self.layout.regions.len() {
            for i in 0..self.layout.regions[r].slots.len() {
                let slot = self.layout.regions[r].slots[i]
                var con = self.connections[slot].take() else continue
                self.send_chunks(mut con)
                self.connections[slot] = some(con)
            }
        }
        // The far chunks the players' senders came to are read.
        self.dispatch_all()
    }

    // A level's tick, as `ServerLevel.tick` runs it, of what Calcite has so far (CAL-105): a new
    // tick of its environment's attributes; its border, then its weather, if it can have any;
    // the night passed where enough of its players sleep (D574); its sky's light, as
    // `updateSkyBrightness` sets it (D313); its time, the Overworld's, as `tickTime` moves the
    // game time on; then its chunks, as its `ServerChunkCache.tick` runs them, with the custom
    // spawners (D314); its block events, entities and block entities; and last its entity
    // chunks, loaded, unloaded and saved (CAL-148). Raids come with what they tick.
    fn tick_level(mut self, d: usize) {
        // The world's jukebox songs, for its jukeboxes to play, once its registries are read
        // (CAL-143).
        if not self.songs_given {
            self.give_songs()
        }
        // The random sequences, which what it drops draws from (CAL-153).
        self.sequences_to(d)
        // `handlingTick`, from the tick's start until its block events have run (CAL-125).
        self.levels[d].handling = true
        if let r = self.reseed {
            let (at, base) = r
            if self.world.game_time >= at and d < self.reseeded.len() and not self.reseeded[d] {
                self.reseeded[d] = true
                let seed = level_random_seed(base, self.world.dims[d].id)
                self.levels[d].set_seed(seed)
                self.world.dims[d].block_random.value = i32.wrap(seed)
            }
        }
        // What the level's random draws is at the game time as it is, which the Overworld's
        // moves on partway, as vanilla's `getGameTime` gives it.
        self.levels[d].set_random_time(self.world.game_time)
        self.world.dims[d].environment.invalidate()
        // What a block set tells the blocks around reads, once natural spawning's block facts
        // are made (D326), given before the time moves on, so the spawn's chunks, which came to
        // tick at the server's start, are post-processed at the game time vanilla does it (D329).
        self.give_env(d)
        self.world.dims[d].border.tick()
        if self.world.dims[d].weathered {
            var random = self.levels[d].lend_random()
            let events = advance_weather(mut self.world.weather, mut self.world.dims[d].weather, mut random, self.world.advance_weather)
            self.levels[d].give_back_random(random)
            for e in events {
                let packet = encode_play(ClientboundGameEvent { event: e.event, param: e.param })
                if e.everyone {
                    self.broadcast(packet)
                } else {
                    self.broadcast_in(d, packet)
                }
            }
        }
        // The night passed where enough sleep (D574). Then the sky's light, from the clocks as this
        // tick has them.
        self.sleep_through_night(d)
        self.world.dims[d].update_sky_brightness(self.world.clocks)
        // Only the Overworld's level ticks the time, as `createLevels` makes only its level with
        // `tickTime`, and the others' game time is its.
        if d == 0 {
            self.world.game_time += 1
            // Each level's, and what its random draws is at from now, as `getGameTime` gives each
            // level the Overworld's, so what the functions below draw is at the new time (D570).
            for l in 0..self.levels.len() {
                self.levels[l].game_time = self.world.game_time
                self.levels[l].set_random_time(self.world.game_time)
            }
            // Then the functions `schedule` has due, as `tickTime` runs them (D569).
            let now = self.world.game_time
            self.tick_schedule(now)
        }
        self.levels[d].set_random_time(self.world.game_time)
        // Lava's tick delay, as `LavaFluid.isFastLava` reads it from the dimension (D324).
        let fast = self.world.dims[d].environment.flag(fast_lava(), self.world.clocks, self.world.dims[d].weather.rain_level(), self.world.dims[d].weather.thunder_level())
        self.levels[d].lava_delay = if fast { 10 } else { 30 }
        self.levels[d].fast_lava = fast
        // Whether it's the End, and whether portals may take what's in it, as its entities' end
        // gateways ask (D594).
        self.levels[d].the_end = self.dim_is(d, "the_end")
        self.levels[d].portals_closed = self.dim_is(d, "the_nether") and not self.world.nether_portals
        // What the level's block ticks read of it this tick, random and scheduled (D338, D339).
        self.levels[d].place = self.tick_place(d)
        // The block ticks due, then the fluid ticks, as `ServerLevel.tick` runs them once the
        // time's moved on (D322): each block's tick as its class has it (D335), and water and
        // lava flow (D328).
        self.levels[d].run_block_ticks()
        self.levels[d].run_fluid_ticks()
        self.make_drops(d)
        self.send_level_events(d)
        // The chunk source's tick: its tickets, then `tickChunks`, with the blocks set as the
        // chunks ticked broadcast after (D321), then what unloads.
        self.levels[d].tick_tickets()
        self.tick_chunks(d)
        self.make_drops(d)
        self.send_level_events(d)
        self.broadcast_changes(d)
        self.track_players(d)
        // The chunk map's tick: the points of interest changed written and the distances to
        // villages run, `poiManager.tick` (CAL-160), then what unloads.
        self.levels[d].tick_pois()
        self.levels[d].tick_unload()
        // The chunks changed in play saved soon after, as `processUnloads` ends with
        // `saveChunksEagerly` (CAL-145).
        self.levels[d].save_eagerly(i64.wrap(self.now / 1000000), false)
        // The block events, `runBlockEvents`, each sent as it runs with what it did, then the
        // tick's handled; entities, which come with them, and then the block entities,
        // `tickBlockEntities` (CAL-125).
        self.levels[d].run_block_events()
        // Those near each bell rung hear it as its block entity takes the event (CAL-160).
        let now = self.levels[d].game_time
        for (bx, by, bz) in self.levels[d].take_rung() {
            var heard = self.take_entities(d)
            heard.list.hear_bell(bx, by, bz, now)
            self.put_entities(d, heard)
        }
        self.levels[d].handling = false
        self.make_drops(d)
        self.send_level_events(d)
        // `hasActiveTickets` (D621): where a ticket in it keeps it ticking,
        // `shouldKeepDimensionActive`, a player's, a forced chunk's, a portal's or an ender
        // pearl's, its empty time's none, `resetEmptyTime`; then it's a tick more, and only under
        // 300 ticks does its dragon fight tick, before its entities (D586), then its entities and
        // its block entities.
        if self.levels[d].dm.tickets.keeps_dimension_active() {
            self.levels[d].empty_time = 0
        }
        self.levels[d].empty_time = self.levels[d].empty_time.wrapping_add(1)
        if self.levels[d].empty_time < EMPTY_TICKS {
            self.tick_dragon_fight(d)
            self.tick_players(d)
            self.levels[d].tick_block_entities()
        }
        self.make_drops(d)
        self.send_level_events(d)
        // `entityManager.tick` (CAL-148).
        self.tick_entity_chunks(d)
    }

    // `EnderDragonFight.tick` of the level `d`'s, where its dimension has one (D586, D624, D625):
    // its boss bar shown where its dragon isn't killed, `setVisible`; every 20 ticks, its players
    // looked for, `updatePlayers`, those in it alive within 192 of 0, 128, 0, `validPlayer`, the
    // bar shown to them and taken from those it was shown to that aren't; while it's shown to
    // any, a `dragon` ticket 9 about chunk 0, 0, and once its arena's loaded, `isArenaLoaded`,
    // its state scanned where it's to be, `scanState`, its arena's chunks read; its respawn said
    // to be missing where it has one; and where its dragon isn't killed, its dragon found or made
    // and its crystals counted, `fight_dragon_tick` (D626); while it's shown to none, its ticket's
    // taken away. An arena whose chunks aren't all full as it scans, which the tick's wait didn't
    // see coming, `fights_wait`, as when a player came into the level in another's tick, is
    // scanned the next tick, as they're read.
    fn tick_dragon_fight(mut self, d: usize) {
        var fight = self.world.dims[d].fight.take() else return
        var sent = List<BossSent>()
        fight.show_bar(mut sent)
        fight.since_scan += 1
        if fight.since_scan >= PLAYER_SCANS {
            fight.update_players(self.fight_players(d), mut sent)
            fight.since_scan = 0
        }
        self.send_boss(sent)
        if not fight.has_players() {
            self.levels[d].let_go_dragon()
        } else {
            self.levels[d].load_dragon()
            if self.levels[d].arena_loaded() {
                if fight.scanning {
                    if not self.levels[d].arena_read() {
                        self.world.dims[d].fight = some(fight)
                        return
                    }
                    self.scan_fight(d, mut fight)
                    fight.scanning = false
                    fight.dirty = true
                }
                if fight.respawn_stage != none {
                    self.levels[d].unimplemented(String("A dragon fight's respawn of its dragon"))
                }
                if not fight.killed {
                    self.fight_dragon_tick(d, mut fight)
                }
            }
        }
        self.world.dims[d].fight = some(fight)
    }

    // Whether a dragon fight that scans its arena this tick has a chunk of it that isn't full,
    // which holds the server's tick, as vanilla's thread waits on the chunks its scan reads,
    // `getChunk` (D625): each fight that's to scan, `needsStateScanning`, whose level ticks it,
    // its empty time under 300 once it's counted, whose boss bar's shown to someone once it's
    // looked for its players where it's to look, and whose arena's loaded; those chunks asked
    // for, and, where any's waiting, the levels settle, as the main-thread tasks run while it
    // waits.
    fn fights_wait(mut self) -> bool {
        var waiting = false
        for d in 0..self.world.dims.len() {
            if d >= self.levels.len() {
                continue
            }
            let (scanning, looks, shown) = match self.world.dims[d].fight {
                some(f) => (f.scanning, f.since_scan + 1 >= PLAYER_SCANS, f.has_players()),
                none => (false, false, false),
            }
            if not scanning {
                continue
            }
            let empty = if self.levels[d].dm.tickets.keeps_dimension_active() { 1 } else { self.levels[d].empty_time.wrapping_add(1) }
            if empty >= EMPTY_TICKS {
                continue
            }
            let has_players = if looks { not self.fight_players(d).is_empty() } else { shown }
            if not has_players or not self.levels[d].arena_loaded() {
                continue
            }
            if not self.levels[d].arena_read() {
                waiting = true
            }
        }
        if waiting {
            self.set_in_tick(false)
            self.settle_between()
            self.set_in_tick(true)
        }
        return waiting
    }

    // `scanState` of the level `d`'s dragon fight `fight`, its arena's chunks read (D625), each
    // step logged as vanilla logs it: an end portal anywhere in its arena, `hasActiveExitPortal`,
    // means its dragon's been killed before; else it hasn't, and where the exit portal's pattern
    // isn't found, `findExitPortal`, the portal's made, inactive, `spawnExitPortal(false)`, its
    // place kept where it hadn't one. Then the first ender dragon alive in the level, where
    // there's one, is its dragon, not killed, unless there was no end portal, when it's taken
    // away, `discard`, and it has none; with none alive, its dragon's killed, but where it wasn't
    // killed before. Marked to be saved.
    fn scan_fight(mut self, d: usize, fight: mut DragonFight) {
        self.logs.push(Entry.info(String("Scanning for legacy world dragon fight...")))
        let active = self.levels[d].arena_end_portal()
        if active {
            self.logs.push(Entry.info(String("Found that the dragon has been killed in this world already.")))
            fight.previously_killed = true
        } else {
            self.logs.push(Entry.info(String("Found that the dragon has not yet been killed in this world.")))
            fight.previously_killed = false
            match self.levels[d].find_exit_portal() {
                some(at) => {
                    if fight.exit_portal == none {
                        fight.exit_portal = some(at)
                        fight.dirty = true
                    }
                },
                none => {
                    let had = fight.exit_portal
                    let at = self.levels[d].spawn_exit_portal(had, false)
                    if had == none {
                        fight.exit_portal = some(at)
                        fight.dirty = true
                    }
                },
            }
        }
        var es = self.take_entities(d)
        let dragons = es.list.alive_dragons()
        if dragons.is_empty() {
            fight.killed = true
        } else {
            let dragon = dragons[0].copy()
            let id = dragon.living.body.id
            let (most, least) = dragon.living.body.uuid
            fight.dragon = some(Uuid.new(most, least))
            self.logs.push(Entry.info("Found that there's a dragon still alive ({self.dragon_described(dragon)})"))
            fight.killed = false
            if not active {
                self.logs.push(Entry.info(String("But we didn't have a portal, let's remove it.")))
                es.list.remove(id)
                _ = es.list.take_gone()
                _ = es.tracked.remove(id)
                if let tr = es.trackers.remove(id) {
                    self.send_to_seen(tr.seen_by, encode_play(ClientboundRemoveEntities { entity_ids: [id] }))
                }
                fight.dragon = none
            }
        }
        self.put_entities(d, es)
        if not fight.previously_killed and fight.killed {
            fight.killed = false
        }
        fight.dirty = true
    }

    // What the level `d`'s dragon fight `fight`, whose dragon isn't killed, does each tick its
    // arena's loaded (D626): where it has no dragon, or a count since its dragon last told it it
    // was seen that comes to 1200, `findOrCreateDragon`, the first ender dragon alive in its level
    // its dragon, else a new one made, `createNewDragon`, the count none again; and every 100 ticks
    // its end crystals counted, `updateCrystalCount`.
    fn fight_dragon_tick(mut self, d: usize, fight: mut DragonFight) {
        var unseen = fight.dragon == none
        if not unseen {
            fight.since_seen += 1
            unseen = fight.since_seen >= UNSEEN_TICKS
        }
        if unseen {
            let es = self.take_entities(d)
            let dragons = es.list.alive_dragons()
            self.put_entities(d, es)
            if dragons.is_empty() {
                self.create_new_dragon(d, mut fight)
            } else {
                let (most, least) = dragons[0].living.body.uuid
                fight.dragon = some(Uuid.new(most, least))
                fight.dirty = true
            }
            fight.since_seen = 0
        }
        fight.since_crystals += 1
        if fight.since_crystals >= CRYSTAL_SCANS {
            fight.alive_crystals = self.crystals_alive(d)
            fight.since_crystals = 0
        }
    }

    // `EnderDragonFight.createNewDragon` in the level `d` for its fight `fight` (D626): an ender
    // dragon as its constructor makes it, `EntityType.create`, its ID and its eight parts' next,
    // each with its random's seed, turned as its own random drew; given the fight and set to hold
    // its pattern, `HOLDING_PATTERN`; put at 0, 128, 0 turned as the level's random draws, a float
    // times 360, `snapTo`; added, `addFreshEntity`; and its UUID the fight's dragon's. Its chunk's
    // full, as its arena is, so `getChunkAt` waits on nothing. Where Calcite hasn't the mobs' facts
    // it's said to be missing.
    fn create_new_dragon(mut self, d: usize, fight: mut DragonFight) {
        if not self.items_ready() or not self.living_ready(d) or not self.mob_facts_ready() {
            self.levels[d].unimplemented(String("A dragon fight's new dragon without the mobs' facts"))
            return
        }
        let kind = u32.wrap(self.entity_type(type_name(ENDER_DRAGON)))
        let lf = self.living_facts.take() else return
        let facts = self.mob_facts.take() else {
            self.living_facts = some(lf)
            return
        }
        self.entity_ids += 1
        let id = self.entity_ids
        let seed = self.entity_seed(id)
        for _ in 0..8 {
            self.entity_ids += 1
            let part = self.entity_ids
            _ = self.entity_seed(part)
        }
        var dragon = Mob.made(lf, facts, ENDER_DRAGON, kind, id, seed, 0.0, 0.0, 0.0)
        self.living_facts = some(lf)
        self.mob_facts = some(facts)
        dragon.set_dragon_fight()
        dragon.set_dragon_phase(HOLDING_PATTERN)
        var r = self.levels[d].lend_random()
        let turn = r.next_float() * 360.0f32
        self.levels[d].give_back_random(r)
        dragon.living.snap_to(0.0, 128.0, 0.0, turn, 0.0f32)
        let (most, least) = dragon.living.body.uuid
        self.add_mob(d, dragon)
        fight.dragon = some(Uuid.new(most, least))
        fight.dirty = true
    }

    // The end crystals alive on the level `d`'s spikes, `updateCrystalCount` (D626): those whose
    // boxes meet each spike's top box, across it and the whole of any level's height, for the
    // world's seed, `getSpikesForLevel`, summed.
    fn crystals_alive(mut self, d: usize) -> i32 {
        let es = self.take_entities(d)
        var n = 0
        for (x, z, radius) in spike_tops(self.world.seed) {
            let b = Aabb { min_x: f64(x - radius), min_y: LOWEST, min_z: f64(z - radius), max_x: f64(x + radius), max_y: HIGHEST, max_z: f64(z + radius) }
            n += es.list.crystals_in(b)
        }
        self.put_entities(d, es)
        return n
    }

    // `Entity.toString` of the ender dragon `m`, as vanilla logs it (D625): its class, its name,
    // the one it's given or its type's, its ID, its level and where it is, to two places.
    fn dragon_described(self, m: Mob) -> String {
        let name = match custom_name_of(m.living) {
            some(c) => c.get_string(self.lang),
            none => Component.translatable(String("entity.minecraft.ender_dragon"), List<Component>()).get_string(self.lang),
        }
        let b = m.living.body.copy()
        return "EnderDragon['{name}'/{b.id}, l='ServerLevel[{self.level_name}]', x={format_fixed(b.x, 2)}, y={format_fixed(b.y, 2)}, z={format_fixed(b.z, 2)}]"
    }

    // The players of the level `d` its dragon fight finds, `validPlayer` (D586): alive, within
    // `ARENA_REACH` of 0, 128, 0, in their order, as its boss bar has them (D624).
    fn fight_players(self, d: usize) -> List<BarViewer> {
        var out = List<BarViewer>()
        for slot in self.connections {
            let c = slot else continue
            if not in_world(c) or c.player.removed or c.player.dim != d or not player_alive(c) {
                continue
            }
            let p = c.profile else continue
            let (dx, dy, dz) = (c.player.x, c.player.y - 128.0, c.player.z)
            if dx * dx + dy * dy + dz * dz <= ARENA_REACH * ARENA_REACH {
                out.push(BarViewer { entity: c.player.entity_id, serial: c.player.serial, profile: p.copy() })
            }
        }
        return out
    }

    // The slots of the players in the level `d` a beacon's pulse `p` reaches, `pulse_near`, in
    // their order (D520).
    fn pulse_slots(mut self, d: usize, p: BeaconPulse) -> List<usize> {
        let height = f64(self.world.dims[d].height)
        var near = List<usize>()
        for i in 0..self.connections.len() {
            if not self.playing(i) {
                continue
            }
            let c = self.connections[i].take() else continue
            if pulse_near(c, d, p, height) {
                near.push(i)
            }
            self.connections[i] = some(c)
        }
        return near
    }

    // A beacon come on at `p` in the level `d` (CAL-164): `CONSTRUCT_BEACON` of its levels for
    // each player it finds, `lit_near`, in their order.
    fn beacon_lit(mut self, d: usize, p: BeaconPulse) {
        for i in 0..self.connections.len() {
            if not self.playing(i) {
                continue
            }
            var other = self.connections[i].take() else continue
            if lit_near(other, d, p) {
                self.beacon_constructed(mut other, p.levels)
            }
            self.connections[i] = some(other)
        }
    }

    // The effect `e` given the player in the slot `slot`, `effect_player` (D520).
    fn give_slot_effect(mut self, slot: usize, e: ActiveEffect) {
        let held = self.connections[slot].take() else return
        var con = held
        _ = self.effect_player(mut con, e)
        self.connections[slot] = some(con)
    }

    // `ChunkMap.tick`'s trackers, in its map's order (CAL-148): each one whose entity's in another
    // section than it last saw looks again at who sees it, and runs where it moved so, where its
    // entity needs syncing, or where its chunk ticks entities; then, where players moved to
    // another section, each tracker looks whether they see its entity, a player's too (CAL-174).
    // A tracker sends what `world.item_tracker` says; a player's sends them too what of their
    // entity data changed (CAL-141), then of their attributes, as `sendDirtyEntityData` sends
    // them, every second time it runs, a player's `updateInterval`, from when they came into the
    // level, or at once where their data changed (D375).
    fn track_players(mut self, d: usize) {
        let es = self.take_entities(d)
        var order = List<(i32, bool)>()
        for (id, player) in es.tracked {
            order.push((id, player))
        }
        self.put_entities(d, es)
        var moved = List<i32>()
        for (id, player) in order {
            if player {
                if self.track_player(d, id) {
                    moved.push(id)
                }
            } else {
                self.track_item(d, id)
            }
        }
        if moved.is_empty() {
            return
        }
        for (id, player) in order {
            if player {
                self.player_sees_moved(d, id, moved)
                continue
            }
            for p in moved {
                let slot = self.slot_of_entity(p) else continue
                var con = self.connections[slot].take() else continue
                self.item_sees(d, id, mut con)
                self.connections[slot] = some(con)
            }
        }
    }

    // `updatePlayers` of the player `id`'s tracker in the level `d` for the players who moved to
    // another section, `movedPlayers`, by their entity IDs (CAL-174).
    fn player_sees_moved(mut self, d: usize, id: i32, moved: List<i32>) {
        let slot = self.slot_of_entity(id) else return
        let target = self.connections[slot].take() else return
        var es = self.take_entities(d)
        let kept = es.trackers.remove(id)
        self.put_entities(d, es)
        if let t = kept {
            var tr = t
            for p in moved {
                let other = self.slot_of_entity(p) else continue
                var viewer = self.connections[other].take() else continue
                self.player_seen(mut tr, target, mut viewer)
                self.connections[other] = some(viewer)
            }
            var back = self.take_entities(d)
            back.trackers.insert(id, tr)
            self.put_entities(d, back)
        }
        self.connections[slot] = some(target)
    }

    // A player's tracker in the level `d`, by their entity ID (CAL-174): where they're in another
    // section than it last saw them in, it looks again at which of the level's players see them;
    // then it runs where they moved so, are to be synced, `needsSync`, or their chunk ticks
    // entities. Whether they moved so.
    fn track_player(mut self, d: usize, id: i32) -> bool {
        let slot = self.slot_of_entity(id) else return false
        var con = self.connections[slot].take() else return false
        var moved = false
        if in_world(con) and con.player.dim == d {
            var es = self.take_entities(d)
            let kept = es.trackers.remove(id)
            self.put_entities(d, es)
            if let t = kept {
                var tr = t
                let now = (section(con.player.x), section(con.player.y), section(con.player.z))
                let (sx, sy, sz) = now
                let (ox, oy, oz) = tr.section
                moved = sx != ox or sy != oy or sz != oz
                if moved {
                    tr.section = now
                    for other in self.level_slots(d) {
                        var viewer = self.connections[other].take() else continue
                        self.player_seen(mut tr, con, mut viewer)
                        self.connections[other] = some(viewer)
                    }
                }
                if moved or con.player.needs_sync or self.levels[d].entity_ticking(ChunkPos { x: sx, z: sz }) {
                    self.player_changes(mut tr, mut con)
                }
                var back = self.take_entities(d)
                back.trackers.insert(id, tr)
                self.put_entities(d, back)
            }
        }
        self.connections[slot] = some(con)
        return moved
    }

    // `sendChanges` of the player's tracker `tr` (CAL-174), as a living entity's runs: what it
    // says goes to those who see them; their values and attributes that changed go to them too,
    // `sendToTrackingPlayersAndSelf`, as does their motion where a hurt marked it,
    // `syncVelocity` (D418). Their place's synced where a bounce of the server's move of them
    // says so, `syncPosition`.
    fn player_changes(mut self, tr: mut Tracker, con: mut Connection) {
        self.player_effects_shown(mut con)
        let id = con.player.entity_id
        var b = tracked_body(con)
        if let kept = con.player.body.take() {
            var l = kept
            b.sync_position = l.body.sync_position
            l.body.sync_position = false
            con.player.body = some(l)
        }
        let dirty = con.player.entity_data.is_dirty()
        var out = List<Sent>()
        tr.send_living_changes(mut b, dirty, con.player.y_head_rot, mut out)
        con.player.needs_sync = b.needs_sync
        con.player.sync_velocity = b.sync_velocity
        for s in out {
            match s {
                Sent.Dirty => {
                    if let packed = con.player.entity_data.pack_dirty() {
                        tr.values = con.player.entity_data.pack_non_default()
                        let packet = encode_play(ClientboundSetEntityData { entity_id: id, items: packed })
                        self.send_to_seen(tr.seen_by, packet.copy())
                        self.send_bytes(mut con, packet)
                    }
                    let changed = con.player.attributes.take_synced()
                    if not changed.is_empty() {
                        let packet = encode_play(attributes_packet(id, changed))
                        self.send_to_seen(tr.seen_by, packet.copy())
                        self.send_bytes(mut con, packet)
                    }
                },
                Sent.Velocity(x, y, z) => {
                    let packet = encode_play(ClientboundSetEntityMotion { entity_id: id, motion: lp_vec3_bytes(x, y, z) })
                    self.send_to_seen(tr.seen_by, packet.copy())
                    self.send_bytes(mut con, packet)
                },
                _ => {
                    let packet = self.sent_packet(id, s)
                    self.send_to_seen(tr.seen_by, packet)
                },
            }
        }
    }

    // `updatePlayer` of the player `target`'s tracker for the player `viewer` (CAL-174), as an
    // item's, where `broadcastToPlayer` lets them: a spectator sees every player, and no one
    // else sees a spectator. Coming to see them, the viewer's sent them, `addPairing`.
    fn player_seen(mut self, tr: mut Tracker, target: Connection, viewer: mut Connection) {
        if viewer.player.entity_id == target.player.entity_id {
            return
        }
        let shown = viewer.player.mode == GameType.Spectator or target.player.mode != GameType.Spectator
        if self.comes_to_see_if(mut tr, tracked_body(target), mut viewer, shown) {
            self.pair_player(mut viewer, tr, target)
        }
    }

    // `addPairing` of the player `target` (CAL-174), as a living entity's: their `add_entity`
    // from their tracker, of the player type; their values as they were last sent, where any
    // aren't their defaults; their attributes that are sent to clients; and what they hold and
    // wear, by slot, `getItemBySlot`.
    fn pair_player(mut self, con: mut Connection, tr: Tracker, target: Connection) {
        let id = target.player.entity_id
        let kind = self.entity_type("minecraft:player")
        let body = tr.add_entity_body(tracked_body(target), kind)
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
        self.send(mut con, ClientboundAddEntity { entity_id: id, body: body }, State.Play)
        if let values = tr.values {
            self.send(mut con, ClientboundSetEntityData { entity_id: id, items: values.copy() }, State.Play)
        }
        let attributes = target.player.attributes.syncable()
        if not attributes.is_empty() {
            self.send(mut con, attributes_packet(id, attributes), State.Play)
        }
        var worn = List<WornSlot>()
        for slot in 0usize..8usize {
            if let stack = worn_in(target, slot) {
                worn.push(WornSlot { slot: i32.wrap(slot), stack: self.sent_stack(some(stack)) })
            }
        }
        if not worn.is_empty() {
            self.send(mut con, ClientboundSetEquipment { entity_id: id, slots: WornSlots { slots: worn } }, State.Play)
        }
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
    }

    // What the locator bar asks of each player in the level `d` (CAL-174), the player `con`,
    // taken out of the connections, among them.
    fn beacons(self, d: usize, con: Connection) -> List<Beacon> {
        var out = List<Beacon>()
        for slot in self.level_slots(d) {
            if let c = self.connections[slot] {
                out.push(beacon_of(c, self.waypoint_color(c)))
            }
        }
        if con.player.dim == d {
            out.push(beacon_of(con, self.waypoint_color(con)))
        }
        return out
    }

    // Sends what the locator bar told each of its receivers, the player `con` among them
    // (CAL-174).
    fn tell_waypoints(mut self, told: List<Told>, con: mut Connection) {
        for t in told {
            let packet = encode_play(ClientboundWaypoint { operation: t.operation, body: t.body.copy() })
            self.send_to_seen_with([t.receiver], packet, mut con)
        }
    }

    // `setPosRaw`'s locator bar where the player's place changed from `was` (CAL-174): past
    // their first tick and while they aren't removed, their waypoint's links looked at again
    // where they transmit one, `updateWaypoint`, then their own where they receive them,
    // `updatePlayer`.
    fn moved_from(mut self, con: mut Connection, was: (f64, f64, f64)) {
        let (x, y, z) = was
        if x == con.player.x and y == con.player.y and z == con.player.z {
            return
        }
        if not con.player.based or con.player.removed {
            return
        }
        let me = beacon_of(con, self.waypoint_color(con))
        let d = con.player.dim
        let bs = self.beacons(d, con)
        let bar = self.world.locator_bar
        var es = self.take_entities(d)
        var out = List<Told>()
        if transmits(me) {
            es.waypoints.update_waypoint(me.id, bs, bar, mut out)
        }
        if receives(me) {
            es.waypoints.update_player(me.id, bs, bar, mut out)
        }
        self.put_entities(d, es)
        self.tell_waypoints(out, mut con)
    }

    // `ServerChunkCache.move`'s locator bar (CAL-174): the player's links looked at again where
    // they receive waypoints and aren't removed, `updatePlayer`.
    fn waypoints_seek(mut self, con: mut Connection) {
        let me = beacon_of(con, self.waypoint_color(con))
        if con.player.removed or not receives(me) {
            return
        }
        let d = con.player.dim
        let bs = self.beacons(d, con)
        let bar = self.world.locator_bar
        var es = self.take_entities(d)
        var out = List<Told>()
        es.waypoints.update_player(me.id, bs, bar, mut out)
        self.put_entities(d, es)
        self.tell_waypoints(out, mut con)
    }

    // `onCreated`'s locator bar (D577): the waypoint the player transmits tracked, where they
    // transmit one.
    fn waypoints_created(mut self, con: mut Connection) {
        let me = beacon_of(con, self.waypoint_color(con))
        if not transmits(me) {
            return
        }
        let d = con.player.dim
        let bs = self.beacons(d, con)
        let bar = self.world.locator_bar
        var es = self.take_entities(d)
        var out = List<Told>()
        es.waypoints.track(me.id, bs, bar, mut out)
        self.put_entities(d, es)
        self.tell_waypoints(out, mut con)
    }

    // The path the tracker of the entity `id` in the level `d` has kept, where it has one (D577).
    fn tracker_path(self, d: usize, id: i32) -> (List<PathStep>, i32)? {
        if let es = self.entities[d] {
            if es.trackers.contains(id) {
                return some(es.trackers[id].path())
            }
        }
        return none
    }

    // `onTrackingStart`'s locator bar (CAL-174): the player receives waypoints where they may,
    // `addPlayer`, which tracks their own where they transmit one, as `onTrackingStart` then
    // does again.
    fn waypoints_enter(mut self, con: mut Connection) {
        let me = beacon_of(con, self.waypoint_color(con))
        let d = con.player.dim
        let bs = self.beacons(d, con)
        let bar = self.world.locator_bar
        var es = self.take_entities(d)
        var out = List<Told>()
        if receives(me) {
            es.waypoints.add_player(me.id, bs, bar, mut out)
        }
        if transmits(me) {
            es.waypoints.track(me.id, bs, bar, mut out)
        }
        self.put_entities(d, es)
        self.tell_waypoints(out, mut con)
    }

    // `onTrackingEnd`'s locator bar (CAL-174): the player `id` out of the level `d`'s,
    // `removePlayer`, what that tells for the caller to send.
    fn waypoints_leave(mut self, d: usize, id: i32) -> List<Told> {
        var es = self.take_entities(d)
        var out = List<Told>()
        es.waypoints.remove_player(id, mut out)
        self.put_entities(d, es)
        return out
    }

    // `refreshDirtyAttributes` of the player at their tick's end (CAL-174): each attribute made or
    // changed since it last ran, `onAttributeUpdated`, of which their waypoint ranges come to
    // the locator bar: past nothing, the waypoint they transmit is tracked, `trackWaypoint`,
    // linking each receiver to it anew, and they receive waypoints, `addPlayer`; else they stop.
    // Made, an instance is changed, `replaceFrom`, so a player's waypoint is tracked again once
    // `updatePlayerAttributes` first makes its range, past their first tick. Not while they're
    // out of their level.
    fn waypoint_ranges(mut self, con: mut Connection) {
        let updated = con.player.attributes.take_updated()
        if con.player.removed {
            return
        }
        let transmit = attribute_id(String("waypoint_transmit_range")) ?? 0
        let receive = attribute_id(String("waypoint_receive_range")) ?? 0
        if not updated.contains(transmit) and not updated.contains(receive) {
            return
        }
        let me = beacon_of(con, self.waypoint_color(con))
        let d = con.player.dim
        let bs = self.beacons(d, con)
        let bar = self.world.locator_bar
        var es = self.take_entities(d)
        var out = List<Told>()
        for a in updated {
            if a == transmit {
                if transmits(me) {
                    es.waypoints.track(me.id, bs, bar, mut out)
                } else {
                    es.waypoints.untrack(me.id, mut out)
                }
            } else if a == receive {
                if receives(me) {
                    es.waypoints.add_player(me.id, bs, bar, mut out)
                } else {
                    es.waypoints.remove_player(me.id, mut out)
                }
            }
        }
        self.put_entities(d, es)
        self.tell_waypoints(out, mut con)
    }

    // `sendToTrackingPlayersAndSelf` of a packet about the player (CAL-174): to those who see
    // them, then to them.
    fn send_seen_and_self(mut self, con: mut Connection, packet: own List<u8>) {
        let seen = self.seers_of(con)
        self.send_to_seen(seen, packet.copy())
        self.send_bytes(mut con, packet)
    }

    // Those who see the player, by their entity IDs, as their tracker has them (CAL-174).
    fn seers_of(mut self, con: Connection) -> List<i32> {
        let d = con.player.dim
        let id = con.player.entity_id
        let es = self.take_entities(d)
        let seen = if es.trackers.contains(id) { es.trackers[id].seen_by.copy() } else { List<i32>() }
        self.put_entities(d, es)
        return seen
    }

    // `handleHandSwap` and `handleEquipmentChanges` of the player (CAL-174): where their hands
    // swapped, those who see them are told, `ClientboundEntityEventPacket` 55, and of the rest
    // of what changed, each slot with its stack now, `ClientboundSetEquipmentPacket`. `before` is
    // what they wore and held as it last looked, `lastEquipmentItems`, empty where it wasn't
    // looked at this tick.
    fn equipment_changes(mut self, con: Connection, before: List<Tag?>, swapped: bool) {
        var changed = List<(usize, Tag?)>()
        for slot in 0..before.len() {
            if swapped and slot < 2 {
                continue
            }
            if not same_stack(before[slot].copy(), con.player.worn[slot].copy()) {
                changed.push((slot, con.player.worn[slot].copy()))
            }
        }
        if not swapped and changed.is_empty() {
            return
        }
        let seen = self.seers_of(con)
        let id = con.player.entity_id
        if swapped {
            self.send_to_seen(seen, encode_play(ClientboundEntityEvent { entity_id: id, event: i8.wrap(55) }))
        }
        if not changed.is_empty() {
            let packet = self.equipment_packet(id, changed)
            self.send_to_seen(seen, packet)
        }
    }

    // An item's tracker in the level `d`, by its ID: where the item's in another section, it
    // looks again at which of the level's players see it; then it runs, `sendChanges`, where it
    // moved so, needs syncing or its chunk ticks entities, and what it says goes to those who
    // see it.
    fn track_item(mut self, d: usize, id: i32) {
        var es = self.take_entities(d)
        if es.list.is_orb(id) {
            self.put_entities(d, es)
            self.track_orb(d, id)
            return
        }
        if es.list.is_stand(id) or es.list.is_mob(id) {
            self.put_entities(d, es)
            self.track_stand(d, id)
            return
        }
        if es.list.is_arrow(id) {
            self.put_entities(d, es)
            self.track_arrow(d, id)
            return
        }
        if es.list.is_thrown(id) {
            self.put_entities(d, es)
            self.track_thrown(d, id)
            return
        }
        if es.list.is_cloud(id) {
            self.put_entities(d, es)
            self.track_cloud(d, id)
            return
        }
        if es.list.is_crystal(id) {
            self.put_entities(d, es)
            self.track_crystal(d, id)
            return
        }
        if es.list.is_eye(id) {
            self.put_entities(d, es)
            self.track_eye(d, id)
            return
        }
        if es.list.is_fireball(id) {
            self.put_entities(d, es)
            self.track_fireball(d, id)
            return
        }
        let lent = es.list.lend(id)
        let kept = es.trackers.remove(id)
        self.put_entities(d, es)
        var e = lent else {
            if let t = kept {
                var back = self.take_entities(d)
                back.trackers.insert(id, t)
                self.put_entities(d, back)
            }
            return
        }
        var tr = kept else {
            self.give_item_back(d, e, none)
            return
        }
        let now = section_of(e.body)
        let (sx, sy, sz) = now
        let (ox, oy, oz) = tr.section
        let moved = sx != ox or sy != oy or sz != oz
        if moved {
            tr.section = now
            for slot in self.level_slots(d) {
                var con = self.connections[slot].take() else continue
                self.item_seen(mut tr, e, mut con)
                self.connections[slot] = some(con)
            }
        }
        if moved or e.body.needs_sync or self.levels[d].entity_ticking(ChunkPos { x: sx, z: sz }) {
            var out = List<Sent>()
            let changed: Tag? = if e.stack_changed { some(e.stack.copy()) } else { none }
            e.stack_changed = false
            let flags: i8? = if e.flags_changed { some(e.flags) } else { none }
            e.flags_changed = false
            tr.send_changes(mut e.body, flags, changed, mut out)
            for s in out {
                let packet = self.sent_packet(id, s)
                self.send_to_seen(tr.seen_by, packet)
            }
        }
        self.give_item_back(d, e, some(tr))
    }

    // An orb's tracker, as an item's runs: an orb's value never changes, so it sends none.
    fn track_orb(mut self, d: usize, id: i32) {
        var es = self.take_entities(d)
        let lent = es.list.lend_orb(id)
        let kept = es.trackers.remove(id)
        self.put_entities(d, es)
        var o = lent else {
            if let t = kept {
                var back = self.take_entities(d)
                back.trackers.insert(id, t)
                self.put_entities(d, back)
            }
            return
        }
        var tr = kept else {
            var back = self.take_entities(d)
            back.list.give_back_orb(o)
            self.put_entities(d, back)
            return
        }
        let now = section_of(o.body)
        let (sx, sy, sz) = now
        let (ox, oy, oz) = tr.section
        let moved = sx != ox or sy != oy or sz != oz
        if moved {
            tr.section = now
            for slot in self.level_slots(d) {
                var con = self.connections[slot].take() else continue
                self.orb_seen(mut tr, o, mut con)
                self.connections[slot] = some(con)
            }
        }
        if moved or o.body.needs_sync or self.levels[d].entity_ticking(ChunkPos { x: sx, z: sz }) {
            var out = List<Sent>()
            let changed: Tag? = if o.value_changed { some(Tag.Int(o.value)) } else { none }
            o.value_changed = false
            let flags: i8? = if o.flags_changed { some(o.flags) } else { none }
            o.flags_changed = false
            tr.send_changes(mut o.body, flags, changed, mut out)
            for s in out {
                let packet = self.sent_packet(id, s)
                self.send_to_seen(tr.seen_by, packet)
            }
        }
        var es2 = self.take_entities(d)
        es2.trackers.insert(id, tr)
        es2.list.give_back_orb(o)
        self.put_entities(d, es2)
    }

    // An arrow's tracker, as an item's runs (CAL-159): its values that changed sent where
    // `sendDirtyEntityData` sends them, its values that aren't their defaults then what a player
    // coming to see it is sent.
    fn track_arrow(mut self, d: usize, id: i32) {
        var es = self.take_entities(d)
        let lent = es.list.lend_arrow(id)
        let kept = es.trackers.remove(id)
        self.put_entities(d, es)
        var a = lent else {
            self.keep_tracker(d, id, kept)
            return
        }
        var tr = kept else {
            var back = self.take_entities(d)
            back.list.give_back_arrow(a)
            self.put_entities(d, back)
            return
        }
        let now = section_of(a.body)
        let (sx, sy, sz) = now
        let (ox, oy, oz) = tr.section
        let moved = sx != ox or sy != oy or sz != oz
        if moved {
            tr.section = now
            for slot in self.level_slots(d) {
                var con = self.connections[slot].take() else continue
                let owner = self.arrow_owner(d, a.owner, con)
                self.arrow_seen(mut tr, a, owner, mut con)
                self.connections[slot] = some(con)
            }
        }
        if moved or a.body.needs_sync or a.body.sync_velocity or self.levels[d].entity_ticking(ChunkPos { x: sx, z: sz }) {
            var out = List<Sent>()
            let dirty = a.data.is_dirty()
            tr.send_arrow_changes(mut a.body, dirty, mut out)
            for s in out {
                match s {
                    Sent.Dirty => {
                        if let packed = a.data.pack_dirty() {
                            tr.values = a.data.pack_non_default()
                            self.send_to_seen(tr.seen_by, encode_play(ClientboundSetEntityData { entity_id: id, items: packed }))
                        }
                    },
                    _ => {
                        let packet = self.sent_packet(id, s)
                        self.send_to_seen(tr.seen_by, packet)
                    },
                }
            }
        }
        var after = self.take_entities(d)
        after.trackers.insert(id, tr)
        after.list.give_back_arrow(a)
        self.put_entities(d, after)
    }

    // A thrown potion's tracker, as an arrow's runs (D527): its values that changed, its stack
    // among them once it's set, `thrown_dirty`, then what a player coming to see it is sent, its
    // values that aren't their defaults with its stack, `thrown_values`.
    fn track_thrown(mut self, d: usize, id: i32) {
        var es = self.take_entities(d)
        let lent = es.list.lend_thrown(id)
        let kept = es.trackers.remove(id)
        self.put_entities(d, es)
        var p = lent else {
            self.keep_tracker(d, id, kept)
            return
        }
        var tr = kept else {
            var back = self.take_entities(d)
            back.list.give_back_thrown(p)
            self.put_entities(d, back)
            return
        }
        let now = section_of(p.body)
        let (sx, sy, sz) = now
        let (ox, oy, oz) = tr.section
        let moved = sx != ox or sy != oy or sz != oz
        if moved {
            tr.section = now
            for slot in self.level_slots(d) {
                var con = self.connections[slot].take() else continue
                let owner = self.arrow_owner(d, p.owner, con)
                self.thrown_seen(mut tr, p, owner, mut con)
                self.connections[slot] = some(con)
            }
        }
        if moved or p.body.needs_sync or p.body.sync_velocity or self.levels[d].entity_ticking(ChunkPos { x: sx, z: sz }) {
            var out = List<Sent>()
            let dirty = p.data.is_dirty() or p.item_dirty
            tr.send_thrown_changes(mut p.body, dirty, mut out)
            for s in out {
                match s {
                    Sent.Dirty => {
                        if p.data.is_dirty() or p.item_dirty {
                            let base = p.data.pack_dirty()
                            let packed = self.thrown_dirty(base, p.item, p.item_dirty)
                            p.item_dirty = false
                            tr.values = some(self.thrown_values(p.data.pack_non_default(), p.item))
                            self.send_to_seen(tr.seen_by, encode_play(ClientboundSetEntityData { entity_id: id, items: packed }))
                        }
                    },
                    _ => {
                        let packet = self.sent_packet(id, s)
                        self.send_to_seen(tr.seen_by, packet)
                    },
                }
            }
        }
        var after = self.take_entities(d)
        after.trackers.insert(id, tr)
        after.list.give_back_thrown(p)
        self.put_entities(d, after)
    }

    // An eye of ender's tracker, as a thrown potion's runs (D598), but every 4 ticks: its stack
    // among its values, sent where it's to be.
    fn track_eye(mut self, d: usize, id: i32) {
        var es = self.take_entities(d)
        let lent = es.list.lend_eye(id)
        let kept = es.trackers.remove(id)
        self.put_entities(d, es)
        var e = lent else {
            self.keep_tracker(d, id, kept)
            return
        }
        var tr = kept else {
            var back = self.take_entities(d)
            back.list.give_back_eye(e)
            self.put_entities(d, back)
            return
        }
        let now = section_of(e.body)
        let (sx, sy, sz) = now
        let (ox, oy, oz) = tr.section
        let moved = sx != ox or sy != oy or sz != oz
        if moved {
            tr.section = now
            for slot in self.level_slots(d) {
                var con = self.connections[slot].take() else continue
                self.eye_seen(mut tr, e, mut con)
                self.connections[slot] = some(con)
            }
        }
        if moved or e.body.needs_sync or e.body.sync_velocity or self.levels[d].entity_ticking(ChunkPos { x: sx, z: sz }) {
            var out = List<Sent>()
            let dirty = e.data.is_dirty() or e.item_dirty
            tr.send_thrown_changes(mut e.body, dirty, mut out)
            for s in out {
                match s {
                    Sent.Dirty => {
                        if e.data.is_dirty() or e.item_dirty {
                            let base = e.data.pack_dirty()
                            let packed = self.thrown_dirty(base, e.item, e.item_dirty)
                            e.item_dirty = false
                            tr.values = some(self.thrown_values(e.data.pack_non_default(), e.item))
                            self.send_to_seen(tr.seen_by, encode_play(ClientboundSetEntityData { entity_id: id, items: packed }))
                        }
                    },
                    _ => {
                        let packet = self.sent_packet(id, s)
                        self.send_to_seen(tr.seen_by, packet)
                    },
                }
            }
        }
        var after = self.take_entities(d)
        after.trackers.insert(id, tr)
        after.list.give_back_eye(e)
        self.put_entities(d, after)
    }

    // A dragon fireball's tracker, as a thrown potion's runs, every 10 ticks, but with no stack
    // among its values (D618): its motion, as it changes, sent with its acceleration in a bundle,
    // `ClientboundProjectilePowerPacket`, as `sendChanges` sends an accelerating projectile's.
    fn track_fireball(mut self, d: usize, id: i32) {
        var es = self.take_entities(d)
        let lent = es.list.lend_fireball(id)
        let kept = es.trackers.remove(id)
        self.put_entities(d, es)
        var b = lent else {
            self.keep_tracker(d, id, kept)
            return
        }
        var tr = kept else {
            var back = self.take_entities(d)
            back.list.give_back_fireball(b)
            self.put_entities(d, back)
            return
        }
        let now = section_of(b.body)
        let (sx, sy, sz) = now
        let (ox, oy, oz) = tr.section
        let moved = sx != ox or sy != oy or sz != oz
        if moved {
            tr.section = now
            for slot in self.level_slots(d) {
                var con = self.connections[slot].take() else continue
                let owner = self.arrow_owner(d, b.owner, con)
                self.fireball_seen(mut tr, b, owner, mut con)
                self.connections[slot] = some(con)
            }
        }
        if moved or b.body.needs_sync or b.body.sync_velocity or self.levels[d].entity_ticking(ChunkPos { x: sx, z: sz }) {
            var out = List<Sent>()
            let dirty = b.data.is_dirty()
            tr.send_thrown_changes(mut b.body, dirty, mut out)
            for sent in out {
                match sent {
                    Sent.Dirty => {
                        if let packed = b.data.pack_dirty() {
                            tr.values = b.data.pack_non_default()
                            self.send_to_seen(tr.seen_by, encode_play(ClientboundSetEntityData { entity_id: id, items: packed }))
                        }
                    },
                    Sent.Motion(x, y, z) => {
                        self.send_to_seen(tr.seen_by, encode_play(ClientboundBundleDelimiter {}))
                        self.send_to_seen(tr.seen_by, encode_play(ClientboundSetEntityMotion { entity_id: id, motion: lp_vec3_bytes(x, y, z) }))
                        self.send_to_seen(tr.seen_by, encode_play(ClientboundProjectilePower { entity_id: id, power: b.acceleration }))
                        self.send_to_seen(tr.seen_by, encode_play(ClientboundBundleDelimiter {}))
                    },
                    _ => {
                        let packet = self.sent_packet(id, sent)
                        self.send_to_seen(tr.seen_by, packet)
                    },
                }
            }
        }
        var after = self.take_entities(d)
        after.trackers.insert(id, tr)
        after.list.give_back_fireball(b)
        self.put_entities(d, after)
    }

    // An end crystal's tracker, as a cloud's runs (D589): where it needs syncing or its values
    // changed, with its motion sent only where it's to be synced, `dontTrackDeltas`.
    fn track_crystal(mut self, d: usize, id: i32) {
        var es = self.take_entities(d)
        let lent = es.list.lend_crystal(id)
        let kept = es.trackers.remove(id)
        self.put_entities(d, es)
        var c = lent else {
            self.keep_tracker(d, id, kept)
            return
        }
        var tr = kept else {
            var back = self.take_entities(d)
            back.list.give_back_crystal(c)
            self.put_entities(d, back)
            return
        }
        let now = section_of(c.body)
        let (sx, sy, sz) = now
        let (ox, oy, oz) = tr.section
        let moved = sx != ox or sy != oy or sz != oz
        if moved {
            tr.section = now
            for slot in self.level_slots(d) {
                var con = self.connections[slot].take() else continue
                self.crystal_seen(mut tr, c, mut con)
                self.connections[slot] = some(con)
            }
        }
        if moved or c.body.needs_sync or c.body.sync_velocity or self.levels[d].entity_ticking(ChunkPos { x: sx, z: sz }) {
            var out = List<Sent>()
            let dirty = c.data.is_dirty()
            tr.send_thrown_changes(mut c.body, dirty, mut out)
            for sent in out {
                match sent {
                    Sent.Dirty => {
                        if let packed = c.data.pack_dirty() {
                            tr.values = c.data.pack_non_default()
                            self.send_to_seen(tr.seen_by, encode_play(ClientboundSetEntityData { entity_id: id, items: packed }))
                        }
                    },
                    _ => {
                        let packet = self.sent_packet(id, sent)
                        self.send_to_seen(tr.seen_by, packet)
                    },
                }
            }
        }
        var after = self.take_entities(d)
        after.trackers.insert(id, tr)
        after.list.give_back_crystal(c)
        self.put_entities(d, after)
    }

    // An area effect cloud's tracker, as an arrow's runs (D529), but only where it needs syncing
    // or its values changed, `UpdateInterval.NEVER`: its values that changed sent where
    // `sendDirtyEntityData` sends them, its values that aren't their defaults then what a player
    // coming to see it is sent.
    fn track_cloud(mut self, d: usize, id: i32) {
        var es = self.take_entities(d)
        let lent = es.list.lend_cloud(id)
        let kept = es.trackers.remove(id)
        self.put_entities(d, es)
        var c = lent else {
            self.keep_tracker(d, id, kept)
            return
        }
        var tr = kept else {
            var back = self.take_entities(d)
            back.list.give_back_cloud(c)
            self.put_entities(d, back)
            return
        }
        let now = section_of(c.body)
        let (sx, sy, sz) = now
        let (ox, oy, oz) = tr.section
        let moved = sx != ox or sy != oy or sz != oz
        if moved {
            tr.section = now
            for slot in self.level_slots(d) {
                var con = self.connections[slot].take() else continue
                self.cloud_seen(mut tr, c, mut con)
                self.connections[slot] = some(con)
            }
        }
        if moved or c.body.needs_sync or c.body.sync_velocity or self.levels[d].entity_ticking(ChunkPos { x: sx, z: sz }) {
            var out = List<Sent>()
            let dirty = c.data.is_dirty()
            tr.send_thrown_changes(mut c.body, dirty, mut out)
            for sent in out {
                match sent {
                    Sent.Dirty => {
                        if let packed = c.data.pack_dirty() {
                            tr.values = c.data.pack_non_default()
                            self.send_to_seen(tr.seen_by, encode_play(ClientboundSetEntityData { entity_id: id, items: packed }))
                        }
                    },
                    _ => {
                        let packet = self.sent_packet(id, sent)
                        self.send_to_seen(tr.seen_by, packet)
                    },
                }
            }
        }
        var after = self.take_entities(d)
        after.trackers.insert(id, tr)
        after.list.give_back_cloud(c)
        self.put_entities(d, after)
    }

    // An armor stand's or a mob's tracker, as an item's runs (CAL-155, CAL-156), `track_living`.
    fn track_stand(mut self, d: usize, id: i32) {
        var es = self.take_entities(d)
        let kept = es.trackers.remove(id)
        if es.list.is_mob(id) {
            let lent = es.list.lend_mob(id)
            self.put_entities(d, es)
            var mb = lent else {
                self.keep_tracker(d, id, kept)
                return
            }
            var tr = kept else {
                var back = self.take_entities(d)
                back.list.give_back_mob(mb)
                self.put_entities(d, back)
                return
            }
            self.track_living(d, id, mut tr, mut mb.living)
            var after = self.take_entities(d)
            after.trackers.insert(id, tr)
            after.list.give_back_mob(mb)
            self.put_entities(d, after)
            return
        }
        let lent = es.list.lend_stand(id)
        self.put_entities(d, es)
        var a = lent else {
            self.keep_tracker(d, id, kept)
            return
        }
        var tr = kept else {
            var back = self.take_entities(d)
            back.list.give_back_stand(a)
            self.put_entities(d, back)
            return
        }
        self.track_living(d, id, mut tr, mut a.living)
        var after = self.take_entities(d)
        after.trackers.insert(id, tr)
        after.list.give_back_stand(a)
        self.put_entities(d, after)
    }

    // Puts back the tracker of an entity that wasn't there to run it.
    fn keep_tracker(mut self, d: usize, id: i32, kept: own Tracker?) {
        if let t = kept {
            var back = self.take_entities(d)
            back.trackers.insert(id, t)
            self.put_entities(d, back)
        }
    }

    // A living entity's tracker run (CAL-155): its effects shown in its values where they
    // changed, `updateDataBeforeSync` (CAL-163); its values that changed and its attributes sent
    // where `sendDirtyEntityData` sends them, its values that aren't their defaults then what a
    // player coming to see it is sent, and its head's turn.
    fn track_living(mut self, d: usize, id: i32, tr: mut Tracker, l: mut Living) {
        if l.effects_dirty {
            if let lf = self.living_facts.take() {
                l.update_dirty_effects(lf)
                self.living_facts = some(lf)
            }
        }
        let now = section_of(l.body)
        let (sx, sy, sz) = now
        let (ox, oy, oz) = tr.section
        let moved = sx != ox or sy != oy or sz != oz
        if moved {
            tr.section = now
            for slot in self.level_slots(d) {
                var con = self.connections[slot].take() else continue
                self.living_seen(mut tr, l, mut con)
                self.connections[slot] = some(con)
            }
        }
        if moved or l.body.needs_sync or l.body.sync_velocity or self.levels[d].entity_ticking(ChunkPos { x: sx, z: sz }) {
            var out = List<Sent>()
            let dirty = l.data.is_dirty()
            let head = l.y_head_rot
            tr.send_living_changes(mut l.body, dirty, head, mut out)
            for s in out {
                match s {
                    Sent.Dirty => {
                        if let packed = l.data.pack_dirty() {
                            tr.values = l.data.pack_non_default()
                            self.send_to_seen(tr.seen_by, encode_play(ClientboundSetEntityData { entity_id: id, items: packed }))
                        }
                        let changed = l.attributes.take_synced()
                        if not changed.is_empty() {
                            self.send_to_seen(tr.seen_by, encode_play(attributes_packet(id, changed)))
                        }
                    },
                    _ => {
                        let packet = self.sent_packet(id, s)
                        self.send_to_seen(tr.seen_by, packet)
                    },
                }
            }
        }
    }

    // Puts an item `track_item` took out back, with its tracker.
    fn give_item_back(mut self, d: usize, e: own ItemEntity, tr: own Tracker?) {
        var es = self.take_entities(d)
        if let t = tr {
            es.trackers.insert(e.body.id, t)
        }
        es.list.give_back(e)
        self.put_entities(d, es)
    }

    // Gives the level `d` what a block's shape and its survival read, once natural spawning's
    // block facts are made: those facts, and its dimension's light and height (D326). Its
    // generator's depth, `getGenDepth`, is the dimension's height here, which only a huge fungus
    // grown by bone meal reads, and none is yet. The chunks that came to tick without them are
    // post-processed as it's given them (D329).
    fn give_env(mut self, d: usize) {
        if self.levels[d].has_env() or not self.world.natural_ready() {
            return
        }
        let n = self.world.natural.take() else return
        let facts = n.facts.copy()
        self.world.natural = some(n)
        // Whether its lava's fast, for the chunks post-processed as it's given (D329).
        let fast = self.world.dims[d].environment.flag(fast_lava(), self.world.clocks, self.world.dims[d].weather.rain_level(), self.world.dims[d].weather.thunder_level())
        self.levels[d].lava_delay = if fast { 10 } else { 30 }
        self.levels[d].fast_lava = fast
        let ctx = GenContext { min_y: self.world.dims[d].min_y, depth: self.world.dims[d].height, sea: self.world.dims[d].sea_level }
        // Each biome's climate, which where it rains reads (D339).
        self.levels[d].climate = self.world.climate.copy()
        // What broken blocks drop with (CAL-153).
        self.levels[d].loot = self.loot_of()
        self.levels[d].world_seed = self.world.seed
        self.levels[d].block_drops = self.world.block_drops
        self.levels[d].set_env(Env { facts: facts, ctx: ctx, sky_light: self.world.dims[d].sky_light, gen_depth: self.world.dims[d].height })
    }

    // What the players of the level `d` heard since it was last sent, in the order it happened,
    // each to those near enough, as `PlayerList.broadcast` sends it: a level event within 64
    // blocks (D326), a block event that ran within 64, and a sound within 16 of where it's
    // played, `SoundEvent.getRange` of a volume of 1 or less (CAL-125); and particles to those
    // whose block's middle is within 32, as `ServerLevel.sendParticles` sends them (CAL-143).
    fn send_level_events(mut self, d: usize) {
        let heard = self.levels[d].take_heard()
        for h in heard {
            // A beacon's pulse, `BeaconBlockEntity.applyEffects`, each of its effects in turn
            // given each player it reaches, as `addEffect`, `effect_player`, tells them (D520).
            if let Heard.Pulse(p) = h {
                if p.lit {
                    self.beacon_lit(d, p)
                    continue
                }
                let near = self.pulse_slots(d, p)
                for e in pulse_effects(p) {
                    for i in near.copy() {
                        self.give_slot_effect(i, e.copy())
                    }
                }
                continue
            }
            let (packet, x, y, z, range, except, centered) = self.heard_packet(h)
            for i in 0..self.connections.len() {
                if not self.playing(i) {
                    continue
                }
                var other = self.connections[i].take() else continue
                self.hear(mut other, d, packet, x, y, z, range, except, centered)
                self.connections[i] = some(other)
            }
        }
    }

    // `send_level_events`, while the player `con` is taken out of the connections to be handled
    // or to tick, as what they set off is sent at once: to them too (D376).
    fn send_level_events_with(mut self, d: usize, con: mut Connection) {
        let heard = self.levels[d].take_heard()
        for h in heard {
            // A beacon's pulse, given `con` first where it reaches them (D520).
            if let Heard.Pulse(p) = h {
                if p.lit {
                    if in_world(con) and lit_near(con, d, p) {
                        self.beacon_constructed(mut con, p.levels)
                    }
                    self.beacon_lit(d, p)
                    continue
                }
                let first = in_world(con) and pulse_near(con, d, p, f64(self.world.dims[d].height))
                let near = self.pulse_slots(d, p)
                for e in pulse_effects(p) {
                    if first {
                        _ = self.effect_player(mut con, e.copy())
                    }
                    for i in near.copy() {
                        self.give_slot_effect(i, e.copy())
                    }
                }
                continue
            }
            let (packet, x, y, z, range, except, centered) = self.heard_packet(h)
            if in_world(con) {
                self.hear(mut con, d, packet, x, y, z, range, except, centered)
            }
            for i in 0..self.connections.len() {
                if not self.playing(i) {
                    continue
                }
                var other = self.connections[i].take() else continue
                self.hear(mut other, d, packet, x, y, z, range, except, centered)
                self.connections[i] = some(other)
            }
        }
    }

    // What the players near enough are sent of `h`: its packet, where it is, how near they're
    // to be, the player not sent it, by their entity, -1 for none (D376), and whether it's their
    // block's middle that's to be near, `closerToCenterThan` (CAL-143).
    fn heard_packet(mut self, h: Heard) -> (List<u8>, f64, f64, f64, f64, i32, bool) {
        return match h {
            // One sent to every player has no range, `broadcastAll` (D596).
            Heard.Event(e) => (encode_play(ClientboundLevelEvent { kind: e.kind, pos: BlockPos { x: e.x, y: e.y, z: e.z }, data: e.data, global: e.global }), f64(e.x), f64(e.y), f64(e.z), if e.global { -1.0 } else { 64.0 }, e.except, false),
            Heard.Block(e) => (encode_play(ClientboundBlockEvent { pos: BlockPos { x: e.x, y: e.y, z: e.z }, b0: u8.wrap(e.b0), b1: u8.wrap(e.b1), block: i32.wrap(e.block) }), f64(e.x), f64(e.y), f64(e.z), 64.0, -1, false),
            Heard.Particles(p) => {
                let id = self.particle_id(p.particle)
                (encode_play(ClientboundLevelParticles { particle: Particle { id: id, option: particle_option(p.state) }, override_limiter: false, always_show: false, x: p.x, y: p.y, z: p.z, x_dist: p.dx, y_dist: p.dy, z_dist: p.dz, x_speed: p.speed, y_speed: p.speed, z_speed: p.speed, count: p.count, randomization: 0 }), p.x, p.y, p.z, 32.0, -1, true)
            },
            // Given, not sent, by `send_level_events` (D520).
            Heard.Pulse(_) => (List<u8>(), 0.0, 0.0, 0.0, -1.0, -1, false),
            Heard.Sound(s) => {
                let id = self.sound_id(s.sound)
                let range = if s.volume > 1.0f32 { 16.0 * f64(s.volume) } else { 16.0 }
                (encode_play(ClientboundSound { sound: id + 1, source: s.source, x: i32.saturate(s.x * 8.0), y: i32.saturate(s.y * 8.0), z: i32.saturate(s.z * 8.0), volume: s.volume, pitch: s.pitch, seed: s.seed }), s.x, s.y, s.z, range, s.except, false)
            },
        }
    }

    // Sends the player `con` `packet` if they're in the level `d`, aren't `except`, and are
    // nearer `x`, `y`, `z` than `range`, as `PlayerList.broadcast` sends it, or, if `centered`,
    // their block's middle is, as `ServerLevel.sendParticles` sends particles (CAL-143).
    fn hear(mut self, con: mut Connection, d: usize, packet: List<u8>, x: f64, y: f64, z: f64, range: f64, except: i32, centered: bool) {
        // No range, a global level event's: every player, in any level (D596).
        if range < 0.0 {
            self.send_bytes(mut con, packet.copy())
            return
        }
        if con.player.dim != d or con.player.entity_id == except {
            return
        }
        let (px, py, pz) = if centered { (con.player.x.floor() + 0.5, con.player.y.floor() + 0.5, con.player.z.floor() + 0.5) } else { (con.player.x, con.player.y, con.player.z) }
        let dx = x - px
        let dy = y - py
        let dz = z - pz
        if dx * dx + dy * dy + dz * dz < range * range {
            self.send_bytes(mut con, packet.copy())
        }
    }

    // The `sound_event` registry's ID of the sound `name`, as `block.piston.extend`, the table
    // made the first time; -1 for one it hasn't.
    fn sound_id(mut self, given: String) -> i32 {
        // A name with vanilla's namespace, as a component names it (D519).
        let name = if given.starts_with("minecraft:") { given[10..].copy() } else { given.copy() }
        if self.sound_ids.is_empty() {
            let names = builtin_names()
            for r in 0..names.len() {
                if names[r] == "sound_event" {
                    let entries = builtin_entries(r)
                    for i in 0..entries.len() {
                        self.sound_ids.insert(entries[i].copy(), i32.wrap(i))
                    }
                }
            }
        }
        return self.sound_ids.get(name) ?? -1
    }

    // The `particle_type` registry's ID of the particle `name`, as `note`, the table
    // made the first time; -1 for one it hasn't (CAL-143).
    fn particle_id(mut self, name: String) -> i32 {
        if self.particle_ids.is_empty() {
            let names = builtin_names()
            for r in 0..names.len() {
                if names[r] == "particle_type" {
                    let entries = builtin_entries(r)
                    for i in 0..entries.len() {
                        self.particle_ids.insert(entries[i].copy(), i32.wrap(i))
                    }
                }
            }
        }
        return self.particle_ids.get(name) ?? -1
    }

    // The blocks set in the level at `d` since the last broadcast, sent to each player in it who
    // has their chunk, as `broadcastChangedChunks` sends them once the chunks have ticked (D321):
    // a section's block alone as `ClientboundBlockUpdatePacket`, and more than one as
    // `ClientboundSectionBlocksUpdatePacket`; and before them, the light that changed in each,
    // `ClientboundLightUpdatePacket`, to the players with it on the edge of their view (D342).
    // Block entities' data comes with CAL-106.
    fn broadcast_changes(mut self, d: usize) {
        for c in self.levels[d].take_light_changes() {
            let packet = encode_play(ClientboundLightUpdate { x: c.chunk.x, z: c.chunk.z, light: c.light.copy() })
            for i in 0..self.connections.len() {
                if not self.playing(i) {
                    continue
                }
                var other = self.connections[i].take() else continue
                if other.player.dim == d and other.player.sender.on_edge(c.chunk) {
                    self.send_bytes(mut other, packet.copy())
                }
                self.connections[i] = some(other)
            }
        }
        let changes = self.levels[d].take_changes()
        for c in changes {
            let packet = change_packet(c)
            // Then each block's block entity's update packet, `broadcastBlockEntityIfNeeded`,
            // where its class sends one (CAL-115).
            var entities = List<List<u8>>()
            for e in c.block_entities {
                entities.push(encode_play(e))
            }
            for i in 0..self.connections.len() {
                if not self.playing(i) {
                    continue
                }
                var other = self.connections[i].take() else continue
                if other.player.dim == d and other.player.sender.has(c.chunk) {
                    self.send_bytes(mut other, packet.copy())
                    for e in entities {
                        self.send_bytes(mut other, e.copy())
                    }
                }
                self.connections[i] = some(other)
            }
        }
    }

    // `ServerChunkCache.tickChunks`, of what Calcite has so far: the level's mobs counted,
    // `createState` (CAL-156); the chunks mobs may spawn in, shuffled with the level's random as
    // `Util.shuffle` shuffles them, then each one's tick (D315), with natural spawning (D317);
    // then each chunk whose blocks tick, its own tick, `tickChunk` (D318); then the custom
    // spawners, which only the Overworld's level has, while `spawn_mobs` is on (D314).
    fn tick_chunks(mut self, d: usize) {
        let players = self.level_players(d)
        var near = List<(f64, f64)>()
        for p in players {
            if not p.spectator {
                near.push((p.x, p.z))
            }
        }
        // The categories that may spawn, `getFilteredSpawningCategories`, while `spawn_mobs` is
        // on: creatures only every 400 ticks (D317), each under the level's cap (CAL-156).
        var spawning = List<i32>()
        if self.world.spawn_rules.mobs {
            let counted = self.levels[d].natural_spawn_chunk_count()
            let state = self.spawn_state_of(d, counted, players.copy())
            spawning = spawning_categories(self.world.spawn_rules.enemies(), self.world.game_time % 400 == 0, state)
            self.spawn_state = some(state)
        }
        var chunks = self.levels[d].spawning_chunks(near)
        shuffle(mut chunks, mut self.levels[d])
        var place: SpawnPlace? = none
        var kept = List<ChunkPos>()
        let ready = self.world.natural_ready()
        if not spawning.is_empty() and ready {
            for pos in chunks {
                if self.levels[d].entities_tick(pos.x, pos.z) {
                    kept.push(pos)
                }
            }
            place = some(self.spawn_place(d, players.copy(), spawning))
            self.making = some(self.mob_making(d))
        }
        // The chunks whose blocks tick, whose light random ticks may read too (D318).
        let speed = self.world.random_tick_speed
        let ticking = self.levels[d].block_ticking_chunks()
        if ready and speed > 0 {
            for pos in ticking {
                kept.push(pos)
            }
        }
        self.levels[d].keep_light(kept)
        for pos in chunks {
            self.tick_spawning_chunk(d, pos, spawning, place)
        }
        self.spawn_state = none
        self.making = none
        for pos in ticking {
            self.tick_chunk(d, pos, speed)
        }
        if d != 0 or not self.world.spawn_rules.mobs {
            return
        }
        let siege = Identifier { namespace: "minecraft", path: "roll_village_siege" }
        let view = SpawnerView { rules: self.world.spawn_rules, sky_darken: self.world.dims[d].sky_darken, sky_light: self.world.dims[d].sky_light, bright: self.world.dims[d].bright_outside(), siege_roll: self.world.at_marker(d, siege), players: players }
        var random = self.levels[d].lend_random()
        self.world.spawners.tick(view, mut random)
        self.levels[d].give_back_random(random)
    }

    // A chunk mobs may spawn in, as `tickSpawningChunk` ticks it (D315). Its inhabited time goes
    // up a tick, which its save keeps (CAL-145); the local difficulty it makes waits for what
    // reads it. If it's in range for its
    // entities to tick, it's `tickThunder`: in a thunderstorm, one in 100,000 strikes, and the
    // strike, with its bolt and maybe a skeleton trap, comes with entities. Then, if any
    // category may spawn and the chunk's entities tick within the border, natural spawning
    // (D317), at `place`, the mobs it makes added to the level after (CAL-156).
    fn tick_spawning_chunk(mut self, d: usize, pos: ChunkPos, spawning: List<i32>, place: SpawnPlace?) {
        self.levels[d].inhabit(pos)
        if self.levels[d].entity_ticking(pos) and self.world.dims[d].weathered and self.world.dims[d].weather.raining() and self.world.dims[d].weather.thundering() {
            _ = self.levels[d].next_int_below(100000)
        }
        if spawning.is_empty() {
            return
        }
        let p = place else return
        if not spawns_in(p, self.levels[d], pos.x, pos.z) {
            return
        }
        // Taken out while it runs, as it reads the world while the level and the random change;
        // with the count of the level's mobs, and the maker, given the server's counters and the
        // living facts while it makes mobs.
        var state = self.spawn_state.take() else return
        var maker = self.making.take() else {
            self.spawn_state = some(state)
            return
        }
        let n = self.world.natural.take() else {
            self.spawn_state = some(state)
            self.making = some(maker)
            return
        }
        maker.ids = self.entity_ids
        maker.seeds = self.entity_seeds
        maker.lf = self.living_facts.take()
        _ = self.mob_facts_ready()
        maker.facts = self.mob_facts.take()
        var thrown: String? = none
        var random = self.levels[d].lend_random()
        match spawn_for_chunk(n, self.world.mobs[d], p, mut self.levels[d], mut maker, mut state, pos.x, pos.z, spawning, mut random) {
            ok => {},
            err(e) => thrown = some("{e.exception}: {e.message}"),
        }
        self.levels[d].give_back_random(random)
        self.world.natural = some(n)
        self.entity_ids = maker.ids
        self.entity_seeds = maker.seeds
        self.living_facts = maker.lf.take()
        self.mob_facts = maker.facts.take()
        let made = maker.made
        maker.made = List<Mob>()
        self.spawn_state = some(state)
        self.making = some(maker)
        if let e = thrown {
            self.logs.push(Entry.error("Natural spawning in {pos.x}, {pos.z} threw {e}"))
        }
        for m in made {
            self.add_mob(d, m.copy())
        }
    }

    // `createState` for the level `d` (CAL-156), for `chunks` chunks and its `players`: each mob
    // there that needn't stay, those it runs and those it keeps as they were read, by its type's
    // category.
    fn spawn_state_of(mut self, d: usize, chunks: i32, players: own List<SpawnerPlayer>) -> SpawnState {
        var state = SpawnState.new(chunks, players)
        let es = self.take_entities(d)
        var counted = es.list.counted()
        if let n = self.world.natural {
            for (_, kept) in es.kept_mobs {
                let (type_id, x, z) = kept
                if type_id >= 0 and usize.wrap(type_id) < n.types.len() {
                    counted.push((n.types[usize.wrap(type_id)].category, x, z))
                }
            }
        }
        self.put_entities(d, es)
        for (category, x, z) in counted {
            state.count(mut self.levels[d], category, x, z)
        }
        return state
    }

    // Natural spawning's maker for the level `d` (CAL-156): what blocks building there as its
    // spawning begins, its mobs and armor stands but markers, and its players but spectators.
    fn mob_making(mut self, d: usize) -> MobMaking {
        let es = self.take_entities(d)
        var blocking = es.list.blocking()
        self.put_entities(d, es)
        for slot in self.level_slots(d) {
            let c = self.connections[slot] else continue
            if c.player.mode != GameType.Spectator {
                blocking.push(pose_box(c.player.entity_data.number(POSE_ID), c.player.x, c.player.y, c.player.z))
            }
        }
        var kinds = List<(i32, i32)>()
        for species in [MOOSHROOM, COW, PIG, CHICKEN, SHEEP, HORSE, DONKEY, CREEPER, ZOMBIE, SKELETON, SPIDER, SLIME, ENDERMAN, WITCH, ZOMBIE_VILLAGER, ZOMBIE_HORSE, ENDERMITE] {
            kinds.push((self.entity_type(type_name(species)), species))
        }
        let loot = self.loot_of()
        return MobMaking { kinds: kinds, base: self.entity_base, now: self.now, blocking: blocking, loot: loot }
    }

    // Whether the farm animals' facts are made, from the world's registries the first time
    // they're asked for, or vanilla's where the world hasn't them, as a test's (CAL-156).
    fn mob_facts_ready(mut self) -> bool {
        let made = match self.mob_facts {
            some(_) => true,
            none => false,
        }
        if made {
            return true
        }
        var facts = MobFacts.vanilla(0, List<i32>(), List<i32>())
        var problem: String? = none
        if let shared = self.world.registries {
            match mob_facts_of(shared.value) {
                ok(f) => facts = f,
                err(e) => problem = some(e),
            }
        }
        if let e = problem {
            self.logs.push(Entry.error("The farm animals' variants don't read: {e}"))
        }
        self.mob_facts = some(facts)
        return true
    }

    // A chunk whose blocks tick, as `ServerLevel.tickChunk` ticks it (D318). `speed` times, one
    // in 48 for precipitation, which picks a column when it comes up and brings it the ice and
    // snow it makes and the cauldrons it fills (D340). Then in each section with a block or fluid
    // that ticks at random, `speed` places, each picked as vanilla picks them whether or not the
    // world has what random ticks read, and the block at each given its random tick, then its
    // fluid, with what the level's `place` says of it (D338).
    fn tick_chunk(mut self, d: usize, pos: ChunkPos, speed: i32) {
        let min_x = pos.x * 16
        let min_z = pos.z * 16
        // Taken out while it runs, as random ticks are.
        let precipitation = self.world.precipitation.take()
        for _ in 0..speed {
            if self.levels[d].next_int_below(48) == 0 {
                let (x, _, z) = self.world.dims[d].block_random.next_pos(min_x, 0, min_z, 15)
                if let p = precipitation {
                    self.levels[d].precipitate(p, x, z)
                }
            }
        }
        self.world.precipitation = precipitation
        if speed <= 0 {
            return
        }
        let sections = self.levels[d].ticking_sections(pos)
        if sections.is_empty() {
            return
        }
        // Taken out while they run, as they read the world while the level and the random change.
        let ticks = self.world.random_ticks.take()
        for bottom in sections {
            for _ in 0..speed {
                let (x, y, z) = self.world.dims[d].block_random.next_pos(min_x, bottom, min_z, 15)
                if let t = ticks {
                    self.levels[d].random_tick(t, x, y, z)
                }
            }
        }
        self.world.random_ticks = ticks
    }

    // What the block ticks of the level `d`, random and scheduled, read of it this tick besides
    // its blocks: its sky's darkening, its players who aren't spectators, the game rule
    // `fire_spread_radius_around_player`, whether its water evaporates, the difficulty (D338);
    // whether it's raining, whether fire lights portals in it, the Overworld and the Nether, its
    // type's `infiniburn`, and `INCREASED_FIRE_BURNOUT`, its own and that of each biome that sets
    // it (D339); and the game rule `max_snow_accumulation_height` (D340). Whether monsters spawn,
    // and `NETHER_PORTAL_SPAWNS_PIGLINS`, its own and that of each biome that sets it (D582).
    fn tick_place(mut self, d: usize) -> TickPlace {
        var standing = List<(f64, f64, f64)>()
        for p in self.level_players(d) {
            if not p.spectator {
                standing.push((p.x, p.y, p.z))
            }
        }
        let viewers = self.viewers_in(d)
        // The level's arrows, which a wooden button's tick looks for (CAL-159).
        var arrows = List<(f64, f64, f64)>()
        if d < self.entities.len() {
            if let es = self.entities[d] {
                arrows = es.list.arrow_places()
            }
        }
        let rain = self.world.dims[d].weather.rain_level()
        let thunder = self.world.dims[d].weather.thunder_level()
        let evaporates = self.world.dims[d].environment.flag(water_evaporates(), self.world.clocks, rain, thunder)
        let at = increased_fire_burnout()
        let burnout = self.world.dims[d].environment.flag(at, self.world.clocks, rain, thunder)
        var burnout_biomes = List<(i32, bool)>()
        if d < self.world.mobs.len() {
            for b in 0..self.world.mobs[d].attributes.len() {
                if self.world.dims[d].environment.sets(at, self.world.mobs[d].attributes[b]) {
                    let biome = self.world.mobs[d].attributes[b].copy()
                    burnout_biomes.push((i32.wrap(b), self.world.dims[d].environment.value_at(at, biome, self.world.clocks, rain, thunder).flag))
                }
            }
        }
        let piglin = nether_portal_spawns_piglin()
        let piglins = self.world.dims[d].environment.flag(piglin, self.world.clocks, rain, thunder)
        var piglin_biomes = List<(i32, bool)>()
        if d < self.world.mobs.len() {
            for b in 0..self.world.mobs[d].attributes.len() {
                if self.world.dims[d].environment.sets(piglin, self.world.mobs[d].attributes[b]) {
                    let biome = self.world.mobs[d].attributes[b].copy()
                    piglin_biomes.push((i32.wrap(b), self.world.dims[d].environment.value_at(piglin, biome, self.world.clocks, rain, thunder).flag))
                }
            }
        }
        let sun = sun_angle()
        let sun_degrees = self.world.dims[d].environment.number(sun, self.world.clocks, rain, thunder)
        var sun_biomes = List<(i32, f32)>()
        if d < self.world.mobs.len() {
            for b in 0..self.world.mobs[d].attributes.len() {
                if self.world.dims[d].environment.sets(sun, self.world.mobs[d].attributes[b]) {
                    let biome = self.world.mobs[d].attributes[b].copy()
                    sun_biomes.push((i32.wrap(b), self.world.dims[d].environment.value_at(sun, biome, self.world.clocks, rain, thunder).number))
                }
            }
        }
        let id = self.world.dims[d].id.to_string()
        return TickPlace {
            darken: self.world.dims[d].sky_darken,
            bright: self.world.dims[d].bright_outside(),
            players: standing,
            arrows: arrows,
            fire_radius: self.world.fire_spread_radius,
            evaporates: evaporates,
            difficulty: self.world.settings.difficulty.id(),
            raining: self.world.dims[d].weather.raining(),
            portals: id == "minecraft:overworld" or id == "minecraft:the_nether",
            end: id == "minecraft:the_end",
            infiniburn: self.world.dims[d].infiniburn.copy(),
            burnout: burnout,
            burnout_biomes: burnout_biomes,
            max_snow: self.world.max_snow,
            border_min_x: self.world.dims[d].border.min_x(),
            border_min_z: self.world.dims[d].border.min_z(),
            border_max_x: self.world.dims[d].border.max_x(),
            border_max_z: self.world.dims[d].border.max_z(),
            sun_angle: sun_degrees,
            sun_biomes: sun_biomes,
            viewers: viewers,
            ambient_light: self.world.dims[d].ambient_light,
            monsters_burn: self.world.dims[d].environment.flag(monsters_burn(), self.world.clocks, rain, thunder),
            monsters: self.world.spawn_rules.enemies(),
            piglins: piglins,
            piglin_biomes: piglin_biomes,
        }
    }

    // The players in the level `d` who aren't spectators with a container's menu open, where
    // they stand, how far they reach, and what it's of, which a chest's recheck counts (CAL-144).
    fn viewers_in(self, d: usize) -> List<Viewer> {
        var out = List<Viewer>()
        for slot in 0..self.connections.len() {
            if not self.playing(slot) {
                continue
            }
            let c = self.connections[slot] else continue
            if c.player.dim != d or c.player.mode == GameType.Spectator {
                continue
            }
            let open = c.player.container else continue
            var parts = List<(i32, i32, i32)>()
            for p in open.opening.parts {
                parts.push((p.x, p.y, p.z))
            }
            let range = c.player.attributes.value(attribute_id(String("block_interaction_range")) ?? 0)
            out.push(Viewer { x: c.player.x, y: c.player.y, z: c.player.z, range: range, parts: parts })
        }
        return out
    }

    // What natural spawning reads of the level at `d` this tick (D317): its players, the
    // world's spawn if it's in this level, the difficulty, the thunder and the sky, the border,
    // its type's light for monsters, and, if monsters may spawn, each biome's chance of a slime
    // on the surface.
    fn spawn_place(mut self, d: usize, players: own List<SpawnerPlayer>, spawning: List<i32>) -> SpawnPlace {
        var respawn: (i32, i32, i32)? = none
        let here = self.world.dims[d].id.copy()
        if self.respawn.dimension.namespace == here.namespace and self.respawn.dimension.path == here.path {
            respawn = some((self.respawn.pos.x, self.respawn.pos.y, self.respawn.pos.z))
        }
        let peaceful = self.world.settings.difficulty == Difficulty.Peaceful
        var chances = List<f32>()
        if not peaceful and spawning.contains(MONSTER) {
            let at = surface_slime_spawn_chance()
            let rain = self.world.dims[d].weather.rain_level()
            let thunder = self.world.dims[d].weather.thunder_level()
            for b in 0..self.world.mobs[d].attributes.len() {
                let biome = self.world.mobs[d].attributes[b].copy()
                chances.push(self.world.dims[d].environment.value_at(at, biome, self.world.clocks, rain, thunder).number)
            }
        }
        // Local difficulty's (CAL-156): the overworld clock's ticks, the moon's brightness as the
        // dimension's phase has it, and the date where the server is.
        let today = self.clock.date_time(unsafe { self.clock.local_offset() })
        let border = self.world.dims[d].border
        return SpawnPlace {
            min_y: self.world.dims[d].min_y,
            sea_level: self.world.dims[d].sea_level,
            seed: self.world.seed,
            peaceful: peaceful,
            thundering: self.world.dims[d].weathered and self.world.dims[d].weather.thundering(),
            sky_darken: self.world.dims[d].sky_darken,
            min_x: border.min_x(),
            max_x: border.max_x(),
            min_z: border.min_z(),
            max_z: border.max_z(),
            respawn: respawn,
            players: players,
            light_test: match self.world.dims[d].light_test {
                some(p) => p.copy(),
                none => IntProvider.Constant(0),
            },
            block_light_limit: self.world.dims[d].block_light_limit,
            ambient_light: self.world.dims[d].ambient_light,
            slime_chances: chances,
            difficulty: self.world.settings.difficulty,
            clock: self.overworld_clock(),
            moon: self.moon_at(d),
            halloween: today.month == 10 and today.day == 31,
        }
    }

    // The moon's brightness in the level `d`, `getMoonBrightness`, as its dimension's phase has it
    // (CAL-156).
    fn moon_at(mut self, d: usize) -> f32 {
        let raining = self.world.dims[d].weather.rain_level()
        let thundering = self.world.dims[d].weather.thunder_level()
        let phase = self.world.dims[d].environment.number(moon_phase(), self.world.clocks, raining, thundering)
        return moon_brightness(i32.saturate(f64(phase)))
    }

    // `getCurrentDifficultyAt` the block at x, z of the level `d` (CAL-159), as the spawners find
    // it: the overworld clock's ticks, and the chunk's inhabited time and the moon's brightness
    // where it's loaded in full, neither where it isn't.
    fn difficulty_at(mut self, d: usize, x: i32, z: i32) -> LocalDifficulty {
        var local: i64 = 0
        var moon = 0.0f32
        if let t = self.levels[d].inhabited_at(x >> 4, z >> 4) {
            local = t
            moon = self.moon_at(d)
        }
        return LocalDifficulty.new(self.world.settings.difficulty, self.overworld_clock(), local, moon)
    }

    // The overworld clock's ticks, `getOverworldClockTime`: the clock the overworld goes by
    // (CAL-156).
    fn overworld_clock(self) -> i64 {
        for dim in self.world.dims {
            if dim.id.namespace == "minecraft" and dim.id.path == "overworld" {
                return self.world.clocks.total_ticks(dim.default_clock)
            }
        }
        return self.world.clocks.total_ticks(some(0))
    }

    // The players in the dimension at `d` as the spawners see them, in the order they came into
    // its level, as `ServerLevel.players()` has them.
    fn level_players(self, d: usize) -> List<SpawnerPlayer> {
        var order = List<(u64, usize)>()
        for slot in 0..self.connections.len() {
            if self.playing(slot) {
                if let c = self.connections[slot] {
                    if c.player.dim == d {
                        order.push((c.player.entered, slot))
                    }
                }
            }
        }
        order.sort()
        var out = List<SpawnerPlayer>()
        for (_, slot) in order {
            if let c = self.connections[slot] {
                out.push(SpawnerPlayer { spectator: c.player.mode == GameType.Spectator, x: c.player.x, y: c.player.y, z: c.player.z })
            }
        }
        return out
    }

    // The connections' part of a tick, as `tickConnection` runs it: each login, configuration
    // and player moves on, as its listener's `tick` moves it, and every connection ticks its
    // second; one the client closed goes, `handleDisconnection` (CAL-151), and one the server
    // closed before is handled, its player taken out of the world, as its channel's closed by
    // now; one it closes as it ticks waits for the next tick's, as vanilla's does (D445). The
    // session ID goes once there are no connections not handled; then what was typed into the
    // console runs (D432).
    fn tick_connections(mut self, now: u64) {
        for i in 0..self.connections.len() {
            var con = self.connections[i].take() else continue
            if con.gone {
                self.lost(con)
                continue
            }
            if con.closing and not con.handled {
                self.lost(con)
                con.handled = true
            }
            if not con.closing {
                match con.phase {
                    Phase.Login => self.tick_login(mut con),
                    Phase.Configuration => self.tick_configuration(mut con, now),
                    Phase.Play => self.tick_play(mut con, now),
                    _ => {},
                }
                self.tick_second(mut con)
            }
            self.connections[i] = some(con)
        }
        var unhandled = false
        for c in self.connections {
            if let con = c {
                if not con.handled {
                    unhandled = true
                }
            }
        }
        if not unhandled {
            self.session = none
        }
        self.console_inputs()
    }

    // The player list's tick, as `PlayerList.tick` runs it: every 601st tick, everyone in the
    // world is told everyone's latency, in the order they joined.
    fn tick_player_list(mut self) {
        self.player_info_in += 1
        if self.player_info_in <= 600 {
            return
        }
        self.player_info_in = 0
        var entries = List<PlayerEntry>()
        for slot in self.by_joining() {
            if let c = self.connections[slot] {
                if let e = entry(c, c.player.mode, self.clock.unix_ms) {
                    entries.push(e)
                }
            }
        }
        if entries.is_empty() {
            return
        }
        self.broadcast(encode_play(ClientboundPlayerInfoUpdate { info: PlayerInfo { actions: UPDATE_LATENCY, entries: entries } }))
    }

    // A packet to every player in the world in the dimension at `d`, as `broadcastAll` with a
    // dimension sends it.
    fn broadcast_in(mut self, d: usize, packet: List<u8>) {
        for i in 0..self.connections.len() {
            if not self.playing(i) {
                continue
            }
            var other = self.connections[i].take() else continue
            if other.player.dim == d {
                self.send_bytes(mut other, packet.copy())
            }
            self.connections[i] = some(other)
        }
    }

    /// Closes each connection that has sent nothing for 30 seconds, as of `now`.
    pub fn sweep(mut self, now: u64) {
        self.link.sweep(now)
        for i in 0..self.connections.len() {
            var stale = false
            if let c = self.connections[i] {
                stale = not c.closing and not c.gone and now > c.last_read and now - c.last_read >= READ_TIMEOUT_NS
            }
            if stale {
                var con = self.connections[i].take() else continue
                con.reason = some(Component.translatable("disconnect.timeout", []))
                self.close(mut con)
                self.connections[i] = some(con)
            }
        }
        self.flush()
    }

    fn owns(self, c: Conn) -> bool {
        let slot = c.slot()
        if slot >= self.connections.len() {
            return false
        }
        if let mine = self.connections[slot] {
            return mine.conn == c
        }
        return false
    }

    // The end of a connection's tick, as vanilla's `Connection.tick` ends: on its first and every
    // 20th after, `tickSecond` averages in the packets it was handled since, a quarter of them to
    // three quarters of the average before. With `rate-limit` set, a connection whose average is
    // over it is kicked then, as `RateKickingConnection` kicks it. Only one in configuration or
    // play can be: before them a connection is handed at most 3 packets, which average under 1 a
    // second.
    fn tick_second(mut self, con: mut Connection) {
        let second = con.ticks % 20 == 0
        con.ticks = con.ticks.wrapping_add(1)
        if not second {
            return
        }
        let received = f32.nearest(con.received)
        con.average_received = received + 0.75f32 * (con.average_received - received)
        con.received = 0
        let limit = self.settings.rate_limit
        if limit <= 0 or not (con.average_received > f32.nearest(limit)) {
            return
        }
        self.logs.push(Entry.warn("Player exceeded rate-limit (sent {con.average_received} packets per second)"))
        let reason = Component.translatable("disconnect.exceeded_packet_rate", [])
        let state = con.outbound
        self.send(mut con, ClientboundDisconnect { reason: reason.copy() }, state)
        con.reason = some(reason)
        self.close(mut con)
    }

    // Works out the regions from where each player in the world is, and how far they see, as the
    // barrier does before the world phase (D22, D283), with each player's slot.
    fn lay_out(mut self) {
        var placed = List<Placed>()
        for i in 0..self.connections.len() {
            if not self.playing(i) {
                continue
            }
            if let c = self.connections[i] {
                placed.push(Placed { player: c.player.entity_id, dim: c.player.dim, x: c.player.center_x, z: c.player.center_z, view: c.player.view, slot: i })
            }
        }
        _ = self.layout.update(placed)
    }

    // Whether the connection in `slot` is a player in the world: in play, and its listener not
    // told it's gone yet, as one the server's closing is in the world till the tick's connections
    // tell it (D445).
    fn playing(self, slot: usize) -> bool {
        if let c = self.connections[slot] {
            return in_world(c)
        }
        return false
    }

    // Closes the connection, once, after what it was sent before: one closed while it was
    // handled, such as a sender with too many messages unseen, is closed already when its handler
    // returns. What arrives from then on is dropped.
    fn close(mut self, con: mut Connection) {
        if con.closing {
            return
        }
        con.closing = true
        con.out.end()
        self.list(mut con)
    }

    fn receive(mut self, c: Conn, now: u64) {
        let slot = c.slot()
        // Takes the connection out, leaving `none` in its slot, so the rest of `self` can be
        // used while it changes.
        var con = self.connections[slot].take() else return
        if con.closing {
            // What arrives after the server closed the connection is dropped.
            self.link.discard(c)
        } else if not self.serve(mut con, now) {
            self.close(mut con)
        }
        self.connections[slot] = some(con)
        self.run_queued()
    }

    // Reads what arrived on the connection and answers it. False when it's to close.
    fn serve(mut self, con: mut Connection, now: u64) -> bool {
        con.codec.push(self.link.read(con.conn))
        con.last_read = now
        if not con.started {
            con.started = true
            if self.status.enabled {
                let kind = classify(con.codec.peek())
                if kind != Legacy.Modern {
                    let answer = response(kind, game_version(), self.status.motd, self.status.status.online, self.status.status.max_players)
                    self.link.sent(con.conn, answer)
                    con.out.raw(answer)
                    self.list(mut con)
                    return false
                }
            }
        }
        return self.decode(mut con, now)
    }

    // Reads the packets that have come on the connection, each handled as it's read or held for
    // the next tick, up to one that ends configuration, after which nothing's read until it's
    // run (CAL-150). False when it's to close. A frame or packet that can't be read closes the
    // connection. In the handshake and status vanilla can't send the reason, since neither state
    // has a disconnect packet, and logs it only at debug level, so it's dropped there. Later the
    // client is told.
    fn decode(mut self, con: mut Connection, now: u64) -> bool {
        loop {
            if con.held {
                return true
            }
            let body = match con.codec.next() {
                ok(some(b)) => b,
                ok(none) => return true,
                err(e) => {
                    if con.phase == Phase.Login or con.phase == Phase.Configuration or con.phase == Phase.Play {
                        self.fault(mut con, decode_exception(e.message))
                    }
                    return false
                },
            }
            if not self.packet(mut con, body, now) {
                return false
            }
        }
    }

    // Handles one packet. False when the connection is to close. Each packet that decodes counts
    // toward `rate-limit`, as vanilla counts those its `Connection` hands its listener.
    fn packet(mut self, con: mut Connection, body: own List<u8>, now: u64) -> bool {
        var r = Reader.new(body)
        match con.phase {
            Phase.Handshake => {
                let intention = match HandshakeIn.read(mut r) {
                    ok(HandshakeIn.Intention(p)) => p,
                    err(_) => return false,
                }
                con.received += 1
                return self.intention(mut con, intention, now)
            },
            Phase.Status => {
                let p = match StatusIn.read(mut r) {
                    ok(p) => p,
                    err(_) => return false,
                }
                con.received += 1
                match p {
                    StatusIn.StatusRequest(_) => {
                        if con.status_requested {
                            return false
                        }
                        con.status_requested = true
                        let answer = ClientboundStatusResponse { json: self.status_json.copy() }
                        self.send(mut con, answer, State.Status)
                        return true
                    },
                    StatusIn.PingRequest(ping) => {
                        self.send(mut con, ClientboundPongResponse { time: ping.time }, State.Status)
                        return false
                    },
                }
            },
            Phase.Login => {
                let p = match LoginIn.read(mut r) {
                    ok(p) => p,
                    err(e) => {
                        self.fault(mut con, decode_exception(e.message))
                        return false
                    },
                }
                con.received += 1
                return self.login_packet(mut con, p, now)
            },
            Phase.Configuration => {
                let p = match ConfigurationIn.read(mut r) {
                    ok(p) => p,
                    err(e) => {
                        self.fault(mut con, decode_exception(e.message))
                        return false
                    },
                }
                con.received += 1
                if not on_server_thread_configuration(p) {
                    return self.configuration_packet(mut con, p, now)
                }
                con.held = ends_configuration(p)
                self.scheduled.push_last(Scheduled { conn: Conn.from_id(con.conn.id()), packet: Inbound.Configuration(p) })
                return true
            },
            Phase.Play => {
                // A packet Calcite doesn't read yet is skipped whole.
                let id = r.peek_varint() ?? -1
                if not PlayIn.reads(id) {
                    con.received += 1
                    return true
                }
                let p = match PlayIn.read(mut r) {
                    ok(p) => p,
                    err(e) => {
                        self.fault(mut con, decode_exception(e.message))
                        return false
                    },
                }
                con.received += 1
                if not on_server_thread_play(p) {
                    self.sequences_to(con.player.dim)
                    let open = self.play_packet(mut con, p, now)
                    self.make_drops_for(mut con)
                    return open
                }
                // What its codec checks as it's read stops the connection now, not as it'd run.
                if let fault = self.unreadable(p) {
                    self.fault(mut con, decode_exception(fault))
                    return false
                }
                self.scheduled.push_last(Scheduled { conn: Conn.from_id(con.conn.id()), packet: Inbound.Play(p) })
                return true
            },
        }
    }

    // The handshake, as `ServerHandshakePacketListenerImpl.handleIntention`.
    fn intention(mut self, con: mut Connection, p: ClientIntention, now: u64) -> bool {
        match p.intention {
            ClientIntent.Status => {
                if not self.status.enabled {
                    return false
                }
                con.phase = Phase.Status
                return true
            },
            ClientIntent.Login => {
                if self.throttled(mut con, now) {
                    return false
                }
                return self.begin_login(mut con, p, false)
            },
            ClientIntent.Transfer => {
                if not self.settings.accepts_transfers {
                    self.refuse(mut con, Component.translatable("multiplayer.disconnect.transfers_disabled", []))
                    return false
                }
                if self.throttled(mut con, now) {
                    return false
                }
                return self.begin_login(mut con, p, true)
            },
        }
    }

    // Whether a try to log in comes too soon after the last from its address, with
    // `login-throttle` set, in which case it's refused. Each try, let in or not, starts the wait
    // again, so an address that keeps trying stays refused. Vanilla has no such limit, so it's
    // off by default, and off behind a Velocity proxy, whose players all come from its address.
    fn throttled(mut self, con: mut Connection, now: u64) -> bool {
        let wait = self.settings.login_throttle
        if wait <= 0 or self.settings.velocity_secret != none {
            return false
        }
        let peer = con.peer else return false
        let ip = peer.ip.to_string()
        let last = self.last_logins.get(ip)
        self.last_logins.insert(ip, now)
        if let t = last {
            if now - t < u64.wrap(wait) * 1000000 {
                self.refuse(mut con, Component.literal("You tried to join too soon after your last try. Wait a moment, then join again."))
                return true
            }
        }
        return false
    }

    // Forgets the addresses whose last try to log in is longer ago than `login-throttle`, once a
    // second, so the table holds only those that could still be refused.
    fn forget_logins(mut self, now: u64) {
        if self.last_logins.is_empty() {
            return
        }
        let wait = if self.settings.login_throttle > 0 { u64.wrap(self.settings.login_throttle) * 1000000 } else { 0 }
        var old = List<String>()
        for (ip, t) in self.last_logins {
            if now - t >= wait {
                old.push(ip.copy())
            }
        }
        for ip in old {
            _ = self.last_logins.remove(ip)
        }
    }

    fn begin_login(mut self, con: mut Connection, p: ClientIntention, transferred: bool) -> bool {
        if p.protocol_version != PROTOCOL_VERSION {
            let key = if p.protocol_version < 754 { "multiplayer.disconnect.outdated_client" } else { "multiplayer.disconnect.incompatible" }
            self.refuse(mut con, Component.translatable(String(key), [Component.literal(game_version())]))
            return false
        }
        con.phase = Phase.Login
        con.transferred = transferred
        con.challenge = self.link.random(4)
        return true
    }

    // The handshake's refusal of a login, which vanilla sends without logging it.
    fn refuse(mut self, con: mut Connection, reason: Component) {
        self.send(mut con, ClientboundLoginDisconnect { reason_json: reason.to_json() }, State.Login)
    }

    // A login packet, as `ServerLoginPacketListenerImpl`'s handlers. False when it's to close.
    fn login_packet(mut self, con: mut Connection, p: LoginIn, now: u64) -> bool {
        match p {
            LoginIn.Hello(hello) => return self.hello(mut con, hello),
            LoginIn.Key(k) => return self.key_packet(mut con, k),
            LoginIn.CustomQueryAnswer(a) => {
                if con.login == LoginState.Forwarding and a.transaction_id == con.query_id {
                    return self.forwarded(mut con, a)
                }
                self.disconnect(mut con, Component.translatable("multiplayer.disconnect.unexpected_query_response", []))
                return false
            },
            LoginIn.CookieResponse(_) => {
                self.disconnect(mut con, Component.translatable("multiplayer.disconnect.unexpected_query_response", []))
                return false
            },
            LoginIn.LoginAcknowledged(_) => {
                if con.login != LoginState.ProtocolSwitching {
                    self.fault(mut con, "java.lang.IllegalStateException: Unexpected login acknowledgement packet")
                    return false
                }
                con.login = LoginState.Accepted
                con.phase = Phase.Configuration
                self.configure(mut con, now)
                return true
            },
        }
    }

    // The client's name, as `handleHello`. Online, the client is sent the server's public key, to
    // encrypt a secret with; offline, the player gets the profile made from their name.
    fn hello(mut self, con: mut Connection, p: ServerboundHello) -> bool {
        if con.login != LoginState.Hello {
            self.fault(mut con, "java.lang.IllegalStateException: Unexpected hello packet")
            return false
        }
        if not is_valid_name(p.name) {
            self.fault(mut con, "java.lang.IllegalStateException: Invalid characters in username")
            return false
        }
        con.name = some(p.name.copy())
        if self.settings.velocity_secret != none {
            // Behind Velocity, the proxy has authenticated the player, and is asked who they are.
            let id = self.link.random(4)
            con.query_id = (i32(id[0]) << 24) | (i32(id[1]) << 16) | (i32(id[2]) << 8) | i32(id[3])
            con.login = LoginState.Forwarding
            let query = ClientboundCustomQuery { transaction_id: con.query_id, channel: Identifier.parse(channel())!, payload: request() }
            self.send(mut con, query, State.Login)
            return true
        }
        if self.settings.online_mode {
            self.take_key()
            con.login = LoginState.Key
            let hello = ClientboundHello { server_id: String(), public_key: self.public_key.copy(), challenge: con.challenge.copy(), should_authenticate: true }
            self.send(mut con, hello, State.Login)
            return true
        }
        con.profile = some(GameProfile.offline(p.name))
        con.login = LoginState.Verifying
        return true
    }

    // The client's secret and the challenge, both encrypted with the server's public key, as
    // `handleKey`. Encryption starts with the secret, and an authenticator checks with the
    // session server that the player joined with the server's hash.
    fn key_packet(mut self, con: mut Connection, p: ServerboundKey) -> bool {
        if con.login != LoginState.Key {
            self.fault(mut con, "java.lang.IllegalStateException: Unexpected key packet")
            return false
        }
        let protocol_error = String("java.lang.IllegalStateException: Protocol error")
        var valid = false
        if let challenge = self.decrypt(p.encrypted_challenge) {
            valid = challenge == con.challenge
        }
        if not valid {
            self.fault(mut con, protocol_error)
            return false
        }
        // A secret Java can't make an AES key of is a `CryptException` too: vanilla works out the
        // hash and moves on first, but the login ends either way.
        let secret = self.decrypt(p.key_bytes) ?? List<u8>()
        if secret.len() != 16 {
            self.fault(mut con, protocol_error)
            return false
        }
        let hash = server_hash(secret, self.public_key)
        con.login = LoginState.Authenticating
        con.codec.start_encryption(secret)
        con.out.start_encryption(secret)
        self.authenticators += 1
        let name = con.name.copy() ?? String()
        let ip = if self.settings.prevent_proxy_connections { host_address(con.peer) } else { none }
        let join = JoinCheck.new(name, hash, ip)
        self.checks.push(Check { conn: con.conn, thread: "User Authenticator #{self.authenticators}", user: user(con), name: name, join: join })
        return true
    }

    // Velocity's answer: the player is let in with the profile it forwards, and logged with the
    // address it forwards, or told why not.
    fn forwarded(mut self, con: mut Connection, a: ServerboundCustomQueryAnswer) -> bool {
        let secret = self.settings.velocity_secret.copy() ?? String()
        match read(a.payload, secret) {
            ok(f) => {
                var port: u16 = 0
                if let peer = con.peer {
                    port = peer.port
                }
                con.ban_ip = ban_ip(socket_text(f.address, port))
                if self.settings.log_ips {
                    con.address = socket_text(f.address, port)
                }
                self.logs.push(Entry.info("UUID of player {f.profile.name} is {f.profile.id.to_string()}").calcite(Look.Quiet))
                con.name = some(f.profile.name.copy())
                con.profile = some(f.profile)
                con.login = LoginState.Verifying
                return true
            },
            err(problem) => {
                self.disconnect(mut con, Component.literal(problem.message()))
                return false
            },
        }
    }

    // The key pair, waiting for it if it isn't made yet.
    fn take_key(mut self) {
        if self.key != none {
            return
        }
        let key = self.link.key(mut self.coming) else panic("the server's key pair never came")
        self.public_key = key.public_der()
        self.key = some(key)
    }

    // What the client encrypted with the server's public key, as Java's `RSA` cipher decrypts
    // it: bytes shorter than the key are a smaller number, as if they had zeros in front. A
    // client is sent the key before it can encrypt anything with it.
    fn decrypt(self, bytes: List<u8>) -> List<u8>? {
        let key = self.key else return none
        let size = key.size()
        if bytes.len() >= size {
            return key.decrypt(bytes)
        }
        var padded = List<u8>()
        for _ in bytes.len()..size {
            padded.push(0)
        }
        for b in bytes {
            padded.push(b)
        }
        return key.decrypt(padded)
    }

    // Moves each check with the session server on, and acts on those that are done, as each
    // authenticator does once `hasJoinedServer` returns.
    fn authenticate(mut self) {
        var i: usize = 0
        while i < self.checks.len() {
            var check = self.checks.remove(i)
            var lines = List<Entry>()
            let result = self.services.poll(mut check.join, mut lines, mut self.link)
            for e in lines {
                self.logs.push(Entry { level: e.level, message: e.message.copy(), thread: some(check.thread.copy()), look: e.look.copy() })
            }
            match result {
                some(joined) => self.authenticated(check, joined),
                none => {
                    self.checks.insert(i, check)
                    i += 1
                },
            }
        }
    }

    // What an authenticator does with what the session server said: the player is let in with
    // their profile, or told why not. It logs the same if they've left, as vanilla's does.
    fn authenticated(mut self, check: own Check, joined: own Joined) {
        let slot = check.conn.slot()
        var taken: Connection? = none
        if self.owns(check.conn) {
            taken = self.connections[slot].take()
        }
        match joined {
            Joined.Yes(profile) => {
                self.logs.push(Entry.info("UUID of player {profile.name} is {profile.id.to_string()}").on(check.thread.copy()).calcite(Look.Quiet))
                if let c = taken {
                    var waiting = c
                    if not waiting.closing {
                        waiting.profile = some(profile)
                        waiting.login = LoginState.Verifying
                    }
                    self.connections[slot] = some(waiting)
                }
            },
            Joined.No => {
                let reason = Component.translatable("multiplayer.disconnect.unverified_username", [])
                self.turn_away(check, taken, reason, "Username '{check.name}' tried to join with an invalid session")
            },
            Joined.Unavailable => {
                let reason = Component.translatable("multiplayer.disconnect.authservers_down", [])
                self.turn_away(check, taken, reason, "Couldn't verify username because servers are unavailable")
            },
        }
    }

    // An authenticator's `disconnect`, then the error it logs. The connection, if it's still
    // there, was taken out of its slot, and goes back in.
    fn turn_away(mut self, check: Check, taken: own Connection?, reason: own Component, problem: own String) {
        let refused = reason.get_string(self.lang)
        self.logs.push(Entry.info("Disconnecting {check.user}: {refused}").on(check.thread.copy()).calcite(Look.Leave("Turned {check.user} away: {refused}")))
        if let c = taken {
            var con = c
            if not con.closing {
                self.send(mut con, ClientboundLoginDisconnect { reason_json: reason.to_json() }, State.Login)
                con.reason = some(reason)
                self.close(mut con)
            }
            self.connections[check.conn.slot()] = some(con)
        }
        self.logs.push(Entry.error(problem).on(check.thread.copy()))
    }

    // A login's tick, as the login listener's `tick`.
    fn tick_login(mut self, con: mut Connection) {
        if con.login == LoginState.Verifying {
            self.verify(mut con)
        }
        let ticks = con.login_ticks
        con.login_ticks += 1
        if ticks == MAX_LOGIN_TICKS {
            self.disconnect(mut con, Component.translatable("multiplayer.disconnect.slow_login", []))
            self.close(mut con)
        }
    }

    // Lets the player in, as `verifyLoginAndFinishConnectionSetup`, or turns them away if a
    // ban, the whitelist or a full server keeps them out: compression goes on if the server has
    // it, then the client is sent its profile. A player already in the world is to be kicked
    // first.
    fn verify(mut self, con: mut Connection) {
        let online = self.players_online()
        var refused: Component? = none
        if let profile = con.profile {
            refused = self.access.refusal(profile.id, con.ban_ip, online, self.world.settings.max_players, self.clock)
        }
        if let reason = refused {
            self.disconnect(mut con, reason)
            self.close(mut con)
            return
        }
        let threshold = self.settings.compression_threshold
        if threshold >= 0 {
            self.send(mut con, ClientboundLoginCompression { threshold: threshold }, State.Login)
            con.codec.start_compression(threshold)
            con.out.start_compression(threshold)
        }
        con.login = LoginState.ProtocolSwitching
        let session = self.session_id()
        var finished: ClientboundLoginFinished? = none
        if let profile = con.profile {
            finished = some(ClientboundLoginFinished { profile: profile.copy(), session_id: session })
        }
        if let f = finished {
            self.send(mut con, f, State.Login)
        }
    }

    // The login is acknowledged, so configuration starts, at `now`, as vanilla's
    // `startConfiguration`: the brand, the links and the enabled features, then the tasks, the
    // first of which starts.
    fn configure(mut self, con: mut Connection, now: u64) {
        con.outbound = State.Configuration
        con.keep_alive_time = millis(now)
        for i in 0..self.configuration.opening.len() {
            let p = self.configuration.opening[i].copy()
            self.send_bytes(mut con, p)
        }
        con.tasks = [Task.SynchronizeRegistries]
        if not self.configuration.codes.is_empty() {
            con.tasks.push(Task.CodeOfConduct)
        }
        if self.configuration.pack != none {
            con.tasks.push(Task.ResourcePack)
        }
        con.tasks.push(Task.PrepareSpawn)
        con.tasks.push(Task.JoinWorld)
        self.next_task(mut con)
    }

    // Starts the next task, if there is one, as `startNextTask`.
    fn next_task(mut self, con: mut Connection) {
        if con.closing or con.tasks.is_empty() {
            return
        }
        let task = con.tasks.remove(0)
        con.task = some(task)
        match task {
            Task.SynchronizeRegistries => {
                let offer = self.configuration.offer.copy()
                self.send_bytes(mut con, offer)
            },
            Task.CodeOfConduct => {
                let code = self.configuration.code_for(con.information.language)
                self.send(mut con, ClientboundCodeOfConduct { code: code }, State.Configuration)
            },
            Task.ResourcePack => {
                var push: ClientboundResourcePackPush? = none
                if let pack = self.configuration.pack {
                    push = some(ClientboundResourcePackPush { pack: pack.id, url: pack.url.copy(), hash: pack.hash.copy(), required: pack.required, prompt: pack.prompt.copy() })
                }
                if let p = push {
                    self.send(mut con, p, State.Configuration)
                }
            },
            Task.PrepareSpawn => self.start_spawn(mut con),
            Task.JoinWorld => self.send(mut con, ClientboundFinishConfiguration {}, State.Configuration),
        }
    }

    // Finishes the current task, which must be `t`, and starts the next, as `finishCurrentTask`.
    // The exception vanilla throws if `t` isn't the current task, as its `toString` writes it.
    fn finish_task(mut self, con: mut Connection, t: Task) -> String? {
        if not is(con.task, t) {
            return some("java.lang.IllegalStateException: Unexpected request for task finish, current task: {task_name(con.task)}, requested: {task_name(some(t))}")
        }
        con.task = none
        self.next_task(mut con)
        return none
    }

    // A configuration's tick at `now`, as the configuration listener's `tick`: a keep-alive if
    // one is due, then the current task's tick.
    fn tick_configuration(mut self, con: mut Connection, now: u64) {
        if not self.keep_alive(mut con, now) {
            return
        }
        // Once the player's place is found, the spawn ticket loads the chunks 3 around it, and
        // the place is ready once they're full, which in a flat world, or one whose chunks are
        // read before the tick, is the first tick, as soon as vanilla's can be. If the ticket
        // runs out first, as it can 20 ticks after its own chunk is ready, those not full yet
        // are let go, and the place is ready then, as vanilla's future for them is done. And
        // once the entities of those full are in, which vanilla's `Ready.spawn` waits for,
        // `waitForEntities`, before it makes the player, so they come before the player does,
        // with the IDs before theirs (CAL-148).
        if is(con.task, Task.PrepareSpawn) {
            if con.prepare.awaiting {
                if self.spawn_pending {
                    return
                }
                self.start_spawn(mut con)
            }
            if not con.prepare.found {
                self.search_spawn(mut con)
            }
            if con.prepare.found {
                let chunk = con.prepare.chunk()
                let d = con.prepare.dim
                if not con.prepare.ticketed {
                    con.prepare.ticketed = true
                    self.levels[d].load_spawn(chunk)
                    self.levels[d].want_spawn_light(chunk)
                    self.level_lines()
                    self.levels[d].dispatch()
                }
                if self.levels[d].around_done(chunk, SPAWN_RADIUS) and self.entities_around(d, chunk, SPAWN_RADIUS) {
                    con.prepare.ready = true
                    con.task = none
                    self.next_task(mut con)
                }
            }
        }
        if con.prepare.ready {
            let d = con.prepare.dim
            self.levels[d].keep_spawn(con.prepare.chunk())
        }
    }

    // Starts the spawn task, as `PrepareSpawnTask.start`: the player's place and angle are where
    // they were saved, or, for one new to the world, a place found around the world's spawn,
    // facing as it does. In adventure mode that's the spawn, moved up or down to where they fit
    // in what's loaded; otherwise a search starts, which the configuration ticks go on with as
    // each candidate's chunk loads. A player saved in a dimension the world has joins it; one
    // saved in another joins the Overworld at the same place, as vanilla puts them (CAL-69).
    fn start_spawn(mut self, con: mut Connection) {
        con.prepare = Prepare()
        var saved = SavedPosition { dimension: none, pos: none, rotation: none }
        if let data = self.player_data(con) {
            saved = saved_position(data)
            con.prepare.data = some(data)
        }
        if let id = saved.dimension {
            con.prepare.dim = self.world.dimension_of(id) ?? 0
        }
        var y_rot = self.respawn.yaw
        var x_rot = self.respawn.pitch
        if let r = saved.rotation {
            y_rot = r[0]
            x_rot = r[1]
        }
        con.prepare.y_rot = y_rot
        con.prepare.x_rot = x_rot
        if let p = saved.pos {
            con.prepare.place(p[0], p[1], p[2])
            return
        }
        // A new world's spawn is still being found: the search starts once it is.
        if self.spawn_pending {
            con.prepare.awaiting = true
            return
        }
        self.search_new_spawn(mut con)
    }

    // Starts the search for where a player new to the world, or respawning without a bed,
    // goes, `adjustSpawnLocation`: in adventure mode the world's spawn, moved up or down to where
    // they fit in what's loaded; otherwise `PlayerSpawnFinder`'s, from a random candidate around
    // it, which goes on as each candidate's chunk loads (D428).
    fn search_new_spawn(mut self, con: mut Connection) {
        let origin = self.respawn.pos
        if self.collisions == none {
            self.collisions = some(CollisionStates.new())
        }
        if self.world.settings.game_type == GameType.Adventure {
            var y = origin.y
            if let states = self.collisions {
                y = fixup_height(states, self.levels[0], origin.x, origin.y, origin.z, MIN_Y, MIN_Y + SECTIONS * 16 - 1)
            }
            con.prepare.dim = 0
            con.prepare.place(f64(origin.x) + 0.5, f64(y), f64(origin.z) + 0.5)
            return
        }
        // The search starts from a random candidate, which vanilla draws with a new random source
        // seeded from the thread's.
        let radius = search_radius(self.respawn_radius, border_distance(origin.x, origin.z))
        var seed: i64 = 0
        for b in self.link.random(8) {
            seed = (seed << 8) | i64(b)
        }
        var random = LegacyRandom.new(seed)
        var search = SpawnSearch.new(origin, radius, random.next_int_below(candidate_count(radius)))
        con.prepare.dim = 0
        let first = search.next()
        con.prepare.search = some(search)
        self.next_candidate(mut con, first)
    }

    // Loads the chunk of the search's next candidate, `candidate`, to check it once it's full.
    fn next_candidate(mut self, con: mut Connection, candidate: Candidate) {
        self.levels[0].search_spawn(ChunkPos { x: candidate.x >> 4, z: candidate.z >> 4 })
        con.prepare.candidate = some(candidate)
        self.level_lines()
        self.levels[0].dispatch()
    }

    // Goes on with the spawn search while its candidate's chunk is full, as vanilla checks each
    // on the server's thread once its chunk is: the place is the candidate's column where a
    // player can stand on its surface and fits, or the next candidate's chunk is loaded; and
    // after them all, the world's spawn, moved up or down to where they fit.
    fn search_spawn(mut self, con: mut Connection) {
        loop {
            let candidate = con.prepare.candidate else return
            if not self.levels[0].full(ChunkPos { x: candidate.x >> 4, z: candidate.z >> 4 }) {
                return
            }
            var place: BlockPos? = none
            if let states = self.collisions {
                if candidate.last {
                    let origin = self.respawn.pos
                    place = some(BlockPos { x: origin.x, y: fixup_height(states, self.levels[0], origin.x, origin.y, origin.z, MIN_Y, MIN_Y + SECTIONS * 16 - 1), z: origin.z })
                } else if let pos = self.levels[0].respawn_pos(states, candidate.x, candidate.z) {
                    if fits(states, self.levels[0], pos.x, pos.y, pos.z) {
                        place = some(pos)
                    }
                }
            }
            if let p = place {
                con.prepare.place(f64(p.x) + 0.5, f64(p.y), f64(p.z) + 0.5)
                return
            }
            var search = con.prepare.search.take() else return
            let next = search.next()
            con.prepare.search = some(search)
            self.next_candidate(mut con, next)
        }
    }

    // The joining player's data, as `loadPlayerData` reads it, with what reading it logs, or
    // `none` for a player new to the world. Replaying, it's what the recording read.
    fn player_data(mut self, con: Connection) -> JavaHashMap<String, Tag>? {
        let profile = con.profile else return none
        var lines = List<Entry>()
        var found = FileRead.Absent
        if self.players != none {
            self.wait_saves()
        }
        if let files = self.players {
            let now = self.clock.date_time(unsafe { self.clock.local_offset() })
            if let data = files.load(profile.id, profile.name, now, mut lines) {
                found = FileRead.Read(data)
            }
        }
        let got = self.link.file(found, mut lines)
        for e in lines {
            self.logs.push(e.copy())
        }
        return match got {
            FileRead.Read(data) => some(data),
            _ => none,
        }
    }

    // Sends a keep-alive if one is due at `now`, as `keepConnectionAlive`. False when the last
    // one went unanswered, so the connection is closed.
    fn keep_alive(mut self, con: mut Connection, now: u64) -> bool {
        let ms = millis(now)
        if ms - con.keep_alive_time >= KEEP_ALIVE_MS {
            if con.keep_alive_pending {
                self.disconnect(mut con, Component.translatable("disconnect.timeout", []))
                self.close(mut con)
                return false
            }
            con.keep_alive_pending = true
            con.keep_alive_time = ms
            let state = con.outbound
            self.send(mut con, ClientboundKeepAlive { challenge: ms }, state)
        }
        return true
    }

    // The answer to a keep-alive, as `handleKeepAlive`: the latency moves a quarter of the way
    // to the time it took. An answer to none ends the connection. False when it's to close.
    fn answer_keep_alive(mut self, con: mut Connection, k: ServerboundKeepAlive, now: u64) -> bool {
        if con.keep_alive_pending and k.challenge == con.keep_alive_time {
            let time = i32.wrap(millis(now) - con.keep_alive_time)
            con.latency = (con.latency * 3 + time) / 4
            con.keep_alive_pending = false
            return true
        }
        self.disconnect(mut con, Component.translatable("disconnect.timeout", []))
        return false
    }

    // A configuration packet, at `now`, as the configuration listener's handlers and those it
    // shares with play. False when the connection is to close. Vanilla handles the packets
    // that change what the server holds on its own thread, where an exception is logged and
    // the connection goes on, and the rest as they're read, where an exception ends it.
    fn configuration_packet(mut self, con: mut Connection, p: ConfigurationIn, now: u64) -> bool {
        match p {
            ConfigurationIn.ClientInformation(c) => {
                con.information = c.information.copy()
                return true
            },
            ConfigurationIn.CookieResponse(_) => {
                // The server asks for no cookies.
                self.disconnect(mut con, Component.translatable("multiplayer.disconnect.unexpected_query_response", []))
                return false
            },
            // Plugin channels, pongs and custom click actions are for plugins, so far.
            ConfigurationIn.CustomPayload(_) => return true,
            ConfigurationIn.Pong(_) => return true,
            ConfigurationIn.CustomClickAction(_) => return true,
            ConfigurationIn.KeepAlive(k) => return self.answer_keep_alive(mut con, k, now),
            ConfigurationIn.AcceptCodeOfConduct(_) => {
                if let problem = self.finish_task(mut con, Task.CodeOfConduct) {
                    self.fault(mut con, problem)
                    return false
                }
                return true
            },
            ConfigurationIn.SelectKnownPacks(answer) => {
                // Vanilla sends the registries for each answer, even one it didn't ask for.
                let known = self.configuration.accepts(answer.packs)
                self.synchronize(mut con, known)
                if let problem = self.finish_task(mut con, Task.SynchronizeRegistries) {
                    var packs = String()
                    for k in answer.packs {
                        if not packs.is_empty() {
                            packs.push_str(", ")
                        }
                        packs.push_str("{k.namespace}:{k.id}:{k.version}")
                    }
                    self.suppress("ServerboundSelectKnownPacks[knownPacks=[{packs}]]", problem)
                }
                return true
            },
            ConfigurationIn.ResourcePack(r) => {
                var required = false
                if let pack = self.configuration.pack {
                    required = pack.required
                }
                if r.action == ResourcePackAction.Declined and required {
                    var name = String()
                    if let profile = con.profile {
                        name = profile.name.copy()
                    }
                    self.logs.push(Entry.info("Disconnecting {name} due to resource pack {r.pack.to_string()} rejection"))
                    self.disconnect(mut con, Component.translatable("multiplayer.requiredTexturePrompt.disconnect", []))
                    return false
                }
                if r.action.is_terminal() {
                    if let problem = self.finish_task(mut con, Task.ResourcePack) {
                        self.suppress("ServerboundResourcePackPacket[id={r.pack.to_string()}, action={action_name(r.action)}]", problem)
                    }
                }
                return true
            },
            ConfigurationIn.FinishConfiguration(_) => {
                if let problem = self.finish_task(mut con, Task.JoinWorld) {
                    // Vanilla's packet has no `toString` of its own, so it names its class and
                    // the instance's hash code, which changes from run to run and is left out.
                    self.suppress("net.minecraft.network.protocol.configuration.ServerboundFinishConfigurationPacket", problem)
                    return true
                }
                // Play's listener is new, `ServerGamePacketListenerImpl`, so its keep-alive
                // timer starts now, with none pending, as `ServerCommonPacketListenerImpl`'s
                // constructor has it (D517).
                con.keep_alive_time = millis(now)
                con.keep_alive_pending = false
                self.join(mut con)
                return true
            },
        }
    }

    // Sends the registries, as `SynchronizeRegistriesTask.handleResponse`: the entries of the
    // packs a client knows by name alone if `known`, as it has every pack it was asked about, and
    // every entry with its contents if not.
    fn synchronize(mut self, con: mut Connection, known: bool) {
        let n = if known { self.configuration.synced.len() } else { self.configuration.full.len() }
        for i in 0..n {
            let p = if known { self.configuration.synced[i].copy() } else { self.configuration.full[i].copy() }
            self.send_bytes(mut con, p)
        }
    }

    // What vanilla's `ServerPacketListener.onPacketError` logs of an exception handling a packet
    // on its own thread, before it goes on: the packet as its `toString` writes it, then the
    // exception's first line, which its stack trace would follow.
    fn suppress(mut self, packet: String, exception: String) {
        self.logs.push(Entry.error("Failed to handle packet {packet}, suppressing error\n{exception}"))
    }

    // The client has finished configuring, so the player joins the world, as vanilla's
    // `handleConfigurationFinished` switches to play and `PlayerList.placeNewPlayer` places
    // them, in its order: the world and what they may do in it, the recipes and commands, the
    // join message for the others, their place, the server's description, the tab list, the
    // world's border, time and spawn, then their view of the world, whose chunks go as the
    // tick it's run in ticks the connections, and their inventory.
    fn join(mut self, con: mut Connection) {
        con.outbound = State.Play
        con.phase = Phase.Play
        var found: GameProfile? = none
        if let p = con.profile {
            found = some(p.copy())
        }
        let profile = found else return
        self.entity_ids += 1
        let id = self.entity_ids
        // `Entity`'s random, which its UUID draws two longs of, though a player's is their
        // profile's, then `LivingEntity`'s constructor a float for its yaw (CAL-148).
        var random = LegacyRandom.new(self.entity_seed(id))
        _ = random.next_long()
        _ = random.next_long()
        _ = random.next_float()
        let chat_spam = Throttler.per_second(self.world.settings.chat_spam_threshold_seconds)
        let command_spam = Throttler.per_second(self.world.settings.command_spam_threshold_seconds)
        // The player is put at the spawn task's place and angle, as `snapTo` puts them: a yaw
        // or pitch that isn't finite is left at 0, and the pitch is kept from -90 to 90.
        let y_rot = if finite(con.prepare.y_rot) { con.prepare.y_rot } else { 0.0f32 }
        var x_rot = 0.0f32
        if finite(con.prepare.x_rot) {
            x_rot = con.prepare.x_rot % 360.0f32
            if x_rot < -90.0f32 {
                x_rot = -90.0f32
            } else if x_rot > 90.0f32 {
                x_rot = 90.0f32
            }
        }
        let saved_data = con.prepare.data.take()
        // Their game modes and abilities, as `loadGameTypes` reads them and
        // `calculateGameModeForNewPlayer` picks the mode: the default where `force-gamemode` is on
        // or they have none (D239).
        var kept = Abilities()
        var saved_mode: GameType? = none
        var previous: GameType? = none
        var selected = 0
        var inventory = Inventory.empty()
        var ender = EnderChest.empty()
        // Their attributes, as `readAdditionalSaveData` reads them: those saved, then their
        // movement speed's base, their abilities' walking speed; none for a player new to the
        // world. Calcite doesn't upgrade older data yet, so its `attributes` are kept (D375).
        var attributes = Attributes()
        var old_attributes = false
        let reads_items = self.items_ready()
        if let d = saved_data {
            kept = saved_abilities(d)
            saved_mode = saved_game_type(d, "playerGameType")
            previous = saved_game_type(d, "previousPlayerGameType")
            selected = saved_slot(d)
            if reads_items {
                if let items = self.items {
                    inventory = Inventory.read(d, items, data_version_or(d, -1) < DATA_VERSION)
                    ender = EnderChest.read(d, items, data_version_or(d, -1) < DATA_VERSION)
                }
            }
            old_attributes = data_version_or(d, -1) < DATA_VERSION
            if not old_attributes and d.contains("attributes") {
                attributes.apply(d["attributes"])
            }
            attributes.set_base(attribute_id(String("movement_speed")) ?? 0, f64(kept.walking_speed))
        }
        var mode = saved_mode ?? self.world.settings.game_type
        if self.world.settings.force_game_mode {
            mode = self.world.settings.game_type
        }
        kept.update(mode)
        self.joins += 1
        con.player = Player { entity_id: id, x: con.prepare.x, y: con.prepare.y, z: con.prepare.z, y_rot: y_rot, x_rot: x_rot, last_seen: LastSeenValidator.new(), chat_spam: chat_spam, command_spam: command_spam, data: saved_data, mode: mode, previous_mode: previous, abilities: kept, level: self.access.level(profile.id), joined: self.joins, sender: ChunkSender.with_rate(self.world.settings.chunk_send_cap, self.world.settings.chunk_send_multiplier, self.world.settings.chunk_send_boost), dim: con.prepare.dim, selected: selected, inventory: inventory, ender: ender, attributes: attributes, worn: unworn(), old_attributes: old_attributes, entity_data: player_data(), random: some(random) }
        // Their statistics, as `getPlayerStats` makes them with the player, before their
        // advancements: their file found, `locateStatsFile`, and read, then all marked to be sent,
        // `markAllDirty`, as `placeNewPlayer` marks them (CAL-164).
        var stats_lines = List<Entry>()
        var stats_path = String()
        var stats_json: Json? = none
        if let files = self.stats_files {
            stats_path = files.locate(profile.id.to_string(), profile.name.copy(), mut stats_lines)
            stats_json = files.load(stats_path, mut stats_lines)
        }
        let (stats_read, stats_found) = self.link.json_file(stats_path, stats_json, mut stats_lines)
        if let codecs = self.items {
            con.player.stats = PlayerStats.loaded(codecs, stats_found, stats_read, mut stats_lines)
        }
        con.player.stats.mark_all_dirty()
        for e in stats_lines {
            self.logs.push(e.copy())
        }
        // Their advancements, as `getPlayerAdvancements` makes them with the player: their file
        // read, then each criterion listened for (CAL-164).
        if let a = self.world.advancements.copy() {
            var lines = List<Entry>()
            var path = String()
            var file_json: Json? = none
            if let files = self.progress_files {
                path = files.file(profile.id.to_string())
                file_json = files.load(path, mut lines)
            }
            let (read_path, json) = self.link.json_file(path, file_json, mut lines)
            con.player.advancements = PlayerAdvancements.loaded(a.value, json, read_path, mut lines)
            for e in lines {
                self.logs.push(e.copy())
            }
        }
        // Their recipe book, as `readAdditionalSaveData` reads it from their data (CAL-164).
        if let shared = self.world.recipes.copy() {
            if let data = con.player.data.copy() {
                if data.contains(String("recipeBook")) {
                    var lines = List<Entry>()
                    con.player.recipe_book = RecipeBook.loaded(shared.value, data[String("recipeBook")].copy(), mut lines)
                    for e in lines {
                        self.logs.push(e.copy())
                    }
                }
            }
        }
        // Their health and the rest of their status, as `readAdditionalSaveData` reads them, then
        // their skin parts and main hand, `updateOptions` (CAL-141).
        let (max_health, max_absorption) = player_maxes(con.player.attributes)
        let saved = con.player.data.copy()
        // Their motion and fall, as `Entity.load` reads them (D418).
        let (mx, my, mz, fell) = saved_motion(con.player.data.copy())
        con.player.vx = mx
        con.player.vy = my
        con.player.vz = mz
        con.player.fall = fell
        // `Entity.load`'s `needsSync`, for their tracker's first run (CAL-174).
        con.player.needs_sync = con.player.data != none
        // Their impulse, as `LivingEntity.readAdditionalSaveData` reads it, and their smash's dust,
        // as `ServerPlayer`'s does (D443).
        let (grace, impact, dust) = saved_impulse(con.player.data.copy())
        con.player.impulse_grace = grace
        con.player.impulse_at = impact
        con.player.extra_fall_particles = dust
        // `Fire`, as `Entity.load` reads it (D434).
        var fire = 0
        if let loaded = con.player.data {
            if loaded.contains("Fire") {
                fire = loaded["Fire"].number_int() ?? 0
            }
        }
        con.player.fire = fire
        // `PortalCooldown`, as `Entity.load` reads it, and `entered_nether_pos`, as
        // `ServerPlayer` does (D577).
        var cooldown = 0
        var entered: (f64, f64, f64)? = none
        if let loaded = con.player.data {
            if loaded.contains("PortalCooldown") {
                cooldown = loaded["PortalCooldown"].number_int() ?? 0
            }
            entered = vec3_of(loaded, "entered_nether_pos")
        }
        con.player.portal_cooldown = cooldown
        con.player.entered_nether = entered
        // `seenCredits`, as `ServerPlayer` reads it (D586).
        var credits = false
        if let loaded = con.player.data {
            if loaded.contains("seenCredits") {
                credits = (loaded["seenCredits"].number_int() ?? 0) != 0
            }
        }
        con.player.seen_credits = credits
        // `SleepTimer`, a short, and `respawn`, as `Player` and `ServerPlayer` read them (D574).
        // Where they slept, `sleeping_pos`, is let go, as they're woken as they're read.
        var slept = 0
        var respawn_at: RespawnConfig? = none
        if let loaded = con.player.data {
            if loaded.contains("SleepTimer") {
                slept = i32(i16.wrap(loaded["SleepTimer"].number_int() ?? 0))
            }
            if loaded.contains("respawn") {
                respawn_at = RespawnConfig.read(loaded["respawn"].copy())
            }
        }
        con.player.sleep_counter = slept
        con.player.respawn = respawn_at
        con.player.old_x = con.player.x
        con.player.old_y = con.player.y
        con.player.old_z = con.player.z
        // `DeathTime` and `LastDeathLocation`, as `readAdditionalSaveData` reads them (D427).
        let (death_time, last_death) = saved_death(con.player.data.copy())
        con.player.death_time = death_time
        con.player.last_death = last_death
        con.player.status = read_status(saved, mut con.player.entity_data, max_health, max_absorption)
        // Their effects, `active_effects`, as `readAdditionalSaveData` reads them (D514).
        con.player.effects = PlayerEffects.read(con.player.data.copy())
        // An enchantment seed of 0 is drawn anew from the player's own random, as
        // `readAdditionalSaveData` draws it for a player whose data is read (CAL-148).
        if con.player.status.xp_seed == 0 and con.player.data != none {
            var r = con.player.random ?? LegacyRandom.new(0)
            con.player.status.xp_seed = r.next_int()
            con.player.random = some(r)
        }
        let information = con.information.copy()
        update_options(mut con.player.entity_data, information)
        self.logs.push(Entry.info("{profile.name}[{con.address}] logged in with entity id {id} at ({con.player.x}, {con.player.y}, {con.player.z})").calcite(Look.Join(joined_words(profile.name, con.address))))
        let spawn = self.spawn_info(con.player.dim, mode, previous, con.player.last_death.copy(), con.player.portal_cooldown)
        let secure = self.enforces_secure_chat()
        var levels = List<Identifier>()
        for dim in self.world.dims {
            levels.push(dim.id.copy())
        }
        let login = ClientboundLogin { player_id: id, hardcore: self.world.settings.hardcore, levels: levels, max_players: self.world.settings.max_players, chunk_radius: self.world.settings.chunk_radius(), simulation_distance: self.world.settings.simulation_distance, reduced_debug_info: false, show_death_screen: true, do_limited_crafting: false, spawn: spawn, online_mode: self.settings.online_mode, enforces_secure_chat: secure }
        self.send(mut con, login, State.Play)
        let difficulty = self.world.settings.difficulty
        self.send(mut con, ClientboundChangeDifficulty { difficulty: difficulty, locked: false }, State.Play)
        let abilities = con.player.abilities
        self.send(mut con, ClientboundPlayerAbilities { abilities: abilities }, State.Play)
        let slot = con.player.selected
        self.send(mut con, ClientboundSetHeldSlot { slot: slot }, State.Play)
        // The recipes' property sets and the stonecutter's recipes (CAL-146). Then their
        // permission level, as `sendPlayerPermissionLevel` sends it, an entity event from 24 up,
        // and the commands it lets them use.
        let update = self.update_recipes()
        self.send(mut con, update, State.Play)
        let level = con.player.level
        self.send(mut con, ClientboundEntityEvent { entity_id: id, event: i8.wrap(24 + level) }, State.Play)
        self.send(mut con, tree(level), State.Play)
        self.send_recipe_book(mut con)
        self.send_scoreboard(mut con)
        let joined = Component.translatable("multiplayer.player.joined", [self.player_name(profile)]).colored("yellow")
        self.broadcast_system(joined, Look.Quiet)
        let (px, py, pz) = (con.player.x, con.player.y, con.player.z)
        // Where they are kept from the start, as their first tick, which comes before their
        // client's accept, keeps them (D420).
        reset_position(mut con)
        self.teleport(mut con, px, py, pz, y_rot, x_rot)
        if not con.transferred {
            let data = ClientboundServerData { motd: self.status.status.description.copy(), icon: self.status.status.favicon.copy() }
            self.send(mut con, data, State.Play)
        }
        // The tab list: those already in the world to the new player, then the new player to
        // everyone.
        var others = List<PlayerEntry>()
        for c in self.connections {
            if let other = c {
                if in_world(other) {
                    if let e = entry(other, other.player.mode, self.clock.unix_ms) {
                        others.push(e)
                    }
                }
            }
        }
        self.send(mut con, ClientboundPlayerInfoUpdate { info: PlayerInfo.initializing(others) }, State.Play)
        if let e = entry(con, con.player.mode, self.clock.unix_ms) {
            let packet = encode_play(ClientboundPlayerInfoUpdate { info: PlayerInfo.initializing([e]) })
            self.broadcast(packet.copy())
            self.send_bytes(mut con, packet)
        }
        self.level_info(mut con)
        self.enter_level(mut con)
        // The one they are now, as a `ServerPlayer`'s made (D580); then each boss bar whose
        // players they're among shown them, `onPlayerConnect` (D606).
        self.serials += 1
        con.player.serial = self.serials
        self.boss_bars_join(mut con)
        self.send_active_effects(mut con)
        self.send(mut con, ClientboundPostEffects { effects: [] }, State.Play)
        self.init_inventory(mut con)
        // Then, placed, their ender pearls, `loadAndSpawnEnderPearls` (D580).
        self.spawn_saved_pearls(mut con)
    }

    // `loadAndSpawnEnderPearls` of the joining player `con` (D580): each of the pearls their
    // data saved, `ender_pearls`, in the level its `ender_pearl_dimension` names, one naming none
    // passed over, read as the level reads an entity, `loadEntityRecursive`, and added where no
    // entity there has its UUID, `addWithUUID`, among the player's pearls, as `setOwner` has it;
    // then its ticket put about its chunk, `placeEnderPearlTicket`, and the player shown it where
    // it's in their level. One of a level the server hasn't, or that isn't added, is logged as
    // vanilla logs it.
    fn spawn_saved_pearls(mut self, con: mut Connection) {
        let data = con.player.data.copy() else return
        if not data.contains("ender_pearls") {
            return
        }
        let Tag.List(saved) = data["ender_pearls"].copy() else return
        for each in saved {
            let Tag.Compound(m) = each else continue
            if not m.contains("ender_pearl_dimension") {
                continue
            }
            let Tag.Str(name) = m["ender_pearl_dimension"].copy() else continue
            let key = "ResourceKey[minecraft:dimension / {name}]"
            let id = match Identifier.parse(name.copy()) {
                ok(i) => i,
                err(_) => continue,
            }
            let d = self.world.dimension_of(id) else {
                self.logs.push(Entry.warn("Trying to load ender pearl without level ({key}) being loaded, skipping"))
                continue
            }
            var lines = List<Entry>()
            let loaded = self.entity_from(d, m, mut lines)
            for e in lines {
                self.logs.push(e.copy())
            }
            var added = false
            if let ReadEntity.Thrown(t) = loaded {
                let es = self.take_entities(d)
                let taken = es.list.id_with_uuid(t.body.uuid) != none
                self.put_entities(d, es)
                if not taken {
                    var pearl = t.copy()
                    pearl.registered = con.player.serial
                    let pid = pearl.body.id
                    let chunk = ChunkPos.containing(pearl.body.x, pearl.body.z)
                    self.add_thrown(d, pearl)
                    if d == con.player.dim and not con.player.removed {
                        self.item_sees(d, pid, mut con)
                    }
                    // `registerAndUpdateEnderPearlTicket`: its level's empty time none (D621).
                    self.levels[d].empty_time = 0
                    self.levels[d].load_pearl(chunk)
                    added = true
                }
            }
            if not added {
                self.logs.push(Entry.warn("Failed to spawn player ender pearl in level ({key}), skipping"))
            }
        }
    }

    // The serial of the player of the UUID `owner` in the world, `Player.serial`, 0 for none or
    // none there (D580).
    fn serial_of(self, owner: (i64, i64)?) -> i64 {
        let (most, least) = owner else return 0
        for slot in 0..self.connections.len() {
            let c = self.connections[slot] else continue
            if not in_world(c) {
                continue
            }
            if let p = c.profile {
                if p.id.most == most and p.id.least == least {
                    return c.player.serial
                }
            }
        }
        return 0
    }

    // What's saved of the player `con`'s ender pearls, `saveEnderPearls` (D580): each among
    // theirs in each level, `saveAsPassenger`, with that level's name, `ender_pearl_dimension`.
    fn saved_pearls(self, con: Connection) -> List<Tag> {
        var out = List<Tag>()
        for d in 0..self.entities.len() {
            let es = self.entities[d] else continue
            for (_, saved) in es.list.pearls_of(con.player.serial) {
                if let Tag.Compound(m) = saved {
                    var t = m.copy()
                    t.insert(String("ender_pearl_dimension"), Tag.Str(self.world.dims[d].id.to_string()))
                    out.push(Tag.Compound(t))
                }
            }
        }
        return out
    }

    // The player `con`'s ender pearls taken out with them as they leave, `UNLOADED_WITH_PLAYER`
    // (D580): out of their levels, those who saw them told, kept among the player's, so saved
    // with them and not with their chunks.
    fn unload_pearls(mut self, con: Connection) {
        for d in 0..self.entities.len() {
            if self.entities[d] == none {
                continue
            }
            var es = self.take_entities(d)
            for (id, _) in es.list.pearls_of(con.player.serial) {
                es.list.remove(id)
            }
            for g in es.list.take_gone() {
                self.item_gone(mut es, g)
            }
            self.put_entities(d, es)
        }
    }

    // What `sendLevelInfo` sends a player of the level they're in, and the tick rate, as
    // `updateJoiningPlayer` sends it.
    fn level_info(mut self, con: mut Connection) {
        let d = con.player.dim
        let border = self.world.dims[d].border.packet()
        self.send(mut con, border, State.Play)
        let time = ClientboundSetTime { game_time: self.world.game_time, clocks: self.world.clocks.updates(self.world.advance_time) }
        self.send(mut con, time, State.Play)
        let respawn = ClientboundSetDefaultSpawnPosition { pos: GlobalPos { dimension: self.respawn.dimension.copy(), pos: self.respawn.pos }, yaw: self.respawn.yaw, pitch: self.respawn.pitch }
        self.send(mut con, respawn, State.Play)
        // If it's raining there, that it is, and how hard, as `sendLevelInfo` says (CAL-105).
        if self.world.dims[d].weathered {
            for e in weather_joining(self.world.dims[d].weather) {
                self.send(mut con, ClientboundGameEvent { event: e.event, param: e.param }, State.Play)
            }
        }
        self.send(mut con, ClientboundGameEvent { event: LEVEL_CHUNKS_LOAD_START, param: 0.0 }, State.Play)
        self.send(mut con, ClientboundTickingState { tick_rate: 20.0, frozen: false }, State.Play)
        self.send(mut con, ClientboundTickingStep { steps: 0 }, State.Play)
    }

    // Puts the player in their dimension's level, as `ChunkMap.addEntity` and
    // `updatePlayerStatus` add them: their tickets go in their section, then their view, then
    // what they see is paired with them. Their tickets wait for the levels' next settling, in the
    // level's tick or after the server's, as vanilla's wait for the distance manager's next run,
    // so a respawn's chunks that dropped as the dead player left aren't ready to send yet, and
    // what's in them stays paired through the player's first move (D446).
    fn enter_level(mut self, con: mut Connection) {
        let chunk = ChunkPos.containing(con.player.x, con.player.z)
        con.player.section_x = chunk.x
        con.player.section_y = section(con.player.y)
        con.player.section_z = chunk.z
        let d = con.player.dim
        // `onCreated`'s locator bar, as the entity manager takes them in, before they're tracked:
        // the waypoint they transmit tracked, `trackWaypoint`, linking each receiver there to it,
        // none on their first tick (D577).
        self.waypoints_created(mut con)
        // `ChunkMap.addEntity`: their tracker, made from where they are, as it looks whether the
        // level's players see them (CAL-174); then, after their tickets and view, each other
        // tracker looks whether they see its entity (CAL-148). Come from another level, it takes
        // up the path their last kept (D577).
        var tr = Tracker.of_player(tracked_body(con), con.player.y_head_rot, con.player.entity_data.pack_non_default())
        if let carried = con.player.carried_path.copy() {
            let (steps, since) = carried
            tr.take_path(steps, since)
        }
        con.player.carried_path = none
        for slot in self.level_slots(d) {
            var viewer = self.connections[slot].take() else continue
            self.player_seen(mut tr, con, mut viewer)
            self.connections[slot] = some(viewer)
        }
        self.levels[d].add_player(chunk, con.player.entity_id)
        self.entries += 1
        con.player.entered = self.entries
        self.track(mut con, true)
        var es = self.take_entities(d)
        es.tracked.insert(con.player.entity_id, true)
        es.trackers.insert(con.player.entity_id, tr)
        self.put_entities(d, es)
        self.items_see(mut con, false)
        self.waypoints_enter(mut con)
        // `onTrackingStart`'s: the level's sleepers counted again (D574).
        self.sleepers_with(d, mut con)
    }

    // The inventory menu's 46 slots, as `sendAllDataToRemote` sends them, its state up one: what's
    // in the player's inventory, or nothing in a world without its registries (D372).
    fn send_inventory(mut self, con: mut Connection) {
        con.player.menu_state = (con.player.menu_state + 1) & 32767
        var slots = List<SentStack>()
        for n in 0..MENU_SLOTS {
            slots.push(self.sent_stack(con.player.inventory.menu_slot(n)))
        }
        let carried = self.sent_stack(con.player.menu.carried)
        // The client has it all now, as `RemoteSlot.force` takes it (D374).
        con.player.menu.sent_all(Slots { inv: con.player.inventory.copy() })
        let state = con.player.menu_state
        self.send(mut con, ClientboundContainerSetContent { container_id: 0, state_id: state, items: slots, carried: carried }, State.Play)
    }

    // A stack as `ItemStack.CODEC` writes it, as a packet sends it, or nothing in a world
    // without its registries.
    fn sent_stack(mut self, stack: Tag?) -> SentStack {
        if not self.items_ready() {
            return SentStack.empty()
        }
        if let given = stack {
            if let streams = self.streams {
                if let r = self.world.registries {
                    return ItemStack.from_saved(given).sent(streams, r.value)
                }
            }
        }
        return SentStack.empty()
    }

    // `broadcastChanges` of the menu the player has open, `containerMenu`, as `ServerPlayer.tick`
    // and each click run it: a container's, where they have one open (CAL-144), else their
    // inventory menu's.
    fn broadcast_menu(mut self, con: mut Connection) {
        if con.player.container != none {
            self.broadcast_container(mut con)
        } else {
            self.broadcast_inventory(mut con)
        }
    }

    // `broadcastChanges` of the player's inventory menu, a slot at a time: what its listeners see
    // changed, `triggerSlotListeners`, which sets off `inventory_changed` for the inventory's own
    // slots (CAL-164), then the slot, where the client hasn't got it, sent as `container_set_slot`
    // with the menu's next state ID; then the cursor's, as `set_cursor_item` (D374).
    fn broadcast_inventory(mut self, con: mut Connection) {
        if not self.items_ready() {
            return
        }
        for n in 0..MENU_SLOTS {
            let current = con.player.inventory.menu_slot(n)
            if con.player.menu.listen(n, current.copy()) and n >= 5 {
                self.inventory_changed(mut con, current.copy())
            }
            let taken = self.items.take() else return
            let send = con.player.menu.sync_slot(n, current.copy(), taken)
            self.items = some(taken)
            if send {
                let sent = self.sent_stack(current)
                con.player.menu_state = (con.player.menu_state + 1) & 32767
                let state = con.player.menu_state
                self.send(mut con, ClientboundContainerSetSlot { container_id: 0, state_id: state, slot: i16.wrap(n), stack: sent }, State.Play)
            }
        }
        let taken = self.items.take() else return
        let carried = con.player.menu.sync_carried(taken)
        self.items = some(taken)
        if carried {
            let sent = self.sent_stack(con.player.menu.carried)
            self.send(mut con, ClientboundSetCursorItem { stack: sent }, State.Play)
        }
    }

    // `initInventoryMenu`: the inventory menu's listener added, whose `broadcastChanges`, before
    // there's anything to send the client by, tells it of each slot as a new menu's, setting off
    // `inventory_changed` for each stack in the inventory (CAL-164); then all of it sent,
    // `sendAllDataToRemote`.
    fn init_inventory(mut self, con: mut Connection) {
        con.player.menu.new_listener()
        self.listen_inventory(mut con)
        self.send_inventory(mut con)
    }

    // `broadcastFullState`: each slot told to the listeners, then all of it sent.
    fn broadcast_full(mut self, con: mut Connection) {
        self.listen_inventory(mut con)
        self.send_inventory(mut con)
    }

    // `triggerSlotListeners` of each of the inventory menu's slots.
    fn listen_inventory(mut self, con: mut Connection) {
        if not self.items_ready() {
            return
        }
        for n in 0..MENU_SLOTS {
            let current = con.player.inventory.menu_slot(n)
            if con.player.menu.listen(n, current.copy()) and n >= 5 {
                self.inventory_changed(mut con, current)
            }
        }
    }

    // `CriteriaTriggers.INVENTORY_CHANGED.trigger` for the player, one of whose inventory's slots
    // came to hold `changed` (CAL-164): how many of the inventory's 43 slots, its 36 and then its
    // equipment's feet, legs, chest, head, offhand, body and saddle, are full, empty and
    // occupied; then each criterion listening whose bounds of those hold and whose items are there,
    // one alone being `changed`, more each in some slot, and whose player's condition holds,
    // awarded.
    fn inventory_changed(mut self, con: mut Connection, changed: Tag?) {
        let listening = con.player.advancements.listening(String("minecraft:inventory_changed"))
        if listening.is_empty() {
            return
        }
        let d = con.player.dim
        let shared = self.levels[d].world_loot() else return
        var slots = List<Tag?>()
        for s in con.player.inventory.items {
            slots.push(s.copy())
        }
        for e in [2usize, 3usize, 4usize, 5usize, 1usize, 6usize, 7usize] {
            slots.push(con.player.inventory.equipment[e].copy())
        }
        var full: i32 = 0
        var empty: i32 = 0
        var occupied: i32 = 0
        for s in slots {
            match s {
                some(stack) => {
                    occupied += 1
                    let most = match self.stack_component(stack.copy(), String("minecraft:max_stack_size")) {
                        some(m) => m.number_int() ?? 1,
                        none => 1,
                    }
                    if count_of(stack) >= most {
                        full += 1
                    }
                },
                none => empty += 1,
            }
        }
        var matched = List<Listener>()
        var missing = List<String>()
        for (key, conditions) in listening {
            let bounds = field_of(conditions, "slots")
            if not ints_hold(field_of(bounds, "full"), full) or not ints_hold(field_of(bounds, "empty"), empty) or not ints_hold(field_of(bounds, "occupied"), occupied) {
                continue
            }
            let wanted = match field_of(conditions, "items") {
                Tag.List(l) => l.copy(),
                _ => List<Tag>(),
            }
            if wanted.len() == 1 {
                if changed == none or not item_holds(shared.value, wanted[0], changed.copy(), mut missing) {
                    continue
                }
            } else if not wanted.is_empty() {
                var left = wanted.copy()
                for s in slots {
                    if left.is_empty() {
                        break
                    }
                    if let stack = s {
                        var still = List<Tag>()
                        for p in left {
                            if not item_holds(shared.value, p, some(stack.copy()), mut missing) {
                                still.push(p.copy())
                            }
                        }
                        left = still
                    }
                }
                if not left.is_empty() {
                    continue
                }
            }
            if not self.player_holds(con, conditions) {
                continue
            }
            matched.push(key.copy())
        }
        for m in missing {
            self.levels[d].unimplemented(m)
        }
        self.award_all(mut con, matched)
    }

    // `CriteriaTriggers.CONSUME_ITEM.trigger` for the player, who used up `stack` (CAL-164).
    fn consume_item(mut self, con: mut Connection, stack: Tag) {
        self.item_trigger(mut con, "minecraft:consume_item", stack)
    }

    // The trigger `trigger` of a stack alone, such as `CONSUME_ITEM` and `USED_TOTEM`, for the
    // player, of `stack` (CAL-164): each criterion listening whose `item`, if it has one, holds of
    // the stack, and whose player's condition holds, awarded.
    fn item_trigger(mut self, con: mut Connection, trigger: str, stack: Tag) {
        let listening = con.player.advancements.listening(String(trigger))
        if listening.is_empty() {
            return
        }
        let d = con.player.dim
        let shared = self.levels[d].world_loot() else return
        var matched = List<Listener>()
        var missing = List<String>()
        for (key, conditions) in listening {
            let wanted = field_of(conditions, "item")
            if wanted != Tag.End and not item_holds(shared.value, wanted, some(stack.copy()), mut missing) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        for m in missing {
            self.levels[d].unimplemented(m)
        }
        self.award_all(mut con, matched)
    }

    // `CriteriaTriggers.ENTER_BLOCK.trigger` for the player, inside the block `state`,
    // `onInsideBlock` (CAL-164): each criterion listening whose `blocks` and `state` hold of it,
    // and whose player's condition holds, awarded.
    fn entered_block(mut self, con: mut Connection, f: Facts, state: u32) {
        let listening = con.player.advancements.listening(String("minecraft:enter_block"))
        if listening.is_empty() {
            return
        }
        var matched = List<Listener>()
        for (key, conditions) in listening {
            if not state_holds(f, field_of(conditions, "blocks"), field_of(conditions, "state"), state) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        self.award_all(mut con, matched)
    }

    // The `trigger` of `ItemUsedOnLocationTrigger`, `DefaultBlockInteractionTrigger` or
    // `AnyBlockInteractionTrigger`, `trigger` its whole ID, for the player, of the block at `x`,
    // `y`, `z` and, where `has_tool`, the stack `tool`, `none` for nothing (CAL-164): each
    // criterion listening whose `location` holds, tested at the block's centre with the player as
    // `this`, the block's state and the tool, with the level's random, and whose player's
    // condition holds, awarded.
    fn location_trigger(mut self, con: mut Connection, trigger: str, x: i32, y: i32, z: i32, has_tool: bool, tool: Tag?) {
        let listening = con.player.advancements.listening(String(trigger))
        if listening.is_empty() {
            return
        }
        let d = con.player.dim
        let shared = self.levels[d].world_loot() else return
        let env = self.levels[d].shared_env() else return
        let Env { facts: f, .. } = env.value
        let state = self.block_at(d, f, x, y, z) ?? f.ids.air_state
        let me = self.looted(con) else return
        let params = LootParams { origin: some((f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5)), this_entity: true, this: some(me), state: some(state), has_tool: has_tool, tool: tool.copy() }
        var matched = List<Listener>()
        var missing = List<String>()
        for (key, conditions) in listening {
            let location = field_of(conditions, "location")
            if location != Tag.End {
                var random = self.levels[d].lend_level_random()
                let holds = condition_holds(shared.value, f, self.levels[d], mut random, location, params, mut missing)
                self.levels[d].give_back_level_random(random)
                if not holds {
                    continue
                }
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        for m in missing {
            self.levels[d].unimplemented(m)
        }
        self.award_all(mut con, matched)
    }

    // `CriteriaTriggers.CONSTRUCT_BEACON.trigger` for the player, by a beacon come on at `levels`
    // (CAL-164): each criterion listening whose `level` holds of them and whose player's condition
    // holds, awarded.
    fn beacon_constructed(mut self, con: mut Connection, levels: i32) {
        let listening = con.player.advancements.listening(String("minecraft:construct_beacon"))
        if listening.is_empty() {
            return
        }
        var matched = List<Listener>()
        for (key, conditions) in listening {
            let level = field_of(conditions, "level")
            if level != Tag.End and not ints_hold(level, levels) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        self.award_all(mut con, matched)
    }

    // `CriteriaTriggers.EFFECTS_CHANGED.trigger` for the player, their effects changed (CAL-164):
    // each criterion listening whose `effects` hold of their effects as they are now and whose
    // player's condition holds, awarded. The entity an effect came from isn't known yet, so a
    // criterion with a `source` doesn't hold, as of an effect from nothing.
    fn effects_changed(mut self, con: mut Connection) {
        let listening = con.player.advancements.listening(String("minecraft:effects_changed"))
        if listening.is_empty() {
            return
        }
        var matched = List<Listener>()
        for (key, conditions) in listening {
            let wanted = field_of(conditions, "effects")
            if wanted != Tag.End and not effects_hold(con.player.effects, wanted) {
                continue
            }
            if field_of(conditions, "source") != Tag.End {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        self.award_all(mut con, matched)
    }

    // `CriteriaTriggers.LEVITATION.trigger` for the player, levitating for `ticks` since they were
    // at `sx`, `sy`, `sz` (CAL-164): each criterion listening whose `distance` holds from there to
    // where they are, whose `duration` holds of the ticks, and whose player's condition holds,
    // awarded.
    fn levitated(mut self, con: mut Connection, sx: f64, sy: f64, sz: f64, ticks: i32) {
        let listening = con.player.advancements.listening(String("minecraft:levitation"))
        if listening.is_empty() {
            return
        }
        var matched = List<Listener>()
        for (key, conditions) in listening {
            let distance = field_of(conditions, "distance")
            if distance != Tag.End and not distance_holds(distance, sx, sy, sz, con.player.x, con.player.y, con.player.z) {
                continue
            }
            let duration = field_of(conditions, "duration")
            if duration != Tag.End and not ints_hold(duration, ticks) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        self.award_all(mut con, matched)
    }

    // `CriteriaTriggers.BRED_ANIMALS.trigger` for the player of the UUID `who` in the level `d`,
    // who made `parent` and `partner` fall in love and breed `child` (CAL-164), where they're
    // there.
    fn bred_animals(mut self, d: usize, who: (i64, i64), parent: LootEntity?, partner: LootEntity?, child: LootEntity) {
        let (most, least) = who
        for slot in 0..self.connections.len() {
            if not self.playing(slot) {
                continue
            }
            var con = self.connections[slot].take() else continue
            let found = match con.profile {
                some(p) => p.id.most == most and p.id.least == least and con.player.dim == d,
                none => false,
            }
            if found {
                self.bred_for(mut con, parent.copy(), partner.copy(), child.copy())
            }
            self.connections[slot] = some(con)
            if found {
                return
            }
        }
    }

    // `ANIMALS_BRED`, then `BRED_ANIMALS`, for the player of `con` (CAL-164): each criterion
    // listening whose `child`
    // holds of the baby, whose `parent` and `partner` hold of the parents, either way round, and
    // whose player's condition holds, awarded.
    fn bred_for(mut self, con: mut Connection, parent: LootEntity?, partner: LootEntity?, child: LootEntity) {
        con.player.stats.award_custom("animals_bred", 1)
        let listening = con.player.advancements.listening(String("minecraft:bred_animals"))
        if listening.is_empty() {
            return
        }
        var matched = List<Listener>()
        for (key, conditions) in listening {
            let wanted = field_of(conditions, "child")
            if wanted != Tag.End and not self.entity_condition(con, wanted, child.copy()) {
                continue
            }
            let mother = field_of(conditions, "parent")
            let father = field_of(conditions, "partner")
            var holds = self.maybe_holds(con, mother.copy(), parent.copy()) and self.maybe_holds(con, father.copy(), partner.copy())
            if not holds {
                holds = self.maybe_holds(con, mother, partner.copy()) and self.maybe_holds(con, father, parent.copy())
            }
            if not holds {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        self.award_all(mut con, matched)
    }

    // Whether a criterion's entity condition `condition` holds of `entity` where `con`'s player
    // is (CAL-164): there's none, or there's the entity and it does.
    fn maybe_holds(mut self, con: Connection, condition: Tag, entity: LootEntity?) -> bool {
        if condition == Tag.End {
            return true
        }
        let e = entity else return false
        return self.entity_condition(con, condition, e)
    }

    // `CriteriaTriggers.ITEM_DURABILITY_CHANGED.trigger` for the player, whose `stack` is to have
    // `durability` left, `delta` less than it had (CAL-164): each criterion listening whose `item`
    // holds of the stack as it was, whose `durability` and `delta` hold, and whose player's
    // condition holds, awarded.
    fn durability_changed(mut self, con: mut Connection, stack: Tag, durability: i32, delta: i32) {
        let listening = con.player.advancements.listening(String("minecraft:item_durability_changed"))
        if listening.is_empty() {
            return
        }
        let d = con.player.dim
        let shared = self.levels[d].world_loot() else return
        var matched = List<Listener>()
        var missing = List<String>()
        for (key, conditions) in listening {
            let wanted = field_of(conditions, "item")
            if wanted != Tag.End and not item_holds(shared.value, wanted, some(stack.copy()), mut missing) {
                continue
            }
            let left = field_of(conditions, "durability")
            if left != Tag.End and not ints_hold(left, durability) {
                continue
            }
            let by = field_of(conditions, "delta")
            if by != Tag.End and not ints_hold(by, delta) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        for m in missing {
            self.levels[d].unimplemented(m)
        }
        self.award_all(mut con, matched)
    }

    // A trigger of a stack and an entity, `trigger` its whole ID, such as
    // `PLAYER_INTERACTED_WITH_ENTITY` and `THROWN_ITEM_PICKED_UP_BY_PLAYER`, for the player, of
    // `stack`, `none` for nothing, and `entity` (CAL-164): each criterion listening whose `item`
    // holds of the stack, whose `entity` holds of the entity where the player is, and whose
    // player's condition holds, awarded.
    fn item_and_entity(mut self, con: mut Connection, trigger: str, stack: Tag?, entity: LootEntity) {
        let listening = con.player.advancements.listening(String(trigger))
        if listening.is_empty() {
            return
        }
        let d = con.player.dim
        let shared = self.levels[d].world_loot() else return
        var matched = List<Listener>()
        var missing = List<String>()
        for (key, conditions) in listening {
            let wanted = field_of(conditions, "item")
            if wanted != Tag.End and not item_holds(shared.value, wanted, stack.copy(), mut missing) {
                continue
            }
            let them = field_of(conditions, "entity")
            if them != Tag.End and not self.entity_condition(con, them, entity.copy()) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        for m in missing {
            self.levels[d].unimplemented(m)
        }
        self.award_all(mut con, matched)
    }

    // `CriteriaTriggers.KILLED_BY_ARROW.trigger` for the player, whose arrow, shot from `weapon`,
    // `none` for none, killed `victims` (CAL-164): each criterion listening whose
    // `fired_from_weapon` holds of the weapon, never where there's none; each of whose `victims`
    // holds of another of them, the first left it holds of, `matches`; whose
    // `unique_entity_types` holds of how many types they're of; and whose player's condition
    // holds, awarded.
    fn killed_by_arrow(mut self, con: mut Connection, victims: List<LootEntity>, weapon: Tag?) {
        let listening = con.player.advancements.listening(String("minecraft:killed_by_arrow"))
        if listening.is_empty() {
            return
        }
        let d = con.player.dim
        let shared = self.levels[d].world_loot() else return
        var kinds = List<String>()
        for v in victims {
            var known = false
            for k in kinds {
                if k == v.kind {
                    known = true
                }
            }
            if not known {
                kinds.push(v.kind.copy())
            }
        }
        let shot = match weapon {
            some(_) => true,
            none => false,
        }
        var matched = List<Listener>()
        var missing = List<String>()
        for (key, conditions) in listening {
            let wanted = field_of(conditions, "fired_from_weapon")
            if wanted != Tag.End and (not shot or not item_holds(shared.value, wanted, weapon.copy(), mut missing)) {
                continue
            }
            var all = true
            if let Tag.List(each) = field_of(conditions, "victims") {
                var left = victims.copy()
                for p in each {
                    var found: usize? = none
                    for k in 0..left.len() {
                        if self.entity_condition(con, p, left[k].copy()) {
                            found = some(k)
                            break
                        }
                    }
                    let k = found else {
                        all = false
                        break
                    }
                    _ = left.remove(k)
                }
            }
            if not all {
                continue
            }
            let types = field_of(conditions, "unique_entity_types")
            if types != Tag.End and not ints_hold(types, i32.wrap(kinds.len())) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        for m in missing {
            self.levels[d].unimplemented(m)
        }
        self.award_all(mut con, matched)
    }

    // A simple trigger's `trigger` for the player, such as `CriteriaTriggers.TICK`'s (CAL-164):
    // each criterion listening for `trigger`, a whole ID, whose player's condition holds, awarded.
    fn trigger_simple(mut self, con: mut Connection, trigger: str) {
        let listening = con.player.advancements.listening(String(trigger))
        if listening.is_empty() {
            return
        }
        var matched = List<Listener>()
        for (key, conditions) in listening {
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        self.award_all(mut con, matched)
    }

    // Whether the player's condition of the criterion whose conditions are `conditions` holds,
    // tested in `EntityPredicate.createContext` of the player, with the level's random: there's
    // none, or it does (CAL-164).
    fn player_holds(mut self, con: Connection, conditions: Tag) -> bool {
        let condition = field_of(conditions, "player")
        if condition == Tag.End {
            return true
        }
        let me = self.looted(con) else return false
        return self.entity_condition(con, condition, me)
    }

    // What loot and a criterion's predicates read of the player, `player_looted`, with the facts
    // that takes made the first time they're asked for (CAL-164).
    fn looted(mut self, con: Connection) -> LootEntity? {
        let d = con.player.dim
        let env = self.levels[d].shared_env() else return none
        let Env { facts: f, .. } = env.value
        if self.item_facts == none {
            self.item_facts = some(BodyFacts.new(f))
        }
        let t = self.item_facts.take() else return none
        let me = self.player_looted(con, f, t)
        self.item_facts = some(t)
        return some(me)
    }

    // What a criterion's predicates read of the entity `id` of the level `d` (CAL-164): of `con`'s
    // player where it's them, of another player, or of a mob or an arrow where the level's
    // entities are in; else nothing, as of one that isn't there.
    fn entity_looted(mut self, d: usize, id: i32, con: Connection) -> LootEntity? {
        if id < 0 {
            return none
        }
        if con.player.entity_id == id {
            return self.looted(con)
        }
        if let (lent, seen) = self.lent_mob {
            if lent == id {
                return some(seen.copy())
            }
        }
        if let slot = self.slot_of_entity(id) {
            let other = self.connections[slot].take() else return none
            let them = self.looted(other)
            self.connections[slot] = some(other)
            return them
        }
        if d >= self.entities.len() or self.entities[d] == none {
            return none
        }
        let es = self.take_entities(d)
        var out: LootEntity? = none
        if es.list.is_mob(id) {
            out = some(es.list.mob(id).loot_entity())
        } else if es.list.is_arrow(id) {
            let a = es.list.arrow(id)
            out = some(LootEntity { kind: String("minecraft:arrow"), at: some((a.body.x, a.body.y, a.body.z)) })
        }
        self.put_entities(d, es)
        return out
    }

    // What a hurt of the damage `source` in the level `d` is to a criterion's damage predicate,
    // `con`'s player being where it's read (CAL-164): what caused it and what dealt it, where
    // they're known, whether they're the same, `isDirect`, and its type's tags.
    fn hit_of(mut self, d: usize, types: DamageTypes, source: Damage, con: Connection) -> Hit {
        let attacker = self.entity_looted(d, source.cause, con)
        let direct = if source.direct == source.cause { attacker.copy() } else { self.entity_looted(d, source.direct, con) }
        return Hit { attacker: attacker, direct: direct, is_direct: source.cause == source.direct, tags: types.tags_of(source.kind) }
    }

    // `DamagePredicate.matches` of `predicate` for `con`'s player (CAL-164): `dealt` and `taken`
    // within its bounds, its `source_entity` holding of what caused it, `blocked` as it was, and
    // its `type`, a `DamageSourcePredicate`, holding of the hit where the player is.
    fn damage_holds(mut self, con: Connection, predicate: Tag, dealt: f32, taken: f32, blocked: bool, hit: Hit) -> bool {
        let Tag.Compound(p) = predicate else return false
        if p.contains("dealt") and not doubles_match(p["dealt"], f64(dealt)) {
            return false
        }
        if p.contains("taken") and not doubles_match(p["taken"], f64(taken)) {
            return false
        }
        if p.contains("source_entity") {
            let e = hit.attacker.copy() else return false
            if not self.entity_condition(con, entity_properties(p["source_entity"]), e) {
                return false
            }
        }
        if p.contains("blocked") and (p["blocked"].number_bool() ?? false) != blocked {
            return false
        }
        if not p.contains("type") {
            return true
        }
        let d = con.player.dim
        let shared = self.levels[d].world_loot() else return false
        let env = self.levels[d].shared_env() else return false
        let Env { facts: f, .. } = env.value
        var condition = JavaHashMap<String, Tag>()
        condition.insert(String("type"), Tag.Str(String("minecraft:damage_source_properties")))
        condition.insert(String("predicate"), p["type"].copy())
        let params = LootParams { origin: some((con.player.x, con.player.y, con.player.z)), damage_source: true, attacker: hit.attacker.copy(), direct_attacker: hit.direct.copy(), direct: hit.is_direct, damage_tags: some(hit.tags) }
        var missing = List<String>()
        var random = self.levels[d].lend_level_random()
        let holds = condition_holds(shared.value, f, self.levels[d], mut random, Tag.Compound(condition), params, mut missing)
        self.levels[d].give_back_level_random(random)
        for m in missing {
            self.levels[d].unimplemented(m)
        }
        return holds
    }

    // `CriteriaTriggers.ENTITY_HURT_PLAYER.trigger` for the player, hurt as `hit` has it, `dealt`
    // of it to take, `taken` taken, blocked or not (CAL-164): each criterion listening whose
    // `damage` holds and whose player's condition holds, awarded.
    fn entity_hurt_player(mut self, con: mut Connection, dealt: f32, taken: f32, blocked: bool, hit: Hit) {
        let listening = con.player.advancements.listening(String("minecraft:entity_hurt_player"))
        if listening.is_empty() {
            return
        }
        var matched = List<Listener>()
        for (key, conditions) in listening {
            let damage = field_of(conditions, "damage")
            if damage != Tag.End and not self.damage_holds(con, damage, dealt, taken, blocked, hit.copy()) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        self.award_all(mut con, matched)
    }

    // `CriteriaTriggers.PLAYER_HURT_ENTITY.trigger` for the player, who hurt `victim` as `hit` has
    // it (CAL-164): each criterion listening whose `damage` holds, whose `entity` holds of the
    // victim where the player is, and whose player's condition holds, awarded.
    fn player_hurt_entity(mut self, con: mut Connection, victim: LootEntity, dealt: f32, taken: f32, blocked: bool, hit: Hit) {
        let listening = con.player.advancements.listening(String("minecraft:player_hurt_entity"))
        if listening.is_empty() {
            return
        }
        var matched = List<Listener>()
        for (key, conditions) in listening {
            let damage = field_of(conditions, "damage")
            if damage != Tag.End and not self.damage_holds(con, damage, dealt, taken, blocked, hit.copy()) {
                continue
            }
            let entity = field_of(conditions, "entity")
            if entity != Tag.End and not self.entity_condition(con, entity, victim.copy()) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        self.award_all(mut con, matched)
    }

    // `CriteriaTriggers.ENTITY_KILLED_PLAYER.trigger` for the player, killed by `killer`, who has
    // the credit (CAL-164): each criterion listening whose `entity` holds of the killer where the
    // player is and whose player's condition holds, awarded. A `killing_blow` is said to be
    // missing, and doesn't hold.
    fn entity_killed_player(mut self, con: mut Connection, killer: LootEntity) {
        let listening = con.player.advancements.listening(String("minecraft:entity_killed_player"))
        if listening.is_empty() {
            return
        }
        let d = con.player.dim
        var matched = List<Listener>()
        for (key, conditions) in listening {
            if field_of(conditions, "killing_blow") != Tag.End {
                self.levels[d].unimplemented(String("A kill's killing blow, as an advancement tests it"))
                continue
            }
            let entity = field_of(conditions, "entity")
            if entity != Tag.End and not self.entity_condition(con, entity, killer.copy()) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        self.award_all(mut con, matched)
    }

    // Each of `matched`, a criterion that held, awarded in turn, as `SimpleCriterionTrigger`
    // awards them once it's found them all (CAL-164).
    fn award_all(mut self, con: mut Connection, matched: List<Listener>) {
        for key in matched {
            self.award(mut con, key.at, key.criterion)
        }
    }

    // `PlayerAdvancements.award`: the criterion `criterion` of the advancement `at` granted the
    // player now, and, where that's finished it, its rewards, then its announcement in chat, where
    // it's announced and the game rule `show_advancement_messages` is on, `createAnnouncement`
    // (CAL-164).
    fn award(mut self, con: mut Connection, at: usize, criterion: String) {
        let a = self.world.advancements.copy() else return
        let now = self.clock.unix_ms
        let done = con.player.advancements.award(a.value, at, criterion, now)
        if not done.finished {
            return
        }
        self.reward(mut con, a.value, at)
        let adv = a.value.all[at].copy()
        if let shown = adv.display {
            if shown.announce and self.world.show_advancement_messages {
                let frame = if shown.frame == 1 {
                    "challenge"
                } else if shown.frame == 2 {
                    "goal"
                } else {
                    "task"
                }
                let name = advancement_name(shown)
                if let profile = con.profile.copy() {
                    // Everyone's told, the player too, who's among them.
                    let message = Component.translatable("chat.type.advancement.{frame}", [self.player_name(profile), name])
                    self.broadcast_system(message.copy(), Look.Quiet)
                    if con.information.chat_visibility != ChatVisibility.Hidden {
                        self.send(mut con, ClientboundSystemChat { content: message, overlay: false }, State.Play)
                    }
                }
            }
        }
    }

    // `AdvancementRewards.grant` of the advancement `at` (CAL-164): its experience given, its
    // loot, `reward_loot`, then its recipes, `awardRecipesByKey`. Its function is said to be
    // missing.
    fn reward(mut self, con: mut Connection, a: Advancements, at: usize) {
        let adv = a.all[at].copy()
        self.give_experience(mut con, adv.rewards.experience)
        let d = con.player.dim
        if let loot = adv.rewards.loot {
            if let Tag.List(tables) = loot {
                self.reward_loot(mut con, tables)
            }
        }
        if not adv.rewards.recipes.is_empty() {
            self.award_recipes(mut con, adv.rewards.recipes)
        }
        if adv.rewards.function != none {
            self.levels[d].unimplemented(String("The function an advancement rewards"))
        }
    }

    // The loot of an advancement's tables `tables`, as `AdvancementRewards.grant` gives it
    // (CAL-164): each table by its ID rolled, `getRandomItems`, with the player as `THIS_ENTITY`
    // where they stand, `ORIGIN`, from its random sequence, else the level's random; each stack
    // added to their inventory, `addItem`, with `ITEM_PICKUP` where they are, from the players,
    // at 0.2 and a pitch their own random draws, where vanilla says it went in, else what's left
    // of it dropped by them, the server's alone, `Prediction.SERVER_ONLY`, for them to pick up at
    // once, `setNoPickUpDelay` and `setTarget`; then, where any went in, their menu's changes
    // sent, `broadcastChanges`. A table given in full in the advancement is said to be missing.
    fn reward_loot(mut self, con: mut Connection, tables: List<Tag>) {
        if tables.is_empty() {
            return
        }
        let d = con.player.dim
        let me = self.looted(con) else return
        let params = LootParams { origin: some((con.player.x, con.player.y, con.player.z)), this_entity: true, this: some(me) }
        self.sequences_to(d)
        var changes = false
        for t in tables {
            match t {
                Tag.Str(name) => {
                    for s in self.roll_entity_loot(d, name.copy(), params.copy(), 0) {
                        if let stack = s {
                            if self.give_reward(mut con, stack) {
                                changes = true
                            }
                        }
                    }
                },
                _ => self.levels[d].unimplemented(String("Loot tables an advancement gives in full")),
            }
        }
        if changes {
            self.broadcast_menu(mut con)
        }
    }

    // `addItem` of a stack an advancement's loot gave, `stack` (CAL-164): with `ITEM_PICKUP` heard
    // at once where vanilla says it went in, which is whether it did; else what's left of it
    // dropped for the player alone, at once.
    fn give_reward(mut self, con: mut Connection, stack: Tag) -> bool {
        let items = self.items.take() else return false
        let who = clicker(con)
        let left = add_item(mut con.player.inventory, stack, items, who)
        self.items = some(items)
        if let rest = left {
            self.drop_for(mut con, rest, false, true, true)
            return false
        }
        var random = con.player.random.take() ?? LegacyRandom.new(self.entity_seed(con.player.entity_id))
        let a = random.next_float()
        let b = random.next_float()
        con.player.random = some(random)
        let pitch = ((a - b) * 0.7f32 + 1.0f32) * 2.0f32
        let d = con.player.dim
        self.levels[d].play_sound_from_source(String("entity.item.pickup"), con.player.x, con.player.y, con.player.z, PLAYERS_SOURCE, 0.2f32, pitch)
        // Heard at once, as vanilla's `playSound` sends it, before the menu's changes.
        self.send_level_events_with(d, mut con)
        return true
    }

    // `ServerPlayer.awardRecipesByKey`: the recipes of the whole IDs `ids` there are, added to the
    // player's recipe book (CAL-164).
    fn award_recipes(mut self, con: mut Connection, ids: List<String>) {
        let shared = self.world.recipes.copy() else return
        var recipes = List<usize>()
        for id in ids {
            if let i = shared.value.find(id) {
                recipes.push(i)
            }
        }
        _ = self.add_recipes(mut con, recipes)
    }

    // `updateEntireScoreboard` (CAL-164): each team, with its players, as
    // `createAddOrModifyPacket` adds it, then each objective a display slot shows, by the slots'
    // IDs, the first time it comes up, as `getStartTrackingPackets` starts it: the objective, each
    // slot showing it, then each of its scores, by holder.
    fn send_scoreboard(mut self, con: mut Connection) {
        con.player.stats.scoring = not self.world.scoreboard.objectives.is_empty()
        let board = self.world.scoreboard.copy()
        for (name, t) in board.teams {
            var players = List<String>()
            for p in t.players {
                players.push(p.copy())
            }
            let body = TeamBody { method: 0, params: some(team_params(t)), players: players }
            self.send(mut con, ClientboundSetPlayerTeam { name: name.copy(), body: body }, State.Play)
        }
        var seen = List<String>()
        for id in 0..board.display.len() {
            let shown = board.display[id].copy() else continue
            if seen.contains(shown) {
                continue
            }
            seen.push(shown.copy())
            let o = board.objectives[shown].copy()
            let body = ObjectiveBody { method: 0, display_name: o.display_name.copy(), hearts: o.hearts, format: wire_format(o.format) }
            self.send(mut con, ClientboundSetObjective { name: shown.copy(), body: body }, State.Play)
            for slot in 0..board.display.len() {
                if board.display[slot] == some(shown.copy()) {
                    self.send(mut con, ClientboundSetDisplayObjective { slot: i32.wrap(slot), objective: shown.copy() }, State.Play)
                }
            }
            for s in board.scores_of(shown.copy()) {
                let value = ScoreValue { value: s.value, display: s.display.copy(), format: wire_format(s.format) }
                self.send(mut con, ClientboundSetScore { owner: s.owner.copy(), objective: shown.copy(), value: value }, State.Play)
            }
        }
    }

    // `forAllObjectives` of the criteria `criteria` for `con`'s player (CAL-164): each of their
    // scores of it `count` more, `ScoreAccess.add`, or set to `value` where it's given,
    // `ScoreAccess.set`, those of objectives shown sent to every player.
    fn score_criteria(mut self, con: mut Connection, criteria: String, count: i32, value: i32?) {
        if self.world.scoreboard.objectives.is_empty() {
            return
        }
        let p = con.profile.copy() else return
        let packets = self.criteria_packets(p, criteria, count, value)
        self.send_all(mut con, packets)
    }

    // `forAllObjectives` of the criteria `criteria` for the player `p`, as `score_criteria` has
    // it: what every player's to be told, `ClientboundSetScorePacket`s, in turn.
    fn criteria_packets(mut self, p: GameProfile, criteria: String, count: i32, value: i32?) -> List<List<u8>> {
        let shown = if self.world.scoreboard.follows_names() { some(self.player_name(p).to_nbt()) } else { none }
        let sent = match value {
            some(v) => self.world.scoreboard.set_for(criteria, p.name.copy(), shown, v),
            none => self.world.scoreboard.add_for(criteria, p.name.copy(), shown, count),
        }
        return score_packets(sent)
    }

    // `forAllObjectives` of the criteria `criteria` for the holder `holder`, each of their scores
    // of it one more, `ScoreAccess.increment`, as a team kill counts (CAL-164).
    fn score_holder(mut self, con: mut Connection, criteria: String, holder: String) {
        let sent = self.world.scoreboard.add_for(criteria, holder, none, 1)
        self.send_all(mut con, score_packets(sent))
    }

    // Each of `packets` to every player, `con`'s first, as `broadcastAll` sends it; kept for
    // one taken out of the connections too, where `held_scores` is (CAL-164).
    fn send_all(mut self, con: mut Connection, packets: List<List<u8>>) {
        for packet in packets {
            self.send_bytes(mut con, packet.copy())
            if let held = self.held_scores.take() {
                var more = held
                more.push(packet.copy())
                self.held_scores = some(more)
            }
            self.broadcast(packet)
        }
    }

    // What `con`'s player's statistics awarded and reset for the scoreboard, in turn, as
    // `awardStat` and `resetStat` give it to `forAllObjectives` (CAL-164), sent to every player.
    fn stat_scores(mut self, con: mut Connection) {
        let p = con.profile.copy() else return
        let scored = con.player.stats.take_scored()
        let packets = self.scored_packets(p, scored)
        self.send_all(mut con, packets)
    }

    // What statistics awarded and reset for the scoreboard, `scored`, did to the player `p`'s
    // scores: each score of a stat that was awarded so much more, and each of one that was reset
    // taken away. What every player's to be told, in turn: `ClientboundSetScorePacket`s, and
    // `ClientboundResetScorePacket`s where its objective's shown.
    fn scored_packets(mut self, p: GameProfile, scored: List<(String, i32?)>) -> List<List<u8>> {
        var out = List<List<u8>>()
        for (name, by) in scored {
            match by {
                some(n) => {
                    for packet in self.criteria_packets(p, name.copy(), n, none) {
                        out.push(packet.copy())
                    }
                },
                none => {
                    for (owner, objective) in self.world.scoreboard.reset_for(name.copy(), p.name.copy()) {
                        out.push(encode_play(ClientboundResetScore { owner: owner.copy(), objective: objective.copy() }))
                    }
                },
            }
        }
        return out
    }

    // `doTick`'s scores of `health`, `food`, `air`, `armor`, `xp` and `level` (CAL-164): each
    // set, `updateScoreForCriteria`, where what it counts isn't what it was last set to, which
    // it's first set to as they're made: their health and absorption, rounded up, their food,
    // their air, their armor, `getArmorValue`, and their experience and its level.
    fn record_criteria(mut self, con: mut Connection) {
        let health = con.player.entity_data.float(HEALTH) + con.player.entity_data.float(ABSORPTION)
        if con.player.recorded_health != some(health) {
            con.player.recorded_health = some(health)
            self.score_criteria(mut con, String("health"), 0, some(i32.saturate(f64(health).ceil())))
        }
        let food = con.player.status.food
        if con.player.recorded_food != some(food) {
            con.player.recorded_food = some(food)
            self.score_criteria(mut con, String("food"), 0, some(food))
        }
        let air = con.player.entity_data.number(AIR_SUPPLY)
        if con.player.recorded_air != some(air) {
            con.player.recorded_air = some(air)
            self.score_criteria(mut con, String("air"), 0, some(air))
        }
        let armor = i32.saturate(con.player.attributes.value(attribute_id(String("armor")) ?? 0).floor())
        if con.player.recorded_armor != some(armor) {
            con.player.recorded_armor = some(armor)
            self.score_criteria(mut con, String("armor"), 0, some(armor))
        }
        let xp = con.player.status.xp_total
        if con.player.recorded_xp != some(xp) {
            con.player.recorded_xp = some(xp)
            self.score_criteria(mut con, String("xp"), 0, some(xp))
        }
        let level = con.player.status.xp_level
        if con.player.recorded_level != some(level) {
            con.player.recorded_level = some(level)
            self.score_criteria(mut con, String("level"), 0, some(level))
        }
    }

    // A player's death message told as their team's death message visibility has it, `die`
    // (CAL-164): where they're in no team, or it's `always`, to everyone, `broadcastSystemMessage`,
    // them too; where it's `hideForOtherTeams`, to the others in their team only, by its players'
    // order, `broadcastSystemToTeam`; where it's `hideForOwnTeam`, to each not in it,
    // `broadcastSystemToAllExceptTeam`; where it's `never`, to no one. Only the first is logged.
    fn death_message(mut self, con: mut Connection, message: own Component) {
        var team: Team? = none
        if let p = con.profile {
            team = self.world.scoreboard.team(p.name.copy())
        }
        let shown = match team {
            some(t) => t.death_messages,
            none => RULE_ALWAYS,
        }
        if shown == RULE_ALWAYS {
            self.broadcast_system(message.copy(), Look.Quiet)
            if con.information.chat_visibility != ChatVisibility.Hidden {
                self.send(mut con, ClientboundSystemChat { content: message, overlay: false }, State.Play)
            }
            return
        }
        let t = team else return
        let packet = encode_play(ClientboundSystemChat { content: message, overlay: false })
        if shown == RULE_OTHER_TEAMS {
            for name in t.players {
                let slot = self.slot_named(name.copy()) else continue
                self.system_to(slot, packet.copy())
            }
        } else if shown == RULE_OWN_TEAM {
            var told = List<usize>()
            for slot in 0..self.connections.len() {
                if not self.playing(slot) {
                    continue
                }
                let c = self.connections[slot] else continue
                let p = c.profile else continue
                if self.world.scoreboard.team_name(p.name.copy()) != some(t.name.copy()) {
                    told.push(slot)
                }
            }
            for slot in told {
                self.system_to(slot, packet.copy())
            }
        }
    }

    // The slot of the player playing named `name`, `getPlayerByName`, but the one being handled.
    fn slot_named(self, name: String) -> usize? {
        for slot in 0..self.connections.len() {
            if not self.playing(slot) {
                continue
            }
            if let c = self.connections[slot] {
                if let p = c.profile {
                    if p.name == name {
                        return some(slot)
                    }
                }
            }
        }
        return none
    }

    // A system message, `packet`, to the player in `slot` where they show system messages,
    // `sendSystemMessage`.
    fn system_to(mut self, slot: usize, packet: own List<u8>) {
        var other = self.connections[slot].take() else return
        if other.information.chat_visibility != ChatVisibility.Hidden {
            self.send_bytes(mut other, packet)
        }
        self.connections[slot] = some(other)
    }

    // The name of the player of the UUID `who`, `con`'s or another playing's (CAL-164).
    fn player_name_by(self, con: Connection, who: (i64, i64)) -> String? {
        let (most, least) = who
        if let p = con.profile {
            if p.id.most == most and p.id.least == least {
                return some(p.name.copy())
            }
        }
        for slot in 0..self.connections.len() {
            if not self.playing(slot) {
                continue
            }
            if let other = self.connections[slot] {
                if let p = other.profile {
                    if p.id.most == most and p.id.least == least {
                        return some(p.name.copy())
                    }
                }
            }
        }
        return none
    }

    // The name of the team the player of `c` is in, where they're in one (CAL-164).
    fn team_name_of(self, c: Connection) -> String? {
        if self.world.scoreboard.teams.is_empty() {
            return none
        }
        let p = c.profile else return none
        return self.world.scoreboard.team_name(p.name.copy())
    }

    // Whether the team the player of `c` is in allows friendly fire, as one in none does.
    fn friendly_fire_of(self, c: Connection) -> bool {
        if self.world.scoreboard.teams.is_empty() {
            return true
        }
        let p = c.profile else return true
        return match self.world.scoreboard.team(p.name.copy()) {
            some(t) => t.friendly_fire,
            none => true,
        }
    }

    // The collision rule of the team the player of `c` is in, `always` where they're in none.
    fn collision_rule_of(self, c: Connection) -> i32 {
        if self.world.scoreboard.teams.is_empty() {
            return RULE_ALWAYS
        }
        let p = c.profile else return RULE_ALWAYS
        return self.world.scoreboard.collision_of(p.name.copy())
    }

    // The color of the team the player of `c` is in, as their waypoint takes it where its icon
    // has none, `cloneAndAssignStyle` (CAL-164): its RGB, but black's a dark gray; none where
    // they're in no team or it has no color.
    fn waypoint_color(self, c: Connection) -> i32? {
        if self.world.scoreboard.teams.is_empty() {
            return none
        }
        let p = c.profile else return none
        let t = self.world.scoreboard.team(p.name.copy()) else return none
        let id = t.color else return none
        return some(if id == 0 { -13619152 } else { color_rgb(id) })
    }

    // Whether the players of `a` and `b` are in the same team, `isAlliedTo` (CAL-164).
    fn allied(self, a: Connection, b: Connection) -> bool {
        if self.world.scoreboard.teams.is_empty() {
            return false
        }
        let pa = a.profile else return false
        let pb = b.profile else return false
        return self.world.scoreboard.allied(pa.name.copy(), pb.name.copy())
    }

    // Whether a mob, in no team, may push the player of `c` as their team's collision rule has
    // it, `pushableBy` (CAL-164).
    fn mob_pushes(self, c: Connection) -> bool {
        return team_pushes(RULE_ALWAYS, self.collision_rule_of(c), false)
    }

    // `ServerLevel.EntityCallbacks.onDestroyed`'s `entityRemoved` of the living entities the
    // scoreboard had that were taken away, `es`'s `unscored`, that of `id` where it's given, else
    // all (CAL-164): each one's scores gone, `reset_score` of them all, then it out of its team,
    // `set_player_team` taking it out, to every player.
    fn unscore(mut self, es: mut LevelEntities, id: i32?) {
        var kept = List<(i32, (i64, i64))>()
        var due = List<(i64, i64)>()
        for (gone, u) in es.list.unscored {
            if id == none or id == some(gone) {
                due.push(u)
            } else {
                kept.push((gone, u))
            }
        }
        es.list.unscored = kept
        for u in due {
            let name = Uuid.new(u.0, u.1).to_string()
            let (scores, left) = self.world.scoreboard.entity_removed(name.copy())
            if scores {
                self.broadcast(encode_play(ClientboundResetScore { owner: name.copy(), objective: none }))
            }
            if let t = left {
                self.broadcast(encode_play(ClientboundSetPlayerTeam { name: t, body: TeamBody { method: 4, players: [name.copy()] } }))
            }
        }
        es.list.scored = self.world.scoreboard.uuid_holders()
    }

    // The player `profile`'s name as vanilla shows it, in their team where they're in one,
    // `Player.getDisplayName` (CAL-164).
    fn player_name(self, profile: GameProfile) -> Component {
        return team_display_name(profile, self.world.scoreboard.team(profile.name.copy()))
    }

    // `ServerRecipeBook.addRecipes` of `recipes` (CAL-164): each the player didn't know and that
    // isn't special, known and highlighted, its displays to be sent, each telling them where its
    // recipe does and highlighted, and `CriteriaTriggers.RECIPE_UNLOCKED` for it; then those
    // sent, where there are any, in a `recipe_book_add`. How many displays were.
    fn add_recipes(mut self, con: mut Connection, recipes: List<usize>) -> usize {
        let shared = self.world.recipes.copy() else return 0
        var w = Writer.new()
        var count: usize = 0
        for i in recipes {
            if not con.player.recipe_book.learn(shared.value, i) {
                continue
            }
            count += shared.value.displays(i)
            shared.value.write_entries(i, true, true, mut w)
            self.recipe_unlocked(mut con, shared.value.all[i].id.to_string())
        }
        if count > 0 {
            let problem = w.problem()
            let entries = BookRecipes { count: count, bytes: w.into_bytes(), problem: problem }
            self.send(mut con, ClientboundRecipeBookAdd { recipes: entries, replace: false }, State.Play)
        }
        return count
    }

    // `CriteriaTriggers.RECIPE_UNLOCKED.trigger` for the player, the recipe of the whole ID `id`
    // added to their book (CAL-164): each criterion listening for that recipe whose player's
    // condition holds, awarded.
    fn recipe_unlocked(mut self, con: mut Connection, id: String) {
        let listening = con.player.advancements.listening(String("minecraft:recipe_unlocked"))
        if listening.is_empty() {
            return
        }
        var matched = List<Listener>()
        for (key, conditions) in listening {
            if field_of(conditions, "recipe") == Tag.Str(id.copy()) and self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        self.award_all(mut con, matched)
    }

    // `flushDirty` of the player's advancements, as their tick ends (CAL-164): what's changed of
    // them, sent, shown.
    fn flush_advancements(mut self, con: mut Connection) {
        let a = self.world.advancements.copy() else return
        let streams = self.streams.copy() else return
        let r = self.world.registries.copy() else return
        if let sent = con.player.advancements.flush(a.value, true, streams, r.value) {
            self.send(mut con, ClientboundUpdateAdvancements { update: sent }, State.Play)
        }
    }

    // What a click or a close did beyond the menu's slots, in the order it happened (D374): the
    // crafting grid's result, taken as the client's and sent, as `slotChangedCraftingGrid` sends
    // it (CAL-147); an equip sound; a stack put back in the inventory, sent as
    // `placeItemBackInInventory` sends it; and a stack vanilla would drop, which needs item
    // entities.
    fn menu_effects(mut self, con: mut Connection, fx: List<Effect>) {
        for e in fx {
            match e {
                Effect.Grid(kind, made) => {
                    if kind == INVENTORY_MENU {
                        con.player.menu.set_remote(0, made.copy())
                        con.player.menu_state = (con.player.menu_state + 1) & 32767
                        let state = con.player.menu_state
                        let sent = self.sent_stack(made)
                        self.send(mut con, ClientboundContainerSetSlot { container_id: 0, state_id: state, slot: 0i16, stack: sent }, State.Play)
                    } else {
                        // The crafting table's menu they have open, with its own ID and state.
                        if let o = con.player.container.take() {
                            var open = o
                            open.menu.set_remote(0, made.copy())
                            open.state = (open.state + 1) & 32767
                            let (id, state) = (open.id, open.state)
                            con.player.container = some(open)
                            let sent = self.sent_stack(made)
                            self.send(mut con, ClientboundContainerSetSlot { container_id: id, state_id: state, slot: 0i16, stack: sent }, State.Play)
                        }
                    }
                },
                Effect.Equip(worn, old, stack) => self.equip_sound(mut con, worn, old, stack),
                Effect.Placed(slot, stack) => {
                    let sent = self.sent_stack(stack)
                    self.send(mut con, ClientboundSetPlayerInventory { slot: i32.wrap(slot), stack: sent }, State.Play)
                },
                Effect.Dropped(stack, alone) => self.drop_item(mut con, stack, false, alone),
                Effect.Thrown(stack) => self.drop_item(mut con, stack, true, false),
                // Carried out by the click, which saves what the container holds (CAL-144).
                Effect.Changed => {},
                Effect.TradeUpdated(valid) => self.trade_updated(mut con, valid),
                // `MerchantResultSlot.onTake`'s `notifyTrade`, then `TRADED_WITH_VILLAGER`
                // (CAL-164).
                Effect.Traded(index) => {
                    self.traded(mut con, index)
                    con.player.stats.award_custom("traded_with_villager", 1)
                },
                Effect.Crafted(at, grid) => self.recipe_crafted(mut con, at, grid),
                // `onCraftedBy`'s `ITEM_CRAFTED` (CAL-164).
                Effect.Made(item, count) => con.player.stats.award(String("minecraft:crafted"), item, count),
            }
        }
    }

    // `handleContainerClick` on the player's inventory menu, container 0 (D374). The slots the
    // client says changed and what its cursor carries are read first, as the packet's codec
    // reads them, which stops the connection where they don't read. A spectator is sent the
    // whole menu again. A slot that isn't one is let be. Otherwise the click runs with remote
    // updates held, the client's word is taken for the slots it says changed and for its
    // cursor, and then what it hasn't got is sent, or all of it where its state wasn't the
    // menu's. A click vanilla throws on is logged as `onPacketError` logs it, and leaves remote
    // updates held, as vanilla leaves them, until the next click.
    fn container_click(mut self, con: mut Connection, c: ServerboundContainerClick) -> bool {
        let click = match self.click_of(c) {
            ClickRead.Unready => return true,
            ClickRead.Fault(f) => {
                self.fault(mut con, decode_exception(f))
                return false
            },
            ClickRead.Read(k) => k,
        }
        if con.player.container != none {
            return self.container_menu_click(mut con, c, click)
        }
        if c.container_id != 0 {
            return true
        }
        if con.player.mode == GameType.Spectator {
            self.send_inventory(mut con)
            return true
        }
        let slot = i32(c.slot)
        if slot != -1 and slot != OUTSIDE and slot >= i32.wrap(MENU_SLOTS) {
            return true
        }
        let resync = c.state_id != con.player.menu_state
        // `ContainerInput.BY_ID`, whose IDs out of range are `PICKUP`'s.
        let input = if c.input >= 0 and c.input <= 6 { c.input } else { 0 }
        let who = clicker(con)
        let taken = self.items.take() else return true
        var menu = con.player.menu.copy()
        menu.suppress()
        var fx = List<Effect>()
        var slots = Slots { inv: con.player.inventory.copy(), recipes: self.world.recipes.copy(), used: menu.used }
        let done = menu.click(mut slots, taken, who, slot, i32(c.button), input, mut fx)
        con.player.inventory = slots.inv
        menu.used = slots.used
        con.player.menu = menu
        self.items = some(taken)
        self.menu_effects(mut con, fx)
        if not done {
            self.suppress(click_text(c, click, input), String("net.minecraft.ReportedException: Container click"))
            return true
        }
        for i in 0..click.slots.len() {
            con.player.menu.receive(click.slots[i], click.stacks[i])
        }
        con.player.menu.receive_carried(click.carried)
        con.player.menu.resume()
        if resync {
            // `broadcastFullState`.
            self.broadcast_full(mut con)
        } else {
            self.broadcast_menu(mut con)
        }
        return true
    }

    // `doCloseContainer`, as `handleContainerClose` runs it whatever container the client names:
    // the container's menu they have open closed (CAL-144), else the inventory menu's `removed`.
    fn close_menu(mut self, con: mut Connection) {
        if con.player.container != none {
            self.close_container(mut con)
        } else {
            self.close_inventory(mut con)
        }
    }

    // The inventory menu's `removed`, which puts what the cursor carries and the crafting grid
    // back in the inventory (D374).
    fn close_inventory(mut self, con: mut Connection) {
        if not self.items_ready() {
            return
        }
        let who = clicker(con)
        let taken = self.items.take() else return
        var menu = con.player.menu.copy()
        var fx = List<Effect>()
        var slots = Slots { inv: con.player.inventory.copy() }
        menu.close(mut slots, taken, who, mut fx)
        con.player.inventory = slots.inv
        con.player.menu = menu
        self.items = some(taken)
        self.menu_effects(mut con, fx)
    }

    // `Player.openMenu` of the container `o` opens (CAL-144): the menu they have open closed
    // first, `closeContainer`; the next container ID, from 1 to 100; the menu made, whose
    // `startOpen` counts them, unless they're a spectator, its sounds sent at once; then
    // `ClientboundOpenScreenPacket` with its type and title, and the whole menu sent,
    // `setSynchronizer`.
    fn open_container(mut self, con: mut Connection, o: Opening) {
        let d = con.player.dim
        let shared = self.levels[d].shared_env() else return
        let Env { facts: f, .. } = shared.value
        if not self.items_ready() {
            return
        }
        if con.player.container != none {
            self.close_and_tell(mut con)
        }
        con.player.container_counter = con.player.container_counter % 100 + 1
        var opened = o.copy()
        for i in 0..opened.parts.len() {
            let (x, y, z) = (opened.parts[i].x, opened.parts[i].y, opened.parts[i].z)
            opened.parts[i].id = self.levels[d].openers(x, y, z).id
        }
        let spectator = con.player.mode == GameType.Spectator
        if not spectator {
            let range = con.player.attributes.value(attribute_id(String("block_interaction_range")) ?? 0)
            match start_open(f, mut self.levels[d], opened, range) {
                ok => {},
                err(thrown) => self.levels[d].unimplemented(thrown.message),
            }
        }
        // `playSound` sends at once, before the menu.
        self.send_level_events_with(d, mut con)
        let id = con.player.container_counter
        let menu_type = self.item_registry_id("menu", opened.menu_type.copy())
        let title = opened.title.copy()
        self.send(mut con, ClientboundOpenScreen { container_id: id, menu_type: menu_type, title: title }, State.Play)
        let size = opened.slots() + 36
        // A crafting table's result and grid, empty as its menu's made (CAL-147), and a merchant's
        // payments and what its trade gives (CAL-160).
        var held = List<Tag?>()
        if holds_own(opened.kind) {
            for _ in 0..opened.slots() {
                held.push(none)
            }
        }
        con.player.container = some(OpenContainer { id: id, opening: opened, menu: Menu.of(size), spectator: spectator, held: held })
        // `initMenu`'s listener, which sees each slot of the new menu, setting off
        // `inventory_changed` for each stack of the player's inventory (CAL-164).
        self.listen_container(mut con)
        self.send_container(mut con)
    }

    // The ID of `name` in the built-in registry `registry`, -1 for none.
    fn item_registry_id(self, registry: str, name: String) -> i32 {
        if let items = self.items {
            return items.builtin_id(registry, name) ?? -1
        }
        return -1
    }

    // The slots of the container's menu the player has open (CAL-144): what the container holds,
    // from its block entities, or their ender chest, or a crafting table's menu itself (CAL-147),
    // or a merchant's (CAL-160), then their inventory, with the recipes a crafting grid's matched
    // against.
    fn container_slots(self, con: Connection) -> Slots {
        let open = con.player.container else return Slots { inv: con.player.inventory.copy() }
        let d = con.player.dim
        let menu_held = holds_own(open.opening.kind)
        let held = if menu_held { open.held.copy() } else if open.opening.ender { con.player.ender.items.copy() } else { items_of(self.levels[d], open.opening) }
        var slots = Slots { inv: con.player.inventory.copy(), container: held, kind: open.opening.kind, recipes: self.world.recipes.copy() }
        // A merchant's offers, as it has them now, and its menu's picked trade and active offer.
        if let trader = open.opening.trader {
            if d < self.entities.len() {
                if let es = self.entities[d] {
                    if let (offers, _, _) = es.list.merchant_offers(trader) {
                        slots.offers = offers
                    }
                }
            }
            slots.hint = open.hint
            slots.active = open.active
        }
        // What a beacon's payment slot takes (D521).
        if open.opening.kind == BEACON_MENU {
            if let r = self.world.registries {
                slots.payments = item_tag_names(r.value, "beacon_payment_items")
            }
        }
        return slots
    }


    // `MerchantMenu.updateSellItem` of the merchant's menu the player has open, as its offers
    // change (CAL-160): what its payments buy made again; what that tells the merchant.
    fn resold(mut self, con: mut Connection) -> List<Effect> {
        var fx = List<Effect>()
        if trader_of(con) == none or not self.items_ready() {
            return fx
        }
        var slots = self.container_slots(con)
        let taken = self.items.take() else return fx
        update_sell(mut slots, taken, mut fx)
        self.items = some(taken)
        if let o = con.player.container.take() {
            var open = o
            open.held = slots.container.copy()
            open.hint = slots.hint
            open.active = slots.active
            con.player.container = some(open)
        }
        return fx
    }

    // `handleSelectTrade` (CAL-160): where the player has a merchant's menu open that's still
    // valid, the trade they picked, `setSelectionHint` and `tryMoveItems`; what moved is sent as
    // their next tick broadcasts their menu.
    fn pick_trade(mut self, con: mut Connection, index: i32) {
        let trader = trader_of(con) else return
        if not self.merchant_valid(con, trader) or not self.items_ready() {
            return
        }
        var slots = self.container_slots(con)
        let taken = self.items.take() else return
        var fx = List<Effect>()
        select_trade(mut slots, index, taken, mut fx)
        self.items = some(taken)
        con.player.inventory = slots.inv.copy()
        if let o = con.player.container.take() {
            var open = o
            open.held = slots.container.copy()
            open.hint = slots.hint
            open.active = slots.active
            con.player.container = some(open)
        }
        self.menu_effects(mut con, fx)
    }

    // `handleSetBeaconPacket` (D521): with a beacon's menu open and still valid, its
    // `updateEffects`: with its payment in, the effects picked, where its levels may give them,
    // `validateEffects`, set as its `dataAccess` sets them, its power select sound played first
    // where it has a beam, heard at once; the payment taken, `remove(1)`; and its block entity
    // changed, so its chunk's saved. Without a payment, or with effects it may not give, they're
    // disconnected.
    fn set_beacon(mut self, con: mut Connection, b: ServerboundSetBeacon) -> bool {
        let kind = match con.player.container {
            some(o) => o.opening.kind,
            none => -1,
        }
        if kind != BEACON_MENU or not self.container_valid(con) {
            return true
        }
        let taken = con.player.container.take() else return true
        var open = taken
        let at = open.opening.at
        let (x, y, z) = at ?? (0, 0, 0)
        let d = con.player.dim
        let names = effect_names()
        let primary = beacon_power(names, b.primary)
        let secondary = beacon_power(names, b.secondary)
        let paid = open.held.len() > 0 and open.held[0] != none
        let beacon = self.levels[d].beacon(x, y, z)
        if at == none or not paid or not valid_effects(primary.copy(), secondary.copy(), beacon.levels) {
            con.player.container = some(open)
            self.disconnect(mut con, Component.translatable("multiplayer.disconnect.generic", []))
            self.logs.push(Entry.warn("Player {player_name(con)} tried to set invalid beacon effects"))
            return false
        }
        if beacon.beam {
            self.levels[d].play_sound(x, y, z, String("block.beacon.power_select"), 1.0f32, 1.0f32)
        }
        self.store_power(d, x, y, z, "primary_effect", primary)
        self.store_power(d, x, y, z, "secondary_effect", secondary)
        open.held[0] = none
        // `blockEntityChanged`: its chunk unsaved, its levels as it saves them.
        self.levels[d].set_block_entity_value(x, y, z, "Levels", Tag.Int(beacon.levels))
        con.player.container = some(open)
        self.send_level_events_with(d, mut con)
        return true
    }

    // A beacon's effect `key` at x, y, z in the level `d` set to `name`, or taken off where it's
    // empty, as `storeEffect` saves it (D521).
    fn store_power(mut self, d: usize, x: i32, y: i32, z: i32, key: str, name: own String) {
        if name.is_empty() {
            self.levels[d].remove_block_entity_value(x, y, z, key)
        } else {
            self.levels[d].set_block_entity_value(x, y, z, key, Tag.Str(name))
        }
    }

    // `notifyTradeUpdated` of the merchant whose menu the player has open (CAL-160): its yes or
    // no, where it says one, heard then and there.
    fn trade_updated(mut self, con: mut Connection, valid: bool) {
        let trader = trader_of(con) else return
        let d = con.player.dim
        var sounds = List<EntitySound>()
        var es = self.take_entities(d)
        if let lent = es.list.lend_mob(trader) {
            var mob = lent
            mob.trade_updated(valid, mut sounds)
            es.list.give_back_mob(mob)
        }
        self.put_entities(d, es)
        for s in sounds {
            self.play_item_sound(d, s)
        }
        self.send_level_events_with(d, mut con)
    }

    // `notifyTrade` of the merchant whose menu the player has open, its offer at `index` traded
    // (CAL-160): its uses and experience, `rewardTradeXp`; where it went up a level, the next
    // level's offers added, `updateTrades`, priced for the player, and 10 seconds of regeneration
    // (CAL-163), what their payments buy made again and the offers sent them; then the orb it
    // gives, at its feet and half a block up, which the player sees with the others, though
    // they're out of the connections.
    fn traded(mut self, con: mut Connection, index: i32) {
        let trader = trader_of(con) else return
        let d = con.player.dim
        var es = self.take_entities(d)
        var mob = es.list.lend_mob(trader) else {
            self.put_entities(d, es)
            return
        }
        let reward = mob.notify_trade(index)
        var repriced = false
        if reward.leveled {
            let more = self.draw_offers(d, mob, none)
            mob.add_offers(more)
            repriced = mob.reprice()
            if self.living_ready(d) {
                if let lf = self.living_facts.take() {
                    var unheard = List<EntitySound>()
                    _ = mob.add_effect(lf, ActiveEffect.new(REGENERATION, 200, 0), mut unheard)
                    self.living_facts = some(lf)
                }
            }
        }
        let (x, y, z) = (mob.living.body.x, mob.living.body.y + 0.5, mob.living.body.z)
        let (offers, level, xp) = (mob.offers(), mob.villager_level(), mob.villager_xp)
        let villager = mob.loot_entity()
        es.list.give_back_mob(mob)
        self.put_entities(d, es)
        if repriced {
            let fx = self.resold(mut con)
            self.menu_effects(mut con, fx)
            self.send_offers(mut con, offers, level, xp)
        }
        if let value = reward.orb {
            self.entity_ids += 1
            let id = self.entity_ids
            let seed = self.entity_seed(id)
            self.add_orb(d, ExperienceOrb.new(id, seed, x, y, z, value), some(con.player.entity_id))
            self.item_sees(d, id, mut con)
        }
        if index >= 0 and usize.wrap(index) < offers.len() {
            self.villager_traded(mut con, villager, field_of(offers[usize.wrap(index)], "sell"))
        }
    }

    // `sendAllDataToRemote` of the container's menu the player has open (CAL-144): every slot and
    // what the cursor carries, with its state up one, which the client then has.
    // `triggerSlotListeners` of each slot of the container's menu the player has open (CAL-164).
    fn listen_container(mut self, con: mut Connection) {
        let size = match con.player.container {
            some(open) => open.menu.slots(),
            none => return,
        }
        for n in 0..size {
            let slots = self.container_slots(con)
            let current = stack_in(slots, n)
            var open = con.player.container.take() else return
            let heard = open.menu.listen(n, current.copy())
            con.player.container = some(open)
            if heard and of_inventory(slots, n) {
                self.inventory_changed(mut con, current)
            }
        }
    }

    fn send_container(mut self, con: mut Connection) {
        let slots = self.container_slots(con)
        var open = con.player.container.take() else return
        open.state = (open.state + 1) & 32767
        open.menu.sent_all(slots)
        var items = List<SentStack>()
        for n in 0..open.menu.slots() {
            items.push(self.sent_stack(stack_in(slots, n)))
        }
        let carried = self.sent_stack(open.menu.carried)
        let (id, state) = (open.id, open.state)
        con.player.container = some(open)
        self.send(mut con, ClientboundContainerSetContent { container_id: id, state_id: state, items: items, carried: carried }, State.Play)
        self.send_menu_data(mut con, true)
    }

    // The data slots of the menu the player has open, a beacon's, `dataAccess` (D521): each the
    // client hasn't got, `synchronizeDataSlotToRemote`, or all of them, as `sendInitialData` sends
    // them, with `ClientboundContainerSetData`.
    fn send_menu_data(mut self, con: mut Connection, all: bool) {
        let taken = con.player.container.take() else return
        var open = taken
        let at = open.opening.at
        if open.opening.kind != BEACON_MENU or at == none {
            con.player.container = some(open)
            return
        }
        let (x, y, z) = at!
        let d = con.player.dim
        let data = beacon_data(self.levels[d].beacon(x, y, z).levels, self.levels[d].block_entity_tag(x, y, z))
        let id = open.id
        for i in 0..data.len() {
            if all or i >= open.data.len() or open.data[i] != data[i] {
                self.send(mut con, ClientboundContainerSetData { container_id: id, slot: i16.wrap(i32.wrap(i)), value: i16.wrap(data[i]) }, State.Play)
            }
        }
        open.data = data
        con.player.container = some(open)
    }

    // `broadcastChanges` of the container's menu the player has open (CAL-144): each slot the
    // client hasn't got, sent with the menu's next state ID, then the cursor's.
    fn broadcast_container(mut self, con: mut Connection) {
        if not self.items_ready() {
            return
        }
        let size = match con.player.container {
            some(open) => open.menu.slots(),
            none => return,
        }
        for n in 0..size {
            let slots = self.container_slots(con)
            let current = stack_in(slots, n)
            var open = con.player.container.take() else return
            let heard = open.menu.listen(n, current.copy())
            con.player.container = some(open)
            if heard and of_inventory(slots, n) {
                self.inventory_changed(mut con, current.copy())
            }
            var o = con.player.container.take() else return
            let taken = self.items.take() else {
                con.player.container = some(o)
                return
            }
            let send = o.menu.sync_slot(n, current.copy(), taken)
            self.items = some(taken)
            if send {
                o.state = (o.state + 1) & 32767
            }
            let (id, state) = (o.id, o.state)
            con.player.container = some(o)
            if send {
                let sent = self.sent_stack(current)
                self.send(mut con, ClientboundContainerSetSlot { container_id: id, state_id: state, slot: i16.wrap(n), stack: sent }, State.Play)
            }
        }
        var open = con.player.container.take() else return
        let taken = self.items.take() else {
            con.player.container = some(open)
            return
        }
        let carried = open.menu.sync_carried(taken)
        self.items = some(taken)
        let held = open.menu.carried.copy()
        con.player.container = some(open)
        if carried {
            let sent = self.sent_stack(held)
            self.send(mut con, ClientboundSetCursorItem { stack: sent }, State.Play)
        }
        self.send_menu_data(mut con, false)
    }

    // `handleContainerClick` while a container's menu is open (CAL-144): only on its container;
    // a spectator is sent the whole menu again; one out of reach of it is let be; a slot that
    // isn't one is let be. Otherwise the click runs as the inventory menu's does, then what it did
    // to the container is saved, each of its block entities' `setChanged` telling the comparators
    // by it, or to the player's ender chest.
    fn container_menu_click(mut self, con: mut Connection, c: ServerboundContainerClick, click: Click) -> bool {
        let id = match con.player.container {
            some(open) => open.id,
            none => return true,
        }
        if c.container_id != id {
            return true
        }
        if con.player.mode == GameType.Spectator {
            self.send_container(mut con)
            return true
        }
        if not self.container_valid(con) {
            return true
        }
        let size = match con.player.container {
            some(open) => open.menu.slots(),
            none => return true,
        }
        let slot = i32(c.slot)
        if slot != -1 and slot != OUTSIDE and slot >= i32.wrap(size) {
            return true
        }
        let input = if c.input >= 0 and c.input <= 6 { c.input } else { 0 }
        let who = clicker(con)
        var slots = self.container_slots(con)
        var open = con.player.container.take() else return true
        let resync = c.state_id != open.state
        let taken = self.items.take() else {
            con.player.container = some(open)
            return true
        }
        open.menu.suppress()
        var fx = List<Effect>()
        slots.used = open.menu.used
        let done = open.menu.click(mut slots, taken, who, slot, i32(c.button), input, mut fx)
        open.menu.used = slots.used
        self.items = some(taken)
        con.player.inventory = slots.inv.copy()
        if holds_own(open.opening.kind) {
            open.held = slots.container.copy()
        }
        open.hint = slots.hint
        open.active = slots.active
        var changed = false
        for e in fx {
            match e {
                Effect.Changed => changed = true,
                _ => {},
            }
        }
        if changed {
            self.container_changed(mut con, open.opening, slots.container)
        }
        con.player.container = some(open)
        self.menu_effects(mut con, fx)
        if not done {
            self.suppress(click_text(c, click, input), String("net.minecraft.ReportedException: Container click"))
            return true
        }
        if let after = con.player.container.take() {
            var now = after
            for i in 0..click.slots.len() {
                now.menu.receive(click.slots[i], click.stacks[i])
            }
            now.menu.receive_carried(click.carried)
            now.menu.resume()
            con.player.container = some(now)
        }
        if resync {
            // `broadcastFullState`: each slot told to the listeners, then all of it sent (CAL-164).
            self.listen_container(mut con)
            self.send_container(mut con)
        } else {
            self.broadcast_container(mut con)
        }
        return true
    }

    // What a click did to the container `o` is of, `held`, its slots (CAL-144): kept in the
    // player's ender chest, or saved in its block entities, each then `setChanged`, telling the
    // comparators by it, `updateNeighbourForOutputSignal`.
    fn container_changed(mut self, con: mut Connection, o: Opening, held: List<Tag?>) {
        if o.ender {
            con.player.ender.set_all(held.copy())
            return
        }
        let d = con.player.dim
        let shared = self.levels[d].shared_env() else return
        let Env { facts: f, .. } = shared.value
        match put_items(f, mut self.levels[d], o, held) {
            ok => {},
            err(thrown) => self.levels[d].unimplemented(thrown.message),
        }
        for p in o.parts {
            let state = self.block_at(d, f, p.x, p.y, p.z) ?? f.ids.air_state
            match update_output_signal(f, mut self.levels[d], state, p.x, p.y, p.z) {
                ok => {},
                err(thrown) => self.levels[d].unimplemented(thrown.message),
            }
        }
    }

    // `stillValid` of the container's menu the player has open (CAL-144): each of its block
    // entities, or the ender chest it's open at, still the one it opened on, and within their
    // reach and 4 more, `Container.stillValidBlockEntity`; a crafting table's, the block it opened
    // at still a crafting table, and within their reach and 4 more, `stillValid(access, player,
    // Blocks.CRAFTING_TABLE)` (CAL-147), and a beacon's still a beacon (D521); a merchant's, the
    // merchant's, `merchant_valid` (CAL-160).
    fn container_valid(mut self, con: Connection) -> bool {
        let open = con.player.container else return true
        let d = con.player.dim
        if let trader = open.opening.trader {
            return self.merchant_valid(con, trader)
        }
        let pose = con.player.entity_data.number(POSE_ID)
        for p in open.opening.parts {
            if self.levels[d].opened_id(p.x, p.y, p.z) != p.id {
                return false
            }
            if not within_range(con.player.attributes, pose, con.player.x, con.player.y, con.player.z, p.x, p.y, p.z, 4.0) {
                return false
            }
        }
        if let at = open.opening.at {
            let (x, y, z) = at
            let shared = self.levels[d].shared_env() else return true
            let Env { facts: f, .. } = shared.value
            let state = self.block_at(d, f, x, y, z) ?? f.ids.air_state
            let block = if open.opening.kind == BEACON_MENU { String("minecraft:beacon") } else { String("minecraft:crafting_table") }
            if f.codec.blocks.name(f.block(state)) != block {
                return false
            }
            if not within_range(con.player.attributes, pose, con.player.x, con.player.y, con.player.z, x, y, z, 4.0) {
                return false
            }
        }
        return true
    }

    // `AbstractVillager.stillValid` of the merchant `trader`'s menu the player has open (CAL-160):
    // the merchant there among their level's entities, trading with them, alive, and its box
    // within their entity interaction range and 4 more of their eyes.
    fn merchant_valid(self, con: Connection, trader: i32) -> bool {
        let d = con.player.dim
        if d >= self.entities.len() {
            return false
        }
        let es = self.entities[d] else return false
        let (trading, alive, bounds) = es.list.merchant(trader) else return false
        if trading != some(con.player.entity_id) or not alive {
            return false
        }
        let pose = con.player.entity_data.number(POSE_ID)
        return entity_in_reach(con.player.attributes, pose, con.player.x, con.player.y, con.player.z, bounds, 4.0)
    }

    // `sendMerchantOffers` to the player (CAL-160): a merchant's offers `offers`, where there are
    // any, with its level and experience, to the menu they have open, its container ID, their
    // inventory's 0 where they've none, which shows the merchant's progress and that it
    // restocks, as a villager's does, `showProgressBar` and `canRestock`.
    fn send_offers(mut self, con: mut Connection, offers: List<Tag>, level: i32, xp: i32) {
        if offers.is_empty() {
            return
        }
        var written: SentOffers? = none
        if let streams = self.streams {
            if let r = self.world.registries {
                written = some(SentOffers.of(offers, streams, r.value))
            }
        }
        let sent = written else return
        let id = match con.player.container {
            some(open) => open.id,
            none => 0,
        }
        self.send(mut con, ClientboundMerchantOffers { container_id: id, offers: sent, level: level, xp: xp, show_progress: true, can_restock: true }, State.Play)
    }

    // The villager `id`'s offers priced again for the player trading with it as it ticked
    // (CAL-160): what their merchant menu's payments buy made again, its yes or no, and the offers
    // sent them.
    fn repriced_for(mut self, es: own LevelEntities, d: usize, id: i32) -> LevelEntities {
        let (trading, _, _) = es.list.merchant(id) else return es
        let player = trading else return es
        let (offers, level, xp) = es.list.merchant_offers(id) else return es
        self.put_entities(d, es)
        for slot in self.level_slots(d) {
            var con = self.connections[slot].take() else continue
            if con.player.entity_id == player {
                let fx = self.resold(mut con)
                self.menu_effects(mut con, fx)
                self.send_offers(mut con, offers.copy(), level, xp)
            }
            self.connections[slot] = some(con)
        }
        return self.take_entities(d)
    }

    // `setTradingPlayer(null)` of the merchant `trader` in the level `d`, where it's there
    // (CAL-160).
    fn stop_trading(mut self, d: usize, trader: i32) {
        if d >= self.entities.len() or self.entities[d] == none {
            return
        }
        var es = self.take_entities(d)
        if let lent = es.list.lend_mob(trader) {
            var mob = lent
            mob.stop_trading()
            es.list.give_back_mob(mob)
        }
        self.put_entities(d, es)
    }

    // `closeContainer`: the client told its menu's closed, `ClientboundContainerClosePacket`,
    // then `doCloseContainer` (CAL-144).
    fn close_and_tell(mut self, con: mut Connection) {
        let id = match con.player.container {
            some(open) => open.id,
            none => 0,
        }
        self.send(mut con, ClientboundContainerClose { container_id: id }, State.Play)
        self.close_menu(mut con)
    }

    // `doCloseContainer` of the container's menu the player has open (CAL-144): its `removed`,
    // what the cursor carries put back in the inventory, or dropped for a player who's left, then
    // the container's `stopOpen`, unless they opened it as a spectator; then the inventory menu
    // takes what the client was sent of the inventory, `transferState`, and is theirs again.
    fn close_container(mut self, con: mut Connection) {
        let open = con.player.container.take() else return
        if not self.items_ready() {
            return
        }
        let who = clicker(con)
        let taken = self.items.take() else return
        var menu = open.menu.copy()
        var fx = List<Effect>()
        var slots = Slots { inv: con.player.inventory.copy(), container: open.held.copy(), kind: open.opening.kind }
        // A dead player out of their level drops them too, as `dropOrPlaceInInventory` drops them
        // for one who's removed (D427).
        if con.closing or con.player.removed {
            if let c = menu.carried.take() {
                fx.push(Effect.Dropped(c, true))
            }
            // A crafting table's grid, dropped as `clearContainer` drops it for a player who's
            // left (CAL-147), or a merchant's payments, as `MerchantMenu.removed` drops them
            // (CAL-160).
            let first: usize = if open.opening.kind == MERCHANT_MENU { 0 } else { 1 }
            let last: usize = if open.opening.kind == MERCHANT_MENU { 2 } else { slots.container.len() }
            for n in first..last {
                if let stack = slots.container[n].copy() {
                    fx.push(Effect.Dropped(stack, true))
                }
                slots.container[n] = none
            }
        }
        menu.close(mut slots, taken, who, mut fx)
        con.player.inventory = slots.inv
        self.items = some(taken)
        // The merchant's trading player let go, `setTradingPlayer(null)`, whoever it trades with
        // (CAL-160).
        if let trader = open.opening.trader {
            self.stop_trading(con.player.dim, trader)
        }
        self.menu_effects(mut con, fx)
        if not open.spectator {
            let d = con.player.dim
            if let shared = self.levels[d].shared_env() {
                let Env { facts: f, .. } = shared.value
                match stop_open(f, mut self.levels[d], open.opening) {
                    ok => {},
                    err(thrown) => self.levels[d].unimplemented(thrown.message),
                }
            }
        }
        con.player.menu.transfer_from(menu)
    }

    // Gives each level the world's jukebox songs, from the item codecs, once there are some
    // (CAL-143).
    fn give_songs(mut self) {
        if not self.items_ready() {
            return
        }
        let codecs = self.items.take() else return
        let songs = codecs.songs()
        self.items = some(codecs)
        for d in 0..self.levels.len() {
            self.levels[d].songs = songs.copy()
        }
        self.songs_given = true
    }

    // The world's loot, made the first time it's asked for from the world's registries, which a
    // test's world hasn't (CAL-153).
    fn loot_of(mut self) -> Shared<Loot>? {
        if let l = self.loot {
            return some(l.copy())
        }
        let shared = match self.world.registries {
            some(r) => r.copy(),
            none => return none,
        }
        let made = Shared(Loot.new(shared))
        self.loot = some(made.copy())
        return some(made)
    }

    // Puts the server's random sequences in the level `d`, from the world or the level that has
    // them, as it's about to run what may drop, vanilla's being the server's (CAL-153).
    fn sequences_to(mut self, d: usize) {
        if self.sequences_at == some(d) or d >= self.levels.len() {
            return
        }
        let s = self.take_sequences() else return
        self.levels[d].sequences = some(s)
        self.sequences_at = some(d)
    }

    // The random sequences, taken from the level that has them, or else the world.
    fn take_sequences(mut self) -> RandomSequences? {
        if let at = self.sequences_at {
            self.sequences_at = none
            return self.levels[at].sequences.take()
        }
        return self.world.sequences.take()
    }

    // The items the level `d` dropped, made as `Block.popResource` makes them, in the order they
    // were popped: each with the next entity ID and its seed and `setDefaultPickUpDelay`'s 10
    // ticks, added as `addFreshEntity` adds them (CAL-153).
    fn make_drops(mut self, d: usize) {
        for dropped in self.levels[d].take_dropped() {
            _ = self.make_drop(d, dropped.copy(), none)
        }
    }

    // One thing level `d` dropped made, seen by its players but `except`: an item, with its
    // default pickup delay; or an orb, `tryMergeToExisting` into the first there that can take
    // it, else made (CAL-154). The id of what was made, or none where it merged.
    fn make_drop(mut self, d: usize, dropped: own Dropped, except: i32?) -> i32? {
        match dropped {
            Dropped.Item(x, y, z, stack) => {
                self.entity_ids += 1
                let id = self.entity_ids
                let seed = self.entity_seed(id)
                var e = ItemEntity.new(id, seed, x, y, z, stack)
                e.pickup_delay = 10
                self.add_item(d, e, except)
                return some(id)
            },
            Dropped.Orb(x, y, z, value, pick) => {
                var es = self.take_entities(d)
                let merged = es.list.merge_award(x, y, z, value, pick)
                self.put_entities(d, es)
                if merged {
                    return none
                }
                self.entity_ids += 1
                let id = self.entity_ids
                let seed = self.entity_seed(id)
                self.add_orb(d, ExperienceOrb.new(id, seed, x, y, z, value), except)
                return some(id)
            },
        }
    }

    // The same, after a packet of `con`'s, who's out of the connections and sees them as the
    // others do.
    fn make_drops_for(mut self, con: mut Connection) {
        for d in 0..self.levels.len() {
            for dropped in self.levels[d].take_dropped() {
                let made = self.make_drop(d, dropped.copy(), some(con.player.entity_id)) else continue
                if con.player.dim == d {
                    self.item_sees(d, made, mut con)
                }
            }
        }
    }

    // Whether players' items can be read and sent: the item codecs and their streams, made the
    // first time they're asked for, from the world's registries, which a test's world hasn't.
    fn items_ready(mut self) -> bool {
        if self.items != none {
            return true
        }
        let shared = match self.world.registries {
            some(r) => r.copy(),
            none => return false,
        }
        self.items = some(ItemCodecs.new(shared))
        self.streams = some(Streams.new())
        return true
    }

    // A click's slots and what its cursor carries, read as the packet's codec reads them.
    fn click_of(mut self, c: ServerboundContainerClick) -> ClickRead {
        if not self.items_ready() {
            return ClickRead.Unready
        }
        let packet = String("serverbound/minecraft:container_click")
        let (items_n, types_n) = match self.world.registries {
            some(r) => (builtin_size(r.value, "item"), builtin_size(r.value, "data_component_type")),
            none => return ClickRead.Unready,
        }
        var rd = Reader.new(c.rest.copy())
        let click = match read_click(mut rd, items_n, types_n) {
            ok(k) => k,
            err(e) => return ClickRead.Fault("Failed to decode packet '{packet}': {e.message}"),
        }
        if rd.left() != 0 {
            return ClickRead.Fault("Packet play/{packet} (ServerboundContainerClickPacket) was larger than I expected, found {rd.left()} bytes extra whilst reading packet {packet}")
        }
        return ClickRead.Read(click)
    }

    // A creative slot's stack, read as the packet's codec reads it.
    fn creative_stack(mut self, c: ServerboundSetCreativeModeSlot) -> CreativeStack {
        if not self.items_ready() {
            return CreativeStack.Unready
        }
        let packet = String("serverbound/minecraft:set_creative_mode_slot")
        var rd = Reader.new(c.stack.copy())
        let taken = self.items.take() else return CreativeStack.Unready
        var items = taken
        let streams = self.streams.take() ?? Streams.new()
        var out = CreativeStack.Unready
        match items.read_untrusted(mut rd, streams) {
            ok(t) => {
                if rd.left() != 0 {
                    out = CreativeStack.Fault("Packet play/{packet} (ServerboundSetCreativeModeSlotPacket) was larger than I expected, found {rd.left()} bytes extra whilst reading packet {packet}")
                } else {
                    var valid = true
                    if let s = t {
                        valid = count_of(s) <= items.max_stack_size(s)
                    }
                    out = CreativeStack.Read(t, valid)
                }
            },
            err(e) => {
                if e.message.starts_with("Calcite reads the stream of ") {
                    out = CreativeStack.Unread(e.message.copy())
                } else {
                    out = CreativeStack.Fault("Failed to decode packet '{packet}': {e.message}")
                }
            },
        }
        self.items = some(items)
        self.streams = some(streams)
        return out
    }

    // `handleSetCreativeModeSlot`, its stack read first as the packet's codec reads it, which
    // stops the connection where it doesn't read: a player with infinite materials puts a stack
    // in a slot of their inventory menu, from 1 to 45, where it's no more than its item stacks
    // to. What's thrown out, under 0, is dropped as an item, which Calcite has no entities for
    // yet, so it's gone. A stack with a component whose stream Calcite doesn't read yet is let
    // be, with a warning.
    fn creative_slot(mut self, con: mut Connection, c: ServerboundSetCreativeModeSlot) -> bool {
        var stack: Tag? = none
        var valid_data = true
        match self.creative_stack(c) {
            CreativeStack.Unready => return true,
            CreativeStack.Unread(why) => {
                self.logs.push(Entry.warn("{player_name(con)} set a creative slot to a stack {why}"))
                return true
            },
            CreativeStack.Fault(f) => {
                self.fault(mut con, decode_exception(f))
                return false
            },
            CreativeStack.Read(t, valid) => {
                stack = t
                valid_data = valid
            },
        }
        if not con.player.abilities.instabuild {
            return true
        }
        let slot = i32(c.slot)
        if slot >= 1 and slot <= 45 and valid_data {
            // `setByPlayer`, which the armor's slots and the offhand's call `onEquipItem` in, and
            // the crafting grid tells the menu of; then the client has it, and what it hasn't is
            // sent (D374).
            let n = usize.wrap(slot)
            var fx = List<Effect>()
            let codecs = self.items.take() else return true
            put_by_player(mut con.player.inventory, self.world.recipes.copy(), n, stack, codecs, mut fx)
            self.items = some(codecs)
            self.menu_effects(mut con, fx)
            con.player.menu.set_remote(n, stack)
            self.broadcast_inventory(mut con)
        }
        return true
    }

    // `LivingEntity.onEquipItem` for the player putting `stack` in the equipment slot `worn`, a
    // name as `EquipmentSlot`'s codec has it, where `old` was: a stack of another item or other
    // components than `old`'s, `equippable` in that slot, plays its `equip_sound`, or
    // `item.armor.equip_generic` where it has none, at the player, among the players' sounds, 7.
    // An equip sound given in full rather than by its ID, and the game event the change makes,
    // which sculk hears, Calcite doesn't have yet.
    fn equip_sound(mut self, con: mut Connection, worn: String, old: Tag?, stack: Tag?) {
        let given = stack else return
        if let was = old {
            if same_item_components(was, given) {
                return
            }
        }
        var equippable: Tag? = none
        if let items = self.items {
            equippable = items.component(given, String("minecraft:equippable"))
        }
        let found = equippable else return
        let Tag.Compound(e) = found else return
        if not e.contains("slot") {
            return
        }
        let equippable_slot = match e["slot"] {
            Tag.Str(s) => s.copy(),
            _ => return,
        }
        if equippable_slot != worn {
            return
        }
        var sound = String("item.armor.equip_generic")
        if e.contains("equip_sound") {
            match e["equip_sound"] {
                Tag.Str(s) => sound = if s.starts_with("minecraft:") { s[10..].copy() } else { s.copy() },
                _ => return,
            }
        }
        let (d, x, y, z) = (con.player.dim, con.player.x, con.player.y, con.player.z)
        self.levels[d].play_entity_sound(sound, x, y, z, PLAYERS)
        // Its seed is a long of the player's own random (CAL-148), which the sound's packet
        // carries, though Calcite's sounds take theirs from the level.
        if let r = con.player.random {
            var drawn = r
            _ = drawn.next_long()
            con.player.random = some(drawn)
        }
    }

    // Takes the player to `x`, `y`, `z` in the dimension at `to`, as `ServerPlayer.teleport` takes
    // a player whose level changes: the client's told of the dimension, its difficulty and their
    // permission level, they leave the old level, which drops the chunks of their view, they're
    // put at the place, and enter the new level, which sends its chunks, then their abilities,
    // the level's info, their inventory and the slot they hold, their effects and the post
    // effects (D514). In the same dimension, they're only put at the place (CAL-69).
    fn change_dimension(mut self, con: mut Connection, to: usize, x: f64, y: f64, z: f64, y_rot: f32, x_rot: f32) {
        self.change_dimension_by(mut con, to, x, y, z, y_rot, x_rot, 0)
    }

    // `change_dimension` of a change with `relatives`, `Relative`'s bits, as `teleport_by` takes
    // them (D577). Into another dimension, they're on their way, `isChangingDimension`, till
    // their client accepts it; from the Overworld into the Nether, where they were is kept,
    // `enteredNetherPosition`; and once they're in the new level, `CHANGED_DIMENSION` is
    // triggered, then, from the Nether into the Overworld, `NETHER_TRAVEL` from where they went
    // into it, which is forgotten out of the Nether, `triggerDimensionChangeTriggers`.
    fn change_dimension_by(mut self, con: mut Connection, to: usize, x: f64, y: f64, z: f64, y_rot: f32, x_rot: f32, relatives: i32) {
        let from = con.player.dim
        if from == to {
            self.teleport_by(mut con, x, y, z, y_rot, x_rot, relatives)
            reset_position(mut con)
            self.track(mut con, false)
            return
        }
        con.player.changing_dimension = true
        let spawn = self.spawn_info(to, con.player.mode, con.player.previous_mode, con.player.last_death.copy(), con.player.portal_cooldown)
        self.send(mut con, ClientboundRespawn { spawn: spawn, data_to_keep: KEEP_ALL_DATA }, State.Play)
        let difficulty = self.world.settings.difficulty
        self.send(mut con, ClientboundChangeDifficulty { difficulty: difficulty, locked: false }, State.Play)
        let (level, id) = (con.player.level, con.player.entity_id)
        self.send(mut con, ClientboundEntityEvent { entity_id: id, event: i8.wrap(24 + level) }, State.Play)
        self.send(mut con, tree(level), State.Play)
        // Out of the old level, as `removePlayerImmediately` takes them: the chunks of their view
        // are dropped, as `applyChunkTrackingView` drops them for an empty view, then their
        // tickets go, and the far chunks read for them. Their client's told to forget none of
        // them, as they're removed as they go, `isAlive` false, till `unsetRemoved` (D577).
        let was_removed = con.player.removed
        con.player.removed = true
        self.drop_view(mut con)
        con.player.removed = was_removed
        // Their view's then empty, `ChunkTrackingView.EMPTY`, till they're in the new level, so
        // the waypoints their move there links them to go by chunk (D577).
        con.player.view = -1
        self.levels[from].remove_player(ChunkPos { x: con.player.section_x, z: con.player.section_z }, con.player.entity_id)
        self.levels[from].forget_player(con.player.entity_id)
        // Their tracker's path, their interpolation tracker's, the entity's own, kept for their
        // tracker in the new level (D577).
        con.player.carried_path = self.tracker_path(from, con.player.entity_id)
        // `ChunkMap.removeEntity`: the items they saw are taken from their client (CAL-148).
        for gone in self.untrack_player(from, con.player.entity_id) {
            self.send(mut con, ClientboundRemoveEntities { entity_ids: [gone] }, State.Play)
        }
        let told = self.waypoints_leave(from, con.player.entity_id)
        self.tell_waypoints(told, mut con)
        // `onTrackingEnd`'s: the old level's sleepers counted again, without them (D574).
        self.sleepers(from)
        // `Player.remove` closes the inventory menu, which puts what the cursor carries and the
        // crafting grid back in the inventory, for a player changing dimension (D374), then the
        // container's menu they have open (CAL-144).
        self.close_inventory(mut con)
        self.close_container(mut con)
        if self.dim_is(from, "overworld") and self.dim_is(to, "the_nether") {
            con.player.entered_nether = some((con.player.x, con.player.y, con.player.z))
        }
        con.player.dim = to
        self.teleport_by(mut con, x, y, z, y_rot, x_rot, relatives)
        reset_position(mut con)
        self.enter_level(mut con)
        self.dimension_changed(mut con, from)
        // `teleport`'s `stopUsingItem` (D519).
        stop_using(mut con)
        let abilities = con.player.abilities
        self.send(mut con, ClientboundPlayerAbilities { abilities: abilities }, State.Play)
        self.level_info(mut con)
        self.send_inventory(mut con)
        let slot = con.player.selected
        self.send(mut con, ClientboundSetHeldSlot { slot: slot }, State.Play)
        // `sendActivePlayerEffects` and `sendPostEffects` (D514).
        self.send_active_effects(mut con)
        self.send(mut con, ClientboundPostEffects { effects: [] }, State.Play)
        // Their experience, health and food sent again on their next tick (CAL-141).
        con.player.status.sent_xp = -1
        con.player.status.sent_health = -1.0f32
        con.player.status.sent_food = -1
    }

    // Whether the dimension at `d` is vanilla's `minecraft:` one named `path`.
    fn dim_is(self, d: usize, path: str) -> bool {
        return self.world.dims[d].id.namespace == "minecraft" and self.world.dims[d].id.path == String(path)
    }

    // `triggerDimensionChangeTriggers` of the player, come from the dimension at `from` (D577):
    // each criterion of `CHANGED_DIMENSION` listening whose `from` and `to` are where they came
    // from and are, where they're given, and whose player's condition holds, awarded; then, from
    // the Nether into the Overworld, where they went into the Nether, each of `NETHER_TRAVEL`'s
    // whose `distance` holds from there to where they are; then, out of the Nether, where they went
    // in's forgotten. A criterion with a `start_position` is said to be missing.
    fn dimension_changed(mut self, con: mut Connection, from: usize) {
        let to = con.player.dim
        let came = self.world.dims[from].id.to_string()
        let now = self.world.dims[to].id.to_string()
        self.dimension_criteria(mut con, came, now)
        if self.dim_is(from, "the_nether") and self.dim_is(to, "overworld") {
            if let (sx, sy, sz) = con.player.entered_nether {
                var traveled = List<Listener>()
                for (key, conditions) in con.player.advancements.listening(String("minecraft:nether_travel")) {
                    if field_of(conditions, "start_position") != Tag.End {
                        self.levels[to].unimplemented(String("Where a player went into the Nether, as nether_travel's start_position"))
                        continue
                    }
                    let distance = field_of(conditions, "distance")
                    if distance != Tag.End and not distance_holds(distance, sx, sy, sz, con.player.x, con.player.y, con.player.z) {
                        continue
                    }
                    if self.player_holds(con, conditions) {
                        traveled.push(key.copy())
                    }
                }
                self.award_all(mut con, traveled)
            }
        }
        if not self.dim_is(to, "the_nether") {
            con.player.entered_nether = none
        }
    }

    // `CHANGED_DIMENSION` of the player, come from the dimension named `came` into the one named
    // `now` (D577, D586): each criterion listening whose `from` and `to` are those, where they're
    // given, and whose player's condition holds, awarded.
    fn dimension_criteria(mut self, con: mut Connection, came: String, now: String) {
        var matched = List<Listener>()
        for (key, conditions) in con.player.advancements.listening(String("minecraft:changed_dimension")) {
            if not dimension_holds(field_of(conditions, "from"), came) or not dimension_holds(field_of(conditions, "to"), now) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        self.award_all(mut con, matched)
    }

    // Drops every chunk of the player's view, as `applyChunkTrackingView` drops them for an empty
    // one: those the client has are forgotten, column by column.
    fn drop_view(mut self, con: mut Connection) {
        let center = ChunkPos { x: con.player.center_x, z: con.player.center_z }
        let view = con.player.view
        for x in center.x - view - 1..center.x + view + 2 {
            let (lo, hi) = column(center, view, x)
            for z in lo..hi + 1 {
                self.forget(mut con, ChunkPos { x: x, z: z })
            }
        }
    }

    // Puts the player at a place, their motion none (D420), which the client is to accept before
    // it moves on its own, as the play listener's `teleport`.
    fn teleport(mut self, con: mut Connection, x: f64, y: f64, z: f64, y_rot: f32, x_rot: f32) {
        self.teleport_by(mut con, x, y, z, y_rot, x_rot, 0)
    }

    // The play listener's `teleport` of a change with `relatives`, `Relative`'s bits (CAL-165):
    // each part from where the player is where its bit's set, else from nothing, as
    // `PositionMoveRotation.calculateAbsolute` adds them, their pitch then kept within 90 of
    // level, and their motion along each axis whose bit of motion is set the movement their
    // client last told of, as `PositionMoveRotation.of` takes a player's `getKnownMovement`, not
    // the motion the server keeps, else none (D565); their head turned with them,
    // `teleportSetPosition`. The client is sent the change and the bits, and is to accept it
    // before it moves on its own. Where the motion's turned with them, `ROTATE_DELTA`, it's
    // turned by the pitch they turn by, then the yaw, from where they were to where they are, as
    // `Vec3.xRot` and `yRot` turn it, of `Mth`'s table (D577).
    fn teleport_by(mut self, con: mut Connection, x: f64, y: f64, z: f64, y_rot: f32, x_rot: f32, relatives: i32) {
        let ox = if relatives & 1 != 0 { con.player.x } else { 0.0 }
        let oy = if relatives & 2 != 0 { con.player.y } else { 0.0 }
        let oz = if relatives & 4 != 0 { con.player.z } else { 0.0 }
        let o_y_rot = if relatives & 8 != 0 { con.player.y_rot } else { 0.0f32 }
        let o_x_rot = if relatives & 16 != 0 { con.player.x_rot } else { 0.0f32 }
        let to_y_rot = o_y_rot + y_rot
        let to_x_rot = (o_x_rot + x_rot).max(-90.0f32).min(90.0f32)
        var (mx, my, mz) = (con.player.known_x, con.player.known_y, con.player.known_z)
        if relatives & 256 != 0 {
            let (rx, ry, rz) = rotate_delta((mx, my, mz), (con.player.y_rot, con.player.x_rot), (to_y_rot, to_x_rot))
            mx = rx
            my = ry
            mz = rz
        }
        con.player.vx = if relatives & 32 != 0 { mx + 0.0 } else { 0.0 }
        con.player.vy = if relatives & 64 != 0 { my + 0.0 } else { 0.0 }
        con.player.vz = if relatives & 128 != 0 { mz + 0.0 } else { 0.0 }
        con.player.awaiting_time = con.player.tick_count
        con.player.teleport_id += 1
        if con.player.teleport_id == 2147483647 {
            con.player.teleport_id = 0
        }
        let was = (con.player.x, con.player.y, con.player.z)
        con.player.x = ox + x
        con.player.y = oy + y
        con.player.z = oz + z
        con.player.awaiting_x = con.player.x
        con.player.awaiting_y = con.player.y
        con.player.awaiting_z = con.player.z
        self.moved_from(mut con, was)
        con.player.y_rot = to_y_rot
        con.player.x_rot = to_x_rot
        // `teleportSetPosition`'s `setYHeadRot` (CAL-174).
        con.player.y_head_rot = to_y_rot
        con.player.awaiting = true
        let p = ClientboundPlayerPosition { teleport_id: con.player.teleport_id, x: x, y: y, z: z, delta_x: 0.0, delta_y: 0.0, delta_z: 0.0, y_rot: y_rot, x_rot: x_rot, relatives: relatives }
        self.send(mut con, p, State.Play)
    }

    // Moves the player's view to the chunk they're in, at the distance the client asks for up
    // to the server's, as `ChunkMap.updateChunkTracking` and `applyChunkTrackingView`, or at
    // `force-view-distance` if it's set: the client is told its new center, the chunks that
    // left the view are dropped, and forgotten if the client has them, and those that came into
    // it are queued. `first` is for a player who had no view, as one joining. The views are
    // walked a column at a time, so a move costs the chunks that change, not the view's area.
    fn track(mut self, con: mut Connection, first: bool) {
        let center = ChunkPos.containing(con.player.x, con.player.z)
        let asked = i32(con.information.view_distance)
        let forced = self.world.settings.force_view_distance
        let view = if forced > 0 { forced } else { clamp(asked, 2, self.world.settings.view_distance) }
        if forced > 0 and asked != con.player.asked {
            con.player.asked = asked
            self.logs.push(Entry.info("{player_name(con)} asks for a view distance of {asked} and is sent {view}, from force-view-distance"))
        }
        let old = ChunkPos { x: con.player.center_x, z: con.player.center_z }
        let old_view = con.player.view
        if not first and old.x == center.x and old.z == center.z and old_view == view {
            return
        }
        con.player.center_x = center.x
        con.player.center_z = center.z
        con.player.view = view
        if first or old.x != center.x or old.z != center.z {
            self.send(mut con, ClientboundSetChunkCacheCenter { x: center.x, z: center.z }, State.Play)
        }
        self.spiral.fit(view)
        if first {
            con.player.sender.move_to(center, view)
            con.player.sender.mark_all()
            return
        }
        // The squares a chunk beyond each view, as `ChunkTrackingView.difference` walks them
        // when they overlap: by `x`, then `z`. Those that left go first, then those that came,
        // as a chunk coming in can have the sender's bit of one going out.
        let min_x = min(old.x - old_view, center.x - view) - 1
        let max_x = max(old.x + old_view, center.x + view) + 1
        let overlap = old.x - old_view - 1 <= center.x + view + 1 and old.x + old_view + 1 >= center.x - view - 1 and old.z - old_view - 1 <= center.z + view + 1 and old.z + old_view + 1 >= center.z - view - 1
        if not overlap {
            for x in old.x - old_view - 1..old.x + old_view + 2 {
                let (lo, hi) = column(old, old_view, x)
                for z in lo..hi + 1 {
                    self.forget(mut con, ChunkPos { x: x, z: z })
                }
            }
            con.player.sender.move_to(center, view)
            con.player.sender.mark_all()
            return
        }
        // In each column, what one view holds and the other doesn't is below the other's
        // column, then above it.
        for x in min_x..max_x + 1 {
            let (was_lo, was_hi) = column(old, old_view, x)
            let (now_lo, now_hi) = column(center, view, x)
            for z in was_lo..min(was_hi, now_lo - 1) + 1 {
                self.forget(mut con, ChunkPos { x: x, z: z })
            }
            for z in max(was_lo, now_hi + 1)..was_hi + 1 {
                self.forget(mut con, ChunkPos { x: x, z: z })
            }
        }
        con.player.sender.move_to(center, view)
        for x in min_x..max_x + 1 {
            let (was_lo, was_hi) = column(old, old_view, x)
            let (now_lo, now_hi) = column(center, view, x)
            for z in now_lo..min(now_hi, was_lo - 1) + 1 {
                con.player.sender.mark_pending(ChunkPos { x: x, z: z })
            }
            for z in max(now_lo, was_hi + 1)..now_hi + 1 {
                con.player.sender.mark_pending(ChunkPos { x: x, z: z })
            }
        }
    }

    // A chunk left the player's view, as `PlayerChunkSender.dropChunk`: the client is told to
    // forget it unless it's waiting to be sent, which, near the player, is once it's ready, or
    // the player's dead (D427). A far chunk read for the player goes, and is forgotten only if it
    // was sent.
    fn forget(mut self, con: mut Connection, c: ChunkPos) {
        let near = con.player.sender.near(c)
        let sent = con.player.sender.drop_chunk(c)
        let d = con.player.dim
        if not near {
            self.levels[d].forget_far(c, con.player.entity_id)
        }
        let alive = not con.player.removed and con.player.entity_data.float(HEALTH) > 0.0f32
        if (sent or (near and not self.levels[d].sendable(c))) and alive {
            self.send(mut con, ClientboundForgetLevelChunk { pos: c }, State.Play)
        }
    }

    // A player's tick at `now`, as the play listener's `tick`: their block changes acked, up to
    // the last they asked to be (D376); then, as `tickPlayer` runs it, where they are kept,
    // `resetPosition`, their own tick, `doTick`, their moves so far counted and their floating
    // looked at, which may kick them, ending the tick (D420); then a keep-alive if one is due,
    // then the spam counts go down.
    fn tick_play(mut self, con: mut Connection, now: u64) {
        con.player.tick_count += 1
        if con.player.ack > -1 {
            let sequence = con.player.ack
            self.send(mut con, ClientboundBlockChangedAck { sequence: sequence }, State.Play)
            con.player.ack = -1
        }
        reset_position(mut con)
        self.do_tick(mut con)
        con.player.known_packets = con.player.move_packets
        if self.kick_floating(mut con) {
            return
        }
        _ = self.keep_alive(mut con, now)
        con.player.chat_spam.tick()
        con.player.command_spam.tick()
        // `ServerCommandSuggestionsProvider.tick`: a request a tick (CAL-165).
        con.player.suggest_budget = true
        self.try_suggest(mut con)
    }

    // The players of the level `d`'s own ticks, `ServerPlayer.tick`, as its entities tick, in the
    // order they came into it, of what Calcite has so far: their game mode's, as they dig (D376),
    // what that sets off sent at once; their menu's changes sent, `broadcastChanges` (D374); the
    // tick trigger (CAL-164); the attributes their mode and pose give them,
    // `updatePlayerAttributes` (D375, CAL-141); and their advancements' changes sent (CAL-164).
    fn tick_players(mut self, d: usize) {
        var order = List<(u64, usize)>()
        for slot in 0..self.connections.len() {
            if self.playing(slot) {
                if let c = self.connections[slot] {
                    // A dead player out of their level isn't among its entities (D427).
                    if c.player.dim == d and not c.player.removed {
                        order.push((c.player.entered, slot))
                    }
                }
            }
        }
        order.sort()
        // The items tick among them, in the order each came into the level (CAL-148).
        self.begin_items(d)
        for (entered, slot) in order {
            self.tick_items(d, entered)
            var con = self.connections[slot].take() else continue
            // `commonTick`'s `tickCount`, as `tickNonPassenger` counts it up before their tick
            // (D433), and where they are, `setOldPosAndRot` (D434).
            con.player.own_ticks += 1
            con.player.old_x = con.player.x
            con.player.old_y = con.player.y
            con.player.old_z = con.player.z
            // `tickClientLoadTimeout` (D418).
            if con.player.load_timer > 0 {
                con.player.load_timer -= 1
            }
            self.tick_game_mode(mut con)
            self.send_level_events_with(d, mut con)
            // A player's `damageCooldownTime`, counted down here, not in `LivingEntity.baseTick`
            // (D418).
            if con.player.damage_cooldown > 0 {
                con.player.damage_cooldown -= 1
            }
            self.broadcast_menu(mut con)
            // `stillValid`, a container's menu closed once it's not (CAL-144).
            if not self.container_valid(con) {
                self.close_and_tell(mut con)
            }
            // `CriteriaTriggers.TICK` (CAL-164).
            self.trigger_simple(mut con, "minecraft:tick")
            // `LEVITATION` while they levitate, of where and when it began (CAL-164).
            let levitating = match con.player.levitation_start {
                some((sx, sy, sz)) => some((sx, sy, sz, con.player.own_ticks - con.player.levitation_time)),
                none => none,
            }
            if let (sx, sy, sz, ticks) = levitating {
                self.levitated(mut con, sx, sy, sz, ticks)
            }
            let crouching = con.player.entity_data.number(POSE_ID) == CROUCHING
            update_player(mut con.player.attributes, con.player.mode == GameType.Creative, crouching)
            // `flushDirty` of their advancements (CAL-164).
            self.flush_advancements(mut con)
            self.connections[slot] = some(con)
        }
        self.tick_items(d, u64.MAX)
        self.end_items(d)
    }

    // Starts the tick of the level `d`'s items (CAL-148).
    fn begin_items(mut self, d: usize) {
        var es = self.take_entities(d)
        es.list.begin_tick()
        es.list.peaceful = self.world.settings.difficulty == Difficulty.Peaceful
        es.list.cramming = self.world.cramming
        es.list.mob_drops = self.world.mob_drops
        es.list.mob_griefing = self.world.mob_griefing
        es.list.universal_anger = self.world.universal_anger
        es.list.border = some(self.border_of(d))
        es.list.pvp = self.world.pvp
        // Whether its nether portals may take what's in them where they lead,
        // `isAllowedToEnterPortal`: into the Nether only where
        // `allow_entering_nether_using_portals` lets them (D578).
        let target = self.portal_target(d)
        es.list.portal_open = target != none and (self.world.nether_portals or not self.dim_is(target ?? 0, "the_nether"))
        // Its end portals likewise, into the End, or out of it where the world's spawn is, but
        // within it, which Calcite doesn't have them do (D587).
        let end_target = if self.dim_is(d, "the_end") { self.respawn_level() } else { self.the_end() }
        es.list.end_portal_open = end_target != none and end_target != some(d) and (self.world.nether_portals or not self.dim_is(end_target ?? 0, "the_nether"))
        // Whether it has a dragon fight, in which end crystals set the air they're in alight
        // (D589).
        es.list.fight = self.world.dims[d].fight != none
        // And of that fight, what its dragons read of it as they tick: its dragon's UUID, its
        // crystals alive and whether a dragon was killed in it before (D626).
        es.list.fight_dragon = none
        es.list.fight_crystals = 0
        es.list.fight_killed_before = false
        if let fight = self.world.dims[d].fight {
            if let u = fight.dragon {
                es.list.fight_dragon = some((u.most, u.least))
            }
            es.list.fight_crystals = fight.alive_crystals
            es.list.fight_killed_before = fight.previously_killed
        }
        // The players ender pearls may be owned by, wherever they are, alive or not, and whether
        // a dead one's pearls go (D579).
        var owners = List<PearlOwner>()
        for slot in 0..self.connections.len() {
            let c = self.connections[slot] else continue
            if not in_world(c) {
                continue
            }
            let p = c.profile else continue
            owners.push(PearlOwner { uuid: (p.id.most, p.id.least), alive: player_alive(c), serial: c.player.serial })
        }
        es.list.pearl_owners = owners
        es.list.pearls_vanish = self.world.pearls_vanish
        es.list.scored = if self.world.scoreboard.scores.is_empty() and self.world.scoreboard.team_of.is_empty() { List<(i64, i64)>() } else { self.world.scoreboard.uuid_holders() }
        es.list.game_time = self.world.game_time
        es.list.hard = self.world.settings.difficulty == Difficulty.Hard
        es.list.difficulty = self.world.settings.difficulty.id()
        let (adult, baby) = self.villager_activities_now(d)
        es.list.villager_activity = adult
        es.list.baby_activity = baby
        es.list.day = self.overworld_days()
        es.list.dimension = self.world.dims[d].id.to_string()
        self.put_entities(d, es)
    }

    // The overworld's day's count, `getPeriodCount` of `Timelines.OVERWORLD_DAY` on the world's
    // clocks: the ticks its clock has run by its period, cut to an `int` as Java's cast cuts it; 0
    // where the registries haven't it (CAL-160).
    fn overworld_days(self) -> i64 {
        let (clock, period) = self.world.overworld_day else return 0
        return i64(i32.wrap(self.world.clocks.total_ticks(some(clock)) / i64(period)))
    }

    // The activities the level `d`'s villager schedules have now, a grown villager's and a
    // baby's, `gameplay/villager_activity` and `gameplay/baby_villager_activity`, by
    // `world.brain`'s numbering (CAL-160). No biome of vanilla's sets them, so they're the
    // level's.
    fn villager_activities_now(mut self, d: usize) -> (i32, i32) {
        let rain = self.world.dims[d].weather.rain_level()
        let thunder = self.world.dims[d].weather.thunder_level()
        let adult = self.world.dims[d].environment.number(villager_activity(), self.world.clocks, rain, thunder)
        let baby = self.world.dims[d].environment.number(baby_villager_activity(), self.world.clocks, rain, thunder)
        return (i32.saturate(f64(adult)), i32.saturate(f64(baby)))
    }

    fn end_items(mut self, d: usize) {
        var es = self.take_entities(d)
        es.list.end_tick()
        self.put_entities(d, es)
    }

    // Ticks the level `d`'s items that came into it before `before`, as `ServerLevel.tick` runs
    // its tick list (CAL-148), an entity at a time, `tick_one`; the level's players read again
    // after an entity's attack on one, as it may have hurt or killed them (CAL-159).
    fn tick_items(mut self, d: usize, before: u64) {
        let shared = self.levels[d].shared_env() else return
        let Env { facts: f, .. } = shared.value
        if self.movement == none {
            self.movement = some(MovementStates.new(f))
        }
        if self.item_facts == none {
            self.item_facts = some(BodyFacts.new(f))
        }
        if not self.items_ready() or not self.living_ready(d) {
            return
        }
        var players = self.level_followers(d, f)
        loop {
            let (going, attacked) = self.tick_one(d, before, f, players)
            if not going {
                break
            }
            if attacked {
                players = self.level_followers(d, f)
            }
        }
        // The blocks sent again, which the entities have read, let go (CAL-157).
        self.levels[d].sent.clear()
    }

    // The players of the level `d` as entities read them, `followers`, with the living's facts
    // lent (CAL-159).
    fn level_followers(mut self, d: usize, f: Facts) -> List<Follower> {
        let lf = self.living_facts.take() else return List<Follower>()
        let out = self.followers(d, lf, f)
        self.living_facts = some(lf)
        return out
    }

    // The tick of the level `d`'s next entity that came into it before `before`, `players` its
    // players (CAL-148): the sounds it plays and the items that go as it ticks sent in the order
    // they came, the items gone taken from those who saw them, with what it showed among them.
    // The level's facts are given back before what it showed is done, as a player its attack hurts
    // may die, which reads them (CAL-159). Whether there was one, and whether it attacked a player.
    fn tick_one(mut self, d: usize, before: u64, f: Facts, players: List<Follower>) -> (bool, bool) {
        let m = self.movement.take() else return (false, false)
        let t = self.item_facts.take() else {
            self.movement = some(m)
            return (false, false)
        }
        let codecs = self.items.take() else {
            self.movement = some(m)
            self.item_facts = some(t)
            return (false, false)
        }
        let lf = self.living_facts.take() else {
            self.movement = some(m)
            self.item_facts = some(t)
            self.items = some(codecs)
            return (false, false)
        }
        let min_y = self.world.dims[d].min_y
        let fast = self.levels[d].fast_lava
        var es = self.take_entities(d)
        // An end gateway with no exit in the End makes one as the entity it takes ticks (D595).
        if not self.gateway_makes.is_empty() {
            if let id = es.list.next_up(before) {
                self.gateway_make_for(d, id)
            }
        }
        var sounds = List<EntitySound>()
        es.list.tracing = self.tracing
        // The level's random, lent to its entities for the tick, which a brain mob's behaviors draw
        // from (CAL-160), and given back before what they showed is done.
        es.list.level_random = some(self.levels[d].lend_random())
        es.list.pois = some(self.levels[d].lend_pois())
        let going = es.list.tick_next(before, f, m, t, lf, codecs, self.levels[d], min_y, fast, players, mut sounds)
        // The tickets ender pearls put as they flew, `placeEnderPearlTicket` (D579), each with its
        // level's empty time none, `registerAndUpdateEnderPearlTicket` (D621).
        let pearled = es.list.pearl_tickets.copy()
        es.list.pearl_tickets.clear()
        for (px, pz) in pearled {
            self.levels[d].empty_time = 0
            self.levels[d].load_pearl(ChunkPos { x: px, z: pz })
        }
        // The points of interest an entity's lodestone compass wanted, asked for (D607).
        let wanted = es.list.poi_asks.copy()
        es.list.poi_asks.clear()
        match es.list.level_random.take() {
            some(r) => self.levels[d].give_back_random(r),
            none => panic("the entities kept the level's random"),
        }
        match es.list.pois.take() {
            some(p) => self.levels[d].give_back_pois(p),
            none => panic("the entities kept the level's points of interest"),
        }
        for c in wanted {
            _ = self.levels[d].pois_known(c, 0)
        }
        if self.tracing {
            self.trace.push_str(es.list.trace)
            es.list.trace = String()
        }
        self.items = some(codecs)
        self.movement = some(m)
        self.item_facts = some(t)
        self.living_facts = some(lf)
        if not going {
            self.put_entities(d, es)
            return (false, false)
        }
        let after = es.list.gone_after.copy()
        let gone = es.list.take_gone()
        let shown_by = es.list.shown_by.copy()
        let shown_after = es.list.shown_after.copy()
        let shown = es.list.take_shown()
        var attacked = false
        for w in shown {
            match w {
                Shown.Attack(_) => attacked = true,
                Shown.Shot(_) => attacked = true,
                Shown.Stabbed(_) => attacked = true,
                _ => {},
            }
        }
        var k = 0usize
        var n = 0usize
        for g in 0..gone.len() {
            while n < shown.len() and shown_after[n] <= after[g] {
                k = self.play_until(d, sounds, k, shown_after[n])
                es = self.show(es, d, shown_by[n], shown[n])
                n += 1
            }
            k = self.play_until(d, sounds, k, after[g])
            self.send_level_events(d)
            self.item_gone(mut es, gone[g])
            if not es.list.unscored.is_empty() {
                self.unscore(mut es, some(gone[g]))
            }
        }
        while n < shown.len() {
            k = self.play_until(d, sounds, k, shown_after[n])
            es = self.show(es, d, shown_by[n], shown[n])
            n += 1
        }
        if let lent = self.living_facts.take() {
            es.list.push_bred(lent, f, self.levels[d], players)
            self.living_facts = some(lent)
        }
        for (id, xa, za) in es.list.take_player_pushes() {
            self.push_player_by(id, xa, za)
        }
        _ = self.play_until(d, sounds, k, sounds.len())
        self.send_level_events(d)
        // Those the scoreboard had that went another way, forgotten too (CAL-164).
        if not es.list.unscored.is_empty() {
            self.unscore(mut es, none)
        }
        self.put_entities(d, es)
        return (true, attacked)
    }

    // `FarmlandBlock.turnToBaseBlock` of the farmland at x, y, z in the level `d`, a mob's trample
    // (CAL-160): what's in the way of the dirt's top pushed up onto it, `pushEntitiesUp`, a player
    // among them said to be missing, then the farmland dirt, set and updated, what grew on it
    // breaking with its drops, made then. Its game event comes with game events.
    fn trample(mut self, es: own LevelEntities, d: usize, x: i32, y: i32, z: i32) -> LevelEntities {
        var all = es
        let slab = Aabb { min_x: f64(x), min_y: f64(y) + 0.9375, min_z: f64(z), max_x: f64(x) + 1.0, max_y: f64(y) + 1.0, max_z: f64(z) + 1.0 }
        all.list.push_up(slab)
        if self.player_meets(d, slab) {
            self.levels[d].unimplemented(String("Players pushed up as farmland under them turns to dirt"))
        }
        self.levels[d].turn_to_dirt(x, y, z)
        self.send_level_events(d)
        self.put_entities(d, all)
        self.make_drops(d)
        return self.take_entities(d)
    }

    // Plays the sounds of an entity's tick from `from` up to `to`, or the last; where it got to.
    fn play_until(mut self, d: usize, sounds: List<EntitySound>, from: usize, to: usize) -> usize {
        var k = from
        while k < to and k < sounds.len() {
            self.play_item_sound(d, sounds[k])
            k += 1
        }
        return k
    }

    // What the living entity `id` showed, in its place among its sounds (CAL-155): its dust, kept
    // with them in the order the level's players hear it; an entity event, `broadcastEntityEvent`,
    // sent to those who see it after what was heard before it; a chicken's egg, an item made there,
    // `spawnAtLocation`, after what was heard, the table's random sequence made as
    // `getRandomSequence` makes it, though one entry draws nothing from it (CAL-156); what a
    // sheep's eating does to the level, where mob griefing lets it, its level event sent then; an
    // enderman's take of a block, its carried block then the block's default state, saved as the
    // codecs write it, and its leave of it where nothing's in the way, not even a player who isn't
    // a spectator (CAL-159); what a farm animal's breeding asks of it, `bred` (CAL-158); a hurt in
    // its own tick that took the whole of it, its damage event, `broadcastDamageEvent`, with
    // nothing causing it; its death there, `died`; an armor stand's breaking, `stand_broken`,
    // before its removal's sent (D441); or what's missing, said (D424). The level's entities, which
    // the egg, the orb, the baby and what a death drops join; `lf`, which the baby's made by.
    fn show(mut self, es: own LevelEntities, d: usize, id: i32, what: Shown) -> LevelEntities {
        match what {
            Shown.Swung((hand, kind, duration)) => {
                self.send_level_events(d)
                if es.trackers.contains(id) {
                    self.send_to_seen(es.trackers[id].seen_by, encode_play(ClientboundSwingAnimation { entity_id: id, hand: hand, kind: kind, duration: duration }))
                }
            },
            Shown.Attack(hit) => {
                self.send_level_events(d)
                let (target, ax, ay, az) = hit
                return self.mob_attack(es, d, id, target, ax, ay, az)
            },
            Shown.Shot(hits) => {
                self.send_level_events(d)
                return self.arrow_hits(es, d, id, hits)
            },
            Shown.Stabbed(stabs) => {
                self.send_level_events(d)
                return self.mob_stabs(es, d, id, stabs)
            },
            Shown.Beaten(beats) => {
                self.send_level_events(d)
                var all = es
                for b in beats {
                    all = self.dragon_beat(all, d, id, b)
                }
                return all
            },
            Shown.Breathed((at, owner)) => {
                // An ender dragon's breath's cloud, `addFreshEntity` (D617): its entity ID next,
                // its random seeded from it, kept by the dragon for its breath's end.
                self.send_level_events(d)
                self.entity_ids += 1
                let cloud_id = self.entity_ids
                let seed = self.entity_seed(cloud_id)
                if let lent = es.list.lend_mob(id) {
                    var mob = lent
                    mob.set_dragon_flame(cloud_id)
                    es.list.give_back_mob(mob)
                }
                let (x, y, z) = at
                let cloud = EffectCloud.breathed(cloud_id, seed, x, y, z, owner)
                self.put_entities(d, es)
                self.add_cloud(d, cloud)
                return self.take_entities(d)
            },
            Shown.Quenched(cloud_id) => {
                // `DragonSittingFlamingPhase.end`: its breath's cloud discarded, where it isn't
                // gone, and its removal sent those who see it at once (D617).
                self.send_level_events(d)
                var all = es
                let lent = all.list.lend_cloud(cloud_id) else return all
                let gone = lent.body.removed
                all.list.give_back_cloud(lent)
                if gone {
                    return all
                }
                all.list.remove(cloud_id)
                _ = all.list.take_gone()
                _ = all.tracked.remove(cloud_id)
                let seen = match all.trackers.remove(cloud_id) {
                    some(tr) => tr.seen_by.copy(),
                    none => List<i32>(),
                }
                self.send_to_seen(seen, encode_play(ClientboundRemoveEntities { entity_ids: [cloud_id] }))
                return all
            },
            Shown.DragonSeen(progress) => {
                // `EnderDragonFight.updateDragon` (D626): its boss bar's progress the dragon's
                // health over its most, `setProgress`, sent its players where it changed; its
                // count since it last saw its dragon none; and where the dragon's given a name,
                // the bar named for it, `getDisplayName`, sent where it changed.
                self.send_level_events(d)
                var all = es
                var fight = self.world.dims[d].fight.take() else return all
                fight.since_seen = 0
                var sent = List<BossSent>()
                if let had = fight.bar.take() {
                    var bar = had
                    bar.set_progress(progress, mut sent)
                    if let lent = all.list.lend_mob(id) {
                        let named = if custom_name_of(lent.living) != none { some(mob_display_name(lent)) } else { none }
                        all.list.give_back_mob(lent)
                        if let name = named {
                            bar.set_name(name, mut sent)
                        }
                    }
                    fight.bar = some(bar)
                }
                self.world.dims[d].fight = some(fight)
                self.send_boss(sent)
                return all
            },
            Shown.FireballShot((at, way, owner)) => {
                // An ender dragon's strafe's fireball, `addFreshEntity` (D619), after the event of
                // its shot: its entity ID next, its random seeded from it.
                self.send_level_events(d)
                self.entity_ids += 1
                let fireball_id = self.entity_ids
                let seed = self.entity_seed(fireball_id)
                let (x, y, z) = at
                let (xd, yd, zd) = way
                let fireball = DragonFireball.fired(fireball_id, seed, x, y, z, owner, xd, yd, zd)
                self.put_entities(d, es)
                self.add_fireball(d, fireball)
                return self.take_entities(d)
            },
            Shown.Struck(struck) => {
                self.send_level_events(d)
                return self.block_struck(es, d, id, struck)
            },
            Shown.Splashed(splash) => {
                self.send_level_events(d)
                return self.splash(es, d, splash)
            },
            Shown.Pearled(landed) => {
                self.send_level_events(d)
                // What it hit hurt first, `onHitEntity` (D581).
                var all = es
                if let target = landed.entity {
                    all = self.pearl_hurts(all, d, landed.copy(), target)
                }
                self.put_entities(d, all)
                self.pearl_landed(d, landed)
                return self.take_entities(d)
            },
            Shown.Fireballed(struck) => {
                self.send_level_events(d)
                return self.fireball_splash(es, d, struck)
            },
            Shown.Dosed(dose) => {
                self.send_level_events(d)
                return self.cloud_doses(es, d, dose)
            },
            Shown.Kindled((x, y, z)) => {
                // An end crystal's fire, as its tick ends (D589).
                self.send_level_events(d)
                self.levels[d].kindle(x, y, z)
                self.send_level_events(d)
            },
            Shown.Fired(shot) => {
                self.send_level_events(d)
                self.put_entities(d, es)
                self.mob_fires(d, shot)
                return self.take_entities(d)
            },
            Shown.Hurled(thrown) => {
                self.send_level_events(d)
                self.put_entities(d, es)
                self.mob_hurls(d, thrown)
                return self.take_entities(d)
            },
            Shown.Dust(dust) => self.levels[d].fall_dust(dust.state, dust.x, dust.y, dust.z, dust.count),
            Shown.Level((kind, x, y, z, data)) => self.levels[d].mob_level_event(kind, x, y, z, data),
            Shown.Global((kind, x, y, z, data)) => self.levels[d].mob_global_event(kind, x, y, z, data),
            Shown.Awarded((x, y, z, amount)) => {
                // Experience given where it is, `ExperienceOrb.award`, as an ender dragon's death
                // gives it (D608): orbs of the values it splits into, each merged into one there
                // that can take it, drawn from the level's random, else made, `addFreshEntity`.
                self.send_level_events(d)
                for value in orb_values(amount) {
                    let pick = self.levels[d].next_int_below(40)
                    self.levels[d].add_orb(x, y, z, value, pick)
                }
                self.put_entities(d, es)
                self.make_drops(d)
                return self.take_entities(d)
            },
            Shown.Particle(p) => self.levels[d].send_particle(p.particle.copy(), p.x, p.y, p.z),
            Shown.Event(event) => {
                self.send_level_events(d)
                if es.trackers.contains(id) {
                    self.send_to_seen(es.trackers[id].seen_by, encode_play(ClientboundEntityEvent { entity_id: id, event: event }))
                }
            },
            Shown.EventOf((of, event)) => {
                self.send_level_events(d)
                if es.trackers.contains(of) {
                    self.send_to_seen(es.trackers[of].seen_by, encode_play(ClientboundEntityEvent { entity_id: of, event: event }))
                }
            },
            Shown.Worn(slots) => {
                self.send_level_events(d)
                if es.trackers.contains(id) {
                    let packet = self.equipment_packet(id, slots)
                    self.send_to_seen(es.trackers[id].seen_by, packet)
                }
            },
            Shown.Grazed(g) => {
                self.send_level_events(d)
                if self.world.mob_griefing {
                    self.levels[d].graze(g)
                    self.send_level_events(d)
                }
            },
            Shown.Lit((x, y, z)) => {
                self.send_level_events(d)
                self.levels[d].light_ore(x, y, z)
                self.send_level_events(d)
            },
            Shown.Pressed((x, y, z)) => {
                self.send_level_events(d)
                self.levels[d].press_by_arrow(x, y, z)
                self.send_level_events(d)
            },
            Shown.Walls(boxes) => {
                // An ender dragon's `checkWalls` where it would break what it flies into (D614):
                // its head's, neck's and body's boxes in turn, each checked as the level has it
                // then; where one broke a block, a place in its box drawn from the dragon's random,
                // and level event 2008 there, its explosion's sound and smoke; whether any was a
                // wall, `inWall`, kept for its next flight.
                self.send_level_events(d)
                let lf = self.living_facts.take() else return es
                let griefing = self.world.mob_griefing
                var hit = false
                for b in boxes {
                    let (x0, y0, z0) = (i32.saturate(b.min_x.floor()), i32.saturate(b.min_y.floor()), i32.saturate(b.min_z.floor()))
                    let (x1, y1, z1) = (i32.saturate(b.max_x.floor()), i32.saturate(b.max_y.floor()), i32.saturate(b.max_z.floor()))
                    let (wall, destroyed) = self.levels[d].dragon_wall(x0, y0, z0, x1, y1, z1, griefing, lf.dragon_transparent, lf.dragon_immune)
                    if wall {
                        hit = true
                    }
                    if destroyed {
                        if let lent = es.list.lend_mob(id) {
                            var mob = lent
                            let rx = x0 + mob.living.body.random.next_int_below(x1 - x0 + 1)
                            let ry = y0 + mob.living.body.random.next_int_below(y1 - y0 + 1)
                            let rz = z0 + mob.living.body.random.next_int_below(z1 - z0 + 1)
                            es.list.give_back_mob(mob)
                            self.levels[d].mob_level_event(2008, rx, ry, rz, 0)
                        }
                    }
                    self.send_level_events(d)
                }
                self.living_facts = some(lf)
                if let lent = es.list.lend_mob(id) {
                    var mob = lent
                    mob.set_dragon_in_wall(hit)
                    es.list.give_back_mob(mob)
                }
            },
            Shown.Took((x, y, z)) => {
                self.send_level_events(d)
                if let state = self.levels[d].take_block(x, y, z) {
                    var tag: Tag? = none
                    if let codecs = self.items {
                        tag = codecs.state_tag(state)
                    }
                    if let lent = es.list.lend_mob(id) {
                        var mob = lent
                        mob.set_carried(some(state), tag)
                        es.list.give_back_mob(mob)
                    }
                }
                self.send_level_events(d)
            },
            Shown.Door((x, y, z, open)) => {
                self.send_level_events(d)
                self.levels[d].swing_door(x, y, z, open)
                self.send_level_events(d)
            },
            Shown.Trampled((x, y, z)) => {
                self.send_level_events(d)
                if self.world.mob_griefing {
                    return self.trample(es, d, x, y, z)
                }
            },
            Shown.Harvested((x, y, z)) => {
                // A villager's harvest (CAL-160): the crop broken with its drops as its brain's
                // tick stopped for it, the items they make added then, as vanilla adds them.
                self.send_level_events(d)
                self.levels[d].harvest(x, y, z, id)
                self.send_level_events(d)
                self.put_entities(d, es)
                self.make_drops(d)
                return self.take_entities(d)
            },
            Shown.Planted((x, y, z, state)) => {
                self.send_level_events(d)
                self.levels[d].set_crop(x, y, z, state, 3)
                self.send_level_events(d)
            },
            Shown.Grew((x, y, z, state)) => {
                self.send_level_events(d)
                self.levels[d].set_crop(x, y, z, state, 2)
                self.send_level_events(d)
            },
            Shown.Repriced => {
                self.send_level_events(d)
                return self.repriced_for(es, d, id)
            },
            Shown.Offers((x, y, z, demand)) => {
                // A villager's offers asked for as it worked, where they were still to make
                // (CAL-160): made as `getOffers` makes them, from where it was then, and their
                // demand updated as it updated it then.
                self.send_level_events(d)
                var all = es
                if let lent = all.list.lend_mob(id) {
                    var mob = lent
                    let offers = self.draw_offers(d, mob, some((x, y, z)))
                    mob.set_offers(offers)
                    for _ in 0..demand {
                        mob.update_demand()
                    }
                    mob.offers_made()
                    all.list.give_back_mob(mob)
                }
                return all
            },
            Shown.Left((x, y, z)) => {
                self.send_level_events(d)
                if let lent = es.list.lend_mob(id) {
                    var mob = lent
                    if let carried = mob.carried() {
                        let unit = Aabb { min_x: f64(x), min_y: f64(y), min_z: f64(z), max_x: f64(x) + 1.0, max_y: f64(y) + 1.0, max_z: f64(z) + 1.0 }
                        let clear = es.list.find_every(unit, id).is_empty() and not self.player_meets(d, unit)
                        if self.levels[d].leave_block(carried, x, y, z, clear) {
                            mob.set_carried(none, none)
                        }
                    }
                    es.list.give_back_mob(mob)
                }
                self.send_level_events(d)
            },
            Shown.Bred(b) => {
                self.send_level_events(d)
                self.put_entities(d, es)
                if let lf = self.living_facts.take() {
                    self.bred(d, id, b, lf)
                    self.living_facts = some(lf)
                }
                return self.take_entities(d)
            },
            Shown.Split(s) => {
                self.send_level_events(d)
                self.put_entities(d, es)
                if let lf = self.living_facts.take() {
                    self.split_cubes(d, s, lf)
                    self.living_facts = some(lf)
                }
                return self.take_entities(d)
            },
            Shown.Damaged(kind) => {
                self.send_level_events(d)
                if es.trackers.contains(id) {
                    let at: Point? = none
                    self.send_to_seen(es.trackers[id].seen_by, encode_play(ClientboundDamageEvent { entity_id: id, source_type: kind, source_cause: 0, source_direct: 0, source_position: at }))
                }
            },
            Shown.Missing(m) => self.levels[d].unimplemented(m),
            Shown.Died(death) => {
                self.send_level_events(d)
                self.put_entities(d, es)
                self.died(d, id, death)
                return self.take_entities(d)
            },
            Shown.Wore((slot, amount)) => {
                self.send_level_events(d)
                let items = self.items.take() else return es
                let worn = self.wear_mob(es, d, id, slot, amount, items)
                self.items = some(items)
                return worn
            },
            Shown.StandBroken(b) => {
                self.send_level_events(d)
                let items = self.items.take() else return es
                let kept = kept_equipment(items, b.equipment)
                self.items = some(items)
                self.put_entities(d, es)
                self.stand_broken(d, b, kept)
                return self.take_entities(d)
            },
            Shown.Spilled(s) => {
                self.send_level_events(d)
                self.put_entities(d, es)
                _ = self.make_drop(d, Dropped.Item(s.x, s.y, s.z, s.stack.copy()), none)
                return self.take_entities(d)
            },
            Shown.Survived(s) => {
                // An eye of ender's stack, as it survives (D599): an item made as `new
                // ItemEntity(level, x, y, z, stack)` makes one, with no pickup delay.
                self.send_level_events(d)
                self.put_entities(d, es)
                self.entity_ids += 1
                let made = self.entity_ids
                let seed = self.entity_seed(made)
                self.add_item(d, ItemEntity.new(made, seed, s.x, s.y, s.z, s.stack.copy()), none)
                return self.take_entities(d)
            },
            Shown.Tossed(t) => {
                // What a villager threw (CAL-160): an item made as `new ItemEntity` makes one, its
                // motion then the throw's, its thrower and its default pickup delay.
                self.send_level_events(d)
                self.put_entities(d, es)
                self.entity_ids += 1
                let made = self.entity_ids
                let seed = self.entity_seed(made)
                var e = ItemEntity.new(made, seed, t.x, t.y, t.z, t.stack.copy())
                e.body.vx = t.vx
                e.body.vy = t.vy
                e.body.vz = t.vz
                e.thrower = some(t.thrower)
                e.pickup_delay = 10
                self.add_item(d, e, none)
                return self.take_entities(d)
            },
            Shown.Bed((x, y, z, occupied)) => {
                self.send_level_events(d)
                self.levels[d].set_bed(x, y, z, occupied)
                self.send_level_events(d)
            },
            Shown.Composted((x, y, z, state, ticked)) => {
                self.send_level_events(d)
                self.levels[d].compost(x, y, z, state, ticked)
                self.send_level_events(d)
            },
            Shown.Picked((item, count)) => {
                self.send_level_events(d)
                if es.trackers.contains(item) {
                    self.send_to_seen(es.trackers[item].seen_by, encode_play(ClientboundTakeItemEntity { item_id: item, collector_id: id, amount: count }))
                }
            },
            Shown.Laid(laid) => {
                self.send_level_events(d)
                self.made_sequence(d, laid.table.copy())
                var stack = JavaHashMap<String, Tag>()
                stack.insert(String("id"), Tag.Str(laid.item.copy()))
                stack.insert(String("count"), Tag.Int(1))
                self.put_entities(d, es)
                _ = self.make_drop(d, Dropped.Item(laid.x, laid.y, laid.z, Tag.Compound(stack)), none)
                return self.take_entities(d)
            },
            Shown.Travel(way) => {
                self.send_level_events(d)
                self.put_entities(d, es)
                self.entity_travel(d, id, way)
                return self.take_entities(d)
            },
            // An end gateway it went into, whose cooldown begins (D594).
            Shown.Gateway(g) => {
                let (at, cursor) = g
                self.gateway_cooled(d, at, cursor)
            },
            // Its way through one within its level, `teleportSameDimension` (D594): those that see
            // it told at once where they're told, where it is, how it's moving and turned, nothing
            // relative, `ClientboundTeleportEntityPacket`, then a portal ticket put 3 about its
            // chunk, `PLACE_PORTAL_TICKET`.
            Shown.Moved(m) => {
                if m.told and es.trackers.contains(m.id) {
                    self.send_to_seen(es.trackers[m.id].seen_by, encode_play(ClientboundTeleportEntity { entity_id: m.id, x: m.x, y: m.y, z: m.z, delta_x: m.vx, delta_y: m.vy, delta_z: m.vz, y_rot: m.y_rot, x_rot: m.x_rot, relatives: 0, on_ground: m.on_ground }))
                }
                self.levels[d].load_portal(ChunkPos { x: i32.saturate(m.x.floor()) >> 4, z: i32.saturate(m.z.floor()) >> 4 })
            },
        }
        return es
    }

    // `Mob.doHurtTarget` of the player `target` by the mob `id` of the level `d` (CAL-159): its
    // attack damage, a float, which scales with the difficulty, as its weapon's enchantments change
    // it against them, `mob_enchanted`, of its weapon's own damage type, a spear's, else
    // `mob_attack`, `getDamageSource`, caused and dealt by it from where it was as it attacked, at
    // `ax`, `ay`, `az`, in its goal's tick before it moved, `serverAiStep`; the player hurt by it,
    // named in their combat as it's shown, `hurt_player_by`, while it's lent out of its entities,
    // so what their death drops goes among them. Where it hurt them, its knockback along its
    // facing, `causeExtraKnockback`, what they wear does to it, `victim_post_attack`, and what its
    // weapon's enchantments do to them, `weapon_post_attack`; it's hurt them last,
    // `setLastHurtMob`; and a zombie with nothing in its main hand, on fire, sets them on fire by
    // a draw under 0.3 of its local difficulty, `getCurrentDifficultyAt`, for twice the
    // difficulty's whole part in seconds, `Zombie.doHurtTarget`. A mace's smash, where it can
    // smash, falling more than 1.5 blocks, `canSmashAttack`, is a `mace_smash` damage where its
    // weapon has no damage type of its own, `getItemDamageSource`, its bonus added after its
    // enchantments' damage, `mob_smash_bonus`, and what it does after its knockback,
    // `mob_hurt_enemy` (CAL-159); its fall isn't forgotten and its weapon isn't worn, as only a
    // player's attack calls `postHurtEnemy`.
    fn mob_attack(mut self, es: own LevelEntities, d: usize, id: i32, target: i32, ax: f64, ay: f64, az: f64) -> LevelEntities {
        var all = es
        let slot = self.slot_of_entity(target) else return all
        if self.connections[slot] == none {
            return all
        }
        var mob = all.list.lend_mob(id) else return all
        self.put_entities(d, all)
        var con = self.connections[slot].take() else return self.mob_back(d, mob)
        let lf = self.living_facts.take() else {
            self.connections[slot] = some(con)
            return self.mob_back(d, mob)
        }
        let held = mob.living.equipment[0].copy()
        var weapon: Component? = none
        let smash = stack_item(held.copy()) == "minecraft:mace" and mob.living.body.fall > 1.5
        var kind = if smash { lf.damage.id("mace_smash") } else { lf.damage.id("mob_attack") }
        var enchanted = false
        if let items = self.items {
            if let stack = held.copy() {
                // `getDamageSource`: its weapon's own damage type, a spear's, caused and dealt by
                // it.
                if let Tag.Str(typed) = items.component(stack.copy(), String("minecraft:damage_type")) ?? Tag.End {
                    let named = lf.damage.id_named(typed.copy())
                    if named >= 0 {
                        kind = named
                    }
                }
                enchanted = not items.enchantments(stack.copy()).is_empty()
            }
            weapon = named_weapon(held.copy(), items)
        }
        var damage = f32.nearest(mob.living.attributes.value(attribute_id(String("attack_damage")) ?? 0))
        if enchanted {
            // `EnchantmentHelper.modifyDamage`: its weapon's enchantments' damage against them.
            if let stack = held.copy() {
                damage = self.mob_enchanted(d, mut con, mob, stack, "minecraft:damage", damage)
            }
        }
        if smash {
            damage = damage + self.mob_smash_bonus(d, mut con, mob, held.copy(), enchanted)
        }
        let source = Damage { kind: kind, cause: id, direct: id, at: some((ax, ay, az)), living_cause: true }
        let this = mob.loot_entity()
        let shown = living_display_name(mob.living, this.kind.copy())
        let blame = Blame { cause: some(shown.copy()), direct: some(shown), weapon: weapon }
        let waiting = con.player.waiting_for_respawn
        self.lent_mob = some((id, this.copy()))
        let hurt = self.hurt_player_by(mut con, lf, source, damage, blame)
        self.lent_mob = none
        if self.world.forgive_dead_players and con.player.waiting_for_respawn and not waiting {
            // Their death's told the mob that killed them too, lent out as it is, within reach,
            // so well within the box `tellNeutralMobsThatIDied` looks in.
            if let p = con.profile {
                mob.player_died((p.id.most, p.id.least))
            }
        }
        self.living_facts = some(lf)
        self.connections[slot] = some(con)
        if hurt {
            if let back = self.connections[slot].take() {
                var c = back
                // `causeExtraKnockback`: half its attack knockback, as its weapon's enchantments
                // change it against them, `getKnockback`, along its facing, which slows its own
                // motion across to 0.6.
                var knock = f32.nearest(mob.living.attributes.value(attribute_id(String("attack_knockback")) ?? 0))
                if enchanted {
                    if let stack = held.copy() {
                        knock = self.mob_enchanted(d, mut c, mob, stack, "minecraft:knockback", knock)
                    }
                }
                knock = knock / 2.0f32
                if knock > 0.0f32 {
                    let turn = mob.living.body.y_rot * 0.017453292f32
                    self.push_player(mut c, f64(knock), f64(table_sin(f64(turn))), f64(-table_cos(f64(turn))))
                    mob.living.body.vx = mob.living.body.vx * 0.6
                    mob.living.body.vz = mob.living.body.vz * 0.6
                }
                if smash {
                    self.mob_hurt_enemy(mut c, d, mut mob)
                }
                // What they wear does to it, then what its weapon's enchantments do to them,
                // `doPostAttackEffects`, before it's hurt them last.
                let context = mob_damage_context(c, mob)
                mob = self.victim_post_attack(mut c, d, mob, context)
                if enchanted {
                    if let stack = held.copy() {
                        self.weapon_post_attack(mut c, d, mob, stack)
                    }
                }
                self.connections[slot] = some(c)
            }
            mob.hurt_mob(target)
            if mob.zombie_class() and held == none and mob.living.on_fire() {
                // `Zombie.doHurtTarget`: by a draw under 0.3 of the local difficulty, the player
                // set on fire for twice its whole part in seconds, `igniteForSeconds`, their
                // freezing gone.
                let (bx, bz) = (i32.saturate(mob.living.body.x.floor()), i32.saturate(mob.living.body.z.floor()))
                let difficulty = self.difficulty_at(d, bx, bz).effective
                if mob.living.body.random.next_float() < difficulty * 0.3f32 {
                    let ticks = 2 * i32.saturate(f64(difficulty).floor()) * 20
                    if let lit = self.connections[slot].take() {
                        var c = lit
                        if c.player.fire < ticks {
                            c.player.fire = ticks
                        }
                        c.player.entity_data.set(TICKS_FROZEN, Value.Number(0))
                        self.connections[slot] = some(c)
                    }
                }
            }
        }
        return self.mob_back(d, mob)
    }

    // `damageEntities`' hits of the mob `id`'s spear in the level `d`, `stabs`, in the order its
    // use met them (CAL-159): each on a player, `mob_stab`; on a mob or an armor stand, said to
    // be missing. Where any did something, entity event 2 of the mob's is sent those who see it,
    // `broadcastEntityEvent`.
    fn mob_stabs(mut self, es: own LevelEntities, d: usize, id: i32, stabs: List<Stab>) -> LevelEntities {
        var all = es
        var affected = false
        for s in stabs {
            if s.player {
                let (back, did) = self.mob_stab(all, d, id, s)
                all = back
                affected = affected or did
            } else {
                self.levels[d].unimplemented(String("A mob's spear's hits on mobs and armor stands"))
            }
        }
        if affected and all.trackers.contains(id) {
            self.send_to_seen(all.trackers[id].seen_by, encode_play(ClientboundEntityEvent { entity_id: id, event: 2i8 }))
        }
        return all
    }

    // `stabAttack` of the mob `id`'s spear on the player `s` names, as `damageEntities` has it
    // (CAL-159): its damage source the spear's own type, `getDamageSource`, caused and dealt by
    // the mob where it is; `s`'s damage as the spear's enchantments change it against them,
    // `modifyDamage`. Where it hurts, the player's hurt by it, named in their combat as it's
    // shown, `hurt_player_by`, while it's lent out of its entities. Where it knocks back, 0.4
    // along the mob's facing, then its attack knockback, as the spear's enchantments change it,
    // halved, `getKnockback`, each slowing its motion across to 0.6, `causeExtraKnockback`;
    // dismounting comes with riding. Where it hurt them, what they wear does to the mob, then what
    // the spear's enchantments do to them, `doPostAttackEffects`; where it did anything, it's hurt
    // them last, `setLastHurtMob`. Whether it did anything.
    fn mob_stab(mut self, es: own LevelEntities, d: usize, id: i32, s: Stab) -> (LevelEntities, bool) {
        var all = es
        let slot = self.slot_of_entity(s.target) else return (all, false)
        if self.connections[slot] == none {
            return (all, false)
        }
        var mob = all.list.lend_mob(id) else return (all, false)
        self.put_entities(d, all)
        var con = self.connections[slot].take() else return (self.mob_back(d, mob), false)
        let lf = self.living_facts.take() else {
            self.connections[slot] = some(con)
            return (self.mob_back(d, mob), false)
        }
        let held = mob.living.equipment[0].copy()
        var weapon: Component? = none
        var kind = lf.damage.id("mob_attack")
        var enchanted = false
        if let items = self.items {
            if let stack = held.copy() {
                if let Tag.Str(typed) = items.component(stack.copy(), String("minecraft:damage_type")) ?? Tag.End {
                    let named = lf.damage.id_named(typed.copy())
                    if named >= 0 {
                        kind = named
                    }
                }
                enchanted = not items.enchantments(stack.copy()).is_empty()
            }
            weapon = named_weapon(held.copy(), items)
        }
        var damage = s.damage
        if enchanted {
            if let stack = held.copy() {
                damage = self.mob_enchanted(d, mut con, mob, stack, "minecraft:damage", damage)
            }
        }
        let source = Damage { kind: kind, cause: id, direct: id, at: some((mob.living.body.x, mob.living.body.y, mob.living.body.z)), living_cause: true }
        let this = mob.loot_entity()
        let shown = living_display_name(mob.living, this.kind.copy())
        let blame = Blame { cause: some(shown.copy()), direct: some(shown), weapon: weapon }
        var hurt = false
        if s.hurts {
            let waiting = con.player.waiting_for_respawn
            self.lent_mob = some((id, this.copy()))
            hurt = self.hurt_player_by(mut con, lf, source, damage, blame)
            self.lent_mob = none
            if self.world.forgive_dead_players and con.player.waiting_for_respawn and not waiting {
                // Their death's told the mob that killed them too, as `mob_attack` tells it.
                if let p = con.profile {
                    mob.player_died((p.id.most, p.id.least))
                }
            }
        }
        self.living_facts = some(lf)
        if s.knocks {
            let turn = mob.living.body.y_rot * 0.017453292f32
            let (along_x, along_z) = (f64(table_sin(f64(turn))), f64(-table_cos(f64(turn))))
            self.push_player(mut con, f64(0.4f32), along_x, along_z)
            mob.living.body.vx = mob.living.body.vx * 0.6
            mob.living.body.vz = mob.living.body.vz * 0.6
            var knock = f32.nearest(mob.living.attributes.value(attribute_id(String("attack_knockback")) ?? 0))
            if enchanted {
                if let stack = held.copy() {
                    knock = self.mob_enchanted(d, mut con, mob, stack, "minecraft:knockback", knock)
                }
            }
            knock = knock / 2.0f32
            if knock > 0.0f32 {
                self.push_player(mut con, f64(knock), along_x, along_z)
                mob.living.body.vx = mob.living.body.vx * 0.6
                mob.living.body.vz = mob.living.body.vz * 0.6
            }
        }
        if hurt {
            let context = mob_damage_context(con, mob)
            mob = self.victim_post_attack(mut con, d, mob, context)
            if enchanted {
                if let stack = held.copy() {
                    self.weapon_post_attack(mut con, d, mob, stack)
                }
            }
        }
        self.connections[slot] = some(con)
        let affected = s.knocks or hurt
        if affected {
            mob.hurt_mob(s.target)
        }
        return (self.mob_back(d, mob), affected)
    }

    // An ender dragon's strike on a player, `b`, the dragon `id` lent out of the level `d`'s
    // entities (D615). A wing's, `knockBack`, pushes them away from the middle of its body across
    // by 4 over their squared distance from it there, 0.1 at least, and up 0.2, where that's
    // finite, `push`, and hurts them by 5 where it doesn't sit and no mob hurt them in their last
    // 2 ticks, `getLastHurtByMobTimestamp`; its head's or neck's, `hurt`, by 10. A hurt is a
    // `mob_attack` caused and dealt by it where it is, named in their combat as it's shown,
    // `hurt_player_by`, while it's lent out; then what they wear does to it, `doPostAttackEffects`,
    // whether it hurt them or not. It holds no weapon and has no team, so its team allows it,
    // `doTeamsAllowDamage`, and it doesn't hurt them last, as it never attacks as a mob does.
    fn dragon_beat(mut self, es: own LevelEntities, d: usize, id: i32, b: Beat) -> LevelEntities {
        var all = es
        let slot = self.slot_of_entity(b.player) else return all
        if self.connections[slot] == none {
            return all
        }
        var mob = all.list.lend_mob(id) else return all
        self.put_entities(d, all)
        var con = self.connections[slot].take() else return self.mob_back(d, mob)
        var damage = 10.0f32
        var hurts = true
        if let (xm, zm) = b.from {
            let xd = con.player.x - xm
            let zd = con.player.z - zm
            let dd = (xd * xd + zd * zd).max(0.1)
            let (px, pz) = (xd / dd * 4.0, zd / dd * 4.0)
            if px - px == 0.0 and pz - pz == 0.0 {
                con.player.vx = con.player.vx + px
                con.player.vy = con.player.vy + f64(0.2f32)
                con.player.vz = con.player.vz + pz
                con.player.needs_sync = true
            }
            hurts = not b.sitting and con.player.hurt_by_mob_stamp < con.player.own_ticks - 2
            damage = 5.0f32
        }
        if not hurts {
            self.connections[slot] = some(con)
            return self.mob_back(d, mob)
        }
        let lf = self.living_facts.take() else {
            self.connections[slot] = some(con)
            return self.mob_back(d, mob)
        }
        let source = Damage { kind: lf.damage.id("mob_attack"), cause: id, direct: id, at: some((mob.living.body.x, mob.living.body.y, mob.living.body.z)), living_cause: true }
        let this = mob.loot_entity()
        let shown = living_display_name(mob.living, this.kind.copy())
        let blame = Blame { cause: some(shown.copy()), direct: some(shown) }
        let waiting = con.player.waiting_for_respawn
        self.lent_mob = some((id, this.copy()))
        _ = self.hurt_player_by(mut con, lf, source, damage, blame)
        self.lent_mob = none
        if self.world.forgive_dead_players and con.player.waiting_for_respawn and not waiting {
            // Their death's told the dragon that killed them too, as `mob_stab` tells its mob.
            if let p = con.profile {
                mob.player_died((p.id.most, p.id.least))
            }
        }
        self.living_facts = some(lf)
        let context = mob_damage_context(con, mob)
        mob = self.victim_post_attack(mut con, d, mob, context)
        self.connections[slot] = some(con)
        return self.mob_back(d, mob)
    }

    // `MaceItem.getAttackDamageBonus` of the mob `mob`'s smash on the player `con` in the level
    // `d`, `held` its mace, `enchanted` or not (CAL-159), as `smash_bonus` has a player's: 4 for
    // each block of its fall to 3, 2 for each to 8, then 1, and what its enchantments make of
    // nothing for each block fallen, density's, times its fall, in doubles, then a float.
    fn mob_smash_bonus(mut self, d: usize, con: mut Connection, mob: Mob, held: Tag?, enchanted: bool) -> f32 {
        let fall = mob.living.body.fall
        let damage = if fall <= 3.0 { 4.0 * fall } else if fall <= 8.0 { 12.0 + 2.0 * (fall - 3.0) } else { 22.0 + fall - 8.0 }
        var per = 0.0f32
        if enchanted {
            if let s = held {
                per = self.mob_enchanted(d, mut con, mob, s, "minecraft:smash_damage_per_fallen_block", 0.0f32)
            }
        }
        return f32.nearest(damage + f64(per) * fall)
    }

    // `MaceItem.hurtEnemy` of the mob `mob`'s smash on the player `con` in the level `d` (CAL-159),
    // as `hurt_enemy` has a player's: its motion up 0.01, and an impulse given it where it is, or
    // where the last was given where that's no higher, its grace 40 ticks at least,
    // `setIgnoreFallDamageFromCurrentImpulse`; where the player's on the ground the smash's sound
    // on the ground, heavy past 5 blocks fallen, else in the air's, where the mob is among its own
    // sounds; then `knockback`: level event 2013 of 750 at the block the player's on, `getOnPos`,
    // and each living entity whose box meets theirs 3.5 larger each way, but the mob, them and a
    // marker armor stand, pushed away from them, `smash_push`. Another player within reach of them
    // is said to be missing, as for a player's smash.
    fn mob_hurt_enemy(mut self, con: mut Connection, d: usize, mob: mut Mob) {
        let (x, y, z) = (mob.living.body.x, mob.living.body.y, mob.living.body.z)
        mob.living.body.vy = f64(0.01f32)
        var impact = (x, y, z)
        if let at = mob.living.impulse_at {
            let (_, iy, _) = at
            if iy <= y {
                impact = at
            }
        }
        mob.living.impulse_grace = mob.living.impulse_grace.max(40)
        mob.living.impulse_at = some(impact)
        let fell = mob.living.body.fall
        var sound = "item.mace.smash_air"
        if con.player.on_ground {
            sound = if fell > 5.0 { "item.mace.smash_ground_heavy" } else { "item.mace.smash_ground" }
        }
        self.levels[d].play_sound_from_source(String(sound), x, y, z, mob.living.body.sound_source, 1.0f32, 1.0f32)
        let shared = self.levels[d].shared_env() else return
        let Env { facts: f, .. } = shared.value
        let t = self.item_facts.take() else return
        let (tx, ty, tz) = (con.player.x, con.player.y, con.player.z)
        let (ox, oy, oz) = on_pos_of(f, t, self.levels[d], con.player.support, tx, ty, tz, 1.0e-5f32)
        self.item_facts = some(t)
        self.levels[d].level_event(2013, ox, oy, oz, 750)
        self.send_level_events_with(d, mut con)
        let around = pose_box(con.player.entity_data.number(POSE_ID), tx, ty, tz).inflate(3.5, 3.5, 3.5)
        let them = con.player.entity_id
        var players = false
        for slot in 0..self.connections.len() {
            if let c = self.connections[slot] {
                let (px, py, pz) = (c.player.x - tx, c.player.y - ty, c.player.z - tz)
                if c.player.entity_id != them and c.player.dim == d and c.player.mode != GameType.Spectator and px * px + py * py + pz * pz <= 12.25 {
                    players = true
                }
            }
        }
        if players {
            self.levels[d].unimplemented(String("Players pushed by a mace's smash"))
        }
        let lf = self.living_facts.take() else return
        var es = self.take_entities(d)
        let ids = es.list.find_living(around, them)
        for id in ids {
            if es.list.is_stand(id) {
                var a = es.list.lend_stand(id) ?? panic("an armor stand a smash pushed went missing")
                if not a.marker() {
                    smash_push(mut a.living, lf, tx, ty, tz, fell)
                }
                es.list.give_back_stand(a)
            } else if es.list.is_mob(id) {
                var m = es.list.lend_mob(id) ?? panic("a mob a smash pushed went missing")
                smash_push(mut m.living, lf, tx, ty, tz, fell)
                es.list.give_back_mob(m)
            }
        }
        self.put_entities(d, es)
        self.living_facts = some(lf)
    }

    // An arrow's hits on what its way met this step, nearest first, `hitTargetsOrDeflectSelf`
    // (CAL-159): each dealt in turn, `arrow_hit`, while the arrow `id` is still here.
    fn arrow_hits(mut self, es: own LevelEntities, d: usize, id: i32, hits: List<ArrowHit>) -> LevelEntities {
        var all = es
        for h in hits {
            let a = all.list.lend_arrow(id) else return all
            if a.body.removed {
                all.list.give_back_arrow(a)
                return all
            }
            all = self.arrow_hit(all, d, a, h)
        }
        return all
    }

    // `onHitEntity` of the arrow `arrow`, lent out of the level `d`'s entities, on what `h` hit
    // (CAL-159): its damage source, `arrow`, dealt by it from where it is and caused by its owner,
    // `shooter_of`, or by itself where it has none, its knockback along its motion; its damage,
    // `strike`, none where it's pierced all it may; a mob that owns it having hurt what it hit
    // last, `setLastHurtMob`, none where that isn't living (D591); where it's on fire, what it hit
    // set on fire for 5 seconds; the hurt, of a mob, `shoot_mob`, an armor stand, `shoot_stand`,
    // an end crystal, `shoot_crystal` (D591), or a player, `hurt_player_by`, their
    // fire as it was where it didn't hurt them; hurt, an arrow more in a living thing where it
    // doesn't pierce, and a player that owns it told of its hit on another player,
    // `ARROW_HIT_SOUND`, unless it's silent; then what follows of the arrow, `struck`, its sounds
    // played, and, where it drops itself, it dropped 0.1 up, `spawnAtLocation`. Shot from a
    // weapon, its damage is what the weapon's enchantments make of it, `modifyDamage`, as a float,
    // `arrow_enchanted`, before its speed's taken; and hurting a living thing, it's knocked back
    // by their knockback, `doKnockback`, `arrow_knockback`, then the hit's post-attack effects
    // are done, `arrow_post_attack` (CAL-159), and a tipped arrow's effects given them,
    // `arrow_effects` (D513); then what it killed kept and its owner's `KILLED_BY_ARROW`,
    // `arrow_killed` (CAL-164).
    fn arrow_hit(mut self, es: own LevelEntities, d: usize, arrow: own Arrow, h: ArrowHit) -> LevelEntities {
        var all = es
        var a = arrow
        let id = a.body.id
        var kind = -1
        var tags: u32? = none
        if let lf = self.living_facts {
            kind = lf.damage.id("arrow")
            if kind >= 0 {
                tags = some(lf.damage.tags_of(kind))
            }
        }
        if kind < 0 {
            all.list.give_back_arrow(a)
            return all
        }
        let by = self.shooter_of(d, all.list, a.owner)
        // The hit's damage's context, `damageContext`, but for what it hit, which
        // `arrow_enchanted` sets: dealt by the arrow, caused by what owns it, or by the arrow
        // itself where nothing does, direct then (CAL-159).
        let me = LootEntity { kind: String("minecraft:arrow"), on_fire: a.body.fire > 0 }
        let (cause, direct) = match by {
            some(o) => (o.loot.copy() ?? me.copy(), false),
            none => (me.copy(), true),
        }
        let context = LootParams { damage_source: true, attacker: some(cause), direct_attacker: some(me), direct: direct, damage_tags: tags }
        let weapon = a.weapon.copy()
        let (avx, avz) = (a.body.vx, a.body.vz)
        var source = Damage { kind: kind, cause: id, direct: id, at: some((a.body.x, a.body.y, a.body.z)), knock: some((a.body.vx, a.body.vz)) }
        var custom: Component? = none
        if a.body.extras.contains("CustomName") {
            match Component.from_nbt(a.body.extras["CustomName"].copy()) {
                ok(c) => custom = some(c),
                err(_) => {},
            }
        }
        let arrow_name = entity_display_name(String("minecraft:arrow"), Uuid.new(a.body.uuid.0, a.body.uuid.1), custom)
        var blame = Blame { cause: some(arrow_name.copy()), direct: some(arrow_name) }
        var attacker: LootEntity? = none
        if let o = by {
            source.cause = o.id
            source.player = o.player
            source.creative = o.creative
            source.living_cause = o.mob
            blame.cause = o.name.copy()
            blame.weapon = o.weapon.copy()
            attacker = o.loot.copy()
        }
        var base = a.base_damage
        if let w = weapon {
            base = f64(self.arrow_enchanted(d, mut all, h, w.copy(), "minecraft:damage", context, f32.nearest(base)))
        }
        let dealt = a.strike(h.target, base) else {
            all.list.give_back_arrow(a)
            return all
        }
        let at_crystal = all.list.is_crystal(h.target)
        if let o = by {
            if o.mob {
                if let lent = all.list.lend_mob(o.id) {
                    var owner_mob = lent
                    if at_crystal {
                        owner_mob.hurt_unliving()
                    } else {
                        owner_mob.hurt_mob(h.target)
                    }
                    all.list.give_back_mob(owner_mob)
                }
            }
        }
        let burns = a.body.fire > 0
        let stuck = a.pierce() <= 0i8
        let effects = self.arrow_potion(a.item)
        let silent = a.silent()
        all.list.give_back_arrow(a)
        let amount = f32.nearest(dealt)
        var hurt = false
        var living = false
        // Whether what it hit dodged it, so it flies on, neither turned back nor gone (CAL-159).
        var flies_on = false
        // Whether it hit a mob, and what an armor stand it hit was before it, for what it kills.
        var hit_mob = false
        var stand_seen: LootEntity? = none
        if h.player {
            living = true
            self.put_entities(d, all)
            if let slot = self.slot_of_entity(h.target) {
                if let held = self.connections[slot].take() {
                    var con = held
                    if let lf = self.living_facts.take() {
                        let fire = con.player.fire
                        if burns {
                            // `igniteForTicks`: the fire up to 5 seconds, and the freezing gone.
                            if con.player.fire < 100 {
                                con.player.fire = 100
                            }
                            con.player.entity_data.set(TICKS_FROZEN, Value.Number(0))
                        }
                        hurt = self.hurt_player_by(mut con, lf, source, amount, blame)
                        if hurt and stuck {
                            let count = con.player.entity_data.number(ARROW_COUNT)
                            con.player.entity_data.set(ARROW_COUNT, Value.Number(count + 1))
                        }
                        if not hurt {
                            con.player.fire = fire
                        }
                        self.living_facts = some(lf)
                    }
                    self.connections[slot] = some(con)
                }
            }
            all = self.take_entities(d)
        } else if all.list.is_mob(h.target) {
            living = true
            hit_mob = true
            let (back, was, dodged) = self.shoot_mob(all, d, h.target, source, amount, attacker, context.direct_attacker.copy(), burns, stuck)
            all = back
            hurt = was
            flies_on = dodged
        } else if all.list.is_stand(h.target) {
            living = true
            stand_seen = some(all.list.stand(h.target).loot_entity())
            let mob_owner = match by {
                some(o) => o.mob,
                none => false,
            }
            let unbuilding = match by {
                some(o) => o.player != none and not o.may_build,
                none => false,
            }
            let stander = StandHurter { mob_without_griefing: mob_owner and not self.world.mob_griefing, player_without_building: unbuilding }
            let (back, was) = self.shoot_stand(all, d, h.target, source, stander, burns, stuck)
            all = back
            hurt = was
        } else if at_crystal {
            // An end crystal, which isn't living, so it takes no knockback, effects or arrow, and
            // the fire the arrow sets it, which it's immune to, it puts out at once, or goes
            // (D591).
            let (back, was) = self.shoot_crystal(all, d, h.target, source)
            all = back
            hurt = was
        }
        if hurt and living {
            if let w = weapon {
                let knock = self.arrow_enchanted(d, mut all, h, w.copy(), "minecraft:knockback", context, 0.0f32)
                if f64(knock) > 0.0 {
                    all = self.arrow_knockback(all, h, f64(knock), avx, avz)
                }
            }
            all = self.arrow_post_attack(all, d, h, by, weapon, context)
            if not effects.is_empty() {
                all = self.arrow_effects(all, d, h, effects)
            }
            if h.player and not silent {
                if let o = by {
                    if let slot = o.slot {
                        if o.id != h.target {
                            if let held = self.connections[slot].take() {
                                var owner_con = held
                                self.send(mut owner_con, ClientboundGameEvent { event: 6u8, param: 0.0f32 }, State.Play)
                                self.connections[slot] = some(owner_con)
                            }
                        }
                    }
                }
            }
            all = self.arrow_killed(all, d, id, h, by, weapon, hit_mob, stand_seen)
        }
        if flies_on {
            return all
        }
        var b = all.list.lend_arrow(id) else return all
        var sounds = List<EntitySound>()
        let drops = b.struck(hurt, mut sounds)
        let (x, y, z) = (b.body.x, b.body.y, b.body.z)
        let item = b.item.copy()
        all.list.give_back_arrow(b)
        for s in sounds {
            self.play_item_sound(d, s)
        }
        self.send_level_events(d)
        if drops {
            self.put_entities(d, all)
            _ = self.make_drop(d, Dropped.Item(x, y + f64(0.1f32), z, item), none)
            all = self.take_entities(d)
        }
        return all
    }

    // `onHitEntity`'s end for the arrow `id`, whose hit `h` hurt a living thing (CAL-164): what it
    // hit, where it's no longer alive, `isAlive`, kept among what it's pierced and killed,
    // `piercedAndKilledEntities`, where it pierces; then, where a player, `by`, owns it, their
    // `KILLED_BY_ARROW` of all it's pierced and killed where it pierces, else of what it hit where
    // that died, and of `weapon`, what it was shot from. `mob` is whether it hit a mob, and
    // `stand` what an armor stand it hit was before it; one it broke wears nothing,
    // `brokenByAnything`.
    fn arrow_killed(mut self, es: own LevelEntities, d: usize, id: i32, h: ArrowHit, by: Shooter?, weapon: Tag?, mob: bool, stand: LootEntity?) -> LevelEntities {
        var all = es
        var alive = true
        var seen: LootEntity? = none
        if h.player {
            if let slot = self.slot_of_entity(h.target) {
                alive = self.player_health(slot) > 0.0f32
                if not alive {
                    if let held = self.connections[slot].take() {
                        seen = self.looted(held)
                        self.connections[slot] = some(held)
                    }
                }
            }
        } else if mob {
            if all.list.is_mob(h.target) {
                let m = all.list.mob(h.target)
                alive = m.living.alive()
                if not alive {
                    seen = some(m.loot_entity())
                }
            } else {
                alive = false
            }
        } else {
            if let s = stand {
                alive = all.list.is_stand(h.target)
                if not alive {
                    var bare = s.copy()
                    bare.hand = none
                    seen = some(bare)
                }
            }
        }
        var pierces = false
        if all.list.is_arrow(id) {
            pierces = match all.list.arrow(id).pierced_killed {
                some(_) => true,
                none => false,
            }
        }
        if pierces and not alive {
            if let victim = seen {
                if let lent = all.list.lend_arrow(id) {
                    var a = lent
                    var killed = a.pierced_killed.take() ?? List<LootEntity>()
                    killed.push(victim.copy())
                    a.pierced_killed = some(killed)
                    all.list.give_back_arrow(a)
                }
            }
        }
        let o = by else return all
        let slot = o.slot else return all
        var victims = List<LootEntity>()
        if pierces {
            match all.list.arrow(id).pierced_killed {
                some(killed) => {
                    for v in killed {
                        victims.push(v.copy())
                    }
                },
                none => {},
            }
        } else if not alive {
            let victim = seen else return all
            victims.push(victim.copy())
        } else {
            return all
        }
        let held = self.connections[slot].take() else return all
        var con = held
        self.put_entities(d, all)
        self.killed_by_arrow(mut con, victims, weapon)
        self.connections[slot] = some(con)
        return self.take_entities(d)
    }

    // `addEffect` of `e` to the player (D514), `PlayerEffects.add`, what it did told them at once,
    // `tell_effects`. Whether it changed their effects.
    fn effect_player(mut self, con: mut Connection, e: ActiveEffect) -> bool {
        let lf = self.living_facts.take() else return false
        let changed = con.player.effects.add(lf, e, mut con.player.attributes, mut con.player.entity_data)
        self.living_facts = some(lf)
        self.tell_effects(mut con)
        return changed
    }

    // What the player's effects did that their connection's to be told (D514), in its order: an
    // effect added or changed, `ClientboundUpdateMobEffectPacket`, blended in where it was added;
    // one taken off, `ClientboundRemoveMobEffectPacket`; each then `EFFECTS_CHANGED`, levitation's
    // start kept as it's added and forgotten as it's taken off (CAL-164); an added effect's sound,
    // heard by all near, as `MobEffect.onEffectAdded` plays it from them, of the players' source,
    // sent at once; and what's missing, said.
    fn tell_effects(mut self, con: mut Connection) {
        if con.player.effects.told.is_empty() {
            return
        }
        let told = con.player.effects.told.copy()
        con.player.effects.told.clear()
        let id = con.player.entity_id
        let d = con.player.dim
        for t in told {
            match t {
                EffectEvent.Added(e) => {
                    self.send(mut con, effect_packet(id, e, true), State.Play)
                    // `ServerPlayer.onEffectAdded`: levitation's start kept, then
                    // `EFFECTS_CHANGED` (CAL-164).
                    if e.id == LEVITATION {
                        con.player.levitation_start = some((con.player.x, con.player.y, con.player.z))
                        con.player.levitation_time = con.player.own_ticks
                    }
                    self.effects_changed(mut con)
                },
                EffectEvent.Updated(e) => {
                    self.send(mut con, effect_packet(id, e, false), State.Play)
                    self.effects_changed(mut con)
                },
                EffectEvent.Removed(k) => {
                    self.send(mut con, ClientboundRemoveMobEffect { entity_id: id, effect: k }, State.Play)
                    if k == LEVITATION {
                        con.player.levitation_start = none
                    }
                    self.effects_changed(mut con)
                },
                EffectEvent.Sound(s) => {
                    self.levels[d].play_sound_from_source(s.copy(), con.player.x, con.player.y, con.player.z, 7, 1.0f32, 1.0f32)
                    self.send_level_events_with(d, mut con)
                },
                EffectEvent.Missing(what) => self.levels[d].unimplemented(what.copy()),
            }
        }
    }

    // `sendActivePlayerEffects` (D514): each of the player's effects, not blended in.
    fn send_active_effects(mut self, con: mut Connection) {
        let id = con.player.entity_id
        for e in con.player.effects.list.copy() {
            self.send(mut con, effect_packet(id, e, false), State.Play)
        }
    }

    // `LivingEntity.tickEffects` of the player, as `baseTick` ends (D514): each of their effects
    // in their order, its act, `PlayerEffects.act`, a hurt it gives dealt them, of `magic` or of
    // `wither`, `hurt_player`, then its count down, `PlayerEffects.end`; what each did told them
    // as it happened.
    fn player_tick_effects(mut self, con: mut Connection) {
        if con.player.effects.list.is_empty() {
            return
        }
        let lf = self.living_facts.take() else return
        let spectator = con.player.mode == GameType.Spectator
        var i: usize = 0
        while i < con.player.effects.list.len() {
            let (kept, hurt, amount) = con.player.effects.act(lf, i, con.player.attributes, mut con.player.entity_data, mut con.player.status, con.player.own_ticks, con.player.abilities.invulnerable, spectator)
            self.tell_effects(mut con)
            if hurt != NO_HURT {
                let name = if hurt == WITHER_HURT { "wither" } else { "magic" }
                _ = self.hurt_player(mut con, lf, Damage.of(lf.damage, name), amount)
            }
            if i >= con.player.effects.list.len() {
                break
            }
            let on = con.player.effects.end(lf, i, kept, mut con.player.attributes, mut con.player.entity_data)
            self.tell_effects(mut con)
            if on {
                i += 1
            }
        }
        self.living_facts = some(lf)
    }

    // `updateDataBeforeSync`'s `updateDirtyEffects` of the player (D514), as their tracker runs:
    // their effects shown in their values where they changed, `PlayerEffects.update_dirty`, a
    // spectator invisible, glowing where they were saved glowing too.
    fn player_effects_shown(mut self, con: mut Connection) {
        if not con.player.effects.dirty {
            return
        }
        let lf = self.living_facts.take() else return
        var glowing = false
        if let kept = con.player.data {
            glowing = kept.contains("Glowing") and (kept["Glowing"].number_int() ?? 0) != 0
        }
        con.player.effects.update_dirty(lf, mut con.player.entity_data, con.player.mode == GameType.Spectator, glowing)
        self.living_facts = some(lf)
    }

    // The effects a tipped arrow's pickup item `item` gives what it hurts, as
    // `Arrow.getPotionContents` and `getPotionDurationScale` read them (D513): its potion
    // contents', its own or its item's, `forEachEffect`, each scaled by its duration's scale, its
    // own or its item's, a tipped arrow's an eighth, else 1.
    fn arrow_potion(self, item: Tag) -> List<ActiveEffect> {
        let items = self.items else return List<ActiveEffect>()
        let contents = items.component(item.copy(), String("minecraft:potion_contents")) else return List<ActiveEffect>()
        var scale = 1.0f32
        if let s = items.component(item.copy(), String("minecraft:potion_duration_scale")) {
            if let v = s.number_double() {
                scale = f32.nearest(v)
            }
        }
        return contents_effects(contents, scale)
    }

    // What a tipped arrow's potion does to the living thing it hurt, `h`'s target, of the level
    // `d`, `Arrow.doPostHurtEffects` (D513): each of its `effects` added, `addEffect`, as its type
    // lets it, in their order, the sounds of those that have one played; a player's given them,
    // `effect_player` (D514).
    fn arrow_effects(mut self, es: own LevelEntities, d: usize, h: ArrowHit, effects: List<ActiveEffect>) -> LevelEntities {
        var all = es
        if h.player {
            if let slot = self.slot_of_entity(h.target) {
                if let held = self.connections[slot].take() {
                    var con = held
                    for e in effects {
                        _ = self.effect_player(mut con, e)
                    }
                    self.connections[slot] = some(con)
                }
            }
            return all
        }
        let lf = self.living_facts.take() else return all
        var sounds = List<EntitySound>()
        if all.list.is_mob(h.target) {
            if let lent = all.list.lend_mob(h.target) {
                var m = lent
                for e in effects {
                    _ = m.add_effect(lf, e, mut sounds)
                }
                all.list.give_back_mob(m)
            }
        } else if all.list.is_stand(h.target) {
            if let lent = all.list.lend_stand(h.target) {
                var s = lent
                for e in effects {
                    _ = s.living.add_effect(lf, e, mut sounds)
                }
                all.list.give_back_stand(s)
            }
        }
        self.living_facts = some(lf)
        for s in sounds {
            self.play_item_sound(d, s)
        }
        return all
    }

    // `amount` as the enchantments on the weapon `weapon` an arrow was shot from change it with
    // their effects of the component `name` against what it hit, `h`, the arrow's
    // `EnchantmentHelper.modifyDamage` and `modifyKnockback` (CAL-159): `enchanted_amount` in the
    // hit's context `context` with what was hit as `this`, where it is, their requirements tested
    // with the level's random, what they process drawing from what was hit's own random; what
    // they can't do said to be missing. Against what's neither a player, a mob, an armor stand
    // nor an end crystal (D591), unchanged.
    fn arrow_enchanted(mut self, d: usize, all: mut LevelEntities, h: ArrowHit, weapon: Tag, name: str, context: LootParams, amount: f32) -> f32 {
        let shared = self.levels[d].world_loot() else return amount
        let env = self.levels[d].shared_env() else return amount
        let Env { facts: f, .. } = env.value
        var params = context.copy()
        var missing = List<String>()
        var random = self.levels[d].lend_level_random()
        var out = amount
        if h.player {
            if let slot = self.slot_of_entity(h.target) {
                if let held = self.connections[slot].take() {
                    var con = held
                    params.this_entity = true
                    params.this = some(LootEntity { kind: String("minecraft:player"), hand: held_in(con, 0) })
                    params.origin = some((con.player.x, con.player.y, con.player.z))
                    var theirs = con.player.random.take() ?? LegacyRandom.new(self.entity_seed(con.player.entity_id))
                    out = enchanted_amount(shared.value, f, self.levels[d], mut random, mut theirs, weapon, name, params, amount, mut missing)
                    con.player.random = some(theirs)
                    self.connections[slot] = some(con)
                }
            }
        } else if all.list.is_mob(h.target) {
            if let lent = all.list.lend_mob(h.target) {
                var mob = lent
                params.this_entity = true
                params.this = some(mob.loot_entity())
                params.origin = some((mob.living.body.x, mob.living.body.y, mob.living.body.z))
                out = enchanted_amount(shared.value, f, self.levels[d], mut random, mut mob.living.body.random, weapon, name, params, amount, mut missing)
                all.list.give_back_mob(mob)
            }
        } else if all.list.is_stand(h.target) {
            if let lent = all.list.lend_stand(h.target) {
                var stand = lent
                params.this_entity = true
                params.this = some(stand.loot_entity())
                params.origin = some((stand.living.body.x, stand.living.body.y, stand.living.body.z))
                out = enchanted_amount(shared.value, f, self.levels[d], mut random, mut stand.living.body.random, weapon, name, params, amount, mut missing)
                all.list.give_back_stand(stand)
            }
        } else if all.list.is_crystal(h.target) {
            if let lent = all.list.lend_crystal(h.target) {
                var crystal = lent
                params.this_entity = true
                params.this = some(crystal_loot())
                params.origin = some((crystal.body.x, crystal.body.y, crystal.body.z))
                out = enchanted_amount(shared.value, f, self.levels[d], mut random, mut crystal.body.random, weapon, name, params, amount, mut missing)
                all.list.give_back_crystal(crystal)
            }
        }
        self.levels[d].give_back_level_random(random)
        for m in missing {
            self.levels[d].unimplemented(m)
        }
        return out
    }

    // `AbstractArrow.doKnockback` of what the arrow hit, `h`, by its weapon's knockback `knock`
    // (CAL-159): along the arrow's way across, `avx`, `avz`, made a unit long, none where it's
    // shorter than `1.0E-5F`, six tenths of the knockback less what they resist of it,
    // `KNOCKBACK_RESISTANCE`, they're pushed that way and a tenth up, `push`, where it's anything.
    fn arrow_knockback(mut self, es: own LevelEntities, h: ArrowHit, knock: f64, avx: f64, avz: f64) -> LevelEntities {
        var all = es
        let lf = self.living_facts.take() else return all
        let dist = (avx * avx + avz * avz).sqrt()
        let (ux, uz) = if dist < f64(1.0e-5f32) { (0.0, 0.0) } else { (avx / dist, avz / dist) }
        if h.player {
            if let slot = self.slot_of_entity(h.target) {
                if let held = self.connections[slot].take() {
                    var con = held
                    let resisted = (1.0 - con.player.attributes.value(attribute_id(String("knockback_resistance")) ?? 0)).max(0.0)
                    let scale = knock * 0.6 * resisted
                    let (mx, mz) = (ux * scale, uz * scale)
                    if mx * mx + mz * mz > 0.0 {
                        player_push(mut con, mx, 0.1, mz)
                    }
                    self.connections[slot] = some(con)
                }
            }
        } else if all.list.is_mob(h.target) {
            if let lent = all.list.lend_mob(h.target) {
                var mob = lent
                let resisted = (1.0 - mob.living.attributes.value(lf.knockback_resistance)).max(0.0)
                let scale = knock * 0.6 * resisted
                let (mx, mz) = (ux * scale, uz * scale)
                if mx * mx + mz * mz > 0.0 {
                    mob.living.body.push(mx, 0.1, mz)
                }
                all.list.give_back_mob(mob)
            }
        } else if all.list.is_stand(h.target) {
            if let lent = all.list.lend_stand(h.target) {
                var stand = lent
                let resisted = (1.0 - stand.living.attributes.value(lf.knockback_resistance)).max(0.0)
                let scale = knock * 0.6 * resisted
                let (mx, mz) = (ux * scale, uz * scale)
                if mx * mx + mz * mz > 0.0 {
                    stand.living.body.push(mx, 0.1, mz)
                }
                all.list.give_back_stand(stand)
            }
        }
        self.living_facts = some(lf)
        return all
    }

    // The post-attack effects of an arrow's hurt of what it hit, `h`, shot by `by` from `weapon`,
    // `doPostAttackEffectsWithItemSource` (CAL-159): what a player hit wears does to the mob that
    // shot it, `victim_post_attack`, in the hit's context `context` with them as `this`; then
    // the weapon's own effects for its attacker, the mob, none of a bow's. What a mob or an armor
    // stand hit wears, what a player wears against an arrow no mob shot, and the weapon's own
    // effects, are said to be missing where there are any.
    fn arrow_post_attack(mut self, es: own LevelEntities, d: usize, h: ArrowHit, by: Shooter?, weapon: Tag?, context: LootParams) -> LevelEntities {
        var all = es
        let shooter: i32? = match by {
            some(o) => if o.mob { some(o.id) } else { none },
            none => none,
        }
        if h.player {
            if let slot = self.slot_of_entity(h.target) {
                if let held = self.connections[slot].take() {
                    var con = held
                    if let m = shooter {
                        if let lent = all.list.lend_mob(m) {
                            var params = context.copy()
                            params.this_entity = true
                            params.this = some(LootEntity { kind: String("minecraft:player"), hand: held_in(con, 0) })
                            params.origin = some((con.player.x, con.player.y, con.player.z))
                            self.put_entities(d, all)
                            let back = self.victim_post_attack(mut con, d, lent, params)
                            all = self.take_entities(d)
                            all.list.give_back_mob(back)
                        }
                    } else if self.any_enchanted(worn_by(con)) {
                        self.levels[d].unimplemented(String("Post-attack effects of what a player wears against an arrow no mob shot"))
                    }
                    self.connections[slot] = some(con)
                }
            }
        } else if all.list.is_mob(h.target) {
            if self.any_enchanted(all.list.mob(h.target).living.equipment.copy()) {
                self.levels[d].unimplemented(String("Post-attack effects of what a mob wears against arrows"))
            }
        } else if all.list.is_stand(h.target) {
            if self.any_enchanted(all.list.stand(h.target).living.equipment.copy()) {
                self.levels[d].unimplemented(String("Post-attack effects of what an armor stand wears against arrows"))
            }
        }
        if let w = weapon {
            if shooter != none {
                if let shared = self.levels[d].world_loot() {
                    if let env = self.levels[d].shared_env() {
                        let Env { facts: f, .. } = env.value
                        var missing = List<String>()
                        var random = self.levels[d].lend_level_random()
                        let done = post_attack_effects(shared.value, f, self.levels[d], mut random, w, 0, "attacker", context, mut missing)
                        self.levels[d].give_back_level_random(random)
                        if not done.is_empty() {
                            missing.push(String("Post-attack effects of the weapons arrows are shot from"))
                        }
                        for m in missing {
                            self.levels[d].unimplemented(m)
                        }
                    }
                }
            }
        }
        return all
    }

    // What the block an arrow struck, `s`, does of it in the level `d` before it lands,
    // `onProjectileHit` (CAL-159): amethyst chimes, `AMETHYST_BLOCK_CHIME`, its pitch drawn from
    // the level's random; a burning arrow lights a campfire that isn't lit nor waterlogged where it
    // may interact there, `mayInteract`, and a candle or candle cake that isn't lit, a candle not
    // waterlogged, `setLit`, with flags 11; and a chorus flower breaks, and a decorated pot cracks,
    // with flags 260, and breaks, `destroyBlock`, where it may interact there and break it,
    // `mayBreak`, the arrow `id` what broke it, its drops made after its break's shown. Their game
    // events come with game events.
    fn block_struck(mut self, es: own LevelEntities, d: usize, id: i32, s: BlockStruck) -> LevelEntities {
        let all = es
        let env = self.levels[d].shared_env() else return all
        let Env { facts: f, .. } = env.value
        let block = f.block(s.state)
        let (x, y, z) = (s.x, s.y, s.z)
        if f.is_a(block, String("TargetBlock")) {
            let strength = self.target_struck(d, f, s)
            if let by = self.shooter_of(d, all.list, s.owner) {
                if let slot = by.slot {
                    self.put_entities(d, all)
                    self.target_hit(slot, s, strength)
                    return self.take_entities(d)
                }
            }
            return all
        }
        if f.is_a(block, String("BellBlock")) {
            // `BellBlock.onHit` from the side it's met on: `attemptToRing`, its block entity's
            // block event toward the face, then its sound for everyone. Its game event comes with
            // game events, and the player who shot it ringing it with their stats.
            let (_, at_y, _) = s.at
            if proper_bell_hit(f, s.state, y, s.face, at_y) {
                self.levels[d].block_event(x, y, z, block, 1, s.face)
                self.levels[d].play_sound(x, y, z, String("block.bell.use"), 2.0f32, 1.0f32)
            }
            return all
        }
        if f.is_a(block, String("BigDripleafBlock")) {
            // `setTiltAndScheduleTick` to full, with its tilt down's sound.
            match tilt_leaf(f, mut self.levels[d], s.state, x, y, z, "full", true) {
                ok => {},
                err(thrown) => self.levels[d].unimplemented(thrown.message),
            }
            return all
        }
        if f.is_a(block, String("AmethystBlock")) {
            var random = self.levels[d].lend_level_random()
            let pitch = 0.5f32 + random.next_float() * 1.2f32
            self.levels[d].give_back_level_random(random)
            // Heard as `SoundSource.BLOCKS`, 4.
            self.levels[d].play_sound_from_source(String("block.amethyst_block.chime"), f64(x) + 0.5, f64(y) + 0.5, f64(z) + 0.5, 4, 1.0f32, pitch)
            return all
        }
        let lit = f.get_bool(s.state, String("lit"))
        let wet = f.get_bool(s.state, String("waterlogged"))
        if f.is_a(block, String("AbstractCandleBlock")) {
            if s.burning and not lit and not (f.is_a(block, String("CandleBlock")) and wet) {
                self.light_struck(d, f, s.state, x, y, z)
            }
            return all
        }
        let may_interact = self.may_interact(d, all.list, s.owner, x, z)
        if f.is_a(block, String("CampfireBlock")) {
            if s.burning and may_interact and not lit and not wet {
                self.light_struck(d, f, s.state, x, y, z)
            }
            return all
        }
        if not may_interact or not self.may_break(d, all.list, s) {
            return all
        }
        if f.is_a(block, String("DecoratedPotBlock")) {
            match f.with_bool(s.state, String("cracked"), true) {
                ok(cracked) => {
                    _ = self.levels[d].set_block_limited(x, y, z, cracked, 260, UPDATE_LIMIT)
                },
                err(_) => {},
            }
        }
        self.put_entities(d, all)
        _ = self.levels[d].break_struck(x, y, z, id)
        self.send_level_events(d)
        self.make_drops(d)
        return self.take_entities(d)
    }

    // `TargetBlock.updateRedstoneOutput` of the arrow that struck `s` in the level `d` (CAL-159):
    // its signal by how near the hit is to the middle of the face it met, `target_strength`, set
    // with flags 3, and its tick to come 20 ticks on, an arrow's, where none's to come already.
    // The signal, whether it's set or not, for the player who shot it, `target_hit` (CAL-164).
    fn target_struck(mut self, d: usize, f: Facts, s: BlockStruck) -> i32 {
        let block = f.block(s.state)
        let strength = target_strength(s.face, s.at)
        if not self.levels[d].has_block_tick(block, s.x, s.y, s.z) {
            match f.with_int(s.state, String("power"), strength) {
                ok(on) => {
                    _ = self.levels[d].set_block_limited(s.x, s.y, s.z, on, 3, UPDATE_LIMIT)
                    self.levels[d].schedule_block(block, s.x, s.y, s.z, 20, 0)
                },
                err(_) => {},
            }
        }
        return strength
    }

    // The rest of `TargetBlock.onProjectileHit` for the player in `slot`, whose arrow struck a
    // target block, `s`, its signal `strength` (CAL-164): their `Stats.TARGET_HIT`; then
    // `CriteriaTriggers.TARGET_BLOCK_HIT.trigger`, each criterion listening whose
    // `signal_strength` holds of the signal, whose `projectile` holds of the arrow where it struck,
    // and whose player's condition holds, awarded.
    fn target_hit(mut self, slot: usize, s: BlockStruck, strength: i32) {
        let held = self.connections[slot].take() else return
        var con = held
        con.player.stats.award_custom("target_hit", 1)
        let listening = con.player.advancements.listening(String("minecraft:target_hit"))
        if not listening.is_empty() {
            let arrow = LootEntity { kind: String("minecraft:arrow"), on_fire: s.burning, at: some(s.at) }
            var matched = List<Listener>()
            for (key, conditions) in listening {
                let wanted = field_of(conditions, "signal_strength")
                if wanted != Tag.End and not ints_hold(wanted, strength) {
                    continue
                }
                let them = field_of(conditions, "projectile")
                if them != Tag.End and not self.entity_condition(con, them, arrow.copy()) {
                    continue
                }
                if self.player_holds(con, conditions) {
                    matched.push(key.copy())
                }
            }
            self.award_all(mut con, matched)
        }
        self.connections[slot] = some(con)
    }

    // The block `state` at `x`, `y`, `z` lit, flags 11, as a burning arrow lights a campfire or a
    // candle (CAL-159).
    fn light_struck(mut self, d: usize, f: Facts, state: u32, x: i32, y: i32, z: i32) {
        match f.with_bool(state, String("lit"), true) {
            ok(on) => {
                _ = self.levels[d].set_block_limited(x, y, z, on, 11, UPDATE_LIMIT)
            },
            err(_) => {},
        }
    }

    // `Projectile.mayInteract` of an arrow of the owner `owner` at the block `x`, `z` of the
    // level `d` (CAL-159): a player owner's own, out of spawn protection and within the world
    // border, `ServerLevel.mayInteract`; with no owner here, it may; else where mob griefing's on.
    fn may_interact(self, d: usize, list: Entities, owner: (i64, i64)?, x: i32, z: i32) -> bool {
        let by = self.shooter_of(d, list, owner) else return true
        let slot = by.slot else return self.world.mob_griefing
        let con = self.connections[slot] else return true
        let (west, north, east, south) = self.border_of(d)
        let (bx, bz) = (f64(x), f64(z))
        return not self.spawn_protected(con, d, x, z) and bx >= west and bx < east and bz >= north and bz < south
    }

    // `Projectile.mayBreak` of the arrow that struck `s` in the level `d` (CAL-159): arrows are
    // `IMPACT_PROJECTILES`; with `projectiles_can_break_blocks` on, where it may break the block
    // in adventure mode, `canBreakBlockInAdventureMode`: with no owner here in a world that isn't
    // adventure's, or a player owner not in adventure mode, it may; else only where its own
    // `can_break` says so, which is said to be missing.
    fn may_break(mut self, d: usize, list: Entities, s: BlockStruck) -> bool {
        if not self.world.projectiles_can_break_blocks {
            return false
        }
        let by = self.shooter_of(d, list, s.owner)
        let adventure_world = self.world.settings.game_type == GameType.Adventure
        var free = false
        match by {
            some(o) => {
                if let slot = o.slot {
                    if let con = self.connections[slot] {
                        free = con.player.mode != GameType.Adventure
                    }
                }
            },
            none => free = not adventure_world,
        }
        if free {
            return true
        }
        if s.can_break {
            self.levels[d].unimplemented(String("A projectile's can_break, which blocks it may break in adventure mode"))
        }
        return false
    }

    // What owns an arrow, of the UUID `uuid`, in the level `d`, `getOwner` (CAL-159): a player of
    // the level, or a mob or armor stand of `list`; none where nothing there has it, or something
    // else does.
    fn shooter_of(self, d: usize, list: Entities, uuid: (i64, i64)?) -> Shooter? {
        let (most, least) = uuid else return none
        for slot in self.level_slots(d) {
            if let c = self.connections[slot] {
                if let p = c.profile {
                    if p.id.most == most and p.id.least == least and in_world(c) {
                        let me = LootEntity { kind: String("minecraft:player"), hand: held_in(c, 0) }
                        return some(Shooter { id: c.player.entity_id, player: some((most, least)), slot: some(slot), creative: c.player.mode == GameType.Creative, may_build: c.player.abilities.may_build, name: some(self.player_name(p)), weapon: self.weapon_name(held_in(c, 0)), loot: some(me) })
                    }
                }
            }
        }
        let id = list.id_with_uuid((most, least)) else return none
        if list.is_mob(id) {
            let m = list.mob(id)
            let name = living_display_name(m.living, String(type_name(m.species)))
            return some(Shooter { id: id, mob: true, name: some(name), weapon: self.weapon_name(m.living.equipment[0].copy()), loot: some(m.loot_entity()) })
        }
        if list.is_stand(id) {
            let s = list.stand(id)
            let name = living_display_name(s.living, String("minecraft:armor_stand"))
            return some(Shooter { id: id, name: some(name), weapon: self.weapon_name(s.living.equipment[0].copy()), loot: some(s.loot_entity()) })
        }
        return none
    }

    // The mob `target` of the level `d`, lent out of `es`, hurt by `amount` of an arrow's damage
    // `source` (CAL-159), as `hurt_mob` hurts it for a player: set on fire for 5 seconds first
    // where the arrow `burns`, its fire as it was where it isn't hurt; `hurtServer`, what it wears
    // against it as its level works it out, `Mob.ward`, with what shot it, `attacker`, to loot;
    // hurt, its damage event sent those who see it where it took the whole of it, caused by the
    // arrow's owner and dealt by the arrow, its sounds played, its death, `die`, done as its
    // level does one in its own tick, `died`, what its kind does after, `after_hurt`, and an
    // arrow more in it where it's `stuck`. An enderman it'd hurt dodges it
    // instead, `dodge`, then, in the arrow's tick, within the world border, what that shows and
    // plays sent in turn, the fire the arrow lit kept, as `projectileReceivesSideEffectsOnHit`
    // has it (CAL-159). Where a player caused it, their `PLAYER_HURT_ENTITY` as its `hurtServer`
    // ends, dealt by `projectile` (CAL-164). The level's entities, whether it was hurt, and
    // whether it was dodged.
    fn shoot_mob(mut self, es: own LevelEntities, d: usize, target: i32, source: Damage, amount: f32, attacker: LootEntity?, projectile: LootEntity?, burns: bool, stuck: bool) -> (LevelEntities, bool, bool) {
        var all = es
        let lent = all.list.lend_mob(target) else return (all, false, false)
        var mob = lent
        let lf = self.living_facts.take() else {
            all.list.give_back_mob(mob)
            return (all, false, false)
        }
        let items = self.items.take() else {
            self.living_facts = some(lf)
            all.list.give_back_mob(mob)
            return (all, false, false)
        }
        var missing = List<String>()
        var sounds = List<EntitySound>()
        let fire = mob.living.body.fire
        if burns {
            mob.living.ignite_for_ticks(100)
        }
        let ward = mob.ward(self.levels[d], items, lf.damage, source, attacker, mut missing)
        let h = mob.hurt(lf, lf.damage, source, amount, self.world.game_time, ward, mut sounds, mut missing)
        if let who = source.player {
            self.dealt_by(who, h)
        }
        var dodged = false
        var dodge_shown = List<Shown>()
        var dodge_after = List<usize>()
        if mob.dodge_due {
            if let held = self.movement.take() {
                if let env = self.levels[d].shared_env() {
                    let Env { facts: f, .. } = env.value
                    mob.border = some(self.border_of(d))
                    let min_y = self.world.dims[d].min_y
                    dodged = mob.dodge(lf, f, held, self.levels[d], min_y, mut sounds)
                }
                self.movement = some(held)
            }
            dodge_shown = mob.living.shown.copy()
            dodge_after = mob.living.shown_after.copy()
            mob.living.shown.clear()
            mob.living.shown_after.clear()
        }
        var deaths = List<Death>()
        var call: i32? = none
        if h.hurt {
            if h.dies {
                mob.die_outside(items, source)
                for w in mob.living.shown {
                    if let Shown.Died(death) = w {
                        deaths.push(death.copy())
                    }
                }
                mob.living.shown.clear()
                mob.living.shown_after.clear()
            }
            let hard = self.world.settings.difficulty == Difficulty.Hard
            call = mob.after_hurt(h, hard, source)
            if stuck {
                mob.living.arrow_in()
            }
        } else if not dodged {
            mob.living.body.fire = fire
        }
        let hit_tags = lf.damage.tags_of(source.kind)
        self.items = some(items)
        self.living_facts = some(lf)
        let victim = mob.loot_entity()
        all.list.give_back_mob(mob)
        if dodged {
            var k = 0usize
            for n in 0..dodge_shown.len() {
                k = self.play_until(d, sounds, k, dodge_after[n])
                all = self.show(all, d, target, dodge_shown[n].copy())
            }
            _ = self.play_until(d, sounds, k, sounds.len())
            self.send_level_events(d)
            for what in missing {
                self.levels[d].unimplemented(what)
            }
            return (all, false, true)
        }
        if h.hurt {
            // The sounds of its `actuallyHurt` first, a villager's anger at a player, then its
            // damage event and the rest.
            let k = self.play_until(d, sounds, 0, h.early)
            self.send_level_events(d)
            if h.angry and all.trackers.contains(target) {
                self.send_to_seen(all.trackers[target].seen_by.copy(), encode_play(ClientboundEntityEvent { entity_id: target, event: 13i8 }))
            }
            if h.full and all.trackers.contains(target) {
                let seen = all.trackers[target].seen_by.copy()
                let at: Point? = none
                let packet = ClientboundDamageEvent { entity_id: target, source_type: source.kind, source_cause: source.cause + 1, source_direct: source.direct + 1, source_position: at }
                self.send_to_seen(seen, encode_play(packet))
            }
            _ = self.play_until(d, sounds, k, sounds.len())
            self.send_level_events(d)
            // A totem's save, `broadcastEntityEvent` 35, after what it played (D518).
            if h.totem and all.trackers.contains(target) {
                self.send_to_seen(all.trackers[target].seen_by.copy(), encode_play(ClientboundEntityEvent { entity_id: target, event: 35i8 }))
            }
        }
        for what in missing {
            self.levels[d].unimplemented(what)
        }
        for death in deaths {
            self.put_entities(d, all)
            self.died(d, target, death)
            all = self.take_entities(d)
        }
        if h.hurt {
            if let who = source.player {
                self.put_entities(d, all)
                self.shot_by_player(who, victim, projectile, h.dealt, h.taken, hit_tags)
                all = self.take_entities(d)
            }
        }
        // The reinforcements it called, after its death, as `Zombie.hurtServer` calls them.
        if let t = call {
            self.put_entities(d, all)
            for m in self.reinforcements(d, target, t, none, none) {
                self.add_mob(d, m.copy())
            }
            all = self.take_entities(d)
        }
        return (all, h.hurt, false)
    }

    // `AbstractThrownPotion.onHit` of what the thrown potion `s` hit in the level `d` (D527): for a
    // potion of water, which douses fire, `#douses_fire`, fire, a lit candle or a lit campfire it'd
    // put out, `douseFire`, and what burns or water hurts about it, `affectEntitiesAround`, said
    // missing; its effects, where it has any, `splash_effects`, or a lingering potion's cloud,
    // `linger` (D529); then level event 2007, where its potion has instant effects, else 2002,
    // with its colour, at its block, and, unless it's silent, 1054 or 1053, its sound. Its
    // removal's sent after.
    fn splash(mut self, es: own LevelEntities, d: usize, s: Splash) -> LevelEntities {
        var all = es
        let contents = self.stack_component(s.item.copy(), String("minecraft:potion_contents")) ?? Tag.Compound(JavaHashMap<String, Tag>())
        var potion: String? = none
        match contents {
            Tag.Str(name) => potion = some(name.copy()),
            Tag.Compound(m) => {
                if m.contains("potion") {
                    if let Tag.Str(name) = m["potion"] {
                        potion = some(name.copy())
                    }
                }
            },
            _ => {},
        }
        if potion == some(String("minecraft:water")) {
            if let (bx, by, bz, face) = s.block {
                if self.douses_any(d, bx, by, bz, face) {
                    self.levels[d].unimplemented(String("A splash of water putting out fire, candles and campfires, douseFire"))
                }
            }
            if self.splash_meets_burning(all, d, s) {
                self.levels[d].unimplemented(String("A splash of water putting out what burns and hurting what water hurts, affectEntitiesAround"))
            }
        }
        let effects = contents_effects(contents.copy(), 1.0f32)
        if not effects.is_empty() {
            if s.lingering {
                all = self.linger(all, d, s, contents.copy())
            } else {
                all = self.splash_effects(all, d, s, effects)
            }
        }
        var instant = false
        if let name = potion {
            if let lf = self.living_facts {
                for e in potion_effects(name.copy()) {
                    instant = instant or lf.effects[usize.wrap(e.id)].instantaneous()
                }
            }
        }
        let (bx, by, bz) = (i32.saturate(s.x.floor()), i32.saturate(s.y.floor()), i32.saturate(s.z.floor()))
        let color = contents_color(contents)
        self.levels[d].mob_level_event(if instant { 2007 } else { 2002 }, bx, by, bz, color)
        if not s.silent {
            self.levels[d].mob_level_event(if instant { 1054 } else { 1053 }, bx, by, bz, 0)
        }
        self.send_level_events(d)
        return all
    }

    // Whether a splash of water on the face `face` of the block at x, y, z in the level `d` would
    // put out anything, `douseFire`: fire, a lit candle or a lit campfire in the block before that
    // face, the block itself, or any of the four beside the first (D527).
    fn douses_any(self, d: usize, x: i32, y: i32, z: i32, face: i32) -> bool {
        let env = self.levels[d].shared_env() else return false
        let Env { facts: f, .. } = env.value
        let (fx, fy, fz) = face_step(face)
        let (ex, ey, ez) = (x + fx, y + fy, z + fz)
        let places: List<(i32, i32, i32)> = [(ex, ey, ez), (x, y, z), (ex, ey, ez - 1), (ex + 1, ey, ez), (ex, ey, ez + 1), (ex - 1, ey, ez)]
        for (px, py, pz) in places {
            let state = self.levels[d].collision_state(px, py, pz) ?? 0
            let block = f.block(state)
            if f.is_a(block, String("BaseFireBlock")) {
                return true
            }
            if (f.is_a(block, String("AbstractCandleBlock")) or f.is_a(block, String("CampfireBlock"))) and f.get_bool(state, String("lit")) {
                return true
            }
        }
        return false
    }

    // Whether a living thing the thrown potion `s` would splash with water burns or water hurts
    // it, as `affectEntitiesAround` looks for them (D527): in its box grown 4 across and 2 up and
    // down, where it is within 4 of the potion.
    fn splash_meets_burning(self, es: LevelEntities, d: usize, s: Splash) -> bool {
        let b = s.bounds
        let area = Aabb { min_x: b.min_x - 4.0, min_y: b.min_y - 2.0, min_z: b.min_z - 4.0, max_x: b.max_x + 4.0, max_y: b.max_y + 2.0, max_z: b.max_z + 4.0 }
        for id in es.list.find_living(area, -1) {
            if es.list.is_mob(id) {
                let m = es.list.mob(id)
                let (dx, dy, dz) = (m.living.body.x - s.x, m.living.body.y - s.y, m.living.body.z - s.z)
                if dx * dx + dy * dy + dz * dz < 16.0 and (m.living.body.fire > 0 or m.species == ENDERMAN) {
                    return true
                }
            }
        }
        for slot in self.level_slots(d) {
            let c = self.connections[slot] else continue
            let pb = pose_box(c.player.entity_data.number(POSE_ID), c.player.x, c.player.y, c.player.z)
            let (dx, dy, dz) = (c.player.x - s.x, c.player.y - s.y, c.player.z - s.z)
            if c.player.fire > 0 and pb.intersects(area.min_x, area.min_y, area.min_z, area.max_x, area.max_y, area.max_z) and dx * dx + dy * dy + dz * dz < 16.0 {
                return true
            }
        }
        return false
    }

    // `ThrownSplashPotion.onHitAsPotion` of the effects `effects`, the potion's `getAllEffects`,
    // where the thrown potion `s` hit, in the level `d` (D527): each living thing in the potion's
    // box grown 4 across and 2 up and down, `getEntitiesOfClass`, the mobs as `find_living` finds
    // them, then the players, no spectators, each that potions take, not an armor stand nor dying,
    // `isAffectedByPotions`, whose box, grown by the potion's margin, is within 4 of the potion's,
    // `distanceToSqr`, at a scale of 1 less a quarter of how far: each instant effect done at that
    // scale, `applyInstantaneousEffect`, `splash_instant`; each other added, `addEffect`, for its
    // duration at that scale and the stack's `potion_duration_scale`, half up, `mapDuration`,
    // unless that ends within 20 ticks, `endsWithin`, its icon shown where it is.
    fn splash_effects(mut self, es: own LevelEntities, d: usize, s: Splash, effects: List<ActiveEffect>) -> LevelEntities {
        var all = es
        let by = s.doser()
        var duration_scale = 1.0f32
        if let t = self.stack_component(s.item.copy(), String("minecraft:potion_duration_scale")) {
            duration_scale = t.number_float() ?? 1.0f32
        }
        let b = s.bounds
        let area = Aabb { min_x: b.min_x - 4.0, min_y: b.min_y - 2.0, min_z: b.min_z - 4.0, max_x: b.max_x + 4.0, max_y: b.max_y + 2.0, max_z: b.max_z + 4.0 }
        let margin = f64(s.margin)
        for id in all.list.find_living(area, -1) {
            if not all.list.is_mob(id) {
                continue
            }
            let m = all.list.mob(id)
            if m.living.dead_or_dying() {
                continue
            }
            let mb = m.living.body.bounding_box()
            let dist = box_distance_sqr(b, Aabb { min_x: mb.min_x - margin, min_y: mb.min_y - margin, min_z: mb.min_z - margin, max_x: mb.max_x + margin, max_y: mb.max_y + margin, max_z: mb.max_z + margin })
            if not (dist < 16.0) {
                continue
            }
            let scale = 1.0 - dist.sqrt() / 4.0
            for e in effects {
                all = self.splash_mob(all, d, by, id, e, scale, splashed_duration(e, scale, duration_scale))
            }
        }
        self.put_entities(d, all)
        var splashed = List<(usize, f64)>()
        for slot in self.level_slots(d) {
            let c = self.connections[slot] else continue
            if c.player.mode == GameType.Spectator or c.player.entity_data.float(HEALTH) <= 0.0f32 or not in_world(c) {
                continue
            }
            let pb = pose_box(c.player.entity_data.number(POSE_ID), c.player.x, c.player.y, c.player.z)
            if not pb.intersects(area.min_x, area.min_y, area.min_z, area.max_x, area.max_y, area.max_z) {
                continue
            }
            let dist = box_distance_sqr(b, Aabb { min_x: pb.min_x - margin, min_y: pb.min_y - margin, min_z: pb.min_z - margin, max_x: pb.max_x + margin, max_y: pb.max_y + margin, max_z: pb.max_z + margin })
            if dist < 16.0 {
                splashed.push((slot, 1.0 - dist.sqrt() / 4.0))
            }
        }
        for (slot, scale) in splashed {
            for e in effects {
                self.splash_player(slot, d, by, e, scale, splashed_duration(e, scale, duration_scale))
            }
        }
        return self.take_entities(d)
    }

    // `DragonFireball.onHit` of what the dragon fireball `s` struck in the level `d` (D618): a
    // cloud of dragon's breath with the next ID where it is, owned by its owner where they're a
    // living thing in the level, `getOwner`, `EffectCloud.fireballed`, but where the first living
    // thing in its box grown 4 across and 2 up and down, `getEntitiesOfClass`, the mobs and armor
    // stands as `find_living` finds them, then the players, no spectators, is within 4 of it,
    // `distanceToSqr`, there; level event 2006 at its block, -1 where it's silent, else 1; and the
    // cloud added, `addFreshEntity`. Its removal's sent after.
    fn fireball_splash(mut self, es: own LevelEntities, d: usize, s: FireballHit) -> LevelEntities {
        let all = es
        let b = s.bounds
        let area = Aabb { min_x: b.min_x - 4.0, min_y: b.min_y - 2.0, min_z: b.min_z - 4.0, max_x: b.max_x + 4.0, max_y: b.max_y + 2.0, max_z: b.max_z + 4.0 }
        var at: (f64, f64, f64)? = none
        for id in all.list.find_living(area, -1) {
            var place: (f64, f64, f64)? = none
            if all.list.is_mob(id) {
                let m = all.list.mob(id)
                if not m.living.body.removed {
                    place = some((m.living.body.x, m.living.body.y, m.living.body.z))
                }
            } else if all.list.is_stand(id) {
                let a = all.list.stand(id)
                if not a.living.body.removed {
                    place = some((a.living.body.x, a.living.body.y, a.living.body.z))
                }
            }
            let (px, py, pz) = place else continue
            let (dx, dy, dz) = (px - s.x, py - s.y, pz - s.z)
            if dx * dx + dy * dy + dz * dz < 16.0 {
                at = some((px, py, pz))
                break
            }
        }
        if at == none {
            for slot in self.level_slots(d) {
                let c = self.connections[slot] else continue
                if c.player.mode == GameType.Spectator or not in_world(c) {
                    continue
                }
                let pb = pose_box(c.player.entity_data.number(POSE_ID), c.player.x, c.player.y, c.player.z)
                let (dx, dy, dz) = (c.player.x - s.x, c.player.y - s.y, c.player.z - s.z)
                if pb.intersects(area.min_x, area.min_y, area.min_z, area.max_x, area.max_y, area.max_z) and dx * dx + dy * dy + dz * dz < 16.0 {
                    at = some((c.player.x, c.player.y, c.player.z))
                    break
                }
            }
        }
        var owner: (i64, i64)? = none
        match self.shooter_of(d, all.list, s.owner) {
            some(_) => owner = s.owner,
            none => {},
        }
        self.entity_ids += 1
        let id = self.entity_ids
        let seed = self.entity_seed(id)
        let (x, y, z) = at ?? (s.x, s.y, s.z)
        let cloud = EffectCloud.fireballed(id, seed, x, y, z, owner)
        let (bx, by, bz) = (i32.saturate(s.x.floor()), i32.saturate(s.y.floor()), i32.saturate(s.z.floor()))
        self.levels[d].mob_level_event(FIREBALL_SPLASH, bx, by, bz, if s.silent { -1 } else { 1 })
        self.send_level_events(d)
        self.put_entities(d, all)
        self.add_cloud(d, cloud)
        return self.take_entities(d)
    }

    // `ThrownLingeringPotion.onHitAsPotion` of the lingering potion `s` in the level `d` (D529): a
    // cloud with the next ID where the entity it hit is, else where it is; its owner where they're
    // a living thing in the level, `getOwner`; what its stack gives it,
    // `applyComponentsFromItemStack`, its contents `contents`, its `potion_duration_scale`, a
    // lingering potion's a quarter, its name and its custom data; and added, `addFreshEntity`.
    fn linger(mut self, es: own LevelEntities, d: usize, s: Splash, contents: Tag) -> LevelEntities {
        let all = es
        var at = (s.x, s.y, s.z)
        if let target = s.entity {
            if let place = all.list.place(target) {
                at = place
            } else if let slot = self.player_slot(d, target) {
                if let c = self.connections[slot] {
                    at = (c.player.x, c.player.y, c.player.z)
                }
            }
        }
        var owner: (i64, i64)? = none
        match self.shooter_of(d, all.list, s.owner) {
            some(_) => owner = s.owner,
            none => {},
        }
        var scale: f32? = none
        if let t = self.stack_component(s.item.copy(), String("minecraft:potion_duration_scale")) {
            scale = t.number_float()
        }
        let name = self.stack_component(s.item.copy(), String("minecraft:custom_name"))
        let custom = self.stack_component(s.item.copy(), String("minecraft:custom_data"))
        self.entity_ids += 1
        let id = self.entity_ids
        let seed = self.entity_seed(id)
        let (x, y, z) = at
        let cloud = EffectCloud.lingered(id, seed, x, y, z, owner, some(contents.copy()), scale, name, custom)
        self.put_entities(d, all)
        self.add_cloud(d, cloud)
        return self.take_entities(d)
    }

    // What the cloud `dose.by` gives those its pass dosed in the level `d`, as `serverTick` gives
    // them (D529): each in turn, every one of its effects, an instant one done at half by the
    // cloud, caused by its owner, `applyInstantaneousEffect`, another added as it is,
    // `addEffect(new MobEffectInstance(effect))`, as `splash_mob` and `splash_player` do them.
    fn cloud_doses(mut self, es: own LevelEntities, d: usize, dose: Dose) -> LevelEntities {
        var all = es
        for (target, player) in dose.targets {
            if player {
                self.put_entities(d, all)
                if let slot = self.player_slot(d, target) {
                    for e in dose.effects {
                        self.splash_player(slot, d, dose.by, e, 0.5, some(e.copy()))
                    }
                }
                all = self.take_entities(d)
            } else {
                for e in dose.effects {
                    all = self.splash_mob(all, d, dose.by, target, e, 0.5, some(e.copy()))
                }
            }
        }
        return all
    }

    // The effect `e` of the thrown potion or cloud `s` on the mob `id` of the level `d`, lent out
    // of `es`, at the scale `scale` (D527, D529): instant health's heal, or instant damage's hurt,
    // `indirectMagic` by `s` caused by its owner, undead mobs the other way round,
    // `isInvertedHealAndHarm`; another added as `lasting`, where it lasts. An enderman hurt so
    // teleports, said missing.
    fn splash_mob(mut self, es: own LevelEntities, d: usize, s: Doser, id: i32, e: ActiveEffect, scale: f64, lasting: own ActiveEffect?) -> LevelEntities {
        var all = es
        let lf = self.living_facts.take() else return all
        let instant = lf.effects[usize.wrap(e.id)].instantaneous()
        if not instant {
            self.living_facts = some(lf)
            let longer = lasting else return all
            let lent = all.list.lend_mob(id) else return all
            var mob = lent
            var sounds = List<EntitySound>()
            if let held = self.living_facts.take() {
                _ = mob.add_effect(held, longer, mut sounds)
                self.living_facts = some(held)
            }
            all.list.give_back_mob(mob)
            _ = self.play_until(d, sounds, 0, sounds.len())
            return all
        }
        if e.id != INSTANT_HEALTH and e.id != INSTANT_DAMAGE {
            self.living_facts = some(lf)
            return all
        }
        let lent = all.list.lend_mob(id) else {
            self.living_facts = some(lf)
            return all
        }
        var mob = lent
        let harm = e.id == INSTANT_DAMAGE
        let amplifier = e.amplifier()
        if harm == mob.living.inverted(lf) {
            let amount = i32.saturate(scale * f64(4 << amplifier) + 0.5)
            mob.living.heal(lf, f32.nearest(amount))
            all.list.give_back_mob(mob)
            self.living_facts = some(lf)
            return all
        }
        let ender = mob.species == ENDERMAN
        let (tx, tz) = (mob.living.body.x, mob.living.body.z)
        all.list.give_back_mob(mob)
        let amount = f32.nearest(i32.saturate(scale * f64(6 << amplifier) + 0.5))
        let kind = lf.damage.id("indirect_magic")
        self.living_facts = some(lf)
        if ender {
            self.levels[d].unimplemented(String("An enderman a thrown potion hurts, hurtWithCleanWater and its teleports"))
        }
        let potion = LootEntity { kind: s.kind.copy(), at: some((s.x, s.y, s.z)) }
        let (source, attacker, _) = self.splash_source(d, all.list, s, kind, tx, tz)
        let (back, _, _) = self.shoot_mob(all, d, id, source, amount, attacker, some(potion), false, false)
        return back
    }

    // The effect `e` of the thrown potion or cloud `s` on the player in the slot `slot`, in the
    // level `d`, at the scale `scale` (D527, D529): instant health's heal, instant damage's hurt,
    // `indirectMagic` by `s` caused by its owner, saturation's food, a level each, at a saturation
    // modifier of 1; another added as `lasting`, where it lasts, told them.
    fn splash_player(mut self, slot: usize, d: usize, s: Doser, e: ActiveEffect, scale: f64, lasting: own ActiveEffect?) {
        let lf = self.living_facts.take() else return
        let instant = lf.effects[usize.wrap(e.id)].instantaneous()
        if e.id == INSTANT_DAMAGE {
            let kind = lf.damage.id("indirect_magic")
            self.living_facts = some(lf)
            let (tx, tz) = match self.connections[slot] {
                some(c) => (c.player.x, c.player.z),
                none => (s.x, s.z),
            }
            let es = self.take_entities(d)
            let (source, _, blame) = self.splash_source(d, es.list, s, kind, tx, tz)
            self.put_entities(d, es)
            let amount = f32.nearest(i32.saturate(scale * f64(6 << e.amplifier()) + 0.5))
            var con = self.connections[slot].take() else return
            if let held = self.living_facts.take() {
                _ = self.hurt_player_by(mut con, held, source, amount, blame)
                self.living_facts = some(held)
            }
            self.connections[slot] = some(con)
            return
        }
        var con = self.connections[slot].take() else {
            self.living_facts = some(lf)
            return
        }
        if not instant {
            if let longer = lasting {
                _ = self.give_effect(mut con, lf, longer)
            }
        } else if e.id == INSTANT_HEALTH {
            let amount = i32.saturate(scale * f64(4 << e.amplifier()) + 0.5)
            let (max_health, _) = player_maxes(con.player.attributes)
            heal(mut con.player.entity_data, f32.nearest(amount), max_health)
        } else {
            con.player.status.eat(e.amplifier() + 1, 1.0f32)
        }
        self.connections[slot] = some(con)
        self.living_facts = some(lf)
    }

    // The damage a thrown potion or cloud `s` deals what's at tx, tz across in the level `d`,
    // `indirectMagic(potion, owner)` of the type `kind` (D527, D529): by `s`, caused by its owner,
    // as `list` and the level's players have it, or by nothing where it has none; from where it
    // is, knocking back away from it, `calculateHorizontalHurtKnockbackDirection`. With it, the
    // owner to loot, and who's blamed for a death it deals.
    fn splash_source(self, d: usize, list: Entities, s: Doser, kind: i32, tx: f64, tz: f64) -> (Damage, LootEntity?, Blame) {
        var source = Damage { kind: kind, cause: -1, direct: s.id, at: some((s.x, s.y, s.z)), knock: some((tx - s.x, tz - s.z)) }
        var custom: Component? = none
        if let n = s.name {
            match Component.from_nbt(n.copy()) {
                ok(c) => custom = some(c),
                err(_) => {},
            }
        }
        let potion_name = entity_display_name(s.kind.copy(), Uuid.new(s.uuid.0, s.uuid.1), custom)
        var blame = Blame { cause: some(potion_name.copy()), direct: some(potion_name) }
        var attacker: LootEntity? = none
        if let o = self.shooter_of(d, list, s.owner) {
            source.cause = o.id
            source.player = o.player
            source.creative = o.creative
            source.living_cause = o.mob
            blame.cause = o.name.copy()
            blame.weapon = o.weapon.copy()
            attacker = o.loot.copy()
        }
        return (source, attacker, blame)
    }

    // The armor stand `target` of the level `d`, lent out of `es`, hurt by an arrow's damage
    // `source` (CAL-159), `by` who's behind it, as `hurt_stand` hurts it for a player: set on fire
    // for 5 seconds first where the arrow `burns`, its fire as it was where it isn't hurt;
    // `ArmorStand.hurt`, which an arrow, always killing armor stands, breaks it by; a hit's entity
    // event 32 sent those who see it; and its breaking, it taken out of the level's entities, the
    // drops, sound and particles, `stand_broken`, then its removal sent them; an arrow more in it
    // where it's hurt and `stuck`. The level's entities, and whether it was hurt.
    fn shoot_stand(mut self, es: own LevelEntities, d: usize, target: i32, source: Damage, by: StandHurter, burns: bool, stuck: bool) -> (LevelEntities, bool) {
        var all = es
        let lent = all.list.lend_stand(target) else return (all, false)
        var a = lent
        let lf = self.living_facts.take() else {
            all.list.give_back_stand(a)
            return (all, false)
        }
        let items = self.items.take() else {
            self.living_facts = some(lf)
            all.list.give_back_stand(a)
            return (all, false)
        }
        var missing = List<String>()
        let fire = a.living.body.fire
        if burns {
            a.living.ignite_for_ticks(100)
        }
        let this = a.loot_entity()
        let ward = a.living.ward(self.levels[d], items, lf.damage, source, this, none, mut missing)
        let h = a.hurt(lf, lf.damage, source, self.world.game_time, by, ward.immune)
        if not h.hurt {
            a.living.body.fire = fire
        } else if stuck {
            a.living.arrow_in()
        }
        var kept = List<Tag>()
        if let b = h.broken {
            kept = kept_equipment(items, b.equipment)
        }
        self.items = some(items)
        self.living_facts = some(lf)
        for what in missing {
            self.levels[d].unimplemented(what)
        }
        all.list.give_back_stand(a)
        if h.hit and all.trackers.contains(target) {
            let seen = all.trackers[target].seen_by.copy()
            self.send_level_events(d)
            self.send_to_seen(seen, encode_play(ClientboundEntityEvent { entity_id: target, event: 32i8 }))
        }
        if let b = h.broken {
            all.list.remove(target)
            _ = all.list.take_gone()
            _ = all.tracked.remove(target)
            let seen = match all.trackers.remove(target) {
                some(tr) => tr.seen_by.copy(),
                none => List<i32>(),
            }
            self.put_entities(d, all)
            self.stand_broken(d, b, kept)
            self.send_to_seen(seen, encode_play(ClientboundRemoveEntities { entity_ids: [target] }))
            return (self.take_entities(d), h.hurt)
        }
        return (all, h.hurt)
    }

    // The end crystal `target` of the level `d`, in `es`, hurt by a projectile's damage `source`,
    // an arrow's or a thrown item's (D591), as `hurt_crystal` hurts it for a player: where it's
    // gone, taken out of the level's entities and its removal sent those who see it at once,
    // after what was heard before, `remove(KILLED)`, then the rest of its destruction,
    // `crystal_destroyed`. The level's entities, and whether it was hurt.
    fn shoot_crystal(mut self, es: own LevelEntities, d: usize, target: i32, source: Damage) -> (LevelEntities, bool) {
        var all = es
        let lent = all.list.lend_crystal(target) else return (all, false)
        var c = lent
        let lf = self.living_facts.take() else {
            all.list.give_back_crystal(c)
            return (all, false)
        }
        let h = c.hurt(lf.damage, source.kind, source.creative, false)
        self.living_facts = some(lf)
        all.list.give_back_crystal(c)
        if not h.gone {
            return (all, false)
        }
        all.list.remove(target)
        _ = all.list.take_gone()
        _ = all.tracked.remove(target)
        let seen = match all.trackers.remove(target) {
            some(tr) => tr.seen_by.copy(),
            none => List<i32>(),
        }
        self.send_level_events(d)
        self.send_to_seen(seen, encode_play(ClientboundRemoveEntities { entity_ids: [target] }))
        self.crystal_destroyed(d, h.explodes)
        return (all, true)
    }

    // What follows an end crystal's breaking in the level `d` once it's gone, `hurtServer` (D590,
    // D591): its explosion, where what broke it wasn't one, `explodes`, said to be missing
    // (CAL-182); and in a dragon fight that isn't over, what the fight makes of it,
    // `onCrystalDestroyed`, said to be missing too, as the fight is (D586).
    fn crystal_destroyed(mut self, d: usize, explodes: bool) {
        if explodes {
            self.levels[d].unimplemented(exploded())
        }
        let fighting = match self.world.dims[d].fight {
            some(f) => not f.over(),
            none => false,
        }
        if fighting {
            self.levels[d].unimplemented(String("An end crystal destroyed in a dragon fight, `onCrystalDestroyed`"))
        }
    }

    // The mob `mob`, lent out of the level `d`'s entities, given back, and the entities taken
    // again (CAL-159).
    fn mob_back(mut self, d: usize, mob: own Mob) -> LevelEntities {
        var all = self.take_entities(d)
        all.list.give_back_mob(mob)
        return all
    }

    // `hurtAndBreak(amount, mob, slot)` of what the mob `id` wears in the equipment slot `slot`
    // (D437), as a player's is worn, `wear_worn`: the damage, as its enchantments and the level's
    // random make it; broken once it's taken all it can, one of it gone, its slot's entity event,
    // 47 for the main hand to 49 for the head, to those who see it, and its modifiers taken off,
    // `onEquippedItemBroken`. Its next tick's look sends the change, `detectEquipmentUpdates`.
    fn wear_mob(mut self, es: own LevelEntities, d: usize, id: i32, slot: usize, amount: i32, items: ItemCodecs) -> LevelEntities {
        var all = es
        var mob = all.list.lend_mob(id) else return all
        let seen = if all.trackers.contains(id) { all.trackers[id].seen_by.copy() } else { List<i32>() }
        self.wear_living(seen, d, mut mob.living, slot, amount, items)
        all.list.give_back_mob(mob)
        return all
    }

    // `wear_mob`'s wear of what the living entity `living` of the level `d` wears in the slot
    // `slot`, lent out of its entities, its break event sent those who see it, `seen` (D442).
    fn wear_living(mut self, seen: List<i32>, d: usize, living: mut Living, slot: usize, amount: i32, items: ItemCodecs) {
        let id = living.body.id
        let stack = living.equipment[slot].copy() else return
        let change = durability_change(stack.copy(), amount, items, false, mut self.levels[d])
        if change == 0 {
            return
        }
        let now = match items.component(stack.copy(), String("minecraft:damage")) {
            some(t) => t.number_int() ?? 0,
            none => 0,
        }
        let damaged = with_damage(stack, now + change, items)
        if broken(damaged.copy(), items) {
            living.equipment[slot] = shrunk(damaged.copy(), 1)
            let events: List<i8> = [47i8, 48i8, 52i8, 51i8, 50i8, 49i8]
            if slot < events.len() {
                self.send_to_seen(seen, encode_play(ClientboundEntityEvent { entity_id: id, event: events[slot] }))
            }
            for (a, m) in stack_modifiers(damaged, slot, items) {
                living.attributes.take_off(a, m.id)
            }
        } else {
            living.equipment[slot] = some(damaged)
        }
    }

    // What the level `d` does of a mob's death in its own tick, `death`, the mob `id` (D424), as
    // `die` has it: its loot table's, `dropFromLootTable`, with nothing that killed it, the player
    // who hurt it lately and their luck where they're in the level, `LAST_DAMAGE_PLAYER`; then
    // what it wears that it drops; each where it died, `spawnAtLocation`; its orbs, drawn for as
    // they're queued, `ExperienceOrb.award`; all made in order and seen; then its entity event 3
    // to those who see it. A slime's splitting and death loot table seeds come with them, said to
    // be missing.
    fn died(mut self, d: usize, id: i32, death: Death) {
        let (x, y, z) = (death.x, death.y, death.z)
        // `awardKillScore` of the player who gets the credit, `PLAYER_KILLED_ENTITY` (CAL-164);
        // then the player whose damage killed it, its source's entity, `killedEntity`: their
        // `ENTITY_KILLED` of its type.
        if let who = death.killed_by {
            if let victim = death.this.copy() {
                let name = match death.uuid {
                    some(u) => some(Uuid.new(u.0, u.1).to_string()),
                    none => none,
                }
                self.player_killed(d, who, victim, name)
            }
        }
        if let who = death.by_player {
            if let victim = death.this {
                self.award_player(who, "minecraft:killed", victim.kind.copy())
            }
        }
        var stacks = List<Tag>()
        if let (table, seed) = death.loot {
            var luck: f32? = none
            if let who = death.killed_by {
                luck = self.luck_in(d, who)
            }
            let none_by: LootEntity? = none
            let params = LootParams { origin: some((x, y, z)), this_entity: true, this: death.this.copy(), damage_source: true, attacker: none_by.copy(), direct_attacker: none_by, killed_by_player: luck != none, luck: luck ?? 0.0f32 }
            for s in self.roll_entity_loot(d, table.copy(), params, seed) {
                if let stack = s {
                    stacks.push(stack.copy())
                }
            }
        }
        for stack in death.equipment {
            stacks.push(stack.copy())
        }
        if let carried = death.carried {
            for stack in self.levels[d].carried_drops(carried, x, y, z) {
                stacks.push(stack.copy())
            }
        }
        for stack in stacks {
            self.levels[d].add_dropped(x, y, z, stack.copy())
        }
        for value in orb_values(death.reward) {
            let pick = self.levels[d].next_int_below(40)
            self.levels[d].add_orb(x, y, z, value, pick)
        }
        self.make_drops(d)
        let es = self.take_entities(d)
        let seen = if es.trackers.contains(id) { es.trackers[id].seen_by.copy() } else { List<i32>() }
        self.put_entities(d, es)
        self.send_to_seen(seen, encode_play(ClientboundEntityEvent { entity_id: id, event: 3i8 }))
    }

    // `dealt_counted` of the hurt `h` for the player of the UUID `who`, who caused it, wherever
    // they are (CAL-164). Nothing where they're not here, or it took nothing to count.
    fn dealt_by(mut self, who: (i64, i64), h: Hurt) {
        if h.resisted <= 0.0f32 and h.absorbed <= 0.0f32 {
            return
        }
        let (most, least) = who
        for slot in 0..self.connections.len() {
            if not self.playing(slot) {
                continue
            }
            var con = self.connections[slot].take() else continue
            var found = false
            if let p = con.profile {
                found = p.id.most == most and p.id.least == least
            }
            if found {
                dealt_counted(mut con, h)
            }
            self.connections[slot] = some(con)
            if found {
                return
            }
        }
    }

    // `awardStat` for the player of the UUID `who`, wherever they are: the stat of the type `kind`
    // and the value `value` one more (CAL-164). Nothing where they're not here.
    fn award_player(mut self, who: (i64, i64), kind: str, value: String) {
        let (most, least) = who
        for slot in 0..self.connections.len() {
            if not self.playing(slot) {
                continue
            }
            var con = self.connections[slot].take() else continue
            var found = false
            if let p = con.profile {
                found = p.id.most == most and p.id.least == least
            }
            if found {
                con.player.stats.award(String(kind), value.copy(), 1)
            }
            self.connections[slot] = some(con)
            if found {
                return
            }
        }
    }

    // `CriteriaTriggers.PLAYER_KILLED_ENTITY.trigger` for the player of the UUID `who` in the
    // level `d`, who killed `victim` (CAL-164): each criterion listening whose `entity` holds of
    // the victim, tested in `EntityPredicate.createContext` of it where the player is, and whose
    // player's condition holds, awarded. A `killing_blow` is said to be missing, and doesn't hold.
    fn player_killed(mut self, d: usize, who: (i64, i64), victim: LootEntity, victim_name: String?) {
        let (most, least) = who
        for slot in 0..self.connections.len() {
            if not self.playing(slot) {
                continue
            }
            var con = self.connections[slot].take() else continue
            var found = false
            if let p = con.profile {
                found = con.player.dim == d and p.id.most == most and p.id.least == least
            }
            if found {
                self.killed_by_player(mut con, victim.copy(), victim_name.copy())
            }
            self.connections[slot] = some(con)
            if found {
                return
            }
        }
    }

    // `ServerPlayer.awardKillScore` of the player of `con`, who killed `victim` (CAL-164): their
    // scores of `totalKillCount` one more, then their `PLAYER_KILLS` and scores of
    // `playerKillCount` where it's a player, else their `MOB_KILLS`; then, `handleTeamKill`, their
    // scores of `teamkill.` the color of the victim's team, and the victim's of `killedByTeam.`
    // the color of theirs, the victim by their name on the scoreboard, `victim_name`, a mob's its
    // UUID; then the kill trigger.
    fn killed_by_player(mut self, con: mut Connection, victim: LootEntity, victim_name: String?) {
        self.score_criteria(mut con, String("totalKillCount"), 1, none)
        let by_player = victim.kind == "minecraft:player"
        con.player.stats.award_custom(if by_player { "player_kills" } else { "mob_kills" }, 1)
        if by_player {
            self.score_criteria(mut con, String("playerKillCount"), 1, none)
        }
        if let killed = victim_name {
            if let p = con.profile.copy() {
                if let t = self.world.scoreboard.team(killed.copy()) {
                    if let c = t.color {
                        self.score_holder(mut con, "teamkill.{color_name(c)}", p.name.copy())
                    }
                }
                if let t = self.world.scoreboard.team(p.name.copy()) {
                    if let c = t.color {
                        self.score_holder(mut con, "killedByTeam.{color_name(c)}", killed.copy())
                    }
                }
            }
        }
        let listening = con.player.advancements.listening(String("minecraft:player_killed_entity"))
        if listening.is_empty() {
            return
        }
        let d = con.player.dim
        var matched = List<Listener>()
        for (key, conditions) in listening {
            if field_of(conditions, "killing_blow") != Tag.End {
                self.levels[d].unimplemented(String("A kill's killing blow, as an advancement tests it"))
                continue
            }
            let entity = field_of(conditions, "entity")
            if entity != Tag.End and not self.entity_condition(con, entity, victim.copy()) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        self.award_all(mut con, matched)
    }

    // Whether `condition`, a criterion's condition of another entity than the player, holds of
    // `entity`, tested in `EntityPredicate.createContext(player, entity)`, `entity` as `this`
    // where the player is, with the level's random (CAL-164).
    fn entity_condition(mut self, con: Connection, condition: Tag, entity: LootEntity) -> bool {
        let d = con.player.dim
        let shared = self.levels[d].world_loot() else return false
        let env = self.levels[d].shared_env() else return false
        let Env { facts: f, .. } = env.value
        let params = LootParams { origin: some((con.player.x, con.player.y, con.player.z)), this_entity: true, this: some(entity.copy()) }
        var missing = List<String>()
        var random = self.levels[d].lend_level_random()
        let holds = condition_holds(shared.value, f, self.levels[d], mut random, condition, params, mut missing)
        self.levels[d].give_back_level_random(random)
        for m in missing {
            self.levels[d].unimplemented(m)
        }
        return holds
    }

    // `CriteriaTriggers.TRADE.trigger` for the player, who traded with `villager` for `sold`, the
    // offer's result (CAL-164): each criterion listening whose `villager` holds of it, whose
    // `item` holds of what they got, and whose player's condition holds, awarded.
    fn villager_traded(mut self, con: mut Connection, villager: LootEntity, sold: Tag) {
        let listening = con.player.advancements.listening(String("minecraft:villager_trade"))
        if listening.is_empty() {
            return
        }
        let d = con.player.dim
        let shared = self.levels[d].world_loot() else return
        var matched = List<Listener>()
        var missing = List<String>()
        for (key, conditions) in listening {
            let them = field_of(conditions, "villager")
            if them != Tag.End and not self.entity_condition(con, them, villager.copy()) {
                continue
            }
            let wanted = field_of(conditions, "item")
            if wanted != Tag.End and not item_holds(shared.value, wanted, some(sold.copy()), mut missing) {
                continue
            }
            if self.player_holds(con, conditions) {
                matched.push(key.copy())
            }
        }
        for m in missing {
            self.levels[d].unimplemented(m)
        }
        self.award_all(mut con, matched)
    }

    // `triggerRecipeCrafted` and `awardRecipes` of the recipe `at`, which the player crafted
    // with the grid's stacks `grid` (CAL-164): `CriteriaTriggers.RECIPE_CRAFTED`, each criterion
    // listening whose `recipes` hold it, each of whose `ingredients` holds of another of the
    // stacks, and whose player's condition holds, awarded; then the recipe added to their book,
    // where it isn't special.
    fn recipe_crafted(mut self, con: mut Connection, at: usize, grid: List<Tag?>) {
        let recipes = self.world.recipes.copy() else return
        let id = recipes.value.all[at].id.to_string()
        let listening = con.player.advancements.listening(String("minecraft:recipe_crafted"))
        let d = con.player.dim
        if not listening.is_empty() {
            if let shared = self.levels[d].world_loot() {
                var matched = List<Listener>()
                var missing = List<String>()
                for (key, conditions) in listening {
                    if not recipe_named(field_of(conditions, "recipes"), id) {
                        continue
                    }
                    var left = grid.copy()
                    var all = true
                    if let Tag.List(wanted) = field_of(conditions, "ingredients") {
                        for p in wanted {
                            var found: usize? = none
                            for k in 0..left.len() {
                                if item_holds(shared.value, p, left[k].copy(), mut missing) {
                                    found = some(k)
                                    break
                                }
                            }
                            let k = found else {
                                all = false
                                break
                            }
                            _ = left.remove(k)
                        }
                    }
                    if all and self.player_holds(con, conditions) {
                        matched.push(key.copy())
                    }
                }
                for m in missing {
                    self.levels[d].unimplemented(m)
                }
                self.award_all(mut con, matched)
            }
        }
        if not recipes.value.is_special(at) {
            _ = self.add_recipes(mut con, [at])
        }
    }

    // The luck of the player of the UUID `who` in the level `d`, `getLuck`, where they're there
    // (D424).
    fn luck_in(self, d: usize, who: (i64, i64)) -> f32? {
        let (most, least) = who
        for slot in 0..self.connections.len() {
            if not self.playing(slot) {
                continue
            }
            if let c = self.connections[slot] {
                if c.player.dim != d {
                    continue
                }
                if let p = c.profile {
                    if p.id.most == most and p.id.least == least {
                        return some(f32.nearest(c.player.attributes.value(attribute_id(String("luck")) ?? 0)))
                    }
                }
            }
        }
        return none
    }

    // What a farm animal's breeding asks of the level `d` (CAL-158), `spawnChildFromBreeding`, of
    // the parent `parent`: its partner 6000 ticks from breeding again and out of love; its baby
    // made, then the `BRED_ANIMALS` of the player who made either fall in love and the parent's
    // entity event 18 (CAL-164), of the next ID, a
    // baby, `setBaby`, at its place facing south and level, `snapTo`, of the variant drawn, a lamb
    // of its parents' colours mixed, `DyeColor.getMixedColor`; then the orb, of the ID after,
    // added, and the baby, `addFreshEntityWithPassengers`.
    fn bred(mut self, d: usize, parent: i32, b: Bred, lf: LivingFacts) {
        var es = self.take_entities(d)
        // Who made either fall in love, `getLoveCause`, its own first, and what its parents are,
        // before the partner's out of love (CAL-164).
        var cause: (i64, i64)? = none
        var parent_seen: LootEntity? = none
        var partner_seen: LootEntity? = none
        if es.list.is_mob(parent) {
            cause = es.list.mob(parent).love_cause()
            parent_seen = some(es.list.mob(parent).loot_entity())
        }
        match es.list.lend_mob(b.partner) {
            some(p) => {
                var partner = p
                if cause == none {
                    cause = partner.love_cause()
                }
                partner_seen = some(partner.loot_entity())
                partner.bred_again()
                es.list.give_back_mob(partner)
            },
            none => {},
        }
        self.put_entities(d, es)
        if b.species == VILLAGER {
            if self.mob_facts_ready() {
                self.villager_born(d, b, lf)
            }
            return
        }
        if not self.mob_facts_ready() {
            self.parent_event(d, parent)
            return
        }
        var variant = b.variant
        if b.species == SHEEP {
            variant = self.mixed_color(d, b.variant, b.partner_variant)
        }
        self.entity_ids += 1
        let id = self.entity_ids
        let seed = self.entity_seed(id)
        let facts = self.mob_facts.take() else return
        var baby = Mob.made(lf, facts, b.species, b.kind, id, seed, b.x, b.y, b.z)
        self.mob_facts = some(facts)
        baby.set_breed_variant(variant)
        baby.set_age(-24000)
        baby.living.snap_to(b.x, b.y, b.z, 0.0f32, 0.0f32)
        // `finalizeSpawnChildFromBreeding`: `BRED_ANIMALS` of the parents and the baby for the
        // player who made them fall in love, before the orb (CAL-164).
        if let who = cause {
            self.bred_animals(d, who, parent_seen, partner_seen, baby.loot_entity())
        }
        self.parent_event(d, parent)
        if b.orb > 0 {
            self.entity_ids += 1
            let orb_id = self.entity_ids
            let orb_seed = self.entity_seed(orb_id)
            self.add_orb(d, ExperienceOrb.new(orb_id, orb_seed, b.x, b.y, b.z, b.orb), none)
        }
        self.add_mob(d, baby)
    }

    // The entity event 18 of the parent `parent` of the level `d` as it's bred,
    // `broadcastEntityEvent`, to those who see it (CAL-164).
    fn parent_event(mut self, d: usize, parent: i32) {
        let es = self.take_entities(d)
        if es.trackers.contains(parent) {
            self.send_to_seen(es.trackers[parent].seen_by.copy(), encode_play(ClientboundEntityEvent { entity_id: parent, event: 18i8 }))
        }
        self.put_entities(d, es)
    }

    // A villager's baby, in the level `d` (CAL-160), `VillagerMakeLove.breed`: of the next ID,
    // made as `getBreedOffspring` makes it, of the type its parent drew, the biome's at the block
    // the parent's in where it drew that, with no profession and its data final; a baby,
    // `setAge(-24000)`, at its parent's place facing south and level, `snapTo`; added,
    // `addFreshEntityWithPassengers`, and shown entity event 12; then the bed taken for it its
    // home, `giveBedToChild`.
    fn villager_born(mut self, d: usize, b: Bred, lf: LivingFacts) {
        let facts = self.mob_facts.take() else return
        var kind = b.variant
        if kind < 0 {
            if let (bx, by, bz) = b.block {
                kind = facts.villager_type(self.levels[d].biome(bx, by, bz))
            }
        }
        self.entity_ids += 1
        let id = self.entity_ids
        let seed = self.entity_seed(id)
        var baby = Mob.made(lf, facts, VILLAGER, b.kind, id, seed, b.x, b.y, b.z)
        self.mob_facts = some(facts)
        baby.born_villager(kind)
        baby.set_age(-24000)
        baby.living.snap_to(b.x, b.y, b.z, 0.0f32, 0.0f32)
        self.add_mob(d, baby)
        var es = self.take_entities(d)
        if es.trackers.contains(id) {
            self.send_to_seen(es.trackers[id].seen_by, encode_play(ClientboundEntityEvent { entity_id: id, event: 12i8 }))
        }
        if let bed = b.bed {
            let (x, y, z) = bed
            let dimension = es.list.dimension.copy()
            if let lent = es.list.lend_mob(id) {
                var child = lent
                child.given_home(x, y, z, dimension)
                es.list.give_back_mob(child)
            }
        }
        self.put_entities(d, es)
    }

    // The smaller cubes a slime splits into as it's taken out dying, in the level `d` (D430), as
    // `convertTo` makes each: of the next ID, made as a mob of its type is, `EntityType.create`,
    // with what `convertCommon` took from it; of half its size, its health full,
    // `setSize(size, true)`; at its place, facing as it drew, `snapTo`; then added,
    // `addFreshEntity`.
    fn split_cubes(mut self, d: usize, s: Split, lf: LivingFacts) {
        if not self.mob_facts_ready() {
            return
        }
        for (x, y, z, yaw) in s.places {
            self.entity_ids += 1
            let id = self.entity_ids
            let seed = self.entity_seed(id)
            let facts = self.mob_facts.take() else return
            var cube = Mob.made(lf, facts, s.species, s.kind, id, seed, x, y, z)
            self.mob_facts = some(facts)
            cube.convert_from(lf, s.common)
            cube.set_slime_size(s.size, true)
            cube.living.snap_to(x, y, z, yaw, 0.0f32)
            self.add_mob(d, cube)
        }
    }

    // `DyeColor.getMixedColor` of the colours `a` and `b`, by their IDs (CAL-158): the colour of
    // the dye that crafting `a`'s dye beside `b`'s makes, `findColorMixInRecipes`, or else either,
    // drawn from the level's random.
    fn mixed_color(mut self, d: usize, a: i32, b: i32) -> i32 {
        if let found = self.dye_mix(a, b) {
            return found
        }
        return if self.levels[d].next_boolean() { a } else { b }
    }

    // The colour of what crafting the dyes of `a` and `b` side by side makes, where it's a dye's,
    // `DataComponents.DYE`; each colour's dye is its own item's, as no other item is a dye.
    fn dye_mix(mut self, a: i32, b: i32) -> i32? {
        let names = dye_names()
        if a < 0 or b < 0 or usize.wrap(a) >= names.len() or usize.wrap(b) >= names.len() or not self.items_ready() {
            return none
        }
        let shared = self.world.recipes.copy() else return none
        let items = self.items.take() else return none
        var grid = List<Tag?>()
        for c in [a, b] {
            var stack = JavaHashMap<String, Tag>()
            stack.insert(String("id"), Tag.Str("minecraft:{names[usize.wrap(c)]}_dye"))
            stack.insert(String("count"), Tag.Int(1))
            grid.push(some(Tag.Compound(stack)))
        }
        let made = crafted(shared.value, CraftInput.of(2, 1, grid), items)
        var answer: i32? = none
        if let stack = made {
            if let dye = items.component(stack, String("minecraft:dye")) {
                if let Tag.Str(name) = dye {
                    for i in 0..names.len() {
                        if name == String(names[i]) {
                            answer = some(i32.wrap(i))
                        }
                    }
                }
            }
        }
        self.items = some(items)
        return answer
    }

    // `ClientboundSetEquipmentPacket` of the entity `id`'s `slots`, each with its stack, encoded.
    fn equipment_packet(mut self, id: i32, slots: List<(usize, Tag?)>) -> List<u8> {
        var worn = List<WornSlot>()
        for (slot, stack) in slots {
            worn.push(WornSlot { slot: i32.wrap(slot), stack: self.sent_stack(stack.copy()) })
        }
        return encode_play(ClientboundSetEquipment { entity_id: id, slots: WornSlots { slots: worn } })
    }

    // The level `d`'s random sequence `name`, made where it isn't, as `getRandomSequence` makes
    // it, with nothing drawn.
    fn made_sequence(mut self, d: usize, name: String) {
        var s = self.levels[d].sequences.take() else return
        let r = s.lend(name.copy(), self.levels[d].world_seed)
        s.give_back(name, r)
        self.levels[d].sequences = some(s)
    }

    // The `compostable` components of wheat seeds and beetroot seeds, which a farmer composts,
    // `WorkAtComposter.COMPOSTABLE_ITEMS`, in that order (CAL-160); none where the items can't be
    // read.
    fn composts_of(mut self) -> List<Tag?> {
        var out = List<Tag?>()
        if not self.items_ready() {
            return out
        }
        let items = self.items.take() else return out
        for name in ["minecraft:wheat_seeds", "minecraft:beetroot_seeds"] {
            var m = JavaHashMap<String, Tag>()
            m.insert(String("id"), Tag.Str(String(name)))
            m.insert(String("count"), Tag.Int(1))
            out.push(items.component(Tag.Compound(m), String("minecraft:compostable")))
        }
        self.items = some(items)
        return out
    }

    // Whether the living facts are made, from the level `d`'s facts the first time those are
    // there (CAL-155), with what tempts the animals as the world's item tags say, where it has its
    // registries (CAL-158).
    fn living_ready(mut self, d: usize) -> bool {
        if self.living_facts != none {
            return true
        }
        let shared = self.levels[d].shared_env() else return false
        let Env { facts: f, .. } = shared.value
        var lf = LivingFacts.new(f)
        if let r = self.world.registries {
            lf.tempting = temptations_of(r.value)
            lf.damage = damage_types_of(r.value)
            lf.swords = item_tag_names(r.value, "swords")
            lf.spears = item_tag_names(r.value, "spears")
            lf.villager_picks_up = item_tag_names(r.value, "villager_picks_up")
            lf.plantable = plantable_of(r.value, f)
            lf.skeleton_weapons = item_tag_names(r.value, "skeleton_preferred_weapons")
        }
        lf.composts = self.composts_of()
        self.living_facts = some(lf)
        return true
    }

    // The players of the level `d` an orb may follow, in `ServerLevel.players()`'s order, the
    // order they came into it (CAL-154), with the boxes of those a mob may push (CAL-156).
    fn followers(self, d: usize, lf: LivingFacts, f: Facts) -> List<Follower> {
        var order = List<(u64, usize)>()
        for slot in 0..self.connections.len() {
            if self.playing(slot) {
                if let c = self.connections[slot] {
                    // A dead player out of their level isn't among its players (D427).
                    if c.player.dim == d and not c.player.removed {
                        order.push((c.player.entered, slot))
                    }
                }
            }
        }
        order.sort()
        var out = List<Follower>()
        for (_, slot) in order {
            let c = self.connections[slot] else continue
            let pose = c.player.entity_data.number(POSE_ID)
            out.push(Follower {
                id: c.player.entity_id,
                x: c.player.x,
                y: c.player.y,
                z: c.player.z,
                eyes: f32.nearest(eye_height(pose)),
                height: f32.nearest(pose_height(pose)),
                spectator: c.player.mode == GameType.Spectator,
                dead: c.player.entity_data.float(HEALTH) <= 0.0f32,
                pushable: if self.mob_pushes(c) { self.player_pushable(c, lf, f) } else { none },
                discrete: c.player.shift,
                tempts: lf.tempting.of(stack_item(held_in(c, 0))) | lf.tempting.of(stack_item(held_in(c, 1))),
                uuid: match c.profile { some(p) => some((p.id.most, p.id.least)), none => none },
                team: self.team_name_of(c),
                friendly_fire: self.friendly_fire_of(c),
                enemy: c.player.mode != GameType.Spectator and c.player.entity_data.float(HEALTH) > 0.0f32 and not c.player.abilities.invulnerable,
                creative: c.player.mode == GameType.Creative,
                bounds: some(pose_box(pose, c.player.x, c.player.y, c.player.z)),
                masks: self.masks_of(c),
                y_rot: c.player.y_head_rot,
                x_rot: c.player.x_rot,
                disguised: stack_item(worn_in(c, 5)) == "minecraft:carved_pumpkin",
                vx: c.player.vx,
                vz: c.player.vz,
                health: c.player.entity_data.float(HEALTH),
                known_dx: c.player.known_x,
                known_dy: c.player.known_y,
                known_dz: c.player.known_z,
                sprinting: i32(c.player.entity_data.byte(SHARED_FLAGS)) & SPRINTING_FLAG != 0,
                main_hand: string_hash(stack_item(held_in(c, 0))),
                effects: effect_kinds(c.player.effects),
                invisible: i32(c.player.entity_data.byte(SHARED_FLAGS)) & INVISIBLE_FLAG != 0,
                armor_cover: armor_cover(c),
            })
        }
        return out
    }

    // An entity's sound, from its source, as `Entity.playSound` plays it.
    fn play_item_sound(mut self, d: usize, s: EntitySound) {
        if let seed = s.seed {
            self.levels[d].play_seeded(s.sound.copy(), s.x, s.y, s.z, s.source, s.volume, s.pitch, seed)
            return
        }
        self.levels[d].play_sound_from_source(s.sound.copy(), s.x, s.y, s.z, s.source, s.volume, s.pitch)
    }

    // An item gone, `ChunkMap.removeEntity`: its tracker goes, and those who saw it are told.
    fn item_gone(mut self, es: mut LevelEntities, id: i32) {
        _ = es.tracked.remove(id)
        let tr = es.trackers.remove(id) else return
        self.send_to_seen(tr.seen_by, encode_play(ClientboundRemoveEntities { entity_ids: [id] }))
    }

    // `ChunkMap.removeEntity` of the player `id` from the level `d`: they go from each tracker
    // whose entity they saw, an item's or another player's (CAL-174), which this gives, in the
    // trackers' order, for their client to be told; then their own tracker goes, and those who
    // saw them are told they're gone, `broadcastRemoved`.
    fn untrack_player(mut self, d: usize, id: i32) -> List<i32> {
        var es = self.take_entities(d)
        var out = List<i32>()
        var others = List<i32>()
        for (other, _) in es.tracked {
            if other != id {
                others.push(other)
            }
        }
        _ = es.tracked.remove(id)
        for other in others {
            if not es.trackers.contains(other) {
                continue
            }
            var kept = List<i32>()
            var saw = false
            for p in es.trackers[other].seen_by {
                if p == id {
                    saw = true
                } else {
                    kept.push(p)
                }
            }
            if saw {
                es.trackers[other].seen_by = kept
                out.push(other)
            }
        }
        let theirs = es.trackers.remove(id)
        self.put_entities(d, es)
        if let tr = theirs {
            self.send_to_seen(tr.seen_by, encode_play(ClientboundRemoveEntities { entity_ids: [id] }))
        }
        return out
    }

    // `ChunkMap.move`'s look, for each tracker of the player's level in their order, at whether
    // they see its entity, another player's too (CAL-174); their own, where `mine`, looks at which
    // of the level's players see them, as a move has it, where coming into the level their own
    // looked before.
    fn items_see(mut self, con: mut Connection, mine: bool) {
        let d = con.player.dim
        var es = self.take_entities(d)
        var ids = List<(i32, bool)>()
        for (id, player) in es.tracked {
            ids.push((id, player))
        }
        for (id, player) in ids {
            var tr = es.trackers.remove(id) else continue
            if player {
                if id == con.player.entity_id {
                    if mine {
                        for slot in self.level_slots(d) {
                            var viewer = self.connections[slot].take() else continue
                            self.player_seen(mut tr, con, mut viewer)
                            self.connections[slot] = some(viewer)
                        }
                    }
                } else if let slot = self.slot_of_entity(id) {
                    if let target = self.connections[slot].take() {
                        self.player_seen(mut tr, target, mut con)
                        self.connections[slot] = some(target)
                    }
                }
            } else if let e = es.list.lend(id) {
                self.item_seen(mut tr, e, mut con)
                es.list.give_back(e)
            } else if let o = es.list.lend_orb(id) {
                self.orb_seen(mut tr, o, mut con)
                es.list.give_back_orb(o)
            } else if let a = es.list.lend_stand(id) {
                self.living_seen(mut tr, a.living, mut con)
                es.list.give_back_stand(a)
            } else if let mb = es.list.lend_mob(id) {
                self.living_seen(mut tr, mb.living, mut con)
                es.list.give_back_mob(mb)
            } else if let a = es.list.lend_arrow(id) {
                let owner = self.owner_among(d, a.owner, es.list, con)
                self.arrow_seen(mut tr, a, owner, mut con)
                es.list.give_back_arrow(a)
            } else if let thrown = es.list.lend_thrown(id) {
                let owner = self.owner_among(d, thrown.owner, es.list, con)
                self.thrown_seen(mut tr, thrown, owner, mut con)
                es.list.give_back_thrown(thrown)
            } else if let cloud = es.list.lend_cloud(id) {
                self.cloud_seen(mut tr, cloud, mut con)
                es.list.give_back_cloud(cloud)
            } else if let crystal = es.list.lend_crystal(id) {
                self.crystal_seen(mut tr, crystal, mut con)
                es.list.give_back_crystal(crystal)
            } else if let eye = es.list.lend_eye(id) {
                self.eye_seen(mut tr, eye, mut con)
                es.list.give_back_eye(eye)
            } else if let fireball = es.list.lend_fireball(id) {
                let owner = self.owner_among(d, fireball.owner, es.list, con)
                self.fireball_seen(mut tr, fireball, owner, mut con)
                es.list.give_back_fireball(fireball)
            }
            es.trackers.insert(id, tr)
        }
        self.put_entities(d, es)
    }

    // `updatePlayer` of the item `id`'s tracker in the level `d` for the player `con`.
    fn item_sees(mut self, d: usize, id: i32, con: mut Connection) {
        var es = self.take_entities(d)
        if let kept = es.trackers.remove(id) {
            var tr = kept
            if let e = es.list.lend(id) {
                self.item_seen(mut tr, e, mut con)
                es.list.give_back(e)
            } else if let o = es.list.lend_orb(id) {
                self.orb_seen(mut tr, o, mut con)
                es.list.give_back_orb(o)
            } else if let a = es.list.lend_stand(id) {
                self.living_seen(mut tr, a.living, mut con)
                es.list.give_back_stand(a)
            } else if let mb = es.list.lend_mob(id) {
                self.living_seen(mut tr, mb.living, mut con)
                es.list.give_back_mob(mb)
            } else if let a = es.list.lend_arrow(id) {
                let owner = self.owner_among(d, a.owner, es.list, con)
                self.arrow_seen(mut tr, a, owner, mut con)
                es.list.give_back_arrow(a)
            } else if let thrown = es.list.lend_thrown(id) {
                let owner = self.owner_among(d, thrown.owner, es.list, con)
                self.thrown_seen(mut tr, thrown, owner, mut con)
                es.list.give_back_thrown(thrown)
            } else if let cloud = es.list.lend_cloud(id) {
                self.cloud_seen(mut tr, cloud, mut con)
                es.list.give_back_cloud(cloud)
            } else if let crystal = es.list.lend_crystal(id) {
                self.crystal_seen(mut tr, crystal, mut con)
                es.list.give_back_crystal(crystal)
            } else if let eye = es.list.lend_eye(id) {
                self.eye_seen(mut tr, eye, mut con)
                es.list.give_back_eye(eye)
            } else if let fireball = es.list.lend_fireball(id) {
                let owner = self.owner_among(d, fireball.owner, es.list, con)
                self.fireball_seen(mut tr, fireball, owner, mut con)
                es.list.give_back_fireball(fireball)
            }
            es.trackers.insert(id, tr)
        }
        self.put_entities(d, es)
    }

    // `TrackedEntity.updatePlayer` (CAL-148): the player sees the item where it's no further
    // across than the lesser of its tracking range, 96 blocks, and their view, and its chunk's
    // one their client has; coming to see it, they're sent it, `addPairing`, and ceasing to,
    // told it's gone, `removePairing`.
    fn item_seen(mut self, tr: mut Tracker, e: ItemEntity, con: mut Connection) {
        if self.comes_to_see(mut tr, e.body, mut con) {
            self.pair_item(mut con, tr, e)
        }
    }

    // The same for an orb (CAL-154), whose tracking range is an item's.
    fn orb_seen(mut self, tr: mut Tracker, o: ExperienceOrb, con: mut Connection) {
        if self.comes_to_see(mut tr, o.body, mut con) {
            self.pair_orb(mut con, tr, o)
        }
    }

    // The same for a living entity, an armor stand or a mob (CAL-155, CAL-156), seen from its
    // tracker's range, 10 chunks for each kind Calcite has.
    fn living_seen(mut self, tr: mut Tracker, l: Living, con: mut Connection) {
        if self.comes_to_see(mut tr, l.body, mut con) {
            self.pair_living(mut con, tr, l)
        }
    }

    // `updatePlayer`'s look for the entity of `b`: whether the player comes to see it now, for
    // the caller to pair it, no further across than the lesser of its tracking range and their
    // view; one who ceases to is told it's gone.
    fn comes_to_see(mut self, tr: mut Tracker, b: Body, con: mut Connection) -> bool {
        return self.comes_to_see_if(mut tr, b, mut con, true)
    }

    // `comes_to_see`, where the entity lets the player see it, `shown`, `broadcastToPlayer`
    // (CAL-174).
    fn comes_to_see_if(mut self, tr: mut Tracker, b: Body, con: mut Connection, shown: bool) -> bool {
        if not in_world(con) {
            return false
        }
        let pid = con.player.entity_id
        let dx = con.player.x - b.x
        let dz = con.player.z - b.z
        let range = f64(min(tr.range * 16, con.player.view * 16))
        let chunk = ChunkPos.containing(b.x, b.z)
        let visible = dx * dx + dz * dz <= range * range and shown and self.chunk_tracked(con, chunk)
        var at: usize? = none
        for i in 0..tr.seen_by.len() {
            if tr.seen_by[i] == pid {
                at = some(i)
            }
        }
        if visible {
            if at == none {
                tr.seen_by.push(pid)
                return true
            }
        } else if let i = at {
            _ = tr.seen_by.swap_remove(i)
            self.send(mut con, ClientboundRemoveEntities { entity_ids: [b.id] }, State.Play)
        }
        return false
    }

    // The display name of what's held, `held`, for a death message's `.item`, where it has a custom
    // name, `ItemStack.getDisplayName` (D448): `item_display_name` of its custom name, its rarity
    // and whether it's enchanted, as its components or its item's have them. A custom name that
    // isn't a text component, which its codec wouldn't have read, names nothing.
    fn weapon_name(self, held: Tag?) -> Component? {
        let items = self.items else return none
        return named_weapon(held, items)
    }

    // `isChunkTracked` for what pairs with the player: the chunk's in their view and isn't waiting
    // to be sent. Vanilla's sender has a chunk wait only once it's ready to send, `getChunkToSend`,
    // marking it as their view takes it in or as it comes to be ready, `onChunkReadyToSend`, so
    // one in their view that isn't ready counts: a quick respawn, whose chunks dropped as the dead
    // player left, pairs the items in them at once, before the chunks are sent (D446). One that
    // was ready and stopped being before it was sent still waits in vanilla's, where it counts
    // here. Past where tickets reach, a chunk counts once it's sent.
    fn chunk_tracked(self, con: Connection, pos: ChunkPos) -> bool {
        if con.player.sender.has(pos) {
            return true
        }
        if not con.player.sender.sees(pos) or not con.player.sender.near(pos) {
            return false
        }
        // A chunk whose generation's entities come in as it comes to be full isn't ready yet in
        // vanilla, whatever Calcite's ticking has of it (D589).
        if self.coming_full == some((con.player.dim, pos.pack())) {
            return true
        }
        return not self.levels[con.player.dim].sendable(pos)
    }

    // `addPairing`: the item as a bundle, `add_entity` from its tracker and its stack as its data
    // was last sent, `trackedDataValues`.
    fn pair_item(mut self, con: mut Connection, tr: Tracker, e: ItemEntity) {
        let item_type = self.item_type()
        let body = tr.add_entity_body(e.body, item_type)
        let flags: i8? = if tr.flags != 0i8 { some(tr.flags) } else { none }
        let data = self.thing_data(flags, some(tr.data.copy()))
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
        self.send(mut con, ClientboundAddEntity { entity_id: e.body.id, body: body }, State.Play)
        self.send(mut con, ClientboundSetEntityData { entity_id: e.body.id, items: data }, State.Play)
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
    }

    // `addPairing` of an orb: its `add_entity` from its tracker, then its flags and value, those
    // that aren't their defaults, 0, which `getNonDefaultValues` leaves out (CAL-154, D435).
    fn pair_orb(mut self, con: mut Connection, tr: Tracker, o: ExperienceOrb) {
        let orb_type = self.entity_type("minecraft:experience_orb")
        let body = tr.add_entity_body(o.body, orb_type)
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
        self.send(mut con, ClientboundAddEntity { entity_id: o.body.id, body: body }, State.Play)
        let flags: i8? = if tr.flags != 0i8 { some(tr.flags) } else { none }
        let value: Tag? = if o.value != 0 { some(Tag.Int(o.value)) } else { none }
        if flags != none or value != none {
            let data = self.thing_data(flags, value)
            self.send(mut con, ClientboundSetEntityData { entity_id: o.body.id, items: data }, State.Play)
        }
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
    }

    // The same for an arrow (CAL-159), seen from its tracker's range, 4 chunks, its owner's ID
    // `owner`.
    fn arrow_seen(mut self, tr: mut Tracker, a: Arrow, owner: i32, con: mut Connection) {
        if self.comes_to_see(mut tr, a.body, mut con) {
            self.pair_arrow(mut con, tr, a, owner)
        }
    }

    // `addPairing` of an arrow (CAL-159): its `add_entity` from its tracker, with its owner's
    // entity ID, `owner`, as its data, `Projectile.getAddEntityPacket`, then its values as they
    // were last sent where any aren't their defaults, `trackedDataValues`.
    fn pair_arrow(mut self, con: mut Connection, tr: Tracker, a: Arrow, owner: i32) {
        let arrow_type = self.entity_type("minecraft:arrow")
        let body = tr.add_entity_with(a.body, arrow_type, owner)
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
        self.send(mut con, ClientboundAddEntity { entity_id: a.body.id, body: body }, State.Play)
        if let values = tr.values {
            self.send(mut con, ClientboundSetEntityData { entity_id: a.body.id, items: values.copy() }, State.Play)
        }
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
    }

    // The same for a thrown potion (D527), seen from its tracker's range, 4 chunks, its owner's ID
    // `owner`.
    fn thrown_seen(mut self, tr: mut Tracker, p: ThrownItem, owner: i32, con: mut Connection) {
        if self.comes_to_see(mut tr, p.body, mut con) {
            self.pair_thrown(mut con, tr, p, owner)
        }
    }

    // `addPairing` of a thrown potion (D527): its `add_entity` from its tracker, with its owner's
    // entity ID, `owner`, as its data, then its values as they were last sent, its stack among
    // them, `trackedDataValues`.
    fn pair_thrown(mut self, con: mut Connection, tr: Tracker, p: ThrownItem, owner: i32) {
        let kind = self.entity_type(p.type_name())
        let body = tr.add_entity_with(p.body, kind, owner)
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
        self.send(mut con, ClientboundAddEntity { entity_id: p.body.id, body: body }, State.Play)
        if let values = tr.values {
            self.send(mut con, ClientboundSetEntityData { entity_id: p.body.id, items: values.copy() }, State.Play)
        }
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
    }

    // The same for an area effect cloud (D529), seen from its tracker's range, 10 chunks.
    fn cloud_seen(mut self, tr: mut Tracker, c: EffectCloud, con: mut Connection) {
        if self.comes_to_see(mut tr, c.body, mut con) {
            self.pair_cloud(mut con, tr, c)
        }
    }

    // `updatePlayer` of an eye of ender's tracker for the player `con` (D598).
    fn eye_seen(mut self, tr: mut Tracker, e: EyeOfEnder, con: mut Connection) {
        if self.comes_to_see(mut tr, e.body, mut con) {
            self.pair_eye(mut con, tr, e)
        }
    }

    // `addPairing` of an eye of ender (D598): its `add_entity` from its tracker, with no data,
    // then its values as they were last sent, its stack among them, `trackedDataValues`.
    fn pair_eye(mut self, con: mut Connection, tr: Tracker, e: EyeOfEnder) {
        let kind = self.entity_type("minecraft:eye_of_ender")
        let body = tr.add_entity_body(e.body, kind)
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
        self.send(mut con, ClientboundAddEntity { entity_id: e.body.id, body: body }, State.Play)
        if let values = tr.values {
            self.send(mut con, ClientboundSetEntityData { entity_id: e.body.id, items: values.copy() }, State.Play)
        }
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
    }

    // `updatePlayer` of a dragon fireball's tracker for the player `con` (D618), its owner's ID
    // `owner`, as a thrown potion's.
    fn fireball_seen(mut self, tr: mut Tracker, b: DragonFireball, owner: i32, con: mut Connection) {
        if self.comes_to_see(mut tr, b.body, mut con) {
            self.pair_fireball(mut con, tr, b, owner)
        }
    }

    // `addPairing` of a dragon fireball (D618): its `add_entity` from its tracker, with its
    // owner's entity ID, `owner`, as its data, `Projectile.getAddEntityPacket`, then its values as
    // they were last sent where any aren't their defaults, `trackedDataValues`.
    fn pair_fireball(mut self, con: mut Connection, tr: Tracker, b: DragonFireball, owner: i32) {
        let kind = self.entity_type("minecraft:dragon_fireball")
        let body = tr.add_entity_with(b.body, kind, owner)
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
        self.send(mut con, ClientboundAddEntity { entity_id: b.body.id, body: body }, State.Play)
        if let values = tr.values {
            self.send(mut con, ClientboundSetEntityData { entity_id: b.body.id, items: values.copy() }, State.Play)
        }
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
    }

    // `updatePlayer` of an end crystal's tracker for the player `con` (D589).
    fn crystal_seen(mut self, tr: mut Tracker, c: EndCrystal, con: mut Connection) {
        if self.comes_to_see(mut tr, c.body, mut con) {
            self.pair_crystal(mut con, tr, c)
        }
    }

    // `addPairing` of an end crystal (D589), as a cloud's: its `add_entity` from its tracker, with
    // no data, then its values as they were last sent where any aren't their defaults.
    fn pair_crystal(mut self, con: mut Connection, tr: Tracker, c: EndCrystal) {
        let kind = self.entity_type("minecraft:end_crystal")
        let body = tr.add_entity_body(c.body, kind)
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
        self.send(mut con, ClientboundAddEntity { entity_id: c.body.id, body: body }, State.Play)
        if let values = tr.values {
            self.send(mut con, ClientboundSetEntityData { entity_id: c.body.id, items: values.copy() }, State.Play)
        }
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
    }

    // `addPairing` of an area effect cloud (D529): its `add_entity` from its tracker, with no
    // data, then its values as they were last sent where any aren't their defaults,
    // `trackedDataValues`, its particle always among them.
    fn pair_cloud(mut self, con: mut Connection, tr: Tracker, c: EffectCloud) {
        let kind = self.entity_type("minecraft:area_effect_cloud")
        let body = tr.add_entity_body(c.body, kind)
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
        self.send(mut con, ClientboundAddEntity { entity_id: c.body.id, body: body }, State.Play)
        if let values = tr.values {
            self.send(mut con, ClientboundSetEntityData { entity_id: c.body.id, items: values.copy() }, State.Play)
        }
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
    }

    // A thrown potion's values as its packets send them (D527): `base`, its values but its stack,
    // as they're packed, then its stack, `DATA_ITEM_STACK`, as its codecs send stacks, then the
    // end.
    fn thrown_values(mut self, base: List<u8>?, stack: Tag) -> List<u8> {
        var w = Writer.new()
        if let b = base {
            for k in 0..b.len() - 1 {
                w.u8(b[k])
            }
        }
        w.u8(THROWN_ITEM)
        w.varint(ITEM_STACK)
        let sent = self.sent_stack(some(stack.copy()))
        sent.write(mut w)
        w.u8(255u8)
        return w.into_bytes()
    }

    // A thrown potion's values that changed, `packDirty` (D527): `base`, its others that did, with
    // its stack after them where it's `set`.
    fn thrown_dirty(mut self, base: List<u8>?, stack: Tag, set: bool) -> List<u8> {
        if set {
            return self.thrown_values(base, stack)
        }
        return base.copy() ?? [255u8]
    }

    // The entity ID of an arrow's owner, of the UUID `uuid`, in the level `d`, `getOwner`, as its
    // `add_entity` sends it, 0 for none (CAL-159): the player `con`, out of the connections, or
    // the one throwing it, `thrower`, or another player in any level (D579), or one of `list`.
    fn owner_among(self, d: usize, uuid: (i64, i64)?, list: Entities, con: Connection) -> i32 {
        let (most, least) = uuid else return 0
        if let p = con.profile {
            if p.id.most == most and p.id.least == least and con.player.dim == d and in_world(con) {
                return con.player.entity_id
            }
        }
        // The player throwing it, out of the connections as they throw (D579).
        if let (u, id) = self.thrower {
            if u == (most, least) {
                return id
            }
        }
        // A player in any level, as `getOwner` finds its owner, `getEntityInAnyDimension` (D579).
        for slot in 0..self.connections.len() {
            if let c = self.connections[slot] {
                if let p = c.profile {
                    if p.id.most == most and p.id.least == least and in_world(c) {
                        return c.player.entity_id
                    }
                }
            }
        }
        return list.id_with_uuid((most, least)) ?? 0
    }

    // `owner_among` the level `d`'s entities, taken for it.
    fn arrow_owner(mut self, d: usize, uuid: (i64, i64)?, con: Connection) -> i32 {
        let es = self.take_entities(d)
        let id = self.owner_among(d, uuid, es.list, con)
        self.put_entities(d, es)
        return id
    }

    // `addPairing` of a living entity, an armor stand or a mob (CAL-155, CAL-156): its
    // `add_entity` from its tracker, its values as they were last sent where any aren't their
    // defaults, `trackedDataValues`, and its attributes made that are sent to clients,
    // `getSyncableAttributes`. Its equipment isn't sent yet.
    fn pair_living(mut self, con: mut Connection, tr: Tracker, l: Living) {
        let id = l.body.id
        let body = tr.add_entity_body(l.body, i32.wrap(l.kind))
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
        self.send(mut con, ClientboundAddEntity { entity_id: id, body: body }, State.Play)
        if let values = tr.values {
            self.send(mut con, ClientboundSetEntityData { entity_id: id, items: values.copy() }, State.Play)
        }
        let attributes = l.attributes.syncable()
        if not attributes.is_empty() {
            self.send(mut con, attributes_packet(id, attributes), State.Play)
        }
        var worn = List<WornSlot>()
        for slot in 0..l.equipment.len() {
            if let stack = l.equipment[slot] {
                worn.push(WornSlot { slot: i32.wrap(slot), stack: self.sent_stack(some(stack.copy())) })
            }
        }
        if not worn.is_empty() {
            self.send(mut con, ClientboundSetEquipment { entity_id: id, slots: WornSlots { slots: worn } }, State.Play)
        }
        self.send(mut con, ClientboundBundleDelimiter {}, State.Play)
    }

    // The type's ID of the entity `tag` keeps, where natural spawning counts it (CAL-156): one
    // that needn't stay, `PersistenceRequired`, nor came from a bucket, `FromBucket`, which is how
    // the types that keep themselves, `requiresCustomPersistence`, mostly do; the caller leaves
    // out those of `MISC`.
    fn kept_type(mut self, tag: Tag) -> i32? {
        let Tag.Compound(m) = tag else return none
        if not m.contains("id") or bool_or(m, "PersistenceRequired") or bool_or(m, "FromBucket") {
            return none
        }
        let Tag.Str(name) = m["id"] else return none
        if not self.items_ready() {
            return none
        }
        let codecs = self.items.take() else return none
        let id = codecs.builtin_id("entity_type", name.copy())
        self.items = some(codecs)
        return id
    }

    // The item entity type's ID in the `entity_type` registry.
    fn item_type(mut self) -> i32 {
        return self.entity_type("minecraft:item")
    }

    // The entity type `name`'s ID in the `entity_type` registry.
    fn entity_type(mut self, name: str) -> i32 {
        if not self.items_ready() {
            return 0
        }
        let codecs = self.items.take() else return 0
        let id = codecs.builtin_id("entity_type", String(name)) ?? 0
        self.items = some(codecs)
        return id
    }

    // An item's or orb's data as `ClientboundSetEntityDataPacket` packs it, those of its values
    // given, in their order (D435): its shared flags, `DATA_SHARED_FLAGS_ID`, 0, of the byte
    // serializer, 0; then an orb's value, `DATA_VALUE`, 8, an int, 1, or an item's stack,
    // `DATA_ITEM`, 8, of the item stack serializer, 7.
    fn thing_data(mut self, flags: i8?, data: Tag?) -> List<u8> {
        var w = Writer.new()
        if let b = flags {
            w.u8(0u8)
            w.varint(0)
            w.i8(b)
        }
        match data {
            some(Tag.Int(value)) => {
                w.u8(8u8)
                w.varint(1)
                w.varint(value)
            },
            some(stack) => {
                w.u8(8u8)
                w.varint(7)
                let sent = self.sent_stack(some(stack.copy()))
                sent.write(mut w)
            },
            none => {},
        }
        w.u8(255u8)
        return w.into_bytes()
    }

    // What an item's or orb's tracker sends, as its packet: an orb's data its value, an int, and an
    // item's its stack.
    fn sent_packet(mut self, id: i32, s: Sent) -> List<u8> {
        if let Sent.Data(flags, data) = s {
            let packed = self.thing_data(flags, data)
            return encode_play(ClientboundSetEntityData { entity_id: id, items: packed })
        }
        return match s {
            Sent.Motion(x, y, z) => encode_play(ClientboundSetEntityMotion { entity_id: id, motion: lp_vec3_bytes(x, y, z) }),
            Sent.Velocity(x, y, z) => encode_play(ClientboundSetEntityMotion { entity_id: id, motion: lp_vec3_bytes(x, y, z) }),
            Sent.Pos(a, b, c, ground) => encode_play(ClientboundMoveEntityPos { entity_id: id, properties: if ground { 1 } else { 0 }, dx: a, dy: b, dz: c }),
            Sent.PosRot(a, b, c, yr, xr, ground) => encode_play(ClientboundMoveEntityPosRot { entity_id: id, properties: if ground { 1 } else { 0 }, dx: a, dy: b, dz: c, y_rot: yr, x_rot: xr }),
            Sent.Rot(yr, xr, ground) => encode_play(ClientboundMoveEntityRot { entity_id: id, on_ground: ground, y_rot: yr, x_rot: xr }),
            Sent.Sync(x, y, z, yr, xr, ground) => encode_play(ClientboundEntityPositionSync { entity_id: id, kind: 0, x: x, y: y, z: z, y_rot: yr, x_rot: xr, on_ground: ground }),
            Sent.Head(h) => encode_play(ClientboundRotateHead { entity_id: id, y_head_rot: h }),
            Sent.StepsPos(steps, ground) => encode_play(ClientboundMoveEntitySteps { entity_id: id, properties: (if ground { 1 } else { 0 }) | i32.wrap(steps.len()) << 1, steps: delta_bytes(steps) }),
            Sent.StepsPosRot(steps, yr, xr, ground) => {
                var w = Writer.new()
                w.raw(delta_bytes(steps))
                w.i8(yr)
                w.i8(xr)
                encode_play(ClientboundMoveEntityStepsRot { entity_id: id, properties: (if ground { 1 } else { 0 }) | i32.wrap(steps.len()) << 1, body: w.into_bytes() })
            },
            Sent.StepsSync(path, yr, xr, ground) => {
                var w = Writer.new()
                w.raw(path_bytes(path))
                w.f32(yr)
                w.f32(xr)
                w.bool(ground)
                encode_play(ClientboundEntityPathSync { entity_id: id, body: w.into_bytes() })
            },
            Sent.Data(_, _) => List<u8>(),
            Sent.Dirty => List<u8>(),
        }
    }

    // Sends `packet` to the players who see an item, by their entity IDs, but one taken out of
    // the connections.
    fn send_to_seen(mut self, seen: List<i32>, packet: List<u8>) {
        for p in seen {
            let slot = self.slot_of_entity(p) else continue
            var con = self.connections[slot].take() else continue
            if not con.closing {
                self.send_bytes(mut con, packet.copy())
            }
            self.connections[slot] = some(con)
        }
    }

    // `send_to_seen`, while the player `con` is taken out of the connections.
    fn send_to_seen_with(mut self, seen: List<i32>, packet: List<u8>, con: mut Connection) {
        for p in seen {
            if p == con.player.entity_id {
                if not con.closing {
                    self.send_bytes(mut con, packet.copy())
                }
                continue
            }
            let slot = self.slot_of_entity(p) else continue
            var other = self.connections[slot].take() else continue
            if not other.closing {
                self.send_bytes(mut other, packet.copy())
            }
            self.connections[slot] = some(other)
        }
    }

    // The slot of the player in play whose entity is `id`.
    fn slot_of_entity(self, id: i32) -> usize? {
        for slot in 0..self.connections.len() {
            if let c = self.connections[slot] {
                if in_world(c) and c.player.entity_id == id {
                    return some(slot)
                }
            }
        }
        return none
    }

    // The slots of the players in the level `d`, in the order it has them, `players()`.
    fn level_slots(self, d: usize) -> List<usize> {
        var order = List<(u64, usize)>()
        for slot in 0..self.connections.len() {
            if self.playing(slot) {
                if let c = self.connections[slot] {
                    if c.player.dim == d {
                        order.push((c.player.entered, slot))
                    }
                }
            }
        }
        order.sort()
        var out = List<usize>()
        for (_, slot) in order {
            out.push(slot)
        }
        return out
    }

    // The level `d`'s items and trackers, taken out to be worked on, for `put_entities` to put
    // back.
    fn take_entities(mut self, d: usize) -> LevelEntities {
        while self.entities.len() <= d {
            self.entities.push(some(LevelEntities()))
        }
        let es = self.entities[d].take() else panic("the entities of level {d} are taken already")
        return es
    }

    fn put_entities(mut self, d: usize, es: own LevelEntities) {
        self.entities[d] = some(es)
    }

    // The world border of the level `d` as it is this tick, its west, north, east and south edges,
    // `getMinX`, `getMinZ`, `getMaxX` and `getMaxZ` (CAL-159).
    fn border_of(self, d: usize) -> (f64, f64, f64, f64) {
        let b = self.world.dims[d].border
        return (b.min_x(), b.min_z(), b.max_x(), b.max_z())
    }

    // The seed of a new entity's random: with `level-random-seed`, its ID mixed with it, as the
    // rig's agent seeds vanilla's; otherwise the next of the server's own (CAL-148).
    fn entity_seed(mut self, id: i32) -> i64 {
        let (seed, seeds) = seeded(self.entity_base, self.entity_seeds, self.now, id)
        self.entity_seeds = seeds
        return seed
    }

    // `createItemStackToDrop(stack, false, thrown)` for the player `p` (CAL-148): an item at
    // their feet across and 0.3 below their eyes, which can't be picked up for 40 ticks,
    // thrown by them where `thrown`, given `random`'s motion the way they face, a little to one
    // side and up; nothing for nothing.
    fn made_drop(mut self, p: Player, random: mut LegacyRandom, thrower: (i64, i64)?, stack: Tag, thrown: bool) -> ItemEntity? {
        if count_of(stack) <= 0 {
            return none
        }
        self.entity_ids += 1
        let id = self.entity_ids
        let y = p.y + eye_height(p.entity_data.number(POSE_ID)) - f64(0.3f32)
        let seed = self.entity_seed(id)
        var e = ItemEntity.new(id, seed, p.x, y, p.z, stack.copy())
        e.pickup_delay = 40
        if thrown {
            e.thrower = thrower
        }
        let rad = 0.017453292f32
        let sin_x = table_sin(f64(p.x_rot * rad))
        let cos_x = table_cos(f64(p.x_rot * rad))
        let sin_y = table_sin(f64(p.y_rot * rad))
        let cos_y = table_cos(f64(p.y_rot * rad))
        let dir = random.next_float() * 6.2831855f32
        let pow2 = 0.02f32 * random.next_float()
        e.body.vx = f64(-sin_y * cos_x * 0.3f32) + strict_cos(f64(dir)) * f64(pow2)
        let a = random.next_float()
        let b = random.next_float()
        e.body.vy = f64(-sin_x * 0.3f32 + 0.1f32 + (a - b) * 0.1f32)
        e.body.vz = f64(cos_y * cos_x * 0.3f32) + strict_sin(f64(dir)) * f64(pow2)
        return some(e)
    }

    // `LivingEntity.drop` for the player `con`, out of the connections: their main hand swings,
    // `SwingAnimation.DEFAULT`, for those who see them, and for them too where the drop's the
    // server's `alone`, `Prediction.SERVER_ONLY`, not one their client predicts (D521); then the
    // item's made and comes into their level.
    fn drop_item(mut self, con: mut Connection, stack: Tag, thrown: bool, alone: bool) {
        self.drop_for(mut con, stack, thrown, alone, false)
    }

    // `drop_item`, the item, where it's `theirs`, for the player alone to pick up at once,
    // `setNoPickUpDelay` and `setTarget`, as what an advancement's loot gave that didn't go in
    // their inventory is (CAL-164).
    fn drop_for(mut self, con: mut Connection, stack: Tag, thrown: bool, alone: bool, theirs: bool) {
        // A dead player out of their level has no tracker, which `swing` sends through, so
        // theirs reaches no one, not even them, as what their menus held drops (D576).
        if not con.player.removed {
            let swung = encode_play(ClientboundSwingAnimation { entity_id: con.player.entity_id, hand: 0, kind: 1, duration: 6 })
            if alone {
                self.send_seen_and_self(mut con, swung)
            } else {
                let seen = self.seers_of(con)
                self.send_to_seen(seen, swung)
            }
        }
        self.drop_from(mut con, stack, thrown, if theirs { DROP_THEIRS } else { DROP_ANY })
    }

    // `createItemStackToDrop(stack, false, thrown)` for the player `con`, out of the connections,
    // then `addFreshEntity`: the item as it's made, `DROP_ANY`; for them alone to pick up at once,
    // `DROP_THEIRS`; or a fake one, `DROP_FAKE`, which no one can pick up and goes after a tick,
    // `makeFakeItem` (CAL-165).
    fn drop_from(mut self, con: mut Connection, stack: Tag, thrown: bool, kind: i32) {
        var thrower: (i64, i64)? = none
        if let p = con.profile {
            thrower = some((p.id.most, p.id.least))
        }
        var random = con.player.random.take() ?? LegacyRandom.new(self.entity_seed(con.player.entity_id))
        let item = stack_item(some(stack.copy()))
        let count = count_of(stack.copy())
        let made = self.made_drop(con.player, mut random, thrower, stack, thrown)
        con.player.random = some(random)
        let dropped = made else return
        var e = dropped
        if kind == DROP_THEIRS {
            e.pickup_delay = 0
            e.target = thrower
        } else if kind == DROP_FAKE {
            e.pickup_delay = INFINITE_PICKUP_DELAY
            e.age = 5999
        }
        let id = e.body.id
        let d = con.player.dim
        self.add_item(d, e, some(con.player.entity_id))
        // The pairing with `con`, who's out of the connections, unless they're dead and out of
        // their level (D427).
        if not con.player.removed {
            self.item_sees(d, id, mut con)
        }
        // `ServerPlayer.drop` of what's thrown from their hand: `ITEM_DROPPED` of it, by how many,
        // and `DROP` (CAL-164).
        if thrown {
            con.player.stats.award(String("minecraft:dropped"), item, count)
            con.player.stats.award_custom("drop", 1)
        }
    }

    /// Reads and writes each dimension's entity chunks in its folder in `folders`, in the world's
    /// order, each on a thread of its own that starts with its first chunk (CAL-148). Replaying,
    /// there's no folder, and `folders` is empty: the chunks the recording read come from its log,
    /// if it opened its folders, which the link says. Without either, as a test's world, there's
    /// nothing saved, and nothing's saved.
    pub fn open_entities(mut self, folders: List<String>) {
        var opened = false
        for d in 0..folders.len() {
            if d >= self.world.dims.len() {
                break
            }
            var compression = Compression.Deflate
            if let c = self.world.dims[d].context {
                compression = c.compression
            }
            match self.link.waker() {
                ok(waker) => {
                    var es = self.take_entities(d)
                    es.jobs = some(EntityJobs.new(folders[d].copy(), compression, waker))
                    self.put_entities(d, es)
                    opened = true
                },
                err(_) => {
                    self.logs.push(Entry.error("Can't read the world's entities: there's nothing to wake the server's poll with"))
                    break
                },
            }
        }
        self.entities_logged = self.link.entity_folders(opened) and self.link.replaying()
    }

    /// Reads and writes each dimension's points of interest in its folder in `folders`, in the
    /// world's order, each on a thread of its own that starts with its first chunk, as each
    /// level's `PoiManager` reads and writes them (CAL-160). Replaying, there's no folder: the
    /// chunks the recording read come from its log, if it opened its entities' folders, as it
    /// opened these with them.
    pub fn open_pois(mut self, folders: List<String>) {
        var format: PoiFormat? = none
        var problem: String? = none
        if let shared = self.world.registries {
            match PoiFormat.new(shared.value) {
                ok(f) => format = some(f),
                err(e) => problem = some(e),
            }
        }
        if let e = problem {
            self.logs.push(Entry.error("Can't read the world's points of interest: {e}"))
        }
        let readable = match format {
            some(_) => true,
            none => false,
        }
        for d in 0..self.levels.len() {
            var jobs: EntityJobs? = none
            if d < folders.len() and readable and d < self.world.dims.len() {
                var compression = Compression.Deflate
                if let c = self.world.dims[d].context {
                    compression = c.compression
                }
                match self.link.waker() {
                    ok(waker) => jobs = some(EntityJobs.new(folders[d].copy(), compression, waker)),
                    err(_) => {},
                }
            }
            self.levels[d].open_pois(jobs, self.entities_logged, format.copy())
        }
    }

    // Takes in what each dimension's `poi` folder's thread has done, recording what it read, as
    // the server's loop hands it over (CAL-160).
    fn pois_read(mut self) {
        for d in 0..self.levels.len() {
            var done = self.levels[d].take_poi_done()
            var any = false
            while let x = done.pop_first() {
                match x {
                    EntityDone.Read(pos, io, got) => {
                        self.link.pois_read(d, pos, io, got)
                        _ = self.levels[d].pois_read(pos, io, got)
                        self.level_lines()
                        any = true
                    },
                    EntityDone.Wrote(lines) => {
                        self.link.saved(lines)
                        for e in lines {
                            self.logs.push(e.copy())
                        }
                    },
                    EntityDone.Closed(lines) => {
                        for e in lines {
                            self.logs.push(e.copy())
                        }
                    },
                }
            }
            if any {
                self.levels[d].dispatch()
            }
        }
    }

    // Takes in what each dimension's entities' IO thread has done, recording what it read, as
    // the server's loop hands it over (CAL-148).
    fn entities_read(mut self) {
        for d in 0..self.entities.len() {
            var es = self.entities[d].take() else continue
            var done = Deque<EntityDone>()
            if let held = es.jobs.take() {
                var jobs = held
                done = jobs.take_done()
                es.jobs = some(jobs)
            }
            self.entities[d] = some(es)
            while let x = done.pop_first() {
                match x {
                    EntityDone.Read(pos, io, got) => {
                        // Held while the tick holds for a portal's way, till it's done (D579).
                        if self.portal_held {
                            self.reads_held.push(HeldRead { d: d, pos: pos, io: io, got: got })
                            continue
                        }
                        self.link.entities_read(d, pos, io, got)
                        _ = self.entity_chunk_read(d, pos, io, got)
                        if self.halted {
                            self.stop_entities(d)
                        }
                    },
                    EntityDone.Wrote(lines) => {
                        self.link.saved(lines)
                        for e in lines {
                            self.logs.push(e.copy())
                        }
                    },
                    EntityDone.Closed(lines) => {
                        // As the server stops, after the last read taken in.
                        for e in lines {
                            self.logs.push(e.copy())
                        }
                    },
                }
            }
        }
    }

    // What the entities' IO thread read of the entity chunk at `pos` of the level `d`, with what
    // it logged, `io`, made into its entities as `loadEntities` makes them, to come in at the
    // level's next tick (CAL-148): none for a chunk that isn't there, which is known to have none;
    // each `minecraft:item` an item, as `world.item_entity` loads it, with the next entity ID, and
    // the rest kept as they were, but those with no type, which vanilla skips. A read that
    // failed logs vanilla's lines, and the chunk waits for its entities ever after, as vanilla's
    // does. `false` if the chunk's entities weren't asked for.
    fn entity_chunk_read(mut self, d: usize, pos: ChunkPos, io: List<Entry>, got: ChunkRead) -> bool {
        let k = pos.pack()
        let es = self.take_entities(d)
        let asked = es.loads.contains(k) and not es.loads[k]
        self.put_entities(d, es)
        if not asked {
            return false
        }
        for e in io {
            self.logs.push(e.copy())
        }
        var lines = List<Entry>()
        var root: Tag? = none
        var failed: String? = none
        match got {
            ChunkRead.Absent => {},
            ChunkRead.Stored(stored) => match unpack(pos, stored, mut lines) {
                ok(some(bytes)) => match read_root(bytes) {
                    ok(tag) => root = some(tag),
                    err(e) => failed = some("{e.exception}: {e.message}"),
                },
                ok(none) => {},
                err(e) => failed = some("{e.exception}: {e.message}"),
            },
            ChunkRead.Failed(e) => failed = some("{e.exception}: {e.message}"),
        }
        if let why = failed {
            for e in lines {
                self.logs.push(e.copy())
            }
            self.logs.push(Entry.error("Failed to load entity chunk [{pos.x}, {pos.z}]: {why}"))
            self.logs.push(Entry.error("Failed to read chunk [{pos.x}, {pos.z}]: {why}"))
            return true
        }
        var entities = List<ReadEntity>()
        var nothing = true
        var compound: JavaHashMap<String, Tag>? = none
        match root {
            some(Tag.Compound(m)) => compound = some(m.copy()),
            _ => {},
        }
        if let m = compound {
            nothing = false
            let chunk = EntityChunk.read(pos, m, mut lines)
            for saved in chunk.entities {
                if let e = self.entity_from(d, saved.tag, mut lines) {
                    entities.push(e)
                }
            }
            if let line = chunk.problems.close(entity_logger()) {
                lines.push(line)
            }
        }
        for e in lines {
            self.logs.push(e.copy())
        }
        var after = self.take_entities(d)
        if nothing {
            after.empty.insert(k)
        }
        after.inbox.push(ReadEntities { pos: pos, entities: entities })
        self.put_entities(d, after)
        return true
    }

    // The entity `tag` saves, as the level `d` reads it in, `EntityType.loadEntityRecursive`
    // (D578, drawn out of `entity_chunk_read`): each kind Calcite runs with the next ID and a seed
    // from it, as its `loaded` reads it in, the rest kept as they were; none for one with no
    // type, which vanilla skips, or one that can't be read, what that logs added to `lines`.
    fn entity_from(mut self, d: usize, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> ReadEntity? {
        let codecs_ready = self.items_ready()
        var type_id = String()
        if tag.contains("id") {
            if let Tag.Str(name) = tag["id"] {
                type_id = name.copy()
            }
        }
        if type_id.is_empty() {
            lines.push(Entry.warn(String("Skipping Entity with id [invalid]")))
            return none
        }
        if type_id == "minecraft:experience_orb" {
            self.entity_ids += 1
            let id = self.entity_ids
            let seed = self.entity_seed(id)
            if let o = ExperienceOrb.loaded(id, seed, tag, mut lines) {
                return some(ReadEntity.Orb(o))
            }
            return none
        }
        if type_id == "minecraft:armor_stand" and codecs_ready and self.living_ready(d) {
            self.entity_ids += 1
            let id = self.entity_ids
            let seed = self.entity_seed(id)
            let kind = u32.wrap(self.entity_type("minecraft:armor_stand"))
            if let lf = self.living_facts {
                if let a = ArmorStand.loaded(lf, kind, id, seed, tag, mut lines) {
                    return some(ReadEntity.Stand(a))
                }
            }
            return none
        }
        if type_id == "minecraft:arrow" and codecs_ready {
            // An arrow (CAL-159), its item and weapon read with `ItemStack.CODEC`, an empty
            // or unread item an arrow, and the state it landed on with `BlockState.CODEC`.
            self.entity_ids += 1
            let id = self.entity_ids
            let seed = self.entity_seed(id)
            var item: Tag? = none
            var weapon: Tag? = none
            var state: u32? = none
            if let codecs = self.items {
                if tag.contains("item") {
                    if let stack = codecs.stack(tag["item"], true) {
                        if count_of(stack.copy()) > 0 and stack_item(some(stack.copy())) != "minecraft:air" {
                            item = some(stack)
                        }
                    }
                }
                if tag.contains("weapon") {
                    weapon = codecs.stack(tag["weapon"], true)
                }
                if tag.contains("inBlockState") {
                    state = codecs.state_of(tag["inBlockState"].copy())
                }
            }
            if let a = Arrow.loaded(id, seed, tag, item, weapon, state, mut lines) {
                return some(ReadEntity.Arrow(a))
            }
            return none
        }
        if type_id == "minecraft:area_effect_cloud" {
            // An area effect cloud (D529).
            self.entity_ids += 1
            let id = self.entity_ids
            let seed = self.entity_seed(id)
            if let c = EffectCloud.loaded(id, seed, tag, mut lines) {
                return some(ReadEntity.Cloud(c))
            }
            return none
        }
        if type_id == "minecraft:end_crystal" {
            // An end crystal (D589).
            self.entity_ids += 1
            let id = self.entity_ids
            let seed = self.entity_seed(id)
            if let c = EndCrystal.loaded(id, seed, tag, mut lines) {
                return some(ReadEntity.Crystal(c))
            }
            return none
        }
        if type_id == "minecraft:dragon_fireball" {
            // A dragon fireball (D618).
            self.entity_ids += 1
            let id = self.entity_ids
            let seed = self.entity_seed(id)
            if let b = DragonFireball.loaded(id, seed, tag, mut lines) {
                return some(ReadEntity.Fireball(b))
            }
            return none
        }
        if type_id == "minecraft:eye_of_ender" and codecs_ready {
            // An eye of ender (D598), its stack read with `ItemStack.CODEC`, an eye of ender where
            // it's empty or unread.
            self.entity_ids += 1
            let id = self.entity_ids
            let seed = self.entity_seed(id)
            var item: Tag? = none
            if let codecs = self.items {
                if tag.contains("Item") {
                    if let stack = codecs.stack(tag["Item"], true) {
                        if count_of(stack.copy()) > 0 and stack_item(some(stack.copy())) != "minecraft:air" {
                            item = some(stack)
                        }
                    }
                }
            }
            if let e = EyeOfEnder.loaded(id, seed, tag, item, mut lines) {
                return some(ReadEntity.Eye(e))
            }
            return none
        }
        if type_id == "minecraft:ender_pearl" and codecs_ready {
            // A thrown ender pearl (D579), its stack read with `ItemStack.CODEC`, an ender pearl
            // where it's empty or unread.
            self.entity_ids += 1
            let id = self.entity_ids
            let seed = self.entity_seed(id)
            var item: Tag? = none
            if let codecs = self.items {
                if tag.contains("Item") {
                    if let stack = codecs.stack(tag["Item"], true) {
                        if count_of(stack.copy()) > 0 and stack_item(some(stack.copy())) != "minecraft:air" {
                            item = some(stack)
                        }
                    }
                }
            }
            if let loaded = ThrownItem.loaded_pearl(id, seed, tag, item, mut lines) {
                // Among its owner's pearls where they're in the world, as `setOwner` registers it
                // as it's read (D580).
                var pearl = loaded
                pearl.registered = self.serial_of(pearl.owner)
                return some(ReadEntity.Thrown(pearl))
            }
            return none
        }
        let lingering = type_id == "minecraft:lingering_potion"
        if (type_id == "minecraft:splash_potion" or lingering) and codecs_ready {
            // A thrown splash potion (D527) or lingering one (D529), its stack read with
            // `ItemStack.CODEC`, a potion of its kind where it's empty or unread.
            self.entity_ids += 1
            let id = self.entity_ids
            let seed = self.entity_seed(id)
            var item: Tag? = none
            if let codecs = self.items {
                if tag.contains("Item") {
                    if let stack = codecs.stack(tag["Item"], true) {
                        if count_of(stack.copy()) > 0 and stack_item(some(stack.copy())) != "minecraft:air" {
                            item = some(stack)
                        }
                    }
                }
            }
            if let thrown = ThrownItem.loaded(id, seed, tag, item, lingering, mut lines) {
                return some(ReadEntity.Thrown(thrown))
            }
            return none
        }
        let species = species_named(type_id.copy())
        if species != none and codecs_ready and self.living_ready(d) and self.mob_facts_ready() {
            if let mb = self.loaded_mob(species ?? MOOSHROOM, tag, mut lines) {
                return some(ReadEntity.Mob(mb))
            }
            return none
        }
        if type_id != "minecraft:item" or not codecs_ready {
            // Kept as it was, with the IDs it and its passengers take all the same, as vanilla
            // makes each whose type it knows, `loadEntityRecursive` (D588).
            self.entity_ids += self.kept_ids(tag)
            return some(ReadEntity.Kept(Tag.Compound(tag.copy())))
        }
        var stack: Tag? = none
        if tag.contains("Item") {
            if let codecs = self.items {
                stack = codecs.stack(tag["Item"], true)
            }
        }
        self.entity_ids += 1
        let id = self.entity_ids
        let seed = self.entity_seed(id)
        if let e = ItemEntity.loaded(id, seed, tag, stack, mut lines) {
            return some(ReadEntity.Item(e))
        }
        return none
    }

    // A mob of the kind `species` loaded from `tag`, with the next ID and a seed from it, as
    // `EntityType.loadEntityRecursive` makes one and `load` reads it in, what that logs added to
    // `lines`; none where it can't be read, which takes its ID all the same.
    fn loaded_mob(mut self, species: i32, tag: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> Mob? {
        self.entity_ids += 1
        let id = self.entity_ids
        let seed = self.entity_seed(id)
        if species == ENDER_DRAGON {
            // An ender dragon's eight parts, each an entity its constructor makes,
            // `EnderDragonPart`, with the next IDs and their randoms' seeds (D608).
            for _ in 0..8 {
                self.entity_ids += 1
                let part = self.entity_ids
                _ = self.entity_seed(part)
            }
        }
        let kind = u32.wrap(self.entity_type(type_name(species)))
        let lf = self.living_facts else return none
        let facts = self.mob_facts else return none
        var mb = Mob.loaded(lf, facts, kind, id, seed, tag, mut lines) else return none
        // A skeleton's weapon goal as what it holds has it, as its `readAdditionalSaveData` ends
        // (CAL-159).
        mb.reassess_weapon(self.world.settings.difficulty == Difficulty.Hard)
        // An enderman's carried block read as a state, `BlockState.CODEC`, where it's one, else
        // none (CAL-159).
        if mb.species == ENDERMAN and mb.kept.contains("carriedBlockState") {
            var state: u32? = none
            if let codecs = self.items {
                state = codecs.state_of(mb.kept["carriedBlockState"].copy())
            }
            let carried = if state != none { some(mb.kept["carriedBlockState"].copy()) } else { none }
            mb.set_carried(state, carried)
        }
        // An enderman's legacy anger, `AngerTime`, read as the game time plus it (CAL-159).
        mb.anger_from(self.world.game_time)
        return some(mb)
    }

    // The spawn step of each fresh chunk of the level `d` that's ready for it, in the order they
    // came to be (CAL-161), as `NoiseBasedChunkGenerator.spawnOriginalMobs` runs it before the
    // chunk's full: its mobs kept as tags for it, and the chunk loaded, so it can come to be.
    fn generation_spawns(mut self, d: usize) {
        let ready = self.levels[d].take_spawn_ready()
        for (pos, legacy) in ready {
            let made = self.generation_spawn(d, pos, legacy)
            self.levels[d].spawned(pos)
            if not made.is_empty() {
                var es = self.take_entities(d)
                es.generated.insert(pos.pack(), made)
                self.put_entities(d, es)
            }
        }
    }

    // `spawnMobsForChunkGeneration` in the chunk at `pos` of the level `d` (CAL-161), with
    // `spawn_mobs` on and what natural spawning knows: its creatures made in `WorldGenRegion`'s
    // place, whose sky doesn't darken and where no entity's in the way, each taking an ID and a
    // seed as `create` does, with the chunk's own random, `WorldgenRandom` over a legacy source
    // seeded for its decoration, and the region's, `worldgen_region_random` at its corner, of the
    // `RandomState`'s source, legacy if `legacy`. Each is saved as `ProtoChunk.addEntity` saves
    // it. A type Calcite doesn't make yet is reported, and ends the chunk's spawning.
    fn generation_spawn(mut self, d: usize, pos: ChunkPos, legacy: bool) -> List<Tag> {
        var out = List<Tag>()
        if not self.world.spawn_rules.mobs or not self.world.natural_ready() or not self.items_ready() or not self.living_ready(d) or not self.mob_facts_ready() {
            return out
        }
        let n = self.world.natural.take() else return out
        var place = self.spawn_place(d, List<SpawnerPlayer>(), [CREATURE])
        place.sky_darken = 0
        var maker = self.mob_making(d)
        maker.blocking = List<Aabb>()
        maker.ids = self.entity_ids
        maker.seeds = self.entity_seeds
        maker.lf = self.living_facts.take()
        maker.facts = self.mob_facts.take()
        let seed = self.world.seed
        let xo = pos.x * 16
        let zo = pos.z * 16
        var r = WorldgenRandom.new(LegacyRandom.new(0))
        _ = r.set_decoration_seed(seed, xo, zo)
        var source = AnyRandom.of(legacy, seed)
        let positional = source.fork_positional()
        var named = positional.from_hash_of(String("minecraft:worldgen_region_random"))
        let factory = named.fork_positional()
        var region = factory.at(xo, 0, zo)
        let top = self.world.dims[d].min_y + self.world.dims[d].height - 1
        let ceiling = self.world.dims[d].ceiling
        var thrown: String? = none
        var missing: i32? = none
        self.levels[d].begin_region(pos)
        match spawn_for_generation(n, self.world.mobs[d], place, mut self.levels[d], mut maker, pos.x, pos.z, top, ceiling, mut r, mut region) {
            ok(m) => missing = m,
            err(e) => thrown = some("{e.exception}: {e.message}"),
        }
        self.levels[d].end_region()
        self.world.natural = some(n)
        self.entity_ids = maker.ids
        self.entity_seeds = maker.seeds
        self.living_facts = maker.lf.take()
        self.mob_facts = maker.facts.take()
        if let e = thrown {
            self.logs.push(Entry.error("Spawning mobs as chunk {pos.x}, {pos.z} generated threw {e}"))
        }
        if let type_id = missing {
            var name = String("an entity type")
            if let codecs = self.items {
                name = codecs.builtin_name("entity_type", type_id) ?? name
            }
            self.levels[d].unimplemented("{name} among the mobs chunks spawn as they generate")
        }
        for m in maker.made {
            out.push(m.saved())
        }
        return out
    }

    // `addEntity` of what the level `d` read, `got`: an item last in the tick list and paired
    // with the players that see it, and the rest kept to save again, with a place in their
    // sections (CAL-148, drawn out of `take_in_entities`, D588).
    fn add_read(mut self, d: usize, got: ReadEntity) {
        if let ReadEntity.Kept(tag) = got {
            let counted = self.kept_type(tag)
            var now = self.take_entities(d)
            now.last_kept -= 1
            let id = now.last_kept
            let (x, y, z) = kept_place(tag)
            now.list.place_kept(id, x, y, z)
            now.kept.insert(id, tag.copy())
            if let type_id = counted {
                now.kept_mobs.insert(id, (type_id, x, z))
            }
            self.put_entities(d, now)
            return
        }
        match got {
            ReadEntity.Item(e) => self.add_item(d, e.copy(), none),
            ReadEntity.Orb(o) => self.add_orb(d, o.copy(), none),
            ReadEntity.Stand(a) => self.add_stand(d, a.copy()),
            ReadEntity.Mob(mb) => self.add_mob(d, mb.copy()),
            ReadEntity.Arrow(a) => self.add_arrow(d, a.copy()),
            ReadEntity.Thrown(thrown) => self.add_thrown(d, thrown.copy()),
            ReadEntity.Cloud(c) => self.add_cloud(d, c.copy()),
            ReadEntity.Crystal(c) => self.add_crystal(d, c.copy()),
            ReadEntity.Eye(e) => self.add_eye(d, e.copy()),
            ReadEntity.Fireball(b) => self.add_fireball(d, b.copy()),
            ReadEntity.Kept(_) => {},
        }
    }

    // How many IDs vanilla's `loadEntityRecursive` draws for the entity `tag` saves, which
    // Calcite keeps as it is: one where its type's known, `EntityType.create`, and as many again
    // for each of its passengers, `Passengers`, in turn; none for one whose type isn't, which
    // isn't made, nor its passengers (D588).
    fn kept_ids(mut self, tag: JavaHashMap<String, Tag>) -> i32 {
        var name = String()
        if tag.contains("id") {
            if let Tag.Str(s) = tag["id"] {
                name = s.copy()
            }
        }
        if not self.entity_type_known(name) {
            return 0
        }
        // An ender dragon takes its parts' eight more (D608).
        var n = if name == "minecraft:ender_dragon" { 9 } else { 1 }
        if tag.contains("Passengers") {
            if let Tag.List(riders) = tag["Passengers"] {
                for r in riders {
                    if let Tag.Compound(m) = r {
                        n += self.kept_ids(m)
                    }
                }
            }
        }
        return n
    }

    // Whether `name` is an entity type's, as `EntityType.byString` finds it in the built-in
    // registry (D588).
    fn entity_type_known(mut self, name: String) -> bool {
        if let codecs = self.items.take() {
            let id = codecs.builtin_id("entity_type", name.copy())
            self.items = some(codecs)
            return id != none
        }
        return match Identifier.parse(name) {
            ok(named) => entity_types().id(named) != none,
            err(_) => false,
        }
    }

    // The entities the chunk at `pos` of the level `d` had till it came to be full, those its
    // generation made, as the End's spikes make their crystals, added as it comes to be,
    // `postLoadProtoChunk`, before the mobs it spawned, which come after them in vanilla's list:
    // each made as it's read, with the IDs it takes (D588).
    fn add_world_entities(mut self, d: usize, pos: ChunkPos) {
        let tags = self.levels[d].take_world_entities(pos)
        if tags.is_empty() {
            return
        }
        var lines = List<Entry>()
        for tag in tags {
            let Tag.Compound(m) = tag else continue
            if let got = self.entity_from(d, m, mut lines) {
                self.add_read(d, got)
            }
        }
        for e in lines {
            self.logs.push(e.copy())
        }
    }

    // The mobs the chunk at `pos` of the level `d` spawned as it generated, added as it comes to
    // be full, as `postLoadProtoChunk` adds them, `addWorldGenChunkEntities`, before its entities
    // are read (CAL-161): each loaded again from its tag as `loadEntitiesRecursive` loads it,
    // with an ID and a seed of its own.
    fn add_generated(mut self, d: usize, pos: ChunkPos) {
        var es = self.take_entities(d)
        let made = es.generated.remove(pos.pack())
        self.put_entities(d, es)
        let tags = made else return
        if not self.items_ready() or not self.living_ready(d) or not self.mob_facts_ready() {
            return
        }
        var lines = List<Entry>()
        for tag in tags {
            let Tag.Compound(m) = tag else continue
            var name = String()
            if m.contains("id") {
                if let Tag.Str(s) = m["id"] {
                    name = s.copy()
                }
            }
            let species = species_named(name) else continue
            if let mb = self.loaded_mob(species, m, mut lines) {
                self.add_mob(d, mb)
            }
        }
        for e in lines {
            self.logs.push(e.copy())
        }
    }

    // Asks for the entities of the chunk at `pos` of the level `d`, `requestChunkLoad`: from its
    // thread, or, replaying a recording that read them, from the log; with neither, nothing's
    // saved, so it has none.
    fn ask_entities(mut self, d: usize, pos: ChunkPos) {
        let k = pos.pack()
        var es = self.take_entities(d)
        es.loads.insert(k, false)
        self.levels[d].entities_loaded(k, false)
        if let held = es.jobs.take() {
            var jobs = held
            jobs.read(pos)
            es.jobs = some(jobs)
        } else if not self.entities_logged {
            es.empty.insert(k)
            es.inbox.push(ReadEntities { pos: pos, entities: List<ReadEntity>() })
        }
        self.put_entities(d, es)
    }

    // `PersistentEntitySectionManager.tick` for the level `d`, as `ServerLevel.tick` ends with it
    // (CAL-148): first the chunks that came to be accessible, `updateChunkStatus`, whose entities
    // are asked for if they're fresh, and those that stopped being, to unload; then the entities
    // read come in, `processPendingLoads`; then each chunk to unload that's still not accessible
    // is saved, and its items go, `processUnloads`.
    fn tick_entity_chunks(mut self, d: usize) {
        self.entity_visibility(d)
        _ = self.take_in_entities(d)
        let es = self.take_entities(d)
        var keys = List<i64>()
        for k in es.to_unload {
            keys.push(k)
        }
        self.put_entities(d, es)
        for k in keys {
            let now = self.take_entities(d)
            let visible = now.visible.contains(k)
            self.put_entities(d, now)
            if visible or self.unload_entity_chunk(d, k) {
                var after = self.take_entities(d)
                after.to_unload.remove(k)
                self.put_entities(d, after)
            }
        }
    }

    // `updateChunkStatus` for each chunk of the level `d` that came to be full or stopped being,
    // as `onFullChunkStatusChange` tells it: one that came to be is accessible, and its entities
    // are asked for if it's fresh; one that stopped being is to unload (CAL-148).
    fn entity_visibility(mut self, d: usize) {
        self.generation_spawns(d)
        let changes = self.levels[d].take_full_changes()
        for (pos, full) in changes {
            let k = pos.pack()
            var es = self.take_entities(d)
            let fresh = not es.loads.contains(k)
            if full {
                es.visible.insert(k)
                es.to_unload.remove(k)
            } else {
                es.visible.remove(k)
                es.to_unload.insert(k)
            }
            self.put_entities(d, es)
            if full {
                self.coming_full = some((d, k))
                self.add_world_entities(d, pos)
                self.add_generated(d, pos)
                self.coming_full = none
            }
            if full and fresh {
                self.ask_entities(d, pos)
            }
        }
    }

    // Whether the entities of each full chunk within `radius` of `center` in the level `d` are in,
    // `areEntitiesLoaded`, as `waitForEntities` waits for them, taking in what's been read first,
    // `processPendingLoads`, once the chunks that came to be full have theirs asked for (CAL-148).
    fn entities_around(mut self, d: usize, center: ChunkPos, radius: i32) -> bool {
        self.entity_visibility(d)
        _ = self.take_in_entities(d)
        let es = self.take_entities(d)
        var all = true
        for x in center.x - radius..center.x + radius + 1 {
            for z in center.z - radius..center.z + radius + 1 {
                let pos = ChunkPos { x: x, z: z }
                if not self.levels[d].full(pos) {
                    continue
                }
                let k = pos.pack()
                if not es.loads.contains(k) or not es.loads[k] {
                    all = false
                }
            }
        }
        self.put_entities(d, es)
        return all
    }

    // `processPendingLoads`: each chunk read comes in, in the order it was read, each entity in the
    // order it was saved, `addEntity`: an item last in the tick list and paired with the players
    // that see it, and the rest kept to save again, with a place in their sections; then it's
    // read. The chunks that came in.
    fn take_in_entities(mut self, d: usize) -> List<i64> {
        var es = self.take_entities(d)
        if es.inbox.is_empty() {
            self.put_entities(d, es)
            return List<i64>()
        }
        let inbox = es.inbox
        es.inbox = List<ReadEntities>()
        self.put_entities(d, es)
        var came = List<i64>()
        for chunk in inbox {
            let k = chunk.pos.pack()
            for each in chunk.entities {
                self.add_read(d, each)
            }
            var after = self.take_entities(d)
            after.loads.insert(k, true)
            self.put_entities(d, after)
            self.levels[d].entities_loaded(k, true)
            came.push(k)
        }
        return came
    }

    // `storeChunkSections` for the chunk at `k` of the level `d`: its entities in its sections'
    // order, each item as `saveAsPassenger` saves it and each kept as it was read,
    // `EntityStorage.storeEntities`; none, if its entities were read, clears it, unless it's known
    // to have none. A chunk whose entities are asked for can't be saved yet, nor one with entities
    // whose entities weren't read, which are asked for. Those saved, by ID, or `none` if it wasn't.
    fn store_entity_chunk(mut self, d: usize, k: i64) -> List<i32>? {
        var es = self.take_entities(d)
        let fresh = not es.loads.contains(k)
        if not fresh and not es.loads[k] {
            self.put_entities(d, es)
            return none
        }
        let pos = ChunkPos { x: i32.wrap(k), z: i32.wrap(k >> 32) }
        let ids = es.list.in_chunk(pos)
        var tags = List<Tag>()
        for id in ids {
            if id < 0 {
                if es.kept.contains(id) {
                    tags.push(es.kept[id].copy())
                }
            } else {
                tags.push(es.list.saved(id))
            }
        }
        if tags.is_empty() {
            if not fresh and not es.empty.contains(k) {
                es.empty.insert(k)
                if let held = es.jobs.take() {
                    var jobs = held
                    jobs.write(pos, none)
                    es.jobs = some(jobs)
                }
            }
            self.put_entities(d, es)
            return some(ids)
        }
        if fresh {
            self.put_entities(d, es)
            self.ask_entities(d, pos)
            return none
        }
        es.empty.remove(k)
        if let held = es.jobs.take() {
            var jobs = held
            jobs.write(pos, write_entities(pos, some(tags)))
            es.jobs = some(jobs)
        }
        self.put_entities(d, es)
        return some(ids)
    }

    // `processChunkUnload` of the chunk at `k` of the level `d`: its entities saved, then its
    // items gone from the level, `unloadEntity`, and from those who saw them, as their trackers
    // go, and the kept let go of; `false` if it can't be saved yet.
    fn unload_entity_chunk(mut self, d: usize, k: i64) -> bool {
        let ids = self.store_entity_chunk(d, k) else return false
        var es = self.take_entities(d)
        for id in ids {
            if id < 0 {
                es.list.remove_kept(id)
                _ = es.kept.remove(id)
                _ = es.kept_mobs.remove(id)
                continue
            }
            es.list.remove(id)
            _ = es.list.take_gone()
            self.item_gone(mut es, id)
        }
        _ = es.loads.remove(k)
        self.put_entities(d, es)
        self.levels[d].entities_loaded(k, false)
        return true
    }

    // `autoSave` of the level `d`'s entities (CAL-148): each chunk with items, and each whose
    // entities were read, saved, or unloaded where it isn't accessible.
    fn save_entity_chunks(mut self, d: usize) {
        let es = self.take_entities(d)
        var keys = List<i64>()
        var seen = Set<i64>()
        for pos in es.list.chunks() {
            let k = pos.pack()
            seen.insert(k)
            keys.push(k)
        }
        for (k, done) in es.loads {
            if done and not seen.contains(k) {
                keys.push(k)
            }
        }
        self.put_entities(d, es)
        for k in keys {
            let now = self.take_entities(d)
            let visible = now.visible.contains(k)
            self.put_entities(d, now)
            if visible {
                _ = self.store_entity_chunk(d, k)
            } else if self.unload_entity_chunk(d, k) {
                var after = self.take_entities(d)
                after.to_unload.remove(k)
                self.put_entities(d, after)
            }
        }
    }

    // `saveAll` of the level `d`'s entities as the server stops (CAL-148): what's been read comes
    // in, and every chunk's saved, as `autoSave` saves them; those asked for are saved as they're
    // read. Once nothing's asked for, their thread writes what it holds and closes.
    fn stop_entities(mut self, d: usize) {
        var es = self.take_entities(d)
        if es.closed {
            self.put_entities(d, es)
            return
        }
        let first = not es.saved_all
        es.saved_all = true
        self.put_entities(d, es)
        let came = self.take_in_entities(d)
        if first {
            self.save_entity_chunks(d)
        } else {
            for k in came {
                let now = self.take_entities(d)
                let visible = now.visible.contains(k)
                self.put_entities(d, now)
                if visible {
                    _ = self.store_entity_chunk(d, k)
                } else {
                    _ = self.unload_entity_chunk(d, k)
                }
            }
        }
        var after = self.take_entities(d)
        var away: usize = 0
        if let jobs = after.jobs {
            away = jobs.reads_away()
        }
        if away == 0 {
            after.closed = true
            if let held = after.jobs.take() {
                var jobs = held
                jobs.close()
                after.jobs = some(jobs)
            }
        }
        self.put_entities(d, after)
    }

    // `addFreshEntity` of the item `e` in the level `d` (CAL-148): last in its tick list, after
    // everything that came before, with its tracker, `ChunkMap.addEntity`, which looks at which
    // of the level's players see it, but `except`, a player out of the connections, whom the
    // caller pairs.
    fn add_item(mut self, d: usize, e: own ItemEntity, except: i32?) {
        self.entries += 1
        var item = e
        item.body.entered = self.entries
        let id = item.body.id
        var tr = Tracker.new(item.body, item.stack.copy())
        tr.flags = item.flags
        for slot in self.level_slots(d) {
            var con = self.connections[slot].take() else continue
            if except != some(con.player.entity_id) {
                self.item_seen(mut tr, item, mut con)
            }
            self.connections[slot] = some(con)
        }
        var es = self.take_entities(d)
        es.tracked.insert(id, false)
        es.trackers.insert(id, tr)
        es.list.add(item)
        self.put_entities(d, es)
    }

    // `addFreshEntity` of the orb `o` in the level `d`, as `add_item` adds an item (CAL-154).
    fn add_orb(mut self, d: usize, o: own ExperienceOrb, except: i32?) {
        self.entries += 1
        var orb = o
        orb.body.entered = self.entries
        let id = orb.body.id
        var tr = Tracker.of_orb(orb.body, Tag.Int(orb.value))
        tr.flags = orb.flags
        for slot in self.level_slots(d) {
            var con = self.connections[slot].take() else continue
            if except != some(con.player.entity_id) {
                self.orb_seen(mut tr, orb, mut con)
            }
            self.connections[slot] = some(con)
        }
        var es = self.take_entities(d)
        es.tracked.insert(id, false)
        es.trackers.insert(id, tr)
        es.list.add_orb(orb)
        self.put_entities(d, es)
    }

    // A mob's shot in the level `d`, `performRangedAttack` (CAL-159): its arrow, `getMobArrow`,
    // with the next ID, its damage drawn, `setBaseDamageFromMob`, shot at its target a fifth of the
    // way across above them at 1.6 blocks a tick, less off the harder the difficulty,
    // `spawnProjectileUsingShoot`, and added, `addFreshEntity`, then what the enchantments on its
    // item and its bow do as it's spawned, `applyOnProjectileSpawned`, `projectile_spawned`, the
    // bow's where it's not the same item, which lights it where it's flame's (CAL-159): that it
    // isn't on fire till its tick, the arrow's lit before it's added, which its tracker doesn't
    // read. A tipped arrow, as one it holds, is as its potion has it (D513). A spectral arrow, and
    // the piercing of a weapon that has it, `getPiercingCount`, said missing.
    fn mob_fires(mut self, d: usize, s: Fired) {
        if held_name(some(s.item.copy())) == "minecraft:spectral_arrow" {
            self.levels[d].unimplemented(String("A mob shooting a spectral arrow"))
        }
        var pierces = false
        var hits_blocks = false
        if let items = self.items {
            for (_, e) in items.enchantments(s.weapon.copy()) {
                pierces = pierces or enchantment_has(e, "minecraft:projectile_piercing")
                hits_blocks = hits_blocks or enchantment_has(e, "minecraft:hit_block")
            }
        }
        if pierces {
            self.levels[d].unimplemented(String("Piercing on the arrows mobs shoot, getPiercingCount"))
        }
        if hits_blocks {
            // `hitBlockEnchantmentEffects`, as the arrow lands, `EnchantmentHelper.onHitBlock`.
            self.levels[d].unimplemented(String("What the weapons arrows are shot from do as they hit blocks"))
        }
        self.entity_ids += 1
        let id = self.entity_ids
        let seed = self.entity_seed(id)
        var a = Arrow.fired(id, seed, s.x, s.y, s.z, s.owner, s.item.copy(), s.weapon.copy())
        let difficulty = self.world.settings.difficulty.id()
        a.base_from_mob(s.power, difficulty)
        let xd = s.tx - s.x
        let yd = s.ty - s.y
        let zd = s.tz - s.z
        let across = (xd * xd + zd * zd).sqrt()
        a.shoot(xd, yd + across * f64(0.2f32), zd, 1.6f32, f32.nearest(14 - difficulty * 4))
        self.projectile_spawned(d, mut a, s.item.copy())
        if held_name(some(s.weapon.copy())) != held_name(some(s.item.copy())) {
            self.projectile_spawned(d, mut a, s.weapon.copy())
        }
        self.add_arrow(d, a)
    }

    // A witch's throw in the level `d`, `Witch.performRangedAttack` (D528): a splash potion of its
    // choice, `PotionContents.createItemStack`, thrown with the next ID from a tenth below its
    // eyes, `spawnProjectileUsingShoot`, along its aim at its power and its uncertainty, a
    // witch's its own, `rangedAttackUncertainty`, and added, `addFreshEntity`. A potion has no
    // enchantments to do anything as it's spawned.
    fn mob_hurls(mut self, d: usize, h: Hurled) {
        var contents = JavaHashMap<String, Tag>()
        contents.insert(String("potion"), Tag.Str(h.potion.copy()))
        var components = JavaHashMap<String, Tag>()
        components.insert(String("minecraft:potion_contents"), Tag.Compound(contents))
        var stack = JavaHashMap<String, Tag>()
        stack.insert(String("id"), Tag.Str(String("minecraft:splash_potion")))
        stack.insert(String("count"), Tag.Int(1))
        stack.insert(String("components"), Tag.Compound(components))
        self.entity_ids += 1
        let id = self.entity_ids
        let seed = self.entity_seed(id)
        var thrown = ThrownItem.thrown(id, seed, h.x, h.y, h.z, h.owner, Tag.Compound(stack))
        thrown.shoot(h.xd, h.yd, h.zd, h.power, h.uncertainty)
        self.add_thrown(d, thrown)
    }

    // What the enchantments on `stack` do to the arrow `a` the level `d` takes in,
    // `EnchantmentHelper.onProjectileSpawned` (CAL-159): `spawned_effects` in its context, it as
    // `this` where it is; flame's `ignite` lights it for its seconds, `igniteForSeconds`, where
    // it's lit for less; what else they'd do is said to be missing.
    fn projectile_spawned(mut self, d: usize, a: mut Arrow, stack: Tag) {
        var one = List<Tag?>()
        one.push(some(stack.copy()))
        if not self.any_enchanted(one) {
            return
        }
        let shared = self.levels[d].world_loot() else return
        let env = self.levels[d].shared_env() else return
        let Env { facts: f, .. } = env.value
        let me = LootEntity { kind: String("minecraft:arrow"), on_fire: a.body.fire > 0 }
        let params = LootParams { origin: some((a.body.x, a.body.y, a.body.z)), this_entity: true, this: some(me) }
        var missing = List<String>()
        var random = self.levels[d].lend_level_random()
        let done = spawned_effects(shared.value, f, self.levels[d], mut random, stack, params, mut missing)
        self.levels[d].give_back_level_random(random)
        for what in done {
            match what {
                Attacked.Ignite(seconds) => {
                    let ticks = i32.saturate(f64(seconds * 20.0f32).floor())
                    if a.body.fire < ticks {
                        a.body.fire = ticks
                    }
                },
                _ => missing.push(String("Enchantments' effects on projectiles as they're spawned, but ignite")),
            }
        }
        for m in missing {
            self.levels[d].unimplemented(m)
        }
    }

    // `addFreshEntity` of the arrow `a` in the level `d`, as `add_item` adds an item (CAL-159),
    // its tracker an arrow's, made with its values that aren't their defaults.
    fn add_arrow(mut self, d: usize, a: own Arrow) {
        self.entries += 1
        var arrow = a
        arrow.body.entered = self.entries
        let id = arrow.body.id
        var tr = Tracker.of_arrow(arrow.body, arrow.data.pack_non_default())
        var es = self.take_entities(d)
        for slot in self.level_slots(d) {
            var con = self.connections[slot].take() else continue
            let owner = self.owner_among(d, arrow.owner, es.list, con)
            self.arrow_seen(mut tr, arrow, owner, mut con)
            self.connections[slot] = some(con)
        }
        es.tracked.insert(id, false)
        es.trackers.insert(id, tr)
        es.list.add_arrow(arrow)
        self.put_entities(d, es)
    }

    // `addFreshEntity` of the thrown potion `p` in the level `d` (D527), as `add_arrow` adds an
    // arrow, its tracker a thrown potion's, with its values that aren't their defaults and its
    // stack, which never is, `thrown_values`.
    fn add_thrown(mut self, d: usize, p: own ThrownItem) {
        self.entries += 1
        var thrown = p
        thrown.body.entered = self.entries
        let id = thrown.body.id
        let values = self.thrown_values(thrown.data.pack_non_default(), thrown.item)
        var tr = Tracker.of_thrown(thrown.body, some(values))
        var es = self.take_entities(d)
        for slot in self.level_slots(d) {
            var con = self.connections[slot].take() else continue
            let owner = self.owner_among(d, thrown.owner, es.list, con)
            self.thrown_seen(mut tr, thrown, owner, mut con)
            self.connections[slot] = some(con)
        }
        es.tracked.insert(id, false)
        es.trackers.insert(id, tr)
        es.list.add_thrown(thrown)
        self.put_entities(d, es)
    }

    // `addFreshEntity` of the area effect cloud `c` in the level `d` (D529), as `add_arrow` adds an
    // arrow, its tracker a cloud's, made with its values that aren't their defaults; a particle of
    // its own, which it doesn't show yet, said missing.
    fn add_cloud(mut self, d: usize, c: own EffectCloud) {
        self.entries += 1
        var cloud = c
        cloud.body.entered = self.entries
        if cloud.particle_missing() {
            self.levels[d].unimplemented(String("An area effect cloud's own particle, custom_particle"))
        }
        let id = cloud.body.id
        var tr = Tracker.of_cloud(cloud.body, cloud.data.pack_non_default())
        var es = self.take_entities(d)
        for slot in self.level_slots(d) {
            var con = self.connections[slot].take() else continue
            self.cloud_seen(mut tr, cloud, mut con)
            self.connections[slot] = some(con)
        }
        es.tracked.insert(id, false)
        es.trackers.insert(id, tr)
        es.list.add_cloud(cloud)
        self.put_entities(d, es)
    }

    // `addFreshEntity` of the eye of ender `e` in the level `d`, as `add_crystal` adds an end
    // crystal (D598), its tracker made with its values that aren't their defaults, its stack among
    // them.
    fn add_eye(mut self, d: usize, e: own EyeOfEnder) {
        self.entries += 1
        var eye = e
        eye.body.entered = self.entries
        let id = eye.body.id
        let values = self.thrown_values(eye.data.pack_non_default(), eye.item)
        var tr = Tracker.of_eye(eye.body, some(values))
        var es = self.take_entities(d)
        for slot in self.level_slots(d) {
            var con = self.connections[slot].take() else continue
            self.eye_seen(mut tr, eye, mut con)
            self.connections[slot] = some(con)
        }
        es.tracked.insert(id, false)
        es.trackers.insert(id, tr)
        es.list.add_eye(eye)
        self.put_entities(d, es)
    }

    // `addFreshEntity` of the dragon fireball `b` in the level `d`, as `add_thrown` adds a thrown
    // potion (D618), its tracker a thrown potion's, made with its values that aren't their
    // defaults.
    fn add_fireball(mut self, d: usize, b: own DragonFireball) {
        self.entries += 1
        var fireball = b
        fireball.body.entered = self.entries
        let id = fireball.body.id
        var tr = Tracker.of_thrown(fireball.body, fireball.data.pack_non_default())
        var es = self.take_entities(d)
        for slot in self.level_slots(d) {
            var con = self.connections[slot].take() else continue
            let owner = self.owner_among(d, fireball.owner, es.list, con)
            self.fireball_seen(mut tr, fireball, owner, mut con)
            self.connections[slot] = some(con)
        }
        es.tracked.insert(id, false)
        es.trackers.insert(id, tr)
        es.list.add_fireball(fireball)
        self.put_entities(d, es)
