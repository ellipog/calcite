    // `addFreshEntity` of the end crystal `c` in the level `d`, as `add_cloud` adds a cloud (D589),
    // its tracker made with its values that aren't their defaults.
    fn add_crystal(mut self, d: usize, c: own EndCrystal) {
        self.entries += 1
        var crystal = c
        crystal.body.entered = self.entries
        let id = crystal.body.id
        var tr = Tracker.of_crystal(crystal.body, crystal.data.pack_non_default())
        var es = self.take_entities(d)
        for slot in self.level_slots(d) {
            var con = self.connections[slot].take() else continue
            self.crystal_seen(mut tr, crystal, mut con)
            self.connections[slot] = some(con)
        }
        es.tracked.insert(id, false)
