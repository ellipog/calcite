/// The server's tick rate, vanilla's `ServerTickRateManager` and the `TickRateManager` it is
/// (CAL-360): how many ticks a second the server runs and the nanoseconds a tick is by that;
/// whether the game's frozen, and how many ticks a step has it run frozen yet; whether the game
/// runs this tick, `runGameElements`; and a sprint, its ticks as fast as they go: how many are
/// left of it and how many it was given, when the tick it's on began and the nanoseconds its ticks
/// took, and whether the game was frozen before it.
module server.tick_rate

import java.text.{format_fixed}

pub struct TickRate {
    pub rate: f32 = 20.0f32
    pub nanos: i64 = 50000000
    pub frozen: bool = false
    pub to_run: i32 = 0
    pub runs: bool = true
    pub sprint_left: i64 = 0
    pub sprint_given: i64 = 0
    pub sprint_began: u64 = 0
    pub sprint_spent: u64 = 0
    pub frozen_before: bool = false
}

/// What a sprint makes of the tick about to run, `checkShouldSprintThisTick`.
pub enum Sprinting {
    /// The tick runs at once, a tick of the sprint.
    Now
    /// The tick waits its time: the game doesn't run.
    Waits
    /// The sprint's done, to be reported, `finishTickSprint`; the tick waits its time.
    Done
}

impl TickRate {
    /// `setTickRate`: at least 1 a second, its tick `NANOSECONDS_PER_SECOND / tickrate`
    /// nanoseconds, truncated.
    pub fn set_rate(mut self, rate: f32) {
        self.rate = if rate > 1.0f32 { rate } else { 1.0f32 }
        self.nanos = i64.saturate(1000000000.0 / f64(self.rate))
    }

    /// `millisecondsPerTick`, as a float.
    pub fn millis_per_tick(self) -> f32 {
        return f32.nearest(self.nanos) / 1000000.0f32
    }

    /// Whether a step has it run frozen, `isSteppingForward`.
    pub fn stepping(self) -> bool {
        return self.to_run > 0
    }

    /// Whether it sprints, `isSprinting`.
    pub fn sprinting(self) -> bool {
        return self.sprint_given > 0
    }

    /// `TickRateManager.tick`, as the server's tick starts: the game runs where it isn't frozen
    /// or a step's ticks are left, one of which it takes.
    pub fn tick(mut self) {
        self.runs = not self.frozen or self.to_run > 0
        if self.to_run > 0 {
            self.to_run -= 1
        }
    }

    /// `stepGameIfPaused`: where it's frozen, `ticks` to run so, and true; else false.
    pub fn step(mut self, ticks: i32) -> bool {
        if not self.frozen {
            return false
        }
        self.to_run = ticks
        return true
    }

    /// `stopStepping`: where a step's ticks are left, none, and true; else false.
    pub fn stop_stepping(mut self) -> bool {
        if self.to_run > 0 {
            self.to_run = 0
            return true
        }
        return false
    }

    /// `requestGameToSprint`: a sprint of `ticks`, the game unfrozen for it, how it was kept for
    /// after; whether one was going.
    pub fn sprint(mut self, ticks: i32) -> bool {
        let going = self.sprint_left > 0
        self.sprint_spent = 0
        self.sprint_given = i64(ticks)
        self.sprint_left = i64(ticks)
        self.frozen_before = self.frozen
        self.frozen = false
        return going
    }

    /// `finishTickSprint`'s report and its end: the ticks a second it ran, from the ticks done
    /// over their milliseconds, at least 1 nanosecond's, an int as Java casts it, and the
    /// milliseconds a tick, `%.2f`, or the rate's where none were done; the sprint over and the
    /// game frozen as it was before.
    pub fn finish_sprint(mut self) -> (i32, String) {
        let done = self.sprint_given - self.sprint_left
        let spent = f64.nearest(self.sprint_spent)
        let millis = (if spent > 1.0 { spent } else { 1.0 }) / 1000000.0
        let per_second = i32.saturate(f64.nearest(1000 * done) / millis)
        let per_tick = format_fixed(if done == 0 { f64(self.millis_per_tick()) } else { millis / f64.nearest(done) }, 2)
        self.sprint_given = 0
        self.sprint_spent = 0
        self.sprint_left = 0
        self.frozen = self.frozen_before
        return (per_second, per_tick)
    }

    /// `checkShouldSprintThisTick` at `now` nanoseconds, of a sprint going: where the game
    /// doesn't run, it waits; where ticks of it are left, one's taken, begun now; else it's done.
    pub fn sprint_tick(mut self, now: u64) -> Sprinting {
        if not self.runs {
            return Sprinting.Waits
        }
        if self.sprint_left > 0 {
            self.sprint_began = now
            self.sprint_left -= 1
            return Sprinting.Now
        }
        return Sprinting.Done
    }

    /// `endTickWork` at `now`: the sprint's tick's time added.
    pub fn end_tick_work(mut self, now: u64) {
        self.sprint_spent = self.sprint_spent.wrapping_add(now.wrapping_sub(self.sprint_began))
    }
}
