/// Reading chunks from a world's region files, off the tick thread, as vanilla's `IOWorker` and
/// its background executor read them (CAL-65).
///
/// One IO thread owns the region files. It finds which chunks a region's file has, and reads
/// what the file holds of a chunk, as it's asked. What it reads goes to the chunk workers, which
/// check it, inflate it and read its NBT into a chunk, with its sky sources and its light as it
/// was saved, and back to the tick thread with what each logged, waking the poll. The workers
/// start as chunks need them, up to one fewer than the processors.
///
/// What the IO thread reads is the server's input, as the network's bytes are: the link records
/// it, and a replay hands it over in the same order. What the workers make of it depends only on
/// that, so a replay makes it again with `prepare` on its own thread.
///
/// A world that generates its chunks hands each the workers find nothing to use of to the
/// generator's thread, which schedules `worldgen.generator`'s jobs with `worldgen.scheduler`,
/// and its workers, one fewer than the processors, each with a `Worker` of its own while it has
/// jobs (D226), which do them: each chunk's starts and biomes, its terrain, its decoration and its finishing as the
/// server's chunk, unlit, with its sky's sources (CAL-88). It keeps two jobs a worker out, the
/// most urgent first, and hands each chunk back as it's finished. The worker that finished it
/// encodes it as its region file holds it, and the IO thread writes it there, so it's read from
/// there when it's asked for again; it's kept until it's written. A chunk is a pure function of
/// where it is, so what comes back depends on nothing but the read, and a replay generates it
/// again. So when the terrain kept for chunks far from any wanted lately is too much, the
/// scheduler is let go and a new one starts, which makes again from nothing what it needs, and
/// memory doesn't grow with the chunks made (D220). The generator's thread also finds a new world's spawn, as
/// `setInitialSpawn` does: from the chunk `getOrigin` picks, which a worker finds, the first
/// column a player can stand on in the first chunk of the 11×11 around it that has one.
module server.chunk_jobs

import nbt.tag.{Tag}
import protocol.play.{LightData, LightLayer}
import server.log.{Entry}
import pack.vanilla.{data_path, vanilla_data}
import std.net.{Waker}
import std.pool.{workers}
import std.thread.{Task}
import std.memory.{trim}
import std.time.{Instant, Timestamp}
import storage.chunk.{ChunkData, ChunkFormat}
import storage.region.{Compression, ReadError, Stored, unpack}
import storage.regions.{ChunkRead, RegionStorage, encode_tag, read_root}
import world.chunk.{BlockStates, Chunk, MOTION_BLOCKING, MOTION_BLOCKING_NO_LEAVES, OCEAN_FLOOR, OCEAN_FLOOR_WG, Section, WORLD_SURFACE, WORLD_SURFACE_WG}
import world.collision.{CollisionStates}
import world.light.{LightStates, SkySources}
import world.pos.{BlockPos, ChunkPos}
import world.spawn.{respawn_pos}
import worldgen.generator.{GenSetup, Job, Made, Worker}
import worldgen.references.{chunk_key}
import worldgen.scheduler.{Scheduler}
import worldgen.template.{TemplateAsk}

/// The thread vanilla's region files log on, `Util.ioPool`'s first.
pub fn io_thread() -> String {
    return String("IO-Worker-1")
}

/// The thread vanilla reads a chunk's NBT on, the background executor's first.
pub fn parse_thread() -> String {
    return String("Worker-Main-1")
}

/// The thread Calcite's generator logs on.
pub fn gen_thread() -> String {
    return String("Worldgen")
}

// The most chunk workers, whatever the processors.
const MOST_WORKERS: usize = 8

// The most chunks the IO thread holds to write together.
const WRITE_BATCH: usize = 64

// How long the generator's thread waits with nothing coming in before it lets go of what its
// scheduler keeps, in nanoseconds (D228).
const SETTLE_NANOS: u64 = 5000000000

// How long a generator worker that's handed nothing keeps its copy of the generator's worker, in
// nanoseconds: then it lets go of it, with what it cached, and copies it again for its next job
// (D226).
const KEEP_COPY_NANOS: u64 = 5000000000

// How the generator's thread tells which kept terrain is far: a chunk wanted marks the cells of
// 16 × 16 chunks within `REACH` of it, as far as the jobs it needs reach through their ranks
// (D214), while it's one of the last `RECENT` chunks wanted and was wanted in the last
// `RECENT_NANOS`. Every `CHECK_EVERY` wanted, if more than `MOST_FAR` chunks' terrain is kept
// outside the marked cells, the scheduler starts again.
const CELL_SHIFT: i32 = 4
const REACH: i32 = 18
const RECENT: usize = 1024
const RECENT_NANOS: u64 = 30000000000
// The most chunks kept as read again, a few at most.
const MOST_REREAD: usize = 4096
// The most chunks kept as let go before they came to the generator's thread (D243).
const MOST_DROPPED: usize = 4096
const CHECK_EVERY: usize = 256
const MOST_FAR: usize = 1024

/// What a chunk is made from: the registries its NBT names things from, the block states'
/// table, and the dimension's sections, from its lowest up, with whether it has sky light; and
/// how it's compressed in its region file, as `region-file-compression` says.
pub struct ChunkContext {
    pub format: ChunkFormat
    pub table: BlockStates
    pub min_section: i32
    pub sections: i32
    pub sky_light: bool
    pub compression: Compression = Compression.Deflate
}

/// What a chunk read from its region file comes to.
pub enum Loaded {
    /// Nothing that can be used was saved, or it couldn't be read: the chunk is to be generated.
    Generate
    /// The chunk as it was saved.
    Saved(SavedChunk)
}

/// A chunk as it was saved: its blocks, its sky's sources worked out from them, as
/// `initializeLightSources` works them out, and its light, for the light engine to take.
pub struct SavedChunk {
    pub chunk: Chunk
    pub sources: SkySources
    /// The light saved for each section, from the one below the world to the one above, or
    /// `none` where there's none: the sky's, and the blocks'. Both are empty where none was
    /// saved, and once the level's light engine has taken what was.
    pub sky: List<List<u8>?>
    pub block: List<List<u8>?>
    /// Whether it was saved lit, its status `minecraft:light` or later with its light on, as
    /// vanilla's `isLighted` says, so its light isn't spread again.
    pub lighted: bool
}

impl SavedChunk {
    /// Its light as it was saved, as a packet sends it: each layer saved in the mask, with its
    /// data, from the section below the world up. Without the light engine, the masks of empty
    /// layers, which come from the sections next to blocks, aren't known, so none are sent.
    pub fn saved_light(self) -> LightData {
        return light_of(self.sky.copy(), self.block.copy())
    }
}

/// What the tick thread gets back.
pub enum Done {
    /// The region, by region coordinates, which of its chunks its file has, a bit each by
    /// `x + z * 32` in 16 words, and what the IO thread logged finding them.
    Region(ChunkPos, List<Entry>, List<u64>)
    /// The chunk, what the IO thread logged reading it and what it read, then what the workers
    /// logged making it, and what they made.
    Chunk(ChunkPos, List<Entry>, ChunkRead, List<Entry>, Loaded)
    /// Where the generator found a new world's spawn, and what it logged finding it.
    Spawn(BlockPos, List<Entry>)
    /// The chunk, which the generator was told nothing wants before it made it, so it didn't
    /// (D243), with what the IO thread logged reading it and the workers logged making it.
    Withdrawn(ChunkPos, List<Entry>, List<Entry>)
    /// The IO thread has written every chunk it was handed and closed the region files, as the
    /// server stops, and what it logged doing it.
    Closed(List<Entry>)
}

/// A chunk the generator finished, as the server takes it: its sky's sources worked out from its
/// blocks with `light`, and no light, which the server's engine works out. `sections` is the
/// dimension's.
pub fn generated(chunk: own Chunk, light: LightStates, sections: i32) -> SavedChunk {
    var sources = SkySources.new(chunk.min_y())
    sources.fill_from(chunk, light)
    // No light was saved for it, so its lists of saved light are empty, not a `none` for each
    // section: two lists of 26 took 1.8 KB a chunk.
    _ = sections
    return SavedChunk { chunk: chunk, sources: sources, sky: [], block: [], lighted: false }
}

/// What a chunk read from its region file comes to, as vanilla's `ChunkMap.scheduleChunkLoad`
/// makes it, with what it logs added to `lines`, each on the thread vanilla logs it on:
///
/// - a file that can't be read, or a chunk whose bytes or NBT can't be, logs "Failed to read
///   chunk [x, z]" on the IO thread and "Failed to load chunk x,z" on the server's, and is
///   generated;
/// - a chunk with no `Status` logs "Chunk file at [x, z] is missing level data, skipping" on the
///   background executor, and is generated, as is one that isn't saved at all;
/// - a chunk vanilla can't read logs "Failed to load chunk x,z", and is generated;
/// - a chunk saved under another position logs that it's in the wrong location, and that it
///   failed to load, and loads where it was asked for.
///
/// A chunk saved before its terrain, `minecraft:terrain`, is generated as one that isn't saved,
/// and so is one saved later than that but before it's full, which vanilla would go on
/// generating from where it was saved.
///
/// The rest loads as `SerializableChunkData.read` reads it: each section saved in the world in
/// its place, a later one over an earlier at the same height, and air with plains in each one
/// not saved; the light saved, the same way; each heightmap saved, and those not, of the four a
/// chunk keeps from its terrain on, worked out from the blocks. Its sky's sources are worked out
/// from its blocks with `light`, as the `initialize_light` status does first.
pub fn prepare(pos: ChunkPos, read: ChunkRead, context: ChunkContext, light: LightStates, lines: mut List<Entry>) -> Loaded {
    match read {
        ChunkRead.Absent => return Loaded.Generate,
        ChunkRead.Failed(e) => {
            failed_read(pos, e, mut lines)
            return Loaded.Generate
        },
        ChunkRead.Stored(stored) => return prepare_stored(pos, stored, context, light, mut lines),
    }
}

fn prepare_stored(pos: ChunkPos, stored: Stored, context: ChunkContext, light: LightStates, lines: mut List<Entry>) -> Loaded {
    var io = List<Entry>()
    var failed: ReadError? = none
    let unpacked: List<u8>? = match unpack(pos, stored, mut io) {
        ok(b) => b,
        err(e) => {
            failed = some(e)
            none
        },
    }
    on(io, io_thread(), mut lines)
    if let e = failed {
        failed_read(pos, e, mut lines)
        return Loaded.Generate
    }
    let bytes = unpacked else return Loaded.Generate
    let fields = match read_root(bytes) {
        ok(Tag.Compound(f)) => f,
        ok(_) => return Loaded.Generate,
        err(e) => {
            failed_read(pos, e, mut lines)
            return Loaded.Generate
        },
    }
    var parsing = List<Entry>()
    var broken = false
    let parsed: ChunkData? = match ChunkData.parse(context.format, context.min_section, context.sections, fields, mut parsing) {
        ok(d) => d,
        err(_) => {
            broken = true
            none
        },
    }
    on(parsing, parse_thread(), mut lines)
    if broken {
        lines.push(failed_load(pos))
        return Loaded.Generate
    }
    var data = parsed else {
        lines.push(Entry.error("Chunk file at {at(pos)} is missing level data, skipping").on(parse_thread()))
        return Loaded.Generate
    }
    if data.pos.x != pos.x or data.pos.z != pos.z {
        lines.push(Entry.error("Chunk file at {at(pos)} is in the wrong location; relocating. (Expected {at(pos)}, got {at(data.pos)})"))
        lines.push(failed_load(pos))
    }
    if not context.format.has_terrain(data.status) {
        return Loaded.Generate
    }
    let count = usize.wrap(context.sections)
    let light_count = count + 2
    var placed = List<Section?>()
    for _ in 0..count {
        placed.push(none)
    }
    var sky = List<List<u8>?>()
    var block = List<List<u8>?>()
    for _ in 0..light_count {
        sky.push(none)
        block.push(none)
    }
    // From the last saved back, so the first found at a height is the one that's kept.
    while let popped = data.sections.pop() {
        var section = popped
        let i = section.y - context.min_section
        if i >= 0 and usize.wrap(i) < count and placed[usize.wrap(i)] == none {
            if let states = section.blocks.take() {
                if let biomes = section.biomes.take() {
                    placed[usize.wrap(i)] = some(Section.from(context.table, states, biomes))
                }
            }
        }
        let l = i + 1
        if l >= 0 and usize.wrap(l) < light_count {
            let at_l = usize.wrap(l)
            if block[at_l] == none {
                if let layer = section.block_light {
                    block[at_l] = some(nibbles(layer))
                }
            }
            if context.sky_light and sky[at_l] == none {
                if let layer = section.sky_light {
                    sky[at_l] = some(nibbles(layer))
                }
            }
        }
    }
    var sections = List<Section>()
    for i in 0..count {
        sections.push(placed[i].take() ?? Section.new(context.table, context.format.plains))
    }
    var chunk = Chunk.of(context.min_section * 16, sections)
    var to_prime: List<i32> = [WORLD_SURFACE, OCEAN_FLOOR, MOTION_BLOCKING, MOTION_BLOCKING_NO_LEAVES]
    for kind in [WORLD_SURFACE_WG, WORLD_SURFACE, OCEAN_FLOOR_WG, OCEAN_FLOOR, MOTION_BLOCKING, MOTION_BLOCKING_NO_LEAVES] {
        let saved = data.heightmaps[usize.wrap(kind)].take() else continue
        let got = saved.len()
        if let want = chunk.set_heightmap(kind, saved) {
            lines.push(Entry.warn("Ignoring heightmap data for chunk {at(pos)}, size does not match; expected: {want}, got: {got}"))
            chunk.prime_heightmaps(context.table, [kind])
        }
        var left = List<i32>()
        for k in to_prime {
            if k != kind {
                left.push(k)
            }
        }
        to_prime = left
    }
    chunk.prime_heightmaps(context.table, to_prime)
    var sources = SkySources.new(context.min_section * 16)
    sources.fill_from(chunk, light)
    let lighted = context.format.has_light(data.status) and data.light_correct
    return Loaded.Saved(SavedChunk { chunk: chunk, sources: sources, sky: sky, block: block, lighted: lighted })
}

// The light a chunk's saved layers send, as vanilla's light packet sends each layer its engine
// has: in the mask, with its data, from the section below the world up.
fn light_of(sky: own List<List<u8>?>, block: own List<List<u8>?>) -> LightData {
    var sky_layers = sky
    var block_layers = block
    var sky_bits = List<bool>()
    var block_bits = List<bool>()
    let sky_data = layers(mut sky_layers, mut sky_bits)
    let block_data = layers(mut block_layers, mut block_bits)
    return LightData { sky_mask: mask(sky_bits), block_mask: mask(block_bits), empty_sky_mask: [], empty_block_mask: [], sky: sky_data, block: block_data }
}

// The layers there are, from the lowest, with a bit in `bits` for each place, set where there's
// one.
fn layers(from: mut List<List<u8>?>, bits: mut List<bool>) -> List<LightLayer> {
    var out = List<LightLayer>()
    for i in 0..from.len() {
        if let data = from[i].take() {
            bits.push(true)
            out.push(LightLayer { data: data })
        } else {
            bits.push(false)
        }
    }
    return out
}

// The bits as `BitSet.toByteArray` gives them: 8 to a byte from the lowest, low bit first, with
// no zero bytes at the end.
fn mask(bits: List<bool>) -> List<u8> {
    var out = List<u8>()
    for i in 0..bits.len() {
        if i % 8 == 0 {
            out.push(0)
        }
        if bits[i] {
            let last = out.len() - 1
            out[last] = out[last] | u8.wrap(1 << i32.wrap(i % 8))
        }
    }
    while not out.is_empty() and out[out.len() - 1] == 0 {
        _ = out.pop()
    }
    return out
}

fn nibbles(layer: List<i8>) -> List<u8> {
    var out = List<u8>()
    for b in layer {
        out.push(u8.wrap(b))
    }
    return out
}

// What a read that failed logs: the IO worker's warning, then the server's error.
fn failed_read(pos: ChunkPos, e: ReadError, lines: mut List<Entry>) {
    _ = e
    lines.push(Entry.warn("Failed to read chunk {at(pos)}").on(io_thread()))
    lines.push(failed_load(pos))
}

// `reportChunkLoadFailure`'s line.
fn failed_load(pos: ChunkPos) -> Entry {
    return Entry.error("Failed to load chunk {pos.x},{pos.z}")
}

// A chunk's position as `ChunkPos.toString` writes it.
fn at(pos: ChunkPos) -> String {
    return "[{pos.x}, {pos.z}]"
}

// Adds `from` to `to`, each on `thread`.
fn on(from: List<Entry>, thread: String, to: mut List<Entry>) {
    for e in from {
        to.push(e.copy().on(thread.copy()))
    }
}

// --- The threads ---

// What the IO thread is asked: which chunks a region's file has, a chunk read, a chunk, encoded,
// written, or everything written and the files closed.
enum Ask {
    Region(ChunkPos)
    Chunk(ChunkPos)
    Write(ChunkPos, List<u8>)
    Close
}

// A chunk the IO thread read, on its way to a worker.
struct Work {
    pos: ChunkPos
    lines: List<Entry>
    read: ChunkRead
}

// The IO thread: it owns the region files, and reads and writes what it's asked, in the order
// it's asked. The chunks to write wait until nothing else is asked, or there are
// `WRITE_BATCH`, and go out together, a region's at once, before anything's read; the
// generator's thread is told which are on the disk. Once it's closed, it writes nothing more.
struct IoThread {
    storage: RegionStorage
    asks: Receiver<Ask>
    work: Sender<Work>
    done: Sender<Done>
    gen: Sender<GenIn>
    waker: Waker
}

impl Task for IoThread {
    fn run(own self) {
        var storage = self.storage
        var asks = self.asks
        var work = self.work
        var done = self.done
        var gen = self.gen
        var writes = List<(ChunkPos, List<u8>?)>()
        var closed = false
        loop {
            var got = asks.next()
            if got == none {
                if not writes.is_empty() {
                    write_out(mut storage, mut writes, mut gen)
                    continue
                }
                got = asks.wait()
            }
            let ask = got else return
            match ask {
                Ask.Write(pos, bytes) => {
                    if not closed {
                        writes.push((pos, some(bytes)))
                        if writes.len() >= WRITE_BATCH {
                            write_out(mut storage, mut writes, mut gen)
                        }
                    }
                },
                Ask.Close => {
                    if not writes.is_empty() {
                        write_out(mut storage, mut writes, mut gen)
                    }
                    var logged = List<Entry>()
                    match storage.close() {
                        ok => {},
                        err(e) => logged.push(Entry.error("Failed to close the region files: {e}")),
                    }
                    var lines = List<Entry>()
                    on(logged, io_thread(), mut lines)
                    closed = true
                    done.send(Done.Closed(lines))
                    self.waker.wake()
                },
                Ask.Region(region) => {
                    if not writes.is_empty() {
                        write_out(mut storage, mut writes, mut gen)
                    }
                    var logged = List<Entry>()
                    let presence = storage.presence(region, mut logged)
                    var lines = List<Entry>()
                    on(logged, io_thread(), mut lines)
                    done.send(Done.Region(region, lines, presence))
                    self.waker.wake()
                },
                Ask.Chunk(pos) => {
                    if not writes.is_empty() {
                        write_out(mut storage, mut writes, mut gen)
                    }
                    var logged = List<Entry>()
                    let read = storage.read_chunk(pos, mut logged)
                    var lines = List<Entry>()
                    on(logged, io_thread(), mut lines)
                    work.send(Work { pos: pos, lines: lines, read: read })
                },
            }
        }
    }
}

// Writes the chunks waiting, then tells the generator's thread which are on the disk: none if
// the write failed, when each logs vanilla's `IOWorker` line, and they're kept to hand back.
fn write_out(storage: mut RegionStorage, writes: mut List<(ChunkPos, List<u8>?)>, gen: mut Sender<GenIn>) {
    var logged = List<Entry>()
    var keys = List<i64>()
    let now = i32.wrap(unsafe { Timestamp.now() }.unix_ms / 1000)
    match storage.write(writes, now, mut logged) {
        ok => {
            for w in writes {
                keys.push(chunk_key(w.0.x, w.0.z))
            }
        },
        err(e) => {
            for w in writes {
                logged.push(Entry.error("Failed to store chunk {at(w.0)}: {e}"))
            }
        },
    }
    writes.clear()
    var lines = List<Entry>()
    on(logged, io_thread(), mut lines)
    gen.send(GenIn.Written(keys, lines))
}

// A chunk worker: it makes each chunk the IO thread read, sends it back, and wakes the poll; one
// with nothing to use goes to the generator, if the world generates. It works out the block
// states' light properties with the first chunk it's handed.
struct ChunkWorker {
    context: ChunkContext
    work: Receiver<Work>
    done: Sender<Done>
    generate: Sender<GenIn>?
    waker: Waker
}

impl Task for ChunkWorker {
    fn run(own self) {
        var work = self.work
        var done = self.done
        var generate = self.generate
        var states: LightStates? = none
        while let w = work.wait() {
            var lines = List<Entry>()
            let made = states.take() ?? LightStates.new()
            let loaded = prepare(w.pos, w.read, self.context, made, mut lines)
            states = some(made)
            var handed = false
            match loaded {
                Loaded.Generate => {
                    if let held = generate.take() {
                        var g = held
                        g.send(GenIn.Make(GenWork { pos: w.pos, io: w.lines.copy(), read: w.read.copy(), made: lines.copy() }))
                        generate = some(g)
                        handed = true
                    }
                },
                _ => {},
            }
            if not handed {
                done.send(Done.Chunk(w.pos, w.lines, w.read, lines, loaded))
                self.waker.wake()
            }
        }
    }
}

// What the generator's thread is handed: a chunk to generate, with what reading it logged; what a
// job of a scheduler's epoch made, or a chunk a worker finished as the server's, with its bytes
// for its region file, none if it couldn't be encoded; the chunks the IO thread wrote, with what
// it logged; the chunk a worker found the spawn is looked for from; or a new world's spawn to
// find; or a chunk nothing wants any more (D243).
enum GenIn {
    Make(GenWork)
    Drop(ChunkPos)
    Made(u32, Made)
    Finished(u32, i32, i32, SavedChunk, List<u8>?)
    Written(List<i64>, List<Entry>)
    Origin(i32, i32, String?)
    Spawn
}

// A chunk to generate, with what the IO thread logged and read, and what the worker logged.
struct GenWork {
    pos: ChunkPos
    io: List<Entry>
    read: ChunkRead
    made: List<Entry>
}

// What a generator worker is handed: a job, with its scheduler's epoch, or the search for the
// chunk the spawn is looked for from.
enum GenTask {
    Job(u32, Job)
    Origin
}

// A generator worker: with its own copy of the generator's `Worker`, it does each job it's handed
// and hands back what it made, a chunk finished as the server's, with its sky's sources worked out
// here, and encoded for its region file.
struct GenWorker {
    worker: Shared<Worker>
    context: ChunkContext
    tasks: Receiver<GenTask>
    out: Sender<GenIn>
}

impl Task for GenWorker {
    fn run(own self) {
        let GenWorker { worker: worker, context: context, tasks: taken, out: sender } = self
        var tasks = taken
        var out = sender
        // The thread copies the worker for itself when it's first handed something, and lets go
        // of the copy, with the templates, pools, features and noise it cached, once it's been
        // handed nothing for a while; the next job copies it again. What a chunk comes to doesn't
        // depend on which worker makes it, or what it made before (D226).
        var held: Worker? = none
        let light = LightStates.new()
        loop {
            var next: GenTask? = none
            if held == none {
                next = tasks.wait()
            } else {
                next = unsafe { tasks.wait_for(KEEP_COPY_NANOS) }
                if next == none {
                    held = none
                    next = tasks.wait()
                }
            }
            let task = next else return
            var w = held.take() ?? worker.value.copy()
            match task {
                GenTask.Origin => {
                    match w.origin() {
                        ok(o) => {
                            let (x, z) = o
                            out.send(GenIn.Origin(x, z, none))
                        },
                        err(t) => out.send(GenIn.Origin(0, 0, some("Couldn't find the spawn's chunk: {t.exception}: {t.message}"))),
                    }
                },
                GenTask.Job(epoch, job) => {
                    let made = w.run(job)
                    let finished = match made {
                        Made.Finished(_, _, _) => true,
                        _ => false,
                    }
                    if finished {
                        match made {
                            Made.Finished(x, z, chunk) => {
                                let bytes: List<u8>? = match ChunkData.generated(context.format, ChunkPos { x: x, z: z }, chunk).write(context.format) {
                                    ok(root) => some(encode_tag(root, context.compression)),
                                    err(_) => none,
                                }
                                out.send(GenIn.Finished(epoch, x, z, generated(chunk, light, context.sections), bytes))
                            },
                            _ => {},
                        }
                    } else {
                        out.send(GenIn.Made(epoch, made))
                    }
                },
            }
            held = some(w)
        }
    }
}

// The search for a new world's spawn: the chunk it's from, the offsets of the chunks it tries in
// order, the one it's trying, and whether that one's asked for.
struct SpawnFind {
    x: i32
    z: i32
    offsets: List<(i32, i32)>
    at: usize
    asked: bool
}

// The offsets of the 11×11 chunks around a new world's spawn chunk, in the order
// `setInitialSpawn` tries them: a spiral out from the middle.
fn spiral() -> List<(i32, i32)> {
    var out = List<(i32, i32)>()
    var x = 0
    var z = 0
    var dx = 0
    var dz = -1
    for _ in 0..121 {
        if x >= -5 and x <= 5 and z >= -5 and z <= 5 {
            out.push((x, z))
        }
        if x == z or (x < 0 and x == -z) or (x > 0 and x == 1 - z) {
            let old = dx
            dx = -dz
            dz = old
        }
        x += dx
        z += dz
    }
    return out
}

// The generator's thread: its workers, made from the setup, each on a thread of its own, and
// the queue to the IO thread, which writes what they finish.
struct GenThread {
    setup: GenSetup
    context: ChunkContext
    inbox: Receiver<GenIn>
    to_inbox: Sender<GenIn>
    to_io: Sender<Ask>
    done: Sender<Done>
    waker: Waker
    workers: usize
}

// Where the generator's thread hands back what it made: the queue back, and what wakes the poll.
struct GenOut {
    done: Sender<Done>
    waker: Waker
}

// What the generator's thread keeps as it goes.
struct GenState {
    // The jobs' scheduler and the queue to the workers, none where nothing generates, and the
    // queue to the IO thread.
    sched: Scheduler?
    to_tasks: Sender<GenTask>?
    to_io: Sender<Ask>
    workers: usize
    // The scheduler's epoch, which each job it hands out carries, and how many jobs of earlier
    // ones are still out: what they make is let go, but for a finished chunk, which is what it
    // is whichever scheduler made it.
    epoch: u32 = 0
    stale: usize = 0
    // The chunks wanted lately, oldest first, each with when, in nanoseconds from when the
    // thread began; the cells about them each marks, by `chunk_key` of the cell, with how many
    // of them mark it; and how many have been wanted since the far terrain was last counted.
    recent: Deque<(i64, u64)> = Deque<(i64, u64)>()
    began: Instant
    hot: Map<i64, u32> = Map<i64, u32>()
    wants: usize = 0
    // The service that loads the structure templates for every worker.
    to_templates: Sender<TemplateAsk>? = none
    collisions: CollisionStates? = none
    // The chunks asked for and not handed back, by `chunk_key`, and each finished, as it was
    // handed back, until it's written, to hand back again if it's asked for again. Those
    // written while the spawn is looked for are kept until it's found, as the search may try
    // them.
    asked: Map<i64, List<GenWork>> = Map<i64, List<GenWork>>()
    finished: Map<i64, SavedChunk> = Map<i64, SavedChunk>()
    held: List<i64> = List<i64>()
    // The chunks asked for after they were written and let go, by a read from before they were
    // written, which are read again.
    reread: Map<i64, bool> = Map<i64, bool>()
    // The chunks let go before they came to be made, which are handed back unmade when they come
    // (D243).
    dropped: Map<i64, bool> = Map<i64, bool>()
    // Whether a new world's spawn is to be found, and its search, once its origin's found.
    spawn_wanted: bool = false
    spawn: SpawnFind? = none
    // What's been logged since the last chunk handed back.
    lines: List<Entry> = List<Entry>()
}

impl Task for GenThread {
    fn run(own self) {
        let GenThread { setup: setup, context: context, inbox: taken, to_inbox: to_inbox, to_io: to_io, done: done, waker: waker, workers: count } = self
        var inbox = taken
        var out = GenOut { done: done, waker: waker }
        var s = GenState { sched: none, to_tasks: none, to_io: to_io, workers: count.max(1), began: unsafe { Instant.now() } }
        match vanilla_data(data_path(), mut s.lines) {
            ok(zip) => {
                // One worker is made, and each thread gets a copy: reading vanilla's data on
                // every thread at once took 40 MB each while it was read, which the allocator
                // kept (D220).
                match Worker.new(zip, setup) {
                    ok(first) => {
                        // The templates are loaded once, by a service every copy asks.
                        var made = first
                        s.to_templates = some(made.serve_templates())
                        s.sched = some(Scheduler.new(made.structures(), made.ring_searches()))
                        // Each thread copies the one worker for itself, when it's first handed
                        // something, so the copies are made at once; one after another, the last
                        // worker started half a second later. The queue's sender is made first: a
                        // worker that waits on a queue with none would end at once.
                        let shared = Shared(made)
                        let tasks = Receiver<GenTask>()
                        s.to_tasks = some(tasks.sender())
                        for _ in 0..s.workers {
                            _ = unsafe { Thread.spawn(GenWorker { worker: shared.copy(), context: context.copy(), tasks: tasks.share(), out: to_inbox.share() }) }
                        }
                    },
                    err(e) => s.lines.push(Entry.error("Can't generate the world, so its chunks are flat: {e}").on(gen_thread())),
                }
            },
            err(e) => s.lines.push(Entry.error("Can't generate the world, so its chunks are flat: {e}").on(gen_thread())),
        }
        loop {
            var progressed = false
            // What's come, without waiting.
            while let m = inbox.next() {
                out.take_in(mut s, m)
                progressed = true
            }
            if out.step(mut s) {
                progressed = true
            }
            if not progressed {
                // Nothing for a while: everything asked for has been handed back, and nothing
                // more is, so what the scheduler keeps goes (D228).
                var next = unsafe { inbox.wait_for(SETTLE_NANOS) }
                if next == none {
                    settle(mut s)
                    next = inbox.wait()
                }
                let m = next else return
                out.take_in(mut s, m)
            }
        }
    }
}

impl GenOut {
    // Takes in what came to the generator's thread.
    fn take_in(mut self, s: mut GenState, m: own GenIn) {
        match m {
            GenIn.Make(w) => {
                let key = chunk_key(w.pos.x, w.pos.z)
                let x = w.pos.x
                let z = w.pos.z
                let was_dropped = s.dropped.remove(key) != none
                if s.finished.contains(key) {
                    let saved = s.finished[key].copy()
                    self.hand_back(mut s, w, Loaded.Saved(saved))
                } else if was_dropped and not spawn_tries(s, x, z) {
                    self.withdraw(w)
                } else if s.asked.contains(key) {
                    s.asked[key].push(w)
                } else if written(s, x, z) and not s.reread.contains(key) {
                    // Read before it was written: read again, and it's there.
                    if s.reread.len() >= MOST_REREAD {
                        s.reread = Map<i64, bool>()
                    }
                    s.reread.insert(key, true)
                    s.to_io.send(Ask.Chunk(w.pos))
                } else {
                    s.asked.insert(key, [w])
                    if s.reread.contains(key) {
                        // Not there when it was read again: it's made again from nothing.
                        _ = s.reread.remove(key)
                        if let g = s.sched.take() {
                            s.sched = some(renewed(mut s, g))
                        }
                    } else if let g = s.sched.take() {
                        var sched = g
                        sched.want(x, z)
                        s.sched = some(sched)
                    }
                    wanted(mut s, x, z)
                }
            },
            GenIn.Drop(pos) => self.drop(mut s, pos),
            GenIn.Made(epoch, made) => {
                if epoch != s.epoch {
                    s.stale -= 1
                } else if let g = s.sched.take() {
                    var sched = g
                    sched.take(made)
                    s.sched = some(sched)
                }
            },
            GenIn.Finished(epoch, x, z, saved, bytes) => self.finished(mut s, epoch, x, z, saved, bytes),
            GenIn.Written(keys, lines) => {
                for e in lines {
                    s.lines.push(e.copy())
                }
                for k in keys {
                    if s.spawn_wanted or s.spawn != none {
                        s.held.push(k)
                    } else {
                        _ = s.finished.remove(k)
                    }
                }
            },
            GenIn.Origin(x, z, problem) => {
                if let p = problem {
                    s.lines.push(Entry.warn(p.copy()).on(gen_thread()))
                }
                s.spawn = some(SpawnFind { x: x, z: z, offsets: spiral(), at: 0, asked: false })
            },
            GenIn.Spawn => {
                s.spawn_wanted = true
                if let t = s.to_tasks.take() {
                    var tasks = t
                    tasks.send(GenTask.Origin)
                    s.to_tasks = some(tasks)
                }
            },
        }
    }

    // Does what can be done without waiting: the spawn's next chunk asked for, and the most
    // urgent jobs out while the workers have fewer than two each. Where nothing generates, each
    // chunk asked for goes back to be flat, and the spawn is its chunk's middle. Whether anything
    // was done.
    fn step(mut self, s: mut GenState) -> bool {
        var sched = s.sched.take() else {
            var any = false
            var keys = List<i64>()
            for (k, _) in s.asked {
                keys.push(k)
            }
            for k in keys {
                var works = s.asked.remove(k) else continue
                while let w = works.pop() {
                    self.hand_back(mut s, w, Loaded.Generate)
                }
                any = true
            }
            if s.spawn_wanted {
                var x = 0
                var z = 0
                if let f = s.spawn.take() {
                    x = f.x
                    z = f.z
                }
                s.spawn_wanted = false
                self.spawn_found(mut s, BlockPos { x: x * 16 + 8, y: 64, z: z * 16 + 8 })
                any = true
            }
            return any
        }
        var progressed = false
        if s.wants >= CHECK_EVERY {
            s.wants = 0
            if sched.kept_outside(s.hot, CELL_SHIFT) > MOST_FAR {
                sched = renewed(mut s, sched)
                progressed = true
            }
        }
        if self.spawn_next(mut s, mut sched) {
            progressed = true
        }
        if let t = s.to_tasks.take() {
            var tasks = t
            while sched.running() + s.stale < s.workers * 2 {
                let job = sched.next() else break
                tasks.send(GenTask.Job(s.epoch, job))
                progressed = true
            }
            s.to_tasks = some(tasks)
        }
        for p in sched.problems {
            s.lines.push(Entry.warn(p.copy()).on(gen_thread()))
        }
        sched.problems.clear()
        s.sched = some(sched)
        return progressed
    }

    // Asks for the spawn's next chunk, checking each already finished as it goes. Whether it
    // did anything.
    fn spawn_next(mut self, s: mut GenState, sched: mut Scheduler) -> bool {
        var any = false
        while let f = s.spawn.take() {
            var find = f
            if find.asked {
                s.spawn = some(find)
                return any
            }
            let (ox, oz) = find.offsets[find.at]
            let key = chunk_key(find.x + ox, find.z + oz)
            any = true
            if s.finished.contains(key) {
                let saved = s.finished[key].copy()
                s.spawn = some(find)
                self.check_spawn(mut s, saved.chunk)
            } else {
                let wx = find.x + ox
                let wz = find.z + oz
                sched.want(wx, wz)
                find.asked = true
                s.spawn = some(find)
                wanted(mut s, wx, wz)
                return any
            }
        }
        return any
    }

    // Checks the spawn's chunk, finished, for a column a player can stand on: the spawn's found
    // if there is one, or if it was the last chunk to try, where the spawn is its origin chunk's
    // middle; else the next is tried.
    fn check_spawn(mut self, s: mut GenState, chunk: Chunk) {
        var find = s.spawn.take() else return
        let (ox, oz) = find.offsets[find.at]
        let cx = find.x + ox
        let cz = find.z + oz
        if s.collisions == none {
            s.collisions = some(CollisionStates.new())
        }
        var found: BlockPos? = none
        if let states = s.collisions {
            found = spawn_in(states, chunk, cx, cz)
        }
        find.at += 1
        find.asked = false
        if found == none and find.at >= find.offsets.len() {
            found = some(BlockPos { x: find.x * 16 + 8, y: 64, z: find.z * 16 + 8 })
        }
        if let pos = found {
            s.spawn_wanted = false
            self.spawn_found(mut s, pos)
        } else {
            s.spawn = some(find)
        }
    }

    // Hands back the chunk a worker finished, for the scheduler of `epoch`, to each that asked for
    // it, checks it for the spawn if it's the chunk the spawn's search is trying, and keeps it
    // while the IO thread writes `bytes`, or for good if there are none. One nothing asked for or
    // tries was made again after it was handed back, by a scheduler that started again, and goes.
    fn finished(mut self, s: mut GenState, epoch: u32, x: i32, z: i32, saved: own SavedChunk, bytes: own List<u8>?) {
        if epoch != s.epoch {
            s.stale -= 1
        } else if let g = s.sched.take() {
            var sched = g
            sched.finished_at(x, z)
            s.sched = some(sched)
        }
        let key = chunk_key(x, z)
        var works = s.asked.remove(key) ?? List<GenWork>()
        let spawn_here = spawn_tries(s, x, z)
        if works.is_empty() and not spawn_here {
            if epoch == s.epoch {
                // Let go while it was being finished (D243): it's written all the same, as the
                // scheduler has it finished, and a read would look for it.
                s.finished.insert(key, saved)
                if let b = bytes {
                    s.to_io.send(Ask.Write(ChunkPos { x: x, z: z }, b))
                }
            }
            return
        }
        while not works.is_empty() {
            let w = works.remove(0)
            self.hand_back(mut s, w, Loaded.Saved(saved.copy()))
        }
        if spawn_here {
            self.check_spawn(mut s, saved.chunk)
        }
        s.finished.insert(key, saved)
        if let b = bytes {
            s.to_io.send(Ask.Write(ChunkPos { x: x, z: z }, b))
        }
    }

    // Nothing wants the chunk at `pos` any more (D243). Asked for and not made, it's handed back
    // unmade, and the scheduler drops the jobs only it needed, unless the spawn's search is trying
    // it. Not yet come, it's handed back unmade when it comes. Finished, it goes back as it is.
    fn drop(mut self, s: mut GenState, pos: ChunkPos) {
        let key = chunk_key(pos.x, pos.z)
        if s.finished.contains(key) {
            return
        }
        var works = s.asked.remove(key) else {
            if s.dropped.len() >= MOST_DROPPED {
                s.dropped = Map<i64, bool>()
            }
            s.dropped.insert(key, true)
            return
        }
        while not works.is_empty() {
            self.withdraw(works.remove(0))
        }
        if spawn_tries(s, pos.x, pos.z) {
            return
        }
        if let g = s.sched.take() {
            var sched = g
            sched.unwant(pos.x, pos.z)
            s.sched = some(sched)
        }
    }

    // Hands back the chunk `w` asked for unmade, as nothing wants it (D243). What the generator
    // logged waits for the next chunk handed back.
    fn withdraw(mut self, w: own GenWork) {
        self.done.send(Done.Withdrawn(w.pos, w.io, w.made))
        self.waker.wake()
    }

    // Hands back the chunk `w` asked for, with what was logged since the last.
    fn hand_back(mut self, s: mut GenState, w: own GenWork, loaded: own Loaded) {
        var made = w.made.copy()
        for e in s.lines {
            made.push(e.copy())
        }
        s.lines.clear()
        self.done.send(Done.Chunk(w.pos, w.io, w.read, made, loaded))
        self.waker.wake()
    }

    // Hands back where the spawn is, with what was logged since the last, and lets go of the
    // chunks written while it was looked for.
    fn spawn_found(mut self, s: mut GenState, pos: BlockPos) {
        self.done.send(Done.Spawn(pos, s.lines.copy()))
        s.lines.clear()
        self.waker.wake()
        for k in s.held {
            _ = s.finished.remove(k)
        }
        s.held.clear()
    }
}

// A scheduler started again from `old`, with nothing made but the strongholds' rings it
// found, of the next epoch, wanting each chunk asked for and not handed back, nearest the
// chunk wanted last first, and the chunk the spawn's search is trying. What the old one has
// out is let go as it comes back.
fn renewed(s: mut GenState, old: own Scheduler) -> Scheduler {
    for p in old.problems {
        s.lines.push(Entry.warn(p.copy()).on(gen_thread()))
    }
    s.stale += old.running()
    s.epoch += 1
    var fresh = old.renewed()
    var keys = List<i64>()
    for (k, _) in s.asked {
        keys.push(k)
    }
    var last: i64 = 0
    if let r = s.recent.last() {
        last = r.0
    }
    let lx = i32.wrap(last)
    let lz = i32.wrap(last >> 32)
    var order = List<i64>()
    for i in 0..keys.len() {
        let away = (i32.wrap(keys[i]) - lx).abs().max((i32.wrap(keys[i] >> 32) - lz).abs())
        order.push((i64(away) << 32) | i64.wrap(i))
    }
    order.sort()
    for o in order {
        let k = keys[usize.wrap(o & 0xFFFFFFFF)]
        fresh.want(i32.wrap(k), i32.wrap(k >> 32))
    }
    if let find = s.spawn {
        if find.asked {
            let (ox, oz) = find.offsets[find.at]
            fresh.want(find.x + ox, find.z + oz)
        }
    }
    return fresh
}

// The generator's thread has had nothing come in for a while, so nothing is waiting to be made:
// what the scheduler keeps of the chunks around those it made goes, and is made again, the same,
// if it's needed, and the templates' service lets go of what it loaded (D220, D228). What the
// busy while freed goes back to the system: what's free now, and the next time what's been freed
// since, as the workers let go of their copies (CLX-114, D226).
fn settle(s: mut GenState) {
    if not s.asked.is_empty() or s.spawn != none or s.spawn_wanted {
        return
    }
    if let g = s.sched.take() {
        if g.holds_any() {
            s.sched = some(renewed(mut s, g))
            forget(mut s)
        } else {
            s.sched = some(g)
        }
    }
    trim()
}

// Has the templates' service let go of the templates it loaded. The workers have let go of their
// copies of the generator's worker by now, each a while after its last job, so once those that
// still hold some are let go too, they're freed (D226).
fn forget(s: mut GenState) {
    if let t = s.to_templates.take() {
        var templates = t
        templates.send(TemplateAsk.Forget)
        s.to_templates = some(templates)
    }
}

// Whether the spawn's search is trying the chunk at `x`, `z`.
fn spawn_tries(s: GenState, x: i32, z: i32) -> bool {
    if let find = s.spawn {
        let (ox, oz) = find.offsets[find.at]
        return find.asked and find.x + ox == x and find.z + oz == z
    }
    return false
}

// Whether the chunk at `x`, `z` was finished by the scheduler and isn't kept: it was handed back
// and written.
fn written(s: GenState, x: i32, z: i32) -> bool {
    if let sched = s.sched {
        return sched.is_finished(x, z)
    }
    return false
}

// Notes that the chunk at `x`, `z` is wanted: it marks the cells within `REACH` of it, and those
// wanted before the last `RECENT`, or longer ago than `RECENT_NANOS`, stop marking them.
fn wanted(s: mut GenState, x: i32, z: i32) {
    let now = unsafe { Instant.now() }.nanos_since(s.began)
    s.recent.push_last((chunk_key(x, z), now))
    mark(mut s.hot, x, z, true)
    while let r = s.recent.first() {
        let (k, when) = r
        if s.recent.len() <= RECENT and when + RECENT_NANOS >= now {
            break
        }
        _ = s.recent.pop_first()
        mark(mut s.hot, i32.wrap(k), i32.wrap(k >> 32), false)
    }
    s.wants += 1
}

// Marks the cells within `REACH` of the chunk at `x`, `z` once more, or once fewer.
fn mark(hot: mut Map<i64, u32>, x: i32, z: i32, more: bool) {
    for cz in (z - REACH) >> CELL_SHIFT..((z + REACH) >> CELL_SHIFT) + 1 {
        for cx in (x - REACH) >> CELL_SHIFT..((x + REACH) >> CELL_SHIFT) + 1 {
            let c = chunk_key(cx, cz)
            let n = hot.get(c) ?? 0
            if more {
                hot.insert(c, n + 1)
            } else if n <= 1 {
                _ = hot.remove(c)
            } else {
                hot.insert(c, n - 1)
            }
        }
    }
}

// `PlayerSpawnFinder.getSpawnPosInChunk`: the first column of the chunk, `x` then `z` from its
// lower corner, a player can stand on.
fn spawn_in(states: CollisionStates, chunk: Chunk, cx: i32, cz: i32) -> BlockPos? {
    for x in cx * 16..cx * 16 + 16 {
        for z in cz * 16..cz * 16 + 16 {
            if let pos = respawn_pos(states, chunk, x, z) {
                return some(pos)
            }
        }
    }
    return none
}

/// The IO thread and the chunk workers, and the generator's thread if the world generates, and
/// the queues to and from them, which start with the first thing asked.
pub struct ChunkJobs {
    context: ChunkContext
    // The region files, until the IO thread takes them, and what wakes the poll.
    storage: RegionStorage?
    waker: Waker
    // What the generator's made from, until its thread takes it, and the queue to that thread.
    gen: GenSetup?
    gen_inbox: Receiver<GenIn>
    to_gen: Sender<GenIn>?
    asks: Receiver<Ask>
    to_asks: Sender<Ask>
    work: Receiver<Work>
    to_work: Sender<Work>
    done: Receiver<Done>
    to_done: Sender<Done>
    started: usize
    most: usize
    // How many chunks are asked for and not back, how many regions, and whether the spawn is.
    chunks_away: usize
    regions_away: usize
    spawn_away: usize
    // Whether the IO thread is closing the region files.
    closing_away: usize = 0
}

impl ChunkJobs {
    /// The jobs for the region files in `folder`, which make chunks with `context`, generate those
    /// they find nothing to use of as `gen` says, if it's given, and wake the server's poll with
    /// `waker` as each is done.
    pub fn new(folder: String, context: own ChunkContext, gen: own GenSetup?, waker: Waker) -> ChunkJobs {
        let gen_inbox = Receiver<GenIn>()
        var to_gen: Sender<GenIn>? = none
        if gen != none {
            to_gen = some(gen_inbox.sender())
        }
        let asks = Receiver<Ask>()
        let to_asks = asks.sender()
        let work = Receiver<Work>()
        let to_work = work.sender()
        let done = Receiver<Done>()
        let to_done = done.sender()
        let processors = unsafe { workers() }
        var most = if processors > 2 { processors - 1 } else { 1 }
        if most > MOST_WORKERS {
            most = MOST_WORKERS
        }
        return ChunkJobs {
            context: context,
            storage: some(RegionStorage.new(folder, false)),
            waker: waker,
            gen: gen,
            gen_inbox: gen_inbox,
            to_gen: to_gen,
            asks: asks,
            to_asks: to_asks,
            work: work,
            to_work: to_work,
            done: done,
            to_done: to_done,
            started: 0,
            most: most,
            chunks_away: 0,
            regions_away: 0,
            spawn_away: 0,
        }
    }

    /// Asks the generator where a new world's spawn is.
    pub fn ask_spawn(mut self) {
        self.start()
        if let held = self.to_gen.take() {
            var g = held
            g.send(GenIn.Spawn)
            self.to_gen = some(g)
            self.spawn_away += 1
        }
    }

    /// Asks which chunks `region`'s file has.
    pub fn ask_region(mut self, region: ChunkPos) {
        self.start()
        self.to_asks.send(Ask.Region(region))
        self.regions_away += 1
    }

    /// Asks for the chunk at `pos`, starting another worker if each started has a chunk.
    pub fn ask_chunk(mut self, pos: ChunkPos) {
        self.start()
        if self.chunks_away >= self.started and self.started < self.most {
            var generate: Sender<GenIn>? = none
            if let g = self.to_gen {
                generate = some(g.share())
            }
            _ = unsafe { Thread.spawn(ChunkWorker { context: self.context.copy(), work: self.work.share(), done: self.to_done.share(), generate: generate, waker: self.waker }) }
            self.started += 1
        }
        self.to_asks.send(Ask.Chunk(pos))
        self.chunks_away += 1
    }

    /// Tells the generator nothing wants the chunk at `pos` any more, if the world generates: it
    /// comes back as `Done.Withdrawn` if it wasn't made (D243).
    pub fn drop_chunk(mut self, pos: ChunkPos) {
        if let held = self.to_gen.take() {
            var g = held
            g.send(GenIn.Drop(pos))
            self.to_gen = some(g)
        }
    }

    /// What's come back since this was last asked, in the order it came.
    pub fn take_done(mut self) -> Deque<Done> {
        var back = Deque<Done>()
        while let d = self.done.next() {
            match d {
                Done.Region(_, _, _) => self.regions_away -= 1,
                Done.Chunk(_, _, _, _, _) => self.chunks_away -= 1,
                Done.Withdrawn(_, _, _) => self.chunks_away -= 1,
                Done.Spawn(_, _) => self.spawn_away -= 1,
                Done.Closed(_) => self.closing_away -= 1,
            }
            back.push_last(d)
        }
        return back
    }

    /// How many chunks and regions are asked for and not back, and the spawn if it is.
    pub fn away(self) -> usize {
        return self.chunks_away + self.regions_away + self.spawn_away
    }

    /// How many chunk workers have started.
    pub fn threads(self) -> usize {
        return self.started
    }

    /// Has the IO thread, if it's started, write every chunk it's been handed and close the
    /// region files, as the server stops; `closing` counts it until it has. What the generator
    /// hands it after isn't written: it's made again when it's next asked for.
    pub fn close(mut self) {
        if self.storage != none {
            return
        }
        self.to_asks.send(Ask.Close)
        self.closing_away += 1
    }

    /// Whether the IO thread is still closing the region files.
    pub fn closing(self) -> usize {
        return self.closing_away
    }

    // Starts the IO thread, if it hasn't, and the generator's, with its workers, one fewer than
    // the processors.
    fn start(mut self) {
        let storage = self.storage.take() else return
        _ = unsafe { Thread.spawn(IoThread { storage: storage, asks: self.asks.share(), work: self.to_work.share(), done: self.to_done.share(), gen: self.gen_inbox.sender(), waker: self.waker }) }
        let setup = self.gen.take() else return
        let to_gen = self.to_gen else return
        let processors = unsafe { workers() }
        let gen_workers = if processors > 2 { processors - 1 } else { 1 }
        _ = unsafe { Thread.spawn(GenThread { setup: setup, context: self.context.copy(), inbox: self.gen_inbox.share(), to_inbox: to_gen.share(), to_io: self.to_asks.share(), done: self.to_done.share(), waker: self.waker, workers: gen_workers }) }
    }
}
