/// Saving the world's files off the tick thread, where vanilla saves them on it (CAL-62).
///
/// The tick thread makes what's to be saved where vanilla saves it, a player's data, the
/// world's `level.dat` or a file of its saved data, and hands it to the saver, which writes each crash-safely (D188), in the
/// order it was handed over, then hands back what it logged, waking the server's poll. A tick
/// waits for the disk only when a player joins while a save is still being written, so their
/// data is read once it's on the disk.
///
/// What the saver logged is the server's input, as what the IO thread reads is: the link records
/// it as the server takes it, and a replay, which has no folder and writes nothing, hands it over
/// in the same place (D189).
module server.saving

import java.uuid.{Uuid}
import nbt.tag.{Tag}
import resources.identifier.{Identifier}
import server.log.{Entry}
import std.net.{Waker}
import std.thread.{Task}
import storage.players.{PlayerFiles}
import storage.saved.{SavedFiles}
import storage.world.{join, save_level_in}

/// Something to save.
pub enum Save {
    /// A player's data, `players/data/<uuid>.dat`: their UUID, their name as the lines name them,
    /// and the compound.
    Player(Uuid, String, Tag)
    /// The world's `level.dat`: its `Data`.
    Level(Tag)
    /// The world's saved data of the type `id`, in its `data` folder: its `data`.
    Data(Identifier, Tag)
    /// A dimension's saved data, in the `data` of the folder of the dimension named first, of the
    /// type `id`: its `data`.
    DimensionData(Identifier, Identifier, Tag)
}

// The saver: it writes what it's handed, in order, then sends back what each save logged and
// wakes the poll.
struct Saver {
    players: PlayerFiles
    world: String
    asks: Receiver<Save>
    done: Sender<List<Entry>>
    waker: Waker
}

impl Task for Saver {
    fn run(own self) {
        var asks = self.asks
        var done = self.done
        while let save = asks.wait() {
            var lines = List<Entry>()
            match save {
                Save.Player(id, name, data) => self.players.save(id, name, data, mut lines),
                Save.Level(data) => save_level_in(self.world, data, mut lines),
                Save.Data(id, data) => match SavedFiles.at(join(self.world, "data")).save(id, data, mut lines) {
                    ok => {},
                    err(e) => lines.push(Entry.error(e)),
                },
                Save.DimensionData(dim, id, data) => match SavedFiles.at(join(join(self.world, "dimensions/{dim.namespace}/{dim.path}"), "data")).save(id, data, mut lines) {
                    ok => {},
                    err(e) => lines.push(Entry.error(e)),
                },
            }
            done.send(lines)
            self.waker.wake()
        }
    }
}

/// The saver, and the queues to and from it.
pub struct Saving {
    to: Sender<Save>
    done: Receiver<List<Entry>>
    // What came back while the tick thread waited, not taken yet, and how many saves were handed
    // over whose lines haven't been taken.
    held: Deque<List<Entry>>
    pending: usize
}

impl Saving {
    /// Starts the saver, which writes players' data to `players` and `level.dat` to the world's
    /// folder at `world`, and wakes the server's poll with `waker` as each save is written.
    pub fn start(players: own PlayerFiles, world: own String, waker: Waker) -> Saving {
        let asks = Receiver<Save>()
        let to = asks.sender()
        let done = Receiver<List<Entry>>()
        let back = done.sender()
        _ = unsafe { Thread.spawn(Saver { players: players, world: world, asks: asks, done: back, waker: waker }) }
        return Saving { to: to, done: done, held: Deque<List<Entry>>(), pending: 0 }
    }

    /// Hands `save` to the saver.
    pub fn save(mut self, save: own Save) {
        self.to.send(save)
        self.pending += 1
    }

    /// What each save logged since this was last asked, in the order they were handed over, an
    /// empty list for one that logged nothing.
    pub fn take_done(mut self) -> Deque<List<Entry>> {
        while let lines = self.done.next() {
            self.held.push_last(lines)
        }
        self.pending -= self.held.len()
        var back = Deque<List<Entry>>()
        while let lines = self.held.pop_first() {
            back.push_last(lines)
        }
        return back
    }

    /// Waits until every save handed over is written, keeping what they logged for `take_done`.
    pub fn wait(mut self) {
        while self.held.len() < self.pending {
            let lines = self.done.wait() else return
            self.held.push_last(lines)
        }
    }

    /// How many saves were handed over whose lines haven't been taken.
    pub fn away(self) -> usize {
        return self.pending
    }
}
