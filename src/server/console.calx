/// The server's console: the lines typed into it, which the server runs as commands between
/// ticks, as vanilla's `DedicatedServer` reads them on its `Server console handler` thread
/// (CAL-56). A hosting panel types into it too, such as `stop` when it stops the server.
module server.console

import java.text.{LineReader}
import std.net.{Waker}
import std.term.{read}
import std.thread.{Task}

/// What the console hands the server.
pub enum ConsoleInput {
    /// A line typed into it, to run as a command.
    Line(String)
    /// A request to stop, as vanilla's shutdown hook makes at Ctrl+C: the server stops without
    /// a command's answer.
    Halt
}

/// The `Server console handler` thread: it reads standard input's lines, as `BufferedReader`
/// reads them in UTF-8, hands each to the server and wakes its poll. It ends at the end of the
/// input, as vanilla's does, and an input that isn't open reads as ended.
pub struct ConsoleReader {
    pub to: Sender<ConsoleInput>
    pub waker: Waker
}

impl Task for ConsoleReader {
    fn run(own self) {
        var to = self.to
        let waker = self.waker
        var lines = LineReader()
        loop {
            var bytes = List<u8>()
            if read(mut bytes, 4096) == 0 {
                break
            }
            let typed = lines.push(bytes)
            if not typed.is_empty() {
                for line in typed {
                    to.send(ConsoleInput.Line(line.copy()))
                }
                waker.wake()
            }
        }
        if let last = lines.finish() {
            to.send(ConsoleInput.Line(last))
            waker.wake()
        }
    }
}
