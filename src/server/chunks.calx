/// Which chunks a player sees, and how fast they're sent, as vanilla's `ChunkTrackingView` and
/// `PlayerChunkSender` decide: a batch at a time, nearest first, as many a tick as the client
/// says it can take. A view is walked a column at a time, and the chunks waiting are found in
/// the order they go, so the work grows with the chunks that come and go, not with the view's
/// area, and a view of 1024 chunks, 3.3 million of them, keeps a tick under 2 ms.
module server.chunks

import world.pos.{ChunkPos}

/// Whether the chunk at `x`, `z` is tracked by a player whose view is `view` chunks around
/// `center`, as `ChunkTrackingView.isWithinDistance` with the neighbours that are loaded with
/// it: a chunk counts as 2 nearer on each axis.
pub fn in_view(center: ChunkPos, view: i32, x: i32, z: i32) -> bool {
    let dx = i64(max(0, abs(x - center.x) - 2))
    let dz = i64(max(0, abs(z - center.z) - 2))
    return dx * dx + dz * dz < i64(view) * i64(view)
}

/// The chunks of the column `x` that a view of `view` chunks around `center` holds, as `in_view`
/// decides: those from the first `z` to the last. A column the view misses gives the `z` after
/// the center and the center's, a first past the last, so a loop from one to the other is empty
/// and the parts of a column below and above it split at the center.
pub fn column(center: ChunkPos, view: i32, x: i32) -> (i32, i32) {
    let a = i64(max(0, abs(x - center.x) - 2))
    let v = i64(view)
    if a >= v {
        return (center.z + 1, center.z)
    }
    // The furthest `z` is 2 past the most whose square is under what's left of the view's.
    let reach = i32.wrap(isqrt(v * v - a * a - 1)) + 2
    return (center.z - reach, center.z + reach)
}

/// The chunks a player's view holds, in the order `ChunkTrackingView.Positioned.forEach` walks
/// them: by `x`, then `z`, in the square one wider than the view.
pub fn in_view_all(center: ChunkPos, view: i32) -> List<ChunkPos> {
    var out = List<ChunkPos>()
    for x in center.x - view - 1..center.x + view + 2 {
        let (lo, hi) = column(center, view, x)
        for z in lo..hi + 1 {
            out.push(ChunkPos { x: x, z: z })
        }
    }
    return out
}

/// How many chunks a view of `view` holds.
pub fn in_view_count(view: i32) -> usize {
    let center = ChunkPos { x: 0, z: 0 }
    var n: usize = 0
    for x in -view - 1..view + 2 {
        let (lo, hi) = column(center, view, x)
        if lo <= hi {
            n += usize.wrap(hi - lo + 1)
        }
    }
    return n
}

/// How many chunks `views` hold between them, each a view's center and distance, with a chunk
/// two hold counted once. It goes a column at a time, so it takes time by the views' width, not
/// their area.
pub fn chunks_held(views: List<(ChunkPos, i32)>) -> usize {
    // Each column in a long of its `x`, its first `z` and its length, so they sort by `x`, then
    // `z`, as integers do, by their bytes, and those of one `x` that overlap are counted once.
    // A view's chunks are within 2^21 of 0, as players are kept within 30 million blocks, and
    // a column is under 4096 long.
    var columns = List<i64>()
    for (center, view) in views {
        for x in center.x - view - 1..center.x + view + 2 {
            let (lo, hi) = column(center, view, x)
            if lo <= hi {
                columns.push(((i64(x) + 2097152) << 34) | ((i64(lo) + 2097152) << 12) | i64(hi - lo))
            }
        }
    }
    columns.sort()
    var n: i64 = 0
    var at: usize = 0
    while at < columns.len() {
        let x = columns[at] >> 34
        let lo = (columns[at] >> 12) & 0x3FFFFF
        var top = lo + (columns[at] & 0xFFF)
        at += 1
        while at < columns.len() and (columns[at] >> 34) == x and ((columns[at] >> 12) & 0x3FFFFF) <= top + 1 {
            let end = ((columns[at] >> 12) & 0x3FFFFF) + (columns[at] & 0xFFF)
            if end > top {
                top = end
            }
            at += 1
        }
        n += top - lo + 1
    }
    return usize.wrap(n)
}

// The largest `r` whose square is at most `n`, which is 0 or more.
fn isqrt(n: i64) -> i64 {
    var r = i64.saturate(f64.nearest(n).sqrt())
    while r * r > n {
        r -= 1
    }
    while (r + 1) * (r + 1) <= n {
        r += 1
    }
    return r
}

fn abs(v: i32) -> i32 {
    return if v < 0 { -v } else { v }
}

fn max(a: i32, b: i32) -> i32 {
    return if a > b { a } else { b }
}

// A chunk's place in the order chunks are sent from `center`: the square of its distance, then
// its `x`, then its `z`, as offsets from `center`, in one long, which sorts as they would. An
// offset is from -32768 to 32767, far wider than a view goes.
fn key(center: ChunkPos, pos: ChunkPos) -> i64 {
    let dx = i64(pos.x - center.x)
    let dz = i64(pos.z - center.z)
    return ((dx * dx + dz * dz) << 32) | ((dx + 32768) << 16) | (dz + 32768)
}

// The chunk a key is, from `center`.
fn unkey(center: ChunkPos, k: i64) -> ChunkPos {
    return ChunkPos { x: center.x + i32.wrap((k >> 16) & 0xFFFF) - 32768, z: center.z + i32.wrap(k & 0xFFFF) - 32768 }
}

// No key: what a sender's `from` is when nothing is waiting.
const NOTHING: i64 = i64.MAX

// The distances squared a ring of the spiral spans, which is about 65,000 chunks.
const RING: i64 = 20000

/// Every chunk of a view, by `key`, nearest the center first: the order chunks are sent in from
/// any center. One serves every player whose view is no wider. It's made a ring at a time, as a
/// sender gets to its end, so a view of 1024 chunks, which takes most of an hour to send at the
/// most a client asks for, never makes all 3.3 million at once.
pub struct Spiral {
    view: i32 = 0
    keys: List<i64> = []
    // The keys hold every chunk of the view whose distance squared is under this.
    built: i64 = 0
}

impl Spiral {
    /// Makes the spiral hold a view of `view` chunks, if it's wider than any it holds.
    pub fn fit(mut self, view: i32) {
        if view <= self.view {
            return
        }
        // Every chunk nearer than the old view's distance is in it, and in the new one too, so
        // those stay; further, the new view holds more.
        let whole = i64(self.view) * i64(self.view)
        if self.built > whole {
            self.keys.truncate(self.find(whole << 32))
            self.built = whole
        }
        self.view = view
    }

    // Adds the next ring of the view's chunks to the keys, nearest first, or says there's none.
    fn extend(mut self) -> bool {
        let reach = i64(self.view) + 1
        let most = 2 * reach * reach + 1
        if self.built >= most {
            return false
        }
        let lo = self.built
        let hi = if lo + RING < most { lo + RING } else { most }
        let center = ChunkPos { x: 0, z: 0 }
        var ring = List<i64>()
        for x in -self.view - 1..self.view + 2 {
            let x2 = i64(x) * i64(x)
            let (_, top) = column(center, self.view, x)
            if x2 < hi and top >= 0 {
                // The `z` on each side whose square, with `x`'s, is from `lo` to under `hi`.
                let near = if lo - x2 <= 0 { 0 } else { i32.wrap(isqrt(lo - x2 - 1)) + 1 }
                let far_ring = i32.wrap(isqrt(hi - x2 - 1))
                let far = if far_ring < top { far_ring } else { top }
                for z in -far..-max(near, 1) + 1 {
                    ring.push(key(center, ChunkPos { x: x, z: z }))
                }
                for z in near..far + 1 {
                    ring.push(key(center, ChunkPos { x: x, z: z }))
                }
            }
        }
        // Integers sort by their bytes, with no comparisons, in time in step with the chunks.
        ring.sort()
        for k in ring {
            self.keys.push(k)
        }
        self.built = hi
        return true
    }

    // The place of the first key at `k` or past it.
    fn find(self, k: i64) -> usize {
        var lo: usize = 0
        var hi = self.keys.len()
        while lo < hi {
            let mid = lo + (hi - lo) / 2
            if self.keys[mid] < k {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        return lo
    }
}

/// The chunks waiting to be sent to a player, and how many may go, vanilla's `PlayerChunkSender`.
pub struct ChunkSender {
    // The chunks the client has, a bit each, in a square `width` chunks wide that wraps around,
    // as the client's chunk cache does: a chunk is at its `x` and `z` modulo `width`. They're
    // all in the view, which is never as wide, so no two share a bit, and a chunk of the view
    // the client hasn't is waiting. So a whole view comes in with nothing to mark.
    sent: List<u64> = []
    width: i32 = 0
    // How many of the view's chunks are waiting.
    count: usize = 0
    // The view's center and its distance, and the key, from the center, before which no chunk
    // is waiting: where the next batch starts looking in the spiral.
    center_x: i32 = 0
    center_z: i32 = 0
    view: i32 = 0
    from: i64 = NOTHING
    desired_chunks_per_tick: f32 = 9.0
    batch_quota: f32 = 0.0
    unacknowledged_batches: i32 = 0
    max_unacknowledged_batches: i32 = 1
}

impl ChunkSender {
    /// Moves the view to `center`, `view` chunks wide, once the chunks that left it are dropped
    /// and before those that came into it are queued.
    pub fn move_to(mut self, center: ChunkPos, view: i32) {
        if 2 * view + 3 > self.width {
            self.widen(2 * view + 3)
        }
        if (center.x != self.center_x or center.z != self.center_z) and self.from != NOTHING {
            // No chunk waiting is nearer the new center than it was to the old one by more than
            // the way between them.
            let dx = f64(center.x - self.center_x)
            let dz = f64(center.z - self.center_z)
            let near = f64.nearest(self.from >> 32).sqrt() - (dx * dx + dz * dz).sqrt() - 1.0
            self.from = if near <= 0.0 { 0 } else { i64.saturate((near * near).floor()) << 32 }
        }
        self.center_x = center.x
        self.center_z = center.z
        self.view = view
    }

    // Makes the square `width` chunks wide, keeping the chunks the client has, which are around
    // the center no further than half the old width.
    fn widen(mut self, width: i32) {
        var kept = List<ChunkPos>()
        let old = self.width
        let half = old / 2
        for i in 0..old {
            for j in 0..old {
                let at = usize.wrap(i * old + j)
                if (self.sent[at / 64] & (1u64 << (at % 64))) != 0 {
                    let x = self.center_x + wrap(i - self.center_x + half, old) - half
                    let z = self.center_z + wrap(j - self.center_z + half, old) - half
                    kept.push(ChunkPos { x: x, z: z })
                }
            }
        }
        self.width = width
        self.sent = [0u64; (usize.wrap(width) * usize.wrap(width) + 63) / 64]
        for p in kept {
            let at = self.place(p)
            self.sent[at / 64] |= 1u64 << (at % 64)
        }
    }

    // The chunk the view is around.
    fn center(self) -> ChunkPos {
        return ChunkPos { x: self.center_x, z: self.center_z }
    }

    // Where a chunk's bit is.
    fn place(self, pos: ChunkPos) -> usize {
        return usize.wrap(wrap(pos.x, self.width) * self.width + wrap(pos.z, self.width))
    }

    /// Queues a chunk that came into the player's view.
    pub fn mark_pending(mut self, pos: ChunkPos) {
        let at = self.place(pos)
        self.sent[at / 64] &= ~(1u64 << (at % 64))
        self.count += 1
        let k = key(self.center(), pos)
        if k < self.from {
            self.from = k
        }
    }

    /// Queues every chunk of the view, which the client has none of, as a player joins or goes
    /// further than their view reaches.
    pub fn mark_all(mut self) {
        self.count += in_view_count(self.view)
        self.from = 0
    }

    /// Takes a chunk that left the player's view off the queue, and says whether the client has
    /// it, so it's to be told to forget it, as `dropChunk`.
    pub fn drop_chunk(mut self, pos: ChunkPos) -> bool {
        if self.width > 0 {
            let at = self.place(pos)
            let bit = 1u64 << (at % 64)
            if (self.sent[at / 64] & bit) != 0 {
                self.sent[at / 64] &= ~bit
                return true
            }
        }
        if self.count > 0 {
            self.count -= 1
        }
        return false
    }

    /// The chunks to send this tick, nearest the center first, as `sendNextChunks` picks them:
    /// none while too many batches are unacknowledged, or until the quota, which grows by the
    /// chunks the client wants a tick, reaches a whole chunk. The caller sends them as a batch.
    /// `spiral` holds the view, and grows as it's walked.
    pub fn next_batch(mut self, spiral: mut Spiral) -> List<ChunkPos> {
        var out = List<ChunkPos>()
        if self.unacknowledged_batches >= self.max_unacknowledged_batches {
            return out
        }
        let most = if self.desired_chunks_per_tick > 1.0 { self.desired_chunks_per_tick } else { 1.0 }
        let quota = self.batch_quota + self.desired_chunks_per_tick
        self.batch_quota = if quota < most { quota } else { most }
        if self.batch_quota < 1.0 or self.count == 0 {
            return out
        }
        // Vanilla's pending chunks are a hash set, so chunks as near as each other go in no
        // order of its own; here they go by `x`, then `z`, the spiral's order.
        let n = usize.wrap(i32.saturate(f64(self.batch_quota).floor()))
        let center = self.center()
        var at = spiral.find(self.from)
        var ended = false
        while out.len() < n and not ended {
            if at == spiral.keys.len() {
                ended = not spiral.extend()
            } else {
                let pos = unkey(center, spiral.keys[at])
                at += 1
                if in_view(center, self.view, pos.x, pos.z) {
                    let place = self.place(pos)
                    let bit = 1u64 << (place % 64)
                    if (self.sent[place / 64] & bit) == 0 {
                        self.sent[place / 64] |= bit
                        self.count -= 1
                        out.push(pos)
                    }
                }
            }
        }
        self.from = if self.count == 0 or ended { NOTHING } else if at < spiral.keys.len() { spiral.keys[at] } else { spiral.built << 32 }
        if out.is_empty() {
            return out
        }
        self.unacknowledged_batches += 1
        self.batch_quota -= f32.nearest(f64(u32.wrap(out.len())))
        return out
    }

    /// The client has a batch and wants `desired` chunks a tick, as `onChunkBatchReceivedByClient`.
    pub fn batch_received(mut self, desired: f32) {
        self.unacknowledged_batches -= 1
        if self.unacknowledged_batches < 0 {
            self.unacknowledged_batches = 0
        }
        self.desired_chunks_per_tick = if desired.is_nan() { 0.01 } else if desired < 0.01 { 0.01 } else if desired > 64.0 { 64.0 } else { desired }
        if self.unacknowledged_batches == 0 {
            self.batch_quota = 1.0
        }
        self.max_unacknowledged_batches = 10
    }
}

// `v` modulo `n`, from 0 to `n` - 1.
fn wrap(v: i32, n: i32) -> i32 {
    let m = v % n
    return if m < 0 { m + n } else { m }
}
