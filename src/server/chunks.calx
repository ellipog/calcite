/// Which chunks a player sees, and how fast they're sent, as vanilla's `ChunkTrackingView` and
/// `PlayerChunkSender` decide: a batch at a time, nearest first, as many a tick as the client
/// says it can take.
module server.chunks

import world.pos.{ChunkPos}

/// Whether the chunk at `x`, `z` is tracked by a player whose view is `view` chunks around
/// `center`, as `ChunkTrackingView.isWithinDistance` with the neighbours that are loaded with
/// it: a chunk counts as 2 nearer on each axis.
pub fn in_view(center: ChunkPos, view: i32, x: i32, z: i32) -> bool {
    let dx = i64(max(0, abs(x - center.x) - 2))
    let dz = i64(max(0, abs(z - center.z) - 2))
    return dx * dx + dz * dz < i64(view) * i64(view)
}

/// The chunks a player's view holds, in the order `ChunkTrackingView.Positioned.forEach` walks
/// them: by `x`, then `z`, in the square one wider than the view.
pub fn in_view_all(center: ChunkPos, view: i32) -> List<ChunkPos> {
    var out = List<ChunkPos>()
    for x in center.x - view - 1..center.x + view + 2 {
        for z in center.z - view - 1..center.z + view + 2 {
            if in_view(center, view, x, z) {
                out.push(ChunkPos { x: x, z: z })
            }
        }
    }
    return out
}

fn abs(v: i32) -> i32 {
    return if v < 0 { -v } else { v }
}

fn max(a: i32, b: i32) -> i32 {
    return if a > b { a } else { b }
}

/// The chunks waiting to be sent to a player, and how many may go, vanilla's `PlayerChunkSender`.
pub struct ChunkSender {
    pending: List<ChunkPos> = []
    desired_chunks_per_tick: f32 = 9.0
    batch_quota: f32 = 0.0
    unacknowledged_batches: i32 = 0
    max_unacknowledged_batches: i32 = 1
}

impl ChunkSender {
    /// Queues a chunk that came into the player's view.
    pub fn mark_pending(mut self, pos: ChunkPos) {
        self.pending.push(pos)
    }

    /// Takes a chunk that left the player's view off the queue, and says whether the client has
    /// it, so it's to be told to forget it, as `dropChunk`.
    pub fn drop_chunk(mut self, pos: ChunkPos) -> bool {
        for i in 0..self.pending.len() {
            if self.pending[i] == pos {
                _ = self.pending.swap_remove(i)
                return false
            }
        }
        return true
    }

    /// The chunks to send this tick, nearest `center` first, as `sendNextChunks` picks them: none
    /// while too many batches are unacknowledged, or until the quota, which grows by the
    /// chunks the client wants a tick, reaches a whole chunk. The caller sends them as a batch.
    pub fn next_batch(mut self, center: ChunkPos) -> List<ChunkPos> {
        var out = List<ChunkPos>()
        if self.unacknowledged_batches >= self.max_unacknowledged_batches {
            return out
        }
        let most = if self.desired_chunks_per_tick > 1.0 { self.desired_chunks_per_tick } else { 1.0 }
        let quota = self.batch_quota + self.desired_chunks_per_tick
        self.batch_quota = if quota < most { quota } else { most }
        if self.batch_quota < 1.0 or self.pending.is_empty() {
            return out
        }
        // Vanilla's pending chunks are a hash set, so chunks as near as each other go in no
        // order of its own; here they go by `x`, then `z`.
        var near = List<(i32, i32, i32)>()
        for p in self.pending {
            near.push((p.distance_squared(center), p.x, p.z))
        }
        near.sort()
        let n = i32.saturate(f64(self.batch_quota).floor())
        var taken = 0
        for (_, x, z) in near {
            if taken == n {
                break
            }
            out.push(ChunkPos { x: x, z: z })
            taken += 1
        }
        for p in out {
            _ = self.drop_chunk(p)
        }
        self.unacknowledged_batches += 1
        self.batch_quota -= f32.nearest(f64(taken))
        return out
    }

    /// The client has a batch and wants `desired` chunks a tick, as `onChunkBatchReceivedByClient`.
    pub fn batch_received(mut self, desired: f32) {
        self.unacknowledged_batches -= 1
        if self.unacknowledged_batches < 0 {
            self.unacknowledged_batches = 0
        }
        self.desired_chunks_per_tick = if desired.is_nan() { 0.01 } else if desired < 0.01 { 0.01 } else if desired > 64.0 { 64.0 } else { desired }
        if self.unacknowledged_batches == 0 {
            self.batch_quota = 1.0
        }
        self.max_unacknowledged_batches = 10
    }
}
