/// The console's colors: which the terminal takes, and Calcite's, which its style's lines, its
/// card and its bar are painted in (D150).
module server.paint

import std.env.{variable}

/// How Calcite's style colors the console.
pub enum Colors {
    /// None, where `NO_COLOR` is set or the terminal is `dumb`.
    Off
    /// The 16 basic colors, on the Linux console.
    Basic
    /// The nearest of xterm's 256, where the terminal doesn't say it takes more.
    Palette
    /// Exact, in 24-bit color: on Windows, whose console takes it, and where `COLORTERM` is
    /// `truecolor` or `24bit`.
    Exact
}

/// The colors the terminal takes, by the conventions terminals follow.
pub fn terminal_colors() -> Colors {
    if let no = variable("NO_COLOR") {
        if not no.is_empty() {
            return Colors.Off
        }
    }
    let term = variable("TERM") ?? String()
    if term == "dumb" {
        return Colors.Off
    }
    if variable("OS") == some(String("Windows_NT")) {
        return Colors.Exact
    }
    let color_term = variable("COLORTERM") ?? String()
    if color_term == "truecolor" or color_term == "24bit" {
        return Colors.Exact
    }
    return if term == "linux" { Colors.Basic } else { Colors.Palette }
}

/// The colors of Calcite's style, from GitHub's Primer palette, which reads on dark and light
/// backgrounds alike. Calcite's own, the off-white of the calcite block, is the card's badge.
pub enum Hue {
    /// A player coming in.
    Green
    /// An error.
    Red
    /// A warning.
    Amber
    /// What's said about something: the card's marks and labels, a player going.
    Muted
    /// The time.
    Faint
}

/// `text` in `hue`, bold where `bold`.
pub fn paint(colors: Colors, hue: Hue, bold: bool, text: String) -> String {
    let code = match colors {
        Colors.Off => return text.copy(),
        Colors.Basic => match hue {
            Hue.Green => "32",
            Hue.Red => "31",
            Hue.Amber => "33",
            Hue.Muted => "90",
            Hue.Faint => "90",
        },
        Colors.Palette => match hue {
            Hue.Green => "38;5;71",
            Hue.Red => "38;5;203",
            Hue.Amber => "38;5;178",
            Hue.Muted => "38;5;246",
            Hue.Faint => "38;5;243",
        },
        Colors.Exact => match hue {
            Hue.Green => "38;2;63;185;80",
            Hue.Red => "38;2;248;81;73",
            Hue.Amber => "38;2;210;153;34",
            Hue.Muted => "38;2;139;148;158",
            Hue.Faint => "38;2;110;118;129",
        },
    }
    let weight = if bold { "1;" } else { "" }
    return "\u{1B}[{weight}{code}m{text}\u{1B}[0m"
}

/// `text` in bold, in the terminal's own color.
pub fn strong(colors: Colors, text: String) -> String {
    return match colors {
        Colors.Off => text.copy(),
        _ => "\u{1B}[1m{text}\u{1B}[0m",
    }
}

/// Calcite's name as the card and the console's bar show it: bold, in the logo's ink, on the
/// off-white of the calcite block.
pub fn badge(colors: Colors) -> String {
    let code = match colors {
        Colors.Off => return String("calcite"),
        Colors.Basic => "1;30;47",
        Colors.Palette => "1;38;5;235;48;5;255",
        Colors.Exact => "1;38;2;30;31;36;48;2;237;236;230",
    }
    return "\u{1B}[{code}m calcite \u{1B}[0m"
}
