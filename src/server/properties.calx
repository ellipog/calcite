/// `server.properties`, as vanilla's `DedicatedServerProperties` reads it: each key with its
/// default, read with vanilla's rules. And what vanilla writes back to it as it starts, with
/// every setting it knows.
module server.properties

import java.number.{parse_int, parse_long}
import java.properties.{Properties}
import json.gson.{JsonWriter}
import json.tree.{Json, parse_object_start}
import server.log.{Entry}
import std.crypto.{random_bytes}
import std.fs.{read}
import world.modes.{Difficulty, GameType}

/// The settings the server uses so far. Each is vanilla's key and default.
pub struct ServerProperties {
    /// `online-mode`, default `true`: whether players are checked with Mojang's session server.
    pub online_mode: bool
    /// `server-ip`, default empty: the address to listen on, or every address.
    pub server_ip: String
    /// `server-port`, default 25565.
    pub server_port: i32
    /// `motd`, default `A Minecraft Server`: the server list's description.
    pub motd: String
    /// `max-players`, default 20.
    pub max_players: i32
    /// `white-list`, default `true`: whether only ops and the players on the whitelist may join.
    pub white_list: bool
    /// `enable-status`, default `true`: whether the server answers the server list.
    pub enable_status: bool
    /// `hide-online-players`, default `false`: whether the server list shows no names.
    pub hide_online_players: bool
    /// `enforce-secure-profile`, default `true`: whether players need Mojang-signed chat keys.
    pub enforce_secure_profile: bool
    /// `accepts-transfers`, default `false`: whether players sent from another server may join.
    pub accepts_transfers: bool
    /// `prevent-proxy-connections`, default `false`.
    pub prevent_proxy_connections: bool
    /// `network-compression-threshold`, default 256: the smallest packet compressed, or -1 for
    /// none.
    pub network_compression_threshold: i32
    /// `rate-limit`, default 0: the packets a second a player may send before being kicked, or 0
    /// for no limit.
    pub rate_limit: i32
    /// `log-ips`, default `true`.
    pub log_ips: bool
    /// `chat-spam-threshold-seconds` and `command-spam-threshold-seconds`, default 10: how many
    /// chat messages or commands a player may send at once, one a second after that, before
    /// they're kicked for spam, or 0 or less for no limit.
    pub chat_spam_threshold_seconds: i32
    pub command_spam_threshold_seconds: i32
    /// `enable-code-of-conduct`, default `false`: whether players must accept the code of conduct
    /// in the `codeofconduct` folder.
    pub enable_code_of_conduct: bool
    /// `bug-report-link`, default empty: the link the client's pause menu offers for reporting a
    /// bug.
    pub bug_report_link: String
    /// `resource-pack`, default empty: the URL of the resource pack players are offered, or
    /// none.
    pub resource_pack: String
    /// `resource-pack-id`, default empty: the pack's UUID, or one made from its URL.
    pub resource_pack_id: String
    /// `resource-pack-sha1`, default empty: the pack's SHA-1 in hex.
    pub resource_pack_sha1: String
    /// `resource-pack-hash`, which `resource-pack-sha1` replaced, with no default.
    pub resource_pack_hash: String?
    /// `require-resource-pack`, default `false`: whether a player who declines the pack is
    /// disconnected.
    pub require_resource_pack: bool
    /// `resource-pack-prompt`, default empty: what the client shows when it asks, as a text
    /// component's JSON.
    pub resource_pack_prompt: String
    /// `view-distance`, default 10: how many chunks around them players see.
    pub view_distance: i32
    /// `simulation-distance`, default 10: how many chunks around players the world runs in.
    pub simulation_distance: i32
    /// `gamemode`, default `survival`: the game mode new players get, by name or ID.
    pub gamemode: GameType
    /// `difficulty`, default `easy`, by name or ID.
    pub difficulty: Difficulty
    /// `hardcore`, default `false`.
    pub hardcore: bool
    /// `level-seed`, default empty: the world's seed, or a random one.
    pub level_seed: String
    /// `region-file-compression`, default `deflate`: how chunks are compressed in region files,
    /// `deflate`, `none` or `lz4`, which `storage.region.configured` reads.
    pub region_file_compression: String
    /// `sync-chunk-writes`, default `true`: whether each chunk saved is on the disk before the
    /// next is saved.
    pub sync_chunk_writes: bool
}

impl ServerProperties {
    /// Every setting at its default, as a server without the file has.
    pub fn defaults() -> ServerProperties {
        return ServerProperties.from(Properties.new())
    }

    /// The settings in `p`, each the default where `p` has no value or one that doesn't parse.
    pub fn from(p: Properties) -> ServerProperties {
        return ServerProperties {
            online_mode: boolean(p, "online-mode", true),
            server_ip: string(p, "server-ip", ""),
            server_port: int(p, "server-port", 25565),
            motd: string(p, "motd", "A Minecraft Server"),
            max_players: int(p, "max-players", 20),
            white_list: boolean(p, "white-list", true),
            enable_status: boolean(p, "enable-status", true),
            hide_online_players: boolean(p, "hide-online-players", false),
            enforce_secure_profile: boolean(p, "enforce-secure-profile", true),
            accepts_transfers: boolean(p, "accepts-transfers", false),
            prevent_proxy_connections: boolean(p, "prevent-proxy-connections", false),
            network_compression_threshold: int(p, "network-compression-threshold", 256),
            rate_limit: int(p, "rate-limit", 0),
            log_ips: boolean(p, "log-ips", true),
            chat_spam_threshold_seconds: int(p, "chat-spam-threshold-seconds", 10),
            command_spam_threshold_seconds: int(p, "command-spam-threshold-seconds", 10),
            enable_code_of_conduct: boolean(p, "enable-code-of-conduct", false),
            bug_report_link: string(p, "bug-report-link", ""),
            resource_pack: string(p, "resource-pack", ""),
            resource_pack_id: string(p, "resource-pack-id", ""),
            resource_pack_sha1: string(p, "resource-pack-sha1", ""),
            resource_pack_hash: p.get("resource-pack-hash"),
            require_resource_pack: boolean(p, "require-resource-pack", false),
            resource_pack_prompt: string(p, "resource-pack-prompt", ""),
            view_distance: int(p, "view-distance", 10),
            simulation_distance: int(p, "simulation-distance", 10),
            gamemode: game_type(p),
            difficulty: difficulty(p),
            hardcore: boolean(p, "hardcore", false),
            level_seed: string(p, "level-seed", ""),
            region_file_compression: string(p, "region-file-compression", "deflate"),
            sync_chunk_writes: boolean(p, "sync-chunk-writes", true),
        }
    }
}

// `gamemode` as vanilla's `dispatchNumberOrString` reads it: a number is a mode's ID, survival
// when it's out of range, and a name that isn't a mode's is survival too.
fn game_type(p: Properties) -> GameType {
    let text = p.get("gamemode") else return GameType.Survival
    if let n = i32.parse(text) {
        return GameType.by_id(n)
    }
    return GameType.by_name(text) ?? GameType.Survival
}

// `difficulty` as vanilla reads it: a number is a difficulty's ID, which wraps around, and a name
// that isn't one's leaves the default.
fn difficulty(p: Properties) -> Difficulty {
    let text = p.get("difficulty") else return Difficulty.Easy
    if let n = i32.parse(text) {
        return Difficulty.by_id(n)
    }
    return Difficulty.by_name(text) ?? Difficulty.Easy
}

/// The properties in the file at `path`, as vanilla's `Settings.loadFromFile` reads them: as
/// UTF-8, or as ISO-8859-1 if it isn't UTF-8. A file that can't be read gives none, and
/// `problem` is what vanilla logs then, before it carries on with the defaults. Reading it as
/// ISO-8859-1 is logged too. A malformed `\u` escape is an error, as it stops vanilla from
/// starting.
pub fn load(path: String, problem: mut Entry?) -> Properties ! String {
    let bytes = match read(path) {
        ok(b) => b,
        err(_) => {
            problem = some(Entry.error("Failed to load properties from file: {path}"))
            return Properties.new()
        },
    }
    if let text = String.from_utf8(bytes.copy()) {
        return try Properties.parse(text)
    }
    problem = some(Entry.info("Failed to load properties as UTF-8 from file {path}, trying ISO_8859_1"))
    var latin = String()
    for b in bytes {
        latin.push(rune(b))
    }
    return try Properties.parse(latin)
}

/// The setting's text, or the default.
pub fn string(p: Properties, key: String, default: String) -> String {
    return p.get(key) ?? default.copy()
}

/// The setting as Java's `Integer.parseInt` reads it, or the default.
pub fn int(p: Properties, key: String, default: i32) -> i32 {
    if let text = p.get(key) {
        return match parse_int(text, 10) {
            ok(n) => n,
            err(_) => default,
        }
    }
    return default
}

/// The setting as Java's `Boolean.valueOf` reads it: `true` in any case is true, and anything
/// else is false. The default is for no setting.
pub fn boolean(p: Properties, key: String, default: bool) -> bool {
    if let text = p.get(key) {
        return text.to_lower_root() == "true"
    }
    return default
}

/// What vanilla writes back to server.properties as it starts, by `Settings.store`: the
/// properties in `p`, with each key `DedicatedServerProperties` reads put back as `Settings.get`
/// puts it. That's the value as the setting reads it, written as the setting writes it, or the
/// default where there's none or it doesn't parse: `TRUE` is `true`, `difficulty=2` is `normal`,
/// `+5` is `5`, and `max-world-size` and the permission levels are kept in range. `level-type`
/// is in lower case, and `generator-settings` is written again as Gson writes its JSON object.
/// `resource-pack-hash` and `announce-player-achievements`, which vanilla reads only to replace,
/// are gone. Keys vanilla doesn't read stay as they are. `secret` is the
/// `management-server-secret` where there's none.
///
/// Fails, as vanilla fails to start, where `generator-settings` isn't a JSON object. Vanilla
/// fails too where `entity-broadcast-range-percentage` isn't a number, the one number it reads
/// with no default for that, and Calcite gives it the default, as every other has
/// ([differences](../../rig/differences/properties-range-percentage.md)).
pub fn settled(p: Properties, secret: String) -> Properties ! String {
    var out = p.copy()
    let bools = [
        ("online-mode", true), ("prevent-proxy-connections", false), ("allow-flight", false),
        ("enable-code-of-conduct", false), ("force-gamemode", false), ("enforce-whitelist", false),
        ("management-server-enabled", false), ("management-server-tls-enabled", true),
        ("enable-query", false), ("enable-rcon", false), ("hardcore", false),
        ("use-native-transport", true), ("broadcast-rcon-to-ops", true),
        ("broadcast-console-to-ops", true), ("sync-chunk-writes", true),
        ("enable-jmx-monitoring", false), ("enable-status", true), ("hide-online-players", false),
        ("white-list", true), ("enforce-secure-profile", true), ("log-ips", true),
        ("accepts-transfers", false), ("generate-structures", true),
        ("require-resource-pack", false),
    ]
    for (key, default) in bools {
        let k = String(key)
        out.set(k.copy(), String(if boolean(p, k, default) { "true" } else { "false" }))
    }
    let ints = [
        ("server-port", 25565), ("management-server-port", 0), ("query.port", 25565),
        ("rcon.port", 25575), ("spawn-protection", 16), ("max-chained-neighbor-updates", 1000000),
        ("rate-limit", 0), ("command-spam-threshold-seconds", 10),
        ("chat-spam-threshold-seconds", 10), ("view-distance", 10), ("simulation-distance", 10),
        ("max-players", 20), ("network-compression-threshold", 256), ("text-filtering-version", 0),
        ("player-idle-timeout", 0), ("status-heartbeat-interval", 0),
        ("pause-when-empty-seconds", 60),
    ]
    for (key, default) in ints {
        let k = String(key)
        out.set(k.copy(), "{int(p, k, default)}")
    }
    // Kept in range, when they're numbers.
    out.set(String("max-world-size"), "{int(p, "max-world-size", 29999984).max(1).min(29999984)}")
    out.set(String("entity-broadcast-range-percentage"), "{int(p, "entity-broadcast-range-percentage", 100).max(10).min(1000)}")
    out.set(String("op-permission-level"), "{int(p, "op-permission-level", 4).max(0).min(4)}")
    out.set(String("function-permission-level"), "{int(p, "function-permission-level", 2).max(0).min(4)}")
    var tick_time: i64 = 60000
    if let text = p.get("max-tick-time") {
        tick_time = match parse_long(text, 10) {
            ok(n) => n,
            err(_) => tick_time,
        }
    }
    out.set(String("max-tick-time"), "{tick_time}")
    let strings = [
        ("server-ip", ""), ("motd", "A Minecraft Server"), ("bug-report-link", ""),
        ("level-name", "world"), ("management-server-host", "localhost"),
        ("management-server-tls-keystore", ""), ("management-server-tls-keystore-password", ""),
        ("management-server-allowed-origins", ""), ("rcon.password", ""),
        ("region-file-compression", "deflate"), ("text-filtering-config", ""), ("level-seed", ""),
        ("resource-pack-id", ""), ("resource-pack", ""), ("resource-pack-sha1", ""),
        ("resource-pack-prompt", ""), ("initial-enabled-packs", "vanilla"),
        ("initial-disabled-packs", ""),
    ]
    for (key, default) in strings {
        let k = String(key)
        out.set(k.copy(), string(p, k, String(default)))
    }
    out.set(String("management-server-secret"), string(p, "management-server-secret", secret))
    out.set(String("difficulty"), difficulty(p).name())
    out.set(String("gamemode"), game_type(p).name())
    out.set(String("level-type"), string(p, "level-type", "minecraft:normal").to_lower_root())
    out.set(String("generator-settings"), try generator_settings(p))
    out.remove("resource-pack-hash")
    out.remove("announce-player-achievements")
    return out
}

// `generator-settings` as Gson writes the JSON object vanilla reads from it: `{}` where it's
// empty or there's none. Anything after the object is ignored, as Gson ignores it. Fails where
// there's no object.
fn generator_settings(p: Properties) -> String ! String {
    let text = p.get("generator-settings") ?? String()
    if text.is_empty() {
        return String("\{\}")
    }
    let members = parse_object_start(text) else fail "generator-settings isn't a JSON object: {text}"
    var w = JsonWriter.new()
    w.tree(Json.Object(members))
    return w.into_string()
}

/// A new `management-server-secret`, as vanilla's `SecurityConfig.generateSecretKey` makes one:
/// 40 letters and digits, each drawn evenly from the system's secure generator.
pub fn new_secret() -> String {
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    var out = String()
    while out.len() < 40 {
        for b in random_bytes(48) {
            // 248 is 4 times 62, so the bytes below it give each character as often.
            if b < 248 and out.len() < 40 {
                let i = usize(b % 62)
                out.push_str(alphabet[i..i + 1])
            }
        }
    }
    return out
}
