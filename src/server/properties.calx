/// `server.properties`, as vanilla's `DedicatedServerProperties` reads it: each key with its
/// default, read with vanilla's rules.
module server.properties

import java.properties.{Properties}
import server.log.{Entry}
import std.fs.{read}

/// The settings the server uses so far. Each is vanilla's key and default.
pub struct ServerProperties {
    /// `online-mode`, default `true`: whether players are checked with Mojang's session server.
    pub online_mode: bool
    /// `server-ip`, default empty: the address to listen on, or every address.
    pub server_ip: String
    /// `server-port`, default 25565.
    pub server_port: i32
    /// `motd`, default `A Minecraft Server`: the server list's description.
    pub motd: String
    /// `max-players`, default 20.
    pub max_players: i32
    /// `enable-status`, default `true`: whether the server answers the server list.
    pub enable_status: bool
    /// `hide-online-players`, default `false`: whether the server list shows no names.
    pub hide_online_players: bool
    /// `enforce-secure-profile`, default `true`: whether players need Mojang-signed chat keys.
    pub enforce_secure_profile: bool
    /// `accepts-transfers`, default `false`: whether players sent from another server may join.
    pub accepts_transfers: bool
    /// `prevent-proxy-connections`, default `false`.
    pub prevent_proxy_connections: bool
    /// `network-compression-threshold`, default 256: the smallest packet compressed, or -1 for
    /// none.
    pub network_compression_threshold: i32
    /// `rate-limit`, default 0: the packets a second a player may send before being kicked, or 0
    /// for no limit.
    pub rate_limit: i32
    /// `log-ips`, default `true`.
    pub log_ips: bool
    /// `enable-code-of-conduct`, default `false`: whether players must accept the code of conduct
    /// in the `codeofconduct` folder.
    pub enable_code_of_conduct: bool
    /// `bug-report-link`, default empty: the link the client's pause menu offers for reporting a
    /// bug.
    pub bug_report_link: String
    /// `resource-pack`, default empty: the URL of the resource pack players are offered, or
    /// none.
    pub resource_pack: String
    /// `resource-pack-id`, default empty: the pack's UUID, or one made from its URL.
    pub resource_pack_id: String
    /// `resource-pack-sha1`, default empty: the pack's SHA-1 in hex.
    pub resource_pack_sha1: String
    /// `resource-pack-hash`, which `resource-pack-sha1` replaced, with no default.
    pub resource_pack_hash: String?
    /// `require-resource-pack`, default `false`: whether a player who declines the pack is
    /// disconnected.
    pub require_resource_pack: bool
    /// `resource-pack-prompt`, default empty: what the client shows when it asks, as a text
    /// component's JSON.
    pub resource_pack_prompt: String
}

impl ServerProperties {
    /// Every setting at its default, as a server without the file has.
    pub fn defaults() -> ServerProperties {
        return ServerProperties.from(Properties.new())
    }

    /// The settings in `p`, each the default where `p` has no value or one that doesn't parse.
    pub fn from(p: Properties) -> ServerProperties {
        return ServerProperties {
            online_mode: boolean(p, "online-mode", true),
            server_ip: string(p, "server-ip", ""),
            server_port: int(p, "server-port", 25565),
            motd: string(p, "motd", "A Minecraft Server"),
            max_players: int(p, "max-players", 20),
            enable_status: boolean(p, "enable-status", true),
            hide_online_players: boolean(p, "hide-online-players", false),
            enforce_secure_profile: boolean(p, "enforce-secure-profile", true),
            accepts_transfers: boolean(p, "accepts-transfers", false),
            prevent_proxy_connections: boolean(p, "prevent-proxy-connections", false),
            network_compression_threshold: int(p, "network-compression-threshold", 256),
            rate_limit: int(p, "rate-limit", 0),
            log_ips: boolean(p, "log-ips", true),
            enable_code_of_conduct: boolean(p, "enable-code-of-conduct", false),
            bug_report_link: string(p, "bug-report-link", ""),
            resource_pack: string(p, "resource-pack", ""),
            resource_pack_id: string(p, "resource-pack-id", ""),
            resource_pack_sha1: string(p, "resource-pack-sha1", ""),
            resource_pack_hash: p.get("resource-pack-hash"),
            require_resource_pack: boolean(p, "require-resource-pack", false),
            resource_pack_prompt: string(p, "resource-pack-prompt", ""),
        }
    }
}

/// The properties in the file at `path`, as vanilla's `Settings.loadFromFile` reads them: as
/// UTF-8, or as ISO-8859-1 if it isn't UTF-8. A file that can't be read gives none, and
/// `problem` is what vanilla logs then, before it carries on with the defaults. Reading it as
/// ISO-8859-1 is logged too. A malformed `\u` escape is an error, as it stops vanilla from
/// starting.
pub fn load(path: String, problem: mut Entry?) -> Properties ! String {
    let bytes = match read(path) {
        ok(b) => b,
        err(_) => {
            problem = some(Entry.error("Failed to load properties from file: {path}"))
            return Properties.new()
        },
    }
    if let text = String.from_utf8(bytes.copy()) {
        return try Properties.parse(text)
    }
    problem = some(Entry.info("Failed to load properties as UTF-8 from file {path}, trying ISO_8859_1"))
    var latin = String()
    for b in bytes {
        latin.push(rune(b))
    }
    return try Properties.parse(latin)
}

/// The setting's text, or the default.
pub fn string(p: Properties, key: String, default: String) -> String {
    return p.get(key) ?? default.copy()
}

/// The setting as Java's `Integer.parseInt` reads it, or the default.
pub fn int(p: Properties, key: String, default: i32) -> i32 {
    if let text = p.get(key) {
        return i32.parse(text) ?? default
    }
    return default
}

/// The setting as Java's `Boolean.valueOf` reads it: `true` in any case is true, and anything
/// else is false. The default is for no setting.
pub fn boolean(p: Properties, key: String, default: bool) -> bool {
    if let text = p.get(key) {
        return text.to_lower_root() == "true"
    }
    return default
}
