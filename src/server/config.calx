/// calcite.properties: Calcite's own settings, those vanilla's server.properties hasn't, in the
/// same format, beside it. A server without one writes it, with each setting at its default and a
/// line on what it does.
module server.config

import java.properties.{Properties}
import server.properties.{boolean, int, string}

/// Calcite's settings. Each is its key and default.
pub struct CalciteConfig {
    /// `velocity-forwarding`, default `false`: whether players are let in only through a Velocity
    /// proxy, with the player data its modern forwarding sends. The proxy authenticates them, so
    /// `online-mode` is ignored.
    pub velocity_forwarding: bool
    /// `velocity-secret`, default empty: the secret Velocity signs that data with, the text of its
    /// forwarding.secret file.
    pub velocity_secret: String
    /// `record-inputs`, default `false`: whether the server records everything it's handed, from
    /// the network, the clock, Mojang's services and the system's random numbers, to a new input
    /// log in recordings/ each time it starts, which `--replay` plays back (D21). The log holds
    /// what players sent and the server's private key, so it's for its admin alone.
    pub record_inputs: bool
    /// `login-throttle`, default 0: the fewest milliseconds between two tries to log in from one
    /// address, sooner than which a try is refused. 0 lets every try in, as vanilla does. It's
    /// ignored with `velocity-forwarding`, since every player then comes from the proxy's address.
    pub login_throttle: i32
    /// `console-style`, default `auto`: how the console shows the server's lines. `auto` gives
    /// Calcite's own look on a terminal, and vanilla's exact lines in a file or a pipe, which
    /// hosting panels and wrappers read. `calcite` or `vanilla` picks one. Any other value is
    /// `auto`. logs/latest.log always has vanilla's lines.
    pub console_style: String
    /// `console-dashboard`, default `off`: `bottom` or `top` pins a bar to that edge of the
    /// terminal with how the server is doing, its TPS and MSPT, players, RAM and CPU, chunks and
    /// uptime, with the line commands are typed on beside it. It's drawn only on a terminal: in a
    /// file, a pipe or a hosting panel's console it's the plain log. Any other value is `off`.
    pub console_dashboard: String
    /// `force-view-distance`, default 0, which is off: the view distance every player gets, from
    /// 2 to 1024 chunks, whatever their client asks for, for testing the server with views far
    /// past the 127 a client can ask for, as it asks in a byte. The login packet says it too, so
    /// the client keeps chunks that far out.
    pub force_view_distance: i32
    /// `chunk-send-cap`, default 0, which is none: the most chunks a tick a player is sent,
    /// however many their client asks for. Vanilla's is 64 (D242).
    pub chunk_send_cap: i32
    /// `chunk-send-multiplier`, default 1.0: what the chunks a tick a client asks for are
    /// multiplied by, from 0.1 to 100, to send faster than it asks, or slower (D242).
    pub chunk_send_multiplier: f32
    /// `chunk-send-boost`, default 4.0: a client that asks for fewer chunks a tick than vanilla's
    /// most, 64, is sent this many times what it asks for, up to 64, from 1, which is off, to 64.
    /// A client on a slow link asks for few, as it counts the time a batch takes on the link
    /// (D272).
    pub chunk_send_boost: f32
    /// `chunk-workers`, default 0, which is one fewer than the processors: how many threads load
    /// and generate chunks, from 1 up. What they make is the same whatever the number; only how
    /// fast changes (D251).
    pub chunk_workers: i32
    /// `level-random-seed`, default empty: each level's random, which draws its weather and what
    /// else happens in the level by chance, is seeded from the system's generator, as vanilla seeds
    /// it. A number, or text as `level-seed` takes it, seeds each one from that and its
    /// dimension's name instead, as the rig's agent seeds vanilla's, so two runs draw the same
    /// (D311).
    pub level_random_seed: String
}

/// The most `chunk-workers`.
pub const MOST_CHUNK_WORKERS: i32 = 256

// `chunk-workers`, 0 where it's 0 or less or doesn't parse, and at most 256.
fn chunk_workers(p: Properties) -> i32 {
    let n = int(p, "chunk-workers", 0)
    return if n <= 0 { 0 } else if n > MOST_CHUNK_WORKERS { MOST_CHUNK_WORKERS } else { n }
}

/// The least and greatest `chunk-send-multiplier`.
pub const LEAST_SEND_MULTIPLIER: f32 = 0.1
pub const MOST_SEND_MULTIPLIER: f32 = 100.0

// `chunk-send-cap`, 0 where it's less or doesn't parse.
fn chunk_send_cap(p: Properties) -> i32 {
    let cap = int(p, "chunk-send-cap", 0)
    return if cap < 0 { 0 } else { cap }
}

// `chunk-send-multiplier`, from 0.1 to 100, or 1 where it doesn't parse as a number.
fn chunk_send_multiplier(p: Properties) -> f32 {
    let text = p.get("chunk-send-multiplier") else return 1.0f32
    let value = f32.parse(text) else return 1.0f32
    if value.is_nan() {
        return 1.0f32
    }
    return if value < LEAST_SEND_MULTIPLIER { LEAST_SEND_MULTIPLIER } else if value > MOST_SEND_MULTIPLIER { MOST_SEND_MULTIPLIER } else { value }
}

/// The widest `force-view-distance`.
pub const MOST_FORCED_VIEW: i32 = 1024

/// The greatest `chunk-send-boost`.
pub const MOST_SEND_BOOST: f32 = 64.0

// `chunk-send-boost`, from 1 to 64, or 4.0 where it doesn't parse as a number.
fn chunk_send_boost(p: Properties) -> f32 {
    let text = p.get("chunk-send-boost") else return 4.0f32
    let value = f32.parse(text) else return 4.0f32
    if value.is_nan() {
        return 4.0f32
    }
    return if value < 1.0f32 { 1.0f32 } else if value > MOST_SEND_BOOST { MOST_SEND_BOOST } else { value }
}

// `force-view-distance`, 0 if it's 0 or less, and from 2 to 1024 otherwise.
fn force_view_distance(p: Properties) -> i32 {
    let view = int(p, "force-view-distance", 0)
    return if view <= 0 { 0 } else if view < 2 { 2 } else if view > MOST_FORCED_VIEW { MOST_FORCED_VIEW } else { view }
}

// `console-dashboard`, or `off` if it isn't one of the three.
fn console_dashboard(p: Properties) -> String {
    let place = string(p, "console-dashboard", "off")
    return if place == "bottom" or place == "top" { place } else { String("off") }
}

// `console-style`, or `auto` if it isn't one of the three.
fn console_style(p: Properties) -> String {
    let style = string(p, "console-style", "auto")
    return if style == "calcite" or style == "vanilla" { style } else { String("auto") }
}

impl CalciteConfig {
    /// Every setting at its default.
    pub fn defaults() -> CalciteConfig {
        return CalciteConfig.from(Properties.new())
    }

    /// The settings in `p`, each the default where `p` has no value or one that doesn't parse.
    pub fn from(p: Properties) -> CalciteConfig {
        return CalciteConfig {
            velocity_forwarding: boolean(p, "velocity-forwarding", false),
            velocity_secret: string(p, "velocity-secret", ""),
            record_inputs: boolean(p, "record-inputs", false),
            login_throttle: int(p, "login-throttle", 0),
            console_style: console_style(p),
            console_dashboard: console_dashboard(p),
            force_view_distance: force_view_distance(p),
            chunk_send_cap: chunk_send_cap(p),
            chunk_send_multiplier: chunk_send_multiplier(p),
            chunk_send_boost: chunk_send_boost(p),
            chunk_workers: chunk_workers(p),
            level_random_seed: string(p, "level-random-seed", ""),
        }
    }

    /// What's wrong with the settings, which stops the server, or `none`.
    pub fn problem(self) -> String? {
        if self.velocity_forwarding and self.velocity_secret.is_empty() {
            return some(String("velocity-forwarding is on in calcite.properties, but velocity-secret is empty: set it to the text of Velocity's forwarding.secret"))
        }
        return none
    }
}

/// What a new calcite.properties holds.
pub fn default_text() -> String {
    var out = String("# Calcite's own settings, beside vanilla's server.properties.\n")
    out.push_str("#\n")
    out.push_str("# velocity-forwarding: let players in only through a Velocity proxy, with its modern\n")
    out.push_str("# forwarding. The proxy authenticates them, so online-mode is ignored.\n")
    out.push_str("velocity-forwarding=false\n")
    out.push_str("# velocity-secret: the text of Velocity's forwarding.secret, which signs what it forwards.\n")
    out.push_str("velocity-secret=\n")
    out.push_str("# record-inputs: record everything the server is handed to a new log in recordings/, which\n")
    out.push_str("# --replay plays back. A log holds what players send and the server's key: keep it private.\n")
    out.push_str("record-inputs=false\n")
    out.push_str("# login-throttle: the fewest milliseconds between two tries to log in from one address,\n")
    out.push_str("# such as 4000 on a public server. 0 lets every try in, as vanilla does.\n")
    out.push_str("login-throttle=0\n")
    out.push_str("# console-style: auto shows Calcite's own look on a terminal, and vanilla's exact lines in a\n")
    out.push_str("# file or a pipe, which hosting panels read. calcite or vanilla picks one. logs/latest.log\n")
    out.push_str("# always has vanilla's lines.\n")
    out.push_str("console-style=auto\n")
    out.push_str("# console-dashboard: bottom or top pins a bar to that edge of the terminal with how the\n")
    out.push_str("# server is doing: TPS, MSPT, players, RAM, CPU, chunks and uptime. Commands are typed\n")
    out.push_str("# beside it. It's drawn only on a terminal, never in a file, a pipe or a hosting panel.\n")
    out.push_str("console-dashboard=off\n")
    out.push_str("# force-view-distance: the view distance every player gets, from 2 to 1024 chunks, whatever\n")
    out.push_str("# their client asks for, for testing with views past the 127 a client can ask for. 0 is off.\n")
    out.push_str("force-view-distance=0\n")
    out.push_str("# chunk-send-cap: the most chunks a tick a player is sent, however many their client asks for.\n")
    out.push_str("# Vanilla's is 64. 0 sends as many as the client asks for.\n")
    out.push_str("chunk-send-cap=0\n")
    out.push_str("# chunk-send-multiplier: what the chunks a tick a client asks for are multiplied by, from\n")
    out.push_str("# 0.1 to 100, to send faster than it asks, or slower. 1.0 sends what it asks for.\n")
    out.push_str("chunk-send-multiplier=1.0\n")
    out.push_str("# chunk-send-boost: a client that asks for fewer than 64 chunks a tick, as one on a slow link\n")
    out.push_str("# does, is sent this many times as many, up to 64, vanilla's most. From 1, which is off, to 64.\n")
    out.push_str("chunk-send-boost=4.0\n")
    out.push_str("# chunk-workers: how many threads load and generate chunks. 0 is one fewer than the\n")
    out.push_str("# processors. The chunks are the same whatever the number; only how fast changes.\n")
    out.push_str("chunk-workers=0\n")
    out.push_str("# level-random-seed: seed each level's random, which draws its weather and what else happens\n")
    out.push_str("# in it by chance, from this and the dimension's name, so two runs draw the same. Empty seeds\n")
    out.push_str("# them from the system's generator, as vanilla does.\n")
    out.push_str("level-random-seed=\n")
    return out
}
