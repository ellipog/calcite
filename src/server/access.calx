/// Who may join, as vanilla's `PlayerList.canPlayerLogin` decides as a player logs in, from the
/// lists vanilla's `DedicatedPlayerList` reads from the server's folder as it starts:
/// banned-players.json, banned-ips.json, ops.json and whitelist.json, each a JSON array of
/// objects. A player is found by their UUID as Java writes it, and an address by the IP that
/// `IpBanList` cuts from the connection's, as vanilla's `StoredUserList` keys them, each list a
/// Java `HashMap` by those keys, which the commands go over in its order (CAL-361).
///
/// The lists are read at start, and the whitelist again by `whitelist reload`. Vanilla writes the
/// first three back as it starts, and the whitelist if it isn't there. Calcite writes each one
/// that isn't there, as `[]`, and leaves the rest as they are, since writing them back only
/// formats them again. A command that changes a list writes it back, as `StoredUserList.save`
/// writes it, where `writes_back` says so (CAL-361). Vanilla also writes a list it couldn't read
/// back as `[]`, losing it, which Calcite doesn't.
module server.access

import chat.component.{Component}
import java.date.{zone_name}
import java.uuid.{Uuid}
import json.gson.{pretty}
import json.tree.{Json, Member, get, parse}
import server.log.{Entry}
import std.fs.{is_file, read, write}
import std.time.{Timestamp}

/// A player's name and UUID, vanilla's `NameAndId`.
pub struct Named {
    pub id: Uuid
    pub name: String
}

/// A ban, as vanilla's `BanListEntry` holds one: the player's name, or the IP, it bans; when it
/// was made, in milliseconds since 1970; who made it, `getSource`; when it ends, `none` for
/// never, or a date that doesn't parse; and why, `none` for the default reason.
pub struct Ban {
    pub name: String
    pub created: i64
    pub source: String
    pub expires: i64?
    pub reason: String?
}

impl Ban {
    /// `getReasonMessage`: the reason, else `multiplayer.disconnect.banned.reason.default`.
    pub fn reason_message(self) -> Component {
        if let r = self.reason {
            return Component.literal(r)
        }
        return Component.translatable("multiplayer.disconnect.banned.reason.default", [])
    }
}

/// An op, as `ServerOpListEntry` holds one: their name, their permission level, and whether they
/// may join a full server, `bypassesPlayerLimit`.
pub struct Op {
    pub name: String
    pub level: i32
    pub bypass: bool
}

/// Who may join: the four lists and `white-list`.
pub struct Access {
    /// `white-list` from server.properties, default `true`: whether only ops and the players on
    /// the whitelist may join.
    pub whitelist_on: bool
    /// `enforce-whitelist`, default `false`: whether the whitelist turned on, or a player taken
    /// off it or made no op, kicks those it doesn't list, `kickUnlistedPlayers`.
    pub enforce_whitelist: bool
    /// `op-permission-level`, default 4: the level `op` makes a player an op at,
    /// `operatorUserPermissions`.
    pub op_level: i32
    whitelist: JavaHashMap<String, String>
    ops: JavaHashMap<String, Op>
    bans: JavaHashMap<String, Ban>
    ip_bans: JavaHashMap<String, Ban>
    // The folder the lists are in, and whether one a command changes is written back there.
    folder: String
    saves: bool
    // The warnings of lists that couldn't be written, till they're taken.
    failed: List<Entry>
}

impl Access {
    /// No one on any list.
    pub fn empty(whitelist_on: bool) -> Access {
        return Access { whitelist_on: whitelist_on, enforce_whitelist: false, op_level: 4, whitelist: JavaHashMap<String, String>(), ops: JavaHashMap<String, Op>(), bans: JavaHashMap<String, Ban>(), ip_bans: JavaHashMap<String, Ban>(), folder: String("."), saves: false, failed: List<Entry>() }
    }

    /// The lists in `folder`, the server's, with a warning in `lines` for each that can't be
    /// read, as vanilla's are. The entries before one that isn't an object are kept, as vanilla
    /// keeps them, and one without a player or an address is passed over. A ban made at a date
    /// that's missing or doesn't parse was made now, as `new Date()` makes it.
    pub fn load(folder: String, whitelist_on: bool, lines: mut List<Entry>) -> Access {
        var access = Access.empty(whitelist_on)
        access.folder = folder.copy()
        let now = unsafe { Timestamp.now() }.unix_ms
        for o in entries(folder, "banned-players.json", "user banlist", mut lines) {
            if let u = user(o) {
                access.bans.insert(u.id.to_string(), ban(o, u.name, now))
            }
        }
        for o in entries(folder, "banned-ips.json", "ip banlist", mut lines) {
            if let ip = string_of(o, "ip") {
                access.ip_bans.insert(ip.copy(), ban(o, ip, now))
            }
        }
        for o in entries(folder, "ops.json", "operators list", mut lines) {
            if let u = user(o) {
                access.ops.insert(u.id.to_string(), Op { name: u.name.copy(), level: op_level_of(o), bypass: flag(o, "bypassesPlayerLimit") })
            }
        }
        access.read_whitelist(mut lines)
        return access
    }

    /// The server's folder, which the lists are in (CAL-363).
    pub fn server_folder(self) -> String {
        return self.folder.copy()
    }

    /// From now on, a list a command changes is written back to the folder (CAL-361).
    pub fn writes_back(mut self) {
        self.saves = true
    }

    /// The warnings of the lists that couldn't be written since they were last taken.
    pub fn take_warnings(mut self) -> List<Entry> {
        let out = self.failed.copy()
        self.failed = List<Entry>()
        return out
    }

    /// `whitelist reload`: whitelist.json read again, `reloadWhiteList`, where it's there, with a
    /// warning in `lines` where it can't be (CAL-361).
    pub fn reload_whitelist(mut self, lines: mut List<Entry>) {
        self.read_whitelist(mut lines)
    }

    // `UserWhiteList.load`: where the file's there, the list emptied, then each player in it.
    fn read_whitelist(mut self, lines: mut List<Entry>) {
        if not is_file("{self.folder}/whitelist.json") {
            return
        }
        self.whitelist.clear()
        let found = entries(self.folder, "whitelist.json", "white-list", mut lines)
        for o in found {
            if let u = user(o) {
                self.whitelist.insert(u.id.to_string(), u.name.copy())
            }
        }
    }

    /// The permission level of the player `id`, as `getProfilePermissions` gives it: an op's
    /// from ops.json, and 0 for anyone else.
    pub fn level(self, id: Uuid) -> i32 {
        let key = id.to_string()
        return if self.ops.contains(key) { self.ops[key].level } else { 0 }
    }

    /// Makes the player `id` an op at `level`, who doesn't bypass the player limit, as a test's
    /// server has them.
    pub fn op(mut self, id: Uuid, level: i32) {
        self.ops.insert(id.to_string(), Op { name: String(), level: level, bypass: false })
    }

    /// Whether there's any op, as `getOps().isEmpty()` asks (D376).
    pub fn has_ops(self) -> bool {
        return not self.ops.is_empty()
    }

    /// Whether the player `id` is an op, whatever their level.
    pub fn is_op(self, id: Uuid) -> bool {
        return self.ops.contains(id.to_string())
    }

    /// `PlayerList.op`: the player made an op at `op-permission-level`, who may bypass the player
    /// limit where they could before, and ops.json written (CAL-361).
    pub fn make_op(mut self, n: Named) {
        let key = n.id.to_string()
        let bypass = self.ops.contains(key) and self.ops[key].bypass
        self.ops.insert(key, Op { name: n.name.copy(), level: self.op_level, bypass: bypass })
        self.save_ops(true)
    }

    /// `PlayerList.deop`: whether the player `id` was an op, who isn't now, with ops.json
    /// written (CAL-361).
    pub fn deop(mut self, id: Uuid) -> bool {
        match self.ops.remove(id.to_string()) {
            some(_) => {},
            none => return false,
        }
        self.save_ops(false)
        return true
    }

    /// Whether the player `id` is banned, `isBanned`, though their ban may have expired.
    pub fn is_banned(self, id: Uuid) -> bool {
        return self.bans.contains(id.to_string())
    }

    /// `UserBanList.add`: the player banned by `b`, and banned-players.json written (CAL-361).
    pub fn ban(mut self, id: Uuid, b: own Ban) {
        self.bans.insert(id.to_string(), b)
        self.save_bans(true)
    }

    /// `UserBanList.remove`: whether the player `id` was banned, who isn't now, with
    /// banned-players.json written (CAL-361).
    pub fn pardon(mut self, id: Uuid) -> bool {
        match self.bans.remove(id.to_string()) {
            some(_) => {},
            none => return false,
        }
        self.save_bans(false)
        return true
    }

    /// Whether the address `ip` is banned, `IpBanList.isBanned`.
    pub fn is_ip_banned(self, ip: String) -> bool {
        return self.ip_bans.contains(ip)
    }

    /// `IpBanList.add`: the address the ban names banned, and banned-ips.json written (CAL-361).
    pub fn ban_address(mut self, b: own Ban) {
        let key = b.name.copy()
        self.ip_bans.insert(key, b)
        self.save_ip_bans(true)
    }

    /// `IpBanList.remove`: whether the address `ip` was banned, which it isn't now, with
    /// banned-ips.json written (CAL-361).
    pub fn pardon_address(mut self, ip: String) -> bool {
        match self.ip_bans.remove(ip) {
            some(_) => {},
            none => return false,
        }
        self.save_ip_bans(false)
        return true
    }

    /// Whether the player `id` is on the whitelist, `UserWhiteList.isWhiteListed`, whether or
    /// not it's on.
    pub fn whitelisted(self, id: Uuid) -> bool {
        return self.whitelist.contains(id.to_string())
    }

    /// `UserWhiteList.add`: the player put on the whitelist, and whitelist.json written
    /// (CAL-361).
    pub fn add_to_whitelist(mut self, n: Named) {
        self.whitelist.insert(n.id.to_string(), n.name.copy())
        self.save_whitelist(true)
    }

    /// `UserWhiteList.remove`: whether the player `id` was on the whitelist, who isn't now, with
    /// whitelist.json written (CAL-361).
    pub fn remove_from_whitelist(mut self, id: Uuid) -> bool {
        match self.whitelist.remove(id.to_string()) {
            some(_) => {},
            none => return false,
        }
        self.save_whitelist(false)
        return true
    }

    /// The ops' names, `getOpNames`, in the list's order.
    pub fn op_names(self) -> List<String> {
        var out = List<String>()
        for (_, o) in self.ops {
            out.push(o.name.copy())
        }
        return out
    }

    /// The names on the whitelist, `getWhiteListNames`, in its order.
    pub fn whitelist_names(self) -> List<String> {
        var out = List<String>()
        for (_, name) in self.whitelist {
            out.push(name.copy())
        }
        return out
    }

    /// The banned players' names, `UserBanList.getUserList`, in the list's order.
    pub fn banned_names(self) -> List<String> {
        var out = List<String>()
        for (_, b) in self.bans {
            out.push(b.name.copy())
        }
        return out
    }

    /// The banned addresses, `IpBanList.getUserList`, in the list's order.
    pub fn banned_addresses(self) -> List<String> {
        var out = List<String>()
        for (ip, _) in self.ip_bans {
            out.push(ip.copy())
        }
        return out
    }

    /// The players' bans, `getEntries`, in the list's order, those expired too.
    pub fn bans_listed(self) -> List<Ban> {
        var out = List<Ban>()
        for (_, b) in self.bans {
            out.push(b.copy())
        }
        return out
    }

    /// The addresses' bans, `getEntries`, in the list's order, those expired too.
    pub fn address_bans_listed(self) -> List<Ban> {
        var out = List<Ban>()
        for (_, b) in self.ip_bans {
            out.push(b.copy())
        }
        return out
    }

    /// How many players the whitelist lets in: those on it, and the ops, who needn't be.
    pub fn listed(self) -> usize {
        var n = self.whitelist.len()
        for (id, _) in self.ops {
            if not self.whitelist.contains(id) {
                n += 1
            }
        }
        return n
    }

    /// Writes each list that isn't in `folder` as an empty one, as vanilla does as it starts,
    /// with a warning in `lines` for each that can't be written.
    pub fn make_missing(folder: String, lines: mut List<Entry>) {
        let files = [("banned-players.json", "user banlist"), ("banned-ips.json", "ip banlist"), ("ops.json", "operators list"), ("whitelist.json", "white-list")]
        for (name, what) in files {
            let path = "{folder}/{name}"
            if is_file(path) {
                continue
            }
            match write(path, String("[]").to_bytes()) {
                ok => {},
                err(_) => lines.push(Entry.warn("Failed to save {what}: {name} can't be written")),
            }
        }
    }

    /// Why the player `id`, from the address `ip`, may not join, as `canPlayerLogin` says it, or
    /// `none` if they may: a ban, then the whitelist, which lets ops past, then a ban of the
    /// address, then a full server, with `online` playing and room for `max`, which an op may be
    /// let past. `now` is the wall clock, which ends a ban that expires.
    ///
    /// Vanilla finds a ban that has expired as it checks, then throws when it asks for its
    /// reason, as asking for it is what drops it; the login fails, and the next one goes in. Here
    /// a ban that has expired is no ban.
    pub fn refusal(self, id: Uuid, ip: String, online: usize, max: i32, now: Timestamp) -> Component? {
        let key = id.to_string()
        if self.bans.contains(key) {
            if let reason = banned(self.bans[key], "multiplayer.disconnect.banned", now) {
                return some(reason)
            }
        }
        if self.whitelist_on and not self.ops.contains(key) and not self.whitelist.contains(key) {
            return some(Component.translatable("multiplayer.disconnect.not_whitelisted", []))
        }
        if self.ip_bans.contains(ip) {
            if let reason = banned(self.ip_bans[ip], "multiplayer.disconnect.banned_ip", now) {
                return some(reason)
            }
        }
        let full = max <= 0 or online >= usize.wrap(max)
        let bypass = self.ops.contains(key) and self.ops[key].bypass
        if full and not bypass {
            return some(Component.translatable("multiplayer.disconnect.server_full", []))
        }
        return none
    }

    // ops.json as `ServerOpList.save` writes it: each op's UUID, name, level and
    // `bypassesPlayerLimit`.
    fn save_ops(mut self, added: bool) {
        var items = List<Json>()
        for (key, o) in self.ops {
            var m = named_members(key, o.name)
            m.push(Member { key: String("level"), value: Json.Number("{o.level}") })
            m.push(Member { key: String("bypassesPlayerLimit"), value: Json.Bool(o.bypass) })
            items.push(Json.Object(m))
        }
        self.save("ops.json", items, added)
    }

    // whitelist.json as `UserWhiteList.save` writes it: each player's UUID and name.
    fn save_whitelist(mut self, added: bool) {
        var items = List<Json>()
        for (key, name) in self.whitelist {
            items.push(Json.Object(named_members(key, name)))
        }
        self.save("whitelist.json", items, added)
    }

    // banned-players.json as `UserBanList.save` writes it: each player's UUID and name, then
    // their ban.
    fn save_bans(mut self, added: bool) {
        var items = List<Json>()
        for (key, b) in self.bans {
            var m = named_members(key, b.name)
            ban_members(mut m, b)
            items.push(Json.Object(m))
        }
        self.save("banned-players.json", items, added)
    }

    // banned-ips.json as `IpBanList.save` writes it: each address, then its ban.
    fn save_ip_bans(mut self, added: bool) {
        var items = List<Json>()
        for (ip, b) in self.ip_bans {
            var m: List<Member> = [Member { key: String("ip"), value: Json.Str(ip.copy()) }]
            ban_members(mut m, b)
            items.push(Json.Object(m))
        }
        self.save("banned-ips.json", items, added)
    }

    // `StoredUserList.save`: the list as Gson pretty-prints it, where lists are written back,
    // with vanilla's warning where it can't be.
    fn save(mut self, name: str, items: own List<Json>, added: bool) {
        if not self.saves {
            return
        }
        match write("{self.folder}/{name}", pretty(Json.Array(items)).to_bytes()) {
            ok => {},
            err(_) => self.failed.push(Entry.warn(if added { "Could not save the list after adding a user." } else { "Could not save the list after removing a user." })),
        }
    }
}

// `NameAndId.appendTo`: the UUID, then the name.
fn named_members(id: String, name: String) -> List<Member> {
    return [Member { key: String("uuid"), value: Json.Str(id.copy()) }, Member { key: String("name"), value: Json.Str(name.copy()) }]
}

// `BanListEntry.serialize`: when it was made, by whom, when it ends, `forever` where it doesn't,
// and why, which Gson leaves out where there's no reason.
fn ban_members(m: mut List<Member>, b: Ban) {
    m.push(Member { key: String("created"), value: Json.Str(list_date(b.created)) })
    m.push(Member { key: String("source"), value: Json.Str(b.source.copy()) })
    let expires = match b.expires {
        some(at) => list_date(at),
        none => String("forever"),
    }
    m.push(Member { key: String("expires"), value: Json.Str(expires) })
    let reason = match b.reason {
        some(r) => Json.Str(r.copy()),
        none => Json.Null,
    }
    m.push(Member { key: String("reason"), value: reason })
}

// An op's `level`, as `ServerOpListEntry` reads it: 0 where it's missing, and kept from 0 to 4,
// as `PermissionLevel.byId` clamps it. One that isn't a number is read as vanilla's `getAsInt`
// reads it, which throws, so the entry is dropped; here it's 0.
fn op_level_of(o: List<Member>) -> i32 {
    for m in o {
        if m.key == "level" {
            match m.value {
                Json.Number(text) => {
                    if let n = i32.parse(text) {
                        return n.max(0).min(4)
                    }
                },
                _ => {},
            }
        }
    }
    return 0
}

/// The IP an address is banned by, as `IpBanList` cuts it from the address's `toString`, such as
/// `/127.0.0.1:50412`: what's after the `/`, up to a `:`. So an IPv6 address, which Java writes
/// in brackets, is cut to `[` and its first group, as it is in vanilla, and only a ban of that
/// matches it.
pub fn ban_ip(address: String) -> String {
    var ip = address.copy()
    if let slash = ip.find("/") {
        ip = ip[slash + 1..]
    }
    if let colon = ip.find(":") {
        ip = ip[..colon]
    }
    return ip
}

/// Whether the text is an IP address, as Guava's `InetAddresses.isInetAddress` reads one, which
/// `ban-ip` and `pardon-ip` ask (CAL-361): hex digits, dots and colons only, up to a `%`, after
/// which an IPv6 address's scope is anything; IPv4 as 4 decimal parts of up to 3 digits, none
/// past 255 and none with a leading zero; IPv6 as 8 groups of up to 4 hex digits, `::` once for
/// one or more groups of zeros, the last two groups perhaps a dotted IPv4 address.
pub fn is_inet_address(text: String) -> bool {
    var colon = false
    var dot = false
    var percent: usize? = none
    for i in 0..text.len() {
        let c = text.byte_at(i)
        if c == 46 {
            dot = true
        } else if c == 58 {
            if dot {
                return false
            }
            colon = true
        } else if c == 37 {
            percent = some(i)
            break
        } else if not is_hex(c) {
            return false
        }
    }
    if colon {
        var ip = text.copy()
        if dot {
            let last = ip.find_last(":") ?? 0
            let quad = v4_parts(ip[last + 1..]) else return false
            ip = "{ip[..last + 1]}{hex_of(quad[0] * 256 + quad[1])}:{hex_of(quad[2] * 256 + quad[3])}"
        }
        if let p = percent {
            if p <= ip.len() {
                ip = ip[..p]
            }
        }
        return is_v6(ip)
    }
    if dot {
        if percent != none {
            return false
        }
        return v4_parts(text) != none
    }
    return false
}

// `textToNumericFormatV4`'s four parts, or `none`.
fn v4_parts(text: String) -> List<i32>? {
    var parts = List<i32>()
    var start: usize = 0
    for i in 0..text.len() + 1 {
        if i < text.len() and text.byte_at(i) != 46 {
            continue
        }
        let length = i - start
        if length == 0 or length > 3 or (length > 1 and text.byte_at(start) == 48) {
            return none
        }
        var n = 0
        for j in start..i {
            let c = text.byte_at(j)
            if c < 48 or c > 57 {
                return none
            }
            n = n * 10 + i32(c - 48)
        }
        if n > 255 {
            return none
        }
        parts.push(n)
        start = i + 1
    }
    return if parts.len() == 4 { some(parts) } else { none }
}

// `textToNumericFormatV6`: whether the text, with no scope, is an IPv6 address's groups.
fn is_v6(text: String) -> bool {
    let n = text.len()
    var delimiters = 0
    for i in 0..n {
        if text.byte_at(i) == 58 {
            delimiters += 1
        }
    }
    if delimiters < 2 or delimiters > 8 {
        return false
    }
    var skipped = 8 - (delimiters + 1)
    var skip = false
    for i in 0..n - 1 {
        if text.byte_at(i) == 58 and text.byte_at(i + 1) == 58 {
            if skip {
                return false
            }
            skip = true
            skipped += 1
            if i == 0 {
                skipped += 1
            }
            if i == n - 2 {
                skipped += 1
            }
        }
    }
    if text.byte_at(0) == 58 and text.byte_at(1) != 58 {
        return false
    }
    if text.byte_at(n - 1) == 58 and text.byte_at(n - 2) != 58 {
        return false
    }
    if skip and skipped <= 0 {
        return false
    }
    if not skip and delimiters + 1 != 8 {
        return false
    }
    // Each group between the colons, of 1 to 4 hex digits.
    var start: usize = if text.byte_at(0) == 58 { 1 } else { 0 }
    while start < n {
        var end = start
        while end < n and text.byte_at(end) != 58 {
            end += 1
        }
        if text.byte_at(start) != 58 {
            let length = end - start
            if length == 0 or length > 4 {
                return false
            }
            for j in start..end {
                if not is_hex(text.byte_at(j)) {
                    return false
                }
            }
        }
        start = end + 1
    }
    return true
}

fn is_hex(c: u8) -> bool {
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

// `Integer.toHexString`.
fn hex_of(v: i32) -> String {
    let digits = "0123456789abcdef"
    if v == 0 {
        return String("0")
    }
    var out = String()
    var n = v
    while n > 0 {
        let d = usize.wrap(n % 16)
        out = "{digits[d..d + 1]}{out}"
        n /= 16
    }
    return out
}

// The reason a ban gives, `key` with its reason and, if it expires, `key.expiration` with the
// date, or `none` if it has expired.
fn banned(b: Ban, key: str, now: Timestamp) -> Component? {
    var reason = Component.translatable("{key}.reason", [b.reason_message()])
    if let at = b.expires {
        if at < now.unix_ms {
            return none
        }
        reason.extra.push(Component.translatable("{key}.expiration", [Component.literal(ban_date(Timestamp { unix_ms: at }))]))
    }
    return some(reason)
}

// The date a ban ends, as `PlayerList`'s `yyyy-MM-dd 'at' HH:mm:ss z` writes it, in the
// system's time zone, which vanilla's JVM has too.
fn ban_date(at: Timestamp) -> String {
    let offset = unsafe { at.local_offset() }
    let zone = zone_name(unsafe { at.zone_abbreviation() }, offset)
    let d = at.date_time(offset)
    return "{d.year}-{two(d.month)}-{two(d.day)} at {two(d.hour)}:{two(d.minute)}:{two(d.second)} {zone}"
}

/// A date, in milliseconds since 1970, as `yyyy-MM-dd HH:mm:ss Z` writes it, in the system's time
/// zone, as vanilla's JVM has it: `2026-10-29 12:00:00 +0100`. The lists and usercache.json write
/// their dates so (CAL-361).
pub fn list_date(at: i64) -> String {
    let t = Timestamp { unix_ms: at }
    let offset = unsafe { t.local_offset() }
    let d = t.date_time(offset)
    let sign = if offset < 0 { "-" } else { "+" }
    let minutes = offset.abs() / 60
    return "{d.year}-{two(d.month)}-{two(d.day)} {two(d.hour)}:{two(d.minute)}:{two(d.second)} {sign}{two(minutes / 60)}{two(minutes % 60)}"
}

// The objects in the list `path` in `folder`: none if it isn't there or is empty, none with a
// warning if it isn't a JSON array, and the objects before the first value that isn't one, with
// a warning.
fn entries(folder: String, path: str, what: str, lines: mut List<Entry>) -> List<List<Member>> {
    var objects = List<List<Member>>()
    let file = "{folder}/{path}"
    if not is_file(file) {
        return objects
    }
    let bytes = match read(file) {
        ok(b) => b,
        err(_) => {
            lines.push(Entry.warn("Failed to load {what}: {path} can't be read"))
            return objects
        },
    }
    let text = String.from_utf8(bytes) else {
        lines.push(Entry.warn("Failed to load {what}: {path} isn't UTF-8"))
        return objects
    }
    // Gson reads an empty file, or `null`, as no list at all.
    if blank(text) {
        return objects
    }
    let json = parse(text) else {
        lines.push(Entry.warn("Failed to load {what}: {path} isn't JSON"))
        return objects
    }
    match json {
        Json.Null => {},
        Json.Array(values) => {
            for v in values {
                match v {
                    Json.Object(members) => objects.push(members.copy()),
                    _ => {
                        lines.push(Entry.warn("Failed to load {what}: an entry in {path} isn't an object"))
                        return objects
                    },
                }
            }
        },
        _ => lines.push(Entry.warn("Failed to load {what}: {path} isn't a JSON array")),
    }
    return objects
}

/// The player an entry names, as `NameAndId.fromJson` reads them: `none` if it hasn't both
/// `uuid` and `name`, or the UUID doesn't parse.
pub fn user(o: List<Member>) -> Named? {
    let id = string_of(o, "uuid") else return none
    let name = string_of(o, "name") else return none
    let uuid = Uuid.parse(id) else return none
    return some(Named { id: uuid, name: name })
}

// A ban as `BanListEntry` reads it, of `name`: made at `created`, else `now`; by `source`, else
// `(Unknown)`; ending at `expires`, else never; for `reason`, else none.
fn ban(o: List<Member>, name: String, now: i64) -> Ban {
    var created = now
    if let date = string_of(o, "created") {
        created = parse_date(date) ?? now
    }
    var expires: i64? = none
    if let date = string_of(o, "expires") {
        expires = parse_date(date)
    }
    return Ban { name: name.copy(), created: created, source: string_of(o, "source") ?? String("(Unknown)"), expires: expires, reason: string_of(o, "reason") }
}

/// A member as `getAsString` gives it: a string's text, or a number's or a boolean's as Java
/// writes it.
pub fn string_of(o: List<Member>, key: str) -> String? {
    let v = get(o, String(key)) else return none
    return match v {
        Json.Str(s) => some(s.copy()),
        Json.Number(n) => some(n.copy()),
        Json.Bool(b) => some(String(if b { "true" } else { "false" })),
        _ => none,
    }
}

// A member as `getAsBoolean` reads it: `true`, or a string that's `true` in any case.
fn flag(o: List<Member>, key: str) -> bool {
    let v = get(o, String(key)) else return false
    return match v {
        Json.Bool(b) => b,
        Json.Str(s) => s.to_lower_root() == "true",
        _ => false,
    }
}

/// A date as `BanListEntry`'s `yyyy-MM-dd HH:mm:ss Z` reads it, such as
/// `2026-10-29 12:00:00 +0100`, in milliseconds since 1970, or `none` if it doesn't parse.
/// `SimpleDateFormat` is lenient, so each number may have any count of digits, a number past its
/// field's end carries into the next, as the 32nd of a month is the 1st of the next, and what
/// follows the zone is ignored. The zone is an offset, `+HHMM` or `-HHMM`, or `GMT` or `UTC`
/// with or without one, as `+HH:MM`; zones by name, such as `CET`, aren't read.
pub fn parse_date(text: String) -> i64? {
    var at: usize = 0
    let year = number(text, mut at) else return none
    if not expect(text, mut at, 45) {
        return none
    }
    let month = number(text, mut at) else return none
    if not expect(text, mut at, 45) {
        return none
    }
    let day = number(text, mut at) else return none
    if not expect(text, mut at, 32) {
        return none
    }
    let hour = number(text, mut at) else return none
    if not expect(text, mut at, 58) {
        return none
    }
    let minute = number(text, mut at) else return none
    if not expect(text, mut at, 58) {
        return none
    }
    let second = number(text, mut at) else return none
    if not expect(text, mut at, 32) {
        return none
    }
    let offset = zone_offset(text, mut at) else return none
    // The month carries into the year, then the day counts on from the month's first.
    let months = year * 12 + month - 1
    let days = civil_days(months.floor_div(12), months.floor_mod(12) + 1) + day - 1
    let seconds = days * 86400 + hour * 3600 + minute * 60 + second - offset
    return some(seconds * 1000)
}

// Digits at `at`, at least one, as a number.
fn number(text: String, at: mut usize) -> i64? {
    let start = at
    var n: i64 = 0
    while at < text.len() {
        let b = text.byte_at(at)
        if b < 48 or b > 57 {
            break
        }
        if n > 100000000000 {
            return none
        }
        n = n * 10 + i64(b - 48)
        at += 1
    }
    return if at == start { none } else { some(n) }
}

// Whether the byte at `at` is `b`, which it steps past if it is.
fn expect(text: String, at: mut usize, b: u8) -> bool {
    if at >= text.len() or text.byte_at(at) != b {
        return false
    }
    at += 1
    return true
}

// Whether the text is only JSON's white space, or nothing.
fn blank(text: String) -> bool {
    for i in 0..text.len() {
        let b = text.byte_at(i)
        if b != 32 and b != 9 and b != 10 and b != 13 {
            return false
        }
    }
    return true
}

// A zone's offset from UTC in seconds: `+0100`, `GMT`, `UTC`, or either with `+01:00`.
fn zone_offset(text: String, at: mut usize) -> i64? {
    let rest = text[at..]
    if rest.starts_with("GMT") or rest.starts_with("UTC") {
        at += 3
        if at >= text.len() {
            return some(0)
        }
        let sign = text.byte_at(at)
        if sign != 43 and sign != 45 {
            return some(0)
        }
        at += 1
        let hours = number(text, mut at) else return none
        var minutes: i64 = 0
        if at < text.len() and text.byte_at(at) == 58 {
            at += 1
            let m = number(text, mut at) else return none
            minutes = m
        }
        let s = (hours * 60 + minutes) * 60
        return some(if sign == 45 { -s } else { s })
    }
    if at + 5 > text.len() {
        return none
    }
    let sign = text.byte_at(at)
    if sign != 43 and sign != 45 {
        return none
    }
    at += 1
    let start = at
    let n = number(text, mut at) else return none
    if at - start != 4 {
        return none
    }
    let s = (n / 100 * 60 + n % 100) * 60
    return some(if sign == 45 { -s } else { s })
}

// Days from 1970-01-01 to the first of `month` in `year`, on the Gregorian calendar.
fn civil_days(year: i64, month: i64) -> i64 {
    let y = if month <= 2 { year - 1 } else { year }
    let era = y.floor_div(400)
    let year_of_era = y - era * 400
    let m = if month > 2 { month - 3 } else { month + 9 }
    let day_of_year = (153 * m + 2) / 5
    let day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
    return era * 146097 + day_of_era - 719468
}

// `n` in two digits at least.
fn two(n: i32) -> String {
    return if n < 10 { "0{n}" } else { "{n}" }
}
