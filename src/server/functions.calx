/// Data-pack functions, `data/<namespace>/function/<path>.mcfunction`, read as vanilla's
/// `ServerFunctionLibrary` reads them, each by `CommandFunction.fromLines` (D567): its lines
/// trimmed, a `\` at a line's end joining the next, comments and blank lines left out, each
/// command read at the level functions are read at, `GAMEMASTERS`, where one that can't be makes
/// the function fail to load, as one starting with `/` does. A line starting with `$` is a macro
/// line, which Calcite reads as `StringTemplate.fromString` does but doesn't run yet.
module server.functions

import chat.language.{Language}
import command.dispatcher.{Tree}
import java.categories.{is_letter_or_digit}
import nbt.snbt.{from_units, units_of}
import pack.resources.{Resources}
import registry.tags.{TagFiles, read_tag_files}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.commands.{Failure, GAMEMASTERS, Parsed, parse_in}
import server.log.{Entry}
import std.text.utf8.{decode_lossy}

/// The world's packs' functions as their files hold them, each by its ID with its text, the top
/// pack's, and the files of their tags, for the server to read once its commands are ready
/// (D567). Vanilla's own data has none.
pub struct FunctionFiles {
    pub files: List<(Identifier, String)> = List<(Identifier, String)>()
    pub tags: TagFiles = TagFiles()
}

impl FunctionFiles {
    /// None, as a world without packs of its own has.
    pub fn empty() -> FunctionFiles {
        return FunctionFiles { files: List<(Identifier, String)>(), tags: TagFiles.empty() }
    }

    /// The functions and their tags' files in `resources`, `data/<namespace>/function/` and
    /// `data/<namespace>/tags/function/`, what can't be read logged in `logs`. A file that isn't
    /// UTF-8 is read as Java reads it, each byte that can't be read as `U+FFFD`.
    pub fn read(resources: Resources, logs: mut List<Entry>) -> FunctionFiles {
        var files = List<(Identifier, String)>()
        for r in resources.list(String("function"), String(".mcfunction"), mut logs) {
            let path = r.id.path["function/".len()..r.id.path.len() - ".mcfunction".len()]
            let id = Identifier { namespace: r.id.namespace.copy(), path: path }
            match resources.read(r) {
                ok(bytes) => files.push((id, decode_lossy(bytes, 0, bytes.len()))),
                err(message) => logs.push(Entry.error("Failed to load function {id.to_string()}: {message}")),
            }
        }
        return FunctionFiles { files: files, tags: read_tag_files(resources, String("tags/function"), mut logs) }
    }
}

/// A function, as vanilla's `CommandFunction` holds it (D567).
pub struct Function {
    pub id: Identifier
    /// Its commands, in order, each read.
    pub lines: List<Parsed>
    /// Whether it has macro lines, which need arguments to run, `MacroFunction`; Calcite doesn't
    /// run those yet.
    pub macro: bool
}

/// The function `id` read from its file's `text` against the tree `t`, or why it can't be, the
/// exception vanilla's `fromLines` throws as Java writes it, its class then its message; a
/// failure's message is in `lang`.
pub fn read_function(id: Identifier, text: String, t: Tree, types: Registry, lang: Language) -> Function ! String {
    let lines = file_lines(text)
    var out = Function { id: id.copy(), lines: List<Parsed>(), macro: false }
    var i: usize = 0
    while i < lines.len() {
        let number = i + 1
        var line = java_trim(lines[i])
        // `shouldConcatenateNextLine`: the next line, trimmed, in place of the `\`, while the
        // line so far ends with one.
        while line.ends_with("\\") {
            i += 1
            if i == lines.len() {
                fail String("java.lang.IllegalArgumentException: Line continuation at end of file")
            }
            line = "{line[..line.len() - 1]}{java_trim(lines[i])}"
            try too_long(line)
        }
        i += 1
        try too_long(line)
        if line.is_empty() or line.starts_with("#") {
            continue
        }
        if line.starts_with("/") {
            // `StringReader.peek` past the end, where there's only the `/`.
            if line.len() == 1 {
                fail String("java.lang.StringIndexOutOfBoundsException: Index 1 out of bounds for length 1")
            }
            if line[1..].starts_with("/") {
                fail "java.lang.IllegalArgumentException: Unknown or invalid command '{line}' on line {number} (if you intended to make a comment, use '#' not '//')"
            }
            fail "java.lang.IllegalArgumentException: Unknown or invalid command '{line}' on line {number} (did you mean '{unquoted(line[1..])}'? Do not use a preceding forwards slash.)"
        }
        if line.starts_with("$") {
            // The template's problem is the cause of vanilla's exception, which its log shows
            // below it.
            match template_problem(line[1..]) {
                some(_) => fail "java.lang.IllegalArgumentException: Can't parse function line {number}: '{line[1..]}'",
                none => out.macro = true,
            }
            continue
        }
        match parse_in(t, line.copy(), GAMEMASTERS, types) {
            ok(p) => out.lines.push(p),
            err(f) => fail "java.lang.IllegalArgumentException: Whilst parsing command on line {number}: {exception_message(f, lang)}",
        }
    }
    return out
}

// `checkCommandLineLength`: a line, or one joined so far, may be at most 2000000 units long.
fn too_long(line: String) ! String {
    let units = units_of(line)
    if units.len() > 2000000 {
        fail "java.lang.IllegalStateException: Command too long: {units.len()} characters, contents: {from_units(units, 0, 512)}..."
    }
}

// The lines of a file as `BufferedReader.lines` gives them: ended by `\n`, `\r\n` or `\r`, with
// no empty line after the last end.
fn file_lines(text: String) -> List<String> {
    let units = units_of(text)
    var out = List<String>()
    var start: usize = 0
    var i: usize = 0
    while i < units.len() {
        if units[i] == '\n' or units[i] == '\r' {
            out.push(from_units(units, start, i))
            if units[i] == '\r' and i + 1 < units.len() and units[i + 1] == '\n' {
                i += 1
            }
            start = i + 1
        }
        i += 1
    }
    if start < units.len() {
        out.push(from_units(units, start, units.len()))
    }
    return out
}

// `String.trim`: the text without the characters up to a space, ` `, at either end.
fn java_trim(text: String) -> String {
    let units = units_of(text)
    var start: usize = 0
    var end = units.len()
    while start < end and u32(units[start]) <= 32 {
        start += 1
    }
    while end > start and u32(units[end - 1]) <= 32 {
        end -= 1
    }
    return from_units(units, start, end)
}

// `StringReader.readUnquotedString` from the start of `text`: the letters, digits and `_`, `-`,
// `.` and `+` there.
fn unquoted(text: String) -> String {
    let units = units_of(text)
    var end: usize = 0
    while end < units.len() {
        let c = units[end]
        let allowed = (c >= '0' and c <= '9') or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' or c == '-' or c == '.' or c == '+'
        if not allowed {
            break
        }
        end += 1
    }
    return from_units(units, 0, end)
}

// Why `StringTemplate.fromString` can't read a macro line, or none where it can: each `$(` must be
// closed by a `)`, and name a variable of letters, digits and `_`; and there must be one.
fn template_problem(line: String) -> String? {
    let units = units_of(line)
    var start: usize = 0
    var i: usize = 0
    var any = false
    while i < units.len() {
        if units[i] == '$' and i + 1 < units.len() and units[i + 1] == '(' {
            var end = i + 2
            while end < units.len() and units[end] != ')' {
                end += 1
            }
            if end == units.len() {
                return some(String("Unterminated macro variable"))
            }
            // `isValidVariableName`: each unit a letter or digit, `Character.isLetterOrDigit`,
            // or `_`.
            for k in i + 2..end {
                if not (units[k] == '_' or is_letter_or_digit(u32(units[k]))) {
                    return some("Invalid macro variable name '{from_units(units, i + 2, end)}'")
                }
            }
            any = true
            start = end + 1
            i = start
            continue
        }
        i += 1
    }
    if not any {
        return some(String("No variables in macro"))
    }
    return none
}

// `CommandSyntaxException.getMessage`: the message, then where the input was when it failed and
// what came before, as `getContext` writes it.
fn exception_message(f: Failure, lang: Language) -> String {
    let message = f.message.get_string(lang)
    if f.cursor < 0 {
        return message
    }
    let units = units_of(f.input)
    let cursor = usize.wrap(f.cursor).min(units.len())
    let start = if cursor > 10 { cursor - 10 } else { 0 }
    let dots = if cursor > 10 { "..." } else { "" }
    return "{message} at position {f.cursor}: {dots}{from_units(units, start, cursor)}<--[HERE]"
}
