        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        if not f.is_a(f.block(state), String("RedStoneOreBlock")) {
            return
        }
        match interact_ore(f, mut self, state, x, y, z) {
            ok => {},
            err(thrown) => self.report(thrown.message),
        }
    }

    /// The wooden button at `x`, `y`, `z` an arrow went into, `ButtonBlock.entityInside` (CAL-159):
    /// where it's still a button arrows press and isn't pressed, pressed, `checkPressed`, the arrow
    /// in its shape, `arrow_press`.
    pub fn press_by_arrow(mut self, x: i32, y: i32, z: i32) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        let block = f.block(state)
        if not f.is_a(block, String("ButtonBlock")) or f.get_bool(state, String("powered")) or not arrows_press(f, block) {
            return
        }
        match arrow_press(f, mut self, state, x, y, z) {
            ok => {},
            err(thrown) => self.report(thrown.message),
        }
    }

    /// `BasePressurePlateBlock.entityInside` of a pressure plate at x, y, z an entity went into,
    /// as it goes in, `counted` of the entities on it then, every one and the living ones, the
    /// players among them (D701): pressed as they press it, where it gives nothing yet.
    pub fn press_plate(mut self, x: i32, y: i32, z: i32, counted: (i32, i32)) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        self.pressing = some(counted)
        match plate_entered(f, mut self, state, x, y, z) {
            ok => {},
            err(thrown) => self.report(thrown.message),
        }
        self.pressing = none
    }

    /// `TripWireBlock.entityInside` of tripwire at x, y, z an entity that doesn't ignore block
    /// triggers went into (D702): pressed by it where it isn't powered and its tick isn't
    /// scheduled.
    pub fn trip(mut self, x: i32, y: i32, z: i32) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        match tripwire_entered(f, mut self, state, x, y, z) {
            ok => {},
            err(thrown) => self.report(thrown.message),
        }
    }

