    }

    /// `playSound(except, ...)` of `sound` at x, y, z from `source`, at `volume` and `pitch`, heard
    /// by those near but the player `except`, by their entity, as a player's own sound,
    /// `Player.playSound`, plays it, its seed drawn all the same (D418).
    pub fn play_sound_except(mut self, sound: own String, x: f64, y: f64, z: f64, source: i32, volume: f32, pitch: f32, except: i32) {
        self.sound_seeds += -7046029254386353131
