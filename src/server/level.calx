/// The overworld's chunks, as vanilla's `ServerChunkCache` and `ChunkMap` keep them: which load,
/// which are ready to send, and when they go (CAL-65).
///
/// `world.distance` says which chunks load, from the players' tickets and a joining player's
/// spawn ticket. Each chunk whose holder's level comes to 33, full, or below gets its chunk. A
/// world whose folder is open reads it from its region file, on the IO thread and the chunk
/// workers of `server.chunk_jobs`, and a chunk that wasn't saved is generated flat, as is every
/// chunk of a world that reads nothing; a flat chunk is sent from the flat world's one body, so
/// it holds no chunk of its own. A chunk is ready to send once it ticks, as `getChunkToSend` has
/// it: its level is 32 or below and the 3×3 around it is loaded, as `prepareTickingChunk` waits
/// for. Its entities tick, which lets the dispatcher hand the next player tickets over, once the
/// 5×5 around it is loaded, as the entity ticking future waits for. A holder that unloads takes
/// its chunk with it.
///
/// Vanilla loads, generates and promotes chunks on worker threads, and when each is done is up
/// to them. Here what the IO thread reads comes back to the tick thread, which records it in the
/// input log and makes the chunk loaded in the order it came, then runs the distance manager
/// until it settles, so a replay has the same chunks at the same points (D178).
///
/// A world whose folder is open lights its chunks as vanilla's `ThreadedLevelLightEngine` does,
/// with `world.light`'s engines (CAL-76). Its holders load their chunks from level 34, the
/// `initialize_light` status's, so each full chunk has the chunks around it to be lit with. A
/// chunk is initialized once it's there, as `initializeLight` does it: its sections with blocks
/// told, a run, then its light turned on, lit or not as it was saved. One whose holder is full is
/// lit once the 3×3 around it is initialized, as `lightChunk` does it: its light spread from its
/// blocks and sky, unless it was saved lit, and a run. Only then is it full. Each pass takes every
/// chunk that's ready, as vanilla's light thread takes the tasks it has. A saved chunk's light
/// goes to the engine as it comes, and a chunk that unloads takes its light with it. A chunk is
/// sent with the engine's light, but a flat one whose neighbours are flat too is sent from the
/// flat world's body, since its light is the same. Light that changes once a chunk is sent isn't
/// sent: with no block changing, that's only at the edge of what's lit, and it comes with block
/// changes (D184).
///
/// A view wider than vanilla's 32 has chunks the tickets don't reach: those more than 33 from
/// the player on an axis. Each player's are loaded as their sender comes to them, at most 64 at
/// once, and let go once they're sent, with their light as it was saved. A region's file is asked
/// which chunks it has first, so those it hasn't are sent flat at once. Two players who need the
/// same far chunk each read it (D179).
module server.level

import protocol.play.{ClientboundLevelChunkWithLight, LightData}
import protocol.state.{State}
import protocol.wire.{Writer, write_packet}
import server.chunk_jobs.{ChunkContext, ChunkJobs, Done, Loaded, SavedChunk, prepare}
import server.chunks.{Chunks, Next}
import server.log.{Entry}
import storage.regions.{ChunkRead, region_of}
import world.chunk.{Chunk}
import world.distance.{DistanceManager, Ticking}
import world.flat.{FlatChunk, FlatWorld}
import world.light.{Layer, Light, LightChunks, light_sources}
import world.pos.{ChunkPos}
import world.tickets.{Holders, Ticket, TicketStorage, TicketType}

/// How far around the spawn chunk a joining player's spawn ticket loads full chunks,
/// `PrepareSpawnTask.PREPARE_CHUNK_RADIUS`.
pub const SPAWN_RADIUS: i32 = 3
/// The most far chunks being read for a player at once.
pub const MOST_FAR_LOADS: i32 = 64
// The level of a full chunk, at and below which a holder's chunk is loaded.
const FULL: i32 = 33
// The level at and below which a chunk ticks, so it can be sent.
const TICKING: i32 = 32
// The level at and below which a holder of a world that reads loads its chunk, for light, that
// of `initialize_light`.
const LIGHT_BORDER: i32 = 34

// A chunk the world has, or is reading.
enum Body {
    // Being read.
    Loading
    // Generated flat: every flat chunk is the flat world's.
    Flat
    // As it was saved. A holder's gives its light to the engine as it comes; a far chunk keeps
    // its own.
    Saved(SavedChunk)
}

// The chunks light sees, as vanilla's `getChunkForLighting` gives them: each holder's chunk, by
// its packed position, once it's there, and the flat chunk each flat one is.
struct Columns {
    slots: OpenHashMap<i64, Body> = OpenHashMap<i64, Body>()
    flat: FlatChunk? = none
}

impl LightChunks for Columns {
    fn light_state(self, x: i32, y: i32, z: i32) -> u32? {
        let k = ChunkPos { x: x >> 4, z: z >> 4 }.pack()
        if not self.slots.contains(k) {
            return none
        }
        match self.slots[k] {
            Body.Saved(s) => return some(s.chunk.block(x & 15, y, z & 15)),
            Body.Flat => {
                if let f = self.flat {
                    return some(f.chunk.block(x & 15, y, z & 15))
                }
            },
            Body.Loading => {},
        }
        return none
    }

    fn lowest_sky_source(self, x: i32, z: i32) -> i32? {
        let k = ChunkPos { x: x >> 4, z: z >> 4 }.pack()
        if not self.slots.contains(k) {
            return none
        }
        match self.slots[k] {
            Body.Saved(s) => return some(s.sources.lowest_source_y(x & 15, z & 15)),
            Body.Flat => {
                if let f = self.flat {
                    return some(f.sources.lowest_source_y(x & 15, z & 15))
                }
            },
            Body.Loading => {},
        }
        return none
    }

    fn highest_sky_source(self, chunk_x: i32, chunk_z: i32) -> i32? {
        let k = ChunkPos { x: chunk_x, z: chunk_z }.pack()
        if not self.slots.contains(k) {
            return none
        }
        match self.slots[k] {
            Body.Saved(s) => return some(s.sources.highest_lowest_source_y()),
            Body.Flat => {
                if let f = self.flat {
                    return some(f.sources.highest_lowest_source_y())
                }
            },
            Body.Loading => {},
        }
        return none
    }

    fn light_sources_in(self, chunk_x: i32, chunk_z: i32) -> List<i64> {
        let k = ChunkPos { x: chunk_x, z: chunk_z }.pack()
        if not self.slots.contains(k) {
            return []
        }
        if let f = self.flat {
            match self.slots[k] {
                Body.Saved(s) => return light_sources(s.chunk, f.states, chunk_x, chunk_z),
                Body.Flat => return light_sources(f.chunk, f.states, chunk_x, chunk_z),
                Body.Loading => {},
            }
        }
        return []
    }
}

// A chunk read for a player whose view is wider than the tickets reach, `owner`.
struct Far {
    owner: i32
    body: Body
}

// What's known of a region's file.
enum Region {
    // It's been asked which chunks it has.
    Asked
    // The chunks it has, a bit each by `x + z * 32` in 16 words.
    Known(List<u64>)
}

// What's to be asked of the IO thread.
enum Ask {
    Region(ChunkPos)
    Chunk(ChunkPos)
}

// The chunks being read for their holders, which aren't ready to save until they're read, as
// `isReadyForSaving` says, so their tickets that don't run out unloaded don't run down.
struct Reading {
    chunks: OpenHashSet<i64> = OpenHashSet<i64>()
}

impl Holders for Reading {
    fn ready_for_saving(self, chunk: i64) -> bool {
        return not self.chunks.contains(chunk)
    }
}

/// The overworld's chunks, and the distance manager that says which load.
pub struct Level {
    /// The tickets and players, and the chunks' holders.
    pub dm: DistanceManager
    // Each holder's chunk, and those of them still being read.
    columns: Columns = Columns()
    reading: Reading = Reading()
    // The far chunks read for players, and how many each player has being read.
    far: OpenHashMap<i64, Far> = OpenHashMap<i64, Far>()
    far_loads: OpenHashMap<i32, i32> = OpenHashMap<i32, i32>()
    regions: OpenHashMap<i64, Region> = OpenHashMap<i64, Region>()
    // How many reads of each chunk are asked for and not back.
    asked: OpenHashMap<i64, i32> = OpenHashMap<i64, i32>()
    // What's to go to the IO thread at the next `dispatch`.
    asks: List<Ask> = List<Ask>()
    // Whether chunks are read, and the threads that read them, which a replay hasn't, and what
    // chunks are made with.
    opened: bool = false
    jobs: ChunkJobs? = none
    context: ChunkContext? = none
    // The light, once chunks are read, and the dimension's sections, from its lowest.
    light: Light? = none
    min_section: i32 = 0
    sections: i32 = 0
    // The chunks whose bodies came, to be initialized, in the order they came; those initialized;
    // those of them lit, which are full; and those initialized that may be ready to light.
    arrived: LinkedSet<i64> = LinkedSet<i64>()
    initialized: OpenHashSet<i64> = OpenHashSet<i64>()
    lit: OpenHashSet<i64> = OpenHashSet<i64>()
    to_light: LinkedSet<i64> = LinkedSet<i64>()
    // The holders whose chunks are to tick their entities once the 5×5 around them is loaded.
    waiting: LinkedSet<i64> = LinkedSet<i64>()
    lines: List<Entry> = List<Entry>()
    // The player whose sender asks next, for their far chunks.
    serving: i32 = 0
}

impl Level {
    /// A world whose player tickets reach `view` chunks and whose simulation distance is
    /// `simulation`, as the chunk map sets them, which reads nothing until it's opened.
    pub fn new(view: i32, simulation: i32) -> Level {
        var dm = DistanceManager.new(TicketStorage.new())
        dm.update_player_tickets(view)
        dm.update_simulation_distance(simulation)
        return Level { dm: dm }
    }

    /// Reads chunks from now on, made with `context`: through `jobs`, the IO thread and chunk
    /// workers, or, replaying, from the log, which has what the recording read. Each is lit, and
    /// those generated are `flat`.
    pub fn open(mut self, jobs: own ChunkJobs?, context: own ChunkContext, flat: own FlatChunk) {
        self.opened = true
        self.jobs = jobs
        self.light = some(Light.new(context.min_section * 16, context.sections * 16, context.sky_light))
        self.min_section = context.min_section
        self.sections = context.sections
        self.context = some(context)
        self.columns.flat = some(flat)
    }

    /// Whether chunks are read from the world's folder.
    pub fn reads(self) -> bool {
        return self.opened
    }

    /// What's been logged since this was last asked, oldest first.
    pub fn take_lines(mut self) -> List<Entry> {
        let out = self.lines.copy()
        self.lines.clear()
        return out
    }

    /// How many chunks are loaded or being read for holders, and how many far chunks for
    /// players.
    pub fn chunk_count(self) -> (usize, usize) {
        return (self.columns.slots.len(), self.far.len())
    }

    /// Adds `player` in `chunk`, as `ChunkMap.updatePlayerStatus` does. What their tickets
    /// come to loads at the next `pump`.
    pub fn add_player(mut self, chunk: ChunkPos, player: i32) {
        self.dm.add_player(chunk.pack(), player)
    }

    /// Takes `player` out of `chunk`, as a player who leaves is, until the next `pump`.
    pub fn remove_player(mut self, chunk: ChunkPos, player: i32) {
        self.dm.remove_player(chunk.pack(), player)
    }

    /// Moves `player` from `from` to `to`, as `ChunkMap.move` does when they go into another
    /// section, until the next `pump`.
    pub fn move_player(mut self, from: ChunkPos, to: ChunkPos, player: i32) {
        self.dm.remove_player(from.pack(), player)
        self.dm.add_player(to.pack(), player)
    }

    /// Lets go of the far chunks read for `player`, who left.
    pub fn forget_player(mut self, player: i32) {
        var gone = List<i64>()
        for (k, f) in self.far {
            if f.owner == player {
                gone.push(k)
            }
        }
        for k in gone {
            self.free_far(k)
        }
        _ = self.far_loads.remove(player)
    }

    /// The chunk at `pos` left `player`'s view: a far chunk read for them goes.
    pub fn forget_far(mut self, pos: ChunkPos, player: i32) {
        let k = pos.pack()
        if self.far.contains(k) and self.far[k].owner == player {
            self.free_far(k)
        }
    }

    /// Adds a joining player's spawn ticket, `player_spawn` 3 around `chunk`, and settles what
    /// it comes to, as `addTicketAndLoadWithRadius` does.
    pub fn load_spawn(mut self, chunk: ChunkPos) {
        _ = self.dm.add_ticket(chunk.pack(), Ticket.with_radius(TicketType.PlayerSpawn, SPAWN_RADIUS))
        self.pump()
    }

    /// Adds the spawn ticket again, so it doesn't run out while the player is still to join, as
    /// `PrepareSpawnTask.Ready.keepAlive` does each configuration tick.
    pub fn keep_spawn(mut self, chunk: ChunkPos) {
        _ = self.dm.add_ticket(chunk.pack(), Ticket.with_radius(TicketType.PlayerSpawn, SPAWN_RADIUS))
    }

    /// Whether every chunk within `radius` of `center` is full, as `getChunkRangeFuture` waits
    /// for them to be.
    pub fn full_around(self, center: ChunkPos, radius: i32) -> bool {
        for x in center.x - radius..center.x + radius + 1 {
            for z in center.z - radius..center.z + radius + 1 {
                let k = ChunkPos { x: x, z: z }.pack()
                if self.dm.chunk_level(k, false) > FULL or not self.loaded(k) {
                    return false
                }
            }
        }
        return true
    }

    /// Whether the chunk at `pos` is ready to send: it ticks, as `getChunkToSend` has it.
    pub fn sendable(self, pos: ChunkPos) -> bool {
        if self.dm.chunk_level(pos.pack(), false) > TICKING {
            return false
        }
        return self.loaded_around(pos, 1)
    }

    /// The world's part of a tick, as `ServerChunkCache.tick` runs it: the tickets run down, the
    /// distance manager settles, and the holders that dropped unload, with their chunks and their
    /// light, which a run takes away. Vanilla unloads as many as it has time for, and Calcite all
    /// of them.
    pub fn tick(mut self) {
        self.dm.purge_stale(self.reading)
        self.pump()
        _ = self.dm.drop_unloaded()
        while self.dm.unload_next() {
        }
        for k in self.dm.take_unloaded() {
            self.unloaded(k)
        }
        var light = self.light.take() else return
        if light.has_work() {
            if let f = self.columns.flat {
                _ = light.run(f.states, self.columns)
            }
        }
        self.light = some(light)
    }

    /// Runs the distance manager until it settles: its updates, which load the chunks the
    /// holders' levels call for; the dispatcher's jobs and the main thread's tasks, until
    /// neither has any; then the chunks that can be are lit; then each holder waiting for its
    /// chunk to tick its entities, whose 5×5 is full, is let go; as long as any of those does
    /// something.
    pub fn pump(mut self) {
        loop {
            var any = self.dm.run_all_updates()
            for k in self.dm.take_changed() {
                self.changed(k)
            }
            if self.drain() {
                any = true
            }
            if self.light_up() {
                any = true
            }
            if self.ready_waiting() {
                any = true
            }
            if not any {
                return
            }
        }
    }

    /// Sets the player whose sender asks next, whose far chunks are read for them.
    pub fn serve(mut self, player: i32) {
        self.serving = player
    }

    /// The chunk at `pos` as it's sent, `ClientboundLevelChunkWithLightPacket`'s ID and fields:
    /// as it was saved, or flat, with its light as the engine has it. A flat chunk whose
    /// neighbours are flat is the flat world's body. A far chunk read for a player has its light
    /// as it was saved, and goes once it's sent. Block entities aren't sent yet.
    pub fn packet(mut self, pos: ChunkPos, flat: FlatWorld) -> List<u8> {
        let k = pos.pack()
        if self.columns.slots.contains(k) {
            if let light = self.light {
                match self.columns.slots[k] {
                    Body.Saved(s) => return chunk_packet(pos, s.chunk, light.light_data(pos.x, pos.z)),
                    Body.Flat => {
                        if not self.flat_around(pos) {
                            if let f = self.columns.flat {
                                return chunk_packet(pos, f.chunk, light.light_data(pos.x, pos.z))
                            }
                        }
                    },
                    Body.Loading => {},
                }
            }
            return flat.chunk_packet(pos.x, pos.z)
        }
        if self.far.contains(k) {
            var packet: List<u8>? = none
            match self.far[k].body {
                Body.Saved(s) => packet = some(chunk_packet(pos, s.chunk, s.saved_light())),
                _ => {},
            }
            self.free_far(k)
            if let p = packet {
                return p
            }
        }
        return flat.chunk_packet(pos.x, pos.z)
    }

    /// The light of the chunk at `pos` as the engine has it, once it's lit: what it's sent with,
    /// unless it's a flat chunk among flat ones.
    pub fn light_of(self, pos: ChunkPos) -> LightData? {
        if not self.lit.contains(pos.pack()) {
            return none
        }
        if let light = self.light {
            return some(light.light_data(pos.x, pos.z))
        }
        return none
    }

    /// Hands what's to be read to the IO thread. Replaying, there's none: what the recording
    /// read comes from the log.
    pub fn dispatch(mut self) {
        if self.asks.is_empty() {
            return
        }
        let asks = self.asks.copy()
        self.asks.clear()
        var jobs = self.jobs.take() else return
        for a in asks {
            match a {
                Ask.Region(r) => jobs.ask_region(r),
                Ask.Chunk(p) => jobs.ask_chunk(p),
            }
        }
        self.jobs = some(jobs)
    }

    /// What the IO thread and workers have done since this was last asked, in the order it came.
    pub fn take_done(mut self) -> Deque<Done> {
        var jobs = self.jobs.take() else return Deque<Done>()
        let done = jobs.take_done()
        self.jobs = some(jobs)
        return done
    }

    /// What `read` comes to, made on this thread as a worker makes it, with what it logs added
    /// to `lines`, for a replay, which has what was read and not what it came to.
    pub fn make(self, pos: ChunkPos, read: ChunkRead, lines: mut List<Entry>) -> Loaded {
        if let context = self.context {
            if let f = self.columns.flat {
                return prepare(pos, read, context, f.states, mut lines)
            }
        }
        return Loaded.Generate
    }

    /// Takes in which chunks `region`'s file has, as the IO thread found them, with what it
    /// logged. `false` if it wasn't asked, which only a replay that's gone another way hands over.
    pub fn read_region(mut self, region: ChunkPos, io: List<Entry>, presence: own List<u64>) -> bool {
        let k = region.pack()
        if not self.regions.contains(k) {
            return false
        }
        match self.regions[k] {
            Region.Known(_) => return false,
            Region.Asked => {},
        }
        for e in io {
            self.lines.push(e.copy())
        }
        self.regions.insert(k, Region.Known(presence))
        return true
    }

    /// Takes in a read of the chunk at `pos`, with what the IO thread logged, which came to
    /// `loaded` with what that logged: a holder's chunk loads if the holder's still there, with
    /// its light given to the engine, and goes if not, and a far chunk loads if it's still
    /// wanted. Then the distance manager settles, and what can be lit is. `false` if no read of it was asked for, which only a replay that's gone another
    /// way hands over.
    pub fn read_chunk(mut self, pos: ChunkPos, io: List<Entry>, loaded: own Loaded, made: List<Entry>) -> bool {
        let k = pos.pack()
        let n = self.asked.get(k) ?? 0
        if n == 0 {
            return false
        }
        if n == 1 {
            _ = self.asked.remove(k)
        } else {
            self.asked.insert(k, n - 1)
        }
        for e in io {
            self.lines.push(e.copy())
        }
        for e in made {
            self.lines.push(e.copy())
        }
        if self.reading.chunks.contains(k) {
            self.reading.chunks.remove(k)
            if self.held(k) {
                self.accept(k, loaded)
                self.pump()
            } else {
                _ = self.columns.slots.remove(k)
            }
            return true
        }
        if self.far.contains(k) {
            let loading = match self.far[k].body {
                Body.Loading => true,
                _ => false,
            }
            if loading {
                let owner = self.far[k].owner
                self.far[k].body = body(loaded)
                self.far_loads.insert(owner, (self.far_loads.get(owner) ?? 1) - 1)
            }
        }
        return true
    }

    // The chunk at `k`'s holder's level changed: a full chunk with no chunk yet is loaded, or one
    // at 34 if chunks are read, to light those beside it with; one that's become full may be
    // lit; and one whose entities are to tick waits for the chunks around it.
    fn changed(mut self, k: i64) {
        let level = self.dm.chunk_level(k, false)
        let reach = if self.opened { LIGHT_BORDER } else { FULL }
        if level <= reach and not self.columns.slots.contains(k) {
            if self.opened {
                self.columns.slots.insert(k, Body.Loading)
                self.reading.chunks.insert(k)
                self.ask(k)
            } else {
                self.columns.slots.insert(k, Body.Flat)
            }
        }
        if level <= FULL and self.initialized.contains(k) and not self.lit.contains(k) {
            self.to_light.insert(k)
        }
        if let h = self.dm.holder(k) {
            if h.ticking == Ticking.Waiting {
                self.waiting.insert(k)
            }
        }
    }

    // The holder at `k` unloaded: its chunk goes, with its light, unless it's still being read,
    // when it goes as it comes back, with no holder to have it.
    fn unloaded(mut self, k: i64) {
        self.waiting.remove(k)
        if self.reading.chunks.contains(k) {
            return
        }
        if let _ = self.columns.slots.remove(k) {
            if self.opened {
                self.forget_light(k)
            }
        }
    }

    // Takes in the chunk at `k` its read came to, for its holder, to be initialized: a saved
    // one's light goes to the engine, as `SerializableChunkData.read` queues it, a section at a
    // time from the lowest, the chunk's kept from the first section with any.
    fn accept(mut self, k: i64, loaded: own Loaded) {
        match loaded {
            Loaded.Generate => self.columns.slots.insert(k, Body.Flat),
            Loaded.Saved(s) => {
                var saved = s
                var light = self.light.take() else {
                    self.columns.slots.insert(k, Body.Saved(saved))
                    return
                }
                let pos = unpacked(k)
                var kept = false
                for i in 0..saved.sky.len() {
                    if saved.block[i] == none and saved.sky[i] == none {
                        continue
                    }
                    if not kept {
                        light.retain_data(pos.x, pos.z, true)
                        kept = true
                    }
                    let y = self.min_section - 1 + i32.wrap(i)
                    if let b = saved.block[i].take() {
                        light.queue_section_data(false, pos.x, y, pos.z, some(Layer.of(b)))
                    }
                    if let l = saved.sky[i].take() {
                        light.queue_section_data(true, pos.x, y, pos.z, some(Layer.of(l)))
                    }
                }
                self.light = some(light)
                self.columns.slots.insert(k, Body.Saved(saved))
            },
        }
        self.arrived.insert(k)
    }

    // The chunk at `k` went: its light goes too, as `updateChunkStatus` lets it go, for the next
    // run to take away.
    fn forget_light(mut self, k: i64) {
        self.arrived.remove(k)
        self.initialized.remove(k)
        self.lit.remove(k)
        self.to_light.remove(k)
        var light = self.light.take() else return
        let pos = unpacked(k)
        light.retain_data(pos.x, pos.z, false)
        light.set_light_enabled(self.columns, pos.x, pos.z, false)
        for y in self.min_section - 1..self.min_section + self.sections + 1 {
            light.queue_section_data(false, pos.x, y, pos.z, none)
            light.queue_section_data(true, pos.x, y, pos.z, none)
        }
        for y in self.min_section..self.min_section + self.sections {
            light.update_section_status(pos.x, y, pos.z, true)
        }
        self.light = some(light)
    }

    // Lights what can be, as vanilla's light thread runs what it has. Each chunk whose body came
    // is initialized, as `initializeLight` does it: its sections with blocks told, a run, then its
    // light turned on, lit or not as it was saved, and kept no more. Then each initialized one
    // whose holder is full and whose 3×3 is initialized is lit, as `lightChunk` does it: its light
    // spread from its blocks and sky, unless it was saved lit, and a run. Whether any was lit.
    fn light_up(mut self) -> bool {
        if self.arrived.is_empty() and self.to_light.is_empty() {
            return false
        }
        var light = self.light.take() else return false
        if not self.arrived.is_empty() {
            var keys = List<i64>()
            for k in self.arrived {
                keys.push(k)
            }
            self.arrived.clear()
            for k in keys {
                self.tell_sections(mut light, k)
            }
            if let f = self.columns.flat {
                _ = light.run(f.states, self.columns)
            }
            for k in keys {
                let pos = unpacked(k)
                light.set_light_enabled(self.columns, pos.x, pos.z, self.lighted(k))
                light.retain_data(pos.x, pos.z, false)
                self.initialized.insert(k)
                for x in pos.x - 1..pos.x + 2 {
                    for z in pos.z - 1..pos.z + 2 {
                        let n = ChunkPos { x: x, z: z }.pack()
                        if self.initialized.contains(n) and not self.lit.contains(n) {
                            self.to_light.insert(n)
                        }
                    }
                }
            }
        }
        var ready = List<i64>()
        for k in self.to_light {
            if self.dm.chunk_level(k, false) <= FULL and self.initialized_around(unpacked(k)) {
                ready.push(k)
            }
        }
        self.to_light.clear()
        if not ready.is_empty() {
            if let f = self.columns.flat {
                for k in ready {
                    if not self.lighted(k) {
                        let pos = unpacked(k)
                        light.propagate_light_sources(f.states, self.columns, pos.x, pos.z)
                    }
                }
                _ = light.run(f.states, self.columns)
            }
            for k in ready {
                self.lit.insert(k)
            }
        }
        self.light = some(light)
        return not ready.is_empty()
    }

    // Tells `light` of the chunk at `k`'s sections with blocks, as `initializeLight` does first.
    fn tell_sections(self, light: mut Light, k: i64) {
        let pos = unpacked(k)
        match self.columns.slots[k] {
            Body.Saved(s) => tell(mut light, s.chunk, pos, self.min_section),
            Body.Flat => {
                if let f = self.columns.flat {
                    tell(mut light, f.chunk, pos, self.min_section)
                }
            },
            Body.Loading => {},
        }
    }

    // Whether the chunk at `k` was saved lit, so its light isn't spread again.
    fn lighted(self, k: i64) -> bool {
        return match self.columns.slots[k] {
            Body.Saved(s) => s.lighted,
            _ => false,
        }
    }

    // Whether every chunk in the 3×3 around `pos` is initialized.
    fn initialized_around(self, pos: ChunkPos) -> bool {
        for x in pos.x - 1..pos.x + 2 {
            for z in pos.z - 1..pos.z + 2 {
                if not self.initialized.contains(ChunkPos { x: x, z: z }.pack()) {
                    return false
                }
            }
        }
        return true
    }

    // Whether every chunk in the 3×3 around `pos` is flat, so its light is the flat world's.
    fn flat_around(self, pos: ChunkPos) -> bool {
        for x in pos.x - 1..pos.x + 2 {
            for z in pos.z - 1..pos.z + 2 {
                let k = ChunkPos { x: x, z: z }.pack()
                if not self.columns.slots.contains(k) {
                    return false
                }
                match self.columns.slots[k] {
                    Body.Flat => {},
                    _ => return false,
                }
            }
        }
        return true
    }

    // Runs the dispatcher's jobs, then the main thread's tasks, until neither has any, and
    // whether any ran.
    fn drain(mut self) -> bool {
        var ran = false
        loop {
            var any = false
            while self.dm.run_dispatcher() {
                any = true
            }
            while self.dm.run_main() {
                any = true
            }
            if not any {
                return ran
            }
            ran = true
        }
    }

    // Lets each holder waiting whose 5×5 is full have its chunk tick its entities, in the order
    // they came to wait, and whether that let any of what waited for it go.
    fn ready_waiting(mut self) -> bool {
        if self.waiting.is_empty() {
            return false
        }
        var keys = List<i64>()
        for k in self.waiting {
            keys.push(k)
        }
        var any = false
        for k in keys {
            let still = match self.dm.holder(k) {
                some(h) => h.ticking == Ticking.Waiting,
                none => false,
            }
            if not still {
                self.waiting.remove(k)
            } else if self.loaded_around(unpacked(k), 2) {
                self.waiting.remove(k)
                if self.dm.entity_ticking_ready(k) {
                    any = true
                }
            }
        }
        return any
    }

    // Whether the chunk at `k` is full: lit, if chunks are read, or there, if they're all flat.
    fn loaded(self, k: i64) -> bool {
        if self.opened {
            return self.lit.contains(k)
        }
        return self.columns.slots.contains(k)
    }

    // Whether every chunk within `radius` of `pos` is full.
    fn loaded_around(self, pos: ChunkPos, radius: i32) -> bool {
        for x in pos.x - radius..pos.x + radius + 1 {
            for z in pos.z - radius..pos.z + radius + 1 {
                if not self.loaded(ChunkPos { x: x, z: z }.pack()) {
                    return false
                }
            }
        }
        return true
    }

    // Whether the chunk at `k` has a holder, in use or waiting to unload.
    fn held(self, k: i64) -> bool {
        if let _ = self.dm.holder(k) {
            return true
        }
        if let _ = self.dm.unloading(k) {
            return true
        }
        return false
    }

    // Asks for a read of the chunk at `k`.
    fn ask(mut self, k: i64) {
        self.asked.insert(k, (self.asked.get(k) ?? 0) + 1)
        self.asks.push(Ask.Chunk(unpacked(k)))
    }

    // Lets the far chunk at `k` go, and its read if it's still being read.
    fn free_far(mut self, k: i64) {
        let f = self.far.remove(k) else return
        match f.body {
            Body.Loading => self.far_loads.insert(f.owner, (self.far_loads.get(f.owner) ?? 1) - 1),
            _ => {},
        }
    }
}

impl Chunks for Level {
    // A chunk the tickets reach goes once it ticks. One further goes at once if a holder has it,
    // initialized if chunks are read, if nothing's read, or if its region's file hasn't it, so
    // it's flat; otherwise it's read for the player, if they've fewer than 64 being read, and goes
    // once it's read. The sender stops at one whose region's file is still to say, or past the
    // most reads.
    fn next(mut self, pos: ChunkPos, near: bool) -> Next {
        if near {
            return if self.sendable(pos) { Next.Send } else { Next.Skip }
        }
        let k = pos.pack()
        if self.columns.slots.contains(k) {
            let there = if self.opened { self.initialized.contains(k) } else { true }
            return if there { Next.Send } else { Next.Skip }
        }
        if not self.opened {
            return Next.Send
        }
        if self.far.contains(k) {
            return match self.far[k].body {
                Body.Loading => Next.Skip,
                _ => Next.Send,
            }
        }
        let region = region_of(pos)
        let r = region.pack()
        if not self.regions.contains(r) {
            self.regions.insert(r, Region.Asked)
            self.asks.push(Ask.Region(region))
            return Next.Stop
        }
        match self.regions[r] {
            Region.Asked => return Next.Stop,
            Region.Known(bits) => {
                let i = (pos.x & 31) + (pos.z & 31) * 32
                if (bits[usize.wrap(i >> 6)] & (1u64 << u64.wrap(i & 63))) == 0 {
                    return Next.Send
                }
            },
        }
        let loads = self.far_loads.get(self.serving) ?? 0
        if loads >= MOST_FAR_LOADS {
            return Next.Stop
        }
        self.far_loads.insert(self.serving, loads + 1)
        self.far.insert(k, Far { owner: self.serving, body: Body.Loading })
        self.ask(k)
        return Next.Skip
    }
}

// What a chunk read comes to, held: as it was saved, or flat.
fn body(loaded: own Loaded) -> Body {
    return match loaded {
        Loaded.Generate => Body.Flat,
        Loaded.Saved(s) => Body.Saved(s),
    }
}

// A chunk's packet's ID and fields.
fn chunk_packet(pos: ChunkPos, chunk: Chunk, light: own LightData) -> List<u8> {
    var w = Writer.new()
    write_packet(ClientboundLevelChunkWithLight { x: pos.x, z: pos.z, chunk: chunk.chunk_data(), light: light }, State.Play, mut w)
    return w.into_bytes()
}

// Tells `light` of the sections of `chunk`, at `pos`, that have blocks.
fn tell(light: mut Light, chunk: Chunk, pos: ChunkPos, min_section: i32) {
    for i in 0..chunk.section_count() {
        if not chunk.section_only_air(i) {
            light.update_section_status(pos.x, min_section + i32.wrap(i), pos.z, false)
        }
    }
}

// The chunk a packed position is.
fn unpacked(k: i64) -> ChunkPos {
    return ChunkPos { x: i32.wrap(k), z: i32.wrap(k >> 32) }
}
