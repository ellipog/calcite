/// How far around the spawn chunk a joining player's spawn ticket loads full chunks,
/// `PrepareSpawnTask.PREPARE_CHUNK_RADIUS`.
pub const SPAWN_RADIUS: i32 = 3
/// The most far chunks being read for a player at once.
pub const MOST_FAR_LOADS: i32 = 64
/// The most chunks the player tickets load at once, where vanilla's dispatcher lets 4 through, each
/// until its chunk ticks its entities (D234). With 4, a new world's view-32 join kept the
/// generator's 31 workers about 45% busy, with no job ready to give them most of the time, and
/// took 4.9 s; with 256, it takes 3.3 s, and the client takes chunks as fast as it will, 64 a
/// tick. With more, the chunks far out are asked for so early that the near ones wait for them.
pub const PLAYER_LOADS: usize = 256
// The level of a full chunk, at and below which a holder's chunk is loaded.
const FULL: i32 = 33
// How long, in game ticks, a chunk that's full is held back for a nearer one still to come to be,
// at most (CAL-188).
const FULL_HOLD: i64 = 20
// The level at and below which a chunk ticks, so it can be sent.
const TICKING: i32 = 32
// The highest level at which a holder's chunk ticks its entities, `ENTITY_TICKING`'s.
const ENTITY_TICKING: i32 = 31
// The level at and below which a holder of a world that reads loads its chunk, for light, that
// of `initialize_light`.
const LIGHT_BORDER: i32 = 34
// The most block or fluid ticks a level runs in a tick, as `ServerLevel.tick` has its
// `LevelTicks` run.
const MOST_TICKS: usize = 65536
// The most chunks changed in play saved in a tick, `CHUNK_SAVED_EAGERLY_PER_TICK`, and how long
// after one's saved it may be again, in milliseconds, `EAGER_CHUNK_SAVE_COOLDOWN_IN_MILLIS`
// (CAL-145).
const EAGER_SAVES: usize = 20
const EAGER_COOLDOWN_MS: i64 = 10000
// `LevelEvent.END_GATEWAY_SPAWN`, which a dragon fight's new gateway makes heard (D627).
const GATEWAY_SPAWNED: i32 = 3000

// A chunk the world has, or is reading.
enum Body {
    // Being read.
    Loading
    // Generated flat: every flat chunk is the flat world's.
    Flat
    // As it was saved. A holder's gives its light and its sky's sources to light as it comes; a
    // far chunk keeps its own.
    Saved(SavedChunk)
}

// Each holder's chunk, by its packed position, once it's there, and the flat chunk each flat one
// is. A chunk held whole has its rest kept with the others' in `rests`, not in its body, from
// when it's put in until it's taken out (D289). A chunk whose blocks have been set since it came
// is its own copy in `live`, made from the one it came as, shared or flat, as a block was first
// set, which what reads it reads first; it's taken out as it is now (D321). A chunk whose block
// entities a block set has changed since it came has its map of them in `block_entities`, in
// place of those its rest saved, which they go back into as it's taken out (CAL-115). A flat
// chunk with blocks set in it is taken out whole, with a rest of its own, of `sections`, to be
// saved (CAL-145).
struct Columns {
    slots: OpenHashMap<i64, Body> = OpenHashMap<i64, Body>()
    sections: usize = 0
    flat: FlatChunk? = none
    rests: RestStore = RestStore()
    live: OpenHashMap<i64, Chunk> = OpenHashMap<i64, Chunk>()
    // A chunk nothing reads, one for the level, which a saved body whose own copy is in `live`
    // holds in place of the shared one it came as (D330).
    stand_in: Shared<Chunk>? = none
    block_entities: Map<i64, OpenHashMap<BlockPos, Tag>> = Map<i64, OpenHashMap<BlockPos, Tag>>()
}

impl Columns {
    // The chunk at `k` has its own copy in `live`, which what reads the chunk reads first and
    // which is taken out in its place: the shared one it came as is let go for `stand_in`, so
    // the level doesn't hold both (D330). Light's own share goes as it's told of the block set.
    fn let_go_shared(mut self, k: i64) {
        let stand_in = self.stand_in.copy() else return
        let gone = self.slots.remove(k) else return
        match gone {
            Body.Saved(s) => {
                var saved = s
                saved.chunk = stand_in
                self.slots.insert(k, Body.Saved(saved))
            },
            Body.Loading => self.slots.insert(k, Body.Loading),
            Body.Flat => self.slots.insert(k, Body.Flat),
        }
    }

    // Puts in the body of the column at `k`, its rest in with the others.
    fn put(mut self, k: i64, given: own Body) {
        _ = self.live.remove(k)
        _ = self.block_entities.remove(k)
        match given {
            Body.Saved(s) => {
                var saved = s
                if let r = saved.rest.take() {
                    self.rests.put(k, r)
                } else {
                    _ = self.rests.take(k)
                }
                self.slots.insert(k, Body.Saved(saved))
            },
            Body.Loading => {
                _ = self.rests.take(k)
                self.slots.insert(k, Body.Loading)
            },
            Body.Flat => {
                _ = self.rests.take(k)
                self.slots.insert(k, Body.Flat)
            },
        }
    }

    // Takes out the body of the column at `k`, if it has one, with its rest back in it, with the
    // block entities it has now where a block set changed them.
    fn take(mut self, k: i64) -> Body? {
        let gone = self.slots.remove(k) else return none
        let rest = self.rests.take(k)
        let changed = self.live.remove(k)
        let entities = self.block_entities.remove(k)
        match gone {
            Body.Saved(s) => {
                var saved = s
                if let r = rest {
                    if let m = entities {
                        saved.rest = some(r.with_block_entities(saved_block_entities(m)))
                    } else {
                        saved.rest = some(r)
                    }
                }
                if let c = changed {
                    saved.chunk = c.into_shared()
                }
                return some(Body.Saved(saved))
            },
            Body.Loading => return some(Body.Loading),
            Body.Flat => {
                // A flat chunk with blocks set in it is all there is of it, saved as it is now,
                // with the block entities it has, as vanilla saves every chunk it made (CAL-145).
                let c = changed else return some(Body.Flat)
                var r = rest ?? PackedRest.of(ChunkRest.empty(self.sections))
                if let m = entities {
                    r = r.with_block_entities(saved_block_entities(m))
                }
                return some(Body.Saved(SavedChunk { chunk: c.into_shared(), sources: none, sky: [], block: [], lighted: false, whole: true, rest: some(r) }))
            },
        }
    }

    // The chunk at `k`'s map of its block entities: its own where a block set changed them, else
    // made from those its rest saved.
    fn block_entities_of(self, k: i64) -> OpenHashMap<BlockPos, Tag> {
        if self.block_entities.contains(k) {
            return self.block_entities[k].copy()
        }
        return block_entity_map(self.rests.block_entities(k))
    }

    // Makes the chunk at `k`'s map of its block entities its own, from those its rest saved, if it
    // isn't yet, for a block set to change.
    fn own_block_entities(mut self, k: i64) {
        if not self.block_entities.contains(k) {
            self.block_entities.insert(k, block_entity_map(self.rests.block_entities(k)))
        }
    }
}

/// A chunk's packet, as the level gives it to send.
pub enum ChunkPacket {
    /// Its ID and fields.
    Plain(List<u8>)
    /// Its ID and fields, kept for another player. Once compressed, its frame's body is to come
    /// back with `key` and `version`, to `Level.compressed`.
    Shared { packet: List<u8>, key: i64, version: u64 }
    /// Its frame's body, compressed with `threshold` for a player before, and its ID and fields if
    /// they're kept, for a link that checks what's sent.
    Compressed { body: List<u8>, threshold: i32, packet: List<u8>? }
}

// A chunk's packet kept for players still to be sent it: its ID and fields until it's
// compressed, and its frame's body once it is, with the threshold it's compressed with. Its
// version tells it from a packet kept for the chunk before, whose body may come back late.
struct Kept {
    packet: List<u8>?
    body: List<u8>?
    threshold: i32
    version: u64
}

impl Kept {
    // What's sent of it to a player, while it's kept for another.
    fn copied(self, k: i64) -> ChunkPacket {
        if let b = self.body {
            return ChunkPacket.Compressed { body: b.copy(), threshold: self.threshold, packet: self.packet.copy() }
        }
        if let p = self.packet {
            return ChunkPacket.Shared { packet: p.copy(), key: k, version: self.version }
        }
        return ChunkPacket.Plain(List<u8>())
    }

    // What's sent of it to the last player, who takes it.
    fn taken(own self) -> ChunkPacket {
        var kept = self
        if let b = kept.body.take() {
            return ChunkPacket.Compressed { body: b, threshold: kept.threshold, packet: kept.packet.take() }
        }
        if let p = kept.packet.take() {
            return ChunkPacket.Plain(p)
        }
        return ChunkPacket.Plain(List<u8>())
    }
}

// A chunk read for a player whose view is wider than the tickets reach, `owner`.
struct Far {
    owner: i32
    body: Body
}

// What's known of a region's file.
enum Region {
    // It's been asked which chunks it has.
    Asked
    // The chunks it has, a bit each by `x + z * 32` in 16 words.
    Known(List<u64>)
}

// What's to be asked of the IO thread, or told the generator: a chunk being read that nothing
// wants any more (D243).
enum Ask {
    Region(ChunkPos)
    Chunk(ChunkPos)
    Drop(ChunkPos)
}

// The chunks being read for their holders, and those full but not yet lit, which aren't ready
// to save until they're read and lit, as `isReadyForSaving` says while a generation task still
// holds the holder, so their tickets that don't run out unloaded don't run down. Without the
// second, a spawn search's ticket ran out while its chunk waited for light, and the chunk was
// let go before it was full, so the search never went on (CAL-89).
struct Reading {
    chunks: OpenHashSet<i64> = OpenHashSet<i64>()
    unlit: OpenHashSet<i64> = OpenHashSet<i64>()
}

impl Holders for Reading {
    fn ready_for_saving(self, chunk: i64) -> bool {
        return not self.chunks.contains(chunk) and not self.unlit.contains(chunk)
    }
}

// One update waiting in the level's updater, as `CollectingNeighborUpdater` keeps them (D326).
enum Update {
    // `ShapeUpdate`: the block at x, y, z told its neighbour toward `d` is `neighbour` now.
    Shape { d: i32, neighbour: u32, x: i32, y: i32, z: i32, flags: i32, limit: i32 }
    // `SimpleNeighborUpdate`: the block at x, y, z told the block `source` beside it changed.
    Simple { x: i32, y: i32, z: i32, source: u32 }
    // `FullNeighborUpdate`: the same, with the state it's told as, and whether a piston moved
    // what changed.
    Full { state: u32, x: i32, y: i32, z: i32, source: u32, moved: bool }
    // `MultiNeighborUpdate`: the six around x, y, z told `source` changed, in `UPDATE_ORDER`,
    // but the one toward `skip`, -1 for none; `next` is the next to be told.
    Multi { x: i32, y: i32, z: i32, source: u32, skip: i32, next: i32 }
}

/// An event at a block, `levelEvent`, for the players within 64 blocks of it (D326), but the
/// player whose entity's `except`, -1 for none, whose own client shows it (D376).
pub struct LevelEvent {
    pub kind: i32
    pub x: i32
    pub y: i32
    pub z: i32
    pub data: i32
    pub except: i32 = -1
    /// Whether every player is sent it, wherever they are, `globalLevelEvent` (D596).
    pub global: bool = false
}

/// What a level's players are sent of what happens in it, in the order it happened, as vanilla
/// sends each at once: a level event (D326); a sound, `playSound`; a block event that ran,
/// `ClientboundBlockEventPacket` (CAL-125); particles, `sendParticles` (CAL-143); and a beacon's
/// effects, given those in its range, `applyEffects` (D520).
pub enum Heard {
    Event(LevelEvent)
    Sound(LevelSound)
    Block(BlockEvent)
    Particles(LevelParticles)
    Pulse(BeaconPulse)
}

/// Particles sent, `ServerLevel.sendParticles` (CAL-143), to the players whose block's middle is
/// within 32 blocks of them: the particle type's name, as `note`; the block state of one whose
/// option is one, as `block`'s, or -1 for a type with no options (CAL-155); where; how many, none
/// for one whose spread is its motion; how far they spread each way, and their most speed, each as
/// a float, as the packet has them.
pub struct LevelParticles {
    pub particle: String
    pub state: i32 = -1
    pub x: f64
    pub y: f64
    pub z: f64
    pub count: i32
    pub dx: f32
    pub dy: f32
    pub dz: f32
    pub speed: f32
    /// Its speed each way where that's not `speed` all ways, and `RandomizationType`'s ID (D698).
    pub speeds: (f32, f32, f32)? = none
    pub randomization: i32 = 0
    /// Its options as the packet writes them where they're neither none nor a block state's, as
    /// `SpellParticleOption`'s colour and power (CAL-179).
    pub option: List<u8>? = none
}

/// A sound played, `Level.playSound`, for the players near enough to hear it (CAL-125): the
/// sound event's name, as `block.piston.extend`, where it's played, its volume and pitch, the
/// seed the client plays it with, and `SoundSource`'s ordinal it's played among, the blocks' 4
/// unless a note block's records' 2 (CAL-124).
pub struct LevelSound {
    pub sound: String
    pub x: f64
    pub y: f64
    pub z: f64
    pub volume: f32
    pub pitch: f32
    pub seed: i64
    pub source: i32 = 4
    /// The player it's not sent, by their entity, -1 for none (CAL-139).
    pub except: i32 = -1
    /// The entity it's played from, `playSeededSound(except, sourceEntity, ...)`, which is sent
    /// as `ClientboundSoundEntityPacket`, where it was then; -1 for one at a place (CAL-179).
    pub entity: i32 = -1
}

/// A block event, `BlockEventData`: the block at `x`, `y`, `z` it's for, and its two numbers, for
/// the players within 64 blocks once it's run (CAL-125). And whether its place has moved since
/// it was kept, `moved`, a walk's cursor's, so the queue's hash of it is where it was and no
/// other's the same as it till it's kept again (D593).
pub struct BlockEvent {
    pub x: i32
    pub y: i32
    pub z: i32
    pub block: u32
    pub b0: i32
    pub b1: i32
    pub moved: bool = false
}

// A block entity's ticker, `RebindableTickingBlockEntityWrapper`: its place; its number, which
// `ticker_ids` keeps for the place while it's there, and once it isn't, it's dropped as the
// tickers come to it (CAL-125); its block entity's type, by its place among the types, which the
// block there must be of for it to tick, `isValid`; and whether it's yet to tick (CAL-130).
struct Ticker {
    pos: BlockPos
    id: u64
    kind: i32
    first: bool
}

// A redstone torch's toggle, `RedstoneTorchBlock.Toggle`: where, and the game time it toggled at.
struct Toggle {
    x: i32
    y: i32
    z: i32
    when: i64
}

/// The overworld's chunks, and the distance manager that says which load.
/// What a level dropped, for the network to make in order: an item, `Block.popResource`'s, where
/// it's popped and its stack (CAL-153); an experience orb, `ExperienceOrb.award`'s, where it's
/// made, its value and the id drawn for it to merge by (CAL-154); or primed TNT, `TntBlock`'s,
/// what it's made with (CAL-182); or a silverfish an infested block let out, `spawnInfestation`'s,
/// where (CAL-172).
pub enum Dropped {
    Item(f64, f64, f64, Tag)
    /// An item a removed container spilled, `Containers.dropItemStack`'s: where, its stack and
    /// how it's thrown, with no pickup delay (CAL-197).
    Spilled(f64, f64, f64, Tag, f64, f64, f64)
    Orb(f64, f64, f64, i32, i32)
    Tnt(Primed)
    Silverfish(f64, f64, f64)
    /// A baby turtle a turtle egg hatched, where and the egg's block, its home (CAL-201).
    Turtle(f64, f64, f64, (i32, i32, i32))
    /// A bee its hive let out (CAL-177).
    Bee(Released)
    /// A golem built of blocks, its kind, as `world.golem_building` has them, and where
    /// (CAL-201).
    Golem(i32, f64, f64, f64)
    /// A crafter's `CRAFTER_RECIPE_CRAFTED`: where it is, the recipe's place and its grid
    /// (CAL-338).
    CrafterCrafted(i32, i32, i32, usize, List<Tag?>)
    /// A projectile a dispenser shot, `ProjectileDispenseBehavior.execute` (CAL-378).
    Shot(Shot)
}

/// What a dispenser shoots (CAL-378): the item's projectile, made of one of `stack` at x, y, z,
/// `asProjectile`, then shot along the dispenser's facing, `dx`, `dy`, `dz`, at `power` with
/// `uncertainty`, `Projectile.shoot`, as `spawnProjectileUsingShoot` shoots it.
pub struct Shot {
    pub stack: Tag
    pub x: f64
    pub y: f64
    pub z: f64
    pub dx: i32
    pub dy: i32
    pub dz: i32
    pub power: f32
    pub uncertainty: f32
}

/// Primed TNT a level made (CAL-182): where, the level's draw that turns it, its owner by UUID,
/// and its fuse, none for the 80 it's made with.
pub struct Primed {
    pub x: f64
    pub y: f64
    pub z: f64
    pub turn: f64
    pub owner: (i64, i64)?
    pub fuse: i32?
}

pub struct Level {
    /// The tickets and players, and the chunks' holders.
    pub dm: DistanceManager
    /// Whether it's not to save, `noSave`, as `save-off` sets it (CAL-165): its chunks don't
    /// unload, nor save but when they're made to.
    pub no_save: bool = false
    // Each holder's chunk, and those of them still being read.
    columns: Columns = Columns()
    reading: Reading = Reading()
    // The far chunks read for players, and how many each player has being read.
    far: OpenHashMap<i64, Far> = OpenHashMap<i64, Far>()
    far_loads: OpenHashMap<i32, i32> = OpenHashMap<i32, i32>()
    regions: OpenHashMap<i64, Region> = OpenHashMap<i64, Region>()
    // How many reads of each chunk are asked for and not back.
    asked: OpenHashMap<i64, i32> = OpenHashMap<i64, i32>()
    // The chunks being read whose holders unloaded, which the generator's been told nothing wants
    // (D243), until they're back.
    dropping: OpenHashSet<i64> = OpenHashSet<i64>()
    // What's to go to the IO thread at the next `dispatch`.
    asks: List<Ask> = List<Ask>()
    // Whether chunks are read, and the threads that read them, which a replay hasn't, and what
    // chunks are made with.
    opened: bool = false
    jobs: ChunkJobs? = none
    context: ChunkContext? = none
    // What chunks that aren't saved are generated with, unless they're flat, and, replaying, the
    // generator that makes them on this thread.
    gen: GenSetup? = none
    generator: Generator? = none
    // The dimension's sections, from its lowest.
    min_section: i32 = 0
    sections: i32 = 0
    /// The dimension's points of interest (CAL-160), as its `PoiManager` keeps them, none while
    /// they're lent to its entities for their tick, `lend_pois`, or before it's opened.
    pois: Pois? = none
    pois_lent: bool = false
    // Where they're read from: its `poi` folder's thread, or, replaying, the recording's log, if
    // the recording read them; the format they're read and written in; the chunks whose points
    // are asked for and not back, and those to ask for at the next `dispatch`; the chunks read
    // while theirs were away, held until they're back, as `scheduleChunkLoad` waits for both its
    // reads; and the chunks that came before the block facts, whose points are looked for once
    // they're here.
    poi_jobs: EntityJobs? = none
    poi_reads: bool = false
    poi_format: PoiFormat? = none
    poi_asked: Set<i64> = Set<i64>()
    poi_asks: List<ChunkPos> = List<ChunkPos>()
    poi_held: Map<i64, List<HeldRead>> = Map<i64, List<HeldRead>>()
    poi_waiting: List<(i64, Shared<Chunk>, bool)> = List<(i64, Shared<Chunk>, bool)>()
    // Light, once chunks are read (D264): the queue to its thread and the steps back, or, in a
    // replay or a test, light itself, run here. The asks not yet handed over, or, run here, not
    // yet taken; whether light here steps as the level settles, as a test's does, rather than as
    // the recording's did; how many asks there have been, and how many light's taken by the last
    // step taken in. `lighting` is whether there's light.
    lighting: bool = false
    light_to: Sender<Deque<LightAsk>>? = none
    light_back: Receiver<LightDone>? = none
    light_here: LightService? = none
    light_asks: Deque<LightAsk> = Deque<LightAsk>()
    light_eager: bool = false
    light_sent: u64 = 0
    light_covered: u64 = 0
    // Whether what light's told waits for the main thread's next wake, `park_light` (CAL-183).
    light_parked: bool = false
    // For each chunk light's been told came and not that it went, which ask told it: a step that
    // hadn't taken that ask is about the chunk before, which went.
    came_at: OpenHashMap<i64, u64> = OpenHashMap<i64, u64>()
    // The chunks light's initialized, and those it's lit, which are full.
    initialized: OpenHashSet<i64> = OpenHashSet<i64>()
    lit: OpenHashSet<i64> = OpenHashSet<i64>()
    // The fresh chunks whose mobs are still to spawn, `ChunkStatus.SPAWN` to come, each with
    // whether its noise settings use the legacy random source; those of them lit at a level that
    // wants them full, in the order they came to be, to spawn once their light's here; and those
    // whose light was watched for it (CAL-161). One isn't loaded until it's spawned. While one
    // spawns, the 3×3 around it, `region`, is read as `WorldGenRegion` reads it, full or not.
    spawn_due: OpenHashMap<i64, bool> = OpenHashMap<i64, bool>()
    spawn_next: LinkedSet<i64> = LinkedSet<i64>()
    spawn_watch: OpenHashSet<i64> = OpenHashSet<i64>()
    region: i64? = none
    // The chunks that may have come to be full, or stopped being, since `take_full_changes` was
    // last asked, and those it last said are full (CAL-148).
    full_maybe: List<i64> = List<i64>()
    full_told: OpenHashSet<i64> = OpenHashSet<i64>()
    // The chunks at a full level that aren't full yet, and those full but held back for one of
    // them nearer, with the game time each was first held (CAL-188).
    full_pending: OpenHashSet<i64> = OpenHashSet<i64>()
    full_held: OpenHashMap<i64, i64> = OpenHashMap<i64, i64>()
    // The chunks told full whose holders dropped below full since, though they may be back
    // (CAL-193).
    full_dropped: OpenHashSet<i64> = OpenHashSet<i64>()
    // The chunks with a joining player's spawn ticket, `want_spawn_light`'s: the chunks lit within
    // its reach are wanted with their light as they're lit (CAL-121).
    spawns: List<i64> = List<i64>()
    // The holders light's been told are full.
    told_full: OpenHashSet<i64> = OpenHashSet<i64>()
    // The chunks whose light is wanted, for their packets, each with the ask that wanted it, from
    // which light gives it; and the light given, as it was last.
    watching: OpenHashMap<i64, u64> = OpenHashMap<i64, u64>()
    light_data: OpenHashMap<i64, LightData> = OpenHashMap<i64, LightData>()
    // The chunks that went to be saved once light gives the light they had, in the order they
    // went, how many each has waiting, and the reads of them that wait for those saves.
    saving: Deque<(i64, Whole)> = Deque<(i64, Whole)>()
    saves_waiting: OpenHashMap<i64, u32> = OpenHashMap<i64, u32>()
    parked: List<i64> = List<i64>()
    // The holders whose chunks are to tick their entities once the 5×5 around them is loaded,
    // each with its place in the order they came to wait, and the next place to give; and those
    // that may have come to be ready, or to wait no more, since `ready_waiting` last looked: only
    // those can have, so only those are looked at again (D252).
    waiting: Map<i64, u64> = Map<i64, u64>()
    next_place: u64 = 0
    recheck: Set<i64> = Set<i64>()
    // The chunks held whole whose light isn't saved as the engine has it: lit since they were
    // saved, or changed by a run since they were lit. Each is saved as it unloads, and as the
    // server stops, as vanilla saves a chunk it's marked unsaved (D258).
    unsaved: OpenHashSet<i64> = OpenHashSet<i64>()
    // The chunks changed in play since they were saved, oldest first, which `save_eagerly`
    // saves, and when each may next be, by the server's clock in milliseconds, 10 seconds after
    // it last was, as `chunksToEagerlySave` and `nextChunkSaveTime` have them (CAL-145).
    eager: OpenHashSet<i64> = OpenHashSet<i64>()
    eager_order: Deque<i64> = Deque<i64>()
    next_save: OpenHashMap<i64, i64> = OpenHashMap<i64, i64>()
    // Whether the chunks unsaved without a change in play are to be saved soon too (CAL-261).
    eager_all: bool = false
    // Each held chunk's inhabited time, where it isn't 0: as it was saved, and a tick more each
    // tick mobs may spawn in it, `incrementInhabitedTime` (CAL-145).
    inhabited: OpenHashMap<i64, i64> = OpenHashMap<i64, i64>()
    lines: List<Entry> = List<Entry>()
    // The player whose sender asks next, for their far chunks.
    serving: i32 = 0
    // The packets kept for chunks another player is still to be sent, by packed position, and
    // the last version given one, whose top bits are the level's dimension (`set_dimension`).
    packets: OpenHashMap<i64, Kept> = OpenHashMap<i64, Kept>()
    versions: u64 = 0
    // The level's dimension, its whole ID, `dimension()`, which a location predicate asks
    // (CAL-164).
    key: String = String()
    // The world's hashed seed, which zooms the biomes in; the chunks whose light is kept for
    // natural spawning, as `keep_light` was last given them; and the light of a flat chunk among
    // flat ones (D317).
    zoom_seed: i64 = 0
    kept_light: OpenHashSet<i64> = OpenHashSet<i64>()
    flat_light: LightData? = none
    // What a block's set with, its heightmaps and its section's counts, once the level's opened;
    // the chunks with blocks set since the changes were last broadcast, in the order they first
    // had one; and the blocks set in each of their sections, by the section's packed position, as
    // each `ChunkHolder` keeps them in `changedBlocksPerSection` (D321).
    table: BlockStates? = none
    to_broadcast: LinkedSet<i64> = LinkedSet<i64>()
    // The sections of each chunk whose light changed since its last broadcast, sky and block, as
    // `ChunkHolder` keeps them, in the order the chunks first had one (D342).
    light_bits: OpenHashMap<i64, LightBits> = OpenHashMap<i64, LightBits>()
    light_order: LinkedSet<i64> = LinkedSet<i64>()
    changed_blocks: OpenHashMap<i64, OpenHashSet<i16>> = OpenHashMap<i64, OpenHashSet<i16>>()
    // Each full chunk's scheduled block and fluid ticks, from when it's full until it unloads, as
    // `registerTickContainerInLevel` adds them, with those it was saved with scheduled once it
    // ticks, as `startTickingChunk` schedules them (D322); the chunks that may have come to be
    // full or to tick since `check_ticks` last looked, each whose holder's level changed and those
    // around each that came to be loaded; and `subTickCount`, how many ticks have been
    // scheduled, which orders those due together.
    block_ticks: LevelTicks = LevelTicks()
    fluid_ticks: LevelTicks = LevelTicks()
    ticks_to_check: LinkedSet<i64> = LinkedSet<i64>()
    // The chunks whose ticking chunk is in, `getTickingChunk`, which tick, may be sent and spawn
    // mobs; those at a ticking level that aren't in yet, in the order they came to it, looked at
    // again at each main-thread pass, where those with the chunks around them full come in, as
    // `prepareTickingChunk`'s task runs on vanilla's main-thread executor; and whether the server's
    // in its tick, where that executor doesn't run, so a pass waits for the levels' settling after
    // it, or an event's (D447), as the distance manager's main-thread tasks do (D449).
    ticking: OpenHashSet<i64> = OpenHashSet<i64>()
    to_tick: LinkedSet<i64> = LinkedSet<i64>()
    in_tick: bool = false
    // The chunks whose entities are in the tick list, `Visibility.TICKING`: those whose holder's
    // chunk ticks its entities, from the main-thread pass after it came to, as
    // `scheduleFullChunkPromotion` tells the entity manager on vanilla's main-thread executor,
    // until its level drops past `ENTITY_TICKING`, at once, as `demoteFullChunk` tells it; and
    // those come to it that wait for that pass (D452).
    entity_listed: OpenHashSet<i64> = OpenHashSet<i64>()
    to_entity_list: LinkedSet<i64> = LinkedSet<i64>()
    // The chunks listed since the network last took them, whose entities go to the tick list's
    // end (CAL-184).
    newly_listed: List<i64> = List<i64>()
    // The chunks that came to tick before the level had its block facts, as the spawn's do at
    // the server's start, in the order they came to, post-processed once it has them (D329).
    post_waiting: LinkedSet<i64> = LinkedSet<i64>()
    // The chunks that came to tick before the level had their light, which post-processing
    // reads, post-processed as it comes (D329).
    post_lit: LinkedSet<i64> = LinkedSet<i64>()
    sub_ticks: i64 = 0
    /// The game time, which the level's ticks are scheduled and saved by, as the network has it.
    pub game_time: i64 = 0
    /// The blocks it has sent again, `sendBlockUpdated`, with what they were and are, which its
    /// entities read before each ticks, as its mobs' navigation does, and the network lets go
    /// once they've ticked (CAL-157).
    pub sent: SentLog = SentLog()
    // Its random, `Level.random`, which the server seeds from its input as it starts, and which
    // can write its draws to the RNG tape (D312); here, so what a block set does can draw from it
    // as vanilla's does, and `none` only while it's lent out (D323).
    random: TapedRandom? = none
    /// Lava's tick delay, `LavaFluid.getTickDelay`: 10 where the dimension's lava is fast, as the
    /// network sets it each tick, else 30 (D324).
    pub lava_delay: i32 = 30
    /// Whether its dimension's lava is fast, as the network sets it each tick, and the game rules
    /// `water_source_conversion` and `lava_source_conversion` (D328).
    pub fast_lava: bool = false
    /// Whether its dimension's the End, where an end gateway with no exit finds one, and whether
    /// portals may not take what's in it, the Nether's without the game rule that lets them in,
    /// `isAllowedToEnterPortal`, as the network sets them each tick (D594).
    pub the_end: bool = false
    pub portals_closed: bool = false
    /// Its dimension's sea level, `getSeaLevel`, as the world gives it, which a drowned's goals
    /// swim up toward and look for beaches by (CAL-175).
    pub sea: i32 = 63
    // Whether its chunks' entities load, as the network's levels' do, and the chunks whose
    // entities are in, `areEntitiesLoaded`, without which a block entity doesn't tick nor a
    // scheduled tick run there (D595). A test's level loads none, and ticks without.
    pub entities_load: bool = false
    entities_in: OpenHashSet<i64> = OpenHashSet<i64>()
    /// The world's jukebox songs, which the network gives it once the world's registries are
    /// read, and none until then (CAL-143).
    pub songs: Songs = Songs()
    pub water_source_conversion: bool = true
    pub lava_source_conversion: bool = false
    /// What its block ticks, random and scheduled, read of it this tick besides its blocks, as
    /// the network sets it each tick before they run (D338, D339); and each biome's climate,
    /// which where it rains reads, as the network gives it with the block facts (D339).
    pub place: TickPlace = TickPlace()
    /// The entities on a pressure plate as one going into it presses it, every one and the living
    /// ones, the players among them, counted as that one went in, which the plate takes in place
    /// of the place's, none else (D701).
    pub pressing: (i32, i32)? = none
    pub climate: Shared<Temperatures>? = none
    /// What broken blocks drop with (CAL-153): the world's loot, as the network gives it with the
    /// block facts; the server's random sequences, lent by the network to the level that's
    /// running, and the world's seed they're made from; the game rule `block_drops`; and the
    /// items and orbs dropped, for the network to make in order.
    pub loot: Shared<Loot>? = none
    /// The world's recipes, which a removed furnace's experience reads, as the network has them
    /// (CAL-197).
    pub recipes: Shared<Recipes>? = none
    /// The item codecs, which the network lends while the block ticks run, for what a crafter
    /// crafts (CAL-338).
    pub items: ItemCodecs? = none
    pub sequences: RandomSequences? = none
    pub world_seed: i64 = 0
    pub block_drops: bool = true
    /// The game rule `tnt_explodes`, which TNT's priming asks (CAL-182).
    pub tnt_explodes: bool = true
    dropped: List<Dropped> = List<Dropped>()
    // How much of `events` each of `dropped` came after, which the network sends before it
    // (CAL-167).
    dropped_heard: List<usize> = List<usize>()
    // What a block's shape and its survival read, the block facts and the dimension's light,
    // once the network has them, shared, so each block set and update reads them where they are
    // and doesn't copy them (D336); the updates waiting, as `CollectingNeighborUpdater` keeps them,
    // the stack and those the update running added, with how many have run in this chain and
    // how many may, `max-chained-neighbor-updates`; what isn't in Calcite yet that's been
    // reported; and the level events for the network to send (D326).
    env: Shared<Env>? = none
    update_stack: List<Update> = List<Update>()
    update_added: List<Update> = List<Update>()
    update_count: i32 = 0
    /// `max-chained-neighbor-updates`: how many updates a chain may run, or no end if below 0.
    pub max_chained: i32 = 1000000
    reported: Set<String> = Set<String>()
    events: List<Heard> = List<Heard>()
    // The block ticks running this tick, as `LevelTicks.tick` collects them, `toRunThisTick`, with
    // the next to run, and those still to run, `toRunThisTickSet`, which `willTickThisTick` makes
    // as it first asks; and the redstone torches' toggles, oldest first, `RECENT_TOGGLES`'s
    // list for the level (CAL-116).
    running: List<ScheduledTick> = List<ScheduledTick>()
    running_at: usize = 0
    to_run: Set<(i64, u32)> = Set<(i64, u32)>()
    toggles: List<Toggle> = List<Toggle>()
    // The `block_entity_type` registry's IDs by name, which a chunk's packet sends its block
    // entities' types by, made as the first chunk's packet is (CAL-115).
    block_entity_ids: OpenHashMap<String, i32> = OpenHashMap<String, i32>()
    // The block events waiting, `blockEvents`, each once, in the order they came; the moving
    // pistons' block entities, by their places, packed; the block entities' tickers,
    // `blockEntityTickers`, in their order, with those added while they tick,
    // `pendingBlockEntityTickers`, and whether they're ticking; each place's ticker's number, and
    // the next; which ticker each place's is, as `world.block_entity_ticks` has them, and each
    // chunk's tickers' places, which go as it unloads (CAL-130); the chunks full before the level
    // had its block facts, whose block entities tick once it has them; and the sounds' seeds, from
    // a sequence of their own, as vanilla's `threadSafeRandom` is seeded as the server starts
    // (CAL-125).
    block_events: List<BlockEvent> = List<BlockEvent>()
    // The bells rung by the block events run, whose block entities find who hears them, which the
    // level's entities do (CAL-160).
    rung: List<(i32, i32, i32)> = List<(i32, i32, i32)>()
    // What the shulker boxes' lids opening into push, each the box swept and the move, in the
    // order they ticked, which the server's entities make (D695).
    lid_pushes: List<(Aabb, (f64, f64, f64))> = List<(Aabb, (f64, f64, f64))>()
    motions: Map<i64, MovingPiston> = Map<i64, MovingPiston>()
    // What each container's block entity holds of who has it open, by its place, packed, which
    // goes with it, and the next number one's given (CAL-144).
    container_openers: Map<i64, Openers> = Map<i64, Openers>()
    next_openers: u64 = 1
    // What each beacon's block entity keeps unsaved, by its place, packed, which goes with it
    // (D520).
    beacons: Map<i64, BeaconState> = Map<i64, BeaconState>()
    // What each brewing stand's block entity keeps unsaved, by its place, packed, which goes with
    // it (CAL-337).
    brewing: Map<i64, BrewingState> = Map<i64, BrewingState>()
    // What its hoppers keep unsaved, the game time each last ticked (CAL-277).
    hoppers: Hoppers? = none
    // Each end gateway's cooldown, which its block entity keeps unsaved, by its place, packed,
    // which goes with it (D592).
    gateway_cooldowns: Map<i64, i32> = Map<i64, i32>()
    tickers: List<Ticker> = List<Ticker>()
    pending_tickers: List<Ticker> = List<Ticker>()
    ticking_entities: bool = false
    ticker_ids: Map<i64, u64> = Map<i64, u64>()
    next_ticker: u64 = 1
    ticker_kinds: Map<i64, i32> = Map<i64, i32>()
    chunk_tickers: Map<i64, List<i64>> = Map<i64, List<i64>>()
    moving_waiting: List<i64> = List<i64>()
    sound_seeds: i64 = 0
    /// `handlingTick`: whether the level's tick is between its start and its block events, as the
    /// network sets it, which a piston pulled back while another moves reads (CAL-125).
    pub handling: bool = false
    /// `emptyTime`: the ticks since a ticket that keeps the level ticking was last in it, or an
    /// entity came into it from another, `resetEmptyTime`, its fight, entities and block entities
    /// ticking only while it's under `EMPTY_TICKS` (D621).
    pub empty_time: i32 = 0
}

/// How many ticks a level may go without a ticket that keeps it ticking before its fight,
/// entities and block entities stop, `ServerLevel.tick`'s 300 (D621).
pub const EMPTY_TICKS: i32 = 300

// A chunk read while its points of interest were away, as `read_chunk` was handed it.
struct HeldRead {
    pos: ChunkPos
    io: List<Entry>
    loaded: Loaded
    made: List<Entry>
}

/// The blocks set in a section since they were last broadcast, as `ChunkHolder.broadcastChanges`
/// sends them (D321): the chunk and the section's `y`, and each block's place in the section,
/// `x << 8 | z << 4 | y`, as `SectionPos.sectionRelativePos` packs it, in the order its set gives
/// them, with its state as it is now; and the update packets of the block entities of those whose
/// class sends one, `broadcastBlockEntityIfNeeded`, in the same order (CAL-115).
pub struct SectionChanges {
    pub chunk: ChunkPos
    pub section_y: i32
    pub places: List<i16>
    pub states: List<u32>
    pub block_entities: List<ClientboundBlockEntityData>
}

/// A chunk's light that changed, as `ChunkHolder.broadcastChanges` sends it to the players with
/// the chunk on the edge of their view (D342): the light of the sections that changed, each as
/// the chunk's light has it now.
pub struct LightChanges {
    pub chunk: ChunkPos
    pub light: LightData
}

// Which of a chunk's sections' sky and block light changed, `skyChangedLightSectionFilter` and
// `blockChangedLightSectionFilter`, each a `BitSet`'s bytes.
struct LightBits {
    sky: List<u8> = List<u8>()
    block: List<u8> = List<u8>()
}

/// How far around where a player's going to another dimension a `portal` ticket loads, as
/// vanilla adds it, which is how far the place they'll stand is looked for (CAL-69).
pub const PORTAL_RADIUS: i32 = 3

/// Where a kept packet's version has its level's dimension, by its place in the world's: its top
/// 8 bits, so each level's are its own and a compressed one comes back to the level that gave it
/// (CAL-69).
pub const VERSION_SHIFT: u64 = 56

impl Level {
    /// A world whose player tickets reach `view` chunks and whose simulation distance is
    /// `simulation`, as the chunk map sets them, which reads nothing until it's opened. Its
    /// player tickets load `PLAYER_LOADS` chunks at once.
    pub fn new(view: i32, simulation: i32) -> Level {
        var dm = DistanceManager.new(TicketStorage.new())
        dm.set_most_in_execution(PLAYER_LOADS)
        dm.update_player_tickets(view)
        dm.update_simulation_distance(simulation)
        return Level { dm: dm, random: some(TapedRandom.new(0)) }
    }

    /// Gives the level `random` as its own, as the server seeds it.
    pub fn set_random(mut self, random: own TapedRandom) {
        self.random = some(random)
    }

    /// Lends the level's random out, for what takes it on its own, such as the weather; it's
    /// given back with `give_back_random`, and the level draws nothing meanwhile.
    pub fn lend_random(mut self) -> TapedRandom {
        let r = self.random.take() else panic("the level's random is lent out already")
        return r
    }

    /// Gives back the random `lend_random` lent.
    pub fn give_back_random(mut self, random: own TapedRandom) {
        self.random = some(random)
    }

    /// Has the level's random write each value it draws to the RNG tape from now on, each line
    /// starting with `name` (D312).
    pub fn tape_random(mut self, name: own String) {
        var r = self.lend_random()
        r.tape(name)
        self.random = some(r)
    }

    /// The RNG tape's lines the level's random wrote since this was last asked.
    pub fn take_random_lines(mut self) -> String {
        var r = self.lend_random()
        let out = r.take_lines()
        self.random = some(r)
        return out
    }

    /// Sets the game time the RNG tape's lines are at, as the level's tick moves it on.
    pub fn set_random_time(mut self, time: i64) {
        var r = self.lend_random()
        r.time = time
        self.random = some(r)
    }

    /// Sets the part of the tick the RNG tape's lines are drawn in, `site`, while it's taping
    /// (CAL-329).
    pub fn set_random_site(mut self, site: own String) {
        var r = self.lend_random()
        if r.taping() {
            r.site = site
        }
        self.random = some(r)
    }

    /// Makes the versions of the packets this level keeps its own among the world's levels, as
    /// it's the dimension at `dim` of them, whose whole ID is `key` (CAL-164).
    pub fn set_dimension(mut self, dim: usize, key: own String) {
        self.versions = u64(dim) << VERSION_SHIFT
        self.key = key
    }

    /// Gives the level its dimension's bottom and height, which a level that's opened has from
    /// what its chunks are made with, and the world's hashed seed, which zooms its biomes in from
    /// quarts to blocks, as `BiomeManager` zooms them (D317).
    pub fn set_bounds(mut self, min_y: i32, height: i32, zoom_seed: i64) {
        self.min_section = min_y >> 4
        self.sections = height >> 4
        self.columns.sections = usize.wrap(self.sections)
        self.zoom_seed = zoom_seed
    }

    /// Gives the level the light of a flat chunk among flat ones, which theirs is, for natural
    /// spawning, which reads it (D317).
    pub fn set_flat_light(mut self, light: own LightData) {
        self.flat_light = some(light)
    }

    /// How many chunks the natural spawn counter counts, `getNaturalSpawnChunkCount`, which the
    /// mob categories' caps are scaled by (D317).
    pub fn natural_spawn_chunk_count(mut self) -> i32 {
        return i32.wrap(self.dm.natural_spawn_chunk_count())
    }

    /// Keeps the light of `chunks`, those natural spawning may read this tick, for as long as
    /// they're given here each tick (D317). Vanilla's light is in its chunks; Calcite's is on
    /// light's thread, which gives a chunk's for its packet and lets it go once it's sent. So the
    /// level watches these as they come, and lets them go as they leave. A flat chunk among flat
    /// ones has the flat world's light, and isn't watched.
    pub fn keep_light(mut self, chunks: List<ChunkPos>) {
        var now = OpenHashSet<i64>()
        for pos in chunks {
            let k = pos.pack()
            now.insert(k)
            self.kept_light.insert(k)
            if self.lighting and not self.watching.contains(k) and not self.flat_around(pos) {
                self.watch(k)
            }
        }
        var gone = List<i64>()
        for k in self.kept_light {
            if not now.contains(k) {
                gone.push(k)
            }
        }
        for k in gone {
            self.kept_light.remove(k)
            self.release(k)
        }
    }

    /// The light at the block, the sky's if `sky`, as `getBrightness` reads it from the light
    /// engine's sections (D317): a section's layer, or for the sky, where a section has none, the
    /// bottom of the first above it that has one, or 15 above them all; for the blocks, 0 where
    /// there's none. A flat chunk among flat ones has the flat world's light. A chunk whose light
    /// isn't here yet, kept only this tick, has the sky's 15 and no block light.
    pub fn light_at(self, sky: bool, x: i32, y: i32, z: i32) -> i32 {
        let pos = ChunkPos { x: x >> 4, z: z >> 4 }
        let k = pos.pack()
        if self.light_data.contains(k) {
            return light_value(self.light_data[k], sky, self.min_section, self.sections, x, y, z)
        }
        if self.flat_around(pos) {
            if let f = self.flat_light {
                return light_value(f, sky, self.min_section, self.sections, x, y, z)
            }
        }
        return if sky { 15 } else { 0 }
    }

    /// Makes every chunk generated `flat`, which the world's blocks are, for collisions, and
    /// light once it's opened.
    pub fn ground(mut self, flat: own FlatChunk) {
        self.columns.flat = some(flat)
    }

    /// Reads chunks from now on, made with `context`: through `jobs`, the IO thread and chunk
    /// workers, or, replaying, from the log, which has what the recording read. Each is lit, on
    /// light's thread with `jobs`, and without them here, a step each time the level settles, as
    /// a test has it, until `replay_light` has the steps the recording's light took instead.
    /// Those that aren't saved are generated as `gen` says, or flat, the ground, if it's `none`.
    pub fn open(mut self, jobs: own ChunkJobs?, context: own ChunkContext, gen: own GenSetup?) {
        self.opened = true
        self.min_section = context.min_section
        self.sections = context.sections
        self.pois = some(Pois.new(context.min_section, context.sections))
        self.columns.sections = usize.wrap(context.sections)
        var flat: FlatChunk? = none
        if let f = self.columns.flat {
            flat = some(f.copy())
        }
        if let f = flat {
            var service = LightService.new(context.min_section, context.sections, context.sky_light, f)
            service.set_table(context.table.copy())
            self.lighting = true
            if let j = jobs {
                let asks = Receiver<Deque<LightAsk>>()
                let back = Receiver<LightDone>()
                self.light_to = some(asks.sender())
                _ = unsafe { Thread.spawn(LightThread { service: service, asks: asks, back: back.sender(), waker: j.poll_waker() }) }
                self.light_back = some(back)
            } else {
                self.light_here = some(service)
                self.light_eager = true
            }
        }
        self.jobs = jobs
        self.gen = gen
        self.table = some(context.table.copy())
        self.context = some(context)
    }

    /// Has light, run here, take the steps the recording's light took, each as `replay_light`
    /// hands it over, rather than a step each time the level settles.
    pub fn light_as_recorded(mut self) {
        self.light_eager = false
    }

    /// Whether chunks are read from the world's folder.
    pub fn reads(self) -> bool {
        return self.opened
    }

    /// Whether chunks that aren't saved are generated, rather than flat.
    pub fn generates(self) -> bool {
        return self.opened and self.gen != none
    }

    /// Asks the generator where a new world's spawn is, which comes back with what's done.
    pub fn ask_spawn(mut self) {
        var jobs = self.jobs.take() else return
        jobs.ask_spawn()
        self.jobs = some(jobs)
    }

    /// What's been logged since this was last asked, oldest first.
    pub fn take_lines(mut self) -> List<Entry> {
        let out = self.lines.copy()
        self.lines.clear()
        return out
    }

    /// Whether a read of the chunk at `pos` was asked for, which `read_chunk` takes (D589).
    pub fn asked_read(self, pos: ChunkPos) -> bool {
        return (self.asked.get(pos.pack()) ?? 0) > 0
    }

    /// How many chunks are loaded or being read for holders, and how many far chunks for
    /// players.
    pub fn chunk_count(self) -> (usize, usize) {
        return (self.columns.slots.len(), self.far.len())
    }

    /// How many chunks being read the generator's been told nothing wants, and not handed back
    /// (D243).
    pub fn dropping_count(self) -> usize {
        return self.dropping.len()
    }

    /// Adds `player` in `chunk`, as `ChunkMap.updatePlayerStatus` does. What their tickets
    /// come to loads at the next `pump`.
    pub fn add_player(mut self, chunk: ChunkPos, player: i32) {
        self.dm.add_player(chunk.pack(), player)
    }

    /// Takes `player` out of `chunk`, as a player who leaves is, until the next `pump`.
    pub fn remove_player(mut self, chunk: ChunkPos, player: i32) {
        self.dm.remove_player(chunk.pack(), player)
    }

    /// Moves `player` from `from` to `to`, as `ChunkMap.move` does when they go into another
    /// section, until the next `pump`.
    pub fn move_player(mut self, from: ChunkPos, to: ChunkPos, player: i32) {
        self.dm.remove_player(from.pack(), player)
        self.dm.add_player(to.pack(), player)
    }

    /// Lets go of the far chunks read for `player`, who left.
    pub fn forget_player(mut self, player: i32) {
        var gone = List<i64>()
        for (k, f) in self.far {
            if f.owner == player {
                gone.push(k)
            }
        }
        for k in gone {
            self.free_far(k)
        }
        _ = self.far_loads.remove(player)
    }

    /// The chunk at `pos` left `player`'s view: a far chunk read for them goes.
    pub fn forget_far(mut self, pos: ChunkPos, player: i32) {
        let k = pos.pack()
        if self.far.contains(k) and self.far[k].owner == player {
            self.free_far(k)
        }
    }

    /// Adds a joining player's spawn ticket, `player_spawn` 3 around `chunk`, and settles what
    /// it comes to, as `addTicketAndLoadWithRadius` does.
    pub fn load_spawn(mut self, chunk: ChunkPos) {
        _ = self.dm.add_ticket(chunk.pack(), Ticket.with_radius(TicketType.PlayerSpawn, SPAWN_RADIUS))
        self.pump()
    }

    /// A player's to join at `chunk`, whose spawn ticket `load_spawn` added: the chunks within its
    /// reach are wanted with their light as they're lit, those lit already now, as the player's
    /// sender, which comes to them as soon as they join, would want them, so they're sent then,
    /// as vanilla's are, nearest first, and not after the flat chunks further out, which need no
    /// light from light (CAL-121). The ticket going ends it.
    pub fn want_spawn_light(mut self, chunk: ChunkPos) {
        let k = chunk.pack()
        if not self.spawns.contains(k) {
            self.spawns.push(k)
        }
        for x in chunk.x - SPAWN_RADIUS..chunk.x + SPAWN_RADIUS + 1 {
            for z in chunk.z - SPAWN_RADIUS..chunk.z + SPAWN_RADIUS + 1 {
                let pos = ChunkPos { x: x, z: z }
                if self.lit.contains(pos.pack()) {
                    _ = self.light_wanted(pos)
                }
            }
        }
    }

    // Whether the chunk at `k` is within the reach of a joining player's spawn ticket, those whose
    // ticket's gone let go of.
    fn near_spawn(mut self, k: i64) -> bool {
        var kept = List<i64>()
        var near = false
        let pos = unpacked(k)
        for c in self.spawns {
            var held = false
            for ticket in self.dm.tickets.tickets_at(c) {
                if ticket.kind == TicketType.PlayerSpawn {
                    held = true
                }
            }
            if not held {
                continue
            }
            kept.push(c)
            let centre = unpacked(c)
            if (pos.x - centre.x).abs() <= SPAWN_RADIUS and (pos.z - centre.z).abs() <= SPAWN_RADIUS {
                near = true
            }
        }
        self.spawns = kept
        return near
    }

    /// Adds a `portal` ticket `PORTAL_RADIUS` around `chunk`, as a portal loads where it leads,
    /// and settles what it comes to (CAL-69).
    pub fn load_portal(mut self, chunk: ChunkPos) {
        _ = self.dm.add_ticket(chunk.pack(), Ticket.with_radius(TicketType.Portal, PORTAL_RADIUS))
        self.pump()
    }

    /// Adds a `dragon` ticket 9 about chunk 0, 0, as a dragon fight with players about it keeps its
    /// arena loaded, and settles what it comes to; and takes it away, as one without lets it go,
    /// where it's there (D586).
    pub fn load_dragon(mut self) {
        if self.dm.add_ticket(ChunkPos { x: 0, z: 0 }.pack(), Ticket.with_radius(TicketType.Dragon, 9)) {
            self.pump()
        }
    }

    pub fn let_go_dragon(mut self) {
        if self.dm.remove_ticket(ChunkPos { x: 0, z: 0 }.pack(), Ticket.with_radius(TicketType.Dragon, 9)) {
            self.pump()
        }
    }

    /// Whether a dragon fight's arena is loaded, `isArenaLoaded` (D624): each chunk from x -8 to
    /// 8 at z 8, full at a level whose blocks tick, `BLOCK_TICKING`, as vanilla's loop over z
    /// from 8 to 8 goes over that row alone; and the entities of the nine chunks about 0, 0 in,
    /// `areEntitiesLoaded`.
    pub fn arena_loaded(self) -> bool {
        for x in -8..9 {
            let pos = ChunkPos { x: x, z: 8 }
            if not self.full(pos) or self.dm.chunk_level(pos.pack(), false) > TICKING {
                return false
            }
        }
        for x in -1..2 {
            for z in -1..2 {
                if not self.entities_are_in(ChunkPos { x: x, z: z }.pack()) {
                    return false
                }
            }
        }
        return true
    }

    /// Whether each chunk of a dragon fight's arena, from -8 to 8 each way, is full, as its scan
    /// reads them on the server's thread, `getChunk`, which waits for those that aren't; each that
    /// isn't asked for as that read asks, `load_now` (D625).
    pub fn arena_read(mut self) -> bool {
        var all = true
        for x in -8..9 {
            for z in -8..9 {
                let pos = ChunkPos { x: x, z: z }
                if not self.full(pos) {
                    all = false
                    self.load_now(pos)
                }
            }
        }
        return all
    }

    /// Whether a dragon fight's arena has an end portal in it, `hasActiveExitPortal` (D625): its
    /// block entity in a chunk from -8 to 8 each way.
    pub fn arena_end_portal(self) -> bool {
        for x in -8..9 {
            for z in -8..9 {
                for (_, tag) in self.columns.block_entities_of(ChunkPos { x: x, z: z }.pack()) {
                    if (kind_of(tag) ?? String()) == "minecraft:end_portal" {
                        return true
                    }
                }
            }
        }
        return false
    }

    /// `findExitPortal`'s search (D625): the exit portal's pattern looked for about each end
    /// portal's block entity in a dragon fight's arena, by chunks from -8 to 8, x then z, and by
    /// each one's block entities in its map's order; then down the column at 0, 0, from the top of
    /// what blocks motion to the bottom of the world. The portal's place, the middle of the
    /// pattern's ring, where it's found.
    pub fn find_exit_portal(mut self) -> BlockPos? {
        return match self.find_exit_match() {
            some(m) => some(m.at()),
            none => none,
        }
    }

    /// `find_exit_portal`'s match, the pattern's blocks with it (CAL-167).
    pub fn find_exit_match(mut self) -> PortalMatch? {
        let some_env = self.env.copy()
        let shared = some_env else return none
        let Env { facts: f, .. } = shared.value
        for x in -8..9 {
            for z in -8..9 {
                for (pos, tag) in self.columns.block_entities_of(ChunkPos { x: x, z: z }.pack()) {
                    if (kind_of(tag) ?? String()) != "minecraft:end_portal" {
                        continue
                    }
                    match exit_portal_match(f, self, pos.x, pos.y, pos.z) {
                        ok(found) => {
                            if let at = found {
                                return some(at)
                            }
                        },
                        err(thrown) => self.unimplemented(thrown.message),
                    }
                }
            }
        }
        let bottom = self.min_section * 16
        var y = self.height_at(MOTION_BLOCKING, 0, 0) ?? bottom
        while y >= bottom {
            match exit_portal_match(f, self, 0, y, 0) {
                ok(found) => {
                    if let at = found {
                        return some(at)
                    }
                },
                err(thrown) => {
                    self.unimplemented(thrown.message)
                    return none
                },
            }
            y -= 1
        }
        return none
    }

    /// `spawnExitPortal(active)` (D625): the exit portal's podium placed at `exit`, or, where
    /// that isn't known, at the block under the top of what blocks motion but leaves at 0, 0, down
    /// past bedrock while it's above 63, a block over the bottom of the world at the lowest;
    /// `END_PODIUM_ACTIVE` where `active`, else `INACTIVE`, in the running level, each block set
    /// with flags 3. Where it's placed. Vanilla then holds the chunks about it back from players
    /// till their light's done, `waitForLightBeforeSending`, as Calcite sends a chunk's light as
    /// it's done.
    pub fn spawn_exit_portal(mut self, exit: BlockPos?, active: bool) -> BlockPos {
        let bottom = self.min_section * 16
        var at = BlockPos { x: 0, y: bottom + 1, z: 0 }
        let some_env = self.env.copy()
        let shared = some_env else return at
        let Env { facts: f, .. } = shared.value
        match exit {
            some(e) => at = e,
            none => {
                var y = (self.height_at(MOTION_BLOCKING_NO_LEAVES, 0, 0) ?? bottom) - 1
                while y > 63 and self.is_block(f, 0, y, 0, f.ids.bedrock) {
                    y -= 1
                }
                at = BlockPos { x: 0, y: y.max(bottom + 1), z: 0 }
            },
        }
        match place_end_podium(f, mut self, active, at.x, at.y, at.z) {
            ok(_) => {},
            err(thrown) => self.unimplemented(thrown.message),
        }
        return at
    }

    /// `respawnDragon`'s clearing of the exit portal (CAL-167): while its pattern's found,
    /// `findExitPortal`, each of the pattern's blocks that's bedrock or an end portal set to end
    /// stone with flags 3, `setBlockAndUpdate`, in the pattern's order.
    pub fn clear_exit_portals(mut self) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let Env { facts: f, .. } = shared.value
        let stone = match f.named_block("end_stone") {
            ok(s) => f.default_state(s),
            err(thrown) => {
                self.unimplemented(thrown.message)
                return
            },
        }
        let portal = match f.named_block("end_portal") {
            ok(p) => p,
            err(thrown) => {
                self.unimplemented(thrown.message)
                return
            },
        }
        while let m = self.find_exit_match() {
            for at in m.blocks() {
                let state = match self.state(f, at.x, at.y, at.z) {
                    ok(s) => s,
                    err(thrown) => {
                        self.unimplemented(thrown.message)
                        return
                    },
                }
                if f.is(state, f.ids.bedrock) or f.is(state, portal) {
                    _ = self.set_block_limited(at.x, at.y, at.z, stone, 3, UPDATE_LIMIT)
                }
            }
        }
    }

    /// `EnderDragonFight.spawnNewGateway(pos)` (D627): level event 3000, `END_GATEWAY_SPAWN`, at x,
    /// y, z for the players near it, then a gateway with no exit placed there in the running level,
    /// `END_GATEWAY_DELAYED`, which draws nothing from the random it's given.
    pub fn spawn_fight_gateway(mut self, x: i32, y: i32, z: i32) {
        self.level_event(GATEWAY_SPAWNED, x, y, z, 0)
        let some_env = self.env.copy()
        let shared = some_env else return
        let Env { facts: f, .. } = shared.value
        match place_end_gateway(f, mut self, delayed_exit(), x, y, z) {
            ok(_) => {},
            err(thrown) => self.unimplemented(thrown.message),
        }
    }

    /// The dragon egg a dragon fight's first kill leaves, set at the top of what blocks motion at
    /// 0, 0, `setBlockAndUpdate` with flags 3 (D627).
    pub fn place_dragon_egg(mut self) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let Env { facts: f, .. } = shared.value
        let y = self.height_at(MOTION_BLOCKING, 0, 0) ?? (self.min_section * 16)
        match f.named_block("dragon_egg") {
            ok(egg) => _ = self.set_block_limited(0, y, 0, f.default_state(egg), 3, UPDATE_LIMIT),
            err(thrown) => self.unimplemented(thrown.message),
        }
    }

    // Whether the block at x, y, z is `block`, false where it can't be read.
    fn is_block(self, f: Facts, x: i32, y: i32, z: i32, block: u32) -> bool {
        return match self.state(f, x, y, z) {
            ok(s) => f.is(s, block),
            err(_) => false,
        }
    }

    /// Adds an `ender_pearl` ticket 2 around `chunk`, as an ender pearl keeps where it flies
    /// loaded, `placeEnderPearlTicket`, and settles what it comes to (D579).
    pub fn load_pearl(mut self, chunk: ChunkPos) {
        _ = self.dm.add_ticket(chunk.pack(), Ticket.with_radius(TicketType.EnderPearl, 2))
        self.pump()
    }

    /// Where a player can stand in the column at `x`, `z`, as `world.spawn.standing_y` finds it,
    /// from `top` down, or from the top of `MOTION_BLOCKING` where that's lower and the dimension
    /// has no ceiling, if its chunk is full.
    pub fn standing_y(self, states: CollisionStates, x: i32, z: i32, top: i32, ceiling: bool) -> i32? {
        let pos = ChunkPos { x: x >> 4, z: z >> 4 }
        if not self.full(pos) {
            return none
        }
        let k = pos.pack()
        if self.columns.live.contains(k) {
            let from = if ceiling { top } else { top.min(self.columns.live[k].height(MOTION_BLOCKING, x & 15, z & 15)) }
            return standing_y(states, self.columns.live[k], self, x, from, z)
        }
        match self.columns.slots[k] {
            Body.Saved(s) => {
                let from = if ceiling { top } else { top.min(s.chunk.value.height(MOTION_BLOCKING, x & 15, z & 15)) }
                return standing_y(states, s.chunk.value, self, x, from, z)
            },
            Body.Flat => {
                if let f = self.columns.flat {
                    let from = if ceiling { top } else { top.min(f.chunk.height(MOTION_BLOCKING, x & 15, z & 15)) }
                    return standing_y(states, f.chunk, self, x, from, z)
                }
            },
            Body.Loading => {},
        }
        return none
    }

    /// Adds a spawn search's ticket, `spawn_search` at `chunk` alone, and settles what it comes
    /// to, as `PlayerSpawnFinder.scheduleCandidate` adds it, so the candidate there can be checked
    /// once the chunk is `full`.
    pub fn search_spawn(mut self, chunk: ChunkPos) {
        _ = self.dm.add_ticket(chunk.pack(), Ticket.with_radius(TicketType.SpawnSearch, 0))
        self.pump()
    }

    /// `setChunkForced` (D622): `pos` forced or let go, `updateChunkForced`, what that comes to
    /// settled; a chunk newly forced then read as reading it on the server's thread would,
    /// `getChunk`, which vanilla waits for there and then, Calcite having it as it comes. Whether
    /// its forced ticket was added or taken out.
    pub fn set_forced(mut self, pos: ChunkPos, forced: bool) -> bool {
        let changed = self.dm.update_forced(pos, forced)
        if changed {
            self.pump()
        }
        if forced and changed {
            self.load_now(pos)
        }
        return changed
    }

    /// The chunks with a forced ticket, `getForceLoadedChunks`, in their set's order (D622).
    pub fn forced_chunks(self) -> List<i64> {
        return self.dm.tickets.forced_chunks()
    }

    /// Whether the chunk packed in `k` has a forced ticket (D622).
    pub fn is_forced(self, k: i64) -> bool {
        return self.dm.tickets.is_forced(k)
    }

    /// Adds `UNKNOWN`'s ticket at `chunk` alone, as reading a block there on the server's thread
    /// adds it, `getChunkFutureMainThread`, and settles what it comes to, so the chunk's read once
    /// it's `full` (D576).
    pub fn load_now(mut self, chunk: ChunkPos) {
        _ = self.dm.add_ticket(chunk.pack(), Ticket.with_radius(TicketType.Unknown, 0))
        self.pump()
    }

    /// Whether the chunk at `pos` has a holder at a level it's full at, as `hasChunk` asks,
    /// loaded or not yet (D577).
    pub fn has_chunk(self, pos: ChunkPos) -> bool {
        return self.dm.chunk_level(pos.pack(), false) <= FULL
    }

    /// Whether the points of interest of the chunks within `r` of `center` are known, those that
    /// aren't asked for, as reading them on the server's thread reads them, `getOrLoad` (D577).
    pub fn pois_known(mut self, center: ChunkPos, r: i32) -> bool {
        var all = true
        for x in center.x - r..center.x + r + 1 {
            for z in center.z - r..center.z + r + 1 {
                let k = ChunkPos { x: x, z: z }.pack()
                self.ask_pois(k)
                let pois = self.lend_pois()
                let known = pois.knows(unpacked(k))
                self.give_back_pois(pois)
                if not known {
                    all = false
                }
            }
        }
        return all
    }

    /// The nearest point of interest of the types `wanted` holds to `center`, `Pois.nearest`, for
    /// `locate poi` (D602).
    pub fn nearest_poi(mut self, wanted: List<bool>, center: BlockPos) -> PoiRecord? {
        let pois = self.lend_pois()
        let found = pois.nearest(wanted, center)
        self.give_back_pois(pois)
        return found
    }

    /// The type of the point of interest at `pos`, `getType`, if there's one in a section that's
    /// known, for a lodestone compass (D603).
    pub fn poi_type_at(mut self, pos: BlockPos) -> i32? {
        let pois = self.lend_pois()
        let kind = pois.type_at(pos)
        self.give_back_pois(pois)
        return kind
    }

    /// Whether a player's chunks are still loading, which a pregen task gives way to (D277).
    pub fn players_loading(self) -> bool {
        return self.dm.players_loading()
    }

    /// Whether the chunk at `pos` was last told full to the entities, `take_full_changes`, so
    /// its entities are accessible and tracked (CAL-193).
    pub fn accessible(self, pos: ChunkPos) -> bool {
        return self.full_told.contains(pos.pack())
    }

    /// Whether the chunk at `pos` is full, as a chunk's future for `FULL` is done.
    pub fn full(self, pos: ChunkPos) -> bool {
        let k = pos.pack()
        return self.dm.chunk_level(k, false) <= FULL and self.loaded(k)
    }

    /// The chunks that came to be full since this was last asked, `true`, and those that stopped
    /// being, `false`, as `ChunkMap.onFullChunkStatusChange` tells the level's entities which
    /// chunks are accessible (CAL-148): those that stopped first, in the order they did, then
    /// those that came to be, nearest the players first. Full here is lit as well, as vanilla's
    /// `FULL` comes after `LIGHT`, which waits for the chunks around it and which vanilla's light
    /// runs by the chunks' levels, lowest first, so the chunks around a player come to be full
    /// from the middle out, whichever was read first; those at a level go north to south, then
    /// west to east (CAL-222). A chunk that came to be full and stopped being between two asks
    /// isn't in it. And as vanilla's chunk tasks go by level too, lowest first, a chunk doesn't
    /// come to be full here while one nearer, at a lower level, is still to, so one read sooner
    /// doesn't put its entities, and their IDs, before those of the chunks nearer the players;
    /// it's held for that at most a second, `FULL_HOLD` (CAL-188).
    pub fn take_full_changes(mut self) -> List<(ChunkPos, bool)> {
        var out = List<(ChunkPos, bool)>()
        if self.full_maybe.is_empty() {
            return out
        }
        let maybe = self.full_maybe.copy()
        self.full_maybe.clear()
        var came = List<(i32, ChunkPos)>()
        var seen = OpenHashSet<i64>()
        for k in maybe {
            if seen.contains(k) {
                continue
            }
            seen.insert(k)
            let pos = unpacked(k)
            let level = self.dm.chunk_level(k, false)
            let now = self.full(pos) and (not self.lighting or self.lit.contains(k))
            if level <= FULL and not now {
                self.full_pending.insert(k)
            } else {
                self.full_pending.remove(k)
            }
            // Full again after it dropped since the last ask: it stopped being now, and comes to
            // be at the next, so what's in it unloads between (CAL-193).
            if now and self.full_dropped.contains(k) {
                self.full_dropped.remove(k)
                if self.full_told.contains(k) {
                    self.full_told.remove(k)
                    _ = self.full_held.remove(k)
                    out.push((pos, false))
                    self.full_maybe.push(k)
                    continue
                }
            }
            self.full_dropped.remove(k)
            if now == self.full_told.contains(k) {
                _ = self.full_held.remove(k)
                continue
            }
            if now {
                came.push((level, pos))
            } else {
                self.full_told.remove(k)
                _ = self.full_held.remove(k)
                out.push((pos, false))
            }
        }
        // The lowest level of a chunk still to come to be full.
        var lowest = FULL + 1
        for k in self.full_pending {
            let level = self.dm.chunk_level(k, false)
            if level < lowest {
                lowest = level
            }
        }
        // Those held back for a nearer one go back to be asked about again, the rest come.
        var ready = List<(i32, ChunkPos)>()
        for (level, pos) in came {
            let k = pos.pack()
            if level > lowest {
                if not self.full_held.contains(k) {
                    self.full_held.insert(k, self.game_time)
                }
                if self.game_time - self.full_held[k] < FULL_HOLD {
                    self.full_maybe.push(k)
                    continue
                }
            }
            _ = self.full_held.remove(k)
            ready.push((level, pos))
        }
        // An insertion sort, as there are few.
        for i in 1..ready.len() {
            var j = i
            while j > 0 and nearer(ready[j], ready[j - 1]) {
                let held = ready[j - 1]
                ready[j - 1] = ready[j]
                ready[j] = held
                j -= 1
            }
        }
        for (_, pos) in ready {
            self.full_told.insert(pos.pack())
            out.push((pos, true))
        }
        return out
    }

    /// Where a player new to the world would stand in the column at `x`, `z`, as
    /// `world.spawn.respawn_pos` finds it, if its chunk is full.
    pub fn respawn_pos(self, states: CollisionStates, x: i32, z: i32) -> BlockPos? {
        let pos = ChunkPos { x: x >> 4, z: z >> 4 }
        if not self.full(pos) {
            return none
        }
        let k = pos.pack()
        if self.columns.live.contains(k) {
            return respawn_pos(states, self.columns.live[k], x, z)
        }
        match self.columns.slots[k] {
            Body.Saved(s) => return respawn_pos(states, s.chunk.value, x, z),
            Body.Flat => {
                if let f = self.columns.flat {
                    return respawn_pos(states, f.chunk, x, z)
                }
            },
            Body.Loading => {},
        }
        return none
    }

    /// Adds the spawn ticket again, so it doesn't run out while the player is still to join, as
    /// `PrepareSpawnTask.Ready.keepAlive` does each configuration tick.
    pub fn keep_spawn(mut self, chunk: ChunkPos) {
        _ = self.dm.add_ticket(chunk.pack(), Ticket.with_radius(TicketType.PlayerSpawn, SPAWN_RADIUS))
    }

    /// Whether every chunk within `radius` of `center` is full, as `getChunkRangeFuture` waits
    /// for them to be.
    pub fn full_around(self, center: ChunkPos, radius: i32) -> bool {
        for x in center.x - radius..center.x + radius + 1 {
            for z in center.z - radius..center.z + radius + 1 {
                let k = ChunkPos { x: x, z: z }.pack()
                if self.dm.chunk_level(k, false) > FULL or not self.loaded(k) {
                    return false
                }
            }
        }
        return true
    }

    /// Whether the future `getChunkRangeFuture` gives for the chunks within `radius` of
    /// `center` is done: each is full, or was let go before it was, as one whose level rose past
    /// `FULL` fails its future. A spawn ticket runs out 20 ticks after its own chunk is ready to
    /// save, whether those around it are full yet or not, and the player joins then anyway.
    pub fn around_done(self, center: ChunkPos, radius: i32) -> bool {
        for x in center.x - radius..center.x + radius + 1 {
            for z in center.z - radius..center.z + radius + 1 {
                let k = ChunkPos { x: x, z: z }.pack()
                if self.dm.chunk_level(k, false) <= FULL and not self.loaded(k) {
                    return false
                }
            }
        }
        return true
    }

    /// Whether the chunk at `pos` is ready to send: its ticking chunk's in, as `getChunkToSend`
    /// has it (D447).
    pub fn sendable(self, pos: ChunkPos) -> bool {
        return self.ticking.contains(pos.pack())
    }

    /// Whether the server's in its tick, where vanilla's main-thread executor doesn't run, so no
    /// chunk's ticking chunk comes in till it's out (D447).
    pub fn set_in_tick(mut self, in_tick: bool) {
        self.in_tick = in_tick
    }

    /// The chunks mobs may spawn in this tick, as `collectSpawningChunks` finds them (D315): each
    /// within 8 of a player by the natural spawn counter, in its order, whose chunk ticks, with a
    /// player of `players`, where each stands on x and z, closer than 128 blocks to its middle, as
    /// `anyPlayerCloseEnoughForSpawningInternal` has it. Spectators aren't close to any.
    pub fn spawning_chunks(mut self, players: List<(f64, f64)>) -> List<ChunkPos> {
        var out = List<ChunkPos>()
        for k in self.dm.spawn_candidates() {
            let pos = unpacked(k)
            if not self.sendable(pos) {
                continue
            }
            let mid_x = f64(pos.x * 16 + 8)
            let mid_z = f64(pos.z * 16 + 8)
            for (x, z) in players {
                let dx = mid_x - x
                let dz = mid_z - z
                if dx * dx + dz * dz < 16384.0 {
                    out.push(pos)
                    break
                }
            }
        }
        return out
    }

    /// The chunks whose blocks tick, as `forEachBlockTickingChunk` goes over them (D318): those
    /// the simulation tracker has in range for their entities to tick, in its table's order,
    /// whose chunk ticks.
    pub fn block_ticking_chunks(self) -> List<ChunkPos> {
        var out = List<ChunkPos>()
        for k in self.dm.entity_ticking_chunks() {
            let pos = unpacked(k)
            if self.sendable(pos) {
                out.push(pos)
            }
        }
        return out
    }

    /// The bottom `y` of each section of the chunk at `pos` with a block or fluid that ticks at
    /// random, `isRandomlyTicking`, from the bottom up (D318).
    pub fn ticking_sections(self, pos: ChunkPos) -> List<i32> {
        var out = List<i32>()
        if not self.full(pos) {
            return out
        }
        let k = pos.pack()
        if self.columns.live.contains(k) {
            ticking_in(self.columns.live[k], mut out)
            return out
        }
        match self.columns.slots[k] {
            Body.Saved(s) => ticking_in(s.chunk.value, mut out),
            Body.Flat => {
                if let f = self.columns.flat {
                    ticking_in(f.chunk, mut out)
                }
            },
            Body.Loading => {},
        }
        return out
    }

    /// The blocks set since this was last asked in each chunk that ticks, as
    /// `broadcastChangedChunks` goes over the holders with changes once the chunks have ticked, a
    /// section at a time from the bottom (D321). The chunks go in the order they first had one, as
    /// vanilla's go in the order of a set of holders by their identity. Those that don't tick by
    /// now have theirs dropped.
    pub fn take_changes(mut self) -> List<SectionChanges> {
        var out = List<SectionChanges>()
        if self.to_broadcast.is_empty() {
            return out
        }
        var chunks = List<i64>()
        for k in self.to_broadcast {
            chunks.push(k)
        }
        self.to_broadcast.clear()
        for k in chunks {
            let pos = unpacked(k)
            let ticks = self.sendable(pos)
            for section_y in self.min_section..self.min_section + self.sections {
                let set = self.changed_blocks.remove(section_key(pos.x, section_y, pos.z)) else continue
                if not ticks {
                    continue
                }
                var places = List<i16>()
                var states = List<u32>()
                var entities = List<ClientboundBlockEntityData>()
                for p in set {
                    let place = i32(p)
                    places.push(p)
                    let at = BlockPos { x: pos.x * 16 + ((place >> 8) & 15), y: section_y * 16 + (place & 15), z: pos.z * 16 + ((place >> 4) & 15) }
                    let state = self.spawn_state(at.x, at.y, at.z)
                    states.push(state)
                    if let packet = self.update_packet(k, at, state) {
                        entities.push(packet)
                    }
                }
                out.push(SectionChanges { chunk: pos, section_y: section_y, places: places, states: states, block_entities: entities })
            }
        }
        return out
    }

    /// The light that changed in each chunk that ticks since this was last asked, as
    /// `broadcastChanges` sends it before the chunk's blocks, in the order the chunks first had
    /// some (D342): the sections' light as the chunk's light is now, `LightUpdatePacketData` of
    /// the sections marked, each with its light, or none known to be dark, or left out where
    /// there's none. Light's thread gives a chunk's light for its packet and lets it go once it's
    /// sent, unless it's kept, so a chunk whose light isn't here has it asked for again and keeps
    /// its marks until it comes. A flat chunk among flat ones gives none.
    pub fn take_light_changes(mut self) -> List<LightChanges> {
        var out = List<LightChanges>()
        if self.light_order.is_empty() {
            return out
        }
        var chunks = List<i64>()
        for k in self.light_order {
            chunks.push(k)
        }
        self.light_order.clear()
        var waiting = List<i64>()
        for k in chunks {
            let pos = unpacked(k)
            if not self.sendable(pos) or not self.lighting or self.flat_around(pos) {
                _ = self.light_bits.remove(k)
                continue
            }
            if not self.light_data.contains(k) {
                // Asked for again unless it's been asked for since light last gave it.
                let asked = self.watching.get(k) ?? 0u64
                if not self.watching.contains(k) or asked <= self.light_covered {
                    self.watch(k)
                }
                waiting.push(k)
                continue
            }
            let bits = self.light_bits.remove(k) else continue
            out.push(LightChanges { chunk: pos, light: light_part(self.light_data[k], bits) })
        }
        for k in waiting {
            self.light_order.insert(k)
        }
        return out
    }

    /// Schedules a tick of the block `kind` at `x`, `y`, `z`, due in `delay` ticks with
    /// `priority`, as `scheduleTick` does: dropped if its chunk isn't full, or if the block has
    /// one of its kind already (D322).
    pub fn schedule_block_tick(mut self, kind: u32, x: i32, y: i32, z: i32, delay: i32, priority: i32) {
        let tick = self.new_tick(kind, x, y, z, delay, priority)
        _ = self.block_ticks.schedule(tick)
    }

    /// Schedules a tick of the fluid `kind` at `x`, `y`, `z`, as `schedule_block_tick` does a
    /// block's.
    pub fn schedule_fluid_tick(mut self, kind: u32, x: i32, y: i32, z: i32, delay: i32, priority: i32) {
        let tick = self.new_tick(kind, x, y, z, delay, priority)
        _ = self.fluid_ticks.schedule(tick)
    }

    /// Whether the block at `x`, `y`, `z` has a tick of the fluid `kind` scheduled.
    pub fn has_fluid_tick(self, kind: u32, x: i32, y: i32, z: i32) -> bool {
        return self.fluid_ticks.has(kind, x, y, z)
    }

    /// The block ticks due now, in the order they're to run, as `blockTicks.tick` takes them
    /// (D322), from the chunks `tickCheck` says tick: in range for their blocks to tick, and
    /// ticking. Vanilla's check asks too whether the chunk's entities are loaded, which a chunk's
    /// are once it's full here.
    pub fn take_block_ticks(mut self) -> List<ScheduledTick> {
        self.check_ticks()
        let ticking = self.ticking_of(self.block_ticks.due(self.game_time))
        return self.block_ticks.collect(self.game_time, MOST_TICKS, ticking)
    }

    /// The fluid ticks due now, as `take_block_ticks` takes the blocks'.
    pub fn take_fluid_ticks(mut self) -> List<ScheduledTick> {
        self.check_ticks()
        let ticking = self.ticking_of(self.fluid_ticks.due(self.game_time))
        return self.fluid_ticks.collect(self.game_time, MOST_TICKS, ticking)
    }

    /// The random tick of the block at `x`, `y`, `z`, then of its fluid, as `tickChunk` gives
    /// them, `ticks`' own, with what the level's `place` says of it this tick (D338). A level
    /// without the block facts gives none. What isn't in Calcite yet is reported.
    pub fn random_tick(mut self, ticks: RandomTicks, x: i32, y: i32, z: i32) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let state = self.spawn_state(x, y, z)
        match ticks.tick(shared.value, mut self, state, x, y, z) {
            ok => {},
            err(thrown) => self.report(thrown.message),
        }
    }

    /// Precipitation in the column at `x`, `z`, as `tickPrecipitation` brings it, `p`'s own,
    /// with the biomes' climate and what the level's `place` says of it this tick (D340). A level
    /// without the block facts or the climate has none. What isn't in Calcite yet is reported.
    pub fn precipitate(mut self, p: Precipitation, x: i32, z: i32) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let some_climate = self.climate.copy()
        let climate = some_climate else return
        let max_snow = self.place.max_snow
        match p.tick(shared.value, mut self, climate.value, max_snow, x, z) {
            ok => {},
            err(thrown) => self.report(thrown.message),
        }
    }

    /// Runs the block ticks due now, as `blockTicks.tick` runs them with `tickBlock` (D335): each
    /// whose block is still there does what its class's `tick` does, as `world.block_updates`
    /// has it, its chunk unsaved, as its ticks changed (CAL-148). A level without the block facts
    /// takes them and runs none, as before. What isn't in Calcite yet is reported.
    pub fn run_block_ticks(mut self) {
        let ticks = self.take_block_ticks()
        let some_env = self.env.copy()
        let shared = some_env else return
        // Each taken off those still to run before it runs, as `runCollectedTicks` polls it.
        self.running = ticks
        self.running_at = 0
        self.to_run.clear()
        while self.running_at < self.running.len() {
            let t = self.running[self.running_at]
            self.running_at += 1
            if not self.to_run.is_empty() {
                self.to_run.remove((BlockPos { x: t.x, y: t.y, z: t.z }.pack(), t.kind))
            }
            match tick_block(shared.value, mut self, t.kind, t.x, t.y, t.z) {
                ok => {},
                err(thrown) => self.report(thrown.message),
            }
        }
        self.running.clear()
        self.running_at = 0
        self.to_run.clear()
    }

    /// Runs the fluid ticks due now, as `fluidTicks.tick` runs them with `tickFluid` (D328): each
    /// whose block still holds its fluid flows, as `FlowingFluid.tick` has it, its chunk unsaved
    /// (CAL-148). A level without the block facts takes them and runs none, as before. What isn't
    /// in Calcite yet is reported.
    pub fn run_fluid_ticks(mut self) {
        let ticks = self.take_fluid_ticks()
        let some_env = self.env.copy()
        let shared = some_env else return
        for t in ticks {
            match tick_fluid(shared.value, mut self, t.kind, t.x, t.y, t.z) {
                ok => {},
                err(thrown) => self.report(thrown.message),
            }
        }
    }

    /// How many block and fluid ticks the level has, scheduled and saved, as `LevelTicks.count`
    /// counts them.
    pub fn tick_count(self) -> (usize, usize) {
        return (self.block_ticks.count(), self.fluid_ticks.count())
    }

    /// Gives the level what a block's shape and its survival read, the block facts and the
    /// dimension's light, as the network has them once the registries are read. Till then, a
    /// block set tells nothing around it (D326), and a chunk that comes to tick waits to be
    /// post-processed until it's given them (D329).
    pub fn set_env(mut self, env: own Env) {
        self.env = some(Shared(env))
        // The points of interest of the chunks that came before, in the order they came.
        let came = self.poi_waiting.copy()
        self.poi_waiting.clear()
        for (k, chunk, generated_now) in came {
            self.check_pois(k, chunk, generated_now)
        }
        let moving = self.moving_waiting.copy()
        self.moving_waiting.clear()
        for k in moving {
            if self.full(unpacked(k)) {
                self.load_tickers(k)
            }
        }
        // The chunks that came to tick without them, the spawn's at the server's start, are
        // post-processed now, in the order they came to, each that still ticks (D329).
        var waiting = List<i64>()
        for k in self.post_waiting {
            waiting.push(k)
        }
        self.post_waiting.clear()
        for k in waiting {
            if self.sendable(unpacked(k)) {
                self.post_process_lit(k)
            }
        }
    }

    /// What `set_env` gave it, shared, or none before (D376).
    pub fn shared_env(self) -> Shared<Env>? {
        return self.env.copy()
    }

    /// `sendBlockUpdated`: the block at `x`, `y`, `z` sent again to the players who have its
    /// chunk, with the blocks set as the chunks next broadcast, as it is then (D376).
    pub fn block_updated(mut self, x: i32, y: i32, z: i32) {
        let state = self.block_state(x, y, z) ?? AIR_STATE
        self.sent_block(ChunkPos { x: x >> 4, z: z >> 4 }, x, y, z, state, state, UPDATE_CLIENTS)
    }

    /// What the end gateway's block entity at x, y, z saves, where there's one (D593, D594).
    pub fn gateway_tag(self, x: i32, y: i32, z: i32) -> JavaHashMap<String, Tag>? {
        let saved = self.block_entity_tag(x, y, z) else return none
        let Tag.Compound(m) = saved else return none
        if not m.contains("id") or m["id"] != Tag.Str(String("minecraft:end_gateway")) {
            return none
        }
        return some(m)
    }

    /// The columns the end gateway at x, y, z reads where it takes what goes into it, as least x
    /// and z and most, where it reads any: those 5 each way of its exit, where it isn't exact,
    /// `findExitPosition` (D593, D594).
    pub fn gateway_reads(self, x: i32, y: i32, z: i32) -> (i32, i32, i32, i32)? {
        let tags = self.gateway_tag(x, y, z) else return none
        let e = gateway_exit_of(tags) else return none
        if gateway_exact(tags) {
            return none
        }
        return some((e.x - 5, e.z - 5, e.x + 5, e.z + 5))
    }

    // `findTallestBlock(level, around, dist, false)` (D593), `tallest_over` with nothing more.
    fn tallest_block(self, around: BlockPos, dist: i32) -> BlockPos {
        return self.tallest_over(around, dist, false, Set<i64>())
    }

    // `findTallestBlock(level, around, dist, bedrock_too)` (D593, D595): of the columns within
    // `dist` across of `around`, its own too where `bedrock_too`, each from the top of the world
    // down to above the tallest found so far, the first block whose collision shape's whole and
    // that isn't bedrock but where `bedrock_too`; the tallest, the first of those as high, else
    // `around`. The blocks packed in `stone` read as end stone, an island yet to be placed.
    fn tallest_over(self, around: BlockPos, dist: i32, bedrock_too: bool, stone: Set<i64>) -> BlockPos {
        let some_env = self.env.copy()
        let shared = some_env else return around
        let Env { facts: f, .. } = shared.value
        let bedrock = f.block_named(String("minecraft:bedrock")) ?? u32.MAX
        let min_y = self.min_section * 16
        let max_y = min_y + self.sections * 16 - 1
        var tallest: BlockPos? = none
        for xd in -dist..dist + 1 {
            for zd in -dist..dist + 1 {
                if xd == 0 and zd == 0 and not bedrock_too {
                    continue
                }
                let floor = match tallest {
                    some(t) => t.y,
                    none => min_y,
                }
                var y = max_y
                while y > floor {
                    let at = BlockPos { x: around.x + xd, y: y, z: around.z + zd }
                    var whole = stone.contains(at.pack())
                    if not whole {
                        let state = self.collision_state(at.x, y, at.z) ?? f.ids.air_state
                        whole = f.collision_full_block(state) and (bedrock_too or f.block(state) != bedrock)
                    }
                    if whole {
                        tallest = some(at)
                        break
                    }
                    y -= 1
                }
            }
        }
        return tallest ?? around
    }

    /// `getHighestFilledSectionIndex` of the chunk at `pos`, -1 where it's only air, none where
    /// it isn't full (D595).
    pub fn highest_filled(self, pos: ChunkPos) -> i32? {
        if not self.full(pos) {
            return none
        }
        let k = pos.pack()
        if self.columns.live.contains(k) {
            return some(self.columns.live[k].highest_filled_section())
        }
        match self.columns.slots[k] {
            Body.Saved(s) => return some(s.chunk.value.highest_filled_section()),
            Body.Flat => {
                if let f = self.columns.flat {
                    return some(f.chunk.highest_filled_section())
                }
            },
            Body.Loading => {},
        }
        return none
    }

    // The block at x, y, z, void air above and below the world, air where its chunk isn't
    // full (D595).
    fn block_or_air(self, f: Facts, x: i32, y: i32, z: i32) -> u32 {
        if y < self.min_section * 16 or y >= (self.min_section + self.sections) * 16 {
            return f.ids.void_air_state
        }
        return self.collision_state(x, y, z) ?? f.ids.air_state
    }

    // `findValidSpawnInChunk` of the chunk at `c` (D595): whether, from the chunk's least x and z
    // at 30 to its most and the top of its highest section that isn't only air, either way up
    // as `betweenClosed` takes them, there's end stone with two blocks above it whose collision
    // shapes aren't whole. Vanilla keeps the closest to the middle of the world as the walk's
    // cursor, which goes on to the walk's last block, so it finds that, the most of each, where
    // there's any.
    fn valid_spawn_in(self, f: Facts, c: ChunkPos) -> BlockPos? {
        let top = self.highest_filled(c) ?? -1
        let bottom = self.min_section * 16
        let section_y = if top == -1 { bottom } else { bottom + top * 16 }
        let high = section_y + 16 - 1
        let (y0, y1) = (high.min(30), high.max(30))
        let (x0, z0) = (c.x * 16, c.z * 16)
        let end_stone = f.block_named(String("minecraft:end_stone")) ?? u32.MAX
        for z in z0..z0 + 16 {
            for y in y0..y1 + 1 {
                for x in x0..x0 + 16 {
                    if f.block(self.block_or_air(f, x, y, z)) != end_stone {
                        continue
                    }
                    if f.collision_full_block(self.block_or_air(f, x, y + 1, z)) {
                        continue
                    }
                    if f.collision_full_block(self.block_or_air(f, x, y + 2, z)) {
                        continue
                    }
                    return some(BlockPos { x: x0 + 15, y: y1, z: z0 + 15 })
                }
            }
        }
        return none
    }

    /// What making an exit for the end gateway at x, z with none reads and comes to,
    /// `findOrCreateValidTeleportPos` (D595), `exact` where the gateway's exact. First along the
    /// line from the middle of the world through it, 1024 out, back 16 at a time past chunks that
    /// aren't only air, at most 16 times, then on past those that are, at most 16, each chunk read
    /// as it's come to, `findExitPortalXZPosTentative`; in the chunk it stops in, a block to stand
    /// on, `findValidSpawnInChunk`, else an island of end stone placed at 75 there, its random
    /// seeded by where it goes; about that, 16 each way, the tallest block, bedrock too, where the
    /// gateway goes 10 above; then, where it isn't exact, what `findExitPosition` reads about
    /// that, 5 each way. The chunks it'd read next that aren't full are what it `needs`, where
    /// it's as far as it gets.
    pub fn exit_plan(self, f: Facts, x: i32, z: i32, exact: bool) -> ExitPlan {
        var plan = ExitPlan { needs: List<ChunkPos>(), spawn: BlockPos { x: 0, y: 0, z: 0 }, exit: BlockPos { x: 0, y: 0, z: 0 }, island: none }
        let (gx, gz) = (f64(x), f64(z))
        let length = (gx * gx + 0.0 * 0.0 + gz * gz).sqrt()
        let (dx, dz) = if length < f64(1.0e-5f32) { (0.0, 0.0) } else { (gx / length, gz / length) }
        var px = dx * 1024.0
        var pz = dz * 1024.0
        var back = 16
        loop {
            let c = tentative_chunk(px, pz)
            let top = self.highest_filled(c) else {
                plan.needs.push(c)
                return plan
            }
            if top == -1 or back <= 0 {
                break
            }
            back -= 1
            px = px + dx * -16.0
            pz = pz + dz * -16.0
        }
        var on = 16
        loop {
            let c = tentative_chunk(px, pz)
            let top = self.highest_filled(c) else {
                plan.needs.push(c)
                return plan
            }
            if top != -1 or on <= 0 {
                break
            }
            on -= 1
            px = px + dx * 16.0
            pz = pz + dz * 16.0
        }
        var stone = Set<i64>()
        match self.valid_spawn_in(f, tentative_chunk(px, pz)) {
            some(p) => plan.spawn = p,
            none => {
                let at = BlockPos { x: i32.saturate((px + 0.5).floor()), y: 75, z: i32.saturate((pz + 0.5).floor()) }
                plan.spawn = at
                plan.island = some(at)
                var placed = Placed { at: List<BlockPos>() }
                var rand = LegacyRandom.new(at.pack())
                match place_end_island(f, mut placed, mut rand, at.x, at.y, at.z) {
                    ok(_) => {},
                    err(_) => {},
                }
                for p in placed.at {
                    stone.insert(p.pack())
                    let c = p.chunk()
                    if not self.full(c) and not plan.needs.contains(c) {
                        plan.needs.push(c)
                    }
                }
                if not plan.needs.is_empty() {
                    return plan
                }
            },
        }
        let s = plan.spawn
        self.unfull_in(mut plan.needs, s.x - 16, s.z - 16, s.x + 16, s.z + 16)
        if not plan.needs.is_empty() {
            return plan
        }
        let t = self.tallest_over(s, 16, true, stone)
        plan.exit = BlockPos { x: t.x, y: t.y + 10, z: t.z }
        if not exact {
            let e = plan.exit
            self.unfull_in(mut plan.needs, e.x - 5, e.z - 5, e.x + 5, e.z + 5)
        }
        return plan
    }

    // The chunks of the blocks from x0, z0 to x1, z1 that aren't full, added to `needs` (D595).
    fn unfull_in(self, needs: mut List<ChunkPos>, x0: i32, z0: i32, x1: i32, z1: i32) {
        for cx in (x0 >> 4)..((x1 >> 4) + 1) {
            for cz in (z0 >> 4)..((z1 >> 4) + 1) {
                let c = ChunkPos { x: cx, z: cz }
                if not self.full(c) and not needs.contains(c) {
                    needs.push(c)
                }
            }
        }
    }

    /// The chunks the end gateway at x, y, z would read next as it makes itself an exit, that
    /// aren't full yet, `exit_plan`, where it's one with none in the End; none where it isn't
    /// (D595).
    pub fn exit_needs(self, x: i32, y: i32, z: i32) -> List<ChunkPos>? {
        if not self.the_end {
            return none
        }
        let tags = self.gateway_tag(x, y, z) else return none
        if gateway_exit_of(tags) != none {
            return none
        }
        let some_env = self.env.copy()
        let shared = some_env else return none
        let Env { facts: f, .. } = shared.value
        return some(self.exit_plan(f, x, z, gateway_exact(tags)).needs)
    }

    /// `getPortalPosition`'s making of an exit for the end gateway at x, y, z with none, in the
    /// End (D595): where `exit_plan` reads no chunk that isn't full, the island it found it
    /// needs placed, `EndIslandFeature`; the tallest block about where it's to be found again,
    /// 16 each way, bedrock too, and 10 above it the exit's gateway placed, `spawnGatewayPortal`,
    /// its own exit this one, not exact, `knownExit`; then this one's exit set to that,
    /// `setExitPosition`, as exact as it was. Whether it made one.
    pub fn make_gateway_exit(mut self, x: i32, y: i32, z: i32) -> bool {
        if not self.the_end {
            return false
        }
        let tags = self.gateway_tag(x, y, z) else return false
        if gateway_exit_of(tags) != none {
            return false
        }
        let some_env = self.env.copy()
        let shared = some_env else return false
        let Env { facts: f, .. } = shared.value
        let plan = self.exit_plan(f, x, z, gateway_exact(tags))
        if not plan.needs.is_empty() {
            self.unimplemented(String("An end gateway's exit made where the chunks it reads aren't full"))
            return false
        }
        if let at = plan.island {
            var rand = LegacyRandom.new(at.pack())
            match place_end_island(f, mut self, mut rand, at.x, at.y, at.z) {
                ok(_) => {},
                err(thrown) => self.unimplemented(thrown.message),
            }
        }
        let t = self.tallest_over(plan.spawn, 16, true, Set<i64>())
        let exit = BlockPos { x: t.x, y: t.y + 10, z: t.z }
        match place_end_gateway(f, mut self, known_exit(x, y, z, false), exit.x, exit.y, exit.z) {
            ok(_) => {},
            err(thrown) => self.unimplemented(thrown.message),
        }
        self.set_block_entity_value(x, y, z, "exit_portal", Tag.IntArray([exit.x, exit.y, exit.z]))
        return true
    }

    /// `BlockInput.place`'s block entity (D592): the one at x, y, z, where there's one, loaded
    /// from `tag`, `loadWithComponents`, as `worldgen.block_entities.loaded` has its type read it,
    /// its items with `items`, and its components; where what it saves then isn't what it saved,
    /// `setChanged`, its chunk changed and the comparators by it told, and the block sent again,
    /// `blockChanged`; with `always`, as `data` sets a block entity's data,
    /// `BlockDataAccessor.setData`, all that even where it saves what it did (CAL-165). Whether it
    /// changed; an error where Calcite doesn't load its type or one of its fields yet.
    pub fn load_block_entity_input(mut self, x: i32, y: i32, z: i32, tag: JavaHashMap<String, Tag>, items: Shared<ItemCodecs>?, always: bool) -> bool ! String {
        let some_env = self.env.copy()
        let shared = some_env else return false
        let Env { facts: f, .. } = shared.value
        let k = ChunkPos { x: x >> 4, z: z >> 4 }.pack()
        let pos = BlockPos { x: x, y: y, z: z }
        self.columns.own_block_entities(k)
        if not self.columns.block_entities[k].contains(pos) {
            return false
        }
        let saved = self.columns.block_entities[k][pos].copy()
        let kind = kind_of(saved.copy()) else return false
        let Tag.Compound(before) = saved else return false
        var after = try loaded_block_entity(kind, tag, items)
        var components = JavaHashMap<String, Tag>()
        if tag.contains("components") {
            if let Tag.Compound(m) = tag["components"] {
                components = m.copy()
            }
        }
        after.insert(String("components"), Tag.Compound(components))
        for key in ["id", "x", "y", "z", "keepPacked"] {
            if before.contains(key) {
                after.insert(String(key), before[key].copy())
            }
        }
        let same = Tag.Compound(after.copy()) == Tag.Compound(before.copy())
        if same and not always {
            return false
        }
        self.columns.block_entities[k].insert(pos, Tag.Compound(after))
        self.touched(k)
        let state = self.block_state(x, y, z) ?? f.ids.air_state
        if not f.is_air(state) {
            match update_output_signal(f, mut self, f.block(state), x, y, z) {
                ok => {},
                err(thrown) => self.report(thrown.message),
            }
        }
        self.block_updated(x, y, z)
        return not same
    }

    /// `EndPlatformFeature.createEndPlatform` about x, y, z, which an end portal makes for what it
    /// takes into the End, `dropResources` (D586): of the five by five blocks about it, from the
    /// north-west, by x then by z, a block below obsidian and the three from it up air, each that
    /// isn't that block already, cave air not being air, broken with its drops, `destroyBlock`,
    /// then set, `setBlockAndUpdate`.
    pub fn end_platform(mut self, x: i32, y: i32, z: i32) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let obsidian = f.default_state(f.block_named(String("minecraft:obsidian")) ?? 0)
        let air = f.ids.air_state
        for dz in -2..3 {
            for dx in -2..3 {
                for dy in -1..3 {
                    let (bx, by, bz) = (x + dx, y + dy, z + dz)
                    let want = if dy == -1 { obsidian } else { air }
                    let state = self.block_state(bx, by, bz) ?? AIR_STATE
                    if f.block(state) == f.block(want) {
                        continue
                    }
                    match destroy_block(shared.value, mut self, bx, by, bz, true, none, UPDATE_LIMIT) {
                        ok(_) => {},
                        err(thrown) => self.report(thrown.message),
                    }
                    _ = self.set_block_limited(bx, by, bz, want, 3, UPDATE_LIMIT)
                }
            }
        }
    }

    /// The block at `x`, `y`, `z` the arrow `arrow` struck broken, `destroyBlock(pos, true,
    /// projectile)` (CAL-159): its break shown, what it drops dropped, the arrow what broke it, and
    /// it left as the fluid it held. Whether it broke.
    pub fn break_struck(mut self, x: i32, y: i32, z: i32, arrow: i32) -> bool {
        let shared = self.env.copy() else return false
        match destroy_block(shared.value, mut self, x, y, z, true, some(arrow), UPDATE_LIMIT) {
            ok(broke) => return broke,
            err(thrown) => self.report(thrown.message),
        }
        return false
    }

    /// Powder snow at x, y, z melted by what burnt in it (D698), `destroyBlock(pos, false)`: broken
    /// without its drops, where it's still powder snow.
    pub fn melt(mut self, x: i32, y: i32, z: i32) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let snow = f.block_named(String("minecraft:powder_snow")) else return
        if f.block(self.block_state(x, y, z) ?? 0) != snow {
            return
        }
        match destroy_block(shared.value, mut self, x, y, z, false, none, UPDATE_LIMIT) {
            ok(_) => {},
            err(thrown) => self.report(thrown.message),
        }
    }

    /// `Entity.sendBubbleColumnParticles` at the top of the bubble column at x, y, z (D700): at
    /// each place across `drawn` within its block, on its top, a splash, one unspread at a speed of
    /// 1, then a bubble, one 0.01 up at 0.2, and again.
    pub fn bubble_particles(mut self, x: i32, y: i32, z: i32, drawn: List<(f64, f64)>) {
        var k = 0usize
        for (ax, az) in drawn {
            let (px, py, pz) = (f64(x) + ax, f64(y + 1), f64(z) + az)
            if k % 2 == 0 {
                self.named_particles(String("splash"), px, py, pz, 1, 0.0, 0.0, 0.0, 1.0)
            } else {
                self.named_particles(String("bubble"), px, py, pz, 1, 0.0, 0.01, 0.0, 0.2)
            }
            k += 1
        }
    }

    /// `sendBubbleColumnParticles` at the top of the bubble column at x, y, z, its places across
    /// drawn from the level's own random now, as a player's push draws them (D700).
    pub fn bubbles(mut self, x: i32, y: i32, z: i32) {
        var drawn = List<(f64, f64)>()
        for _ in 0..4 {
            let ax = self.next_double()
            let az = self.next_double()
            drawn.push((ax, az))
        }
        self.bubble_particles(x, y, z, drawn)
    }

    /// `PowderSnowBlock.entityInside`'s snowflake at x, y, z (D698): one, unspread, moving `sx`
    /// across x, 0.05 up and `sz` across z, `RandomizationType.ALTERNATIVE`.
    pub fn snowflake(mut self, x: f64, y: f64, z: f64, sx: f32, sz: f32) {
        self.events.push(Heard.Particles(LevelParticles { particle: String("minecraft:snowflake"), x: x, y: y, z: z, count: 1, dx: 0.0f32, dy: 0.0f32, dz: 0.0f32, speed: 0.0f32, speeds: some((sx, 0.05f32, sz)), randomization: 1 }))
    }

    /// What a sheep's eating does where mob griefing lets it, `EatBlockGoal.tick`'s (CAL-158): what
    /// it stood in broken without its drops, `destroyBlock`; or the grass block below it turned to
    /// dirt, its break shown first, level event 2001 of grass's state, set with flags 2.
    pub fn graze(mut self, g: Grazed) {
        let shared = self.env.copy() else return
        if g.whole {
            match destroy_block(shared.value, mut self, g.x, g.y, g.z, false, none, UPDATE_LIMIT) {
                ok(_) => {},
                err(thrown) => self.report(thrown.message),
            }
            return
        }
        let Env { facts: f, .. } = shared.value
        let grass = f.block_named(String("minecraft:grass_block")) else return
        let dirt = f.block_named(String("minecraft:dirt")) else return
        self.level_event(BLOCK_BROKEN, g.x, g.y, g.z, i32.wrap(f.default_state(grass)))
        _ = self.set_block_limited(g.x, g.y, g.z, f.default_state(dirt), UPDATE_CLIENTS, UPDATE_LIMIT)
    }

    /// A rabbit's raid of the carrots at x, y, z, `RaidGardenGoal.tick` (CAL-201), where they're
    /// carrots still: at age 0 taken away, `setBlock` to air without updates, as its
    /// `destroyBlock` after finds nothing; else a year younger, without updates, and their breaking
    /// shown as they were, level event 2001.
    pub fn raid_carrot(mut self, x: i32, y: i32, z: i32) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        if not f.is_a(f.block(state), "CarrotBlock") {
            return
        }
        let age = f.get_int(state, String("age")) ?? 0
        if age == 0 {
            let air = f.block_named(String("minecraft:air")) else return
            _ = self.set_block_limited(x, y, z, f.default_state(air), UPDATE_CLIENTS, UPDATE_LIMIT)
            return
        }
        let younger = match f.with_int(state, String("age"), age - 1) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        _ = self.set_block_limited(x, y, z, younger, UPDATE_CLIENTS, UPDATE_LIMIT)
        self.level_event(BLOCK_BROKEN, x, y, z, i32.wrap(state))
    }

    /// A villager's harvest of the crop at x, y, z, the villager of the entity ID `breaker`'s,
    /// `HarvestFarmland.tick` (CAL-160): broken with what it drops, `destroyBlock`, its drops
    /// popped from the level's random and their loot from the table's sequence.
    pub fn harvest(mut self, x: i32, y: i32, z: i32, breaker: i32) {
        let shared = self.env.copy() else return
        match destroy_block(shared.value, mut self, x, y, z, true, some(breaker), UPDATE_LIMIT) {
            ok(_) => {},
            err(thrown) => self.report(thrown.message),
        }
    }

    /// Farmland at x, y, z trampled back to dirt, `FarmlandBlock.turnToBaseBlock`'s
    /// `setBlockAndUpdate` (CAL-160), where it's farmland still: what grew on it, which can't
    /// stand on dirt, breaks as its shape's updated, with its drops.
    pub fn turn_to_dirt(mut self, x: i32, y: i32, z: i32) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        if not f.is_a(f.block(state), "FarmlandBlock") {
            return
        }
        _ = self.set_block_limited(x, y, z, f.default_state(f.ids.dirt), 3, UPDATE_LIMIT)
    }

    /// A villager's crop at x, y, z, of the state `state`, set with `flags`: its seed planted, set
    /// and updated, `setBlockAndUpdate`, 3, or a crop grown by its bone meal, 2 (CAL-160).
    pub fn set_crop(mut self, x: i32, y: i32, z: i32, state: u32, flags: i32) {
        _ = self.set_block_limited(x, y, z, state, flags, UPDATE_LIMIT)
    }

    /// A bee gone into the hive at x, y, z with its tag `bee` as it saved, `addOccupant`
    /// (CAL-177); one the hive has no room for, which its goal doesn't start for, is reported.
    pub fn add_bee(mut self, x: i32, y: i32, z: i32, bee: own Tag) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let Tag.Compound(tags) = bee else return
        match add_occupant(f, mut self, x, y, z, tags) {
            ok(went) => {
                if not went {
                    self.report(String("A bee going into a full hive"))
                }
            },
            err(thrown) => self.report(thrown.message),
        }
    }

    /// The block at x, y, z, a host or an infested block, made the other by `infested` and
    /// updated, `setBlockAndUpdate` (CAL-172): a host made infested, `into`, as a silverfish goes
    /// into it, and an infested block made its host again, as one woken where mob griefing's off
    /// is; nothing where it isn't one still.
    pub fn infest(mut self, x: i32, y: i32, z: i32, infested: Infested, into: bool) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        let to = if into { infested.infested_of(f, state) } else { infested.host_of(f, state) }
        let changed = to else return
        _ = self.set_block_limited(x, y, z, changed, 3, UPDATE_LIMIT)
    }

    /// The biome at the block x, y, z, by its ID, as `getNoiseBiomeAtPosition` gives it, that of
    /// its quart, unzoomed; -1 where its chunk isn't loaded (D574).
    pub fn noise_biome_at(self, x: i32, y: i32, z: i32) -> i32 {
        return self.noise_biome(x >> 2, y >> 2, z >> 2)
    }

    /// The biome at the block x, y, z, `getBiome`, as `BiomeManager` zooms the quarts (CAL-165).
    pub fn block_biome(self, x: i32, y: i32, z: i32) -> i32 {
        return self.biome_at(x, y, z)
    }

    /// A bed at x, y, z a mob lay down in, `occupied`, or got up from, where it's a bed still, set
    /// and updated, `setBlockAndUpdate`, its other half following as its shape updates (CAL-160).
    pub fn set_bed(mut self, x: i32, y: i32, z: i32, occupied: bool) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        if not f.is_a(f.block(state), "AbstractBedBlock") {
            return
        }
        match f.with_bool(state, "occupied", occupied) {
            ok(now) => {
                _ = self.set_block_limited(x, y, z, now, 3, UPDATE_LIMIT)
            },
            err(thrown) => self.report(thrown.message),
        }
    }

    /// The block at x, y, z an end crystal's in, in a level with a dragon fight, set alight where
    /// it's air, `setBlockAndUpdate(BaseFireBlock.getState)`, as `EndCrystal.tick` does (D589).
    pub fn kindle(mut self, x: i32, y: i32, z: i32) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let was = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        if not f.is_air(was) {
            return
        }
        match fire_state(f, self, x, y, z) {
            ok(fire) => {
                _ = self.set_block_limited(x, y, z, fire, 3, UPDATE_LIMIT)
            },
            err(thrown) => self.report(thrown.message),
        }
    }

    /// Fire set at x, y, z by a lightning bolt, as `LightningBolt.spawnFire` sets it (CAL-326):
    /// where the block's air and the fire it would be, `BaseFireBlock.getState`, can stay there,
    /// `canSurvive`, `setBlockAndUpdate`. Whether it was set.
    pub fn strike_fire(mut self, x: i32, y: i32, z: i32) -> bool {
        let shared = self.env.copy() else return false
        let e = shared.value.copy()
        let f = e.facts.copy()
        let was = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return false
            },
        }
        if not f.is_air(was) {
            return false
        }
        let fire = match fire_state(f, self, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return false
            },
        }
        match can_survive(e, self, fire, x, y, z) {
            ok(stays) => {
                if not stays {
                    return false
                }
            },
            err(thrown) => {
                self.report(thrown.message)
                return false
            },
        }
        _ = self.set_block_limited(x, y, z, fire, 3, UPDATE_LIMIT)
        return true
    }

    /// `ServerLevel.canSpreadFireAround` at x, y, z (CAL-326).
    pub fn fire_spreads_at(self, x: i32, y: i32, z: i32) -> bool {
        return self.place.fire_spreads(x, y, z)
    }

    /// `LightningBolt.powerLightningRod` at x, y, z, the block under a bolt (CAL-326): a lightning
    /// rod there struck, `onLightningStrike`, and level event 3002 at it with its axis.
    pub fn strike_rod(mut self, x: i32, y: i32, z: i32) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        if not f.is_a(f.block(state), String("LightningRodBlock")) {
            return
        }
        match rod_struck(f, mut self, state, x, y, z) {
            ok(axis) => self.level_event(3002, x, y, z, axis),
            err(thrown) => self.report(thrown.message),
        }
    }

    /// `LightningBolt.clearCopperOnLightningStrike` at x, y, z, the block under a bolt (CAL-326):
    /// copper there that weathers made unaffected, `getFirst`; then, where it weathers or is waxed,
    /// 3 to 5 walks from it, each of 1 to 8 steps, drawn from the level's random,
    /// `randomWalkCleaningCopper`, each step to the first copper that weathers of 10 blocks drawn
    /// in the cube about where the walk's got to, a stage back where it can be, `getPrevious`, with
    /// level event 3002 at it; a walk stops where a step finds none.
    pub fn scrape_copper(mut self, x: i32, y: i32, z: i32) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let struck = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        let is_waxed = waxed(f, f.block(struck))
        let is_weathering = weathers(f, f.block(struck))
        if not is_weathering and not is_waxed {
            return
        }
        if is_weathering {
            _ = self.set_block_limited(x, y, z, copper_first(f, struck), 3, UPDATE_LIMIT)
        }
        let strikes = self.next_int_below(3) + 3
        for _ in 0..strikes {
            let steps = self.next_int_below(8) + 1
            var wx = x
            var wy = y
            var wz = z
            for _ in 0..steps {
                let (sx, sy, sz) = self.copper_step(f, wx, wy, wz) else break
                wx = sx
                wy = sy
                wz = sz
            }
        }
    }

    // `randomStepCleaningCopper` from x, y, z (CAL-326): of 10 blocks drawn in the cube about it,
    // `BlockPos.randomInCube`, x, then y, then z, the first copper that weathers, a stage back
    // where it can be, with level event 3002 at it, and where it is; none where none weathers.
    fn copper_step(mut self, f: Facts, x: i32, y: i32, z: i32) -> (i32, i32, i32)? {
        for _ in 0..10 {
            let cx = x - 1 + self.next_int_below(3)
            let cy = y - 1 + self.next_int_below(3)
            let cz = z - 1 + self.next_int_below(3)
            let state = match self.state(f, cx, cy, cz) {
                ok(s) => s,
                err(thrown) => {
                    self.report(thrown.message)
                    return none
                },
            }
            if weathers(f, f.block(state)) {
                if let back = copper_previous(f, state) {
                    _ = self.set_block_limited(cx, cy, cz, back, 3, UPDATE_LIMIT)
                }
                self.level_event(3002, cx, cy, cz, -1)
                return some((cx, cy, cz))
            }
        }
        return none
    }

    /// A villager's composter at x, y, z set to `state`, `setBlockAndUpdate`, and ticked 20 on
    /// where `ticked`, as a layer filled it to 7, `ComposterBlock.addLayer` (CAL-160).
    pub fn compost(mut self, x: i32, y: i32, z: i32, state: u32, ticked: bool) {
        _ = self.set_block_limited(x, y, z, state, 3, UPDATE_LIMIT)
        if ticked {
            let shared = self.env.copy() else return
            let Env { facts: f, .. } = shared.value
            self.schedule_block_tick(f.block(state), x, y, z, 20, 0)
        }
    }

    /// A fox's berries picked at x, y, z, `FoxEatBerriesGoal.onReachedTarget` (CAL-201): from a
    /// sweet berry bush, so many sweet berries popped out where there are any, `popResource`, and
    /// the bush aged 1 with flags 2, `pickSweetBerries`, the fox playing the sound; or, the count
    /// -1, cave vines' glow berries, `CaveVines.use`: where they have them, one popped out, the
    /// sound of their pick at a pitch drawn between 0.8 and 1.2, `randomBetween`, and none left,
    /// with flags 2. Its game event comes with game events.
    pub fn fox_berries(mut self, x: i32, y: i32, z: i32, count: i32) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        if count >= 0 {
            if not f.is_a(f.block(state), "SweetBerryBushBlock") {
                return
            }
            if count > 0 {
                var stack = JavaHashMap<String, Tag>()
                stack.insert(String("id"), Tag.Str(String("minecraft:sweet_berries")))
                stack.insert(String("count"), Tag.Int(count))
                pop_resource(mut self, x, y, z, some(Tag.Compound(stack)))
            }
            match f.with_int(state, String("age"), 1) {
                ok(picked) => {
                    _ = self.set_block_limited(x, y, z, picked, 2, UPDATE_LIMIT)
                },
                err(thrown) => self.report(thrown.message),
            }
            return
        }
        if not f.get_bool(state, "berries") {
            return
        }
        var stack = JavaHashMap<String, Tag>()
        stack.insert(String("id"), Tag.Str(String("minecraft:glow_berries")))
        stack.insert(String("count"), Tag.Int(1))
        pop_resource(mut self, x, y, z, some(Tag.Compound(stack)))
        let pitch = self.next_float() * (1.2f32 - 0.8f32) + 0.8f32
        self.play_sound(x, y, z, String("block.cave_vines.pick_berries"), 1.0f32, pitch)
        match f.with_bool(state, String("berries"), false) {
            ok(picked) => {
                _ = self.set_block_limited(x, y, z, picked, 2, UPDATE_LIMIT)
            },
            err(thrown) => self.report(thrown.message),
        }
    }

    /// The rest of a player's picking of the berries at x, y, z, once they've dropped (CAL-310):
    /// a sweet berry bush's, `sweet`, its sound at a pitch of 0.8 + `nextFloat` × 0.4, then age 1;
    /// cave vines', theirs at `randomBetween(0.8, 1.2)`, then no berries; each set with flags 2.
    pub fn picked_berries(mut self, x: i32, y: i32, z: i32, sweet: bool) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        var picked = state
        if sweet {
            let pitch = 0.8f32 + self.next_float() * 0.4f32
            self.play_sound(x, y, z, String("block.sweet_berry_bush.pick_berries"), 1.0f32, pitch)
            match f.with_int(state, String("age"), 1) {
                ok(s) => picked = s,
                err(thrown) => self.report(thrown.message),
            }
        } else {
            let pitch = self.next_float() * (1.2f32 - 0.8f32) + 0.8f32
            self.play_sound(x, y, z, String("block.cave_vines.pick_berries"), 1.0f32, pitch)
            match f.with_bool(state, String("berries"), false) {
                ok(s) => picked = s,
                err(thrown) => self.report(thrown.message),
            }
        }
        if picked != state {
            _ = self.set_block_limited(x, y, z, picked, 2, UPDATE_LIMIT)
        }
    }

    /// A villager's door at x, y, z opened or shut, `open`, `DoorBlock.setOpen` (CAL-160): where
    /// it's still a door that isn't so, set with flags 10, its other half following as its shape
    /// updates, as a player's use sets it; the villager plays its sound. Its game event comes with
    /// game events.
    pub fn swing_door(mut self, x: i32, y: i32, z: i32, open: bool) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        if not f.is_a(f.block(state), "DoorBlock") or f.get_bool(state, "open") == open {
            return
        }
        match f.with_bool(state, "open", open) {
            ok(swung) => {
                _ = self.set_block_limited(x, y, z, swung, 10, UPDATE_LIMIT)
            },
            err(thrown) => self.report(thrown.message),
        }
    }

    /// An enderman's take of the block at x, y, z, `EndermanTakeBlockGoal.tick` (CAL-159): the
    /// block removed, `removeBlock(pos, false)`, its game event coming with what hears it; and the
    /// default state of its block, which the enderman then carries, or none where it couldn't.
    pub fn take_block(mut self, x: i32, y: i32, z: i32) -> u32? {
        let shared = self.env.copy() else return none
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return none
            },
        }
        match remove_block(f, mut self, x, y, z) {
            ok(_) => {},
            err(thrown) => {
                self.report(thrown.message)
                return none
            },
        }
        return some(f.default_state(f.block(state)))
    }

    /// An ender dragon's `checkWalls` on the blocks from x0, y0, z0 to x1, y1, z1, in x, then y,
    /// then z (D614): each as the level has it as it's reached, that isn't air or `transparent`,
    /// `#dragon_transparent`, broken where `griefing` and it isn't `immune`, `#dragon_immune`,
    /// `removeBlock`, else a wall. Whether one was a wall, and whether one was broken, which only a
    /// block that changes is, not a fluid's own. A block whose chunk isn't loaded is reported.
    pub fn dragon_wall(mut self, x0: i32, y0: i32, z0: i32, x1: i32, y1: i32, z1: i32, griefing: bool, transparent: BlockSet, immune: BlockSet) -> (bool, bool) {
        let shared = self.env.copy() else return (false, false)
        let Env { facts: f, .. } = shared.value
        var hit = false
        var destroyed = false
        for x in x0..=x1 {
            for y in y0..=y1 {
                for z in z0..=z1 {
                    let state = match self.state(f, x, y, z) {
                        ok(s) => s,
                        err(thrown) => {
                            self.report(thrown.message)
                            continue
                        },
                    }
                    if f.is_air(state) or f.in_set(state, transparent) {
                        continue
                    }
                    if griefing and not f.in_set(state, immune) {
                        match remove_block(f, mut self, x, y, z) {
                            ok(changed) => {
                                if changed {
                                    destroyed = true
                                }
                            },
                            err(thrown) => self.report(thrown.message),
                        }
                    } else {
                        hit = true
                    }
                }
            }
        }
        return (hit, destroyed)
    }

    /// An enderman's leave of `carried` at x, y, z, `EndermanLeaveBlockGoal.tick` (CAL-159): the
    /// state made again from its neighbours' shapes there, `updateFromNeighbourShapes`, and
    /// placed, `setBlockAndUpdate`, where the block there is air, the one below isn't air or
    /// bedrock and its collision shape is a whole block, the state can stay there, `canSurvive`,
    /// and `clear`, no entity's box meeting the block's; its game event comes with what hears it.
    /// Whether it was placed, which leaves the enderman carrying nothing.
    pub fn leave_block(mut self, carried: u32, x: i32, y: i32, z: i32, clear: bool) -> bool {
        let shared = self.env.copy() else return false
        let Env { facts: f, .. } = shared.value
        let bedrock = f.block_named(String("minecraft:bedrock")) else return false
        let (here, below) = match self.state(f, x, y, z) {
            ok(s) => match self.state(f, x, y - 1, z) {
                ok(b) => (s, b),
                err(thrown) => {
                    self.report(thrown.message)
                    return false
                },
            },
            err(thrown) => {
                self.report(thrown.message)
                return false
            },
        }
        let placed = match update_from_neighbours(shared.value, mut self, carried, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return false
            },
        }
        if not f.is_air(here) or f.is_air(below) or f.block(below) == bedrock or not f.collision_full_block(below) {
            return false
        }
        let survives = match can_survive(shared.value, self, placed, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return false
            },
        }
        if not survives or not clear {
            return false
        }
        _ = self.set_block(x, y, z, placed, UPDATE_NEIGHBORS | UPDATE_CLIENTS)
        return true
    }

    /// A snow golem's trail, `SnowGolem.aiStep` (CAL-201), where mob griefing lets it: at each
    /// of `spots` in turn, where the block's air and snow would survive there, `canSurvive`, a
    /// layer of snow set and updated, `setBlockAndUpdate`. Its place's game event nothing in
    /// Calcite hears.
    pub fn snow_trail(mut self, spots: List<(i32, i32, i32)>) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let snow = f.block_named(String("minecraft:snow")) else return
        let layer = f.default_state(snow)
        for (x, y, z) in spots {
            let here = match self.state(f, x, y, z) {
                ok(s) => s,
                err(thrown) => {
                    self.report(thrown.message)
                    return
                },
            }
            if not f.is_air(here) {
                continue
            }
            let survives = match can_survive(shared.value, self, layer, x, y, z) {
                ok(s) => s,
                err(thrown) => {
                    self.report(thrown.message)
                    return
                },
            }
            if survives {
                _ = self.set_block_limited(x, y, z, layer, 3, UPDATE_LIMIT)
            }
        }
    }

    /// What the block `carried` drops as the enderman carrying it dies at x, y, z,
    /// `Enderman.dropCustomDeathLoot` (CAL-159): its loot table rolled with `ORIGIN` there, the
    /// enderman as `THIS_ENTITY` and a diamond axe as `TOOL`, enchanted by the world's provider
    /// `enderman_loot_drop`, vanilla's silk touch I, which draws nothing (CAL-217). One that draws
    /// is drawn from the level's random, not the enderman's, at no local difficulty, and said to
    /// be missing.
    pub fn carried_drops(mut self, carried: u32, x: f64, y: f64, z: f64) -> List<Tag> {
        var out = List<Tag>()
        let shared = self.env.copy() else return out
        let Env { facts: f, .. } = shared.value
        var plain = JavaHashMap<String, Tag>()
        plain.insert(String("id"), Tag.Str(String("minecraft:diamond_axe")))
        plain.insert(String("count"), Tag.Int(1))
        var axe = Tag.Compound(plain)
        if let loot = self.world_loot() {
            if provider_draws(loot.value, "minecraft:enderman_loot_drop") {
                self.unimplemented(String("An enderman_loot_drop provider that draws, from the enderman's random at its local difficulty"))
            }
            var random = self.lend_level_random()
            axe = provider_enchanted(loot.value, mut random, axe, "minecraft:enderman_loot_drop", 0.0f32)
            self.give_back_level_random(random)
        }
        for s in get_drops_at(f, mut self, carried, (x, y, z), none, true, some(axe)) {
            if let stack = s {
                out.push(stack.copy())
            }
        }
        return out
    }

    /// `TurtleEggBlock.destroyEgg` of what fell or stepped on `x`, `y`, `z`, which may break turtle
    /// eggs, `canDestroyEgg`, 1 in `randomness` (CAL-172): where it's a turtle egg, a draw from the
    /// random, and where that's 0, one fewer, `decrease_eggs`, its break pitched 0.9 and a fifth
    /// of a draw.
    pub fn destroy_egg(mut self, x: i32, y: i32, z: i32, randomness: i32) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        if not f.is_a(f.block(state), String("TurtleEggBlock")) or self.next_int_below(randomness) != 0 {
            return
        }
        let pitch = 0.9f32 + self.next_float() * 0.2f32
        match decrease_eggs(shared.value, mut self, state, x, y, z, pitch) {
            ok => {},
            err(thrown) => self.report(thrown.message),
        }
    }

    /// `LayeredCauldronBlock.handleEntityOnFireInside` of the cauldron at `x`, `y`, `z` something
    /// burnt in (CAL-172): where it's a water or powder snow cauldron still, a powder snow one
    /// taken as water as full, then a level less, `lowerFillLevel`, none an empty cauldron, set and
    /// updated. Its game event comes with what hears it.
    pub fn lower_cauldron(mut self, x: i32, y: i32, z: i32) {
        let shared = self.env.copy() else return
        let Env { facts: f, .. } = shared.value
        let state = match self.state(f, x, y, z) {
            ok(s) => s,
            err(thrown) => {
                self.report(thrown.message)
                return
            },
        }
        let block = f.block(state)
        if not f.is_a(block, String("LayeredCauldronBlock")) {
            return
        }
        let level = f.get_int(state, String("level")) ?? 1
        let lower = if level - 1 <= 0 {
            f.block_named(String("minecraft:cauldron"))
        } else if f.codec.blocks.name(block) == "minecraft:powder_snow_cauldron" {
            f.block_named(String("minecraft:water_cauldron"))
        } else {
            some(block)
        }
        let to = lower else return
        var new = f.default_state(to)
        if level - 1 > 0 {
            new = match f.with_int(new, String("level"), level - 1) {
                ok(s) => s,
                err(thrown) => {
                    self.report(thrown.message)
                    return
                },
            }
        }
        _ = self.set_block_limited(x, y, z, new, 3, UPDATE_LIMIT)
    }

    /// Redstone ore at `x`, `y`, `z` stepped on, `RedStoneOreBlock.stepOn` (D431): where it's still
    /// ore, `interact_ore`, its particles' draws and its lighting.
    pub fn light_ore(mut self, x: i32, y: i32, z: i32) {
