    /// Whether the level has `set_env`'s.
    pub fn has_env(self) -> bool {
        return match self.env {
            some(_) => true,
            none => false,
        }
    }

    /// The items and orbs dropped since this was last asked, in the order they were popped
    /// (CAL-153, CAL-154).
    pub fn take_dropped(mut self) -> List<Dropped> {
        let out = self.dropped.copy()
        self.dropped.clear()
        self.dropped_heard.clear()
        return out
    }

    /// `take_dropped`, with how much of what's heard, as `take_heard` would take it now, each
    /// came after (CAL-167).
    pub fn take_dropped_heard(mut self) -> (List<Dropped>, List<usize>) {
        let before = self.dropped_heard.copy()
        return (self.take_dropped(), before)
    }

    /// What `take_heard` took and wasn't sent, put back before what's been heard since (CAL-167).
    pub fn hear_first(mut self, heard: own List<Heard>) {
        if heard.is_empty() {
            return
        }
        let n = heard.len()
        var all = heard
        all.extend(self.events.copy())
        self.events = all
        for i in 0..self.dropped_heard.len() {
            self.dropped_heard[i] += n
        }
    }

    /// The level events since this was last asked, in the order they came (D326), with what else
    /// the players heard since let go.
    pub fn take_events(mut self) -> List<LevelEvent> {
        var out = List<LevelEvent>()
        for h in self.events {
            match h {
                Heard.Event(e) => out.push(e),
                _ => {},
            }
        }
        self.events.clear()
        self.heard_taken()
        return out
    }

    // What's heard taken: each drop waiting comes after none of what's heard from now.
    fn heard_taken(mut self) {
        for i in 0..self.dropped_heard.len() {
            self.dropped_heard[i] = 0
        }
    }

    /// `playSeededSound(null, x, y, z, ...)` at an entity, such as a player: the sound `sound`,
    /// among `SoundSource`'s `source`, at a volume and pitch of 1, with a seed of its own, as the
    /// entity draws one from its own random, which nothing else reads (D372).
    pub fn play_entity_sound(mut self, sound: own String, x: f64, y: f64, z: f64, source: i32) {
        self.sound_seeds += -7046029254386353131
        let seed = mix_stafford13(self.sound_seeds)
        self.events.push(Heard.Sound(LevelSound { sound: sound, x: x, y: y, z: z, volume: 1.0f32, pitch: 1.0f32, seed: seed, source: source }))
    }

    /// `levelEvent` of the kind `kind` at the block x, y, z with `data`, as a mob shows it
    /// (CAL-159).
    pub fn mob_level_event(mut self, kind: i32, x: i32, y: i32, z: i32, data: i32) {
        self.level_event(kind, x, y, z, data)
    }

    /// A level event for every player a mob's tick asked for, `globalLevelEvent`, as an ender
    /// dragon's death has it (D608).
    pub fn mob_global_event(mut self, kind: i32, x: i32, y: i32, z: i32, data: i32) {
        self.global_level_event(kind, x, y, z, data)
    }

    /// The dust a living entity throws up landing on `state`, as `checkFallDamage` sends it,
