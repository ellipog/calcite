        self.events.push(Heard.Particles(LevelParticles { particle: particle, x: x, y: y, z: z, count: count, dx: f32.nearest(dx), dy: f32.nearest(dy), dz: f32.nearest(dz), speed: f32.nearest(speed) }))
    }

    /// A shulker's bullet's burst on a block (CAL-200): 2 explosion particles where it is, 0.2
    /// about, `ShulkerBullet.onHitBlock`'s `sendParticles`.
    pub fn bullet_burst(mut self, x: f64, y: f64, z: f64) {
        self.events.push(Heard.Particles(LevelParticles { particle: String("minecraft:explosion"), x: x, y: y, z: z, count: 2, dx: 0.2f32, dy: 0.2f32, dz: 0.2f32, speed: 0.0f32 }))
    }

    /// `ServerLevel.sendParticles` of `count` item particles, `ParticleTypes.ITEM`, of the item of
    /// the ID `item`, one of it with no components, `ItemStackTemplate`, at x, y, z, spread so far
    /// each way, at `speed`, as wolf armor's cracks send them (CAL-201).
    pub fn item_particles(mut self, item: i32, x: f64, y: f64, z: f64, count: i32, dx: f64, dy: f64, dz: f64, speed: f64) {
        var w = Writer.new()
        w.varint(item)
        w.varint(1)
        w.varint(0)
        w.varint(0)
        self.events.push(Heard.Particles(LevelParticles { particle: String("minecraft:item"), x: x, y: y, z: z, count: count, dx: f32.nearest(dx), dy: f32.nearest(dy), dz: f32.nearest(dz), speed: f32.nearest(speed), option: some(w.into_bytes()) }))
    }

    /// `ServerLevel.sendParticles` of `count` of the particle named `particle`, one without
    /// options, at x, y, z, spread or moving so far each way, at `speed`, as an enchantment's
    /// effect sends them (D525).
    pub fn named_particles(mut self, particle: own String, x: f64, y: f64, z: f64, count: i32, dx: f64, dy: f64, dz: f64, speed: f64) {
        self.events.push(Heard.Particles(LevelParticles { particle: particle, x: x, y: y, z: z, count: count, dx: f32.nearest(dx), dy: f32.nearest(dy), dz: f32.nearest(dz), speed: f32.nearest(speed) }))
    }

    /// `playSound` with no player of `sound` at x, y, z from `source`, at `volume` and `pitch`,
    /// as an entity's own sound plays it (CAL-148).
    pub fn play_sound_from_source(mut self, sound: own String, x: f64, y: f64, z: f64, source: i32, volume: f32, pitch: f32) {
