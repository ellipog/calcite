/// How far around the spawn chunk a joining player's spawn ticket loads full chunks,
/// `PrepareSpawnTask.PREPARE_CHUNK_RADIUS`.
pub const SPAWN_RADIUS: i32 = 3
/// The most far chunks being read for a player at once.
pub const MOST_FAR_LOADS: i32 = 64
/// The most chunks the player tickets load at once, where vanilla's dispatcher lets 4 through, each
/// until its chunk ticks its entities (D234). With 4, a new world's view-32 join kept the
/// generator's 31 workers about 45% busy, with no job ready to give them most of the time, and
/// took 4.9 s; with 256, it takes 3.3 s, and the client takes chunks as fast as it will, 64 a
/// tick. With more, the chunks far out are asked for so early that the near ones wait for them.
pub const PLAYER_LOADS: usize = 256
// The level of a full chunk, at and below which a holder's chunk is loaded.
const FULL: i32 = 33
// The level at and below which a chunk ticks, so it can be sent.
const TICKING: i32 = 32
// The level at and below which a holder of a world that reads loads its chunk, for light, that
// of `initialize_light`.
const LIGHT_BORDER: i32 = 34
// The most block or fluid ticks a level runs in a tick, as `ServerLevel.tick` has its
// `LevelTicks` run.
const MOST_TICKS: usize = 65536
// The most chunks changed in play saved in a tick, `CHUNK_SAVED_EAGERLY_PER_TICK`, and how long
// after one's saved it may be again, in milliseconds, `EAGER_CHUNK_SAVE_COOLDOWN_IN_MILLIS`
// (CAL-145).
const EAGER_SAVES: usize = 20
const EAGER_COOLDOWN_MS: i64 = 10000

// A chunk the world has, or is reading.
enum Body {
    // Being read.
    Loading
    // Generated flat: every flat chunk is the flat world's.
    Flat
    // As it was saved. A holder's gives its light and its sky's sources to light as it comes; a
    // far chunk keeps its own.
    Saved(SavedChunk)
}

// Each holder's chunk, by its packed position, once it's there, and the flat chunk each flat one
// is. A chunk held whole has its rest kept with the others' in `rests`, not in its body, from
// when it's put in until it's taken out (D289). A chunk whose blocks have been set since it came
// is its own copy in `live`, made from the one it came as, shared or flat, as a block was first
// set, which what reads it reads first; it's taken out as it is now (D321). A chunk whose block
// entities a block set has changed since it came has its map of them in `block_entities`, in
// place of those its rest saved, which they go back into as it's taken out (CAL-115). A flat
// chunk with blocks set in it is taken out whole, with a rest of its own, of `sections`, to be
// saved (CAL-145).
struct Columns {
    slots: OpenHashMap<i64, Body> = OpenHashMap<i64, Body>()
    sections: usize = 0
    flat: FlatChunk? = none
    rests: RestStore = RestStore()
    live: OpenHashMap<i64, Chunk> = OpenHashMap<i64, Chunk>()
    // A chunk nothing reads, one for the level, which a saved body whose own copy is in `live`
    // holds in place of the shared one it came as (D330).
    stand_in: Shared<Chunk>? = none
    block_entities: Map<i64, OpenHashMap<BlockPos, Tag>> = Map<i64, OpenHashMap<BlockPos, Tag>>()
}

impl Columns {
    // The chunk at `k` has its own copy in `live`, which what reads the chunk reads first and
    // which is taken out in its place: the shared one it came as is let go for `stand_in`, so
    // the level doesn't hold both (D330). Light's own share goes as it's told of the block set.
    fn let_go_shared(mut self, k: i64) {
        let stand_in = self.stand_in.copy() else return
        let gone = self.slots.remove(k) else return
        match gone {
            Body.Saved(s) => {
                var saved = s
                saved.chunk = stand_in
                self.slots.insert(k, Body.Saved(saved))
            },
            Body.Loading => self.slots.insert(k, Body.Loading),
            Body.Flat => self.slots.insert(k, Body.Flat),
        }
    }

    // Puts in the body of the column at `k`, its rest in with the others.
    fn put(mut self, k: i64, given: own Body) {
        _ = self.live.remove(k)
        _ = self.block_entities.remove(k)
        match given {
            Body.Saved(s) => {
                var saved = s
                if let r = saved.rest.take() {
                    self.rests.put(k, r)
                } else {
                    _ = self.rests.take(k)
                }
                self.slots.insert(k, Body.Saved(saved))
            },
            Body.Loading => {
                _ = self.rests.take(k)
                self.slots.insert(k, Body.Loading)
            },
            Body.Flat => {
                _ = self.rests.take(k)
                self.slots.insert(k, Body.Flat)
            },
        }
    }

    // Takes out the body of the column at `k`, if it has one, with its rest back in it, with the
    // block entities it has now where a block set changed them.
    fn take(mut self, k: i64) -> Body? {
        let gone = self.slots.remove(k) else return none
        let rest = self.rests.take(k)
        let changed = self.live.remove(k)
        let entities = self.block_entities.remove(k)
        match gone {
            Body.Saved(s) => {
                var saved = s
                if let r = rest {
                    if let m = entities {
                        saved.rest = some(r.with_block_entities(saved_block_entities(m)))
                    } else {
                        saved.rest = some(r)
                    }
                }
                if let c = changed {
                    saved.chunk = c.into_shared()
                }
                return some(Body.Saved(saved))
            },
            Body.Loading => return some(Body.Loading),
            Body.Flat => {
                // A flat chunk with blocks set in it is all there is of it, saved as it is now,
                // with the block entities it has, as vanilla saves every chunk it made (CAL-145).
                let c = changed else return some(Body.Flat)
                var r = rest ?? PackedRest.of(ChunkRest.empty(self.sections))
                if let m = entities {
                    r = r.with_block_entities(saved_block_entities(m))
                }
                return some(Body.Saved(SavedChunk { chunk: c.into_shared(), sources: none, sky: [], block: [], lighted: false, whole: true, rest: some(r) }))
            },
        }
    }

    // The chunk at `k`'s map of its block entities: its own where a block set changed them, else
    // made from those its rest saved.
    fn block_entities_of(self, k: i64) -> OpenHashMap<BlockPos, Tag> {
        if self.block_entities.contains(k) {
            return self.block_entities[k].copy()
        }
        return block_entity_map(self.rests.block_entities(k))
    }

    // Makes the chunk at `k`'s map of its block entities its own, from those its rest saved, if it
    // isn't yet, for a block set to change.
    fn own_block_entities(mut self, k: i64) {
        if not self.block_entities.contains(k) {
            self.block_entities.insert(k, block_entity_map(self.rests.block_entities(k)))
        }
    }
}

/// A chunk's packet, as the level gives it to send.
pub enum ChunkPacket {
    /// Its ID and fields.
    Plain(List<u8>)
    /// Its ID and fields, kept for another player. Once compressed, its frame's body is to come
    /// back with `key` and `version`, to `Level.compressed`.
    Shared { packet: List<u8>, key: i64, version: u64 }
    /// Its frame's body, compressed with `threshold` for a player before, and its ID and fields if
    /// they're kept, for a link that checks what's sent.
    Compressed { body: List<u8>, threshold: i32, packet: List<u8>? }
}

// A chunk's packet kept for players still to be sent it: its ID and fields until it's
// compressed, and its frame's body once it is, with the threshold it's compressed with. Its
// version tells it from a packet kept for the chunk before, whose body may come back late.
struct Kept {
    packet: List<u8>?
    body: List<u8>?
    threshold: i32
    version: u64
}

impl Kept {
    // What's sent of it to a player, while it's kept for another.
    fn copied(self, k: i64) -> ChunkPacket {
        if let b = self.body {
            return ChunkPacket.Compressed { body: b.copy(), threshold: self.threshold, packet: self.packet.copy() }
        }
        if let p = self.packet {
            return ChunkPacket.Shared { packet: p.copy(), key: k, version: self.version }
        }
        return ChunkPacket.Plain(List<u8>())
    }

    // What's sent of it to the last player, who takes it.
    fn taken(own self) -> ChunkPacket {
        var kept = self
        if let b = kept.body.take() {
            return ChunkPacket.Compressed { body: b, threshold: kept.threshold, packet: kept.packet.take() }
        }
        if let p = kept.packet.take() {
            return ChunkPacket.Plain(p)
        }
        return ChunkPacket.Plain(List<u8>())
    }
}

// A chunk read for a player whose view is wider than the tickets reach, `owner`.
struct Far {
    owner: i32
    body: Body
}

// What's known of a region's file.
enum Region {
    // It's been asked which chunks it has.
    Asked
    // The chunks it has, a bit each by `x + z * 32` in 16 words.
    Known(List<u64>)
}

// What's to be asked of the IO thread, or told the generator: a chunk being read that nothing
// wants any more (D243).
enum Ask {
    Region(ChunkPos)
    Chunk(ChunkPos)
    Drop(ChunkPos)
}

// The chunks being read for their holders, and those full but not yet lit, which aren't ready
// to save until they're read and lit, as `isReadyForSaving` says while a generation task still
// holds the holder, so their tickets that don't run out unloaded don't run down. Without the
// second, a spawn search's ticket ran out while its chunk waited for light, and the chunk was
// let go before it was full, so the search never went on (CAL-89).
struct Reading {
    chunks: OpenHashSet<i64> = OpenHashSet<i64>()
    unlit: OpenHashSet<i64> = OpenHashSet<i64>()
}

impl Holders for Reading {
    fn ready_for_saving(self, chunk: i64) -> bool {
        return not self.chunks.contains(chunk) and not self.unlit.contains(chunk)
    }
}

// One update waiting in the level's updater, as `CollectingNeighborUpdater` keeps them (D326).
enum Update {
    // `ShapeUpdate`: the block at x, y, z told its neighbour toward `d` is `neighbour` now.
    Shape { d: i32, neighbour: u32, x: i32, y: i32, z: i32, flags: i32, limit: i32 }
    // `SimpleNeighborUpdate`: the block at x, y, z told the block `source` beside it changed.
    Simple { x: i32, y: i32, z: i32, source: u32 }
    // `FullNeighborUpdate`: the same, with the state it's told as, and whether a piston moved
    // what changed.
    Full { state: u32, x: i32, y: i32, z: i32, source: u32, moved: bool }
    // `MultiNeighborUpdate`: the six around x, y, z told `source` changed, in `UPDATE_ORDER`,
    // but the one toward `skip`, -1 for none; `next` is the next to be told.
    Multi { x: i32, y: i32, z: i32, source: u32, skip: i32, next: i32 }
}

/// An event at a block, `levelEvent`, for the players within 64 blocks of it (D326), but the
/// player whose entity's `except`, -1 for none, whose own client shows it (D376).
pub struct LevelEvent {
    pub kind: i32
    pub x: i32
    pub y: i32
    pub z: i32
    pub data: i32
    pub except: i32 = -1
}

/// What a level's players are sent of what happens in it, in the order it happened, as vanilla
/// sends each at once: a level event (D326); a sound, `playSound`; a block event that ran,
/// `ClientboundBlockEventPacket` (CAL-125); and particles, `sendParticles` (CAL-143).
pub enum Heard {
    Event(LevelEvent)
    Sound(LevelSound)
    Block(BlockEvent)
    Particles(LevelParticles)
}

/// Particles sent, `ServerLevel.sendParticles` (CAL-143), to the players whose block's middle is
/// within 32 blocks of them: the particle type's name, as `note`; the block state of one whose
/// option is one, as `block`'s, or -1 for a type with no options (CAL-155); where; how many, none
/// for one whose spread is its motion; how far they spread each way, and their most speed, each as
/// a float, as the packet has them.
pub struct LevelParticles {
    pub particle: String
    pub state: i32 = -1
    pub x: f64
    pub y: f64
    pub z: f64
    pub count: i32
    pub dx: f32
    pub dy: f32
    pub dz: f32
    pub speed: f32
}

/// A sound played, `Level.playSound`, for the players near enough to hear it (CAL-125): the
/// sound event's name, as `block.piston.extend`, where it's played, its volume and pitch, the
/// seed the client plays it with, and `SoundSource`'s ordinal it's played among, the blocks' 4
/// unless a note block's records' 2 (CAL-124).
pub struct LevelSound {
    pub sound: String
    pub x: f64
    pub y: f64
    pub z: f64
    pub volume: f32
    pub pitch: f32
    pub seed: i64
    pub source: i32 = 4
    /// The player it's not sent, by their entity, -1 for none (CAL-139).
    pub except: i32 = -1
}

/// A block event, `BlockEventData`: the block at `x`, `y`, `z` it's for, and its two numbers, for
/// the players within 64 blocks once it's run (CAL-125).
pub struct BlockEvent {
    pub x: i32
    pub y: i32
    pub z: i32
    pub block: u32
    pub b0: i32
    pub b1: i32
}

// A block entity's ticker, `RebindableTickingBlockEntityWrapper`: its place; its number, which
// `ticker_ids` keeps for the place while it's there, and once it isn't, it's dropped as the
// tickers come to it (CAL-125); its block entity's type, by its place among the types, which the
// block there must be of for it to tick, `isValid`; and whether it's yet to tick (CAL-130).
struct Ticker {
    pos: BlockPos
    id: u64
    kind: i32
    first: bool
}

// A redstone torch's toggle, `RedstoneTorchBlock.Toggle`: where, and the game time it toggled at.
struct Toggle {
    x: i32
    y: i32
    z: i32
    when: i64
}

/// The overworld's chunks, and the distance manager that says which load.
/// What a level dropped, for the network to make in order: an item, `Block.popResource`'s, where
/// it's popped and its stack (CAL-153); or an experience orb, `ExperienceOrb.award`'s, where it's
/// made, its value and the id drawn for it to merge by (CAL-154).
pub enum Dropped {
    Item(f64, f64, f64, Tag)
    Orb(f64, f64, f64, i32, i32)
}

pub struct Level {
    /// The tickets and players, and the chunks' holders.
    pub dm: DistanceManager
    // Each holder's chunk, and those of them still being read.
    columns: Columns = Columns()
    reading: Reading = Reading()
    // The far chunks read for players, and how many each player has being read.
    far: OpenHashMap<i64, Far> = OpenHashMap<i64, Far>()
    far_loads: OpenHashMap<i32, i32> = OpenHashMap<i32, i32>()
    regions: OpenHashMap<i64, Region> = OpenHashMap<i64, Region>()
    // How many reads of each chunk are asked for and not back.
    asked: OpenHashMap<i64, i32> = OpenHashMap<i64, i32>()
    // The chunks being read whose holders unloaded, which the generator's been told nothing wants
    // (D243), until they're back.
    dropping: OpenHashSet<i64> = OpenHashSet<i64>()
    // What's to go to the IO thread at the next `dispatch`.
    asks: List<Ask> = List<Ask>()
    // Whether chunks are read, and the threads that read them, which a replay hasn't, and what
    // chunks are made with.
    opened: bool = false
    jobs: ChunkJobs? = none
    context: ChunkContext? = none
    // What chunks that aren't saved are generated with, unless they're flat, and, replaying, the
    // generator that makes them on this thread.
    gen: GenSetup? = none
    generator: Generator? = none
    // The dimension's sections, from its lowest.
    min_section: i32 = 0
    sections: i32 = 0
    // Light, once chunks are read (D264): the queue to its thread and the steps back, or, in a
    // replay or a test, light itself, run here. The asks not yet handed over, or, run here, not
    // yet taken; whether light here steps as the level settles, as a test's does, rather than as
    // the recording's did; how many asks there have been, and how many light's taken by the last
    // step taken in. `lighting` is whether there's light.
    lighting: bool = false
    light_to: Sender<Deque<LightAsk>>? = none
    light_back: Receiver<LightDone>? = none
    light_here: LightService? = none
    light_asks: Deque<LightAsk> = Deque<LightAsk>()
    light_eager: bool = false
    light_sent: u64 = 0
    light_covered: u64 = 0
    // For each chunk light's been told came and not that it went, which ask told it: a step that
    // hadn't taken that ask is about the chunk before, which went.
    came_at: OpenHashMap<i64, u64> = OpenHashMap<i64, u64>()
    // The chunks light's initialized, and those it's lit, which are full.
    initialized: OpenHashSet<i64> = OpenHashSet<i64>()
    lit: OpenHashSet<i64> = OpenHashSet<i64>()
    // The chunks that may have come to be full, or stopped being, since `take_full_changes` was
    // last asked, and those it last said are full (CAL-148).
    full_maybe: List<i64> = List<i64>()
    full_told: OpenHashSet<i64> = OpenHashSet<i64>()
    // The chunks with a joining player's spawn ticket, `want_spawn_light`'s: the chunks lit within
    // its reach are wanted with their light as they're lit (CAL-121).
    spawns: List<i64> = List<i64>()
    // The holders light's been told are full.
    told_full: OpenHashSet<i64> = OpenHashSet<i64>()
    // The chunks whose light is wanted, for their packets, each with the ask that wanted it, from
    // which light gives it; and the light given, as it was last.
    watching: OpenHashMap<i64, u64> = OpenHashMap<i64, u64>()
    light_data: OpenHashMap<i64, LightData> = OpenHashMap<i64, LightData>()
    // The chunks that went to be saved once light gives the light they had, in the order they
    // went, how many each has waiting, and the reads of them that wait for those saves.
    saving: Deque<(i64, Whole)> = Deque<(i64, Whole)>()
    saves_waiting: OpenHashMap<i64, u32> = OpenHashMap<i64, u32>()
    parked: List<i64> = List<i64>()
    // The holders whose chunks are to tick their entities once the 5×5 around them is loaded,
    // each with its place in the order they came to wait, and the next place to give; and those
    // that may have come to be ready, or to wait no more, since `ready_waiting` last looked: only
    // those can have, so only those are looked at again (D252).
    waiting: Map<i64, u64> = Map<i64, u64>()
    next_place: u64 = 0
    recheck: Set<i64> = Set<i64>()
    // The chunks held whole whose light isn't saved as the engine has it: lit since they were
    // saved, or changed by a run since they were lit. Each is saved as it unloads, and as the
    // server stops, as vanilla saves a chunk it's marked unsaved (D258).
    unsaved: OpenHashSet<i64> = OpenHashSet<i64>()
    // The chunks changed in play since they were saved, oldest first, which `save_eagerly`
    // saves, and when each may next be, by the server's clock in milliseconds, 10 seconds after
    // it last was, as `chunksToEagerlySave` and `nextChunkSaveTime` have them (CAL-145).
    eager: OpenHashSet<i64> = OpenHashSet<i64>()
    eager_order: Deque<i64> = Deque<i64>()
    next_save: OpenHashMap<i64, i64> = OpenHashMap<i64, i64>()
    // Each held chunk's inhabited time, where it isn't 0: as it was saved, and a tick more each
    // tick mobs may spawn in it, `incrementInhabitedTime` (CAL-145).
    inhabited: OpenHashMap<i64, i64> = OpenHashMap<i64, i64>()
    lines: List<Entry> = List<Entry>()
    // The player whose sender asks next, for their far chunks.
    serving: i32 = 0
    // The packets kept for chunks another player is still to be sent, by packed position, and
    // the last version given one, whose top bits are the level's dimension (`set_dimension`).
    packets: OpenHashMap<i64, Kept> = OpenHashMap<i64, Kept>()
    versions: u64 = 0
    // The world's hashed seed, which zooms the biomes in; the chunks whose light is kept for
    // natural spawning, as `keep_light` was last given them; and the light of a flat chunk among
    // flat ones (D317).
    zoom_seed: i64 = 0
    kept_light: OpenHashSet<i64> = OpenHashSet<i64>()
    flat_light: LightData? = none
    // What a block's set with, its heightmaps and its section's counts, once the level's opened;
    // the chunks with blocks set since the changes were last broadcast, in the order they first
    // had one; and the blocks set in each of their sections, by the section's packed position, as
    // each `ChunkHolder` keeps them in `changedBlocksPerSection` (D321).
    table: BlockStates? = none
    to_broadcast: LinkedSet<i64> = LinkedSet<i64>()
    // The sections of each chunk whose light changed since its last broadcast, sky and block, as
    // `ChunkHolder` keeps them, in the order the chunks first had one (D342).
    light_bits: OpenHashMap<i64, LightBits> = OpenHashMap<i64, LightBits>()
    light_order: LinkedSet<i64> = LinkedSet<i64>()
    changed_blocks: OpenHashMap<i64, OpenHashSet<i16>> = OpenHashMap<i64, OpenHashSet<i16>>()
    // Each full chunk's scheduled block and fluid ticks, from when it's full until it unloads, as
    // `registerTickContainerInLevel` adds them, with those it was saved with scheduled once it
    // ticks, as `startTickingChunk` schedules them (D322); the chunks that may have come to be
    // full or to tick since `check_ticks` last looked, each whose holder's level changed and those
    // around each that came to be loaded; and `subTickCount`, how many ticks have been
    // scheduled, which orders those due together.
    block_ticks: LevelTicks = LevelTicks()
    fluid_ticks: LevelTicks = LevelTicks()
    ticks_to_check: LinkedSet<i64> = LinkedSet<i64>()
    // The chunks that came to tick before the level had its block facts, as the spawn's do at
    // the server's start, in the order they came to, post-processed once it has them (D329).
    post_waiting: LinkedSet<i64> = LinkedSet<i64>()
    // The chunks that came to tick before the level had their light, which post-processing
    // reads, post-processed as it comes (D329).
    post_lit: LinkedSet<i64> = LinkedSet<i64>()
    sub_ticks: i64 = 0
    /// The game time, which the level's ticks are scheduled and saved by, as the network has it.
    pub game_time: i64 = 0
    /// The blocks it has sent again, `sendBlockUpdated`, with what they were and are, which its
    /// entities read before each ticks, as its mobs' navigation does, and the network lets go
    /// once they've ticked (CAL-157).
    pub sent: SentLog = SentLog()
    // Its random, `Level.random`, which the server seeds from its input as it starts, and which
    // can write its draws to the RNG tape (D312); here, so what a block set does can draw from it
    // as vanilla's does, and `none` only while it's lent out (D323).
    random: TapedRandom? = none
    /// Lava's tick delay, `LavaFluid.getTickDelay`: 10 where the dimension's lava is fast, as the
    /// network sets it each tick, else 30 (D324).
    pub lava_delay: i32 = 30
    /// Whether its dimension's lava is fast, as the network sets it each tick, and the game rules
    /// `water_source_conversion` and `lava_source_conversion` (D328).
    pub fast_lava: bool = false
    /// The world's jukebox songs, which the network gives it once the world's registries are
    /// read, and none until then (CAL-143).
    pub songs: Songs = Songs()
    pub water_source_conversion: bool = true
    pub lava_source_conversion: bool = false
    /// What its block ticks, random and scheduled, read of it this tick besides its blocks, as
    /// the network sets it each tick before they run (D338, D339); and each biome's climate,
    /// which where it rains reads, as the network gives it with the block facts (D339).
    pub place: TickPlace = TickPlace()
    pub climate: Shared<Temperatures>? = none
    /// What broken blocks drop with (CAL-153): the world's loot, as the network gives it with the
    /// block facts; the server's random sequences, lent by the network to the level that's
    /// running, and the world's seed they're made from; the game rule `block_drops`; and the
    /// items and orbs dropped, for the network to make in order.
    pub loot: Shared<Loot>? = none
    pub sequences: RandomSequences? = none
    pub world_seed: i64 = 0
    pub block_drops: bool = true
    dropped: List<Dropped> = List<Dropped>()
    // What a block's shape and its survival read, the block facts and the dimension's light,
    // once the network has them, shared, so each block set and update reads them where they are
    // and doesn't copy them (D336); the updates waiting, as `CollectingNeighborUpdater` keeps them,
    // the stack and those the update running added, with how many have run in this chain and
    // how many may, `max-chained-neighbor-updates`; what isn't in Calcite yet that's been
    // reported; and the level events for the network to send (D326).
    env: Shared<Env>? = none
    update_stack: List<Update> = List<Update>()
    update_added: List<Update> = List<Update>()
    update_count: i32 = 0
    /// `max-chained-neighbor-updates`: how many updates a chain may run, or no end if below 0.
    pub max_chained: i32 = 1000000
    reported: Set<String> = Set<String>()
    events: List<Heard> = List<Heard>()
    // The block ticks running this tick, as `LevelTicks.tick` collects them, `toRunThisTick`, with
    // the next to run, and those still to run, `toRunThisTickSet`, which `willTickThisTick` makes
    // as it first asks; and the redstone torches' toggles, oldest first, `RECENT_TOGGLES`'s
    // list for the level (CAL-116).
    running: List<ScheduledTick> = List<ScheduledTick>()
    running_at: usize = 0
    to_run: Set<(i64, u32)> = Set<(i64, u32)>()
    toggles: List<Toggle> = List<Toggle>()
    // The `block_entity_type` registry's IDs by name, which a chunk's packet sends its block
    // entities' types by, made as the first chunk's packet is (CAL-115).
    block_entity_ids: OpenHashMap<String, i32> = OpenHashMap<String, i32>()
    // The block events waiting, `blockEvents`, each once, in the order they came; the moving
    // pistons' block entities, by their places, packed; the block entities' tickers,
    // `blockEntityTickers`, in their order, with those added while they tick,
    // `pendingBlockEntityTickers`, and whether they're ticking; each place's ticker's number, and
    // the next; which ticker each place's is, as `world.block_entity_ticks` has them, and each
    // chunk's tickers' places, which go as it unloads (CAL-130); the chunks full before the level
    // had its block facts, whose block entities tick once it has them; and the sounds' seeds, from
    // a sequence of their own, as vanilla's `threadSafeRandom` is seeded as the server starts
    // (CAL-125).
    block_events: List<BlockEvent> = List<BlockEvent>()
    motions: Map<i64, MovingPiston> = Map<i64, MovingPiston>()
    // What each container's block entity holds of who has it open, by its place, packed, which
    // goes with it, and the next number one's given (CAL-144).
    container_openers: Map<i64, Openers> = Map<i64, Openers>()
    next_openers: u64 = 1
    tickers: List<Ticker> = List<Ticker>()
    pending_tickers: List<Ticker> = List<Ticker>()
    ticking_entities: bool = false
    ticker_ids: Map<i64, u64> = Map<i64, u64>()
    next_ticker: u64 = 1
    ticker_kinds: Map<i64, i32> = Map<i64, i32>()
    chunk_tickers: Map<i64, List<i64>> = Map<i64, List<i64>>()
    moving_waiting: List<i64> = List<i64>()
    sound_seeds: i64 = 0
    /// `handlingTick`: whether the level's tick is between its start and its block events, as the
    /// network sets it, which a piston pulled back while another moves reads (CAL-125).
    pub handling: bool = false
}

/// The blocks set in a section since they were last broadcast, as `ChunkHolder.broadcastChanges`
/// sends them (D321): the chunk and the section's `y`, and each block's place in the section,
/// `x << 8 | z << 4 | y`, as `SectionPos.sectionRelativePos` packs it, in the order its set gives
/// them, with its state as it is now; and the update packets of the block entities of those whose
/// class sends one, `broadcastBlockEntityIfNeeded`, in the same order (CAL-115).
pub struct SectionChanges {
    pub chunk: ChunkPos
    pub section_y: i32
    pub places: List<i16>
    pub states: List<u32>
    pub block_entities: List<ClientboundBlockEntityData>
}

/// A chunk's light that changed, as `ChunkHolder.broadcastChanges` sends it to the players with
/// the chunk on the edge of their view (D342): the light of the sections that changed, each as
/// the chunk's light has it now.
pub struct LightChanges {
    pub chunk: ChunkPos
    pub light: LightData
}

// Which of a chunk's sections' sky and block light changed, `skyChangedLightSectionFilter` and
// `blockChangedLightSectionFilter`, each a `BitSet`'s bytes.
struct LightBits {
    sky: List<u8> = List<u8>()
    block: List<u8> = List<u8>()
}

/// How far around where a player's going to another dimension a `portal` ticket loads, as
/// vanilla adds it, which is how far the place they'll stand is looked for (CAL-69).
pub const PORTAL_RADIUS: i32 = 3

/// Where a kept packet's version has its level's dimension, by its place in the world's: its top
/// 8 bits, so each level's are its own and a compressed one comes back to the level that gave it
/// (CAL-69).
pub const VERSION_SHIFT: u64 = 56

impl Level {
    /// A world whose player tickets reach `view` chunks and whose simulation distance is
    /// `simulation`, as the chunk map sets them, which reads nothing until it's opened. Its
    /// player tickets load `PLAYER_LOADS` chunks at once.
    pub fn new(view: i32, simulation: i32) -> Level {
        var dm = DistanceManager.new(TicketStorage.new())
        dm.set_most_in_execution(PLAYER_LOADS)
        dm.update_player_tickets(view)
        dm.update_simulation_distance(simulation)
        return Level { dm: dm, random: some(TapedRandom.new(0)) }
    }

    /// Gives the level `random` as its own, as the server seeds it.
    pub fn set_random(mut self, random: own TapedRandom) {
        self.random = some(random)
    }

    /// Lends the level's random out, for what takes it on its own, such as the weather; it's
    /// given back with `give_back_random`, and the level draws nothing meanwhile.
    pub fn lend_random(mut self) -> TapedRandom {
        let r = self.random.take() else panic("the level's random is lent out already")
        return r
    }

    /// Gives back the random `lend_random` lent.
    pub fn give_back_random(mut self, random: own TapedRandom) {
        self.random = some(random)
    }

    /// Has the level's random write each value it draws to the RNG tape from now on, each line
    /// starting with `name` (D312).
    pub fn tape_random(mut self, name: own String) {
        var r = self.lend_random()
        r.tape(name)
        self.random = some(r)
    }

    /// The RNG tape's lines the level's random wrote since this was last asked.
    pub fn take_random_lines(mut self) -> String {
        var r = self.lend_random()
        let out = r.take_lines()
        self.random = some(r)
        return out
    }

    /// Sets the game time the RNG tape's lines are at, as the level's tick moves it on.
    pub fn set_random_time(mut self, time: i64) {
        var r = self.lend_random()
        r.time = time
        self.random = some(r)
    }

    /// Makes the versions of the packets this level keeps its own among the world's levels, as
    /// it's the dimension at `dim` of them.
    pub fn set_dimension(mut self, dim: usize) {
        self.versions = u64(dim) << VERSION_SHIFT
    }

    /// Gives the level its dimension's bottom and height, which a level that's opened has from
    /// what its chunks are made with, and the world's hashed seed, which zooms its biomes in from
    /// quarts to blocks, as `BiomeManager` zooms them (D317).
    pub fn set_bounds(mut self, min_y: i32, height: i32, zoom_seed: i64) {
        self.min_section = min_y >> 4
        self.sections = height >> 4
        self.columns.sections = usize.wrap(self.sections)
        self.zoom_seed = zoom_seed
    }

    /// Gives the level the light of a flat chunk among flat ones, which theirs is, for natural
    /// spawning, which reads it (D317).
    pub fn set_flat_light(mut self, light: own LightData) {
        self.flat_light = some(light)
    }

    /// How many chunks the natural spawn counter counts, `getNaturalSpawnChunkCount`, which the
    /// mob categories' caps are scaled by (D317).
    pub fn natural_spawn_chunk_count(mut self) -> i32 {
        return i32.wrap(self.dm.natural_spawn_chunk_count())
    }

    /// Keeps the light of `chunks`, those natural spawning may read this tick, for as long as
    /// they're given here each tick (D317). Vanilla's light is in its chunks; Calcite's is on
    /// light's thread, which gives a chunk's for its packet and lets it go once it's sent. So the
    /// level watches these as they come, and lets them go as they leave. A flat chunk among flat
    /// ones has the flat world's light, and isn't watched.
    pub fn keep_light(mut self, chunks: List<ChunkPos>) {
        var now = OpenHashSet<i64>()
        for pos in chunks {
            let k = pos.pack()
            now.insert(k)
            self.kept_light.insert(k)
            if self.lighting and not self.watching.contains(k) and not self.flat_around(pos) {
                self.watch(k)
            }
        }
        var gone = List<i64>()
        for k in self.kept_light {
            if not now.contains(k) {
                gone.push(k)
            }
        }
        for k in gone {
            self.kept_light.remove(k)
            self.release(k)
        }
    }

    /// The light at the block, the sky's if `sky`, as `getBrightness` reads it from the light
    /// engine's sections (D317): a section's layer, or for the sky, where a section has none, the
    /// bottom of the first above it that has one, or 15 above them all; for the blocks, 0 where
    /// there's none. A flat chunk among flat ones has the flat world's light. A chunk whose light
    /// isn't here yet, kept only this tick, has the sky's 15 and no block light.
    pub fn light_at(self, sky: bool, x: i32, y: i32, z: i32) -> i32 {
        let pos = ChunkPos { x: x >> 4, z: z >> 4 }
        let k = pos.pack()
        if self.light_data.contains(k) {
            return light_value(self.light_data[k], sky, self.min_section, self.sections, x, y, z)
        }
        if self.flat_around(pos) {
            if let f = self.flat_light {
                return light_value(f, sky, self.min_section, self.sections, x, y, z)
            }
        }
        return if sky { 15 } else { 0 }
    }

    /// Makes every chunk generated `flat`, which the world's blocks are, for collisions, and
    /// light once it's opened.
    pub fn ground(mut self, flat: own FlatChunk) {
        self.columns.flat = some(flat)
    }

    /// Reads chunks from now on, made with `context`: through `jobs`, the IO thread and chunk
    /// workers, or, replaying, from the log, which has what the recording read. Each is lit, on
    /// light's thread with `jobs`, and without them here, a step each time the level settles, as
    /// a test has it, until `replay_light` has the steps the recording's light took instead.
    /// Those that aren't saved are generated as `gen` says, or flat, the ground, if it's `none`.
    pub fn open(mut self, jobs: own ChunkJobs?, context: own ChunkContext, gen: own GenSetup?) {
        self.opened = true
        self.min_section = context.min_section
        self.sections = context.sections
        self.columns.sections = usize.wrap(context.sections)
        var flat: FlatChunk? = none
        if let f = self.columns.flat {
            flat = some(f.copy())
        }
        if let f = flat {
            var service = LightService.new(context.min_section, context.sections, context.sky_light, f)
            service.set_table(context.table.copy())
            self.lighting = true
            if let j = jobs {
                let asks = Receiver<Deque<LightAsk>>()
                let back = Receiver<LightDone>()
                self.light_to = some(asks.sender())
                _ = unsafe { Thread.spawn(LightThread { service: service, asks: asks, back: back.sender(), waker: j.poll_waker() }) }
                self.light_back = some(back)
            } else {
                self.light_here = some(service)
                self.light_eager = true
            }
        }
        self.jobs = jobs
        self.gen = gen
        self.table = some(context.table.copy())
        self.context = some(context)
    }

    /// Has light, run here, take the steps the recording's light took, each as `replay_light`
    /// hands it over, rather than a step each time the level settles.
    pub fn light_as_recorded(mut self) {
        self.light_eager = false
    }

    /// Whether chunks are read from the world's folder.
    pub fn reads(self) -> bool {
        return self.opened
    }

    /// Whether chunks that aren't saved are generated, rather than flat.
    pub fn generates(self) -> bool {
        return self.opened and self.gen != none
    }

    /// Asks the generator where a new world's spawn is, which comes back with what's done.
    pub fn ask_spawn(mut self) {
        var jobs = self.jobs.take() else return
        jobs.ask_spawn()
        self.jobs = some(jobs)
    }

    /// What's been logged since this was last asked, oldest first.
    pub fn take_lines(mut self) -> List<Entry> {
        let out = self.lines.copy()
        self.lines.clear()
        return out
    }

    /// How many chunks are loaded or being read for holders, and how many far chunks for
    /// players.
    pub fn chunk_count(self) -> (usize, usize) {
        return (self.columns.slots.len(), self.far.len())
    }

    /// How many chunks being read the generator's been told nothing wants, and not handed back
    /// (D243).
    pub fn dropping_count(self) -> usize {
        return self.dropping.len()
    }

    /// Adds `player` in `chunk`, as `ChunkMap.updatePlayerStatus` does. What their tickets
    /// come to loads at the next `pump`.
    pub fn add_player(mut self, chunk: ChunkPos, player: i32) {
        self.dm.add_player(chunk.pack(), player)
    }

    /// Takes `player` out of `chunk`, as a player who leaves is, until the next `pump`.
    pub fn remove_player(mut self, chunk: ChunkPos, player: i32) {
        self.dm.remove_player(chunk.pack(), player)
    }

    /// Moves `player` from `from` to `to`, as `ChunkMap.move` does when they go into another
    /// section, until the next `pump`.
    pub fn move_player(mut self, from: ChunkPos, to: ChunkPos, player: i32) {
        self.dm.remove_player(from.pack(), player)
        self.dm.add_player(to.pack(), player)
    }

    /// Lets go of the far chunks read for `player`, who left.
    pub fn forget_player(mut self, player: i32) {
        var gone = List<i64>()
        for (k, f) in self.far {
            if f.owner == player {
                gone.push(k)
            }
        }
        for k in gone {
            self.free_far(k)
        }
        _ = self.far_loads.remove(player)
    }

    /// The chunk at `pos` left `player`'s view: a far chunk read for them goes.
    pub fn forget_far(mut self, pos: ChunkPos, player: i32) {
        let k = pos.pack()
        if self.far.contains(k) and self.far[k].owner == player {
            self.free_far(k)
        }
    }

    /// Adds a joining player's spawn ticket, `player_spawn` 3 around `chunk`, and settles what
    /// it comes to, as `addTicketAndLoadWithRadius` does.
    pub fn load_spawn(mut self, chunk: ChunkPos) {
        _ = self.dm.add_ticket(chunk.pack(), Ticket.with_radius(TicketType.PlayerSpawn, SPAWN_RADIUS))
        self.pump()
    }

    /// A player's to join at `chunk`, whose spawn ticket `load_spawn` added: the chunks within its
    /// reach are wanted with their light as they're lit, those lit already now, as the player's
    /// sender, which comes to them as soon as they join, would want them, so they're sent then,
    /// as vanilla's are, nearest first, and not after the flat chunks further out, which need no
    /// light from light (CAL-121). The ticket going ends it.
    pub fn want_spawn_light(mut self, chunk: ChunkPos) {
        let k = chunk.pack()
        if not self.spawns.contains(k) {
            self.spawns.push(k)
        }
        for x in chunk.x - SPAWN_RADIUS..chunk.x + SPAWN_RADIUS + 1 {
            for z in chunk.z - SPAWN_RADIUS..chunk.z + SPAWN_RADIUS + 1 {
                let pos = ChunkPos { x: x, z: z }
                if self.lit.contains(pos.pack()) {
                    _ = self.light_wanted(pos)
                }
            }
        }
    }

    // Whether the chunk at `k` is within the reach of a joining player's spawn ticket, those whose
    // ticket's gone let go of.
    fn near_spawn(mut self, k: i64) -> bool {
        var kept = List<i64>()
        var near = false
        let pos = unpacked(k)
        for c in self.spawns {
            var held = false
            for ticket in self.dm.tickets.tickets_at(c) {
                if ticket.kind == TicketType.PlayerSpawn {
                    held = true
                }
            }
            if not held {
                continue
            }
            kept.push(c)
            let centre = unpacked(c)
            if (pos.x - centre.x).abs() <= SPAWN_RADIUS and (pos.z - centre.z).abs() <= SPAWN_RADIUS {
                near = true
            }
        }
        self.spawns = kept
        return near
    }

    /// Adds a `portal` ticket `PORTAL_RADIUS` around `chunk`, as a portal loads where it leads,
    /// and settles what it comes to (CAL-69).
    pub fn load_portal(mut self, chunk: ChunkPos) {
        _ = self.dm.add_ticket(chunk.pack(), Ticket.with_radius(TicketType.Portal, PORTAL_RADIUS))
        self.pump()
    }

    /// Where a player can stand in the column at `x`, `z`, as `world.spawn.standing_y` finds it,
    /// from `top` down, or from the top of `MOTION_BLOCKING` where that's lower and the dimension
    /// has no ceiling, if its chunk is full.
    pub fn standing_y(self, states: CollisionStates, x: i32, z: i32, top: i32, ceiling: bool) -> i32? {
        let pos = ChunkPos { x: x >> 4, z: z >> 4 }
        if not self.full(pos) {
            return none
        }
        let k = pos.pack()
        if self.columns.live.contains(k) {
            let from = if ceiling { top } else { top.min(self.columns.live[k].height(MOTION_BLOCKING, x & 15, z & 15)) }
            return standing_y(states, self.columns.live[k], self, x, from, z)
        }
        match self.columns.slots[k] {
            Body.Saved(s) => {
                let from = if ceiling { top } else { top.min(s.chunk.value.height(MOTION_BLOCKING, x & 15, z & 15)) }
                return standing_y(states, s.chunk.value, self, x, from, z)
            },
            Body.Flat => {
                if let f = self.columns.flat {
                    let from = if ceiling { top } else { top.min(f.chunk.height(MOTION_BLOCKING, x & 15, z & 15)) }
                    return standing_y(states, f.chunk, self, x, from, z)
                }
            },
            Body.Loading => {},
        }
        return none
    }

    /// Adds a spawn search's ticket, `spawn_search` at `chunk` alone, and settles what it comes
    /// to, as `PlayerSpawnFinder.scheduleCandidate` adds it, so the candidate there can be checked
    /// once the chunk is `full`.
    pub fn search_spawn(mut self, chunk: ChunkPos) {
        _ = self.dm.add_ticket(chunk.pack(), Ticket.with_radius(TicketType.SpawnSearch, 0))
        self.pump()
    }

    /// Whether a player's chunks are still loading, which a pregen task gives way to (D277).
    pub fn players_loading(self) -> bool {
        return self.dm.players_loading()
    }

    /// Whether the chunk at `pos` is full, as a chunk's future for `FULL` is done.
    pub fn full(self, pos: ChunkPos) -> bool {
        let k = pos.pack()
        return self.dm.chunk_level(k, false) <= FULL and self.loaded(k)
    }

    /// The chunks that came to be full since this was last asked, `true`, and those that stopped
    /// being, `false`, in the order they did, as `ChunkMap.onFullChunkStatusChange` tells the
    /// level's entities which chunks are accessible (CAL-148). A chunk that came to be full and
    /// stopped being between two asks isn't in it.
    pub fn take_full_changes(mut self) -> List<(ChunkPos, bool)> {
        var out = List<(ChunkPos, bool)>()
        if self.full_maybe.is_empty() {
            return out
        }
        let maybe = self.full_maybe.copy()
        self.full_maybe.clear()
        for k in maybe {
            let pos = unpacked(k)
            let now = self.full(pos)
            if now == self.full_told.contains(k) {
                continue
            }
            if now {
                self.full_told.insert(k)
            } else {
                self.full_told.remove(k)
            }
            out.push((pos, now))
        }
        return out
    }

    /// Where a player new to the world would stand in the column at `x`, `z`, as
    /// `world.spawn.respawn_pos` finds it, if its chunk is full.
    pub fn respawn_pos(self, states: CollisionStates, x: i32, z: i32) -> BlockPos? {
        let pos = ChunkPos { x: x >> 4, z: z >> 4 }
        if not self.full(pos) {
            return none
        }
        let k = pos.pack()
        if self.columns.live.contains(k) {
            return respawn_pos(states, self.columns.live[k], x, z)
        }
        match self.columns.slots[k] {
            Body.Saved(s) => return respawn_pos(states, s.chunk.value, x, z),
            Body.Flat => {
                if let f = self.columns.flat {
                    return respawn_pos(states, f.chunk, x, z)
                }
            },
            Body.Loading => {},
        }
        return none
    }

    /// Adds the spawn ticket again, so it doesn't run out while the player is still to join, as
    /// `PrepareSpawnTask.Ready.keepAlive` does each configuration tick.
    pub fn keep_spawn(mut self, chunk: ChunkPos) {
        _ = self.dm.add_ticket(chunk.pack(), Ticket.with_radius(TicketType.PlayerSpawn, SPAWN_RADIUS))
    }

    /// Whether every chunk within `radius` of `center` is full, as `getChunkRangeFuture` waits
    /// for them to be.
    pub fn full_around(self, center: ChunkPos, radius: i32) -> bool {
        for x in center.x - radius..center.x + radius + 1 {
            for z in center.z - radius..center.z + radius + 1 {
                let k = ChunkPos { x: x, z: z }.pack()
                if self.dm.chunk_level(k, false) > FULL or not self.loaded(k) {
                    return false
                }
            }
        }
        return true
    }

    /// Whether the future `getChunkRangeFuture` gives for the chunks within `radius` of
    /// `center` is done: each is full, or was let go before it was, as one whose level rose past
    /// `FULL` fails its future. A spawn ticket runs out 20 ticks after its own chunk is ready to
    /// save, whether those around it are full yet or not, and the player joins then anyway.
    pub fn around_done(self, center: ChunkPos, radius: i32) -> bool {
        for x in center.x - radius..center.x + radius + 1 {
            for z in center.z - radius..center.z + radius + 1 {
                let k = ChunkPos { x: x, z: z }.pack()
                if self.dm.chunk_level(k, false) <= FULL and not self.loaded(k) {
                    return false
                }
            }
        }
        return true
    }

    /// Whether the chunk at `pos` is ready to send: it ticks, as `getChunkToSend` has it.
    pub fn sendable(self, pos: ChunkPos) -> bool {
        if self.dm.chunk_level(pos.pack(), false) > TICKING {
            return false
        }
        return self.loaded_around(pos, 1)
    }

    /// The chunks mobs may spawn in this tick, as `collectSpawningChunks` finds them (D315): each
    /// within 8 of a player by the natural spawn counter, in its order, whose chunk ticks, with a
    /// player of `players`, where each stands on x and z, closer than 128 blocks to its middle, as
    /// `anyPlayerCloseEnoughForSpawningInternal` has it. Spectators aren't close to any.
    pub fn spawning_chunks(mut self, players: List<(f64, f64)>) -> List<ChunkPos> {
        var out = List<ChunkPos>()
        for k in self.dm.spawn_candidates() {
            let pos = unpacked(k)
            if not self.sendable(pos) {
                continue
            }
            let mid_x = f64(pos.x * 16 + 8)
            let mid_z = f64(pos.z * 16 + 8)
            for (x, z) in players {
                let dx = mid_x - x
                let dz = mid_z - z
                if dx * dx + dz * dz < 16384.0 {
                    out.push(pos)
                    break
                }
            }
        }
        return out
    }

    /// The chunks whose blocks tick, as `forEachBlockTickingChunk` goes over them (D318): those
    /// the simulation tracker has in range for their entities to tick, in its table's order,
    /// whose chunk ticks.
    pub fn block_ticking_chunks(self) -> List<ChunkPos> {
        var out = List<ChunkPos>()
        for k in self.dm.entity_ticking_chunks() {
            let pos = unpacked(k)
            if self.sendable(pos) {
                out.push(pos)
            }
        }
        return out
    }

    /// The bottom `y` of each section of the chunk at `pos` with a block or fluid that ticks at
    /// random, `isRandomlyTicking`, from the bottom up (D318).
    pub fn ticking_sections(self, pos: ChunkPos) -> List<i32> {
        var out = List<i32>()
        if not self.full(pos) {
            return out
        }
        let k = pos.pack()
        if self.columns.live.contains(k) {
            ticking_in(self.columns.live[k], mut out)
            return out
        }
        match self.columns.slots[k] {
            Body.Saved(s) => ticking_in(s.chunk.value, mut out),
            Body.Flat => {
                if let f = self.columns.flat {
                    ticking_in(f.chunk, mut out)
                }
            },
            Body.Loading => {},
        }
        return out
    }

    /// The blocks set since this was last asked in each chunk that ticks, as
    /// `broadcastChangedChunks` goes over the holders with changes once the chunks have ticked, a
    /// section at a time from the bottom (D321). The chunks go in the order they first had one, as
    /// vanilla's go in the order of a set of holders by their identity. Those that don't tick by
    /// now have theirs dropped.
    pub fn take_changes(mut self) -> List<SectionChanges> {
        var out = List<SectionChanges>()
        if self.to_broadcast.is_empty() {
            return out
        }
        var chunks = List<i64>()
        for k in self.to_broadcast {
            chunks.push(k)
        }
        self.to_broadcast.clear()
        for k in chunks {
            let pos = unpacked(k)
            let ticks = self.sendable(pos)
            for section_y in self.min_section..self.min_section + self.sections {
                let set = self.changed_blocks.remove(section_key(pos.x, section_y, pos.z)) else continue
                if not ticks {
                    continue
                }
                var places = List<i16>()
                var states = List<u32>()
                var entities = List<ClientboundBlockEntityData>()
                for p in set {
                    let place = i32(p)
                    places.push(p)
                    let at = BlockPos { x: pos.x * 16 + ((place >> 8) & 15), y: section_y * 16 + (place & 15), z: pos.z * 16 + ((place >> 4) & 15) }
                    let state = self.spawn_state(at.x, at.y, at.z)
                    states.push(state)
                    if let packet = self.update_packet(k, at, state) {
                        entities.push(packet)
                    }
                }
                out.push(SectionChanges { chunk: pos, section_y: section_y, places: places, states: states, block_entities: entities })
            }
        }
        return out
    }

    /// The light that changed in each chunk that ticks since this was last asked, as
    /// `broadcastChanges` sends it before the chunk's blocks, in the order the chunks first had
    /// some (D342): the sections' light as the chunk's light is now, `LightUpdatePacketData` of
    /// the sections marked, each with its light, or none known to be dark, or left out where
    /// there's none. Light's thread gives a chunk's light for its packet and lets it go once it's
    /// sent, unless it's kept, so a chunk whose light isn't here has it asked for again and keeps
    /// its marks until it comes. A flat chunk among flat ones gives none.
    pub fn take_light_changes(mut self) -> List<LightChanges> {
        var out = List<LightChanges>()
        if self.light_order.is_empty() {
            return out
        }
        var chunks = List<i64>()
        for k in self.light_order {
            chunks.push(k)
        }
        self.light_order.clear()
        var waiting = List<i64>()
        for k in chunks {
            let pos = unpacked(k)
            if not self.sendable(pos) or not self.lighting or self.flat_around(pos) {
                _ = self.light_bits.remove(k)
                continue
            }
            if not self.light_data.contains(k) {
                // Asked for again unless it's been asked for since light last gave it.
                let asked = self.watching.get(k) ?? 0u64
                if not self.watching.contains(k) or asked <= self.light_covered {
                    self.watch(k)
                }
                waiting.push(k)
                continue
            }
            let bits = self.light_bits.remove(k) else continue
            out.push(LightChanges { chunk: pos, light: light_part(self.light_data[k], bits) })
        }
        for k in waiting {
            self.light_order.insert(k)
        }
        return out
    }

    /// Schedules a tick of the block `kind` at `x`, `y`, `z`, due in `delay` ticks with
    /// `priority`, as `scheduleTick` does: dropped if its chunk isn't full, or if the block has
    /// one of its kind already (D322).
    pub fn schedule_block_tick(mut self, kind: u32, x: i32, y: i32, z: i32, delay: i32, priority: i32) {
        let tick = self.new_tick(kind, x, y, z, delay, priority)
        _ = self.block_ticks.schedule(tick)
    }

    /// Schedules a tick of the fluid `kind` at `x`, `y`, `z`, as `schedule_block_tick` does a
    /// block's.
    pub fn schedule_fluid_tick(mut self, kind: u32, x: i32, y: i32, z: i32, delay: i32, priority: i32) {
        let tick = self.new_tick(kind, x, y, z, delay, priority)
        _ = self.fluid_ticks.schedule(tick)
    }

    /// Whether the block at `x`, `y`, `z` has a tick of the fluid `kind` scheduled.
    pub fn has_fluid_tick(self, kind: u32, x: i32, y: i32, z: i32) -> bool {
        return self.fluid_ticks.has(kind, x, y, z)
    }

    /// The block ticks due now, in the order they're to run, as `blockTicks.tick` takes them
    /// (D322), from the chunks `tickCheck` says tick: in range for their blocks to tick, and
    /// ticking. Vanilla's check asks too whether the chunk's entities are loaded, which a chunk's
    /// are once it's full here.
    pub fn take_block_ticks(mut self) -> List<ScheduledTick> {
        self.check_ticks()
        let ticking = self.ticking_of(self.block_ticks.due(self.game_time))
        return self.block_ticks.collect(self.game_time, MOST_TICKS, ticking)
    }

    /// The fluid ticks due now, as `take_block_ticks` takes the blocks'.
    pub fn take_fluid_ticks(mut self) -> List<ScheduledTick> {
        self.check_ticks()
        let ticking = self.ticking_of(self.fluid_ticks.due(self.game_time))
        return self.fluid_ticks.collect(self.game_time, MOST_TICKS, ticking)
    }

    /// The random tick of the block at `x`, `y`, `z`, then of its fluid, as `tickChunk` gives
    /// them, `ticks`' own, with what the level's `place` says of it this tick (D338). A level
    /// without the block facts gives none. What isn't in Calcite yet is reported.
    pub fn random_tick(mut self, ticks: RandomTicks, x: i32, y: i32, z: i32) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let state = self.spawn_state(x, y, z)
        match ticks.tick(shared.value, mut self, state, x, y, z) {
            ok => {},
            err(thrown) => self.report(thrown.message),
        }
    }

    /// Precipitation in the column at `x`, `z`, as `tickPrecipitation` brings it, `p`'s own,
    /// with the biomes' climate and what the level's `place` says of it this tick (D340). A level
    /// without the block facts or the climate has none. What isn't in Calcite yet is reported.
    pub fn precipitate(mut self, p: Precipitation, x: i32, z: i32) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let some_climate = self.climate.copy()
        let climate = some_climate else return
        let max_snow = self.place.max_snow
        match p.tick(shared.value, mut self, climate.value, max_snow, x, z) {
            ok => {},
            err(thrown) => self.report(thrown.message),
        }
    }

    /// Runs the block ticks due now, as `blockTicks.tick` runs them with `tickBlock` (D335): each
    /// whose block is still there does what its class's `tick` does, as `world.block_updates`
    /// has it, its chunk unsaved, as its ticks changed (CAL-148). A level without the block facts
    /// takes them and runs none, as before. What isn't in Calcite yet is reported.
    pub fn run_block_ticks(mut self) {
        let ticks = self.take_block_ticks()
        let some_env = self.env.copy()
        let shared = some_env else return
        // Each taken off those still to run before it runs, as `runCollectedTicks` polls it.
        self.running = ticks
        self.running_at = 0
        self.to_run.clear()
        while self.running_at < self.running.len() {
            let t = self.running[self.running_at]
            self.running_at += 1
            // Its chunk's ticks changed, so it's to be saved (CAL-148).
            self.touched(ChunkPos { x: t.x >> 4, z: t.z >> 4 }.pack())
            if not self.to_run.is_empty() {
                self.to_run.remove((BlockPos { x: t.x, y: t.y, z: t.z }.pack(), t.kind))
            }
            match tick_block(shared.value, mut self, t.kind, t.x, t.y, t.z) {
                ok => {},
                err(thrown) => self.report(thrown.message),
            }
        }
        self.running.clear()
        self.running_at = 0
        self.to_run.clear()
    }

    /// Runs the fluid ticks due now, as `fluidTicks.tick` runs them with `tickFluid` (D328): each
    /// whose block still holds its fluid flows, as `FlowingFluid.tick` has it, its chunk unsaved
    /// (CAL-148). A level without the block facts takes them and runs none, as before. What isn't
    /// in Calcite yet is reported.
    pub fn run_fluid_ticks(mut self) {
        let ticks = self.take_fluid_ticks()
        let some_env = self.env.copy()
        let shared = some_env else return
        for t in ticks {
            // Its chunk's ticks changed, so it's to be saved (CAL-148).
            self.touched(ChunkPos { x: t.x >> 4, z: t.z >> 4 }.pack())
            match tick_fluid(shared.value, mut self, t.kind, t.x, t.y, t.z) {
                ok => {},
                err(thrown) => self.report(thrown.message),
            }
        }
    }

    /// How many block and fluid ticks the level has, scheduled and saved, as `LevelTicks.count`
    /// counts them.
    pub fn tick_count(self) -> (usize, usize) {
        return (self.block_ticks.count(), self.fluid_ticks.count())
    }

    /// Gives the level what a block's shape and its survival read, the block facts and the
    /// dimension's light, as the network has them once the registries are read. Till then, a
    /// block set tells nothing around it (D326), and a chunk that comes to tick waits to be
    /// post-processed until it's given them (D329).
    pub fn set_env(mut self, env: own Env) {
        self.env = some(Shared(env))
        let moving = self.moving_waiting.copy()
        self.moving_waiting.clear()
        for k in moving {
            if self.full(unpacked(k)) {
                self.load_tickers(k)
            }
        }
        // The chunks that came to tick without them, the spawn's at the server's start, are
        // post-processed now, in the order they came to, each that still ticks (D329).
        var waiting = List<i64>()
        for k in self.post_waiting {
            waiting.push(k)
        }
        self.post_waiting.clear()
        for k in waiting {
            if self.sendable(unpacked(k)) {
                self.post_process_lit(k)
            }
        }
    }

    /// What `set_env` gave it, shared, or none before (D376).
    pub fn shared_env(self) -> Shared<Env>? {
        return self.env.copy()
    }

    /// `sendBlockUpdated`: the block at `x`, `y`, `z` sent again to the players who have its
    /// chunk, with the blocks set as the chunks next broadcast, as it is then (D376).
    pub fn block_updated(mut self, x: i32, y: i32, z: i32) {
        let state = self.block_state(x, y, z) ?? AIR_STATE
        self.sent_block(ChunkPos { x: x >> 4, z: z >> 4 }, x, y, z, state, state, UPDATE_CLIENTS)
    }

    /// Whether the level has `set_env`'s.
    pub fn has_env(self) -> bool {
        return match self.env {
            some(_) => true,
            none => false,
        }
    }

    /// The items and orbs dropped since this was last asked, in the order they were popped
    /// (CAL-153, CAL-154).
    pub fn take_dropped(mut self) -> List<Dropped> {
        let out = self.dropped.copy()
        self.dropped.clear()
        return out
    }

    /// The level events since this was last asked, in the order they came (D326), with what else
    /// the players heard since let go.
    pub fn take_events(mut self) -> List<LevelEvent> {
        var out = List<LevelEvent>()
        for h in self.events {
            match h {
                Heard.Event(e) => out.push(e),
                _ => {},
            }
        }
        self.events.clear()
        return out
    }

    /// `playSeededSound(null, x, y, z, ...)` at an entity, such as a player: the sound `sound`,
    /// among `SoundSource`'s `source`, at a volume and pitch of 1, with a seed of its own, as the
    /// entity draws one from its own random, which nothing else reads (D372).
    pub fn play_entity_sound(mut self, sound: own String, x: f64, y: f64, z: f64, source: i32) {
        self.sound_seeds += -7046029254386353131
        let seed = mix_stafford13(self.sound_seeds)
        self.events.push(Heard.Sound(LevelSound { sound: sound, x: x, y: y, z: z, volume: 1.0f32, pitch: 1.0f32, seed: seed, source: source }))
    }

    /// The dust a living entity throws up landing on `state`, as `checkFallDamage` sends it,
    /// `ParticleTypes.BLOCK` of the state, `count` of it spread nowhere at 0.15 (CAL-155).
    pub fn fall_dust(mut self, state: u32, x: f64, y: f64, z: f64, count: i32) {
        self.events.push(Heard.Particles(LevelParticles { particle: String("block"), state: i32.wrap(state), x: x, y: y, z: z, count: count, dx: 0.0f32, dy: 0.0f32, dz: 0.0f32, speed: f32.nearest(f64(0.15f32)) }))
    }

    /// `playSound` with no player of `sound` at x, y, z from `source`, at `volume` and `pitch`,
    /// as an entity's own sound plays it (CAL-148).
    pub fn play_sound_from_source(mut self, sound: own String, x: f64, y: f64, z: f64, source: i32, volume: f32, pitch: f32) {
        self.sound_seeds += -7046029254386353131
        let seed = mix_stafford13(self.sound_seeds)
        self.events.push(Heard.Sound(LevelSound { sound: sound, x: x, y: y, z: z, volume: volume, pitch: pitch, seed: seed, source: source }))
    }

    /// What the players heard since this was last asked, in the order it happened, for the
    /// network to send: level events, sounds and block events (CAL-125).
    pub fn take_heard(mut self) -> List<Heard> {
        let out = self.events.copy()
        self.events.clear()
        return out
    }

    /// How many moving pistons' block entities the level holds (CAL-125).
    pub fn moving_piston_count(self) -> usize {
        return self.motions.len()
    }

    /// The number of the block entity at `x`, `y`, `z` a menu opened on, `Openers.id`, 0 where
    /// it's none a menu's opened on, or gone (CAL-144).
    pub fn opened_id(self, x: i32, y: i32, z: i32) -> u64 {
        let o = self.container_openers.get(BlockPos { x: x, y: y, z: z }.pack()) else return 0
        return o.id
    }

    /// Runs the block events waiting, as `runBlockEvents` does once the chunks have ticked
    /// (CAL-125): first come first, with those they add after them, each in a chunk whose blocks
    /// tick run if the block it's for is still there, `doBlockEvent`, and heard by its players if
    /// it did anything; each in a chunk that doesn't, kept for the next tick.
    pub fn run_block_events(mut self) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let Env { facts: f, .. } = shared.value
        var later = List<BlockEvent>()
        while not self.block_events.is_empty() {
            let e = self.block_events.remove(0)
            if not self.dm.in_block_ticking_range(ChunkPos { x: e.x >> 4, z: e.z >> 4 }.pack()) {
                later.push(e)
                continue
            }
            let state = self.state_or_report(f, e.x, e.y, e.z) else continue
            if f.block(state) != e.block {
                continue
            }
            let ran = match self.trigger(shared.value, state, e) {
                ok(r) => r,
                err(thrown) => {
                    self.report(thrown.message)
                    false
                },
            }
            if ran {
                self.events.push(Heard.Block(e))
            }
        }
        for e in later {
            self.add_block_event(e)
        }
    }

    /// Ticks the block entities, as `tickBlockEntities` does after the entities (CAL-125): those
    /// added since they last ticked put at the end first, then each in turn, one taken away
    /// since dropped as it's come to, and one in a chunk whose blocks tick, within the border,
    /// whose block is still of its type, ticked: a moving piston's as `world.pistons` has it, and
    /// the others as `world.block_entity_ticks` has them (CAL-130).
    pub fn tick_block_entities(mut self) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let Env { facts: f, .. } = shared.value
        self.ticking_entities = true
        let added = self.pending_tickers.copy()
        self.pending_tickers.clear()
        for t in added {
            self.tickers.push(t)
        }
        var kept = List<Ticker>()
        var i: usize = 0
        while i < self.tickers.len() {
            let t = self.tickers[i]
            i += 1
            let p = t.pos.pack()
            if (self.ticker_ids.get(p) ?? 0) != t.id {
                continue
            }
            if not self.ticks_block_entity(t.pos) {
                kept.push(t)
                continue
            }
            let state = self.block_state(t.pos.x, t.pos.y, t.pos.z) ?? f.ids.air_state
            if f.block_entity_type(f.block(state)) != t.kind {
                kept.push(t)
                continue
            }
            kept.push(Ticker { pos: t.pos, id: t.id, kind: t.kind, first: false })
            let ticker = self.ticker_kinds.get(p) ?? NO_TICKER
            if ticker != PISTON_TICKER {
                match tick_block_entity(f, mut self, ticker, t.first, state, t.pos.x, t.pos.y, t.pos.z) {
                    ok => {},
                    err(thrown) => self.report(thrown.message),
                }
                continue
            }
            let m = self.motions.get(p) else continue
            match tick_moving(shared.value, mut self, t.pos.x, t.pos.y, t.pos.z, m) {
                ok(next) => {
                    if let n = next {
                        if (self.ticker_ids.get(p) ?? 0) == t.id {
                            self.set_motion(t.pos, n)
                        }
                    }
                },
                err(thrown) => self.report(thrown.message),
            }
        }
        self.tickers = kept
        self.ticking_entities = false
    }

    // `triggerEvent` of the block event `ev` on `state`: a piston's, as `world.pistons` has it; a
    // note block's, as `world.block_updates` has it; a bell's ring, which its block entity takes,
    // shaking it, and nothing else (CAL-124); a decorated pot's wobble, the same (CAL-142); the
    // others' come with their blocks.
    fn trigger(mut self, e: Env, state: u32, ev: BlockEvent) -> bool ! Thrown {
        let Env { facts: f, .. } = e
        let block = f.block(state)
        if block == f.ids.piston or block == f.ids.sticky_piston {
            return try trigger_event(e, mut self, state, ev.x, ev.y, ev.z, ev.b0, ev.b1)
        }
        let kind = f.class_name(block)
        if kind == "NoteBlock" {
            return try note_block_event(f, mut self, state, ev.x, ev.y, ev.z)
        }
        if kind == "BellBlock" {
            return ev.b0 == 1
        }
        // A decorated pot's wobble, either of its two styles, which its client shows (CAL-142).
        if kind == "DecoratedPotBlock" {
            return ev.b0 == 1 and ev.b1 >= 0 and ev.b1 < 2
        }
        // A chest's lid and an ender chest's, by how many have it open, which their clients show,
        // and a shulker box's, which opens or closes its lid (CAL-144).
        let entity = f.block_entity_kind(block) ?? String()
        if entity == "minecraft:chest" or entity == "minecraft:trapped_chest" or entity == "minecraft:ender_chest" {
            return ev.b0 == 1
        }
        if entity == "minecraft:shulker_box" {
            return shulker_event(mut self, ev.x, ev.y, ev.z, ev.b0, ev.b1)
        }
        fail Thrown { exception: "Unimplemented", message: "triggerEvent of {kind}" }
    }

    // `blockEvents.add`: kept at the end, unless the same one waits already.
    fn add_block_event(mut self, e: BlockEvent) {
        for w in self.block_events {
            if w.x == e.x and w.y == e.y and w.z == e.z and w.block == e.block and w.b0 == e.b0 and w.b1 == e.b1 {
                return
            }
        }
        self.block_events.push(e)
    }

    // `BoundTickingBlockEntity.tick`'s `isTicking` and `shouldTickBlocksAt`: whether a block
    // entity at `pos` ticks, within the border, in a chunk whose blocks tick, with its entities.
    fn ticks_block_entity(self, pos: BlockPos) -> bool {
        let chunk = pos.chunk()
        return self.place.in_border(pos.x, pos.z) and self.dm.in_block_ticking_range(chunk.pack()) and self.sendable(chunk)
    }

    // `updateBlockEntityTicker` for a block entity new at `pos`, of the type `kind`, whose ticker
    // is `ticker`: a ticker of its own, at the end, or, while they tick, after them.
    fn add_ticker(mut self, pos: BlockPos, kind: i32, ticker: i32) {
        let id = self.next_ticker
        self.next_ticker += 1
        let p = pos.pack()
        self.ticker_ids.insert(p, id)
        self.ticker_kinds.insert(p, ticker)
        let k = pos.chunk().pack()
        if not self.chunk_tickers.contains(k) {
            self.chunk_tickers.insert(k, List<i64>())
        }
        self.chunk_tickers[k].push(p)
        let t = Ticker { pos: pos, id: id, kind: kind, first: true }
        if self.ticking_entities {
            self.pending_tickers.push(t)
        } else {
            self.tickers.push(t)
        }
    }

    // What the moving piston at `pos` holds now, `m`, kept, and in its block entity as it saves:
    // its `progress`, `progressO`.
    fn set_motion(mut self, pos: BlockPos, m: MovingPiston) {
        self.motions.insert(pos.pack(), m)
        let k = pos.chunk().pack()
        self.columns.own_block_entities(k)
        if not self.columns.block_entities[k].contains(pos) {
            return
        }
        var tags = match self.columns.block_entities[k][pos] {
            Tag.Compound(t) => t.copy(),
            _ => return,
        }
        tags.insert("progress", Tag.Float(m.progress_o))
        self.columns.block_entities[k].insert(pos, Tag.Compound(tags))
        self.touched(k)
    }

    // The block entities the chunk at `k` was saved with, ticking once it's full, as
    // `registerAllBlockEntitiesAfterLevelLoad` adds the tickers their blocks give them, in its
    // map's order, a moving piston's with what it moves; once the level has its block facts,
    // which read what they move and which tick (CAL-130). One whose block isn't of its type isn't
    // made, as `loadStatic` makes none.
    fn load_tickers(mut self, k: i64) {
        let some_env = self.env.copy()
        let shared = some_env else {
            self.moving_waiting.push(k)
            return
        }
        let Env { facts: f, sky_light: sky, .. } = shared.value
        let map = self.columns.block_entities_of(k)
        for (pos, saved) in map {
            let kind = kind_of(saved) ?? String()
            let state = self.block_state(pos.x, pos.y, pos.z) ?? f.ids.air_state
            if (f.block_entity_kind(f.block(state)) ?? String()) != kind {
                continue
            }
            let ticker = ticker_of(f, sky, kind, state)
            if ticker == NO_TICKER {
                continue
            }
            let p = pos.pack()
            if ticker == PISTON_TICKER {
                let m = moving_of(f, saved) else continue
                self.motions.insert(p, m)
            }
            if self.ticker_ids.contains(p) {
                self.ticker_kinds.insert(p, ticker)
            } else {
                self.add_ticker(pos, f.block_entity_type(f.block(state)), ticker)
            }
        }
    }

    // `updateBlockEntityTicker` for the block entity at `pos` of the chunk at `k`, on `state`, as
    // `setBlockState` and `addAndRegisterBlockEntity` run it (CAL-130): its ticker taken away
    // where its block gives it none, `removeBlockEntityTicker`; else the one it has kept in its
    // place with the ticker it's given now, `rebind`, or, in a full chunk, `isInLevel`, a new one.
    fn update_ticker(mut self, f: Facts, k: i64, pos: BlockPos, state: u32) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let Env { sky_light: sky, .. } = shared.value
        let kind = f.block_entity_kind(f.block(state)) else return
        let ticker = ticker_of(f, sky, kind, state)
        let p = pos.pack()
        if ticker == NO_TICKER {
            _ = self.ticker_ids.remove(p)
            _ = self.ticker_kinds.remove(p)
            return
        }
        if self.ticker_ids.contains(p) {
            self.ticker_kinds.insert(p, ticker)
            return
        }
        if self.full(unpacked(k)) {
            self.add_ticker(pos, f.block_entity_type(f.block(state)), ticker)
        }
    }

    // The chunk at `k` unloaded: its block entities' tickers go, as `clearAllBlockEntities` takes
    // them away, and its moving pistons with them.
    fn drop_tickers(mut self, k: i64) {
        var gone = List<i64>()
        for (p, _) in self.motions {
            if BlockPos.unpack(p).chunk().pack() == k {
                gone.push(p)
            }
        }
        for p in gone {
            _ = self.motions.remove(p)
        }
        // And what its containers held of who has them open (CAL-144).
        var closed = List<i64>()
        for (p, _) in self.container_openers {
            if BlockPos.unpack(p).chunk().pack() == k {
                closed.push(p)
            }
        }
        for p in closed {
            _ = self.container_openers.remove(p)
        }
        let places = self.chunk_tickers.remove(k) ?? List<i64>()
        for p in places {
            _ = self.ticker_ids.remove(p)
            _ = self.ticker_kinds.remove(p)
        }
    }

    // Says once that `what` isn't in Calcite yet: the level goes on without it.
    fn report(mut self, what: String) {
        if self.reported.contains(what) {
            return
        }
        self.reported.insert(what.copy())
        self.lines.push(Entry.warn("{what} isn't in Calcite yet, so it's left out"))
    }

    // The state at the block, or `none`, reported, where it can't be read.
    fn state_or_report(mut self, f: Facts, x: i32, y: i32, z: i32) -> u32? {
        return match self.state(f, x, y, z) {
            ok(s) => some(s),
            err(t) => {
                self.report(t.message)
                none
            },
        }
    }

    // `CollectingNeighborUpdater.addAndRun`: the update `u`, from the block at x, y, z, run at
    // once if none is running, or kept for when the one running is done; past
    // `max-chained-neighbor-updates` in one chain, dropped, with an error the first time.
    fn add_and_run(mut self, x: i32, y: i32, z: i32, u: own Update) {
        let was_running = self.update_count > 0
        let over = self.max_chained >= 0 and self.update_count >= self.max_chained
        self.update_count += 1
        if not over {
            if was_running {
                self.update_added.push(u)
            } else {
                self.update_stack.push(u)
            }
        } else if self.update_count - 1 == self.max_chained {
            self.lines.push(Entry.error("Too many chained neighbor updates. Skipping the rest. First skipped position: {x}, {y}, {z}"))
        }
        if not was_running {
            self.run_updates()
        }
    }

    // `CollectingNeighborUpdater.runUpdates`: the updates added while one runs go on top of the
    // stack, the first added on top, and the top runs a step at a time until it's done or adds
    // more.
    fn run_updates(mut self) {
        while not self.update_stack.is_empty() or not self.update_added.is_empty() {
            var i = self.update_added.len()
            while i > 0 {
                i -= 1
                self.update_stack.push(self.update_added[i])
            }
            self.update_added.clear()
            let top = self.update_stack.len() - 1
            while self.update_added.is_empty() {
                let u = self.update_stack[top]
                if not self.run_next(top, u) {
                    _ = self.update_stack.pop()
                    break
                }
            }
        }
        self.update_stack.clear()
        self.update_added.clear()
        self.update_count = 0
    }

    // `runNext` of the update `u`, at `top` of the stack: whether it has more to run.
    fn run_next(mut self, top: usize, u: Update) -> bool {
        match u {
            Update.Shape { d, neighbour, x, y, z, flags, limit } => {
                self.shape_update(d, x, y, z, neighbour, flags, limit)
                return false
            },
            Update.Simple { x, y, z, source } => {
                let some_env = self.env.copy()
                let shared = some_env else return false
                let Env { facts: f, .. } = shared.value
                let state = self.state_or_report(f, x, y, z) else return false
                self.neighbour_update(state, x, y, z, source, false)
                return false
            },
            Update.Full { state, x, y, z, source, moved } => {
                self.neighbour_update(state, x, y, z, source, moved)
                return false
            },
            Update.Multi { x, y, z, source, skip, next } => {
                let d = update_order(next)
                var after = next + 1
                if after < 6 and update_order(after) == skip {
                    after += 1
                }
                // Moved on before it runs, which adds only to `update_added`.
                self.update_stack[top] = Update.Multi { x: x, y: y, z: z, source: source, skip: skip, next: after }
                let nx = x + step_x(d)
                let ny = y + step_y(d)
                let nz = z + step_z(d)
                let some_env = self.env.copy()
                if let shared = some_env {
                    let Env { facts: f, .. } = shared.value
                    if let state = self.state_or_report(f, nx, ny, nz) {
                        self.neighbour_update(state, nx, ny, nz, source, false)
                    }
                }
                return after < 6
            },
        }
    }

    // `NeighborUpdater.executeShapeUpdate`: the block at x, y, z, but redstone wire with
    // `UPDATE_SKIP_SHAPE_UPDATE_ON_WIRE`, takes the shape the block toward `d`, `neighbour`, gives
    // it, or is broken.
    fn shape_update(mut self, d: i32, x: i32, y: i32, z: i32, neighbour: u32, flags: i32, limit: i32) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let Env { facts: f, .. } = shared.value
        let state = self.state_or_report(f, x, y, z) else return
        if flags & UPDATE_SKIP_SHAPE_UPDATE_ON_WIRE != 0 and f.block(state) == f.ids.redstone_wire {
            return
        }
        let made = match update_shape(shared.value, mut self, state, x, y, z, d, neighbour) {
            ok(s) => s,
            err(t) => {
                self.report(t.message)
                return
            },
        }
        match update_or_destroy(shared.value, mut self, state, made, x, y, z, flags, limit) {
            ok => {},
            err(t) => self.report(t.message),
        }
    }

    // `NeighborUpdater.executeUpdate`: the block `state` at x, y, z told `source` beside it
    // changed.
    fn neighbour_update(mut self, state: u32, x: i32, y: i32, z: i32, source: u32, moved: bool) {
        let some_env = self.env.copy()
        let shared = some_env else return
        match on_neighbour_changed(shared.value, mut self, state, x, y, z, source, moved) {
            ok => {},
            err(t) => self.report(t.message),
        }
    }

    // `updateNeighborsAt`: the six around the block at x, y, z told `source` there changed, as
    // one `MultiNeighborUpdate`.
    fn update_neighbours_at(mut self, x: i32, y: i32, z: i32, source: u32) {
        self.add_and_run(x, y, z, Update.Multi { x: x, y: y, z: z, source: source, skip: -1, next: 0 })
    }

    // `BlockState.updateNeighbourShapes`: each of the six around the block at x, y, z, in
    // `UPDATE_SHAPE_ORDER`, told its shape is `state`'s, `neighborShapeChanged`.
    fn update_neighbour_shapes(mut self, state: u32, x: i32, y: i32, z: i32, flags: i32, limit: i32) {
        var i = 0
        while i < 6 {
            let d = shape_order(i)
            let nx = x + step_x(d)
            let ny = y + step_y(d)
            let nz = z + step_z(d)
            self.add_and_run(nx, ny, nz, Update.Shape { d: opposite(d), neighbour: state, x: nx, y: ny, z: nz, flags: flags, limit: limit })
            i += 1
        }
    }

    // `BlockState.updateIndirectNeighbourShapes`, which only redstone wire's does something,
    // `RedstoneWireBlock`'s: toward each side, in `Direction.Plane.HORIZONTAL`'s order, it's
    // joined to where what's there isn't wire, the wire below that, then above, told its shape
    // from the block below or above x, y, z, as that is now (CAL-116).
    fn update_indirect_shapes(mut self, f: Facts, state: u32, x: i32, y: i32, z: i32, flags: i32, limit: i32) {
        let wire = f.ids.redstone_wire
        if f.block(state) != wire {
            return
        }
        for i in 0..4 {
            let d = horizontal(i)
            if (f.get_name(state, direction_property(d)) ?? String("none")) == "none" {
                continue
            }
            let (nx, nz) = (x + step_x(d), z + step_z(d))
            let beside = self.state_or_report(f, nx, y, nz) else continue
            if f.block(beside) == wire {
                continue
            }
            for dy in [-1, 1] {
                let there = self.state_or_report(f, nx, y + dy, nz) else continue
                if f.block(there) == wire {
                    let neighbour = self.state_or_report(f, x, y + dy, z) else continue
                    self.add_and_run(nx, y + dy, nz, Update.Shape { d: opposite(d), neighbour: neighbour, x: nx, y: y + dy, z: nz, flags: flags, limit: limit })
                }
            }
        }
    }

    // The block at x, y, z as it is, where its chunk's full.
    fn block_state(self, x: i32, y: i32, z: i32) -> u32? {
        return self.collision_state(x, y, z)
    }

    /// Gives the level the tickets its dimension's `chunk_tickets` saved, all deactivated, as
    /// `TicketStorage.fromPacked` keeps them, until `activate_saved_tickets` (D319).
    pub fn load_tickets(mut self, saved: own TicketStorage) {
        self.dm.tickets = saved
    }

    /// Activates the tickets the level was given, as `activateAllDeactivatedTickets`, and
    /// settles the distance manager, and gives the chunks they're to load full that weren't
    /// before, holders at a full chunk's level or lower, as `ChunkLoadCounter.track` finds them
    /// (D319).
    pub fn activate_saved_tickets(mut self) -> List<ChunkPos> {
        self.pump()
        var before = OpenHashSet<i64>()
        for k in self.dm.holder_chunks() {
            if self.dm.chunk_level(k, false) <= FULL_LEVEL {
                before.insert(k)
            }
        }
        self.dm.activate_saved()
        self.pump()
        var wanted = List<ChunkPos>()
        for k in self.dm.holder_chunks() {
            if self.dm.chunk_level(k, false) <= FULL_LEVEL and not before.contains(k) {
                wanted.push(unpacked(k))
            }
        }
        return wanted
    }

    /// Whether the light of each chunk of `chunks` is here, as `keep_light` keeps it, or the flat
    /// world's is theirs (D320).
    pub fn has_light(self, chunks: List<ChunkPos>) -> bool {
        if not self.lighting {
            return true
        }
        for pos in chunks {
            if not self.light_data.contains(pos.pack()) and not self.flat_around(pos) {
                return false
            }
        }
        return true
    }

    /// Whether each chunk of `chunks` is full, as `ChunkLoadCounter.pendingChunks` counts those
    /// that aren't (D319).
    pub fn all_full(self, chunks: List<ChunkPos>) -> bool {
        for pos in chunks {
            if not self.full(pos) {
                return false
            }
        }
        return true
    }

    /// The tickets as the dimension's `chunk_tickets` saves them, if one that persists has come
    /// or gone since they were last taken, as vanilla marks its `TicketStorage` (D319).
    pub fn take_dirty_tickets(mut self) -> Tag? {
        if not self.dm.tickets.dirty {
            return none
        }
        self.dm.tickets.dirty = false
        return some(self.dm.tickets.pack())
    }

    /// Whether the chunk at `pos` is in range for its entities to tick, `inEntityTickingRange`.
    pub fn entity_ticking(self, pos: ChunkPos) -> bool {
        return self.dm.in_entity_ticking_range(pos.pack())
    }

    /// The world's part of a tick, as `ServerChunkCache.tick` runs it: the tickets run down, the
    /// distance manager settles, and the holders that dropped unload, with their chunks and their
    /// light, which light's next step takes away. Vanilla unloads as many as it has time for, and
    /// Calcite all of them.
    pub fn tick(mut self) {
        self.tick_tickets()
        self.tick_unload()
    }

    /// The first part of `tick`, before the chunks' own tick, `tickChunks`: the tickets run down
    /// and the distance manager settles.
    pub fn tick_tickets(mut self) {
        self.dm.purge_stale(self.reading)
        self.pump()
    }

    /// The last part of `tick`, after `tickChunks`: what dropped unloads.
    pub fn tick_unload(mut self) {
        _ = self.dm.drop_unloaded()
        while self.dm.unload_next() {
        }
        for k in self.dm.take_unloaded() {
            self.unloaded(k)
        }
        self.flush_light()
    }

    /// Runs the distance manager until it settles: its updates, which load the chunks the
    /// holders' levels call for; the dispatcher's jobs and the main thread's tasks, until
    /// neither has any; then, with light run here as a test has it, light's steps; then each
    /// holder waiting for its chunk to tick its entities, whose 5×5 is full, is let go; as long
    /// as any of those does something. What light's to be told goes to its thread then.
    pub fn pump(mut self) {
        loop {
            var any = self.dm.run_all_updates()
            for k in self.dm.take_changed() {
                self.changed(k)
            }
            if self.drain() {
                any = true
            }
            if self.light_eager and self.step_here() {
                any = true
            }
            if self.ready_waiting() {
                any = true
            }
            if not any {
                self.check_ticks()
                self.flush_light()
                return
            }
        }
    }

    /// The next step light's thread has done, which the network records, then hands to
    /// `light_done`, or `none` if it's done none since this was last asked.
    pub fn take_light(mut self) -> LightDone? {
        var back = self.light_back.take() else return none
        let d = back.next()
        self.light_back = some(back)
        return d
    }

    /// Takes in a step of light: the chunks it initialized and lit, those whose light changed,
    /// the light wanted for packets and the light the chunks that went are saved with. A chunk
    /// lit since it was saved, or whose light changed once it was lit, is to be saved again
    /// (D258). Then the distance manager settles.
    pub fn light_done(mut self, done: own LightDone) {
        self.take_in(done)
        self.pump()
    }

    /// Has light, run here, take the step the recording's took, which had taken `covered` asks
    /// by its end, and takes it in, as `light_done`. `false` if light hasn't been told that many,
    /// or had by the last step, or the step does nothing, which only a replay that's gone another
    /// way hands over.
    pub fn replay_light(mut self, covered: u64) -> bool {
        var s = self.light_here.take() else return false
        let had = s.covered()
        if covered < had or covered - had > u64(self.light_asks.len()) {
            self.light_here = some(s)
            return false
        }
        let d = s.step(mut self.light_asks, usize.wrap(covered - had))
        self.light_here = some(s)
        let done = d else return false
        self.light_done(done)
        return true
    }

    /// Sets the player whose sender asks next, whose far chunks are read for them.
    pub fn serve(mut self, player: i32) {
        self.serving = player
    }

    /// The chunk at `pos` as it's sent, `ClientboundLevelChunkWithLightPacket`'s ID and fields:
    /// as it was saved, or flat, with the light light gave for it. A flat chunk whose neighbours
    /// are flat is the flat world's body. A far chunk read for a player has its light as it was
    /// saved, and goes once it's sent. Block entities aren't sent yet.
    ///
    /// A holder's chunk sent with light's light is kept if `keep`, as another player is still to
    /// be sent it, and is what's sent until it changes; one kept is taken if not `keep`, and its
    /// light isn't wanted any more. Once it's compressed, what's sent is its frame's body.
    pub fn packet(mut self, pos: ChunkPos, flat: FlatWorld, keep: bool) -> ChunkPacket {
        let k = pos.pack()
        if self.block_entity_ids.is_empty() {
            self.block_entity_ids = block_entity_ids()
        }
        if self.packets.contains(k) {
            if keep {
                return self.packets[k].copied(k)
            }
            if let p = self.packets.remove(k) {
                self.release(k)
                return p.taken()
            }
        }
        if self.columns.slots.contains(k) {
            var made: List<u8>? = none
            if self.opened {
                let light = self.light_for(k, keep)
                let entities = self.columns.block_entities_of(k)
                if self.columns.live.contains(k) {
                    let infos = self.infos(entities, self.columns.live[k])
                    made = some(chunk_packet(pos, self.columns.live[k], light, infos))
                } else {
                    match self.columns.slots[k] {
                        Body.Saved(s) => {
                            let infos = self.infos(entities, s.chunk.value)
                            made = some(chunk_packet(pos, s.chunk.value, light, infos))
                        },
                        Body.Flat => {
                            if not self.flat_around(pos) {
                                if let f = self.columns.flat {
                                    made = some(chunk_packet(pos, f.chunk, light, []))
                                }
                            }
                        },
                        Body.Loading => {},
                    }
                }
            }
            if let p = made {
                if keep {
                    self.versions += 1
                    self.packets.insert(k, Kept { packet: some(p.copy()), body: none, threshold: -1, version: self.versions })
                    return ChunkPacket.Shared { packet: p, key: k, version: self.versions }
                }
                self.release(k)
                return ChunkPacket.Plain(p)
            }
            return ChunkPacket.Plain(flat.chunk_packet(pos.x, pos.z))
        }
        if self.far.contains(k) {
            var packet: List<u8>? = none
            match self.far[k].body {
                Body.Saved(s) => {
                    let saved = if let r = s.rest { r.block_entities() } else { List<Tag>() }
                    let infos = self.infos(block_entity_map(saved), s.chunk.value)
                    packet = some(chunk_packet(pos, s.chunk.value, s.saved_light(), infos))
                },
                _ => {},
            }
            self.free_far(k)
            if let p = packet {
                return ChunkPacket.Plain(p)
            }
        }
        return ChunkPacket.Plain(flat.chunk_packet(pos.x, pos.z))
    }

    // What a chunk's packet sends of the block entities in its map, `map`, with `chunk`'s blocks
    // saying which are trial spawners that are active, where the level has the block facts
    // (CAL-115).
    fn infos(self, map: OpenHashMap<BlockPos, Tag>, chunk: Chunk) -> List<BlockEntityInfo> {
        if map.is_empty() {
            return List<BlockEntityInfo>()
        }
        var active = Set<i64>()
        let some_env = self.env.copy()
        if let shared = some_env {
            let Env { facts: f, .. } = shared.value
            for (pos, _) in map {
                if pos.y >= chunk.min_y() and pos.y < chunk.min_y() + i32.wrap(chunk.section_count()) * 16 {
                    let state = chunk.block(pos.x & 15, pos.y, pos.z & 15)
                    if (f.get_name(state, String("trial_spawner_state")) ?? String()) == "active" {
                        active.insert(pos.pack())
                    }
                }
            }
        }
        return block_entity_infos(map, active, self.block_entity_ids)
    }

    // `broadcastBlockEntityIfNeeded`: where `state`, at `pos` in the chunk at `k`, has a block
    // entity whose class sends one, its update packet, with the level's block facts. The block
    // entity is as `Level.getBlockEntity` gives it, made where there's none, as `IMMEDIATE` makes
    // it.
    fn update_packet(mut self, k: i64, pos: BlockPos, state: u32) -> ClientboundBlockEntityData? {
        let some_env = self.env.copy()
        let shared = some_env else return none
        let Env { facts: f, .. } = shared.value
        if not f.has_block_entity(state) {
            return none
        }
        let kind = f.block_entity_kind(f.block(state)) else return none
        if not sends_update_packet(kind.copy()) {
            return none
        }
        var tag = self.block_entity_at(k, pos)
        if tag == none {
            self.make_block_entity(f, k, pos, state)
            tag = self.block_entity_at(k, pos)
        }
        let saved = tag else return none
        let tags = match saved {
            Tag.Compound(m) => m.copy(),
            _ => return none,
        }
        if self.block_entity_ids.is_empty() {
            self.block_entity_ids = block_entity_ids()
        }
        let id = self.block_entity_ids.get(kind) else return none
        let active = (f.get_name(state, String("trial_spawner_state")) ?? String()) == "active"
        return some(ClientboundBlockEntityData { pos: pos, kind: id, tag: Tag.Compound(update_tag(kind, tags, active)) })
    }

    // The block entity at `pos` in the chunk at `k`, as it saves, if it has one: in its map where a
    // block set changed them, else as its rest saved it, the last saved there.
    fn block_entity_at(self, k: i64, pos: BlockPos) -> Tag? {
        if self.columns.block_entities.contains(k) {
            if self.columns.block_entities[k].contains(pos) {
                return some(self.columns.block_entities[k][pos].copy())
            }
            return none
        }
        var found: Tag? = none
        for t in self.columns.rests.block_entities(k) {
            if place_of(t) == some(pos) {
                found = some(t.copy())
            }
        }
        return found
    }

    // `removeBlockEntity`: the block entity at `pos` in the chunk at `k` taken away, if it has one;
    // with `effects`, what it holds dropped first, `preRemoveSideEffects`, which isn't yet.
    fn remove_block_entity(mut self, k: i64, pos: BlockPos, effects: bool) {
        // A moving piston's goes with what it moves and its ticker (CAL-125), and a container's
        // with who had it open (CAL-144).
        _ = self.motions.remove(pos.pack())
        _ = self.container_openers.remove(pos.pack())
        _ = self.ticker_ids.remove(pos.pack())
        _ = self.ticker_kinds.remove(pos.pack())
        self.columns.own_block_entities(k)
        if not self.columns.block_entities[k].contains(pos) {
            return
        }
        if effects and holds_anything(self.columns.block_entities[k][pos]) {
            self.report(String("What a block entity holds dropped as it's removed, `preRemoveSideEffects`"))
        }
        _ = self.columns.block_entities[k].remove(pos)
    }

    // The block entity of `state`, set at `pos` in the chunk at `k`, as `setBlockState` gives it
    // one: the one there kept if it's of the block's type, `isValidBlockState`, else a fresh one
    // of that type in its place, `newBlockEntity`, as `addAndRegisterBlockEntity` adds it. A
    // structure block's or test block's takes its mode from the state, as its constructor does
    // (CAL-124).
    fn make_block_entity(mut self, f: Facts, k: i64, pos: BlockPos, state: u32) {
        let kind = f.block_entity_kind(f.block(state)) else return
        self.columns.own_block_entities(k)
        if self.columns.block_entities[k].contains(pos) {
            if (kind_of(self.columns.block_entities[k][pos]) ?? String()) == kind {
                // `setBlockState` and `updateBlockEntityTicker` (CAL-130).
                self.update_ticker(f, k, pos, state)
                return
            }
            // One of another type is taken away, with a warning, as `setBlockState` does, and with
            // it who had it open (CAL-144).
            _ = self.columns.block_entities[k].remove(pos)
            _ = self.container_openers.remove(pos.pack())
        }
        // `MovingPistonBlock.newBlockEntity` makes none: a piston sets its own (CAL-125).
        if kind == "minecraft:piston" {
            return
        }
        var made = fresh(kind.copy()) else {
            self.report("A fresh {kind}")
            return
        }
        if kind == "minecraft:structure_block" or kind == "minecraft:test_block" {
            if let mode = f.get_name(state, "mode") {
                // `StructureMode.LEGACY_CODEC` saves its name in capitals.
                let saved = if kind != "minecraft:structure_block" { mode } else if mode == "save" { String("SAVE") } else if mode == "load" { String("LOAD") } else if mode == "corner" { String("CORNER") } else { String("DATA") }
                made.insert("mode", Tag.Str(saved))
            }
        }
        self.columns.block_entities[k].insert(pos, made_block_entity(kind, made, pos))
        self.update_ticker(f, k, pos, state)
    }

    /// Keeps the frame's body a player's encoder compressed a kept packet to, with `threshold`,
    /// in its place, if it's still kept: the packet the level gave as `key` and `version`. Its ID
    /// and fields go, unless `whole`, for a link that checks what's sent.
    pub fn compressed(mut self, key: i64, version: u64, frame_body: own List<u8>, threshold: i32, whole: bool) {
        if not self.packets.contains(key) or self.packets[key].version != version or self.packets[key].body != none {
            return
        }
        self.packets[key].body = some(frame_body)
        self.packets[key].threshold = threshold
        if not whole {
            self.packets[key].packet = none
        }
    }

    /// How many chunks' packets are kept for players still to be sent them.
    pub fn kept(self) -> usize {
        return self.packets.len()
    }

    /// How many of the packets kept are compressed.
    pub fn kept_compressed(self) -> usize {
        var n: usize = 0
        for (_, p) in self.packets {
            if p.body != none {
                n += 1
            }
        }
        return n
    }

    /// The light of the chunk at `pos` as light last gave it, once it's lit and while its light
    /// is wanted: what it's sent with, unless it's a flat chunk among flat ones. A test's level,
    /// whose light steps as it settles, wants it at once (D266).
    pub fn light_of(mut self, pos: ChunkPos) -> LightData? {
        let k = pos.pack()
        if not self.lit.contains(k) {
            return none
        }
        if self.light_eager and not self.light_data.contains(k) {
            if not self.watching.contains(k) {
                self.watch(k)
            }
            _ = self.step_here()
        }
        if not self.light_data.contains(k) {
            return none
        }
        return some(self.light_data[k].copy())
    }

    /// Hands what's to be read to the IO thread, and what light's to be told to its thread.
    /// Replaying, there's no IO thread: what the recording read comes from the log.
    pub fn dispatch(mut self) {
        self.flush_light()
        if self.asks.is_empty() {
            return
        }
        let asks = self.asks.copy()
        self.asks.clear()
        var jobs = self.jobs.take() else return
        for a in asks {
            match a {
                Ask.Region(r) => jobs.ask_region(r),
                Ask.Chunk(p) => jobs.ask_chunk(p),
                Ask.Drop(p) => jobs.drop_chunk(p),
            }
        }
        self.jobs = some(jobs)
    }

    /// Has the IO thread write the chunks it's been handed and close the region files, as the
    /// server stops, once each chunk whose light isn't saved is, with the light light has for it,
    /// as `saveAllChunks` saves them: this waits for light to give it. Those go from the level as
    /// they're handed over, not copied, as nothing ticks after.
    pub fn close_chunks(mut self) {
        var keys = List<i64>()
        for k in self.unsaved {
            keys.push(k)
        }
        for k in keys {
            let ticks = self.ticks_now(k)
            if let gone = self.columns.take(k) {
                _ = self.came_at.remove(k)
                if let whole = self.to_save(k, gone, ticks) {
                    self.save_lit(k, whole, false)
                }
            }
        }
        self.unsaved.clear()
        self.finish_light()
        var far = List<i64>()
        for (k, _) in self.far {
            far.push(k)
        }
        for k in far {
            self.free_far(k)
        }
        var jobs = self.jobs.take() else return
        jobs.close()
        self.jobs = some(jobs)
    }

    /// Whether the IO thread is still closing the region files.
    pub fn chunks_closing(self) -> usize {
        if let jobs = self.jobs {
            return jobs.closing()
        }
        return 0
    }

    /// What the IO thread and workers have done since this was last asked, in the order it came.
    pub fn take_done(mut self) -> Deque<Done> {
        var jobs = self.jobs.take() else return Deque<Done>()
        let done = jobs.take_done()
        self.jobs = some(jobs)
        return done
    }

    /// What `read` comes to, made on this thread as a worker makes it, with what it logs added
    /// to `lines`, for a replay, which has what was read and not what it came to. A chunk with
    /// nothing to use is generated here, as the recording's generator generated it.
    pub fn make(mut self, pos: ChunkPos, read: ChunkRead, lines: mut List<Entry>) -> Loaded {
        var loaded = Loaded.Generate
        if let context = self.context {
            if let f = self.columns.flat {
                loaded = prepare(pos, read, context, f.states, mut lines)
            }
        }
        match loaded {
            Loaded.Generate => return self.generate_here(pos, mut lines),
            _ => return loaded,
        }
    }

    // The chunk at `pos` generated on this thread, with the generator made the first time, or
    // flat if the world doesn't generate or the generator can't be made.
    fn generate_here(mut self, pos: ChunkPos, lines: mut List<Entry>) -> Loaded {
        if self.generator == none {
            let setup = self.gen.take() else return Loaded.Generate
            var made = List<Entry>()
            match setup_data(setup, mut made) {
                ok(zip) => {
                    match Generator.new(zip, setup.copy()) {
                        ok(g) => {
                            self.generator = some(g)
                            self.gen = some(setup)
                        },
                        err(e) => lines.push(Entry.error("Can't generate the world, so its chunks are flat: {e}").on(gen_thread())),
                    }
                },
                err(e) => lines.push(Entry.error("Can't generate the world, so its chunks are flat: {e}").on(gen_thread())),
            }
        }
        var g = self.generator.take() else return Loaded.Generate
        var loaded = Loaded.Generate
        if let f = self.columns.flat {
            loaded = match g.full(pos.x, pos.z) {
                ok(made) => {
                    let (chunk, rest) = made
                    Loaded.Saved(generated(chunk, rest, f.states, self.sections))
                },
                err(t) => {
                    lines.push(Entry.warn("Couldn't generate chunk [{pos.x}, {pos.z}], so it's flat: {t.exception}: {t.message}").on(gen_thread()))
                    Loaded.Generate
                },
            }
        }
        for p in g.problems {
            lines.push(Entry.warn(p.copy()).on(gen_thread()))
        }
        g.problems.clear()
        self.generator = some(g)
        return loaded
    }

    /// Takes in which chunks `region`'s file has, as the IO thread found them, with what it
    /// logged. `false` if it wasn't asked, which only a replay that's gone another way hands over.
    pub fn read_region(mut self, region: ChunkPos, io: List<Entry>, presence: own List<u64>) -> bool {
        let k = region.pack()
        if not self.regions.contains(k) {
            return false
        }
        match self.regions[k] {
            Region.Known(_) => return false,
            Region.Asked => {},
        }
        for e in io {
            self.lines.push(e.copy())
        }
        self.regions.insert(k, Region.Known(presence))
        return true
    }

    /// Takes in a read of the chunk at `pos`, with what the IO thread logged, which came to
    /// `loaded` with what that logged: a holder's chunk loads if the holder's still there, with
    /// its light given to the engine, and goes if not, and a far chunk loads if it's still
    /// wanted. Then the distance manager settles, and what can be lit is. `false` if no read of it was asked for, which only a replay that's gone another
    /// way hands over.
    pub fn read_chunk(mut self, pos: ChunkPos, io: List<Entry>, loaded: own Loaded, made: List<Entry>) -> bool {
        let k = pos.pack()
        let n = self.asked.get(k) ?? 0
        if n == 0 {
            return false
        }
        if n == 1 {
            _ = self.asked.remove(k)
        } else {
            self.asked.insert(k, n - 1)
        }
        self.dropping.remove(k)
        for e in io {
            self.lines.push(e.copy())
        }
        for e in made {
            self.lines.push(e.copy())
        }
        if self.reading.chunks.contains(k) {
            self.reading.chunks.remove(k)
            if self.held(k) {
                self.accept(k, loaded)
                self.pump()
            } else {
                _ = self.columns.take(k)
                self.stale(k)
                self.let_go(k, loaded)
            }
            return true
        }
        if self.far.contains(k) {
            let loading = match self.far[k].body {
                Body.Loading => true,
                _ => false,
            }
            if loading {
                let owner = self.far[k].owner
                self.far[k].body = body(loaded)
                self.far_loads.insert(owner, (self.far_loads.get(owner) ?? 1) - 1)
                return true
            }
        }
        self.let_go(k, loaded)
        return true
    }

    // The chunk at `k`, read, goes with nothing to take it: if the generator made it, it isn't on
    // the disk, so it's saved, unlit, to be read, not made again, when it's next asked for (D258).
    fn let_go(mut self, k: i64, loaded: own Loaded) {
        match loaded {
            Loaded.Saved(s) => self.let_go_body(k, Body.Saved(s)),
            Loaded.Generate => {},
        }
    }

    // As `let_go`, for a body held.
    fn let_go_body(mut self, k: i64, gone: own Body) {
        if self.gen == none {
            return
        }
        match gone {
            Body.Saved(s) => {
                if s.fresh and s.whole {
                    let SavedChunk { chunk: chunk, rest: rest, .. } = s
                    let r = rest else return
                    var jobs = self.jobs.take() else return
                    jobs.save_chunk(unpacked(k), Whole { chunk: chunk, rest: r }, none)
                    self.jobs = some(jobs)
                }
            },
            _ => {},
        }
    }

    /// Takes in that the generator didn't make the chunk at `pos`, as it was told nothing wanted
    /// it (D243), with what the IO thread and the workers logged: if a holder or a far read has it
    /// again, it's asked for again, and if not, it goes. `false` if no read of it was asked for,
    /// which only a replay that's gone another way hands over.
    pub fn withdrawn(mut self, pos: ChunkPos, io: List<Entry>, made: List<Entry>) -> bool {
        let k = pos.pack()
        let n = self.asked.get(k) ?? 0
        if n == 0 {
            return false
        }
        if n == 1 {
            _ = self.asked.remove(k)
        } else {
            self.asked.insert(k, n - 1)
        }
        self.dropping.remove(k)
        for e in io {
            self.lines.push(e.copy())
        }
        for e in made {
            self.lines.push(e.copy())
        }
        if self.reading.chunks.contains(k) {
            if self.held(k) {
                self.ask(k)
            } else {
                self.reading.chunks.remove(k)
                _ = self.columns.take(k)
                self.stale(k)
            }
            return true
        }
        if self.far.contains(k) {
            let loading = match self.far[k].body {
                Body.Loading => true,
                _ => false,
            }
            if loading {
                self.ask(k)
            }
        }
        return true
    }

    // The chunk at `k`'s holder's level changed: a full chunk with no chunk yet is loaded, or one
    // at 34 if chunks are read, to light those beside it with; light's told if it came to be full
    // or stopped being, as one that's full may be lit; and one whose entities are to tick waits
    // for the chunks around it.
    fn changed(mut self, k: i64) {
        self.ticks_to_check.insert(k)
        self.full_maybe.push(k)
        let level = self.dm.chunk_level(k, false)
        let reach = if self.opened { LIGHT_BORDER } else { FULL }
        if level <= reach and not self.columns.slots.contains(k) {
            self.stale(k)
            if self.opened {
                self.columns.put(k, Body.Loading)
                self.reading.chunks.insert(k)
                self.ask(k)
            } else {
                self.columns.put(k, Body.Flat)
                self.came_loaded(k)
            }
        }
        if self.opened {
            self.tell_full(k, level <= FULL)
        }
        if self.opened and level <= FULL and not self.lit.contains(k) {
            self.reading.unlit.insert(k)
        } else {
            self.reading.unlit.remove(k)
        }
        var waits = false
        if let h = self.dm.holder(k) {
            waits = h.ticking == Ticking.Waiting
        }
        if waits {
            if not self.waiting.contains(k) {
                self.waiting.insert(k, self.next_place)
                self.next_place += 1
            }
            self.recheck.insert(k)
        } else if self.waiting.contains(k) {
            self.recheck.insert(k)
        }
    }

    // `createTick`: a tick of `kind` at `x`, `y`, `z`, due in `delay` ticks with `priority`,
    // the next in the level's count of them.
    fn new_tick(mut self, kind: u32, x: i32, y: i32, z: i32, delay: i32, priority: i32) -> ScheduledTick {
        let sub = self.sub_ticks
        self.sub_ticks += 1
        return ScheduledTick { kind: kind, x: x, y: y, z: z, trigger: self.game_time + i64(delay), priority: priority, sub: sub }
    }

    // The chunks of `chunks` whose ticks run, as `isPositionTickingWithEntitiesLoaded` has it.
    fn ticking_of(self, chunks: List<i64>) -> OpenHashSet<i64> {
        var out = OpenHashSet<i64>()
        for k in chunks {
            if self.dm.in_block_ticking_range(k) and self.sendable(unpacked(k)) {
                out.insert(k)
            }
        }
        return out
    }

    // Looks at each chunk that may have come to be full or to tick, in the order it was noted:
    // one that's full gets its ticks, those it was saved with, as `registerTickContainerInLevel`
    // adds them, and one that ticks schedules those, as `startTickingChunk` does, from the game
    // time now (D322).
    fn check_ticks(mut self) {
        if self.ticks_to_check.is_empty() {
            return
        }
        var keys = List<i64>()
        for k in self.ticks_to_check {
            keys.push(k)
        }
        self.ticks_to_check.clear()
        for k in keys {
            let pos = unpacked(k)
            if not self.block_ticks.has_container(k) {
                if not self.full(pos) {
                    continue
                }
                var block = List<SavedTick>()
                var fluid = List<SavedTick>()
                if let saved = self.columns.rests.ticks(k) {
                    let (b, f) = saved
                    block = b
                    fluid = f
                }
                self.block_ticks.add_container(k, ChunkTicks.saved(block))
                self.fluid_ticks.add_container(k, ChunkTicks.saved(fluid))
                self.load_tickers(k)
            }
            if self.sendable(pos) {
                self.post_process_lit(k)
                self.block_ticks.unpack(k, self.game_time)
                self.fluid_ticks.unpack(k, self.game_time)
            }
        }
    }

    // The chunk at `k`, come to tick, post-processed once the level has its light, which what it
    // does reads, as a chunk vanilla ticks is lit (D329): at once if the light's here or there's
    // none to wait for, else once light gives it, which is asked for. One that marked nothing
    // has nothing to do.
    fn post_process_lit(mut self, k: i64) {
        if not self.columns.rests.marked(k) {
            return
        }
        if self.lighting and not self.light_data.contains(k) and not self.flat_around(unpacked(k)) {
            if not self.watching.contains(k) {
                self.watch(k)
            }
            if not self.light_eager {
                self.post_lit.insert(k)
                return
            }
            _ = self.step_here()
        }
        self.post_process_chunk(k)
    }

    // The chunk at `k`, coming to tick, post-processed as `postProcessGeneration` does it before
    // `startTickingChunk` and before it's sent (D329): each block its generation marked, in each
    // section from the bottom and in the order marked, done as `world.post_process` has it, and
    // the marks cleared from its rest, as vanilla clears each list, so it's done once. A level
    // without the block facts yet keeps the chunk waiting for them. What isn't in Calcite yet is
    // reported.
    fn post_process_chunk(mut self, k: i64) {
        let some_env = self.env.copy()
        let shared = some_env else {
            self.post_waiting.insert(k)
            return
        }
        let marks = self.columns.rests.take_marks(k)
        let pos = unpacked(k)
        var section_y = self.min_section
        for section in marks {
            if let list = section {
                for packed in list {
                    // `ProtoChunk.unpackOffsetCoordinates`.
                    let p = i32(packed)
                    let x = pos.x * 16 + (p & 15)
                    let y = section_y * 16 + ((p >> 4) & 15)
                    let z = pos.z * 16 + ((p >> 8) & 15)
                    match post_process(shared.value, mut self, x, y, z) {
                        ok => {},
                        err(thrown) => self.report(thrown.message),
                    }
                }
            }
            section_y += 1
        }
    }

    // Takes out the chunk at `k`'s ticks as it unloads, as `unregisterTickContainerFromLevel`
    // does, packed as they're saved now, if it was full.
    fn drop_ticks(mut self, k: i64) -> (List<SavedTick>, List<SavedTick>)? {
        let block = self.block_ticks.remove_container(k) else return none
        let fluid = self.fluid_ticks.remove_container(k) ?? ChunkTicks.new()
        return some((block.pack(self.game_time), fluid.pack(self.game_time)))
    }

    // The chunk at `k`'s ticks as they're saved now, if it's full.
    fn ticks_now(self, k: i64) -> (List<SavedTick>, List<SavedTick>)? {
        let block = self.block_ticks.pack(k, self.game_time) else return none
        let fluid = self.fluid_ticks.pack(k, self.game_time) ?? List<SavedTick>()
        return some((block, fluid))
    }

    // The chunk at `k` came to be loaded, as `loaded` has it: each chunk waiting in the 5×5
    // around it may be ready now (D252).
    fn came_loaded(mut self, k: i64) {
        self.full_maybe.push(k)
        let pos = unpacked(k)
        for x in pos.x - 1..pos.x + 2 {
            for z in pos.z - 1..pos.z + 2 {
                self.ticks_to_check.insert(ChunkPos { x: x, z: z }.pack())
            }
        }
        if self.waiting.is_empty() {
            return
        }
        for x in pos.x - 2..pos.x + 3 {
            for z in pos.z - 2..pos.z + 3 {
                let w = ChunkPos { x: x, z: z }.pack()
                if self.waiting.contains(w) {
                    self.recheck.insert(w)
                }
            }
        }
    }

    // The chunk at `k` waits no more.
    fn stop_waiting(mut self, k: i64) {
        _ = self.waiting.remove(k)
    }

    // The holder at `k` unloaded: light's told it isn't full, and its chunk goes, with its light,
    // unless it's still being read, when it goes as it comes back, with no holder to have it, and
    // the generator's told nothing wants it, unless a far read does, so it doesn't make it if it
    // hasn't begun to (D243).
    fn unloaded(mut self, k: i64) {
        self.full_maybe.push(k)
        self.stop_waiting(k)
        let ticks = self.drop_ticks(k)
        self.drop_tickers(k)
        self.reading.unlit.remove(k)
        if self.opened {
            self.tell_full(k, false)
        }
        if self.reading.chunks.contains(k) {
            if self.opened and not self.far.contains(k) and not self.dropping.contains(k) {
                self.dropping.insert(k)
                self.asks.push(Ask.Drop(unpacked(k)))
            }
            return
        }
        if let gone = self.columns.take(k) {
            self.stale(k)
            if self.opened {
                let save = self.to_save(k, gone, ticks)
                self.forget_light(k, save)
            }
        }
        _ = self.inhabited.remove(k)
    }

    // The chunk at `k` unloads, or the server stops, as `gone`, with `ticks`, its block and fluid
    // ticks as they're saved now if it was full: if it isn't saved as it is, made by the generator
    // since, or lit, or its light changed, and it's held whole, it's to be saved, with its light if
    // it's lit, as vanilla saves an unsaved chunk (D258), and with those ticks (D322).
    fn to_save(mut self, k: i64, gone: own Body, ticks: own (List<SavedTick>, List<SavedTick>)?) -> Whole? {
        if not self.unsaved.contains(k) {
            return none
        }
        self.unsaved.remove(k)
        self.eager.remove(k)
        _ = self.next_save.remove(k)
        match gone {
            Body.Saved(s) => {
                let SavedChunk { chunk: chunk, whole: whole, rest: rest, .. } = s
                if whole {
                    let r = rest else return none
                    let inhabited = self.inhabited.get(k) ?? 0
                    if let t = ticks {
                        let (block, fluid) = t
                        return some(Whole { chunk: chunk, rest: r.with_ticks(block, fluid), last_update: self.game_time, inhabited: inhabited })
                    }
                    return some(Whole { chunk: chunk, rest: r, last_update: self.game_time, inhabited: inhabited })
                }
            },
            _ => {},
        }
        return none
    }

    // Saves the chunk at `k` with the light light has for it, if it's lit, once light gives it,
    // as it `went` or as the server stops. A read of it waits for the save.
    fn save_lit(mut self, k: i64, whole: own Whole, went: bool) {
        if not self.lighting {
            self.save_now(k, whole, none)
            return
        }
        self.send_light(if went { LightAsk.Went { k: k, save: true } } else { LightAsk.Save(k) })
        self.saving.push_last((k, whole))
        self.saves_waiting.insert(k, (self.saves_waiting.get(k) ?? 0) + 1)
    }

    // Hands the chunk at `k` to the savers with `light`, and the reads of it that waited for its
    // saves to the IO thread once it has none left waiting.
    fn save_now(mut self, k: i64, whole: own Whole, light: own LightData?) {
        if let held = self.jobs.take() {
            var jobs = held
            jobs.save_chunk(unpacked(k), whole, light)
            self.jobs = some(jobs)
        }
        let left = self.saves_waiting.get(k) ?? 0
        if left > 1 {
            self.saves_waiting.insert(k, left - 1)
            return
        }
        _ = self.saves_waiting.remove(k)
        if self.parked.is_empty() {
            return
        }
        var still = List<i64>()
        for p in self.parked {
            if p == k {
                self.asks.push(Ask.Chunk(unpacked(k)))
            } else {
                still.push(p)
            }
        }
        self.parked = still
    }

    // Whether the chunk at `k` is held whole, so it can be saved from what's held (D258).
    // Whether the chunk at `k` is saved as it changes: one held whole, or a flat one with blocks
    // set in it, which Calcite holds all of (CAL-145).
    fn saves_whole(self, k: i64) -> bool {
        if not self.columns.slots.contains(k) {
            return false
        }
        return match self.columns.slots[k] {
            Body.Saved(s) => s.whole,
            Body.Flat => self.columns.live.contains(k),
            Body.Loading => false,
        }
    }

    /// Whether the chunk at `pos` is to be saved, as `isUnsaved` says.
    pub fn is_unsaved(self, pos: ChunkPos) -> bool {
        return self.unsaved.contains(pos.pack())
    }

    // The chunk at `k` changed in play, a block set in it or a block entity changed: it's
    // unsaved, as `markUnsaved` marks it, and to be saved soon, as its `UnsavedListener` has
    // `saveChunksEagerly` save it (CAL-145).
    fn touched(mut self, k: i64) {
        if not self.saves_whole(k) {
            return
        }
        self.unsaved.insert(k)
        if not self.eager.contains(k) {
            self.eager.insert(k)
            self.eager_order.push_last(k)
        }
    }

    /// Saves the chunks changed in play, as `saveChunksEagerly` saves them after the unloads,
    /// oldest first, up to 20, each no sooner than 10 seconds after it last was, `now` being the
    /// server's clock in milliseconds; or, at an autosave, `all`, every one, as `saveAllChunks`
    /// saves them with those times cleared (CAL-145). Each is saved as it is, with its light, and
    /// stays. Chunks the generator made, or whose light alone changed, are saved as they unload
    /// and as the server stops, not here: they'd be made or lit again the same (D258).
    pub fn save_eagerly(mut self, now: i64, all: bool) {
        if not self.opened or self.eager_order.is_empty() {
            return
        }
        if all {
            self.next_save.clear()
        }
        var saved: usize = 0
        var left = Deque<i64>()
        while let k = self.eager_order.pop_first() {
            if not self.eager.contains(k) {
                continue
            }
            if not all and saved >= EAGER_SAVES {
                left.push_last(k)
                continue
            }
            if not self.unsaved.contains(k) or not self.saves_whole(k) {
                self.eager.remove(k)
                continue
            }
            if now < (self.next_save.get(k) ?? -1) {
                left.push_last(k)
                continue
            }
            self.eager.remove(k)
            let whole = self.snapshot(k) else continue
            self.unsaved.remove(k)
            self.next_save.insert(k, now + EAGER_COOLDOWN_MS)
            self.save_lit(k, whole, false)
            saved += 1
        }
        self.eager_order = left
    }

    // The chunk at `k` as it's saved now it's held whole, with its rest as it is: its block
    // entities, and its ticks if it's full; none if it isn't (CAL-145).
    fn snapshot(self, k: i64) -> Whole? {
        if not self.columns.slots.contains(k) {
            return none
        }
        var chunk: Shared<Chunk>? = none
        if self.columns.live.contains(k) {
            chunk = some(Shared(self.columns.live[k].copy()))
        }
        var rest = self.columns.rests.copied(k)
        match self.columns.slots[k] {
            Body.Saved(s) => {
                if not s.whole {
                    return none
                }
                if chunk == none {
                    chunk = some(s.chunk.copy())
                }
            },
            Body.Flat => {
                if rest == none {
                    rest = some(PackedRest.of(ChunkRest.empty(self.columns.sections)))
                }
            },
            Body.Loading => return none,
        }
        let c = chunk else return none
        var r = rest else return none
        if self.columns.block_entities.contains(k) {
            r = r.with_block_entities(saved_block_entities(self.columns.block_entities[k].copy()))
        }
        if let t = self.ticks_now(k) {
            let (block, fluid) = t
            r = r.with_ticks(block, fluid)
        }
        return some(Whole { chunk: c, rest: r, last_update: self.game_time, inhabited: self.inhabited.get(k) ?? 0 })
    }

    /// The chunk at `pos` had a tick where mobs may spawn in it, `incrementInhabitedTime`, which
    /// its save keeps (CAL-145).
    pub fn inhabit(mut self, pos: ChunkPos) {
        let k = pos.pack()
        self.inhabited.insert(k, (self.inhabited.get(k) ?? 0) + 1)
    }

    /// How many ticks the chunk at `pos` has been where mobs may spawn, `getInhabitedTime`.
    pub fn inhabited_time(self, pos: ChunkPos) -> i64 {
        return self.inhabited.get(pos.pack()) ?? 0
    }

    fn whole(self, k: i64) -> bool {
        if not self.columns.slots.contains(k) {
            return false
        }
        return match self.columns.slots[k] {
            Body.Saved(s) => s.whole,
            _ => false,
        }
    }

    // Takes in the chunk at `k` its read came to, for its holder, and tells light it came, with
    // the light it was saved with and its sky's sources, which go to light, to be initialized.
    fn accept(mut self, k: i64, loaded: own Loaded) {
        self.stale(k)
        match loaded {
            Loaded.Generate => {
                self.columns.put(k, Body.Flat)
                self.came(k, LightBody.Flat, [], [], false)
            },
            Loaded.Saved(s) => {
                var saved = s
                // What the generator made isn't on the disk until it's let go of (D258).
                if saved.fresh and saved.whole {
                    self.unsaved.insert(k)
                }
                if saved.inhabited != 0 {
                    self.inhabited.insert(k, saved.inhabited)
                } else {
                    _ = self.inhabited.remove(k)
                }
                if not self.lighting {
                    self.columns.put(k, Body.Saved(saved))
                    return
                }
                let sky = saved.sky
                saved.sky = []
                let block = saved.block
                saved.block = []
                let sources = saved.sources.take() ?? SkySources.new(self.min_section * 16)
                let shape = LightBody.Saved(saved.chunk.copy(), sources)
                let lighted = saved.lighted
                self.columns.put(k, Body.Saved(saved))
                self.came(k, shape, sky, block, lighted)
            },
        }
    }

    // Tells light the chunk at `k` came, as `shape`, with the light it was saved with.
    fn came(mut self, k: i64, shape: own LightBody, sky: own List<List<u8>?>, block: own List<List<u8>?>, lighted: bool) {
        if not self.lighting {
            return
        }
        self.send_light(LightAsk.Came { k: k, body: shape, sky: sky, block: block, lighted: lighted })
        self.came_at.insert(k, self.light_sent)
    }

    // The chunk at `k` went: light's told, and lets its light go, as `updateChunkStatus` lets it
    // go, giving the light it had first if it's to be saved, as `save` is.
    fn forget_light(mut self, k: i64, save: own Whole?) {
        self.full_maybe.push(k)
        self.initialized.remove(k)
        self.lit.remove(k)
        _ = self.came_at.remove(k)
        _ = self.watching.remove(k)
        _ = self.light_data.remove(k)
        self.kept_light.remove(k)
        if let whole = save {
            self.save_lit(k, whole, true)
        } else if self.lighting {
            self.send_light(LightAsk.Went { k: k, save: false })
        }
    }

    // Tells light `ask`, once it's handed over.
    fn send_light(mut self, ask: own LightAsk) {
        self.light_asks.push_last(ask)
        self.light_sent += 1
    }

    // Hands what light's to be told to its thread, if it has one.
    fn flush_light(mut self) {
        if self.light_asks.is_empty() {
            return
        }
        var to = self.light_to.take() else return
        var asks = Deque<LightAsk>()
        while let a = self.light_asks.pop_first() {
            asks.push_last(a)
        }
        to.send(asks)
        self.light_to = some(to)
    }

    // Tells light the holder at `k` came to be full, or that it stopped being, and its light isn't
    // wanted any more.
    fn tell_full(mut self, k: i64, full: bool) {
        if not full {
            // One that's no longer full waits to be post-processed no more; its marks stay in
            // its rest, as a chunk vanilla never ticked saves them (D329).
            self.post_lit.remove(k)
            self.post_waiting.remove(k)
        }
        if not self.lighting or full == self.told_full.contains(k) {
            return
        }
        if full {
            self.told_full.insert(k)
            self.send_light(LightAsk.Full { k: k, full: true })
        } else {
            self.told_full.remove(k)
            self.send_light(LightAsk.Full { k: k, full: false })
            self.release(k)
        }
    }

    // Wants the chunk at `k`'s light from light, as it is and as it changes.
    fn watch(mut self, k: i64) {
        self.send_light(LightAsk.Watch(k))
        self.watching.insert(k, self.light_sent)
    }

    // Doesn't want the chunk at `k`'s light any more, if it did, and lets go of what light gave.
    fn release(mut self, k: i64) {
        if self.kept_light.contains(k) {
            return
        }
        // A chunk in range for its entities to tick keeps what light gave, which its random
        // ticks and natural spawning read, so it's here as they tick, as vanilla's chunks have
        // their light; `keep_light` lets it go once it's out of range (D320).
        if self.light_data.contains(k) and self.dm.in_entity_ticking_range(k) {
            self.kept_light.insert(k)
            return
        }
        if self.watching.remove(k) == none {
            return
        }
        _ = self.light_data.remove(k)
        self.send_light(LightAsk.Release(k))
    }

    // Whether the chunk at `pos`, ready to send, waits for its light, which is wanted if it isn't
    // already. A flat chunk among flat ones is sent as the flat world's.
    fn light_wanted(mut self, pos: ChunkPos) -> bool {
        let k = pos.pack()
        if not self.lighting or self.light_data.contains(k) or self.flat_around(pos) {
            return false
        }
        if not self.watching.contains(k) {
            self.watch(k)
        }
        return true
    }

    // The light to send the chunk at `k` with: light's last, taken if it's not `keep`. The
    // network sends a chunk only once its light's here (`light_wanted`); a test's level, whose
    // light steps as it settles, is given it at once.
    fn light_for(mut self, k: i64, keep: bool) -> LightData {
        if self.light_eager and not self.light_data.contains(k) {
            if not self.watching.contains(k) {
                self.watch(k)
            }
            _ = self.step_here()
        }
        if self.light_data.contains(k) {
            if keep or self.kept_light.contains(k) {
                return self.light_data[k].copy()
            }
            if let l = self.light_data.remove(k) {
                return l
            }
        }
        return LightData { sky_mask: [], block_mask: [], empty_sky_mask: [], empty_block_mask: [], sky: [], block: [] }
    }

    // Whether a step of light that had taken `covered` asks is about the chunk at `k` the level
    // has, not one before it that went: whether the step had taken the ask that told light it
    // came.
    fn current(self, k: i64, covered: u64) -> bool {
        let at = self.came_at.get(k) else return false
        return at <= covered
    }

    // Takes in a step of light, as `light_done` does, without settling.
    fn take_in(mut self, done: own LightDone) {
        let d = done
        let covered = d.covered
        self.light_covered = covered
        for k in d.initialized {
            if self.current(k, covered) {
                self.initialized.insert(k)
            }
        }
        if self.packets.len() > 0 {
            for k in d.changed {
                if self.current(k, covered) {
                    _ = self.packets.remove(k)
                }
            }
        }
        for k in d.unsaved {
            if self.current(k, covered) and self.whole(k) {
                self.unsaved.insert(k)
            }
        }
        for k in d.lit {
            if not self.current(k, covered) {
                continue
            }
            // Lit now and not as it was saved, as `setLightCorrect` marks it unsaved (D258).
            if not self.lighted(k) and self.whole(k) {
                self.unsaved.insert(k)
            }
            self.lit.insert(k)
            self.came_loaded(k)
            self.reading.unlit.remove(k)
            if not self.spawns.is_empty() and self.near_spawn(k) {
                _ = self.light_wanted(unpacked(k))
            }
        }
        for (k, at, sky) in d.light_sections {
            if self.current(k, covered) {
                self.section_light_changed(k, at, sky)
            }
        }
        var data = d.data
        while let entry = data.pop() {
            let (k, light) = entry
            let from = self.watching.get(k) ?? (covered + 1)
            if self.current(k, covered) and from <= covered {
                self.light_data.insert(k, light)
            }
        }
        // The chunks that came to tick before their light was here, post-processed now it is,
        // in the order they came to, each that still ticks (D329).
        if not self.post_lit.is_empty() {
            var ready = List<i64>()
            for k in self.post_lit {
                if self.light_data.contains(k) {
                    ready.push(k)
                }
            }
            for k in ready {
                self.post_lit.remove(k)
                if self.sendable(unpacked(k)) {
                    self.post_process_chunk(k)
                }
            }
        }
        var saves = d.saves
        for i in 0..saves.len() {
            let light = saves[i].take()
            let gone = self.saving.pop_first() else break
            let (k, whole) = gone
            self.save_now(k, whole, light)
        }
    }

    // Runs light here, a step at a time, over the asks it's been told, until it has nothing left
    // to do, taking each step in. Whether it did anything.
    fn step_here(mut self) -> bool {
        var any = false
        loop {
            var s = self.light_here.take() else return any
            if self.light_asks.is_empty() and not s.pending() {
                self.light_here = some(s)
                return any
            }
            let n = self.light_asks.len().min(LIGHT_ASKS)
            let d = s.step(mut self.light_asks, n)
            self.light_here = some(s)
            if let done = d {
                self.take_in(done)
                any = true
            }
        }
    }

    // Waits for light to have taken every ask it's been told, taking each step in, as the server
    // stops: on its thread, or here.
    fn finish_light(mut self) {
        self.flush_light()
        if let held = self.light_back.take() {
            var back = held
            while self.light_covered < self.light_sent {
                let d = back.wait() else break
                self.take_in(d)
            }
            self.light_back = some(back)
            return
        }
        _ = self.step_here()
    }

    // The chunk at `k` came, went or changed: the packets kept for it and those around it go, as a
    // flat chunk is sent as the flat world's body only while those around it are flat too.
    fn stale(mut self, k: i64) {
        if self.packets.len() == 0 {
            return
        }
        let pos = unpacked(k)
        for x in pos.x - 1..pos.x + 2 {
            for z in pos.z - 1..pos.z + 2 {
                _ = self.packets.remove(ChunkPos { x: x, z: z }.pack())
            }
        }
    }

    // Whether the chunk at `k` was saved lit, so its light isn't spread again.
    fn lighted(self, k: i64) -> bool {
        if not self.columns.slots.contains(k) {
            return false
        }
        return match self.columns.slots[k] {
            Body.Saved(s) => s.lighted,
            _ => false,
        }
    }

    // Whether every chunk in the 3×3 around `pos` is flat, so its light is the flat world's: none
    // of them has had a block set, which its light may reach out of (D321).
    fn flat_around(self, pos: ChunkPos) -> bool {
        for x in pos.x - 1..pos.x + 2 {
            for z in pos.z - 1..pos.z + 2 {
                let k = ChunkPos { x: x, z: z }.pack()
                if not self.columns.slots.contains(k) or self.columns.live.contains(k) {
                    return false
                }
                match self.columns.slots[k] {
                    Body.Flat => {},
                    _ => return false,
                }
            }
        }
        return true
    }

    // Runs the dispatcher's jobs, then the main thread's tasks, until neither has any, and
    // whether any ran.
    fn drain(mut self) -> bool {
        var ran = false
        loop {
            var any = false
            while self.dm.run_dispatcher() {
                any = true
            }
            while self.dm.run_main() {
                any = true
            }
            if not any {
                return ran
            }
            ran = true
        }
    }

    // Lets each holder waiting whose 5×5 is full have its chunk tick its entities, in the order
    // they came to wait, and whether that let any of what waited for it go. Only those marked to
    // be looked at again are, in that order: the rest are as they were when last looked at, not
    // full, and still waiting (D252).
    fn ready_waiting(mut self) -> bool {
        if self.recheck.is_empty() {
            return false
        }
        var keys = List<(u64, i64)>()
        for k in self.recheck {
            if let place = self.waiting.get(k) {
                keys.push((place, k))
            }
        }
        self.recheck.clear()
        keys.sort()
        var any = false
        for (_, k) in keys {
            let still = match self.dm.holder(k) {
                some(h) => h.ticking == Ticking.Waiting,
                none => false,
            }
            if not still {
                self.stop_waiting(k)
            } else if self.loaded_around(unpacked(k), 2) {
                self.stop_waiting(k)
                if self.dm.entity_ticking_ready(k) {
                    any = true
                }
            }
        }
        return any
    }

    // Whether the chunk at `k` is full: lit, if chunks are read, or there, if they're all flat.
    fn loaded(self, k: i64) -> bool {
        if self.opened {
            return self.lit.contains(k)
        }
        return self.columns.slots.contains(k)
    }

    // Whether every chunk within `radius` of `pos` is full.
    fn loaded_around(self, pos: ChunkPos, radius: i32) -> bool {
        for x in pos.x - radius..pos.x + radius + 1 {
            for z in pos.z - radius..pos.z + radius + 1 {
                if not self.loaded(ChunkPos { x: x, z: z }.pack()) {
                    return false
                }
            }
        }
        return true
    }

    // Whether the chunk at `k` has a holder, in use or waiting to unload.
    fn held(self, k: i64) -> bool {
        if let _ = self.dm.holder(k) {
            return true
        }
        if let _ = self.dm.unloading(k) {
            return true
        }
        return false
    }

    // Asks for a read of the chunk at `k`, once it's saved if it's waiting to be.
    fn ask(mut self, k: i64) {
        self.asked.insert(k, (self.asked.get(k) ?? 0) + 1)
        if self.saves_waiting.contains(k) {
            self.parked.push(k)
            return
        }
        self.asks.push(Ask.Chunk(unpacked(k)))
    }

    // Lets the far chunk at `k` go, and its read if it's still being read.
    fn free_far(mut self, k: i64) {
        let f = self.far.remove(k) else return
        let Far { owner: owner, body: gone } = f
        match gone {
            Body.Loading => self.far_loads.insert(owner, (self.far_loads.get(owner) ?? 1) - 1),
            _ => self.let_go_body(k, gone),
        }
    }
}

// Collisions see the full chunks, as `getChunkForCollisions` gives them.
impl SpawnLevel for Level {
    fn spawn_state(self, x: i32, y: i32, z: i32) -> u32 {
        return self.collision_state(x, y, z) ?? AIR_STATE
    }

    // `Level.getHeight`: the world's bottom where the chunk isn't loaded.
    fn surface(self, kind: i32, x: i32, z: i32) -> i32 {
        let pos = ChunkPos { x: x >> 4, z: z >> 4 }
        if self.full(pos) {
            let k = pos.pack()
            if self.columns.live.contains(k) {
                return self.columns.live[k].height(kind, x & 15, z & 15)
            }
            match self.columns.slots[k] {
                Body.Saved(s) => return s.chunk.value.height(kind, x & 15, z & 15),
                Body.Flat => {
                    if let f = self.columns.flat {
                        return f.chunk.height(kind, x & 15, z & 15)
                    }
                },
                Body.Loading => {},
            }
        }
        return self.min_section * 16
    }

    fn biome(mut self, x: i32, y: i32, z: i32) -> i32 {
        let (qx, qy, qz) = corner(self.zoom_seed, x, y, z)
        return self.noise_biome(qx, qy, qz)
    }

    // `ChunkAccess.getNoiseBiome` of the chunk the quart's in, its height clamped to the world;
    // -1, no biome, where the chunk isn't loaded, which vanilla would ask its generator for.
    fn noise_biome(self, qx: i32, qy: i32, qz: i32) -> i32 {
        let pos = ChunkPos { x: qx >> 2, z: qz >> 2 }
        if not self.full(pos) {
            return -1
        }
        let k = pos.pack()
        if self.columns.live.contains(k) {
            return i32.wrap(self.columns.live[k].noise_biome(qx & 3, qy, qz & 3))
        }
        match self.columns.slots[k] {
            Body.Saved(s) => return i32.wrap(s.chunk.value.noise_biome(qx & 3, qy, qz & 3)),
            Body.Flat => {
                if let f = self.columns.flat {
                    return i32.wrap(f.chunk.noise_biome(qx & 3, qy, qz & 3))
                }
            },
            Body.Loading => {},
        }
        return -1
    }

    fn light(self, sky: bool, x: i32, y: i32, z: i32) -> i32 {
        return self.light_at(sky, x, y, z)
    }

    // A holder whose chunk ticks its entities, as the entity manager's sections tick once the
    // chunk's full status comes to `ENTITY_TICKING`.
    fn entities_tick(self, chunk_x: i32, chunk_z: i32) -> bool {
        return match self.dm.holder(ChunkPos { x: chunk_x, z: chunk_z }.pack()) {
            some(h) => h.ticking == Ticking.Ready,
            none => false,
        }
    }

    // `hasPlayersNearby(...).toBoolean(true)`: unless no player's within 8 chunks (CAL-156).
    fn players_near(mut self, chunk_x: i32, chunk_z: i32) -> bool {
        return self.dm.players_nearby(ChunkPos { x: chunk_x, z: chunk_z }.pack()) != Nearby.No
    }

    fn inhabited_at(self, chunk_x: i32, chunk_z: i32) -> i64? {
        let pos = ChunkPos { x: chunk_x, z: chunk_z }
        if not self.full(pos) {
            return none
        }
        return some(self.inhabited_time(pos))
    }
}

// What a mob reads of the light where it is (CAL-156).
impl MobLight for Level {
    // `hasChunkAt`, then `getMaxLocalRawBrightness` over 15, curved and lerped to 1 by the
    // dimension's ambient light.
    fn magic_light(self, x: i32, y: i32, z: i32) -> f32 {
        if not self.full(ChunkPos { x: x >> 4, z: z >> 4 }) {
            return 0.0f32
        }
        let v = f32.nearest(raw_brightness(self, x, y, z, self.place.darken)) / 15.0f32
        let curved = v / (4.0f32 - 3.0f32 * v)
        return curved + self.place.ambient_light * (1.0f32 - curved)
    }

    fn monsters_burn(self, x: i32, y: i32, z: i32) -> bool {
        _ = x + y + z
        return self.place.monsters_burn
    }
}

// What a mob's navigation reads of its level besides its blocks (CAL-157).
impl NavLevel for Level {
    fn level_time(self) -> i64 {
        return self.game_time
    }

    // `getMaxY`.
    fn top_y(self) -> i32 {
        return (self.min_section + self.sections) * 16 - 1
    }

    fn sent_first(self) -> u64 {
        return self.sent.first()
    }

    fn sent_total(self) -> u64 {
        return self.sent.total()
    }

    fn sent_at(self, i: u64) -> SentBlock {
        return self.sent.at(i)
    }
}

impl LevelWriter for Level {
    fn set_block(mut self, x: i32, y: i32, z: i32, state: u32, flags: i32) -> bool {
        return self.set_block_limited(x, y, z, state, flags, UPDATE_LIMIT)
    }
}

// The level's blocks, set as vanilla's are (D326).
impl DropLevel for Level {
    fn world_loot(self) -> Shared<Loot>? {
        return self.loot.copy()
    }

    fn lend_sequence(mut self, name: String) -> SequenceRandom? {
        var s = self.sequences.take() else return none
        let r = s.lend(name, self.world_seed)
        self.sequences = some(s)
        return some(r)
    }

    fn give_back_sequence(mut self, name: String, random: SequenceRandom) {
        var s = self.sequences.take() else return
        s.give_back(name, random)
        self.sequences = some(s)
    }

    fn lend_level_random(mut self) -> TapedRandom {
        return self.lend_random()
    }

    fn give_back_level_random(mut self, random: own TapedRandom) {
        self.give_back_random(random)
    }

    fn add_dropped(mut self, x: f64, y: f64, z: f64, stack: own Tag) {
        self.dropped.push(Dropped.Item(x, y, z, stack))
    }

    fn add_orb(mut self, x: f64, y: f64, z: f64, value: i32, pick: i32) {
        self.dropped.push(Dropped.Orb(x, y, z, value, pick))
    }

    fn drops_on(self) -> bool {
        return self.block_drops
    }
}

impl BlockLevel for Level {
    // `Level.setBlock` (D321, D326): in the world's height and a full chunk, the block's state
    // set, as `LevelChunk.setBlockState` sets it, with the heightmaps, in the chunk's own copy;
    // the chunk marked unsaved, and its kept packet dropped, as the next player to be sent it is
    // sent it as it is now; and light told, as `setBlockState` tells it. Then, with the block
    // facts, what `setBlockState` does once it's set: the old block's
    // `affectNeighborsAfterRemoval`, where the block changed or is a rail and the blocks around
    // are told or a piston moved it, and, unless that set another block there, the new one's
    // `onPlace`, unless `UPDATE_SKIP_ON_PLACE`. Then, if the block's still what was set,
    // `setBlock`'s: with `UPDATE_CLIENTS`, in a chunk that ticks, the block kept for the
    // broadcast after the chunks tick, as `sendBlockUpdated` keeps it through
    // `ChunkHolder.blockChanged`; with `UPDATE_NEIGHBORS`, the six around told; and unless
    // `UPDATE_KNOWN_SHAPE`, with `limit` left, the six around given its shape. With
    // `UPDATE_NEIGHBORS`, a block a comparator reads tells the comparators by it,
    // `updateNeighbourForOutputSignal` (CAL-123). Redstone wire's indirect shapes and points of
    // interest come with them.
    fn set_block_limited(mut self, x: i32, y: i32, z: i32, state: u32, flags: i32, limit: i32) -> bool {
        if y < self.min_section * 16 or y >= (self.min_section + self.sections) * 16 {
            return false
        }
        if x < -30000000 or x >= 30000000 or z < -30000000 or z >= 30000000 {
            return false
        }
        let pos = ChunkPos { x: x >> 4, z: z >> 4 }
        if not self.full(pos) or self.table == none {
            return false
        }
        let k = pos.pack()
        if not self.columns.live.contains(k) {
            var copy: Chunk? = none
            match self.columns.slots[k] {
                Body.Saved(s) => copy = some(s.chunk.value.copy()),
                Body.Flat => {
                    if let f = self.columns.flat {
                        copy = some(f.chunk.copy())
                    }
                },
                Body.Loading => {},
            }
            let c = copy else return false
            self.columns.live.insert(k, c)
            if self.columns.stand_in == none {
                if let t = self.table.take() {
                    self.columns.stand_in = some(Shared(Chunk.new(t, self.min_section * 16, 1, 0)))
                    self.table = some(t)
                }
            }
            self.columns.let_go_shared(k)
        }
        let t = self.table.take() else return false
        let set = self.columns.live[k].set_block(t, x & 15, y, z & 15, state)
        self.table = some(t)
        let old = set else return false
        self.touched(k)
        _ = self.packets.remove(k)
        if self.lighting {
            self.send_light(LightAsk.Block { k: k, x: x, y: y, z: z, state: state })
        }
        let some_env = self.env.copy()
        let shared = some_env else {
            self.sent_block(pos, x, y, z, old, state, flags)
            return true
        }
        let Env { facts: f, .. } = shared.value
        let block = f.block(state)
        let moved = flags & UPDATE_MOVE_BY_PISTON != 0
        // The block entity of the block replaced goes, unless the block set keeps it, what it holds
        // dropping first unless `UPDATE_SKIP_BLOCK_ENTITY_SIDEEFFECTS` (CAL-115).
        if f.block(old) != block and f.has_block_entity(old) and not keeps_block_entity(f, old, state) {
            self.remove_block_entity(k, BlockPos { x: x, y: y, z: z }, flags & UPDATE_SKIP_BLOCK_ENTITY_SIDEEFFECTS == 0)
        }
        if (f.block(old) != block or f.is_a(block, "BaseRailBlock")) and (flags & UPDATE_NEIGHBORS != 0 or moved) {
            match after_removal(shared.value, mut self, old, x, y, z, moved) {
                ok => {},
                err(thrown) => self.report(thrown.message),
            }
        }
        let here = self.block_state(x, y, z) ?? state
        if f.block(here) != block {
            return false
        }
        if flags & UPDATE_SKIP_ON_PLACE == 0 {
            match on_place(shared.value, mut self, state, x, y, z, old, moved) {
                ok => {},
                err(thrown) => self.report(thrown.message),
            }
        }
        if f.has_block_entity(state) and f.block(self.block_state(x, y, z) ?? state) == block {
            self.make_block_entity(f, k, BlockPos { x: x, y: y, z: z }, state)
        }
        let now = self.block_state(x, y, z) ?? state
        if now != state {
            return true
        }
        self.sent_block(pos, x, y, z, old, state, flags)
        if flags & UPDATE_NEIGHBORS != 0 {
            self.update_neighbours_at(x, y, z, f.block(old))
            if f.has_analog_output(block) {
                match update_output_signal(f, mut self, block, x, y, z) {
                    ok => {},
                    err(thrown) => self.report(thrown.message),
                }
            }
        }
        if flags & UPDATE_KNOWN_SHAPE == 0 and limit > 0 {
            let shape_flags = flags & -34
            self.update_indirect_shapes(f, old, x, y, z, shape_flags, limit - 1)
            self.update_neighbour_shapes(state, x, y, z, shape_flags, limit - 1)
            self.update_indirect_shapes(f, state, x, y, z, shape_flags, limit - 1)
        }
        if f.poi(old) != f.poi(now) {
            self.report(String("Points of interest changed as blocks are set"))
        }
        return true
    }

    // `ServerLevel.levelEvent`, kept for the network to send.
    fn level_event(mut self, kind: i32, x: i32, y: i32, z: i32, data: i32) {
        self.events.push(Heard.Event(LevelEvent { kind: kind, x: x, y: y, z: z, data: data }))
    }

    // `ServerLevel.levelEvent(player, ...)`, kept for the network to send to all but the player
    // (D376).
    fn level_event_from(mut self, player: i32, kind: i32, x: i32, y: i32, z: i32, data: i32) {
        self.events.push(Heard.Event(LevelEvent { kind: kind, x: x, y: y, z: z, data: data, except: player }))
    }

    fn unimplemented(mut self, what: String) {
        self.report(what)
    }

    fn drop_resources(mut self, f: Facts, state: u32, x: i32, y: i32, z: i32, block_entity: Tag?, breaker: i32?, tool: Tag?) {
        drop_block_resources(f, mut self, state, x, y, z, block_entity, breaker, tool)
    }

    fn schedule_fluid_in(mut self, fluid: u32, x: i32, y: i32, z: i32, delay: i32) {
        self.schedule_fluid_tick(fluid, x, y, z, delay, 0)
    }

    fn converts_to_source(self, lava: bool) -> bool {
        return if lava { self.lava_source_conversion } else { self.water_source_conversion }
    }

    fn is_fast_lava(self) -> bool {
        return self.fast_lava
    }

    fn is_loaded(self, x: i32, y: i32, z: i32) -> bool {
        if not self.in_height(y) or x < -30000000 or x >= 30000000 or z < -30000000 or z >= 30000000 {
            return false
        }
        return self.full(ChunkPos { x: x >> 4, z: z >> 4 })
    }

    fn in_height(self, y: i32) -> bool {
        return y >= self.min_section * 16 and y < (self.min_section + self.sections) * 16
    }

    fn neighbour_changed(mut self, x: i32, y: i32, z: i32, source: u32) {
        self.add_and_run(x, y, z, Update.Simple { x: x, y: y, z: z, source: source })
    }

    fn neighbour_changed_as(mut self, state: u32, x: i32, y: i32, z: i32, source: u32, moved: bool) {
        self.add_and_run(x, y, z, Update.Full { state: state, x: x, y: y, z: z, source: source, moved: moved })
    }

    fn update_neighbours(mut self, x: i32, y: i32, z: i32, source: u32) {
        self.update_neighbours_at(x, y, z, source)
    }

    // `MultiNeighborUpdate` past `skip` from the first, as its constructor starts it.
    fn update_neighbours_except(mut self, x: i32, y: i32, z: i32, source: u32, skip: i32) {
        let first = if update_order(0) == skip { 1 } else { 0 }
        self.add_and_run(x, y, z, Update.Multi { x: x, y: y, z: z, source: source, skip: skip, next: first })
    }

    // `willTickThisTick`: whether it's among the block ticks still to run, a set of them made as
    // it's first asked, `calculateTickSetIfNeeded`, where it's empty; none outside the ticks.
    fn will_tick_this_tick(mut self, block: u32, x: i32, y: i32, z: i32) -> bool {
        if self.to_run.is_empty() {
            var i = self.running_at
            while i < self.running.len() {
                let t = self.running[i]
                self.to_run.insert((BlockPos { x: t.x, y: t.y, z: t.z }.pack(), t.kind))
                i += 1
            }
        }
        return self.to_run.contains((BlockPos { x: x, y: y, z: z }.pack(), block))
    }

    fn time_now(self) -> i64 {
        return self.game_time
    }

    // `isToggledTooFrequently`: the toggle added now if `add`, then whether 8 are at the place.
    fn torch_toggled(mut self, x: i32, y: i32, z: i32, add: bool) -> bool {
        if add {
            self.toggles.push(Toggle { x: x, y: y, z: z, when: self.game_time })
        }
        var count = 0
        for i in 0..self.toggles.len() {
            let t = self.toggles[i]
            if t.x == x and t.y == y and t.z == z {
                count += 1
                if count >= 8 {
                    return true
                }
            }
        }
        return false
    }

    // The toggles from the oldest on let go while each is more than 60 ticks old.
    // The comparator's block entity, made where it has none, holding `output` (CAL-123).
    fn set_comparator_output(mut self, x: i32, y: i32, z: i32, output: i32) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let Env { facts: f, .. } = shared.value
        let state = self.block_state(x, y, z) else return
        let k = ChunkPos { x: x >> 4, z: z >> 4 }.pack()
        let pos = BlockPos { x: x, y: y, z: z }
        self.make_block_entity(f, k, pos, state)
        if not self.columns.block_entities[k].contains(pos) {
            return
        }
        var tags = match self.columns.block_entities[k][pos] {
            Tag.Compound(m) => m.copy(),
            _ => return,
        }
        if not tags.contains("id") or tags["id"] != Tag.Str(String("minecraft:comparator")) {
            return
        }
        tags.insert("OutputSignal", Tag.Int(output))
        self.columns.block_entities[k].insert(pos, Tag.Compound(tags))
        self.touched(k)
    }

    fn forget_toggles(mut self) {
        var gone: usize = 0
        while gone < self.toggles.len() and self.game_time - self.toggles[gone].when > 60 {
            gone += 1
        }
        if gone == 0 {
            return
        }
        var kept = List<Toggle>()
        for i in gone..self.toggles.len() {
            kept.push(self.toggles[i])
        }
        self.toggles = kept
    }

    fn fire_spreads(self, x: i32, y: i32, z: i32) -> bool {
        return self.place.fire_spreads(x, y, z)
    }

    fn sky_darken(self) -> i32 {
        return self.place.darken
    }

    fn sky_light(self, x: i32, y: i32, z: i32) -> i32 {
        return self.light_at(true, x, y, z)
    }

    // `getValue(SUN_ANGLE, pos)`: as the biome of the block's quart has it, as with
    // `INCREASED_FIRE_BURNOUT` (CAL-130).
    fn sun_angle_at(self, x: i32, y: i32, z: i32) -> f32 {
        return self.place.sun_angle_in(self.noise_biome(x >> 2, y >> 2, z >> 2))
    }

    fn player_within(self, x: f64, y: f64, z: f64, range: f64) -> bool {
        return self.place.player_within(x, y, z, range)
    }

    fn openers(mut self, x: i32, y: i32, z: i32) -> Openers {
        let pos = BlockPos { x: x, y: y, z: z }
        if let o = self.container_openers.get(pos.pack()) {
            return o
        }
        let some_env = self.env.copy()
        let shared = some_env else return Openers()
        let Env { facts: f, .. } = shared.value
        let state = self.block_state(x, y, z) else return Openers()
        if f.block_entity_kind(f.block(state)) == none {
            return Openers()
        }
        let k = pos.chunk().pack()
        self.make_block_entity(f, k, pos, state)
        let made = Openers { id: self.next_openers }
        self.next_openers += 1
        self.container_openers.insert(pos.pack(), made)
        return made
    }

    fn set_openers(mut self, x: i32, y: i32, z: i32, o: Openers) {
        let pos = BlockPos { x: x, y: y, z: z }
        if self.container_openers.get(pos.pack()) == none {
            _ = self.openers(x, y, z)
        }
        if self.container_openers.get(pos.pack()) != none {
            self.container_openers.insert(pos.pack(), o)
        }
    }

    fn viewers(self, x: i32, y: i32, z: i32, range: f64) -> (i32, f64) {
        return self.place.viewers_of(x, y, z, range)
    }

    fn play_sound_at(mut self, x: f64, y: f64, z: f64, sound: own String, volume: f32, pitch: f32) {
        self.sound_seeds += -7046029254386353131
        let seed = mix_stafford13(self.sound_seeds)
        self.events.push(Heard.Sound(LevelSound { sound: sound, x: x, y: y, z: z, volume: volume, pitch: pitch, seed: seed }))
    }

    fn keep_block_entity_value(mut self, x: i32, y: i32, z: i32, key: str, value: own Tag) {
        let k = ChunkPos { x: x >> 4, z: z >> 4 }.pack()
        let pos = BlockPos { x: x, y: y, z: z }
        self.columns.own_block_entities(k)
        if not self.columns.block_entities[k].contains(pos) {
            return
        }
        var tags = match self.columns.block_entities[k][pos] {
            Tag.Compound(m) => m.copy(),
            _ => return,
        }
        tags.insert(String(key), value)
        self.columns.block_entities[k].insert(pos, Tag.Compound(tags))
    }

    fn water_evaporates(self) -> bool {
        return self.place.evaporates
    }

    fn difficulty(self) -> i32 {
        return self.place.difficulty
    }

    fn raining(self) -> bool {
        return self.place.raining
    }

    // `isRainingAt`, `precipitationAt` being rain: where it's raining, at a block that sees the
    // sky, its sky light 15 (`canSeeSky`), no lower than the top of what blocks motion there,
    // in a biome, zoomed in as `getBiome` zooms it, that has precipitation and is warm enough to
    // rain there, at the dimension's sea level, `Biome.getPrecipitationAt`.
    fn raining_at(self, x: i32, y: i32, z: i32) -> bool ! Thrown {
        if not self.place.raining or self.light_at(true, x, y, z) < 15 or self.surface(MOTION_BLOCKING, x, z) > y {
            return false
        }
        let climate = self.climate.copy() else fail Thrown { exception: "Unimplemented", message: "Rain at a block without the biomes' climate" }
        let some_env = self.env.copy()
        let shared = some_env else fail Thrown { exception: "Unimplemented", message: "Rain at a block without the block facts" }
        let (qx, qy, qz) = corner(self.zoom_seed, x, y, z)
        let biome = self.noise_biome(qx, qy, qz)
        if biome < 0 {
            fail Thrown { exception: "Unimplemented", message: "Reading a biome where its chunk isn't full" }
        }
        return climate.value.rains(biome, x, y, z, shared.value.ctx.sea)
    }

    fn portals_light(self) -> bool {
        return self.place.portals
    }

    fn infiniburn(self) -> String {
        return self.place.infiniburn.copy()
    }

    // `environmentAttributes().getValue(INCREASED_FIRE_BURNOUT, pos)`: the attribute as the
    // biome of the block's quart has it, `getNoiseBiomeAtPosition`, as it isn't one of those read
    // at the zoomed biome.
    fn fire_burnout(self, x: i32, y: i32, z: i32) -> bool {
        return self.place.burnout_in(self.noise_biome(x >> 2, y >> 2, z >> 2))
    }

    fn block_event(mut self, x: i32, y: i32, z: i32, block: u32, b0: i32, b1: i32) {
        self.add_block_event(BlockEvent { x: x, y: y, z: z, block: block, b0: b0, b1: b1 })
    }

    // `ServerLevel.sendParticles`, kept for the network to send (CAL-143).
    fn send_particles(mut self, particle: str, x: f64, y: f64, z: f64, count: i32, dx: f64, dy: f64, dz: f64, speed: f64) {
        self.events.push(Heard.Particles(LevelParticles { particle: String(particle), x: x, y: y, z: z, count: count, dx: f32.nearest(dx), dy: f32.nearest(dy), dz: f32.nearest(dz), speed: f32.nearest(speed) }))
    }

    // `playSound(null, pos, ...)`: from the block's middle, with a seed of its own, as vanilla
    // draws one from `threadSafeRandom`, which nothing else reads.
    fn play_sound(mut self, x: i32, y: i32, z: i32, sound: own String, volume: f32, pitch: f32) {
        self.sound_seeds += -7046029254386353131
        let seed = mix_stafford13(self.sound_seeds)
        self.events.push(Heard.Sound(LevelSound { sound: sound, x: f64(x) + 0.5, y: f64(y) + 0.5, z: f64(z) + 0.5, volume: volume, pitch: pitch, seed: seed }))
    }

    fn play_sound_from(mut self, player: i32, x: i32, y: i32, z: i32, sound: own String, volume: f32, pitch: f32) {
        self.sound_seeds += -7046029254386353131
        let seed = mix_stafford13(self.sound_seeds)
        self.events.push(Heard.Sound(LevelSound { sound: sound, x: f64(x) + 0.5, y: f64(y) + 0.5, z: f64(z) + 0.5, volume: volume, pitch: pitch, seed: seed, except: player }))
    }

    fn play_seeded_sound(mut self, x: i32, y: i32, z: i32, sound: own String, source: i32, volume: f32, pitch: f32, seed: i64) {
        self.events.push(Heard.Sound(LevelSound { sound: sound, x: f64(x) + 0.5, y: f64(y) + 0.5, z: f64(z) + 0.5, volume: volume, pitch: pitch, seed: seed, source: source }))
    }

    fn neighbour_shapes(mut self, state: u32, x: i32, y: i32, z: i32, flags: i32) {
        self.update_neighbour_shapes(state, x, y, z, flags, UPDATE_LIMIT)
    }

    fn indirect_shapes(mut self, state: u32, x: i32, y: i32, z: i32, flags: i32) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let Env { facts: f, .. } = shared.value
        self.update_indirect_shapes(f, state, x, y, z, flags, UPDATE_LIMIT)
    }

    fn moving_piston(self, x: i32, y: i32, z: i32) -> MovingPiston? {
        return self.motions.get(BlockPos { x: x, y: y, z: z }.pack())
    }

    // `LevelChunk.setBlockEntity`, where the block there is a moving piston: in the chunk's map,
    // as it saves, ticking, by its place's ticker where it has one, as `updateBlockEntityTicker`
    // rebinds it, else by a new one.
    fn put_moving_piston(mut self, x: i32, y: i32, z: i32, m: MovingPiston) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let Env { facts: f, .. } = shared.value
        let state = self.block_state(x, y, z) else return
        if f.block(state) != f.ids.moving_piston {
            return
        }
        let pos = BlockPos { x: x, y: y, z: z }
        let k = pos.chunk().pack()
        self.columns.own_block_entities(k)
        self.columns.block_entities[k].insert(pos, moving_tag(f, pos, m))
        self.touched(k)
        self.motions.insert(pos.pack(), m)
        if self.ticker_ids.contains(pos.pack()) {
            self.ticker_kinds.insert(pos.pack(), PISTON_TICKER)
        } else {
            self.add_ticker(pos, f.block_entity_type(f.ids.moving_piston), PISTON_TICKER)
        }
    }

    fn remove_block_entity_at(mut self, x: i32, y: i32, z: i32) {
        let pos = BlockPos { x: x, y: y, z: z }
        self.remove_block_entity(pos.chunk().pack(), pos, false)
    }

    fn in_border(self, x: i32, z: i32) -> bool {
        return self.place.in_border(x, z)
    }

    fn handling_tick(self) -> bool {
        return self.handling
    }

    fn players_touching(self, min_x: f64, min_y: f64, min_z: f64, max_x: f64, max_y: f64, max_z: f64) -> i32 {
        return self.place.players_touching(min_x, min_y, min_z, max_x, max_y, max_z)
    }

    fn local_brightness(self, x: i32, y: i32, z: i32) -> i32 {
        if not self.in_height(y) {
            return 15
        }
        return raw_brightness(self, x, y, z, self.place.darken)
    }

    fn block_light(self, x: i32, y: i32, z: i32) -> i32 {
        return self.light_at(false, x, y, z)
    }

    fn is_end(self) -> bool {
        return self.place.end
    }

    fn set_block_entity_value(mut self, x: i32, y: i32, z: i32, key: str, value: own Tag) {
        let some_env = self.env.copy()
        let shared = some_env else return
        let Env { facts: f, .. } = shared.value
        let state = self.block_state(x, y, z) else return
        let k = ChunkPos { x: x >> 4, z: z >> 4 }.pack()
        let pos = BlockPos { x: x, y: y, z: z }
        self.make_block_entity(f, k, pos, state)
        if not self.columns.block_entities[k].contains(pos) {
            return
        }
        var tags = match self.columns.block_entities[k][pos] {
            Tag.Compound(m) => m.copy(),
            _ => return,
        }
        tags.insert(String(key), value)
        self.columns.block_entities[k].insert(pos, Tag.Compound(tags))
        self.touched(k)
    }

    fn send_block_updated(mut self, x: i32, y: i32, z: i32) {
        self.block_updated(x, y, z)
    }

    fn remove_block_entity_value(mut self, x: i32, y: i32, z: i32, key: str) {
        let k = ChunkPos { x: x >> 4, z: z >> 4 }.pack()
        let pos = BlockPos { x: x, y: y, z: z }
        self.columns.own_block_entities(k)
        if not self.columns.block_entities[k].contains(pos) {
            return
        }
        var tags = match self.columns.block_entities[k][pos] {
            Tag.Compound(m) => m.copy(),
            _ => return,
        }
        if not tags.contains(key) {
            return
        }
        _ = tags.remove(String(key))
        self.columns.block_entities[k].insert(pos, Tag.Compound(tags))
        self.touched(k)
    }

    fn after_removal_of(mut self, old: u32, x: i32, y: i32, z: i32, moved: bool) {
        let some_env = self.env.copy()
        let shared = some_env else return
        match after_removal(shared.value, mut self, old, x, y, z, moved) {
            ok => {},
            err(thrown) => self.report(thrown.message),
        }
    }
}

// A moving piston's block entity holding `m` at `pos`, as `saveWithFullMetadata` saves it: the
// state it moves, `BlockState.CODEC`'s, the piston's facing, `Direction.LEGACY_ID_CODEC`'s byte,
// how far along it was as its last tick started, and whether it's extending and the piston's
// own (CAL-125).
fn moving_tag(f: Facts, pos: BlockPos, m: MovingPiston) -> Tag {
    var data = JavaHashMap<String, Tag>()
    data.insert(String("blockState"), f.codec.encode(m.moved))
    data.insert(String("facing"), Tag.Byte(i8.wrap(m.facing)))
    data.insert(String("progress"), Tag.Float(m.progress_o))
    data.insert(String("extending"), Tag.Byte(if m.extending { 1 } else { 0 }))
    data.insert(String("source"), Tag.Byte(if m.source { 1 } else { 0 }))
    return made_block_entity(String("minecraft:piston"), data, pos)
}

// What the moving piston's block entity `saved` holds, as `loadAdditional` reads it: its state,
// air where it names none, its facing, the byte's remainder by 6, without its sign, down where
// it has none, and its progress, both as it is and as its last tick started (CAL-125).
fn moving_of(f: Facts, saved: Tag) -> MovingPiston? {
    let tags = match saved {
        Tag.Compound(t) => t.copy(),
        _ => return none,
    }
    var moved = f.ids.air_state
    if tags.contains("blockState") {
        moved = match f.codec.decode(tags["blockState"]) {
            ok(s) => s,
            err(_) => f.ids.air_state,
        }
    }
    let facing = if tags.contains("facing") {
        match tags["facing"] {
            Tag.Byte(b) => (i32(b) % 6).abs(),
            _ => 0,
        }
    } else { 0 }
    let progress = if tags.contains("progress") {
        match tags["progress"] {
            Tag.Float(v) => v,
            _ => 0.0f32,
        }
    } else { 0.0f32 }
    return some(MovingPiston { moved: moved, facing: facing, extending: flag_of(tags, "extending"), source: flag_of(tags, "source"), progress: progress, progress_o: progress })
}

// A saved boolean, a byte that isn't 0, false where there's none.
fn flag_of(tags: JavaHashMap<String, Tag>, name: str) -> bool {
    if not tags.contains(name) {
        return false
    }
    return match tags[name] {
        Tag.Byte(b) => b != 0,
        _ => false,
    }
}

impl Level {
    // `sendBlockUpdated`, with `UPDATE_CLIENTS`, in a chunk that ticks: the block kept for the
    // broadcast after the chunks tick, through `ChunkHolder.blockChanged` (D321).
    fn sent_block(mut self, pos: ChunkPos, x: i32, y: i32, z: i32, old: u32, now: u32, flags: i32) {
        if flags & UPDATE_CLIENTS != 0 and self.sendable(pos) {
            self.sent.push(SentBlock { x: x, y: y, z: z, old: old, now: now })
            let k = pos.pack()
            let key = section_key(pos.x, y >> 4, pos.z)
            if not self.changed_blocks.contains(key) {
                self.changed_blocks.insert(key, OpenHashSet<i16>())
            }
            self.changed_blocks[key].insert(i16.wrap(((x & 15) << 8) | ((z & 15) << 4) | (y & 15)))
            self.to_broadcast.insert(k)
        }
    }

    // `ChunkHolder.sectionLightChanged`, as light tells the main thread a section's light may
    // have changed: marked, in a chunk that ticks, for its next broadcast (D342). `at` is the
    // section's place from the one below the world.
    fn section_light_changed(mut self, k: i64, at: i32, sky: bool) {
        if not self.sendable(unpacked(k)) {
            return
        }
        if not self.light_bits.contains(k) {
            self.light_bits.insert(k, LightBits {})
        }
        if sky {
            mask_set(mut self.light_bits[k].sky, at)
        } else {
            mask_set(mut self.light_bits[k].block, at)
        }
        self.light_order.insert(k)
    }
}

// The light of the sections `bits` marks, as `data`, a chunk's light, has it:
// `ClientboundLightUpdatePacketData` of those sections alone (D342).
fn light_part(data: LightData, bits: LightBits) -> LightData {
    var out = LightData { sky_mask: [], block_mask: [], empty_sky_mask: [], empty_block_mask: [], sky: [], block: [] }
    var sky_at = 0usize
    var block_at = 0usize
    let most = i32.wrap(8 * data.sky_mask.len().max(data.empty_sky_mask.len()).max(data.block_mask.len()).max(data.empty_block_mask.len()))
    for i in 0..most {
        if mask_has(data.sky_mask, i) {
            if mask_has(bits.sky, i) {
                mask_set(mut out.sky_mask, i)
                out.sky.push(data.sky[sky_at].copy())
            }
            sky_at += 1
        } else if mask_has(data.empty_sky_mask, i) and mask_has(bits.sky, i) {
            mask_set(mut out.empty_sky_mask, i)
        }
        if mask_has(data.block_mask, i) {
            if mask_has(bits.block, i) {
                mask_set(mut out.block_mask, i)
                out.block.push(data.block[block_at].copy())
            }
            block_at += 1
        } else if mask_has(data.empty_block_mask, i) and mask_has(bits.block, i) {
            mask_set(mut out.empty_block_mask, i)
        }
    }
    return out
}

// Whether bit `i` of a `BitSet`'s bytes is set.
fn mask_has(bits: List<u8>, i: i32) -> bool {
    let byte = usize.wrap(i >> 3)
    return byte < bits.len() and (i32(bits[byte]) >> (i & 7)) & 1 != 0
}

// Sets bit `i` of a `BitSet`'s bytes, growing them only as far as the bit.
fn mask_set(bits: mut List<u8>, i: i32) {
    let byte = usize.wrap(i >> 3)
    while bits.len() <= byte {
        bits.push(0)
    }
    bits[byte] |= u8.wrap(1 << (i & 7))
}

// What a block's shape and its survival read and change in the level (D324): its blocks, where
// their chunks are full; its ticks, each due in the delay vanilla gives it; and its light.
impl BlockAccess for Level {
    // `Level.getBlockState`: void air outside the world's height and 30,000,000 blocks out. A
    // chunk that isn't full, which vanilla would load and wait for, throws, so what asked keeps
    // what it had.
    fn state(self, facts: Facts, x: i32, y: i32, z: i32) -> u32 ! Thrown {
        if y < self.min_section * 16 or y >= (self.min_section + self.sections) * 16 {
            return facts.ids.void_air_state
        }
        if x < -30000000 or x >= 30000000 or z < -30000000 or z >= 30000000 {
            return facts.ids.void_air_state
        }
        let s = self.collision_state(x, y, z) else fail Thrown { exception: "Unimplemented", message: "Reading a block where its chunk isn't full" }
        return s
    }

    fn schedule_block(mut self, block: u32, x: i32, y: i32, z: i32, delay: i32, priority: i32) {
        self.schedule_block_tick(block, x, y, z, delay, priority)
    }

    // `FlowingFluid.getTickDelay`: water's 5, and lava's `lava_delay`.
    fn schedule_fluid(mut self, fluid: u32, x: i32, y: i32, z: i32) {
        let delay = if fluid == FLOWING_LAVA or fluid == LAVA_FLUID { self.lava_delay } else { 5 }
        self.schedule_fluid_tick(fluid, x, y, z, delay, 0)
    }

    // `hasScheduledTick` of the block `block`.
    fn has_block_tick(self, block: u32, x: i32, y: i32, z: i32) -> bool {
        return self.block_ticks.has(block, x, y, z)
    }

    // The level keeps no block entities yet, but what it reads of them.
    fn block_entity(mut self, facts: Facts, x: i32, y: i32, z: i32) -> String? ! Thrown {
        fail Thrown { exception: "Unimplemented", message: "Block entities in the server's level" }
    }

    // The block entity in its chunk's map, or as its rest saved it (CAL-123).
    fn block_entity_tag(self, x: i32, y: i32, z: i32) -> Tag? {
        return self.block_entity_at(ChunkPos { x: x >> 4, z: z >> 4 }.pack(), BlockPos { x: x, y: y, z: z })
    }

    // `getRawBrightness(pos, 0)`: the block's light or the sky's, whichever's more, or the
    // block's alone where there's no sky.
    fn raw_brightness(self, sky_light: bool, x: i32, y: i32, z: i32) -> i32 {
        let block = self.light_at(false, x, y, z)
        if not sky_light {
            return block
        }
        return self.light_at(true, x, y, z).max(block)
    }

    fn jukebox_song(self, record: Tag) -> JukeboxSong? {
        return self.songs.of(record)
    }

    fn open_count(self, x: i32, y: i32, z: i32) -> i32 {
        let o = self.container_openers.get(BlockPos { x: x, y: y, z: z }.pack()) else return 0
        let saved = self.block_entity_tag(x, y, z) else return 0
        let kind = kind_of(saved) ?? String()
        if kind != "minecraft:chest" and kind != "minecraft:trapped_chest" {
            return 0
        }
        return o.count
    }
}

impl CollisionBlocks for Level {
    fn collision_state(self, x: i32, y: i32, z: i32) -> u32? {
        let pos = ChunkPos { x: x >> 4, z: z >> 4 }
        if not self.full(pos) {
            return none
        }
        let k = pos.pack()
        if self.columns.live.contains(k) {
            return some(self.columns.live[k].block(x & 15, y, z & 15))
        }
        match self.columns.slots[k] {
            Body.Saved(s) => return some(s.chunk.value.block(x & 15, y, z & 15)),
            Body.Flat => {
                if let f = self.columns.flat {
                    return some(f.chunk.block(x & 15, y, z & 15))
                }
            },
            Body.Loading => {},
        }
        return none
    }
}

impl EntityTicking for Level {
    fn ticks_entities(self, chunk_x: i32, chunk_z: i32) -> bool {
        return self.dm.in_entity_ticking_range(ChunkPos { x: chunk_x, z: chunk_z }.pack())
    }
}

impl Chunks for Level {
    // A chunk the tickets reach goes once it ticks and light's given its light, which is wanted
    // from when it's lit and the sender comes to it (D264, D266). One further goes at once if a
    // holder has it, initialized, with its light, if chunks are read, if nothing's read, or if
    // its region's file hasn't it, so it's flat; otherwise it's read for the player, if they've
    // fewer than 64 being read, and goes once it's read. The sender stops at one whose region's
    // file is still to say, or past the most reads.
    fn next(mut self, pos: ChunkPos, near: bool) -> Next {
        if near {
            // A chunk lit is wanted with its light once the sender comes to it, so the light's here
            // by the time the chunks around it are lit too, and it can be sent (D266).
            if not self.sendable(pos) {
                if self.lit.contains(pos.pack()) {
                    _ = self.light_wanted(pos)
                }
                return Next.Skip
            }
            return if self.light_wanted(pos) { Next.Skip } else { Next.Send }
        }
        let k = pos.pack()
        if self.columns.slots.contains(k) {
            let there = if self.opened { self.initialized.contains(k) and not self.light_wanted(pos) } else { true }
            return if there { Next.Send } else { Next.Skip }
        }
        if not self.opened {
            return Next.Send
        }
        if self.far.contains(k) {
            return match self.far[k].body {
                Body.Loading => Next.Skip,
                _ => Next.Send,
            }
        }
        let region = region_of(pos)
        let r = region.pack()
        if not self.regions.contains(r) {
            self.regions.insert(r, Region.Asked)
            self.asks.push(Ask.Region(region))
            return Next.Stop
        }
        match self.regions[r] {
            Region.Asked => return Next.Stop,
            Region.Known(bits) => {
                let i = (pos.x & 31) + (pos.z & 31) * 32
                if (bits[usize.wrap(i >> 6)] & (1u64 << u64.wrap(i & 63))) == 0 and self.gen == none {
                    return Next.Send
                }
            },
        }
        let loads = self.far_loads.get(self.serving) ?? 0
        if loads >= MOST_FAR_LOADS {
            return Next.Stop
        }
        self.far_loads.insert(self.serving, loads + 1)
        self.far.insert(k, Far { owner: self.serving, body: Body.Loading })
        self.ask(k)
        return Next.Skip
    }
}

// What a chunk read comes to, held: as it was saved, or flat.
fn body(loaded: own Loaded) -> Body {
    return match loaded {
        Loaded.Generate => Body.Flat,
        Loaded.Saved(s) => Body.Saved(s),
    }
}

// A chunk's packet's ID and fields.
/// A section's position packed, as `SectionPos.asLong` packs it: 22 bits of `x` from bit 42, 22
/// of `z` from bit 20, and 20 of `y` (D321).
pub fn section_key(x: i32, y: i32, z: i32) -> i64 {
    return ((i64(x) & 4194303) << 42) | (i64(y) & 1048575) | ((i64(z) & 4194303) << 20)
}

fn chunk_packet(pos: ChunkPos, chunk: Chunk, light: own LightData, block_entities: own List<BlockEntityInfo>) -> List<u8> {
    var data = chunk.chunk_data()
    data.block_entities = block_entities
    var w = Writer.new()
    write_packet(ClientboundLevelChunkWithLight { x: pos.x, z: pos.z, chunk: data, light: light }, State.Play, mut w)
    return w.into_bytes()
}

// `shouldChangedStateKeepBlockEntity`: whether `state`, set in place of `old`, keeps its block
// entity, as a copper chest keeps a copper chest's and a copper golem statue a statue's as they
// weather, the blocks of `COPPER_CHESTS` and `COPPER_GOLEM_STATUES` being those of the classes
// that say so.
fn keeps_block_entity(f: Facts, old: u32, state: u32) -> bool {
    for name in ["minecraft:copper_chests", "minecraft:copper_golem_statues"] {
        let set = f.tag(String(name))
        if f.in_set(state, set) and f.in_set(old, set) {
            return true
        }
    }
    return false
}

// The chunk a packed position is.
fn unpacked(k: i64) -> ChunkPos {
    return ChunkPos { x: i32.wrap(k), z: i32.wrap(k >> 32) }
}

// A pregen task's chunks, each held with a `pregen` ticket, which loads it full, so it's lit, and
// lets it go once it is, when it unloads and is saved, lit, unless something else holds it
// (CAL-71, D275).
impl Holds for Level {
    fn hold(mut self, pos: ChunkPos) {
        _ = self.dm.add_ticket(pos.pack(), Ticket.with_radius(TicketType.Pregen, 0))
    }

    fn done(self, pos: ChunkPos) -> bool {
        return self.full(pos)
    }

    fn unhold(mut self, pos: ChunkPos) {
        _ = self.dm.remove_ticket(pos.pack(), Ticket.with_radius(TicketType.Pregen, 0))
    }
}

/// The light at the block in a chunk's light as a packet sends it, `data`, from the section below
/// the world, `min_section - 1`, to the one above, as `SkyLightSectionStorage` and
/// `BlockLightSectionStorage` read their sections' layers.
pub fn light_value(data: LightData, sky: bool, min_section: i32, sections: i32, x: i32, y: i32, z: i32) -> i32 {
    let count = sections + 2
    var i = (y >> 4) - min_section + 1
    if not sky {
        if i < 0 or i >= count or not mask_bit(data.block_mask, i) {
            return 0
        }
        return nibble(data.block[layer_at(data.block_mask, i)].data, x & 15, y & 15, z & 15)
    }
    var walked = false
    if i < 0 {
        i = 0
        walked = true
    }
    while i < count {
        if mask_bit(data.sky_mask, i) {
            return nibble(data.sky[layer_at(data.sky_mask, i)].data, x & 15, if walked { 0 } else { y & 15 }, z & 15)
        }
        if mask_bit(data.empty_sky_mask, i) {
            return 0
        }
        i += 1
        walked = true
    }
    return 15
}

// The bottom `y` of each section of `chunk` with a block or fluid that ticks at random.
fn ticking_in(chunk: Chunk, out: mut List<i32>) {
    for i in 0..chunk.section_count() {
        if chunk.section_ticks(i) {
            out.push(chunk.min_y() + 16 * i32.wrap(i))
        }
    }
}

// Bit `i` of a `BitSet`'s bytes.
fn mask_bit(mask: List<u8>, i: i32) -> bool {
    let byte = usize.wrap(i >> 3)
    return byte < mask.len() and (i32(mask[byte]) >> (i & 7)) & 1 != 0
}

// Where the layer of section `i` is among those sent: how many sections before it have one.
fn layer_at(mask: List<u8>, i: i32) -> usize {
    var n: usize = 0
    for j in 0..i {
        if mask_bit(mask, j) {
            n += 1
        }
    }
    return n
}

// `DataLayer.get`: the nibble of the block in its section's 2048 bytes, `y`, then `z`, then `x`,
// the low nibble first.
fn nibble(data: List<u8>, x: i32, y: i32, z: i32) -> i32 {
    if data.len() < 2048 {
        return 0
    }
    let index = (y << 8) | (z << 4) | x
    return (i32(data[usize.wrap(index >> 1)]) >> ((index & 1) << 2)) & 15
}

// The level's random, `Level.random`, which what the level ticks and what a block set does draw
// from (D323).
impl RandomSource for Level {
    fn set_seed(mut self, seed: i64) {
        var r = self.lend_random()
        r.set_seed(seed)
        self.random = some(r)
    }

    fn next_int(mut self) -> i32 {
        var r = self.lend_random()
        let v = r.next_int()
        self.random = some(r)
        return v
    }

    fn next_int_below(mut self, bound: i32) -> i32 {
        var r = self.lend_random()
        let v = r.next_int_below(bound)
        self.random = some(r)
        return v
    }

    fn next_long(mut self) -> i64 {
        var r = self.lend_random()
        let v = r.next_long()
        self.random = some(r)
        return v
    }

    fn next_boolean(mut self) -> bool {
        var r = self.lend_random()
        let v = r.next_boolean()
        self.random = some(r)
        return v
    }

    fn next_float(mut self) -> f32 {
        var r = self.lend_random()
        let v = r.next_float()
        self.random = some(r)
        return v
    }

    fn next_double(mut self) -> f64 {
        var r = self.lend_random()
        let v = r.next_double()
        self.random = some(r)
        return v
    }

    fn next_gaussian(mut self) -> f64 {
        var r = self.lend_random()
        let v = r.next_gaussian()
        self.random = some(r)
        return v
    }
}
