/// The game tests' data, as vanilla's `gametest.framework` keeps it (CAL-365): a test instance as
/// `GameTestInstance` and `TestData` read it from the `test_instance` registry, and a test instance
/// block's data, `TestInstanceBlockEntity.Data`, with the boxes and corners worked out from it
/// as the block entity works them out.
module server.game_tests

import chat.component.{Component}
import nbt.tag.{Tag}

/// The rotations, `Rotation`'s, by their ordinals.
pub const NONE: i32 = 0
pub const CLOCKWISE_90: i32 = 1
pub const CLOCKWISE_180: i32 = 2
pub const COUNTERCLOCKWISE_90: i32 = 3

/// A test instance, `GameTestInstance` with its `TestData`: its type, `function` or `block_based`,
/// and a function test's function; its environment as written, an ID or one given whole; the rest
/// as `TestData.CODEC` reads them, with its defaults.
pub struct TestDef {
    pub id: String
    pub kind: String
    pub function: String = String()
    pub environment: Tag? = none
    pub dimension: String = "minecraft:overworld"
    pub structure: String = String()
    pub max_ticks: i32 = 1
    pub setup_ticks: i32 = 0
    pub required: bool = true
    pub rotation: i32 = NONE
    pub manual_only: bool = false
    pub max_attempts: i32 = 1
    pub required_successes: i32 = 1
    pub sky_access: bool = false
    pub padding: i32 = 0
}

/// The test instance `id` as its entry `t` writes it; `none` where it isn't a compound.
pub fn test_def(id: String, t: Tag) -> TestDef? {
    let Tag.Compound(m) = t else return none
    var out = TestDef { id: id.copy(), kind: text(m, "type") }
    out.function = text(m, "function")
    if m.contains("environment") {
        out.environment = some(m["environment"].copy())
    }
    if m.contains("dimension") {
        out.dimension = text(m, "dimension")
    }
    out.structure = text(m, "structure")
    out.max_ticks = int(m, "max_ticks", 1)
    out.setup_ticks = int(m, "setup_ticks", 0)
    out.required = int(m, "required", 1) != 0
    out.rotation = rotation_named(text(m, "rotation"))
    out.manual_only = int(m, "manual_only", 0) != 0
    out.max_attempts = int(m, "max_attempts", 1)
    out.required_successes = int(m, "required_successes", 1)
    out.sky_access = int(m, "sky_access", 0) != 0
    out.padding = int(m, "padding", 0)
    return some(out)
}

/// A test instance block's data, `TestInstanceBlockEntity.Data`: its test's ID, its size, its
/// rotation beyond its test's, whether it ignores entities, its status, `cleared`, `running` or
/// `finished`, and the error it finished with; and its error markers as saved, `errors`.
pub struct TestBlock {
    pub test: String? = none
    pub size: (i32, i32, i32) = (0, 0, 0)
    pub rotation: i32 = NONE
    pub ignore_entities: bool = false
    pub status: String = "cleared"
    pub error: Tag? = none
    pub errors: Tag? = none
}

impl TestBlock {
    /// The block's data as its block entity `saved` holds it, `Data.CODEC` reading its `data`,
    /// a new block's where there's none.
    pub fn of(saved: JavaHashMap<String, Tag>) -> TestBlock {
        var out = TestBlock {}
        if saved.contains("errors") {
            out.errors = some(saved["errors"].copy())
        }
        if not saved.contains("data") {
            return out
        }
        let Tag.Compound(m) = saved["data"] else return out
        if m.contains("test") {
            out.test = some(text(m, "test"))
        }
        if m.contains("size") {
            match m["size"] {
                Tag.IntArray(v) => {
                    if v.len() == 3 {
                        out.size = (v[0], v[1], v[2])
                    }
                },
                Tag.List(v) => {
                    if v.len() == 3 {
                        out.size = (v[0].number_int() ?? 0, v[1].number_int() ?? 0, v[2].number_int() ?? 0)
                    }
                },
                _ => {},
            }
        }
        out.rotation = rotation_named(text(m, "rotation"))
        out.ignore_entities = int(m, "ignore_entities", 0) != 0
        if m.contains("status") {
            out.status = text(m, "status")
        }
        if m.contains("error_message") {
            out.error = some(m["error_message"].copy())
        }
        return out
    }

    /// Its data as `Data.CODEC` writes it.
    pub fn data(self) -> Tag {
        var m = JavaHashMap<String, Tag>()
        if let t = self.test {
            m.insert(String("test"), Tag.Str(t.copy()))
        }
        let (sx, sy, sz) = self.size
        m.insert(String("size"), Tag.IntArray([sx, sy, sz]))
        m.insert(String("rotation"), Tag.Str(rotation_name(self.rotation)))
        m.insert(String("ignore_entities"), Tag.Byte(if self.ignore_entities { 1i8 } else { 0i8 }))
        m.insert(String("status"), Tag.Str(self.status.copy()))
        if let e = self.error {
            m.insert(String("error_message"), e.copy())
        }
        return Tag.Compound(m)
    }

    /// The data with `status`, its error gone, `withStatus`.
    pub fn with_status(self, status: str) -> TestBlock {
        var out = self.copy()
        out.status = String(status)
        out.error = none
        return out
    }

    /// Its size turned by `rotation`, `getTransformedSize`: x and z swapped for a quarter turn.
    pub fn turned_size(self, rotation: i32) -> (i32, i32, i32) {
        let (sx, sy, sz) = self.size
        if rotation == CLOCKWISE_90 or rotation == COUNTERCLOCKWISE_90 {
            return (sz, sy, sx)
        }
        return (sx, sy, sz)
    }
}

/// Where a test's structure starts for its block at `pos`, `getStructurePos`: past the padding
/// each way, then one up and one south.
pub fn structure_pos(pos: (i32, i32, i32), padding: i32) -> (i32, i32, i32) {
    let (x, y, z) = pos
    return (x + padding, y + padding + 1, z + padding + 1)
}

/// The box of a test's structure, `getStructureBoundingBox`: from where it starts to its size
/// turned, inclusive.
pub fn structure_box(pos: (i32, i32, i32), padding: i32, size: (i32, i32, i32)) -> ((i32, i32, i32), (i32, i32, i32)) {
    let (x, y, z) = structure_pos(pos, padding)
    let (sx, sy, sz) = size
    let (fx, fy, fz) = (x + sx - 1, y + sy - 1, z + sz - 1)
    return ((java_min(x, fx), java_min(y, fy), java_min(z, fz)), (java_max(x, fx), java_max(y, fy), java_max(z, fz)))
}

/// The corner a test's structure is placed from, `getStartCorner`: where it starts, moved along
/// by its size, not turned, for its rotation.
pub fn start_corner(pos: (i32, i32, i32), padding: i32, size: (i32, i32, i32), rotation: i32) -> (i32, i32, i32) {
    let (x, y, z) = structure_pos(pos, padding)
    let (sx, _, sz) = size
    if rotation == CLOCKWISE_90 {
        return (x + sz - 1, y, z)
    }
    if rotation == CLOCKWISE_180 {
        return (x + sx - 1, y, z + sz - 1)
    }
    if rotation == COUNTERCLOCKWISE_90 {
        return (x, y, z + sx - 1)
    }
    return (x, y, z)
}

/// `Rotation.getRotated`: `a` turned on by `b`.
pub fn rotated(a: i32, b: i32) -> i32 {
    return (a + b) % 4
}

/// A rotation by its serialized name, `none` for one that isn't.
pub fn rotation_named(name: String) -> i32 {
    if name == "clockwise_90" {
        return CLOCKWISE_90
    }
    if name == "180" {
        return CLOCKWISE_180
    }
    if name == "counterclockwise_90" {
        return COUNTERCLOCKWISE_90
    }
    return NONE
}

/// A rotation's serialized name.
pub fn rotation_name(rotation: i32) -> String {
    if rotation == CLOCKWISE_90 {
        return String("clockwise_90")
    }
    if rotation == CLOCKWISE_180 {
        return String("180")
    }
    if rotation == COUNTERCLOCKWISE_90 {
        return String("counterclockwise_90")
    }
    return String("none")
}

fn text(m: JavaHashMap<String, Tag>, key: str) -> String {
    if not m.contains(key) {
        return String()
    }
    return match m[key] {
        Tag.Str(s) => s.copy(),
        _ => String(),
    }
}

fn int(m: JavaHashMap<String, Tag>, key: str, otherwise: i32) -> i32 {
    if not m.contains(key) {
        return otherwise
    }
    return m[key].number_int() ?? otherwise
}

fn java_min(a: i32, b: i32) -> i32 {
    return if a < b { a } else { b }
}

fn java_max(a: i32, b: i32) -> i32 {
    return if a > b { a } else { b }
}

/// A test as it runs, `GameTestInfo` (CAL-365): its test, the rotation it's run at beyond its
/// own, its level, the test instance block it has once it's placed, how many times it may run
/// and whether it stops at a failure, `RetryOptions`; its tick, from below 0 as it's set up,
/// whether its structure's placed and its chunks loaded, whether it's started and done; the
/// error it failed with, as `GameTestException` describes it and as its message reads; the
/// milliseconds it ran, from when it started; and the report it's counted in, which its reruns
/// share, `ReportGameListener`.
pub struct TestRun {
    pub def: TestDef
    pub extra: i32 = NONE
    pub dim: usize = 0
    pub pos: (i32, i32, i32)? = none
    pub tries: i32 = 1
    pub halt_on_failure: bool = true
    pub tick: i32 = 0
    pub placed: bool = false
    pub chunks_loaded: bool = false
    pub started: bool = false
    pub done: bool = false
    pub failed: bool = false
    pub description: Component? = none
    pub message: String = ""
    pub started_at: u64 = 0
    pub millis: i64 = 0
    pub report: usize = 0
}

impl TestRun {
    /// `copyReset`: the test again from the start, at the same block, in the same report.
    pub fn again(self) -> TestRun {
        return TestRun { def: self.def.copy(), extra: self.extra, dim: self.dim, pos: self.pos, tries: self.tries, halt_on_failure: self.halt_on_failure, report: self.report }
    }

    /// `RetryOptions.hasRetries`.
    pub fn has_retries(self) -> bool {
        return self.tries != 1
    }

    /// `RetryOptions.hasTriesLeft` after `attempts`, of which `successes` passed.
    pub fn tries_left(self, attempts: i32, successes: i32) -> bool {
        let failures = attempts != successes
        let more = self.tries < 1 or attempts < self.tries
        return more and (not failures or not self.halt_on_failure)
    }
}

/// A batch of tests, `GameTestBatch` (CAL-365): its index among its environment's, its tests by
/// their places among the runner's, its environment as written and its name, `getRegisteredName`,
/// and its level.
pub struct TestBatch {
    pub index: i32
    pub runs: List<usize>
    pub environment: Tag? = none
    pub name: String = ""
    pub dim: usize = 0
}

/// Where the next test goes in a level's grid, `StructureGridSpawner.DimensionGridState`
/// (CAL-365): its first corner, the next, the box of the row so far, how many the row has, and
/// the tests of the last batch.
pub struct TestGrid {
    pub dim: usize
    pub first: (i32, i32, i32)
    pub next: (i32, i32, i32)
    pub row_min: (f64, f64, f64)
    pub row_max: (f64, f64, f64)
    pub in_row: i32 = 0
    pub last_batch: List<usize> = List<usize>()
}

impl TestGrid {
    /// A level's grid from `first`, its row `new AABB(first)`.
    pub fn from(dim: usize, first: (i32, i32, i32)) -> TestGrid {
        let (x, y, z) = first
        return TestGrid { dim: dim, first: first, next: first, row_min: (f64(x), f64(y), f64(z)), row_max: (f64(x + 1), f64(y + 1), f64(z + 1)) }
    }
}

/// The game tests and their runner, `GameTestTicker.SINGLETON` and the `GameTestRunner` it has
/// (CAL-365): every test the runner has run or will, `allTestInfos`; those ticking; whether it
/// has a runner, is ticking them now, or is to stop once it's done, `HALTING`; the runner's
/// batches, the one it's on and its tests, those to run again, whether it's stopped, the
/// environment it set up and how it was before; its grids, how many tests a row has, whether the
/// grid also places tests already placed, clears a batch's before the next and stops at a
/// failure, `haltOnError`, and clears between batches; the most tests a batch has; each report's
/// attempts and successes; the tests the summary tracks; and the tests that failed last,
/// `FailedTestTracker`, by ID.
pub struct GameTests {
    pub runs: List<TestRun> = List<TestRun>()
    pub ticking: List<usize> = List<usize>()
    pub has_runner: bool = false
    pub in_tick: bool = false
    pub halting: bool = false
    pub batches: List<TestBatch> = List<TestBatch>()
    pub batch: usize = 0
    pub batch_runs: List<usize> = List<usize>()
    pub reruns: List<usize> = List<usize>()
    pub stopped: bool = true
    pub environment: Tag? = none
    pub grids: List<TestGrid> = List<TestGrid>()
    pub per_row: i32 = 8
    pub grid_existing: bool = false
    pub clear_on_batch: bool = false
    pub halt_on_error: bool = false
    pub clear_between: bool = false
    pub per_batch: usize = 50
    pub reports: List<(i32, i32)> = List<(i32, i32)>()
    pub tracked: List<usize> = List<usize>()
    pub failed: List<String> = List<String>()
}

impl GameTests {
    /// `FailedTestTracker.rememberFailedTest`.
    pub fn remember_failed(mut self, id: String) {
        if not self.failed.contains(id) {
            self.failed.push(id.copy())
        }
    }

    /// `GameTestBatchFactory.fromGameTestInfo(per_batch).batch` of the runs at `runs`: by their
    /// environment and level, in the order each first comes, each run of up to `per_batch`
    /// numbered from 0.
    pub fn batched(self, runs: List<usize>) -> List<TestBatch> {
        var keys = List<(String, usize)>()
        var groups = List<List<usize>>()
        var environments = List<Tag?>()
        for i in runs {
            let key = (environment_key(self.runs[i].def.environment), self.runs[i].dim)
            var at: usize? = none
            for k in 0..keys.len() {
                if keys[k] == key {
                    at = some(k)
                }
            }
            match at {
                some(k) => groups[k].push(i),
                none => {
                    keys.push(key)
                    groups.push([i])
                    environments.push(self.runs[i].def.environment.copy())
                },
            }
        }
        var out = List<TestBatch>()
        for k in 0..keys.len() {
            var index = 0
            var part = List<usize>()
            for i in groups[k] {
                part.push(i)
                if part.len() == self.per_batch {
                    out.push(TestBatch { index: index, runs: part.copy(), environment: environments[k].copy(), name: environment_name(environments[k]), dim: keys[k].1 })
                    part.clear()
                    index += 1
                }
            }
            if not part.is_empty() {
                out.push(TestBatch { index: index, runs: part, environment: environments[k].copy(), name: environment_name(environments[k]), dim: keys[k].1 })
            }
        }
        return out
    }

    /// `MultipleTestTracker.isDone` of the runs at `runs`.
    pub fn all_done(self, runs: List<usize>) -> bool {
        for i in runs {
            if not self.runs[i].done {
                return false
            }
        }
        return true
    }
}

// What tells two environments apart as a batch's key: an ID, or one given whole as written.
fn environment_key(environment: Tag?) -> String {
    return match environment {
        some(Tag.Str(id)) => id.copy(),
        some(t) => t.to_snbt(),
        none => String(),
    }
}

/// An environment's name, `Holder.getRegisteredName`: its ID, `[unregistered]` for one given whole.
pub fn environment_name(environment: Tag?) -> String {
    return match environment {
        some(Tag.Str(id)) => id.copy(),
        _ => String("[unregistered]"),
    }
}
