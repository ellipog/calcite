/// The locator bar's waypoints of a level, as vanilla's `ServerWaypointManager` keeps them
/// (CAL-174): the players whose waypoints it tracks, `waypoints`, those who receive them,
/// `players`, and each receiver's link to each source whose waypoint they have,
/// `WaypointTransmitter.Connection`. A link goes by the block the source was last told at,
/// `EntityBlockConnection`; by its chunk where the receiver's view doesn't take that in,
/// `EntityChunkConnection`; or, past 332 blocks, by the way to it, `EntityAzimuthConnection`. A
/// source makes none on its first tick, `firstTick`, nor where it's further than the lesser of how
/// far it transmits and the receiver receives, nor where it's a spectator and the receiver isn't,
/// `doesSourceIgnoreReceiver`. What a receiver's told is a `ClientboundTrackedWaypointPacket`: its
/// operation, 0 to track a waypoint, 1 to stop and 2 to update it, and the waypoint, the source's
/// UUID, its icon and where, as `TrackedWaypoint` writes it.
module server.waypoints

import math.mth.{table_atan2}
import protocol.wire.{Writer}

/// Past how many blocks a waypoint goes by the way to it, `REALLY_FAR_DISTANCE`.
pub const REALLY_FAR: f32 = 332.0f32

// The links' kinds, and the operations, `ClientboundTrackedWaypointPacket.Operation`.
const BLOCK: i32 = 0
const CHUNK: i32 = 1
const AZIMUTH: i32 = 2
const TRACK: i32 = 0
const UNTRACK: i32 = 1
const UPDATE: i32 = 2

/// What the locator bar asks of a player: their entity ID and UUID, where they are, the chunk
/// their view's around and how far it reaches, below nought where they have none, whether
/// they're a spectator and on their first tick, how far they transmit and receive waypoints,
/// `waypoint_transmit_range` and `waypoint_receive_range`, and their waypoint's icon,
/// `locatorBarIcon`: its style and its color, where it has one.
pub struct Beacon {
    pub id: i32
    pub uuid: (i64, i64)
    pub x: f64
    pub y: f64
    pub z: f64
    pub center_x: i32
    pub center_z: i32
    pub view: i32
    pub spectator: bool
    pub first_tick: bool
    pub transmit: f64
    pub receive: f64
    pub style: String
    pub color: i32?
}

/// A packet for the player `receiver`: its operation and the waypoint as it's written.
pub struct Told {
    pub receiver: i32
    pub operation: i32
    pub body: List<u8>
}

// A receiver's link to a source: its kind; where the source was last told at, a block, or a
// chunk across `x` and `z`, or the way to it; and the icon it was made with.
struct Link {
    receiver: i32
    source: i32
    uuid: (i64, i64)
    kind: i32
    x: i32 = 0
    y: i32 = 0
    z: i32 = 0
    angle: f32 = 0.0f32
    style: String
    color: i32? = none
}

/// A level's locator bar.
pub struct Waypoints {
    sources: List<i32> = List<i32>()
    receivers: List<i32> = List<i32>()
    links: List<Link> = List<Link>()
}

impl Waypoints {
    /// Whether the player `id`'s waypoint is tracked, and whether they receive waypoints.
    pub fn is_source(self, id: i32) -> bool {
        return self.sources.contains(id)
    }

    pub fn is_receiver(self, id: i32) -> bool {
        return self.receivers.contains(id)
    }

    /// `addPlayer`: the player `p` receives waypoints, linked to each source as it is, then their
    /// own's tracked where they transmit one. `bar` is whether the locator bar's on,
    /// `locator_bar`.
    pub fn add_player(mut self, p: i32, bs: List<Beacon>, bar: bool, out: mut List<Told>) {
        if not self.receivers.contains(p) {
            self.receivers.push(p)
        }
        for s in self.sources.copy() {
            self.create(p, s, bs, bar, mut out)
        }
        if let b = beacon(bs, p) {
            if transmits(b) {
                self.track(p, bs, bar, mut out)
            }
        }
    }

    /// `trackWaypoint`: the player `source`'s waypoint is tracked, and each receiver linked to it
    /// as it is.
    pub fn track(mut self, source: i32, bs: List<Beacon>, bar: bool, out: mut List<Told>) {
        if not self.sources.contains(source) {
            self.sources.push(source)
        }
        for r in self.receivers.copy() {
            self.create(r, source, bs, bar, mut out)
        }
    }

    /// `untrackWaypoint`: each receiver linked to the player `source` is told it's gone, and it's
    /// no longer tracked.
    pub fn untrack(mut self, source: i32, out: mut List<Told>) {
        var kept = List<Link>()
        for l in self.links {
            if l.source == source {
                out.push(untracked(l))
            } else {
                kept.push(l.copy())
            }
        }
        self.links = kept
        self.sources = without(self.sources, source)
    }

    /// `updateWaypoint`, as the player `source` moves: each link to them looked at again, then
    /// each receiver without one linked as it is.
    pub fn update_waypoint(mut self, source: i32, bs: List<Beacon>, bar: bool, out: mut List<Told>) {
        if not self.sources.contains(source) {
            return
        }
        var linked = List<i32>()
        for l in self.links {
            if l.source == source {
                linked.push(l.receiver)
            }
        }
        for r in linked {
            self.update(r, source, bs, bar, mut out)
        }
        for r in self.receivers.copy() {
            if self.link_at(r, source) == none {
                self.create(r, source, bs, bar, mut out)
            }
        }
    }

    /// `updatePlayer`, as the player `p` moves: each of their links looked at again, then each
    /// source they've none to linked as it is.
    pub fn update_player(mut self, p: i32, bs: List<Beacon>, bar: bool, out: mut List<Told>) {
        var linked = List<i32>()
        for l in self.links {
            if l.receiver == p {
                linked.push(l.source)
            }
        }
        for s in linked {
            self.update(p, s, bs, bar, mut out)
        }
        for s in self.sources.copy() {
            if self.link_at(p, s) == none {
                self.create(p, s, bs, bar, mut out)
            }
        }
    }

    /// `removePlayer`: the player `p` is told each waypoint they had is gone, their own's no
    /// longer tracked, and they receive none.
    pub fn remove_player(mut self, p: i32, out: mut List<Told>) {
        var kept = List<Link>()
        for l in self.links {
            if l.receiver == p {
                out.push(untracked(l))
            } else {
                kept.push(l.copy())
            }
        }
        self.links = kept
        self.untrack(p, mut out)
        self.receivers = without(self.receivers, p)
    }

    // `createConnection`: the receiver linked to the source as it is now, and told of it, or,
    // where it can't be, an old link gone and the receiver told so.
    fn create(mut self, receiver: i32, source: i32, bs: List<Beacon>, bar: bool, out: mut List<Told>) {
        if receiver == source or not bar {
            return
        }
        let src = beacon(bs, source) else return
        let rcv = beacon(bs, receiver) else return
        match make_link(src, rcv) {
            some(l) => {
                out.push(told(l, TRACK))
                self.put(l)
            },
            none => {
                if let at = self.link_at(receiver, source) {
                    out.push(untracked(self.links[at]))
                    _ = self.links.remove(at)
                }
            },
        }
    }

    // `updateConnection`: a link that still holds tells the receiver where the source is now,
    // where that changed; one that's broken is made anew, or goes.
    fn update(mut self, receiver: i32, source: i32, bs: List<Beacon>, bar: bool, out: mut List<Told>) {
        if receiver == source or not bar {
            return
        }
        let at = self.link_at(receiver, source) else return
        let src = beacon(bs, source) else return
        let rcv = beacon(bs, receiver) else return
        if not broken(self.links[at], src, rcv) {
            var l = self.links[at].copy()
            if moved(mut l, src, rcv) {
                out.push(told(l, UPDATE))
                self.links[at] = l
            }
            return
        }
        match make_link(src, rcv) {
            some(l) => {
                out.push(told(l, TRACK))
                self.links[at] = l
            },
            none => {
                out.push(untracked(self.links[at]))
                _ = self.links.remove(at)
            },
        }
    }

    // Puts the link in, in place of any the receiver had to the source.
    fn put(mut self, l: own Link) {
        if let at = self.link_at(l.receiver, l.source) {
            self.links[at] = l
            return
        }
        self.links.push(l)
    }

    fn link_at(self, receiver: i32, source: i32) -> usize? {
        for i in 0..self.links.len() {
            if self.links[i].receiver == receiver and self.links[i].source == source {
                return some(i)
            }
        }
        return none
    }
}

/// Whether the player transmits a waypoint, `isTransmittingWaypoint`, and receives them,
/// `isReceivingWaypoints`.
pub fn transmits(b: Beacon) -> bool {
    return b.transmit > 0.0
}

pub fn receives(b: Beacon) -> bool {
    return b.receive > 0.0
}

fn beacon(bs: List<Beacon>, id: i32) -> Beacon? {
    for b in bs {
        if b.id == id {
            return some(b.copy())
        }
    }
    return none
}

fn without(ids: List<i32>, id: i32) -> List<i32> {
    var out = List<i32>()
    for i in ids {
        if i != id {
            out.push(i)
        }
    }
    return out
}

// `LivingEntity.makeWaypointConnectionWith`: none on the source's first tick, or where it ignores
// the receiver; past 332 blocks the way to it; where the receiver's view doesn't take its chunk
// in, its chunk; else its block.
fn make_link(src: Beacon, rcv: Beacon) -> Link? {
    if src.first_tick or src.id == rcv.id or ignores(src, rcv) {
        return none
    }
    var l = Link { receiver: rcv.id, source: src.id, uuid: src.uuid, kind: BLOCK, style: src.style.copy(), color: src.color }
    if really_far(src, rcv) {
        l.kind = AZIMUTH
        l.angle = azimuth(src, rcv)
        return some(l)
    }
    let (cx, cz) = chunk_of(src)
    if not chunk_visible(cx, cz, rcv) {
        l.kind = CHUNK
        l.x = cx
        l.z = cz
        return some(l)
    }
    let (bx, by, bz) = block_of(src)
    l.x = bx
    l.y = by
    l.z = bz
    return some(l)
}

// `isBroken`: a block link where the source's more than a block from where it was told, a chunk
// link more than a chunk from its chunk or where the receiver's view takes that chunk in now,
// and a way where it's no longer really far or the receiver's view takes its chunk in; and any
// where the source ignores the receiver.
fn broken(l: Link, src: Beacon, rcv: Beacon) -> bool {
    if l.kind == BLOCK {
        let (bx, by, bz) = block_of(src)
        return (bx - l.x).abs() + (by - l.y).abs() + (bz - l.z).abs() > 1 or ignores(src, rcv)
    }
    if l.kind == CHUNK {
        let (cx, cz) = chunk_of(src)
        let far = max((cx - l.x).abs(), (cz - l.z).abs()) > 1
        if not far and not ignores(src, rcv) {
            return chunk_visible(l.x, l.z, rcv)
        }
        return true
    }
    let (cx, cz) = chunk_of(src)
    return ignores(src, rcv) or chunk_visible(cx, cz, rcv) or not really_far(src, rcv)
}

// `Connection.update`: whether the source's block, chunk or way changed, by more than half a
// degree for a way, the link then holding it.
fn moved(l: mut Link, src: Beacon, rcv: Beacon) -> bool {
    if l.kind == BLOCK {
        let (bx, by, bz) = block_of(src)
        if (bx - l.x).abs() + (by - l.y).abs() + (bz - l.z).abs() > 0 {
            l.x = bx
            l.y = by
            l.z = bz
            return true
        }
        return false
    }
    if l.kind == CHUNK {
        let (cx, cz) = chunk_of(src)
        if max((cx - l.x).abs(), (cz - l.z).abs()) > 0 {
            l.x = cx
            l.z = cz
            return true
        }
        return false
    }
    let angle = azimuth(src, rcv)
    if (angle - l.angle).abs() > 0.008726646f32 {
        l.angle = angle
        return true
    }
    return false
}

// `doesSourceIgnoreReceiver`: never a spectator receiver; always a spectator source; else where
// the source's at least the lesser of its transmitting and the receiver's receiving range away.
fn ignores(src: Beacon, rcv: Beacon) -> bool {
    if rcv.spectator {
        return false
    }
    if src.spectator {
        return true
    }
    let range = if src.transmit < rcv.receive { src.transmit } else { rcv.receive }
    return f64(distance(src, rcv)) >= range
}

fn really_far(src: Beacon, rcv: Beacon) -> bool {
    return distance(src, rcv) > REALLY_FAR
}

// `Entity.distanceTo`, in floats.
fn distance(a: Beacon, b: Beacon) -> f32 {
    let xd = f32.nearest(a.x - b.x)
    let yd = f32.nearest(a.y - b.y)
    let zd = f32.nearest(a.z - b.z)
    return f32.nearest(f64(xd * xd + yd * yd + zd * zd).sqrt())
}

// `EntityAzimuthConnection`'s angle: of the way from the source to the receiver turned a right
// angle clockwise, `rotateClockwise90`, `Mth.atan2`.
fn azimuth(src: Beacon, rcv: Beacon) -> f32 {
    let dx = rcv.x - src.x
    let dz = rcv.z - src.z
    return f32.nearest(table_atan2(dx, -dz) ?? 0.0)
}

// `isChunkVisible`: the receiver's view takes the chunk in, `isInViewDistance`, a chunk past its
// reach as its edge.
fn chunk_visible(x: i32, z: i32, rcv: Beacon) -> bool {
    if rcv.view < 0 {
        return false
    }
    let dx = i64(max(0, (x - rcv.center_x).abs() - 1))
    let dz = i64(max(0, (z - rcv.center_z).abs() - 1))
    return dx * dx + dz * dz < i64(rcv.view) * i64(rcv.view)
}

fn block_of(b: Beacon) -> (i32, i32, i32) {
    return (i32.saturate(b.x.floor()), i32.saturate(b.y.floor()), i32.saturate(b.z.floor()))
}

fn chunk_of(b: Beacon) -> (i32, i32) {
    let (x, _, z) = block_of(b)
    return (x >> 4, z >> 4)
}

fn max(a: i32, b: i32) -> i32 {
    return if a > b { a } else { b }
}

// The link's waypoint told the receiver: its source's UUID, its icon, its kind and where.
fn told(l: Link, operation: i32) -> Told {
    var w = Writer.new()
    head(mut w, l.uuid, l.style.copy(), l.color)
    if l.kind == BLOCK {
        w.varint(1)
        w.varint(l.x)
        w.varint(l.y)
        w.varint(l.z)
    } else if l.kind == CHUNK {
        w.varint(2)
        w.varint(l.x)
        w.varint(l.z)
    } else {
        w.varint(3)
        w.f32(l.angle)
    }
    return Told { receiver: l.receiver, operation: operation, body: w.into_bytes() }
}

// `removeWaypoint`: the link's source gone, `TrackedWaypoint.empty`, its icon none.
fn untracked(l: Link) -> Told {
    var w = Writer.new()
    head(mut w, l.uuid, String("minecraft:default"), none)
    w.varint(0)
    return Told { receiver: l.receiver, operation: UNTRACK, body: w.into_bytes() }
}

// `TrackedWaypoint.write`'s start: the identifier, a UUID, `Either.left`; the icon's style, and
// its color, red, green and blue, where it has one.
fn head(w: mut Writer, uuid: (i64, i64), style: String, color: i32?) {
    let (most, least) = uuid
    w.bool(true)
    w.i64(most)
    w.i64(least)
    w.string(style, 32767)
    match color {
        some(c) => {
            w.bool(true)
            w.u8(u8.wrap(c >> 16))
            w.u8(u8.wrap(c >> 8))
            w.u8(u8.wrap(c))
        },
        none => w.bool(false),
    }
}
