/// The status the server list shows, vanilla's `ServerStatus`, and its JSON as the status
/// response sends it.
module server.status

import chat.component.{Component}
import java.base64.{encode}
import java.uuid.{Uuid}
import json.gson.{JsonWriter}
import protocol.ids.{PROTOCOL_VERSION, game_version}

/// A player the server list names, vanilla's `NameAndId`.
pub struct PlayerSample {
    pub id: Uuid
    pub name: String
}

/// What the server list shows.
pub struct ServerStatus {
    /// The description, from `motd`.
    pub description: Component
    pub max_players: i32
    pub online: i32
    /// Up to 12 of the players online, which the client shows when the count is hovered.
    pub sample: List<PlayerSample>
    pub version_name: String
    pub protocol: i32
    /// The server's icon: a 64 by 64 PNG.
    pub favicon: List<u8>?
    /// Whether players need Mojang-signed chat keys, which the client warns about.
    pub enforces_secure_chat: bool
}

impl ServerStatus {
    /// The status of a server that has just started, with this version, no one online, and
    /// secure chat not enforced, as it can't be until the services' keys come.
    pub fn starting(description: own Component, max_players: i32, favicon: own List<u8>?) -> ServerStatus {
        return ServerStatus { description: description, max_players: max_players, online: 0, sample: [], version_name: game_version(), protocol: PROTOCOL_VERSION, favicon: favicon, enforces_secure_chat: false }
    }

    /// The status as vanilla's `ServerStatus.CODEC` writes it, through Gson: `description`,
    /// `players`, `version`, `favicon` and `enforcesSecureChat`, in that order. A field that's
    /// its codec's default is left out: an empty description, an empty sample, no icon, and
    /// `enforcesSecureChat` when it's false.
    pub fn to_json(self) -> String {
        var w = JsonWriter.new()
        w.begin_object()
        if not self.description.is_empty() {
            w.name("description")
            self.description.write_json(mut w)
        }
        w.name("players")
        w.begin_object()
        w.name("max")
        w.i32(self.max_players)
        w.name("online")
        w.i32(self.online)
        if not self.sample.is_empty() {
            w.name("sample")
            w.begin_array()
            for p in self.sample {
                w.begin_object()
                w.name("id")
                w.string(p.id.to_string())
                w.name("name")
                w.string(p.name)
                w.end_object()
            }
            w.end_array()
        }
        w.end_object()
        w.name("version")
        w.begin_object()
        w.name("name")
        w.string(self.version_name)
        w.name("protocol")
        w.i32(self.protocol)
        w.end_object()
        if let icon = self.favicon {
            w.name("favicon")
            w.string("data:image/png;base64,{encode(icon)}")
        }
        if self.enforces_secure_chat {
            w.name("enforcesSecureChat")
            w.bool(true)
        }
        w.end_object()
        return w.into_string()
    }
}

/// `png` if it's a PNG of 64 by 64, as vanilla's `loadStatusIcon` checks with `PngInfo`, or
/// vanilla's message for why not.
pub fn check_icon(png: List<u8>) -> List<u8> ! String {
    if png.len() < 8 {
        fail "Couldn't load server icon: EOFException"
    }
    let signature: List<u8> = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A]
    var good = true
    for i in 0..signature.len() {
        good = good and png[i] == signature[i]
    }
    if not good {
        fail "Couldn't load server icon: Bad PNG Signature: {hex(png, 0, 8)}"
    }
    if png.len() < 26 {
        fail "Couldn't load server icon: EOFException"
    }
    let length = int_at(png, 8)
    if length != 13 {
        fail "Couldn't load server icon: Bad length for IHDR chunk: {length}"
    }
    if int_at(png, 12) != 0x49484452 {
        fail "Couldn't load server icon: Bad type for IHDR chunk: {hex(png, 12, 4)}"
    }
    let width = int_at(png, 16)
    let height = int_at(png, 20)
    let depth = i8.wrap(png[24])
    if depth != 1 and depth != 2 and depth != 4 and depth != 8 and depth != 16 {
        fail "Couldn't load server icon: Invalid bit depth: {depth}"
    }
    let color = i8.wrap(png[25])
    if color != 0 and color != 2 and color != 3 and color != 4 and color != 6 {
        fail "Couldn't load server icon: Invalid color type: {color}"
    }
    if depth == 16 {
        let estimate = 4 * i64(width) * i64(height) * 2
        if estimate != i64(i32.wrap(estimate)) {
            fail "Couldn't load server icon: Bounds check failed, {width}x{height}@{depth}, type: {color}"
        }
    }
    if width != 64 or height != 64 {
        fail "Couldn't load server icon: Invalid world icon size [{width}, {height}], but expected [64, 64]"
    }
    return png.copy()
}

fn int_at(b: List<u8>, at: usize) -> i32 {
    return (i32(b[at]) << 24) | (i32(b[at + 1]) << 16) | (i32(b[at + 2]) << 8) | i32(b[at + 3])
}

// The bytes as Java's `HexFormat.of().withUpperCase()` writes them.
fn hex(b: List<u8>, at: usize, n: usize) -> String {
    let digits = "0123456789ABCDEF"
    var out = String()
    for i in at..at + n {
        let d = b[i]
        out.push_str(digits[usize(d / 16)..usize(d / 16) + 1])
        out.push_str(digits[usize(d % 16)..usize(d % 16) + 1])
    }
    return out
}
