/// Calcite's commands so far, parsed as vanilla's brigadier dispatcher parses them against the
/// tree `Commands` builds, with brigadier's errors where they're its, and the tree each player is
/// sent, of the commands their permission level lets them use. They're vanilla's `gamemode` and
/// `stop`, and Calcite's own: `gmc`, `gms`, `gma` and `gmsp`, which are `gamemode` in each mode,
/// `calcite flyspeed` (D239) and `calcite dimension` (CAL-69). The rest of vanilla's come with
/// Phase 6 (P6.6).
///
/// A command is read as brigadier reads it: its first word picks a command its source may use,
/// each argument is read by its type, and an argument is followed by a space and the next, or by
/// the end. Where brigadier would throw, `parse` fails with what it throws: the message, and the
/// input and where in it, which vanilla shows under the message.
module server.commands

import chat.component.{ClickEvent, Component}
import java.uuid.{Uuid}
import protocol.play.{ClientboundCommands, CommandNode, NodeKind}
import registry.builtin.{builtin_entries, builtin_names}
import resources.identifier.{Identifier}
import world.modes.{GameType}

/// The permission level `gamemode` and Calcite's commands need, vanilla's `GAMEMASTERS`, which
/// also lets selectors such as `@a` be used.
pub const GAMEMASTERS: i32 = 2

/// The permission level `stop` needs, vanilla's `OWNERS`, which the console has.
pub const OWNERS: i32 = 4

/// The fastest `calcite flyspeed` sets: a thousand times vanilla's.
pub const MOST_FLY_SPEED: f32 = 1000.0f32

/// The players a command names, as vanilla's `EntityArgument.players()` reads them.
pub enum Targets {
    /// A player's name, matched without regard to case.
    Name(String)
    /// `@s`: the player running it.
    Me
    /// `@a`: every player.
    All
    /// `@p`: the nearest player.
    Nearest
    /// `@r`: a player at random.
    Random
}

/// A command, read.
pub enum Parsed {
    /// `stop`.
    Stop
    /// `gamemode <gamemode> [<target>]`, or one of Calcite's aliases: the mode, and the players,
    /// or `none` for the one running it.
    GameMode(GameType, Targets?)
    /// `calcite flyspeed [<speed>]`: the speed, as a multiple of vanilla's, or `none` to be told it.
    FlySpeed(f32?)
    /// `calcite dimension <dimension> [<target>]`: the dimension, which may not be one the world
    /// has, as a `dimension` argument reads any identifier, and the players to go there, or `none`
    /// for the one running it (CAL-69).
    Dimension(Identifier, Targets?)
}

/// Why a command can't be read or run, brigadier's `CommandSyntaxException`: its message, and,
/// where it has them, the input and where in it, in bytes.
pub struct Failure {
    pub message: Component
    pub input: String
    /// Where in `input`, or -1 for a failure with no place, which vanilla shows alone.
    pub cursor: i32
}

impl Failure {
    /// A failure with no place in the input, as an exception made with `create()`.
    pub fn alone(message: own Component) -> Failure {
        return Failure { message: message, input: String(), cursor: -1 }
    }
}

/// The commands a player whose permission level is `level` may use, as `sendCommands` sends
/// them: the tree's nodes numbered as `ClientboundCommandsPacket` numbers them, the root first,
/// then a level of the tree at a time, each node's children in the order they were added. A node
/// a player without permissions couldn't use is marked restricted.
pub fn tree(level: i32) -> ClientboundCommands {
    var specs = List<Spec>()
    specs.push(Spec { kind: NodeKind.Root, executable: false, restricted: false, children: [] })
    // Vanilla's, in the order `Commands` registers them, then Calcite's.
    if level >= GAMEMASTERS {
        let target = add(mut specs, Spec { kind: entity_argument(), executable: true, restricted: false, children: [] })
        let mode = add(mut specs, Spec { kind: argument("gamemode", "gamemode", []), executable: true, restricted: false, children: [target] })
        let literal = add(mut specs, Spec { kind: NodeKind.Literal(String("gamemode")), executable: false, restricted: true, children: [mode] })
        specs[0].children.push(literal)
    }
    if level >= OWNERS {
        let stop = add(mut specs, Spec { kind: NodeKind.Literal(String("stop")), executable: true, restricted: true, children: [] })
        specs[0].children.push(stop)
    }
    if level >= GAMEMASTERS {
        let speed = add(mut specs, Spec { kind: argument("speed", "brigadier:float", float_range(0.0f32, MOST_FLY_SPEED)), executable: true, restricted: false, children: [] })
        let flyspeed = add(mut specs, Spec { kind: NodeKind.Literal(String("flyspeed")), executable: true, restricted: false, children: [speed] })
        let moved = add(mut specs, Spec { kind: entity_argument(), executable: true, restricted: false, children: [] })
        let to = add(mut specs, Spec { kind: argument("dimension", "dimension", []), executable: true, restricted: false, children: [moved] })
        let dimension = add(mut specs, Spec { kind: NodeKind.Literal(String("dimension")), executable: false, restricted: false, children: [to] })
        let calcite = add(mut specs, Spec { kind: NodeKind.Literal(String("calcite")), executable: false, restricted: true, children: [flyspeed, dimension] })
        specs[0].children.push(calcite)
        for name in ["gmc", "gms", "gma", "gmsp"] {
            let target = add(mut specs, Spec { kind: entity_argument(), executable: true, restricted: false, children: [] })
            let alias = add(mut specs, Spec { kind: NodeKind.Literal(String(name)), executable: true, restricted: true, children: [target] })
            specs[0].children.push(alias)
        }
    }
    // Numbered a level at a time, from the root.
    var order: List<usize> = [0]
    var ids: List<i32> = [-1; specs.len()]
    ids[0] = 0
    var at: usize = 0
    while at < order.len() {
        let s = order[at]
        for c in specs[s].children {
            if ids[c] == -1 {
                ids[c] = i32.wrap(order.len())
                order.push(c)
            }
        }
        at += 1
    }
    var nodes = List<CommandNode>()
    for s in order {
        var children = List<i32>()
        for c in specs[s].children {
            children.push(ids[c])
        }
        nodes.push(CommandNode { kind: specs[s].kind.copy(), executable: specs[s].executable, restricted: specs[s].restricted, children: children })
    }
    return ClientboundCommands { nodes: nodes, root: 0 }
}

// A node of the tree, its children by their places among the specs.
struct Spec {
    kind: NodeKind
    executable: bool
    restricted: bool
    children: List<usize>
}

fn add(specs: mut List<Spec>, s: own Spec) -> usize {
    specs.push(s)
    return specs.len() - 1
}

// An argument node named `name` of the argument type `parser`, as `minecraft:<parser>` or
// `brigadier:<type>`, with its properties as `ArgumentTypeInfo.serializeToNetwork` writes them.
fn argument(name: str, parser: str, properties: own List<u8>) -> NodeKind {
    return NodeKind.Argument { name: String(name), parser: argument_type(parser), properties: properties }
}

// `target`, `EntityArgument.players()`: many, and only players, flags 2.
fn entity_argument() -> NodeKind {
    return argument("target", "entity", [2])
}

// A float argument from `min` to `max`, as `FloatArgumentInfo` writes it: both bounds' flags,
// then each bound.
fn float_range(min: f32, max: f32) -> List<u8> {
    var out: List<u8> = [3]
    for v in [min, max] {
        let bits = v.to_bits()
        out.push(u8.wrap(bits >> 24))
        out.push(u8.wrap(bits >> 16))
        out.push(u8.wrap(bits >> 8))
        out.push(u8.wrap(bits))
    }
    return out
}

/// The ID of the argument type `name`, such as `gamemode` or `brigadier:float`, in the
/// `command_argument_type` registry.
pub fn argument_type(name: str) -> i32 {
    let names = builtin_names()
    for r in 0..names.len() {
        if names[r] == "command_argument_type" {
            let entries = builtin_entries(r)
            for i in 0..entries.len() {
                if entries[i] == String(name) {
                    return i32.wrap(i)
                }
            }
        }
    }
    panic("there's no command argument type {name}")
}

/// The command `input`, without its `/`, as the dispatcher reads it for a source whose
/// permission level is `level`: the commands it may not use aren't there for it.
pub fn parse(input: String, level: i32) -> Parsed ! Failure {
    var r = Reading { text: input.copy(), at: 0 }
    let word = r.word()
    if word == "gamemode" and level >= GAMEMASTERS {
        r.at = word.len()
        try r.next_argument()
        let mode = try r.game_mode()
        let targets = try r.optional_targets()
        return Parsed.GameMode(mode, targets)
    }
    if word == "stop" and level >= OWNERS {
        r.at = word.len()
        try r.end()
        return Parsed.Stop
    }
    if word == "calcite" and level >= GAMEMASTERS {
        r.at = word.len()
        try r.next_argument()
        let sub = r.word()
        if sub == "dimension" {
            r.at += 9
            try r.next_argument()
            let id = try r.identifier()
            let targets = try r.optional_targets()
            return Parsed.Dimension(id, targets)
        }
        if sub != "flyspeed" {
            // No child of `calcite` matches: brigadier stops after the space.
            fail r.failure_here(Component.translatable("command.unknown.argument", []))
        }
        r.at += 8
        if not r.can_read(2) {
            try r.end()
            return Parsed.FlySpeed(none)
        }
        r.at += 1
        let speed = try r.float_between(0.0f32, MOST_FLY_SPEED)
        try r.end()
        return Parsed.FlySpeed(some(speed))
    }
    let aliases = [("gmc", GameType.Creative), ("gms", GameType.Survival), ("gma", GameType.Adventure), ("gmsp", GameType.Spectator)]
    for (name, mode) in aliases {
        if word == String(name) and level >= GAMEMASTERS {
            r.at = word.len()
            let targets = try r.optional_targets()
            return Parsed.GameMode(mode, targets)
        }
    }
    // No command matches its first word.
    r.at = 0
    if input.is_empty() {
        fail r.failure_here(Component.translatable("command.unknown.command", []))
    }
    fail r.failure_here(Component.translatable("command.unknown.command", []))
}

// Brigadier's `StringReader` over the input, at a byte.
struct Reading {
    text: String
    at: usize
}

impl Reading {
    fn can_read(self, n: usize) -> bool {
        return self.at + n <= self.text.len()
    }

    fn peek(self) -> u8 {
        return self.text.byte_at(self.at)
    }

    // The input up to the next space, from here, as `getRelevantNodes` takes a literal's word.
    fn word(self) -> String {
        var end = self.at
        while end < self.text.len() and self.text.byte_at(end) != 32 {
            end += 1
        }
        return self.text[self.at..end]
    }

    // A failure at the reader's place.
    fn failure_here(self, message: own Component) -> Failure {
        return Failure { message: message, input: self.text.copy(), cursor: i32.wrap(self.at) }
    }

    // After a node that needs more: a space and something after it, which the reader goes past
    // the space to. At the end, the command is incomplete; with only a space left, the argument
    // after it is missing.
    fn next_argument(mut self) ! Failure {
        if not self.can_read(1) {
            fail self.failure_here(Component.translatable("command.unknown.command", []))
        }
        if not self.can_read(2) {
            fail self.failure_here(Component.translatable("command.unknown.argument", []))
        }
        self.at += 1
    }

    // After the last node: the end of the input. Brigadier reads past a space only where
    // something follows it, and then finds nothing that can read it.
    fn end(mut self) ! Failure {
        if not self.can_read(1) {
            return
        }
        if self.peek() != 32 {
            fail self.failure_here(Component.translatable("command.expected.separator", []))
        }
        if self.can_read(2) {
            self.at += 1
        }
        fail self.failure_here(Component.translatable("command.unknown.argument", []))
    }

    // `<target>` after an executable node: the end, or a space and the players.
    fn optional_targets(mut self) -> Targets? ! Failure {
        if not self.can_read(2) {
            try self.end()
            return none
        }
        if self.peek() != 32 {
            fail self.failure_here(Component.translatable("command.expected.separator", []))
        }
        self.at += 1
        let targets = try self.targets()
        try self.end()
        return some(targets)
    }

    // `GameModeArgument.parse`: an unquoted string that names a mode.
    fn game_mode(mut self) -> GameType ! Failure {
        let name = self.unquoted()
        let mode = GameType.by_name(name) else fail self.failure_here(Component.translatable("argument.gamemode.invalid", [Component.literal(name)]))
        if self.can_read(1) and self.peek() != 32 {
            fail self.failure_here(Component.translatable("command.expected.separator", []))
        }
        return mode
    }

    // `EntityArgument.players()`: a selector, `@` and its type, or a player's name or a UUID,
    // which, naming an entity, isn't a player's. A source that reaches this may use selectors.
    fn targets(mut self) -> Targets ! Failure {
        var targets = Targets.Me
        var entities = false
        if self.can_read(1) and self.peek() == 64 {
            self.at += 1
            if not self.can_read(1) {
                fail self.failure_here(Component.translatable("argument.entity.selector.missing", []))
            }
            let start = self.at
            let kind = self.peek()
            self.at += 1
            if kind == 97 {
                targets = Targets.All
            } else if kind == 112 {
                targets = Targets.Nearest
            } else if kind == 114 {
                targets = Targets.Random
            } else if kind == 115 {
                targets = Targets.Me
            } else if kind == 101 or kind == 110 {
                entities = true
            } else {
                self.at = start
                fail self.failure_here(Component.translatable("argument.entity.selector.unknown", [Component.literal("@{self.text[start..self.char_end(start)]}")]))
            }
            if self.can_read(1) and self.peek() == 91 {
                fail self.failure_here(Component.literal("Calcite doesn't read a selector's options yet"))
            }
        } else {
            let start = self.at
            let name = try self.string()
            if let _ = Uuid.parse(name) {
                entities = true
            } else {
                if name.is_empty() or name.len() > 16 {
                    self.at = start
                    fail self.failure_here(Component.translatable("argument.entity.invalid", []))
                }
                targets = Targets.Name(name)
            }
        }
        if entities {
            self.at = 0
            fail self.failure_here(Component.translatable("argument.player.entities", []))
        }
        if self.can_read(1) and self.peek() != 32 {
            fail self.failure_here(Component.translatable("command.expected.separator", []))
        }
        return targets
    }

    // `readUnquotedString`: the letters, digits and `_-.+` from here.
    fn unquoted(mut self) -> String {
        let start = self.at
        while self.can_read(1) and allowed_unquoted(self.peek()) {
            self.at += 1
        }
        return self.text[start..self.at]
    }

    // `readString`: a string in double or single quotes, with `\` before its quote or a `\`, or
    // an unquoted one.
    fn string(mut self) -> String ! Failure {
        if not self.can_read(1) {
            return String()
        }
        let quote = self.peek()
        if quote != 34 and quote != 39 {
            return self.unquoted()
        }
        self.at += 1
        var out = String()
        var escaped = false
        while self.can_read(1) {
            let c = self.peek()
            let end = self.char_end(self.at)
            if escaped {
                if c == quote or c == 92 {
                    out.push_str(self.text[self.at..end])
                    escaped = false
                } else {
                    let bad = self.text[self.at..end]
                    fail self.failure_here(Component.translatable("parsing.quote.escape", [Component.literal(bad)]))
                }
            } else if c == 92 {
                escaped = true
            } else if c == quote {
                self.at += 1
                return out
            } else {
                out.push_str(self.text[self.at..end])
            }
            self.at = end
        }
        fail self.failure_here(Component.translatable("parsing.quote.expected.end", []))
    }

    // `Identifier.read`: the characters an identifier may have, from here, as an identifier, or,
    // where they aren't one, a failure at their start.
    fn identifier(mut self) -> Identifier ! Failure {
        let start = self.at
        while self.can_read(1) and allowed_in_identifier(self.peek()) {
            self.at += 1
        }
        match Identifier.parse(self.text[start..self.at]) {
            ok(id) => return id,
            err(_) => {
                self.at = start
                fail self.failure_here(Component.translatable("argument.id.invalid", []))
            },
        }
    }

    // `FloatArgumentType.parse`: `readFloat`, from `min` to `max`.
    fn float_between(mut self, min: f32, max: f32) -> f32 ! Failure {
        let start = self.at
        while self.can_read(1) and (is_digit(self.peek()) or self.peek() == 46 or self.peek() == 45) {
            self.at += 1
        }
        let number = self.text[start..self.at]
        if number.is_empty() {
            fail self.failure_here(Component.translatable("parsing.float.expected", []))
        }
        let value = java_float(number) else {
            self.at = start
            fail self.failure_here(Component.translatable("parsing.float.invalid", [Component.literal(number)]))
        }
        if value < min {
            self.at = start
            fail self.failure_here(Component.translatable("argument.float.low", [Component.literal("{min}"), Component.literal("{value}")]))
        }
        if value > max {
            self.at = start
            fail self.failure_here(Component.translatable("argument.float.big", [Component.literal("{max}"), Component.literal("{value}")]))
        }
        if self.can_read(1) and self.peek() != 32 {
            fail self.failure_here(Component.translatable("command.expected.separator", []))
        }
        return value
    }

    // Where the character starting at `i` ends, so a character isn't cut.
    fn char_end(self, i: usize) -> usize {
        var end = i + 1
        while end < self.text.len() and self.text.byte_at(end) & 0xC0 == 0x80 {
            end += 1
        }
        return end
    }
}

fn is_digit(c: u8) -> bool {
    return c >= 48 and c <= 57
}

// `Identifier.isAllowedInIdentifier`: `[0-9a-z_:/.-]`.
fn allowed_in_identifier(c: u8) -> bool {
    return is_digit(c) or (c >= 97 and c <= 122) or c == 95 or c == 58 or c == 47 or c == 46 or c == 45
}

// `StringReader.isAllowedInUnquotedString`.
fn allowed_unquoted(c: u8) -> bool {
    return is_digit(c) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c == 45 or c == 46 or c == 43
}

// `Float.parseFloat` of digits, `.` and `-`: an optional `-`, then digits with at most one `.`,
// at least one of them a digit.
fn java_float(text: String) -> f32? {
    var i: usize = 0
    if i < text.len() and text.byte_at(i) == 45 {
        i += 1
    }
    var digits = 0
    var dots = 0
    while i < text.len() {
        let c = text.byte_at(i)
        if is_digit(c) {
            digits += 1
        } else if c == 46 {
            dots += 1
        } else {
            return none
        }
        i += 1
    }
    if digits == 0 or dots > 1 {
        return none
    }
    return f32.parse(text)
}

/// The text vanilla shows under a failure's message, as `Commands.performCommand` makes it: in
/// gray, with a click that puts the command back in the chat box, the last 10 characters read,
/// after `...` if there were more, then the rest of the input, then `<--[HERE]`, each part's
/// style apart, for a player; the console logs its text.
pub fn failure_context(f: Failure) -> Component? {
    if f.cursor < 0 {
        return none
    }
    let cursor = usize.wrap(f.cursor).min(f.input.len())
    var out = Component.empty().colored("gray")
    out.style.click_event = some(ClickEvent.SuggestCommand("/{f.input}"))
    var start = if cursor > 10 { cursor - 10 } else { 0 }
    while start > 0 and start < f.input.len() and f.input.byte_at(start) & 0xC0 == 0x80 {
        start -= 1
    }
    if cursor > 10 {
        out.extra.push(Component.literal("..."))
    }
    // `append("")` adds nothing.
    if cursor > start {
        out.extra.push(Component.literal(f.input[start..cursor]))
    }
    if cursor < f.input.len() {
        var rest = Component.literal(f.input[cursor..]).colored("red")
        rest.style.underlined = some(true)
        out.extra.push(rest)
    }
    var here = Component.translatable("command.context.here", []).colored("red")
    here.style.italic = some(true)
    out.extra.push(here)
    return some(out)
}
