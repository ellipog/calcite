/// Calcite's commands, read by `command.dispatcher` as vanilla's brigadier dispatcher reads them
/// against the tree `Commands` builds, with brigadier's errors where they're its, and the tree each
/// player is sent, of the commands their permission level lets them use: vanilla's whole tree,
/// from `command.tree`, then Calcite's own. Those that run so far are vanilla's `gamemode`,
/// `stop`, `help`, `list`, `me`, `msg`, `tell`, `w`, `teammsg`, `tm`, `trigger`, `random`'s
/// `value` and `roll`, `say`, `tellraw`, `title`, `weather`, `kill`, `teleport` and `tp`, `time`,
/// `give`, `setblock`, `fill`, `summon`, `scoreboard`, `data` and `execute`, but its `summon`,
/// `on` and some conditions, and Calcite's: `gmc`, `gms`, `gma` and `gmsp`, which are `gamemode`
/// in each mode, `calcite flyspeed` (D239), `calcite dimension` (CAL-69) and `pregen` (CAL-71,
/// D275). The rest of vanilla's read, and come with Phase 6 (P6.6, CAL-165).
module server.commands

import chat.component.{ClickEvent, Component}
import command.coordinates.{Coordinates}
import command.dispatcher.{BlockInput, BlockTest, Context, Holder, ItemInput, Kind, Message, NOWHERE, Node, Parse, Tree, Value, finish, parse as dispatch, signable}
import command.selector.{Ints, Selector}
import nbt.path.{NbtPath}
import nbt.snbt.{SyntaxError, from_units, units_of}
import nbt.tag.{Tag}
import protocol.play.{ClientboundCommands, CommandNode, NodeKind}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.pregen.{Pattern, Shape}
import world.modes.{GameType}
import world.spawn.{BORDER_HALF}

/// The permission level `gamemode` and Calcite's commands need, vanilla's `GAMEMASTERS`, which
/// also lets selectors such as `@a` be used.
pub const GAMEMASTERS: i32 = 2

/// The permission level `stop` needs, vanilla's `OWNERS`, which the console has.
pub const OWNERS: i32 = 4

/// The fastest `calcite flyspeed` sets: a thousand times vanilla's.
pub const MOST_FLY_SPEED: f32 = 1000.0f32

/// What `trigger` does to its score: adds one, adds a value, or sets it.
pub enum TriggerChange {
    Simple
    Add(i32)
    Set(i32)
}

/// Where `teleport` sends its targets (CAL-165).
pub enum Destination {
    /// To an entity, `teleportToEntity`.
    To(Selector)
    /// To a place, turned as the rotation says where there's one, else as they were, then
    /// toward what they're to face where there's that, `teleportToPos`.
    At(Coordinates, Coordinates?, Facing?)
}

/// What `teleport` turns its targets toward once they're there, `LookAt` (CAL-165).
pub enum Facing {
    /// A place, `facing <facingLocation>`.
    Place(Coordinates)
    /// An entity's feet, or its eyes where it's `true`, `facing entity <facingEntity>
    /// [<facingAnchor>]`.
    Entity(Selector, bool)
}

/// What `time` does with its clock (CAL-165).
pub enum TimeAction {
    /// `set <time>`: to so many ticks.
    Set(i32)
    /// `set <timemarker>`: on to the time marker's next tick.
    SetMarker(Identifier)
    /// `add <time>`: on, or back, so many ticks.
    Add(i32)
    Pause
    Resume
    /// `rate <rate>`.
    Rate(f32)
    /// `query time`: its ticks.
    QueryTime
    /// `query <timeline>`: its ticks into the timeline's period.
    QueryTimeline(Identifier)
    /// `query <timeline> repetition`: the timeline's periods it's run.
    QueryRepetitions(Identifier)
    /// `query gametime`: the level's game time.
    QueryGameTime
}

/// The weather `weather` sets (CAL-165).
pub enum WeatherKind {
    Clear
    Rain
    Thunder
}

/// What `title` does to its players (CAL-165): takes the title off, and puts its times back too;
/// shows a title, a subtitle or the action bar's text; or sets its times, in ticks.
pub enum TitleAction {
    Clear
    Reset
    Title(Component)
    Subtitle(Component)
    ActionBar(Component)
    Times(i32, i32, i32)
}

/// What `scoreboard` does (CAL-165). Objectives go by name, and number formats as their codec
/// writes them, none to clear one.
pub enum ScoreboardAction {
    /// `objectives list`.
    ListObjectives
    /// `objectives add <objective> <criteria> [<displayName>]`: its name, its criteria's, and
    /// its display name, none for its name.
    AddObjective(String, String, Component?)
    /// `objectives remove <objective>`.
    RemoveObjective(String)
    /// `objectives setdisplay <slot> [<objective>]`: the slot's ID, and what it's to show, none
    /// to clear it.
    SetDisplay(usize, String?)
    /// `objectives modify <objective> displayname <displayName>`.
    DisplayName(String, Component)
    /// `objectives modify <objective> rendertype hearts|integer`: whether as hearts.
    RenderType(String, bool)
    /// `objectives modify <objective> displayautoupdate <value>`.
    AutoUpdate(String, bool)
    /// `objectives modify <objective> numberformat [blank|fixed <contents>|styled <style>]`.
    ObjectiveFormat(String, NumberFormatGiven?)
    /// `players list [<target>]`.
    ListHolders(Holder?)
    /// `players get <target> <objective>`.
    Get(Holder, String)
    /// `players set|add|remove <targets> <objective> <score>`: which, by its word, the holders,
    /// the objective and the score.
    Change(String, Holder, String, i32)
    /// `players reset <targets> [<objective>]`: of the objective, or all.
    Reset(Holder, String?)
    /// `players enable <targets> <objective>`.
    Enable(Holder, String)
    /// `players display name <targets> <objective> [<name>]`: none to clear it.
    ScoreName(Holder, String, Component?)
    /// `players display numberformat <targets> <objective> [...]`.
    ScoreFormat(Holder, String, NumberFormatGiven?)
    /// `players operation <targets> <targetObjective> <operation> <source> <sourceObjective>`.
    Operation(Holder, String, String, Holder, String)
}

/// What `data` reads or changes, a `DataAccessor` (CAL-165): an entity, the block entity at a
/// block, or a command storage compound.
pub enum DataTarget {
    Entity(Selector)
    Block(Coordinates)
    Storage(Identifier)
}

/// What `data` does (CAL-165).
pub enum DataAction {
    /// `merge <target> <nbt>`.
    Merge(DataTarget, Tag)
    /// `get <target> [<path> [<scale>]]`: the whole compound, one tag, or one number scaled.
    Get(DataTarget, NbtPath?, f64?)
    /// `remove <target> <path>`.
    Remove(DataTarget, NbtPath)
    /// `modify <target> <targetPath> <how> <source>`.
    Modify(DataTarget, NbtPath, DataHow, DataSource)
}

/// How `data modify` changes what its path finds (CAL-165): inserts at an index, `prepend` at
/// 0 and `append` at -1, sets, or merges.
pub enum DataHow {
    Insert(i32)
    Set
    Merge
}

/// What `data modify` puts (CAL-165): what a path finds in another target, or the whole of it,
/// `from`; the same as text, `string`, cut from `start` to `end` where they're given; or a tag,
/// `value`.
pub enum DataSource {
    From(DataTarget, NbtPath?)
    Text(DataTarget, NbtPath?, i32?, i32?)
    Value(Tag)
}

/// A number format as a command gives it (CAL-165): `blank`, `fixed` with the text, which is
/// resolved as the command runs, or `styled` with the style, as its codec writes it.
pub enum NumberFormatGiven {
    Blank
    Fixed(Component)
    Styled(Tag)
}

/// One of `execute`'s steps, read (CAL-165): what it changes of each source, or the sources it
/// makes of each, in the order written.
pub enum ExecuteStep {
    /// `as`: a source for each entity, running as it.
    As(Selector)
    /// `at`: a source for each entity, where it is, as it looks, in its level.
    At(Selector)
    /// `positioned`: at the place given, its anchor the feet.
    Positioned(Coordinates)
    /// `positioned as`: a source for each entity, where it is.
    PositionedAs(Selector)
    /// `positioned over`: on the heightmap named, where the source is.
    Over(String)
    /// `rotated`: looking as given.
    Rotated(Coordinates)
    /// `rotated as`: a source for each entity, looking as it does.
    RotatedAs(Selector)
    /// `facing`: looking at the place given.
    Facing(Coordinates)
    /// `facing entity`: a source for each entity, looking at its feet, or its eyes.
    FacingEntity(Selector, bool)
    /// `align`: the axes given floored, `x` 1, `y` 2 and `z` 4.
    Align(u8)
    /// `anchored`: the anchor the eyes, or the feet.
    Anchored(bool)
    /// `in`: in the dimension named, the place scaled to it.
    In(Identifier)
    /// `if` and `unless`: the source where a condition holds, or doesn't.
    Test(bool, Condition)
    /// `store result` and `store success`: what each command run after it gives, or whether it
    /// ran, stored once it has (D566).
    Store(bool, StoreTarget)
    /// `return run`: what's run after it returns from the function it's in, as
    /// `ReturnFromCommandCustomModifier` makes it (D567).
    ReturnRun
}

/// What `function` is given (D567): nothing, a compound, or `with` a target's data, whole or what
/// a path finds in it.
pub enum FunctionArgs {
    None
    Given(Tag)
    With(DataTarget, NbtPath?)
}

/// What `item` puts items in or finds them in (D571): a block's container, at a place, or the
/// entities a selector picks, `BlockItemAccessor` and `EntityItemAccessor`.
pub enum ItemTarget {
    Block(Coordinates)
    Entity(Selector)
}

/// The slots `item` names (D571), as `Value.Slots` holds them: the name of the range or the ID
/// of the slot source, where it has one, and the slot source.
pub struct SlotsGiven {
    pub name: String?
    pub source: Tag
}

/// What `item replace`, `fill` and `override` put in the slots (D571): an item, so many of it,
/// or copies of what's in a source's slots, each changed by an item modifier where one's given.
pub enum ItemFrom {
    With(ItemInput, i32)
    From(ItemTarget, SlotsGiven, Tag?)
}

/// What `item` does (D571).
pub enum ItemAction {
    /// `replace`, `fill` or `override`, by its word: the target, its slots and what goes in.
    Set(String, ItemTarget, SlotsGiven, ItemFrom)
    /// `modify`: the target, its slots and the item modifier, as `Value.Loot` holds it.
    Modify(ItemTarget, SlotsGiven, Tag)
}

/// Where `datapack enable` puts a pack among those on (D573): where its default position puts
/// it, first, last, or before or after a pack that's on.
pub enum PackPlace {
    Default
    First
    Last
    Before(String)
    After(String)
}

/// What `datapack` does (D573).
pub enum DataPackAction {
    /// `enable <name>`, and where it goes.
    Enable(String, PackPlace)
    /// `disable <name>`.
    Disable(String)
    /// `list`, `list enabled` or `list available`: whether those on are listed, and whether
    /// those off.
    List(bool, bool)
    /// `create <id> <description>`.
    Create(String, Component)
}

/// What `schedule` does (D569).
pub enum ScheduleAction {
    /// `schedule function <function> <time> [append|replace]`: the function's ID, or a tag's
    /// where it's one, in so many ticks, and whether it replaces what its name has waiting, as
    /// it does but with `append`.
    Function(Identifier, bool, i32, bool)
    /// `schedule clear <function>`: what's waiting under the name.
    Clear(Identifier)
}

/// What `execute store` stores into (CAL-165, D566).
pub enum StoreTarget {
    /// `score`: each holder's score of the objective.
    Score(Holder, String)
    /// `bossbar`: a boss bar's value, or its most.
    Bossbar(Identifier, bool)
    /// `block`, `entity` and `storage`: the tag at the path, of the type named, the value scaled.
    Data(DataTarget, NbtPath, String, f64)
}

/// A condition `execute if` and `execute unless` test (CAL-165).
pub enum Condition {
    /// `block`: whether the block at the place matches.
    Block(Coordinates, BlockTest)
    /// `blocks`: whether every block of an area, or every one but air, matches the one at the
    /// same place from another corner, and how many.
    Blocks(Coordinates, Coordinates, Coordinates, bool)
    /// `entity`: how many entities a selector picks.
    Entity(Selector)
    /// `score`: whether a holder's score compares with another's, by `=`, `<`, `<=`, `>` or
    /// `>=`.
    Score(Holder, String, String, Holder, String)
    /// `score … matches`: whether a holder's score is in a range.
    Matches(Holder, String, Ints)
    /// `data`: how many tags a path finds in a target.
    Data(DataTarget, NbtPath)
    /// `dimension`: whether the source is in the dimension named.
    Dimension(Identifier)
    /// `loaded`: whether the chunk at the place is loaded with its entities.
    Loaded(Coordinates)
    /// `predicate`: whether a loot predicate holds where the source is, the entry an ID names or
    /// one given inline, as `Value.Loot` holds it (D570).
    Predicate(Tag)
}

/// What `execute` runs at its end (CAL-165): a command, or a condition, which says whether it
/// held.
pub enum ExecuteEnd {
    Run(Box<Parsed>)
    Test(bool, Condition)
}

/// A command, read.
pub enum Parsed {
    /// `stop`.
    Stop
    /// `gamemode <gamemode> [<target>]`, or one of Calcite's aliases: the mode, and the players,
    /// or `none` for the one running it.
    GameMode(GameType, Selector?)
    /// `calcite flyspeed [<speed>]`: the speed, as a multiple of vanilla's, or `none` to be told it.
    FlySpeed(f32?)
    /// `calcite dimension <dimension> [<target>]`: the dimension, which may not be one the world
    /// has, as a `dimension` argument reads any identifier, and the players to go there, or `none`
    /// for the one running it (CAL-69).
    Dimension(Identifier, Selector?)
    /// `pregen ...`: pregenerating chunks (CAL-71, D275).
    Pregen(PregenCommand)
    /// `help [<command>]`: the usage of every command the source may use, or of what the
    /// command written leads to.
    Help(String?)
    /// `list`, or `list uuids`, with each player's UUID.
    List(bool)
    /// `me <action>`.
    Me(Message)
    /// `msg <targets> <message>`, which `tell` and `w` redirect to.
    Msg(Selector, Message)
    /// `say <message>`, for the game masters (CAL-165).
    Say(Message)
    /// `tellraw <targets> <message>` (CAL-165).
    TellRaw(Selector, Component)
    /// `kill [<targets>]`: those named, or `none` for the one running it (CAL-165).
    Kill(Selector?)
    /// `give <targets> <item> [<count>]`: the players, the item and how many, 1 where none's
    /// given (CAL-165).
    Give(Selector, ItemInput, i32)
    /// `setblock <pos> <block> [destroy|keep|replace|strict]`: where, the block, and how, by its
    /// word, `replace` where none's given (CAL-165).
    SetBlock(Coordinates, BlockInput, String)
    /// `fill <from> <to> <block> [destroy|hollow|keep|outline|replace|strict]`: the corners, the
    /// block, and how, `replace` where none's given (CAL-165).
    Fill(Coordinates, Coordinates, BlockInput, String)
    /// `summon <entity> [<pos> [<nbt>]]`: the entity type, where, `none` for where the source
    /// is, and its NBT, `none` where none's given, which is finalized (CAL-165).
    Summon(Identifier, Coordinates?, Tag?)
    /// `teleport` and `tp`: those named, or `none` for the one running it, to an entity or a
    /// place (CAL-165).
    Teleport(Selector?, Destination)
    /// `time` of the clock named, `time of <clock>`, or of the source's level's, `none`
    /// (CAL-165).
    Time(Identifier?, TimeAction)
    /// `weather clear|rain|thunder [<duration>]`: clear weather, rain or thunder, for so many
    /// ticks or for as long as the level's random draws (CAL-165).
    Weather(WeatherKind, i32?)
    /// `title <targets> ...` (CAL-165).
    Title(Selector, TitleAction)
    /// `teammsg <message>`, which `tm` redirects to.
    TeamMsg(Message)
    /// `trigger <objective> [add|set <value>]`.
    Trigger(String, TriggerChange)
    /// `scoreboard ...` (CAL-165).
    Scoreboard(ScoreboardAction)
    /// `data ...` (CAL-165).
    Data(DataAction)
    /// `execute ...`: its steps, then what it runs (CAL-165).
    Execute(List<ExecuteStep>, ExecuteEnd)
    /// `random value <range>` or `random roll <range>`, which tells everyone: the range, and
    /// whether it's a roll.
    Random(Ints, bool)
    /// `function <name> ...`: the function's ID, or a tag's where it's one, and what it's given
    /// (D567).
    Function(Identifier, bool, FunctionArgs)
    /// `return <value>`, or `return fail`, `none` (D567).
    Return(i32?)
    /// `schedule ...` (D569).
    Schedule(ScheduleAction)
    /// `item ...` (D571).
    Item(ItemAction)
    /// `reload` (D572).
    Reload
    /// `datapack ...` (D573).
    DataPack(DataPackAction)
    /// `spawnpoint [<targets> [<pos> [<rotation>]]]`: the players, or `none` for the one running
    /// it, the place, `none` for where the source is, and the rotation, `none` for none (D576).
    SpawnPoint(Selector?, Coordinates?, Coordinates?)
    /// A command of vanilla's that reads but doesn't run in Calcite yet, by its nodes' names.
    Unrun(String)
}

/// What `pregen` is to do, as Chunky's commands do: start, pause, carry on with or cancel the
/// tasks, say how they go, or change what the source's next task pregenerates.
pub enum PregenCommand {
    /// `pregen start`: a task for the source's selection, in its dimension.
    Start
    /// `pregen pause`, `pregen continue`, `pregen cancel`: every task.
    Pause
    Continue
    Cancel
    /// `pregen progress`: how each task's going.
    Progress
    /// `pregen selection`: what the source's selection is.
    Selection
    /// `pregen dimension <dimension>`, or Chunky's `pregen world <dimension>`: the dimension it's
    /// in, which may not be one the world has.
    Dimension(Identifier)
    /// `pregen center [<x> <z>]`: its center, or `none` for where the source is.
    Center((f64, f64)?)
    /// `pregen spawn`: its center at the world's spawn.
    Spawn
    /// `pregen worldborder`: a square the world border's size around its center, 0, 0.
    WorldBorder
    /// `pregen radius <radius> [<radius_z>]`: its radius, and a rectangle's or an ellipse's along
    /// `z`, the same where it's not given.
    Radius(f64, f64?)
    /// `pregen shape <shape>`, `pregen pattern <pattern>`.
    Shape(Shape)
    Pattern(Pattern)
    /// `pregen quiet <seconds>`: how often the console's told how the tasks go.
    Quiet(i32)
    /// `pregen silent`: whether it's told at all, turned the other way.
    Silent
}

/// Why a command can't be read or run, brigadier's `CommandSyntaxException`: its message, and,
/// where it has them, the input and where in it, in UTF-16 units.
pub struct Failure {
    pub message: Component
    pub input: String
    /// Where in `input`, or -1 for a failure with no place, which vanilla shows alone.
    pub cursor: i32
}

impl Failure {
    /// A failure with no place in the input, as an exception made with `create()`.
    pub fn alone(message: own Component) -> Failure {
        return Failure { message: message, input: String(), cursor: -1 }
    }

    /// A reader's syntax error, as a failure.
    pub fn of(e: own SyntaxError) -> Failure {
        let cursor = if e.cursor == NOWHERE { -1 } else { i32.wrap(e.cursor) }
        return Failure { message: e.message, input: e.input, cursor: cursor }
    }
}

/// Every command: vanilla's, as a dedicated server registers them, then Calcite's own, under the
/// root after vanilla's.
pub fn full_tree() -> Tree {
    var t = Tree.vanilla()
    let calcite = t.add(0, Node.literal("calcite", false, GAMEMASTERS))
    let flyspeed = t.add(calcite, Node.literal("flyspeed", true, 0))
    _ = t.add(flyspeed, Node.argument("speed", "brigadier:float", float_range(0.0f32, MOST_FLY_SPEED), true))
    let dimension = t.add(calcite, Node.literal("dimension", false, 0))
    let to = t.add(dimension, Node.argument("dimension", "dimension", [], true))
    _ = t.add(to, players("target"))
    for name in ["gmc", "gms", "gma", "gmsp"] {
        let alias = t.add(0, Node.literal(name, true, GAMEMASTERS))
        _ = t.add(alias, players("target"))
    }
    pregen_tree(mut t)
    return t
}

// `pregen` and its children, which only the owners may use, as pregenerating can keep the
// server's workers busy for hours.
fn pregen_tree(t: mut Tree) {
    let pregen = t.add(0, Node.literal("pregen", false, OWNERS))
    for name in ["start", "pause", "continue", "cancel", "progress", "selection", "spawn", "worldborder", "silent"] {
        _ = t.add(pregen, Node.literal(name, true, 0))
    }
    // `world` is Chunky's name for it.
    for name in ["dimension", "world"] {
        let at = t.add(pregen, Node.literal(name, false, 0))
        _ = t.add(at, Node.argument("dimension", "dimension", [], true))
    }
    let center = t.add(pregen, Node.literal("center", true, 0))
    // A double with no bounds still has its flags, none set.
    let x = t.add(center, Node.argument("x", "brigadier:double", [0], false))
    _ = t.add(x, Node.argument("z", "brigadier:double", [0], true))
    let radius = t.add(pregen, Node.literal("radius", false, 0))
    let r = t.add(radius, Node.argument("radius", "brigadier:double", double_range(0.0, BORDER_HALF), true))
    _ = t.add(r, Node.argument("radius_z", "brigadier:double", double_range(0.0, BORDER_HALF), true))
    let shape = t.add(pregen, Node.literal("shape", false, 0))
    for s in Shape.all() {
        _ = t.add(shape, Node.literal(s.name(), true, 0))
    }
    let pattern = t.add(pregen, Node.literal("pattern", false, 0))
    for p in Pattern.all() {
        _ = t.add(pattern, Node.literal(p.name(), true, 0))
    }
    let quiet = t.add(pregen, Node.literal("quiet", false, 0))
    _ = t.add(quiet, Node.argument("seconds", "brigadier:integer", int_min(0), true))
}

// An argument named `name`, `EntityArgument.players()`: many, and only players, flags 2.
fn players(name: str) -> Node {
    return Node.argument(name, "entity", [2], true)
}

// A double argument from `min` to `max`, as `DoubleArgumentInfo` writes it: both bounds' flags,
// then each bound.
fn double_range(min: f64, max: f64) -> List<u8> {
    var out: List<u8> = [3]
    for v in [min, max] {
        let bits = v.to_bits()
        for k in 0u64..8 {
            out.push(u8.wrap(bits >> (56 - 8 * k)))
        }
    }
    return out
}

// An integer argument of at least `min`, as `IntegerArgumentInfo` writes it: the minimum's flag,
// then the minimum.
fn int_min(min: i32) -> List<u8> {
    let bits = u32.wrap(min)
    return [1, u8.wrap(bits >> 24), u8.wrap(bits >> 16), u8.wrap(bits >> 8), u8.wrap(bits)]
}

// A float argument from `min` to `max`, as `FloatArgumentInfo` writes it: both bounds' flags,
// then each bound.
fn float_range(min: f32, max: f32) -> List<u8> {
    var out: List<u8> = [3]
    for v in [min, max] {
        let bits = v.to_bits()
        out.push(u8.wrap(bits >> 24))
        out.push(u8.wrap(bits >> 16))
        out.push(u8.wrap(bits >> 8))
        out.push(u8.wrap(bits))
    }
    return out
}

/// The commands a player whose permission level is `level` may use, as `sendCommands` sends
/// them, of every command.
pub fn tree(level: i32) -> ClientboundCommands {
    return packet(full_tree(), level)
}

/// The commands of `t` a player whose permission level is `level` may use, as `sendCommands`
/// sends them: copied from the root as `fillUsableCommands` copies them, numbered as
/// `ClientboundCommandsPacket` numbers them, the root first, then a level of the tree at a time,
/// each node's children in the order they were added and then the node it redirects to. A node
/// a player without permissions couldn't use is marked restricted.
pub fn packet(t: Tree, level: i32) -> ClientboundCommands {
    var specs = List<Spec>()
    specs.push(Spec { kind: NodeKind.Root, executable: false, restricted: false, children: [] })
    var converted: List<i32> = [-1; t.nodes.len()]
    converted[0] = 0
    fill(t, 0, 0, level, mut specs, mut converted)
    // Numbered as `enumerateNodes` numbers them: from a queue, the root first, each node as it
    // comes out of it the first time, after which its children and the node it redirects to go
    // in.
    var order = List<usize>()
    var ids: List<i32> = [-1; specs.len()]
    var queue: List<usize> = [0]
    var at: usize = 0
    while at < queue.len() {
        let s = queue[at]
        at += 1
        if ids[s] != -1 {
            continue
        }
        ids[s] = i32.wrap(order.len())
        order.push(s)
        for c in specs[s].children {
            queue.push(c)
        }
        if let r = specs[s].redirect {
            queue.push(r)
        }
    }
    var nodes = List<CommandNode>()
    for s in order {
        var children = List<i32>()
        for c in specs[s].children {
            children.push(ids[c])
        }
        var redirect: i32? = none
        if let r = specs[s].redirect {
            redirect = some(ids[r])
        }
        nodes.push(CommandNode { kind: specs[s].kind.copy(), executable: specs[s].executable, restricted: specs[s].restricted, children: children, redirect: redirect })
    }
    return ClientboundCommands { nodes: nodes, root: 0 }
}

// `fillUsableCommands`: each child of `source` the player may use, copied under `target`, then
// its own children. A copy redirects to the copy of the node its original redirects to where
// that's been copied already, and otherwise to none, as `converted` hasn't it yet.
fn fill(t: Tree, source: usize, target: usize, level: i32, specs: mut List<Spec>, converted: mut List<i32>) {
    for child in t.nodes[source].children {
        let n = t.nodes[child].copy()
        if n.level > level {
            continue
        }
        var to: usize? = none
        if let r = n.redirect {
            if converted[r] >= 0 {
                to = some(usize.wrap(converted[r]))
            }
        }
        let kind = match n.kind {
            Kind.Root => NodeKind.Root,
            Kind.Literal => NodeKind.Literal(n.name.copy()),
            Kind.Argument(_) => NodeKind.Argument { name: n.name.copy(), parser: n.parser, properties: n.properties.copy(), suggestions: n.suggestions.copy() },
        }
        specs.push(Spec { kind: kind, executable: n.executable, restricted: n.level > 0, children: [], redirect: to })
        let made = specs.len() - 1
        converted[child] = i32.wrap(made)
        specs[target].children.push(made)
        if not n.children.is_empty() {
            fill(t, child, made, level, mut specs, mut converted)
        }
    }
}

// A node of the packet's tree, its children and the node it redirects to by their places among
// the specs.
struct Spec {
    kind: NodeKind
    executable: bool
    restricted: bool
    children: List<usize>
    redirect: usize? = none
}

/// The command `input`, without its `/`, read for a source whose permission level is `level`,
/// against every command, with the entity types a selector's `type` may name.
pub fn parse(input: String, level: i32, types: Registry) -> Parsed ! Failure {
    return try parse_in(full_tree(), input, level, types)
}

/// The command `input` read against `t` for a source whose permission level is `level`: the
/// commands it may not use aren't there for it. One that reads but doesn't run in Calcite yet is
/// `Unrun`.
pub fn parse_in(t: Tree, input: String, level: i32, types: Registry) -> Parsed ! Failure {
    let p = dispatch(t, input.copy(), level, types)
    let c = match finish(p) {
        ok(c) => c,
        err(e) => fail Failure.of(e),
    }
    let first = words_of(t, p.contexts[0])[0].copy()
    if first == "execute" or (first == "return" and p.contexts.len() > 1) {
        return execute_of(t, p)
    }
    return command_of(t, c)
}

// The names of the nodes a context read, from the node it started at where that isn't the root,
// as `execute` for a step after another.
fn words_of(t: Tree, c: Context) -> List<String> {
    var words = List<String>()
    if c.root != 0 {
        words.push(t.nodes[c.root].name.copy())
    }
    for n in c.nodes {
        words.push(t.nodes[n.node].name.copy())
    }
    return words
}

// `execute`, as its contexts read it (CAL-165): each context but the last a step, or a redirect
// such as `run` or `tell`'s that changes nothing; the last the command run, or a condition. One
// with a step or a command Calcite doesn't run yet is `Unrun`. `return run` is a step of its own,
// as its modifier is (D567).
fn execute_of(t: Tree, p: Parse) -> Parsed {
    var steps = List<ExecuteStep>()
    let n = p.contexts.len()
    for i in 0..n - 1 {
        let words = words_of(t, p.contexts[i])
        if words.len() == 2 and words[0] == "return" and words[1] == "run" {
            steps.push(ExecuteStep.ReturnRun)
            continue
        }
        if words[0] != "execute" or (words.len() == 2 and words[1] == "run") {
            continue
        }
        let step = step_of(p.contexts[i], words) else return Parsed.Unrun(t.path(p.contexts[i]))
        steps.push(step)
    }
    let words = words_of(t, p.contexts[n - 1])
    if words[0] == "execute" {
        if words[1] == "if" or words[1] == "unless" {
            if let cond = condition_of(p.contexts[n - 1], words) {
                return Parsed.Execute(steps, ExecuteEnd.Test(words[1] == "if", cond))
            }
        }
        return Parsed.Unrun(join(words))
    }
    let run = command_of(t, p.contexts[n - 1])
    if let Parsed.Unrun(path) = run {
        return Parsed.Unrun(path.copy())
    }
    return Parsed.Execute(steps, ExecuteEnd.Run(Box(run)))
}

// An `execute` step, by the names of the nodes its context read, from `execute`, or none for one
// Calcite doesn't run yet: `summon`, `on`, and the conditions it doesn't test. A `store` into a
// block entity's, an entity's or storage's data names its target `target`, as
// `DataCommands.TARGET_PROVIDERS` names each with the prefix it's given.
fn step_of(c: Context, words: List<String>) -> ExecuteStep? {
    var rest = List<String>()
    for i in 1..words.len() {
        rest.push(words[i].copy())
    }
    let path = join(rest)
    if path == "as targets" or path == "at targets" or path == "positioned as targets" or path == "rotated as targets" {
        let who = entities(c.argument("targets")) else return none
        return some(if path == "as targets" { ExecuteStep.As(who) } else if path == "at targets" { ExecuteStep.At(who) } else if path == "positioned as targets" { ExecuteStep.PositionedAs(who) } else { ExecuteStep.RotatedAs(who) })
    }
    if path == "positioned pos" {
        let at = place(c.argument("pos")) else return none
        return some(ExecuteStep.Positioned(at))
    }
    if path == "positioned over heightmap" {
        return some(ExecuteStep.Over(text(c.argument("heightmap"))))
    }
    if path == "rotated rot" {
        let turn = place(c.argument("rot")) else return none
        return some(ExecuteStep.Rotated(turn))
    }
    if path == "facing pos" {
        let at = place(c.argument("pos")) else return none
        return some(ExecuteStep.Facing(at))
    }
    if path == "facing entity targets anchor" {
        let who = entities(c.argument("targets")) else return none
        return some(ExecuteStep.FacingEntity(who, eyes_of(c.argument("anchor"))))
    }
    if path == "align axes" {
        return match c.argument("axes") {
            some(Value.Axes(a)) => some(ExecuteStep.Align(a)),
            _ => none,
        }
    }
    if path == "anchored anchor" {
        return some(ExecuteStep.Anchored(eyes_of(c.argument("anchor"))))
    }
    if path == "in dimension" {
        return some(ExecuteStep.In(id(c.argument("dimension"))))
    }
    if rest[0] == "if" or rest[0] == "unless" {
        let cond = condition_of(c, words) else return none
        return some(ExecuteStep.Test(rest[0] == "if", cond))
    }
    if rest[0] == "store" and rest.len() >= 5 {
        let result = rest[1] == "result"
        let kind = rest[2].copy()
        if kind == "score" {
            let h = holder_of(c.argument("targets")) else return none
            return some(ExecuteStep.Store(result, StoreTarget.Score(h, text(c.argument("objective")))))
        }
        if kind == "bossbar" {
            return some(ExecuteStep.Store(result, StoreTarget.Bossbar(id(c.argument("id")), rest[4] == "value")))
        }
        if rest.len() >= 7 {
            let target = data_target(kind.copy(), c.argument("target")) else return none
            let p = path_of(c.argument("path")) else return none
            return some(ExecuteStep.Store(result, StoreTarget.Data(target, p, rest[5].copy(), double_of(c.argument("scale")) ?? 1.0)))
        }
    }
    return none
}

// What `execute if` or `execute unless` tests, by the names of the nodes from `execute`, or none
// for a condition Calcite doesn't test yet: `biome`, `function`, `items` and `stopwatch`.
fn condition_of(c: Context, words: List<String>) -> Condition? {
    if words.len() < 4 {
        return none
    }
    let kind = words[2].copy()
    if kind == "block" {
        let at = place(c.argument("pos")) else return none
        return match c.argument("block") {
            some(Value.BlockTest(b)) => some(Condition.Block(at, b.copy())),
            _ => none,
        }
    }
    if kind == "blocks" and words.len() >= 7 {
        let start = place(c.argument("start")) else return none
        let end = place(c.argument("end")) else return none
        let to = place(c.argument("destination")) else return none
        return some(Condition.Blocks(start, end, to, words[6] == "masked"))
    }
    if kind == "entity" {
        let who = entities(c.argument("entities")) else return none
        return some(Condition.Entity(who))
    }
    if kind == "score" and words.len() >= 6 {
        let target = holder_of(c.argument("target")) else return none
        let objective = text(c.argument("targetObjective"))
        if words[5] == "matches" {
            return match c.argument("range") {
                some(Value.Range(r)) => some(Condition.Matches(target, objective, r)),
                _ => none,
            }
        }
        let source = holder_of(c.argument("source")) else return none
        return some(Condition.Score(target, objective, words[5].copy(), source, text(c.argument("sourceObjective"))))
    }
    if kind == "data" {
        let from = data_target(words[3].copy(), c.argument("source")) else return none
        let p = path_of(c.argument("path")) else return none
        return some(Condition.Data(from, p))
    }
    if kind == "dimension" {
        return some(Condition.Dimension(id(c.argument("dimension"))))
    }
    if kind == "loaded" {
        let at = place(c.argument("pos")) else return none
        return some(Condition.Loaded(at))
    }
    if kind == "predicate" {
        return match c.argument("predicate") {
            some(Value.Loot(t)) => some(Condition.Predicate(t.copy())),
            _ => none,
        }
    }
    return none
}

// An anchor argument: whether it's the eyes.
fn eyes_of(v: Value?) -> bool {
    return match v {
        some(Value.Eyes(e)) => e,
        _ => false,
    }
}

// A command read from the context whose command runs, the last (CAL-165).
fn command_of(t: Tree, c: Context) -> Parsed {
    let words = words_of(t, c)
    let path = join(words)
    let first = words[0].copy()
    if first == "gamemode" {
        return Parsed.GameMode(mode(c.argument("gamemode")), entities(c.argument("target")))
    }
    if first == "stop" {
        return Parsed.Stop
    }
    let aliases = [("gmc", GameType.Creative), ("gms", GameType.Survival), ("gma", GameType.Adventure), ("gmsp", GameType.Spectator)]
    for (name, m) in aliases {
        if first == String(name) {
            return Parsed.GameMode(m, entities(c.argument("target")))
        }
    }
    if first == "calcite" {
        if words[1] == "flyspeed" {
            return Parsed.FlySpeed(float_of(c.argument("speed")))
        }
        return Parsed.Dimension(id(c.argument("dimension")), entities(c.argument("target")))
    }
    if first == "pregen" {
        return Parsed.Pregen(pregen_of(words, c.argument("dimension"), c.argument("x"), c.argument("z"), c.argument("radius"), c.argument("radius_z"), c.argument("seconds")))
    }
    if path == "help" {
        return Parsed.Help(none)
    }
    if path == "help command" {
        return Parsed.Help(some(text(c.argument("command"))))
    }
    if path == "list" or path == "list uuids" {
        return Parsed.List(path == "list uuids")
    }
    if path == "me action" {
        return Parsed.Me(message_of(c.argument("action")))
    }
    if path == "msg targets message" {
        let who = entities(c.argument("targets")) else panic("msg has no targets")
        return Parsed.Msg(who, message_of(c.argument("message")))
    }
    if path == "say message" {
        return Parsed.Say(message_of(c.argument("message")))
    }
    if path.starts_with("weather ") {
        let kind = if path.starts_with("weather clear") { WeatherKind.Clear } else if path.starts_with("weather rain") { WeatherKind.Rain } else { WeatherKind.Thunder }
        return Parsed.Weather(kind, int_of(c.argument("duration")))
    }
    if path == "kill" or path == "kill targets" {
        return Parsed.Kill(entities(c.argument("targets")))
    }
    if path.starts_with("setblock pos block") {
        let at = place(c.argument("pos")) else panic("setblock has no place")
        let block = match c.argument("block") {
            some(Value.Block(b)) => b,
            _ => panic("setblock has no block"),
        }
        let how = if words.len() > 3 { words[3].copy() } else { String("replace") }
        return Parsed.SetBlock(at, block, how)
    }
    if path.starts_with("fill from to block") {
        let from = place(c.argument("from")) else panic("fill has no corner")
        let to = place(c.argument("to")) else panic("fill has no corner")
        let block = match c.argument("block") {
            some(Value.Block(b)) => b,
            _ => panic("fill has no block"),
        }
        let how = if words.len() > 4 { words[4].copy() } else { String("replace") }
        return Parsed.Fill(from, to, block, how)
    }
    if path.starts_with("summon entity") {
        let nbt = match c.argument("nbt") {
            some(Value.Nbt(tag)) => some(tag),
            _ => none,
        }
        return Parsed.Summon(id(c.argument("entity")), place(c.argument("pos")), nbt)
    }
    if path.starts_with("give targets item") {
        let who = entities(c.argument("targets")) else panic("give has no targets")
        let item = match c.argument("item") {
            some(Value.Stack(s)) => s,
            _ => panic("give has no item"),
        }
        return Parsed.Give(who, item, int_of(c.argument("count")) ?? 1)
    }
    if first == "time" {
        // Its nodes past `time`, and past `of <clock>` where there's that.
        var rest = List<String>()
        let of = words.len() > 2 and words[1] == "of"
        for i in 1..words.len() {
            if of and i <= 2 {
                continue
            }
            rest.push(words[i].copy())
        }
        let sub = join(rest)
        let clock = match c.argument("clock") {
            some(Value.Id(i)) => some(i.copy()),
            _ => none,
        }
        let action = if sub == "set time" {
            TimeAction.Set(int_of(c.argument("time")) ?? 0)
        } else if sub == "set timemarker" {
            TimeAction.SetMarker(id(c.argument("timemarker")))
        } else if sub == "add time" {
            TimeAction.Add(int_of(c.argument("time")) ?? 0)
        } else if sub == "pause" {
            TimeAction.Pause
        } else if sub == "resume" {
            TimeAction.Resume
        } else if sub == "rate rate" {
            TimeAction.Rate(float_of(c.argument("rate")) ?? 1.0f32)
        } else if sub == "query time" {
            TimeAction.QueryTime
        } else if sub == "query timeline" {
            TimeAction.QueryTimeline(id(c.argument("timeline")))
        } else if sub == "query timeline repetition" {
            TimeAction.QueryRepetitions(id(c.argument("timeline")))
        } else if sub == "query gametime" {
            TimeAction.QueryGameTime
        } else {
            return Parsed.Unrun(path)
        }
        return Parsed.Time(clock, action)
    }
    if path == "teleport destination" or path == "teleport targets destination" {
        let to = entities(c.argument("destination")) else panic("teleport has no destination")
        return Parsed.Teleport(entities(c.argument("targets")), Destination.To(to))
    }
    if path == "teleport location" or path == "teleport targets location" or path == "teleport targets location rotation" {
        let at = place(c.argument("location")) else panic("teleport has no location")
        return Parsed.Teleport(entities(c.argument("targets")), Destination.At(at, place(c.argument("rotation")), none))
    }
    if path == "teleport targets location facing facingLocation" {
        let at = place(c.argument("location")) else panic("teleport has no location")
        let toward = place(c.argument("facingLocation")) else panic("teleport faces no place")
        return Parsed.Teleport(entities(c.argument("targets")), Destination.At(at, none, some(Facing.Place(toward))))
    }
    if path.starts_with("teleport targets location facing entity facingEntity") {
        let at = place(c.argument("location")) else panic("teleport has no location")
        let toward = entities(c.argument("facingEntity")) else panic("teleport faces no entity")
        let eyes = match c.argument("facingAnchor") {
            some(Value.Eyes(e)) => e,
            _ => false,
        }
        return Parsed.Teleport(entities(c.argument("targets")), Destination.At(at, none, some(Facing.Entity(toward, eyes))))
    }
    if path == "tellraw targets message" {
        let who = entities(c.argument("targets")) else panic("tellraw has no targets")
        return Parsed.TellRaw(who, component_arg(c.argument("message")))
    }
    if path.starts_with("title targets ") {
        let who = entities(c.argument("targets")) else panic("title has no targets")
        let action = if path == "title targets clear" {
            TitleAction.Clear
        } else if path == "title targets reset" {
            TitleAction.Reset
        } else if path == "title targets title title" {
            TitleAction.Title(component_arg(c.argument("title")))
        } else if path == "title targets subtitle title" {
            TitleAction.Subtitle(component_arg(c.argument("title")))
        } else if path == "title targets actionbar title" {
            TitleAction.ActionBar(component_arg(c.argument("title")))
        } else {
            TitleAction.Times(int_of(c.argument("fadeIn")) ?? 0, int_of(c.argument("stay")) ?? 0, int_of(c.argument("fadeOut")) ?? 0)
        }
        return Parsed.Title(who, action)
    }
    if path == "teammsg message" {
        return Parsed.TeamMsg(message_of(c.argument("message")))
    }
    if first == "trigger" {
        let objective = text(c.argument("objective"))
        var change = TriggerChange.Simple
        if let v = int_of(c.argument("value")) {
            change = if words[2] == "add" { TriggerChange.Add(v) } else { TriggerChange.Set(v) }
        }
        return Parsed.Trigger(objective, change)
    }
    if first == "scoreboard" {
        if let action = scoreboard_of(c, words, path.copy()) {
            return Parsed.Scoreboard(action)
        }
    }
    if first == "data" {
        if let action = data_of(c, words) {
            return Parsed.Data(action)
        }
    }
    if path == "random value range" or path == "random roll range" {
        match c.argument("range") {
            some(Value.Range(r)) => return Parsed.Random(r, words[1] == "roll"),
            _ => {},
        }
    }
    if first == "function" {
        // `function <name> [<arguments> | with <source> [<path>]]`, each data source's
        // argument named `source`, as `DataCommands.SOURCE_PROVIDERS` names them (D567).
        var named: Identifier? = none
        var tag = false
        match c.argument("name") {
            some(Value.Function(n, is_tag)) => {
                named = some(n.copy())
                tag = is_tag
            },
            _ => {},
        }
        let name = named else return Parsed.Unrun(path)
        if path == "function name" {
            return Parsed.Function(name.copy(), tag, FunctionArgs.None)
        }
        if path == "function name arguments" {
            let given = nbt_of(c.argument("arguments")) else return Parsed.Unrun(path)
            return Parsed.Function(name.copy(), tag, FunctionArgs.Given(given))
        }
        if words.len() >= 5 and words[2] == "with" {
            let target = data_target(words[3].copy(), c.argument("source")) else return Parsed.Unrun(path)
            return Parsed.Function(name.copy(), tag, FunctionArgs.With(target, path_of(c.argument("path"))))
        }
    }
    if path == "return value" {
        let value = int_of(c.argument("value")) else return Parsed.Unrun(path)
        return Parsed.Return(some(value))
    }
    if path == "return fail" {
        return Parsed.Return(none)
    }
    if path.starts_with("schedule function function time") {
        match (c.argument("function"), int_of(c.argument("time"))) {
            (some(Value.Function(n, is_tag)), some(ticks)) => {
                return Parsed.Schedule(ScheduleAction.Function(n.copy(), is_tag, ticks, not path.ends_with("append")))
            },
            _ => {},
        }
    }
    if path == "schedule clear function" {
        return Parsed.Schedule(ScheduleAction.Clear(id(c.argument("function"))))
    }
    if first == "item" and words.len() >= 6 {
        if let made = item_of(c, words) {
            return Parsed.Item(made)
        }
    }
    if path == "reload" {
        return Parsed.Reload
    }
    if first == "spawnpoint" {
        return Parsed.SpawnPoint(entities(c.argument("targets")), place(c.argument("pos")), place(c.argument("rotation")))
    }
    if first == "datapack" {
        if let made = datapack_of(c, path) {
            return Parsed.DataPack(made)
        }
    }
    return Parsed.Unrun(path)
}

// `datapack` as its nodes, `path`, and its arguments read (D573).
fn datapack_of(c: Context, path: String) -> DataPackAction? {
    if path == "datapack list" {
        return some(DataPackAction.List(true, true))
    }
    if path == "datapack list enabled" {
        return some(DataPackAction.List(true, false))
    }
    if path == "datapack list available" {
        return some(DataPackAction.List(false, true))
    }
    if path == "datapack disable name" {
        return some(DataPackAction.Disable(text(c.argument("name"))))
    }
    if path == "datapack create id description" {
        return some(DataPackAction.Create(text(c.argument("id")), component_arg(c.argument("description"))))
    }
    if not path.starts_with("datapack enable name") {
        return none
    }
    let name = text(c.argument("name"))
    let at = if path == "datapack enable name first" {
        PackPlace.First
    } else if path == "datapack enable name last" {
        PackPlace.Last
    } else if path == "datapack enable name before existing" {
        PackPlace.Before(text(c.argument("existing")))
    } else if path == "datapack enable name after existing" {
        PackPlace.After(text(c.argument("existing")))
    } else {
        PackPlace.Default
    }
    return some(DataPackAction.Enable(name, at))
}

// What `item` does, by the names of the nodes from `item` (D571): its target, `block` or
// `entity` and then `target`, its slots, and `modify`'s modifier, or what goes in, `with` an
// item and its count, 1 where none's given, or `from` a source's slots, with a modifier where
// one's given.
fn item_of(c: Context, words: List<String>) -> ItemAction? {
    let target = item_target(words[2].copy(), c.argument("target")) else return none
    let slots = slots_of(c.argument("slots")) else return none
    if words[1] == "modify" {
        return match c.argument("modifier") {
            some(Value.Loot(m)) => some(ItemAction.Modify(target, slots, m.copy())),
            _ => none,
        }
    }
    if words[5] == "with" {
        return match c.argument("item") {
            some(Value.Stack(s)) => some(ItemAction.Set(words[1].copy(), target, slots, ItemFrom.With(s.copy(), int_of(c.argument("count")) ?? 1))),
            _ => none,
        }
    }
    if words.len() < 9 {
        return none
    }
    let source = item_target(words[6].copy(), c.argument("source")) else return none
    let from = slots_of(c.argument("sourceSlots")) else return none
    let md = match c.argument("modifier") {
        some(Value.Loot(m)) => some(m.copy()),
        _ => none,
    }
    return some(ItemAction.Set(words[1].copy(), target, slots, ItemFrom.From(source, from, md)))
}

// `item`'s target or source, of the kind named, `block` or `entity`, its argument read.
fn item_target(kind: String, v: Value?) -> ItemTarget? {
    if kind == "block" {
        let at = place(v) else return none
        return some(ItemTarget.Block(at))
    }
    let who = entities(v) else return none
    return some(ItemTarget.Entity(who))
}

// A slot source argument, as `item` is given it.
fn slots_of(v: Value?) -> SlotsGiven? {
    return match v {
        some(Value.Slots(name, source)) => some(SlotsGiven { name: name.copy(), source: source.copy() }),
        _ => none,
    }
}

/// The names of the message arguments `input` has, read as `parse_in` reads it, each with what
/// was written for it, which a client signs, `SignableCommand.of`.
pub fn signable_in(t: Tree, input: String, level: i32, types: Registry) -> List<(String, String)> {
    return signable(t, dispatch(t, input, level, types))
}

// Words joined by spaces.
fn join(words: List<String>) -> String {
    var out = String()
    for w in words {
        if not out.is_empty() {
            out.push_str(" ")
        }
        out.push_str(w)
    }
    return out
}

// What `pregen`'s nodes read.
fn pregen_of(words: List<String>, dimension: Value?, x: Value?, z: Value?, radius: Value?, radius_z: Value?, seconds: Value?) -> PregenCommand {
    let sub = words[1].copy()
    let plain = [("start", PregenCommand.Start), ("pause", PregenCommand.Pause), ("continue", PregenCommand.Continue), ("cancel", PregenCommand.Cancel), ("progress", PregenCommand.Progress), ("selection", PregenCommand.Selection), ("spawn", PregenCommand.Spawn), ("worldborder", PregenCommand.WorldBorder), ("silent", PregenCommand.Silent)]
    for (name, c) in plain {
        if sub == String(name) {
            return c.copy()
        }
    }
    if sub == "dimension" or sub == "world" {
        return PregenCommand.Dimension(id(dimension))
    }
    if sub == "center" {
        if let cx = double_of(x) {
            if let cz = double_of(z) {
                return PregenCommand.Center(some((cx, cz)))
            }
        }
        return PregenCommand.Center(none)
    }
    if sub == "radius" {
        if let r = double_of(radius) {
            return PregenCommand.Radius(r, double_of(radius_z))
        }
    }
    if sub == "shape" {
        for s in Shape.all() {
            if words[2] == String(s.name()) {
                return PregenCommand.Shape(s)
            }
        }
    }
    if sub == "pattern" {
        for p in Pattern.all() {
            if words[2] == String(p.name()) {
                return PregenCommand.Pattern(p)
            }
        }
    }
    if let s = int_of(seconds) {
        return PregenCommand.Quiet(s)
    }
    panic("pregen {sub} isn't one of its commands")
}

// What `data`'s nodes read, by the names of the nodes `words` (CAL-165), or none for a path that
// isn't one of its commands, as `modify … compute`'s aren't yet. Each target or source is a
// literal, `entity`, `block` or `storage`, then the argument after it, `target` or `source`.
fn data_of(c: Context, words: List<String>) -> DataAction? {
    if words.len() < 4 {
        return none
    }
    let target = data_target(words[2].copy(), c.argument("target")) else return none
    let sub = words[1].copy()
    if sub == "merge" {
        let nbt = nbt_of(c.argument("nbt")) else return none
        return some(DataAction.Merge(target, nbt))
    }
    if sub == "get" {
        return some(DataAction.Get(target, path_of(c.argument("path")), double_of(c.argument("scale"))))
    }
    if sub == "remove" {
        let p = path_of(c.argument("path")) else return none
        return some(DataAction.Remove(target, p))
    }
    if sub != "modify" or words.len() < 7 {
        return none
    }
    let to = path_of(c.argument("targetPath")) else return none
    let word = words[5].copy()
    var at: usize = 6
    let how = if word == "insert" {
        at = 7
        DataHow.Insert(int_of(c.argument("index")) ?? 0)
    } else if word == "prepend" {
        DataHow.Insert(0)
    } else if word == "append" {
        DataHow.Insert(-1)
    } else if word == "set" {
        DataHow.Set
    } else if word == "merge" {
        DataHow.Merge
    } else {
        return none
    }
    if at >= words.len() {
        return none
    }
    let kind = words[at].copy()
    if kind == "value" {
        let v = nbt_of(c.argument("value")) else return none
        return some(DataAction.Modify(target, to, how, DataSource.Value(v)))
    }
    if at + 1 >= words.len() {
        return none
    }
    let from = data_target(words[at + 1].copy(), c.argument("source")) else return none
    let from_path = path_of(c.argument("sourcePath"))
    if kind == "from" {
        return some(DataAction.Modify(target, to, how, DataSource.From(from, from_path)))
    }
    if kind == "string" {
        return some(DataAction.Modify(target, to, how, DataSource.Text(from, from_path, int_of(c.argument("start")), int_of(c.argument("end")))))
    }
    return none
}

// A `data` target or source, by the literal before it and its argument.
fn data_target(kind: String, v: Value?) -> DataTarget? {
    if kind == "entity" {
        let s = entities(v) else return none
        return some(DataTarget.Entity(s))
    }
    if kind == "block" {
        let p = place(v) else return none
        return some(DataTarget.Block(p))
    }
    if kind == "storage" {
        return match v {
            some(Value.Id(i)) => some(DataTarget.Storage(i.copy())),
            _ => none,
        }
    }
    return none
}

// An NBT path argument.
fn path_of(v: Value?) -> NbtPath? {
    return match v {
        some(Value.Path(p)) => some(p.copy()),
        _ => none,
    }
}

// A tag argument.
fn nbt_of(v: Value?) -> Tag? {
    return match v {
        some(Value.Nbt(t)) => some(t.copy()),
        _ => none,
    }
}

// What `scoreboard`'s nodes read, by the names of the nodes `words` and `path` (CAL-165), or none
// for a path that isn't one of its commands.
fn scoreboard_of(c: Context, words: List<String>, path: String) -> ScoreboardAction? {
    if path == "scoreboard objectives list" {
        return some(ScoreboardAction.ListObjectives)
    }
    if path.starts_with("scoreboard objectives add objective criteria") {
        let shown = match c.argument("displayName") {
            some(Value.Shown(s)) => some(s.copy()),
            _ => none,
        }
        return some(ScoreboardAction.AddObjective(text(c.argument("objective")), text(c.argument("criteria")), shown))
    }
    if path == "scoreboard objectives remove objective" {
        return some(ScoreboardAction.RemoveObjective(text(c.argument("objective"))))
    }
    if path.starts_with("scoreboard objectives setdisplay slot") {
        let slot = int_of(c.argument("slot")) ?? 0
        let shown = match c.argument("objective") {
            some(Value.Text(t)) => some(t.copy()),
            _ => none,
        }
        return some(ScoreboardAction.SetDisplay(usize.wrap(slot), shown))
    }
    if path.starts_with("scoreboard objectives modify objective ") {
        let name = text(c.argument("objective"))
        let what = words[4].copy()
        if what == "displayname" {
            return some(ScoreboardAction.DisplayName(name, component_arg(c.argument("displayName"))))
        }
        if what == "rendertype" {
            return some(ScoreboardAction.RenderType(name, words[5] == "hearts"))
        }
        if what == "displayautoupdate" {
            let on = match c.argument("value") {
                some(Value.Bool(b)) => b,
                _ => false,
            }
            return some(ScoreboardAction.AutoUpdate(name, on))
        }
        return some(ScoreboardAction.ObjectiveFormat(name, format_given(c, words, 5)))
    }
    if path == "scoreboard players list" or path == "scoreboard players list target" {
        return some(ScoreboardAction.ListHolders(holder_of(c.argument("target"))))
    }
    if path == "scoreboard players get target objective" {
        let who = holder_of(c.argument("target")) ?? Holder.Named(String())
        return some(ScoreboardAction.Get(who, text(c.argument("objective"))))
    }
    let targets = holder_of(c.argument("targets")) ?? Holder.Named(String())
    let sub = if words.len() > 2 { words[2].copy() } else { String() }
    if (sub == "set" or sub == "add" or sub == "remove") and words.len() == 6 {
        return some(ScoreboardAction.Change(sub, targets, text(c.argument("objective")), int_of(c.argument("score")) ?? 0))
    }
    if sub == "reset" {
        let objective = match c.argument("objective") {
            some(Value.Text(t)) => some(t.copy()),
            _ => none,
        }
        return some(ScoreboardAction.Reset(targets, objective))
    }
    if sub == "enable" {
        return some(ScoreboardAction.Enable(targets, text(c.argument("objective"))))
    }
    if path.starts_with("scoreboard players display name targets objective") {
        let shown = match c.argument("name") {
            some(Value.Shown(s)) => some(s.copy()),
            _ => none,
        }
        return some(ScoreboardAction.ScoreName(targets, text(c.argument("objective")), shown))
    }
    if path.starts_with("scoreboard players display numberformat targets objective") {
        return some(ScoreboardAction.ScoreFormat(targets, text(c.argument("objective")), format_given(c, words, 6)))
    }
    if path == "scoreboard players operation targets targetObjective operation source sourceObjective" {
        let from = holder_of(c.argument("source")) ?? Holder.Named(String())
        return some(ScoreboardAction.Operation(targets, text(c.argument("targetObjective")), text(c.argument("operation")), from, text(c.argument("sourceObjective"))))
    }
    return none
}

// The number format a `numberformat` node's children give, the word at `at` saying which, or
// none where there are no more.
fn format_given(c: Context, words: List<String>, at: usize) -> NumberFormatGiven? {
    if words.len() <= at {
        return none
    }
    if words[at] == "blank" {
        return some(NumberFormatGiven.Blank)
    }
    if words[at] == "fixed" {
        return some(NumberFormatGiven.Fixed(component_arg(c.argument("contents"))))
    }
    return match c.argument("style") {
        some(Value.Nbt(t)) => some(NumberFormatGiven.Styled(t.copy())),
        _ => none,
    }
}

// A score holder argument, where it was given.
fn holder_of(v: Value?) -> Holder? {
    return match v {
        some(Value.Holder(h)) => some(h.copy()),
        _ => none,
    }
}

// An argument's identifier.
fn id(v: Value?) -> Identifier {
    return match v {
        some(Value.Id(i)) => i.copy(),
        _ => panic("the argument isn't an identifier"),
    }
}

// An argument's game mode.
fn mode(v: Value?) -> GameType {
    return match v {
        some(Value.Mode(m)) => m,
        _ => panic("the argument isn't a game mode"),
    }
}

// An argument's text.
fn text(v: Value?) -> String {
    return match v {
        some(Value.Text(t)) => t.copy(),
        _ => panic("the argument isn't text"),
    }
}

// An argument's message.
fn message_of(v: Value?) -> Message {
    return match v {
        some(Value.Message(m)) => m.copy(),
        _ => panic("the argument isn't a message"),
    }
}

// An argument's float, where it was given.
fn float_of(v: Value?) -> f32? {
    return match v {
        some(Value.Float(f)) => some(f),
        _ => none,
    }
}

// An argument's double, where it was given.
fn double_of(v: Value?) -> f64? {
    return match v {
        some(Value.Double(d)) => some(d),
        _ => none,
    }
}

// An argument's integer, where it was given.
fn int_of(v: Value?) -> i32? {
    return match v {
        some(Value.Int(i)) => some(i),
        _ => none,
    }
}

// A component argument's component.
fn component_arg(v: Value?) -> Component {
    return match v {
        some(Value.Shown(c)) => c.copy(),
        _ => panic("the argument isn't a component"),
    }
}

// A position or rotation argument's coordinates, where it was given.
fn place(v: Value?) -> Coordinates? {
    return match v {
        some(Value.Place(p)) => some(p),
        _ => none,
    }
}

// An entity argument's selector, where it was given.
fn entities(v: Value?) -> Selector? {
    return match v {
        some(Value.Entities(s)) => some(s.copy()),
        _ => none,
    }
}

/// `getSmartUsage`: how each child of the node `at` the source may use is used, for `help`,
/// in the order they were added.
pub fn usage(t: Tree, at: usize, level: i32) -> List<String> {
    var out = List<String>()
    let optional = t.nodes[at].executable
    for c in t.nodes[at].children {
        if let u = smart_usage(t, c, level, optional, false) {
            out.push(u)
        }
    }
    return out
}

// How the node `at` is used: its own usage, in brackets where it's optional, then, unless it's
// deep, where it redirects, or its one child's usage, or its children's if they're used alike,
// or their own usages, `(a|b)`, in brackets where the node runs a command.
fn smart_usage(t: Tree, at: usize, level: i32, optional: bool, deep: bool) -> String? {
    let n = t.nodes[at].copy()
    if n.level > level {
        return none
    }
    let own_text = usage_text(n)
    let shown = if optional { "[{own_text}]" } else { own_text }
    let child_optional = n.executable
    if deep {
        return some(shown)
    }
    if let r = n.redirect {
        let to = if r == 0 { String("...") } else { "-> {usage_text(t.nodes[r].copy())}" }
        return some("{shown} {to}")
    }
    var children = List<usize>()
    for c in n.children {
        if t.nodes[c].level <= level {
            children.push(c)
        }
    }
    if children.len() == 1 {
        if let u = smart_usage(t, children[0], level, child_optional, child_optional) {
            return some("{shown} {u}")
        }
    } else if children.len() > 1 {
        var uses = List<String>()
        for c in children {
            if let u = smart_usage(t, c, level, child_optional, true) {
                var seen = false
                for v in uses {
                    if v == u {
                        seen = true
                    }
                }
                if not seen {
                    uses.push(u)
                }
            }
        }
        if uses.len() == 1 {
            let u = uses[0].copy()
            return some(if child_optional { "{shown} [{u}]" } else { "{shown} {u}" })
        }
        if uses.len() > 1 {
            var all = String()
            for c in children {
                if not all.is_empty() {
                    all.push_str("|")
                }
                all.push_str(usage_text(t.nodes[c].copy()))
            }
            return some(if child_optional { "{shown} [{all}]" } else { "{shown} ({all})" })
        }
    }
    return some(shown)
}

// `getUsageText`: a literal's word, or an argument's name in angle brackets.
fn usage_text(n: Node) -> String {
    return match n.kind {
        Kind.Argument(_) => "<{n.name}>",
        _ => n.name.copy(),
    }
}

/// The node a parse of `input` for `help <command>` ends at, the last it read, or none where it
/// read nothing.
pub fn help_node(t: Tree, input: String, level: i32, types: Registry) -> usize? {
    let p = dispatch(t, input, level, types)
    var last: usize? = none
    // The first context's, as `getContext().getNodes()` gives them.
    for n in p.contexts[0].nodes {
        last = some(n.node)
    }
    return last
}

/// The text vanilla shows under a failure's message, as `Commands.finishParsing` makes it: in
/// gray, with a click that puts the command back in the chat box, the last 10 UTF-16 units read,
/// after `...` if there were more, then the rest of the input, then `<--[HERE]`, each part's
/// style apart, for a player; the console logs its text.
pub fn failure_context(f: Failure) -> Component? {
    if f.cursor < 0 {
        return none
    }
    let units = units_of(f.input)
    let cursor = usize.wrap(f.cursor).min(units.len())
    var out = Component.empty().colored("gray")
    out.style.click_event = some(ClickEvent.SuggestCommand("/{f.input}"))
    let start = if cursor > 10 { cursor - 10 } else { 0 }
    if cursor > 10 {
        out.extra.push(Component.literal("..."))
    }
    // `append("")` adds nothing.
    if cursor > start {
        out.extra.push(Component.literal(from_units(units, start, cursor)))
    }
    if cursor < units.len() {
        var rest = Component.literal(from_units(units, cursor, units.len())).colored("red")
        rest.style.underlined = some(true)
        out.extra.push(rest)
    }
    var here = Component.translatable("command.context.here", []).colored("red")
    here.style.italic = some(true)
    out.extra.push(here)
    return some(out)
}
