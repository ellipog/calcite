/// The world players join and what's the same for each of them: its dimensions, each with what
/// its saved chunks are read with and what its chunks are generated with, the flat world's
/// chunks, the settings from server.properties the login packet carries, the registry IDs play
/// needs, how chat is shown, and players' names as vanilla shows them.
module server.play

import pack.data.{Data}
import random.xoroshiro.{mix_stafford13}
import auth.profile.{GameProfile}
import chat.chat_type.{Decoration}
import chat.component.{Component, Style, ClickEvent, HoverEvent, EntityTooltip}
import java.text.{java_trim, string_hash}
import java.number.{parse_long}
import json.tree.{Json, Member}
import nbt.tag.{Accounter, Tag, read_any}
import registry.registries.{Registries}
import registry.registry.{Registry}
import resources.identifier.{Identifier}
import server.chunk_jobs.{ChunkContext}
import server.properties.{ServerProperties}
import storage.chunk.{ChunkFormat}
import storage.region.{Compression}
import world.border.{Border, BorderSettings}
import world.blocks.{first_states, default_offsets}
import world.chunk.{BlockStates}
import world.clocks.{Clocks, TimeMarker}
import world.environment.{Environment, sky_light_level}
import world.flat.{FlatBlocks, FlatWorld, MIN_Y, SECTIONS}
import world.modes.{Difficulty, GameType}
import world.natural.{MobSettings, Mobs, Natural, int_provider_of}
import world.precipitation.{Precipitation}
import world.random_sequences.{RandomSequences}
import world.random_ticks.{BlockRandom, RandomTicks}
import world.recipes.{Recipes}
import world.tickets.{TicketStorage}
import world.spawners.{SpawnRules, Spawners, TraderData}
import world.weather.{Weather, WeatherLevels}
import worldgen.biome_manager.{obfuscate_seed}
import worldgen.facts.{Facts}
import worldgen.generator.{GenSetup}
import worldgen.providers.{IntProvider}
import worldgen.temperature.{Temperatures}

/// What every player is told of the world as they join, from server.properties and the
/// registries.
pub struct PlaySettings {
    /// The server's view distance in chunks, from `view-distance`. A player's view is what
    /// their client asks for, from 2 to this. Vanilla keeps it from 2 to 32
    /// (`ChunkMap.setServerViewDistance`), and Calcite doesn't yet.
    pub view_distance: i32
    /// `force-view-distance` from calcite.properties: every player's view, whatever their client
    /// asks for, or 0 when it's off.
    pub force_view_distance: i32 = 0
    /// `chunk-send-cap` and `chunk-send-multiplier` from calcite.properties: the most chunks a
    /// tick a player is sent, 0 for no most, and what their client's rate is multiplied by (D242).
    pub chunk_send_cap: i32 = 0
    pub chunk_send_multiplier: f32 = 1.0
    /// `chunk-send-boost` from calcite.properties: what a client's rate under 64 a tick is
    /// multiplied by, up to 64 (D272).
    pub chunk_send_boost: f32 = 4.0
    /// `chunk-workers` from calcite.properties: the threads chunks are generated on, 0 for one
    /// fewer than the processors (D251).
    pub chunk_workers: i32 = 0
    /// `--stage-times FILE`: where each dimension's generator writes how long its workers have
    /// spent in each stage, the Overworld's to `FILE` and another's to `FILE.<its place>`.
    pub stage_times: String? = none
    pub simulation_distance: i32
    pub max_players: i32
    pub hardcore: bool
    /// The game mode new players get, from `gamemode`.
    pub game_type: GameType
    /// `force-gamemode`: whether every player joins in `game_type`, whatever mode they left in.
    pub force_game_mode: bool = false
    /// `broadcast-console-to-ops`: whether the ops are told what the console's commands did.
    pub broadcast_console_to_ops: bool = true
    /// `spawn-protection`: how far across or along from the spawn only ops may dig (D376).
    pub spawn_protection: i32 = 16
    pub difficulty: Difficulty
    /// The world's seed as `BiomeManager.obfuscateSeed` hides it.
    pub hashed_seed: i64
    pub online_mode: bool
    pub enforces_secure_chat: bool
    /// The seconds' worth of chat messages and of commands a player may send at once.
    pub chat_spam_threshold_seconds: i32
    pub command_spam_threshold_seconds: i32
    /// The world's clocks by their IDs in `world_clock`.
    pub clocks: List<i32>
}

impl PlaySettings {
    /// The view distance the login packet says, which the client keeps chunks out to: the forced
    /// one, if it's set, or `view-distance`.
    pub fn chunk_radius(self) -> i32 {
        return if self.force_view_distance > 0 { self.force_view_distance } else { self.view_distance }
    }

    /// The settings from server.properties, with the world's seed and the registry IDs. A
    /// hardcore world is hard, as vanilla makes it.
    pub fn from(props: ServerProperties, seed: i64, clocks: own List<i32>) -> PlaySettings {
        let difficulty = if props.hardcore { Difficulty.Hard } else { props.difficulty }
        return PlaySettings { force_game_mode: props.force_gamemode, broadcast_console_to_ops: props.broadcast_console_to_ops, spawn_protection: props.spawn_protection, view_distance: props.view_distance, simulation_distance: props.simulation_distance, max_players: props.max_players, hardcore: props.hardcore, game_type: props.gamemode, difficulty: difficulty, hashed_seed: obfuscate_seed(seed), online_mode: props.online_mode, enforces_secure_chat: props.enforce_secure_profile, chat_spam_threshold_seconds: props.chat_spam_threshold_seconds, command_spam_threshold_seconds: props.command_spam_threshold_seconds, clocks: clocks }
    }
}

/// The world's dimensions, in the order vanilla makes their levels: the Overworld, the Nether
/// and the End.
pub fn dimension_names() -> List<String> {
    return [String("minecraft:overworld"), String("minecraft:the_nether"), String("minecraft:the_end")]
}

/// One of the world's dimensions, as its `LevelStem` in `level.dat` and its dimension type have
/// it (CAL-69).
pub struct Dimension {
    /// Its ID, such as `minecraft:the_nether`, and its type's ID in `dimension_type`.
    pub id: Identifier
    pub type_id: i32
    /// What its saved chunks are read with: the registries' names and the block states, for its
    /// sections from its lowest, with sky light if its type has it. A world made without the
    /// registries, as a test's, reads none.
    pub context: ChunkContext? = none
    /// What its chunks that aren't saved are generated with, or `none` for a flat world's
    /// Overworld, whose are flat.
    pub gen: GenSetup? = none
    /// Its generator's sea level and whether it's flat, which the login and respawn packets say.
    pub sea_level: i32 = FLAT_SEA_LEVEL
    pub flat: bool = true
    /// Its type's lowest block and height, the height of what portals and the like reach, whether
    /// it has a ceiling, and the scale of its coordinates, which a portal to another divides by
    /// that one's.
    pub min_y: i32 = MIN_Y
    pub height: i32 = SECTIONS * 16
    pub logical_height: i32 = SECTIONS * 16
    pub ceiling: bool = false
    pub scale: f64 = 1.0
    /// Its ground: the flat world, for the Overworld, and air at its height for the others, whose
    /// chunk the level lights with and whose packet is what's sent for a chunk that isn't there.
    pub ground: FlatWorld
    /// Whether it can have weather, as `canHaveWeather` says of its type: sky light, no ceiling,
    /// and not the End (CAL-105).
    pub weathered: bool = false
    /// Its rain and thunder now and a tick ago, and its border. Its random, `Level.random`, is its
    /// level's (D323).
    pub weather: WeatherLevels = WeatherLevels()
    pub border: Border = Border()
    /// Its environment attributes, as its type and its timelines set them (D313), whether its
    /// type has fixed time, and how far its sky's light is under 15, `skyDarken`.
    pub environment: Environment
    pub fixed_time: bool = false
    pub sky_darken: i32 = 0
    /// Whether its type has sky light, and its type's default clock, by its ID in `world_clock`,
    /// which its day goes by (D314).
    pub sky_light: bool = true
    pub default_clock: i32? = none
    /// Its type's attribute map, as its entry has it, and what its monsters' light is held to,
    /// its type's `monster_spawn_light_level` and `monster_spawn_block_light_limit`, which
    /// natural spawning reads (D317).
    pub type_attributes: Tag? = none
    pub light_test: IntProvider? = none
    pub block_light_limit: i32 = 0
    /// Its type's `ambient_light`, which a mob's walk target reads where it spawns (CAL-156).
    pub ambient_light: f32 = 0.0f32
    /// The name of the block tag of what fire burns on forever there, its type's `infiniburn`,
    /// which fire's tick reads (D339).
    pub infiniburn: String = String()
    /// What picks where its random ticks and precipitation land, `randValue`, set to the low 32
    /// bits of its random's seed as its random's seeded, as the rig's agent sets vanilla's, which
    /// starts it from a random of its thread's own (D318).
    pub block_random: BlockRandom = BlockRandom()
}

impl Dimension {
    /// `Level.updateSkyBrightness`, as the level's tick and its making run it: the sky's light,
    /// its environment's sky light level, taken from 15 and cast to an `int` (D313).
    pub fn update_sky_brightness(mut self, clocks: Clocks) {
        let light = self.environment.number(sky_light_level(), clocks, self.weather.rain_level(), self.weather.thunder_level())
        self.sky_darken = i32.saturate(f64(15.0f32 - light))
    }

    /// `Level.isBrightOutside`: the sky's light no more than 3 under 15, in a level whose type
    /// hasn't fixed time.
    pub fn bright_outside(self) -> bool {
        return not self.fixed_time and self.sky_darken < 4
    }

    /// `Level.isDarkOutside`: not bright outside, in a level whose type hasn't fixed time.
    pub fn dark_outside(self) -> bool {
        return not self.fixed_time and not self.bright_outside()
    }
}

/// What the world saved of its weather, clocks and borders, and what else the tick reads, as the
/// server starts (CAL-105).
pub struct WorldState {
    pub weather: Weather
    pub clocks: Clocks
    /// Each dimension's border, in the world's order.
    pub borders: List<BorderSettings>
    /// The game rules `advance_time` and `advance_weather`.
    pub advance_time: bool = true
    pub advance_weather: bool = true
    /// `pause-when-empty-seconds` and `max-world-size`.
    pub pause_when_empty: i32 = 60
    pub max_world_size: i32 = 29999984
    /// `max-chained-neighbor-updates` (D326).
    pub max_chained: i32 = 1000000
    /// The game rules `water_source_conversion` and `lava_source_conversion` (D328).
    pub water_source_conversion: bool = true
    pub lava_source_conversion: bool = false
    /// Each level's random's seed, in the world's order.
    pub seeds: List<i64>
    /// The game rules the custom spawners read, the wandering trader's saved data, and its
    /// random's seed (D314).
    pub spawn_rules: SpawnRules = SpawnRules()
    /// The game rule `random_tick_speed` (D318).
    pub random_tick_speed: i32 = 3
    /// The game rule `fire_spread_radius_around_player`: how far from a player fire spreads, -1
    /// for anywhere (D338).
    pub fire_spread_radius: i32 = 128
    /// The game rule `max_snow_accumulation_height`: how many layers of snow precipitation lays,
    /// 0 for none (D340).
    pub max_snow: i32 = 1
    /// The game rule `natural_health_regeneration` (CAL-141).
    pub natural_regeneration: bool = true
    pub trader: TraderData = TraderData()
    pub trader_seed: i64 = 0
    /// Each dimension's saved tickets, in the world's order, `none` where it has none (D319).
    pub tickets: List<TicketStorage?> = List<TicketStorage?>()
    /// The random sequences, and the game rule `block_drops` (CAL-153).
    pub sequences: RandomSequences = RandomSequences()
    pub block_drops: bool = true
}

/// A flat world's sea level, `FlatLevelSource.getSeaLevel`.
pub const FLAT_SEA_LEVEL: i32 = -63

/// The world: its dimensions, its settings, how chat is shown, and its age in ticks.
pub struct World {
    /// Its dimensions, in `dimension_names`' order: only the Overworld, flat, for a world made
    /// without the registries, as a test's.
    pub dims: List<Dimension>
    pub settings: PlaySettings
    /// Each chat type's decoration, by its ID in `chat_type`, and the ID of `minecraft:chat`,
    /// which players' messages are sent as.
    pub chat_types: List<Decoration>
    pub chat: i32
    /// The ticks since the world began, which is the game time.
    pub game_time: i64 = 0
    /// The server's weather and clocks, `weather.dat`'s and `world_clocks.dat`'s, and the game
    /// rules the tick reads, `advance_time` and `advance_weather` (CAL-105).
    pub weather: Weather = Weather()
    pub clocks: Clocks
    pub advance_time: bool = true
    pub advance_weather: bool = true
    /// The timelines' time markers, each on its clock, in the order `ServerClockManager.init`
    /// registers them (D314).
    pub markers: List<TimeMarker> = List<TimeMarker>()
    /// The game rules the custom spawners read, and the Overworld's custom spawners (D314).
    pub spawn_rules: SpawnRules = SpawnRules()
    pub spawners: Spawners
    /// The world's seed, which slime chunks hang on, and what natural spawning reads: what the
    /// registries gave it, until it's made into what it knows of blocks and entity types and
    /// each dimension's mobs, in `dims`' order (D317).
    pub seed: i64 = 0
    pub natural_source: NaturalSource? = none
    pub natural: Natural? = none
    pub mobs: List<Mobs> = List<Mobs>()
    /// Each biome's climate, made with what natural spawning reads, which the levels read where
    /// it rains (D339).
    pub climate: Shared<Temperatures>? = none
    /// The game rule `random_tick_speed`, and what random ticks read of the blocks, made with
    /// what natural spawning reads (D318).
    pub random_tick_speed: i32 = 3
    pub random_ticks: RandomTicks? = none
    /// The game rule `fire_spread_radius_around_player`, which lava's random ticks read (D338).
    pub fire_spread_radius: i32 = 128
    /// The game rule `max_snow_accumulation_height`, and what precipitation reads of the blocks,
    /// made with what natural spawning reads (D340).
    pub max_snow: i32 = 1
    pub precipitation: Precipitation? = none
    /// The game rule `natural_health_regeneration`, which players' food and peaceful's healing
    /// read (CAL-141).
    pub natural_regeneration: bool = true
    /// The registries the world was loaded with, which players' items are read against, or
    /// `none` for a world made without them, as a test's (D372).
    pub registries: Shared<Registries>? = none
    /// The recipes, and what players are sent of them as they join, which crafting grids are
    /// matched against, shared with each click's slots; none for a world made without the
    /// registries (CAL-146, CAL-147).
    pub recipes: Shared<Recipes>? = none
    /// The server's random sequences, which loot draws from, none while they're lent to the
    /// level that's running, and the game rule `block_drops` (CAL-153).
    pub sequences: RandomSequences? = none
    pub block_drops: bool = true
}

impl World {
    pub fn new(flat: own FlatWorld, settings: own PlaySettings, chat_types: own List<Decoration>, chat: i32) -> World {
        let overworld = Dimension { id: Identifier { namespace: "minecraft", path: "overworld" }, type_id: 0, ground: flat, weathered: true, environment: Environment.new(), default_clock: some(0) }
        // Vanilla's clocks, by the IDs the settings have, until the registries say otherwise.
        var names = List<Identifier>()
        for i in 0..settings.clocks.len() {
            let path = if i == 0 { String("overworld") } else if i == 1 { String("the_end") } else { "clock_{i}" }
            names.push(Identifier { namespace: String("minecraft"), path: path })
        }
        return World { dims: [overworld], settings: settings, chat_types: chat_types, chat: chat, clocks: Clocks.new(names), spawners: Spawners.new(0, TraderData()) }
    }

    /// The world, with what server.properties sets, its seed, the IDs from `registries`, which its
    /// generators read items against too, the chat types' decorations in their order, and its
    /// dimensions as `stems`, `level.dat`'s, have them.
    pub fn load(props: ServerProperties, seed: i64, registries: Shared<Registries>, chat_types: own List<Decoration>, stems: JavaHashMap<String, Tag>) -> World ! String {
        let blocks = try flat_blocks(registries.value)
        let table = try block_states(registries.value)
        let format = try ChunkFormat.new(registries.value)
        let settings = PlaySettings.from(props, seed, synced_ids(registries.value, "world_clock"))
        let chat = try synced_id(registries.value, "chat_type", "chat")
        if usize.wrap(chat) >= chat_types.len() {
            fail String("there's no decoration of the chat type minecraft:chat")
        }
        let compression = Compression.from_name(props.region_file_compression) ?? Compression.Deflate
        var world = World.new(FlatWorld.new(blocks, table.copy()), settings, chat_types, chat)
        if let r = registries.value.find(String("world_clock")) {
            world.clocks = Clocks.new(registries.value.synced[r].entries)
        }
        world.markers = try time_markers_of(registries.value)
        world.registries = some(registries.copy())
        world.seed = seed
        world.natural_source = try natural_source(registries.value, table)
        var flat = world.dims.pop()
        world.dims.clear()
        for name in dimension_names() {
            let id = try Identifier.parse(name.copy())
            let (type_path, generator) = stem_of(stems, name)
            let type_id = try synced_id(registries.value, "dimension_type", type_path)
            let t = try type_data(registries.value, type_id)
            let (min_y, height, sky_light) = (t.min_y, t.height, t.sky)
            let context = ChunkContext { format: format.copy(), table: table.copy(), min_section: min_y >> 4, sections: height >> 4, sky_light: sky_light, compression: compression }
            var ground = FlatWorld.empty(table.copy(), min_y, height >> 4, blocks.biome)
            if name == "minecraft:overworld" {
                if let f = flat.take() {
                    ground = f.ground
                }
            }
            let weathered = sky_light and not t.ceiling and name != "minecraft:the_end"
            let environment = try environment_of(registries.value, type_id, weathered)
            var dim = Dimension { id: id, type_id: type_id, context: some(context), ground: ground, min_y: min_y, height: height, logical_height: t.logical_height, ceiling: t.ceiling, scale: t.scale, weathered: weathered, environment: environment, fixed_time: t.fixed_time, sky_light: sky_light, default_clock: t.default_clock }
            try spawning_of_type(registries.value, type_id, mut dim)
            if let g = generator {
                let (noise, source) = g
                var gen = try gen_setup(registries.value, table.copy(), noise.copy(), seed)
                gen.source = some(source.copy())
                gen.min_y = min_y
                gen.height = height
                gen.sky_light = sky_light
                gen.registries = some(registries.copy())
                dim.gen = some(gen)
                dim.sea_level = sea_level_of(noise)
                dim.flat = false
            } else if name != "minecraft:overworld" {
                fail "Calcite makes {name} only with a noise generator"
            }
            world.dims.push(dim)
        }
        return world
    }

    /// Whether natural spawning has what it reads, which it's made into the first time it's
    /// asked for, from what the registries gave as the server started (D317): what it knows of
    /// the blocks and entity types, and each dimension's mobs by biome, each biome's
    /// `natural_mob_spawns` over its type's; what random ticks read of the blocks (D318); and what
    /// precipitation reads of them (D340). A world made without the registries, as a test's,
    /// hasn't.
    pub fn natural_ready(mut self) -> bool {
        if self.natural != none {
            return true
        }
        let source = self.natural_source.take() else return false
        let facts = match Facts.new(source.blocks, source.fluids, source.table.copy()) {
            ok(f) => f,
            err(_) => return false,
        }
        let ticks = match RandomTicks.new(facts) {
            ok(t) => t,
            err(_) => return false,
        }
        let precipitation = match Precipitation.new(facts) {
            ok(p) => p,
            err(_) => return false,
        }
        let natural = match Natural.new(facts) {
            ok(n) => n,
            err(_) => return false,
        }
        let name = natural_mob_spawns()
        self.mobs.clear()
        for d in 0..self.dims.len() {
            let type_entry = match self.dims[d].type_attributes {
                some(a) => tag_field(a, name.copy()),
                none => Tag.End,
            }
            let base = MobSettings.empty().applied(type_entry, source.entity_types)
            var by_biome = List<MobSettings>()
            for attributes in source.biomes {
                by_biome.push(base.applied(tag_field(attributes, name.copy()), source.entity_types))
            }
            self.mobs.push(Mobs { by_biome: by_biome, attributes: source.biomes.copy(), reduced_water: source.reduced_water.copy(), surface_slimes: source.surface_slimes.copy() })
        }
        self.climate = some(Shared(Temperatures.of(source.temperatures.copy(), source.frozen.copy(), source.precipitation.copy())))
        self.natural = some(natural)
        self.random_ticks = some(ticks)
        self.precipitation = some(precipitation)
        return true
    }

    /// The dimension `id` names, by its place in `dims`, if the world has it.
    pub fn dimension_of(self, id: Identifier) -> usize? {
        for i in 0..self.dims.len() {
            if self.dims[i].id.namespace == id.namespace and self.dims[i].id.path == id.path {
                return some(i)
            }
        }
        return none
    }

    /// Whether the default clock of the dimension at `d`'s type is at the time marker `name`, as
    /// `isAtTimeMarker` says: the marker registered last of that name on the clock, if any, at
    /// the clock's ticks (D314). A type with no default clock is at none.
    pub fn at_marker(self, d: usize, name: Identifier) -> bool {
        let clock = self.dims[d].default_clock else return false
        var i = self.markers.len()
        while i > 0 {
            i -= 1
            if self.markers[i].clock == clock and self.markers[i].name.namespace == name.namespace and self.markers[i].name.path == name.path {
                return self.markers[i].occurs_at(self.clocks.total_ticks(some(clock)))
            }
        }
        return false
    }

    /// How `minecraft:chat` is shown.
    pub fn chat_decoration(self) -> Decoration {
        return self.chat_types[usize.wrap(self.chat)].copy()
    }

    /// Has each dimension's generator read `data`, the world's packs' data, in place of vanilla's
    /// (CAL-92).
    pub fn set_data(mut self, data: Shared<Data>) {
        for i in 0..self.dims.len() {
            if let g = self.dims[i].gen.take() {
                var setup = g
                setup.data = some(data.copy())
                self.dims[i].gen = some(setup)
            }
        }
    }

    /// The flat world with server.properties' defaults, its blocks by vanilla's IDs, and the
    /// first entry of each registry it needs, for a server that hasn't loaded the registries,
    /// as a test's. Its seed is 0, so two are the same. With no tags, its heightmaps count the
    /// flat world's blocks, as vanilla's tags do, and there's one biome. It has vanilla's three
    /// dimensions: the Nether and the End are air at their heights, their types by their places
    /// in vanilla's `dimension_type`, which are `overworld`, `overworld_caves`, `the_end` and
    /// `the_nether`.
    pub fn defaults() -> World {
        let blocks = FlatBlocks { bedrock: 88, dirt: 10, grass_block: 9, biome: 0 }
        let untagged = BlockStates.new([], [], 1)
        let ground: List<i32> = [i32.wrap(untagged.block_of(blocks.bedrock)), i32.wrap(untagged.block_of(blocks.dirt)), i32.wrap(untagged.block_of(blocks.grass_block))]
        let table = BlockStates.new(ground.copy(), ground, 1)
        var world = World.new(FlatWorld.new(blocks, table.copy()), PlaySettings.from(ServerProperties.defaults(), 0, [0, 1]), [Decoration.chat()], 0)
        world.dims.push(Dimension { id: Identifier { namespace: "minecraft", path: "the_nether" }, type_id: 3, ground: FlatWorld.empty(table.copy(), 0, 16, blocks.biome), sea_level: 32, flat: false, min_y: 0, height: 256, logical_height: 128, ceiling: true, scale: 8.0, environment: Environment.new(), sky_light: false })
        world.dims.push(Dimension { id: Identifier { namespace: "minecraft", path: "the_end" }, type_id: 2, ground: FlatWorld.empty(table, 0, 16, blocks.biome), sea_level: 0, flat: false, min_y: 0, height: 256, logical_height: 256, environment: Environment.new(), fixed_time: true, default_clock: some(1) })
        return world
    }
}

// The dimension type's path a stem names, and its generator's noise settings and biome source,
// or `none` for a flat one: `level.dat`'s, or vanilla's `normal` preset's where it has none or
// one Calcite can't make, as a preset Calcite can't generate is `minecraft:normal`'s.
fn stem_of(stems: JavaHashMap<String, Tag>, name: String) -> (String, (String, Json)?) {
    let fallback_type = if name == "minecraft:the_nether" { "the_nether" } else if name == "minecraft:the_end" { "the_end" } else { "overworld" }
    let fallback_noise = if name == "minecraft:the_nether" { "minecraft:nether" } else if name == "minecraft:the_end" { "minecraft:end" } else { "minecraft:overworld" }
    let fallback_source = if name == "minecraft:the_end" { source_json("minecraft:the_end", none) } else if name == "minecraft:the_nether" { source_json("minecraft:multi_noise", some("minecraft:nether")) } else { source_json("minecraft:multi_noise", some("minecraft:overworld")) }
    let fallback = (String(fallback_type), some((String(fallback_noise), fallback_source.copy())))
    let Tag.Compound(fields) = field(stems, "{name}") else return fallback
    var type_path = String(fallback_type)
    if let Tag.Str(t) = field(fields, "type") {
        if t.starts_with("minecraft:") {
            type_path = t[10..]
        }
    }
    let Tag.Compound(generator) = field(fields, "generator") else return (type_path, some((String(fallback_noise), fallback_source)))
    let kind = match field(generator, "type") {
        Tag.Str(k) => k,
        _ => String(),
    }
    if kind == "minecraft:flat" and name == "minecraft:overworld" {
        return (type_path, none)
    }
    if kind != "minecraft:noise" {
        return (type_path, some((String(fallback_noise), fallback_source)))
    }
    let noise = match field(generator, "settings") {
        Tag.Str(s) => s,
        _ => String(fallback_noise),
    }
    if not known_noise(noise) {
        return (type_path, some((String(fallback_noise), fallback_source)))
    }
    let source = if generator.contains("biome_source") { generator["biome_source"].to_json() } else { fallback_source }
    return (type_path, some((noise, source)))
}

// The field `key` of a compound, or `Tag.End` where it has none.
fn field(fields: JavaHashMap<String, Tag>, key: String) -> Tag {
    if fields.contains(key) {
        return fields[key].copy()
    }
    return Tag.End
}

// Whether Calcite generates with the noise settings `noise`: vanilla's.
fn known_noise(noise: String) -> bool {
    for known in ["minecraft:overworld", "minecraft:large_biomes", "minecraft:amplified", "minecraft:caves", "minecraft:floating_islands", "minecraft:nether", "minecraft:end"] {
        if noise == String(known) {
            return true
        }
    }
    return false
}

// A biome source of `kind`, with `preset` if it's given.
fn source_json(kind: str, preset: str?) -> Json {
    var members: List<Member> = [Member { key: String("type"), value: Json.Str(String(kind)) }]
    if let p = preset {
        members.push(Member { key: String("preset"), value: Json.Str(String(p)) })
    }
    return Json.Object(members)
}

// A dimension type's bottom, height and whether it has sky light, from its entry as the
// registries hold it.
// What the server needs of a dimension type: its lowest block and height, whether it has sky
// light and a ceiling, the height portals reach, and its coordinates' scale.
struct TypeData {
    min_y: i32
    height: i32
    sky: bool
    ceiling: bool
    logical_height: i32
    scale: f64
    fixed_time: bool
    default_clock: i32?
}

fn type_data(registries: Registries, type_id: i32) -> TypeData ! String {
    let r = registries.find(String("dimension_type")) else fail String("there's no registry dimension_type")
    if usize.wrap(type_id) >= registries.synced[r].contents.len() {
        fail "dimension type {type_id} has no contents"
    }
    var at: usize = 0
    var accounter = Accounter.unlimited()
    let tag = match read_any(registries.synced[r].contents[usize.wrap(type_id)], mut at, mut accounter) {
        ok(t) => t,
        err(e) => fail "dimension type {type_id} doesn't read: {e.message}",
    }
    let Tag.Compound(fields) = tag else fail "dimension type {type_id} isn't a compound"
    let min_y = match field(fields, "min_y") {
        Tag.Int(v) => v,
        _ => fail "dimension type {type_id} has no min_y",
    }
    let height = match field(fields, "height") {
        Tag.Int(v) => v,
        _ => fail "dimension type {type_id} has no height",
    }
    let sky = match field(fields, "has_skylight") {
        Tag.Byte(v) => v != 0,
        _ => fail "dimension type {type_id} has no has_skylight",
    }
    let ceiling = match field(fields, "has_ceiling") {
        Tag.Byte(v) => v != 0,
        _ => false,
    }
    let logical_height = match field(fields, "logical_height") {
        Tag.Int(v) => v,
        _ => height,
    }
    let scale = match field(fields, "coordinate_scale") {
        Tag.Double(v) => v,
        Tag.Float(v) => f64(v),
        _ => 1.0,
    }
    let fixed_time = match field(fields, "has_fixed_time") {
        Tag.Byte(v) => v != 0,
        _ => false,
    }
    // The default clock, which the registries keep by name.
    var default_clock: i32? = none
    if let Tag.Str(name) = field(fields, "default_clock") {
        if let c = registries.find(String("world_clock")) {
            default_clock = entry_id(registries.synced[c], name)
        }
    }
    return TypeData { min_y: min_y, height: height, sky: sky, ceiling: ceiling, logical_height: logical_height, scale: scale, fixed_time: fixed_time, default_clock: default_clock }
}

/// What natural spawning reads of the world's registries, kept as the server starts and made
/// into what it reads the first time it runs, so the server starts as fast (D317): the blocks and
/// fluids with their tags, the block states, the entity types' IDs, and each biome's attribute
/// map, by its ID, and whether it's in `#reduced_water_ambient_spawns` and
/// `#allows_surface_slime_spawns`.
pub struct NaturalSource {
    pub blocks: Registry
    pub fluids: Registry
    pub table: BlockStates
    pub entity_types: List<Identifier>
    pub biomes: List<Tag>
    pub reduced_water: List<bool>
    pub surface_slimes: List<bool>
    /// Each biome's climate, by its ID: its temperature, whether its temperature modifier is
    /// `frozen`, and whether it has precipitation, which the level reads where it rains (D339).
    pub temperatures: List<f32>
    pub frozen: List<bool>
    pub precipitation: List<bool>
}

// The name of the attribute of what spawns at a place.
fn natural_mob_spawns() -> String {
    return String("minecraft:gameplay/natural_mob_spawns")
}

// What natural spawning reads of the registries, if they have the blocks, fluids, entity types
// and biomes, as the server's do.
fn natural_source(registries: Registries, table: BlockStates) -> NaturalSource? ! String {
    let b = registries.find_builtin(String("block")) else return none
    let f = registries.find_builtin(String("fluid")) else return none
    let e = registries.find_builtin(String("entity_type")) else return none
    let r = registries.find(String("worldgen/biome")) else return none
    var attributes = List<Tag>()
    var temperatures = List<f32>()
    var frozen = List<bool>()
    var precipitation = List<bool>()
    for i in 0..registries.synced[r].full.len() {
        let tag = try full_tag(registries.synced[r], i32.wrap(i))
        attributes.push(tag_field(tag, "attributes"))
        temperatures.push(float_of(tag_field(tag, "temperature")))
        frozen.push(match tag_field(tag, "temperature_modifier") {
            Tag.Str(s) => s == "frozen",
            _ => false,
        })
        precipitation.push(match tag_field(tag, "has_precipitation") {
            Tag.Byte(v) => v != 0,
            _ => false,
        })
    }
    let reduced = registries.synced[r].tag_ids(Identifier { namespace: "minecraft", path: "reduced_water_ambient_spawns" })
    let slimes = registries.synced[r].tag_ids(Identifier { namespace: "minecraft", path: "allows_surface_slime_spawns" })
    var reduced_water = List<bool>()
    var surface_slimes = List<bool>()
    for i in 0..attributes.len() {
        reduced_water.push(reduced.contains(i32.wrap(i)))
        surface_slimes.push(slimes.contains(i32.wrap(i)))
    }
    return some(NaturalSource { blocks: registries.builtin[b].copy(), fluids: registries.builtin[f].copy(), table: table.copy(), entity_types: registries.builtin[e].entries.copy(), biomes: attributes, reduced_water: reduced_water, surface_slimes: surface_slimes, temperatures: temperatures, frozen: frozen, precipitation: precipitation })
}

// A number of the registries' data as `Codec.FLOAT` reads it, `Number.floatValue`.
fn float_of(tag: Tag) -> f32 {
    return match tag {
        Tag.Float(v) => v,
        Tag.Double(v) => f32.nearest(v),
        _ => f32.nearest(tag.int_value() ?? 0),
    }
}

// What natural spawning reads of the dimension type `type_id`, from its entry in full: its
// attributes, and its monsters' light test and block light limit (D317), and its ambient light
// (CAL-156); and the tag of what fire burns on forever there, `infiniburn`, without its `#` (D339). Registries with no full contents
// of the type, as a test's, leave the defaults.
fn spawning_of_type(registries: Registries, type_id: i32, dim: mut Dimension) ! String {
    let r = registries.find(String("dimension_type")) else fail String("there's no registry dimension_type")
    if usize.wrap(type_id) >= registries.synced[r].full.len() {
        return
    }
    let tag = try full_tag(registries.synced[r], type_id)
    dim.type_attributes = some(tag_field(tag, "attributes"))
    dim.light_test = int_provider_of(tag_field(tag, "monster_spawn_light_level"))
    if let Tag.Int(v) = tag_field(tag, "monster_spawn_block_light_limit") {
        dim.block_light_limit = v
    }
    dim.ambient_light = float_of(tag_field(tag, "ambient_light"))
    if let Tag.Str(s) = tag_field(tag, "infiniburn") {
        dim.infiniburn = if s.starts_with("#") { s[1..] } else { s.copy() }
    }
}

/// The environment of a level of the dimension type `type_id`, as `addDefaultLayers` builds it
/// but for the biomes' layer (D313): the type's attributes, then its timelines, a tag's in the
/// tag's order or each it names, with their clocks from `world_clock`, then the weather's, if
/// `weathered`. Registries with no full contents of the type, as a test's, give the defaults.
pub fn environment_of(registries: Registries, type_id: i32, weathered: bool) -> Environment ! String {
    let r = registries.find(String("dimension_type")) else fail String("there's no registry dimension_type")
    if usize.wrap(type_id) >= registries.synced[r].full.len() {
        return Environment.new()
    }
    let tag = try full_tag(registries.synced[r], type_id)
    var clocks = List<Identifier>()
    if let c = registries.find(String("world_clock")) {
        clocks = registries.synced[c].entries.copy()
    }
    var timelines = List<Tag>()
    if let tr = registries.find(String("timeline")) {
        var ids = List<i32>()
        match tag_field(tag, "timelines") {
            Tag.Str(s) => {
                if s.starts_with("#") {
                    let name = match Identifier.parse(s[1..]) {
                        ok(n) => n,
                        err(e) => fail "dimension type {type_id} names the tag {s}: {e}",
                    }
                    ids = registries.synced[tr].tag_ids(name)
                } else if let id = entry_id(registries.synced[tr], s) {
                    ids.push(id)
                }
            },
            Tag.List(items) => {
                for item in items {
                    if let Tag.Str(s) = item {
                        if let id = entry_id(registries.synced[tr], s) {
                            ids.push(id)
                        }
                    }
                }
            },
            _ => {},
        }
        for id in ids {
            if usize.wrap(id) < registries.synced[tr].full.len() {
                timelines.push(try full_tag(registries.synced[tr], id))
            }
        }
    }
    return Environment.build(tag_field(tag, "attributes"), timelines, clocks, weathered)
}

// An entry's full contents, as the registry keeps them in NBT.
fn full_tag(registry: Registry, id: i32) -> Tag ! String {
    var at: usize = 0
    var accounter = Accounter.unlimited()
    return match read_any(registry.full[usize.wrap(id)], mut at, mut accounter) {
        ok(t) => t,
        err(e) => fail "{registry.name.to_string()} entry {id} doesn't read: {e.message}",
    }
}

// The ID of the entry `name` names in `registry`, if it's there.
fn entry_id(registry: Registry, name: String) -> i32? {
    return match Identifier.parse(name.copy()) {
        ok(id) => registry.id(id),
        err(_) => none,
    }
}

/// Every timeline's time markers, as `ServerClockManager.init` registers them on their clocks:
/// the timelines in the registry's order, and in each its markers, at the ticks they name, with
/// its period, each written as its tick or as a map with its tick (D314). Registries with no
/// full contents of the timelines, as a test's, give none.
pub fn time_markers_of(registries: Registries) -> List<TimeMarker> ! String {
    var out = List<TimeMarker>()
    let tr = registries.find(String("timeline")) else return out
    let c = registries.find(String("world_clock")) else return out
    for i in 0..registries.synced[tr].full.len() {
        let tag = try full_tag(registries.synced[tr], i32.wrap(i))
        let Tag.Str(clock_name) = tag_field(tag, "clock") else continue
        let clock = entry_id(registries.synced[c], clock_name) else continue
        let period: i32? = match tag_field(tag, "period_ticks") {
            Tag.Int(p) => some(p),
            _ => none,
        }
        let Tag.Compound(markers) = tag_field(tag, "time_markers") else continue
        for (key, value) in markers {
            let name = match Identifier.parse(key.copy()) {
                ok(n) => n,
                err(_) => continue,
            }
            let ticks = match value {
                Tag.Int(v) => v,
                Tag.Compound(m) => match field(m, "ticks") {
                    Tag.Int(v) => v,
                    _ => continue,
                },
                _ => continue,
            }
            out.push(TimeMarker { name: name, clock: clock, ticks: ticks, period: period })
        }
    }
    return out
}

// The field `key` of a compound tag, or `Tag.End`.
fn tag_field(tag: Tag, key: String) -> Tag {
    match tag {
        Tag.Compound(fields) => return field(fields, key),
        _ => return Tag.End,
    }
}

// The sea level of vanilla's noise settings `noise`, its `sea_level`, which the login and
// respawn packets say: Calcite reads vanilla's data only on the generator's thread, so as not to
// slow the start.
fn sea_level_of(noise: String) -> i32 {
    if noise == "minecraft:nether" or noise == "minecraft:caves" {
        return 32
    }
    if noise == "minecraft:end" {
        return 0
    }
    if noise == "minecraft:floating_islands" {
        return -64
    }
    return 63
}

/// The noise settings a new world's Overworld is generated with for `level-type`, as its world
/// preset has them: `none` for `minecraft:flat`, whose chunks are flat. A preset Calcite can't
/// generate, or doesn't know, is `minecraft:normal`'s, as vanilla takes a preset it doesn't know
/// to be.
pub fn noise_settings_of(level_type: String) -> String? {
    let id = if level_type.contains(":") { level_type.copy() } else { "minecraft:{level_type}" }
    if id == "minecraft:flat" {
        return none
    }
    if id == "minecraft:large_biomes" {
        return some(String("minecraft:large_biomes"))
    }
    if id == "minecraft:amplified" {
        return some(String("minecraft:amplified"))
    }
    return some(String("minecraft:overworld"))
}

/// What the Overworld is generated with: the noise settings `noise`, the block, fluid and biome
/// registries, the block states, the blocks in `#uncarvable`, and the seed.
pub fn gen_setup(registries: Registries, table: own BlockStates, noise: own String, seed: i64) -> GenSetup ! String {
    let block = try block_registry(registries)
    var fluid: usize? = none
    for i in 0..registries.builtin.len() {
        if registries.builtin[i].name.path == "fluid" {
            fluid = some(i)
        }
    }
    let f = fluid else fail "there's no fluid registry"
    let biomes = registries.find(String("worldgen/biome")) else {
        fail "there's no biome registry"
    }
    let uncarvable = tag_values(registries.builtin[block], "uncarvable")
    return GenSetup { settings: noise, blocks: registries.builtin[block].copy(), fluids: registries.builtin[f].copy(), biomes: registries.synced[biomes].copy(), table: table, uncarvable: uncarvable, seed: seed }
}

/// The block states and biome of the flat world, by their IDs in `registries`, or a problem
/// if one is missing, which can only be a broken build.
pub fn flat_blocks(registries: Registries) -> FlatBlocks ! String {
    let block = try block_registry(registries)
    let biomes = registries.find(String("worldgen/biome")) else {
        fail "there's no biome registry"
    }
    let plains = registries.synced[biomes].id(Identifier { namespace: "minecraft", path: "plains" }) else {
        fail "there's no plains biome"
    }
    let bedrock = try default_state(registries.builtin[block], "bedrock")
    let dirt = try default_state(registries.builtin[block], "dirt")
    let grass_block = try default_state(registries.builtin[block], "grass_block")
    return FlatBlocks { bedrock: bedrock, dirt: dirt, grass_block: grass_block, biome: u32.wrap(plains) }
}

/// What chunks need to know of the block states, with the blocks in the heightmaps' tags as
/// `registries` has them, or a problem if a registry is missing, which can only be a broken
/// build. A tag no pack defines has no blocks, as in vanilla.
pub fn block_states(registries: Registries) -> BlockStates ! String {
    let block = try block_registry(registries)
    let biomes = registries.find(String("worldgen/biome")) else {
        fail "there's no biome registry"
    }
    let motion = tag_values(registries.builtin[block], "blocks_motion_in_heightmap")
    let motion_no_leaves = tag_values(registries.builtin[block], "blocks_motion_in_heightmap_no_leaves")
    return BlockStates.new(motion, motion_no_leaves, u32.wrap(registries.synced[biomes].entries.len()))
}

// Where the block registry is among the built-in ones.
fn block_registry(registries: Registries) -> usize ! String {
    for i in 0..registries.builtin.len() {
        if registries.builtin[i].name.path == "block" {
            return i
        }
    }
    fail "there's no block registry"
}

// The IDs in the tag `minecraft:{name}`, or none if there's no such tag.
fn tag_values(registry: Registry, name: String) -> List<i32> {
    for tag in registry.tags {
        if tag.name.namespace == "minecraft" and tag.name.path == name {
            return tag.values.copy()
        }
    }
    return []
}

// The ID of the block's default state.
fn default_state(blocks: Registry, name: String) -> u32 ! String {
    let id = blocks.id(Identifier { namespace: "minecraft", path: name.copy() }) else {
        fail "there's no block {name}"
    }
    let i = usize.wrap(id)
    return first_states()[i] + default_offsets()[i]
}

/// The ID of `entry` in the synchronized registry `registry`, or a problem.
pub fn synced_id(registries: Registries, registry: String, entry: String) -> i32 ! String {
    let r = registries.find(registry) else {
        fail "there's no registry {registry}"
    }
    let id = registries.synced[r].id(Identifier { namespace: "minecraft", path: entry.copy() }) else {
        fail "there's no {entry} in {registry}"
    }
    return id
}

/// The IDs of every entry in the synchronized registry `registry`, in ID order.
pub fn synced_ids(registries: Registries, registry: String) -> List<i32> {
    var out = List<i32>()
    if let r = registries.find(registry) {
        for i in 0..registries.synced[r].entries.len() {
            out.push(i32.wrap(i))
        }
    }
    return out
}

/// The world's seed from `level-seed`, as `WorldOptions.parseSeed` reads it: a number, or else
/// the text's Java hash code, or `none` when it's empty, for a random seed.
pub fn parse_seed(text: String) -> i64? {
    let trimmed = java_trim(text)
    if trimmed.is_empty() {
        return none
    }
    return match parse_long(trimmed, 10) {
        ok(n) => some(n),
        err(_) => some(i64(string_hash(trimmed))),
    }
}

/// The seed `level-random-seed`'s `base` gives the random of the level of the dimension `id`,
/// as the rig's agent seeds vanilla's (D311): `mixStafford13(base ^ id.hashCode())`, with the
/// hash Java's `String.hashCode` of the name, such as `minecraft:overworld`, made a long.
pub fn level_random_seed(base: i64, id: Identifier) -> i64 {
    return mix_stafford13(base ^ i64(string_hash(id.to_string())))
}

/// A random seed, as `WorldOptions.randomSeed` draws one, from 8 random bytes.
pub fn random_seed(bytes: List<u8>) -> i64 {
    var seed: i64 = 0
    for b in bytes {
        seed = (seed << 8) | i64(b)
    }
    return seed
}


/// A player's name as vanilla shows it, `Player.getDisplayName`: clicking it suggests a
/// message to them, hovering shows them, and shift-clicking puts their name in the chat box.
pub fn display_name(profile: GameProfile) -> Component {
    let tooltip = EntityTooltip { kind: Identifier { namespace: "minecraft", path: "player" }, uuid: profile.id, name: some(Box(Component.literal(profile.name))) }
    return Component.literal(profile.name).styled(Style { click_event: some(ClickEvent.SuggestCommand("/tell {profile.name} ")), hover_event: some(HoverEvent.ShowEntity(tooltip)), insertion: some(profile.name.copy()) })
}
