/// `ProfileResolver.Cached`'s caches of profiles, by name and by UUID, which `fetchprofile` asks
/// first (CAL-374).

module server.profile_cache

import auth.profile.{GameProfile}
import java.uuid.{Uuid}

// What `ProfileResolver.Cached` keeps (CAL-374): the profile found for each name and for each
// UUID, none where there was none, each kept till ten minutes after it was last asked for,
// `expireAfterAccess`, at most 256 of each, the one longest unasked going first, `maximumSize`.
pub struct ProfileCache {
    pub names: List<(String, GameProfile?, i64)> = List<(String, GameProfile?, i64)>()
    pub ids: List<(Uuid, GameProfile?, i64)> = List<(Uuid, GameProfile?, i64)>()
}

// How long a cached profile's kept unasked, ten minutes (CAL-374).
pub const PROFILE_KEPT_MS: i64 = 600000

// The most profiles each of the cache's halves keeps (CAL-374).
pub const PROFILES_KEPT: usize = 256

impl ProfileCache {
    // Whether the name `name` is still kept at `now`, asked for again, and its profile or none.
    pub fn named(mut self, name: String, now: i64) -> (bool, GameProfile?) {
        self.forget_old(now)
        for i in 0..self.names.len() {
            let (n, p, _) = self.names[i].copy()
            if n == name {
                self.names[i] = (n, p.copy(), now)
                return (true, p)
            }
        }
        return (false, none)
    }

    // What's kept for the UUID `id` at `now`, as `named` gives it.
    pub fn by_id(mut self, id: Uuid, now: i64) -> (bool, GameProfile?) {
        self.forget_old(now)
        for i in 0..self.ids.len() {
            let (u, p, _) = self.ids[i].copy()
            if u == id {
                self.ids[i] = (u, p.copy(), now)
                return (true, p)
            }
        }
        return (false, none)
    }

    // The name `name` found to be `p` at `now`.
    pub fn keep_named(mut self, name: String, p: GameProfile?, now: i64) {
        var kept = List<(String, GameProfile?, i64)>()
        for e in self.names {
            if e.0 != name {
                kept.push(e.copy())
            }
        }
        kept.push((name.copy(), p.copy(), now))
        while kept.len() > PROFILES_KEPT {
            _ = kept.remove(oldest_named(kept))
        }
        self.names = kept
    }

    // The UUID `id` found to be `p` at `now`.
    pub fn keep_id(mut self, id: Uuid, p: GameProfile?, now: i64) {
        var kept = List<(Uuid, GameProfile?, i64)>()
        for e in self.ids {
            if e.0 != id {
                kept.push(e.copy())
            }
        }
        kept.push((id, p.copy(), now))
        while kept.len() > PROFILES_KEPT {
            _ = kept.remove(oldest_id(kept))
        }
        self.ids = kept
    }

    // Those unasked for ten minutes forgotten.
    pub fn forget_old(mut self, now: i64) {
        var names = List<(String, GameProfile?, i64)>()
        for e in self.names {
            if now - e.2 < PROFILE_KEPT_MS {
                names.push(e.copy())
            }
        }
        self.names = names
        var ids = List<(Uuid, GameProfile?, i64)>()
        for e in self.ids {
            if now - e.2 < PROFILE_KEPT_MS {
                ids.push(e.copy())
            }
        }
        self.ids = ids
    }
}

// Where in `l` the name longest unasked is.
fn oldest_named(l: List<(String, GameProfile?, i64)>) -> usize {
    var at: usize = 0
    for i in 0..l.len() {
        if l[i].2 < l[at].2 {
            at = i
        }
    }
    return at
}

// Where in `l` the UUID longest unasked is.
fn oldest_id(l: List<(Uuid, GameProfile?, i64)>) -> usize {
    var at: usize = 0
    for i in 0..l.len() {
        if l[i].2 < l[at].2 {
            at = i
        }
    }
    return at
}
