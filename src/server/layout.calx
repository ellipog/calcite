/// The world's regions: which players tick together (D19, D22, D47). A player's loaded chunks
/// are the square of their view around the chunk they're in, and any two players whose squares
/// come closer than `MERGE_DISTANCE` chunks, in one dimension, are in the same region, as are
/// those that are close to them, so a region is a part of a world nothing outside it can reach in
/// a tick. The layout is worked out again at the barrier, from the players' places and the last
/// layout alone, so the same input log gives the same regions, with the same IDs, on any
/// number of threads.
///
/// A region keeps its ID while it's there: one that splits keeps it for the part with the player
/// who's been in the server longest, by entity ID, and the others get new ones; regions that
/// merge keep the smallest of theirs. New IDs count up from 1, and 0 is the world's own actor.
module server.layout

/// Chunks of two players' views closer than this, on both axes, put them in one region (D47).
/// D53's least: every bounded query vanilla makes, 128 blocks at most, stays inside a region.
pub const MERGE_DISTANCE: i32 = 9

/// A player as the layout places them: their entity ID, their dimension, by its place in the
/// world's, the chunk they're in and their view distance; and where the server keeps them, which
/// the layout hands back with them and doesn't go by.
pub struct Placed {
    pub player: i32
    pub dim: usize
    pub x: i32
    pub z: i32
    pub view: i32
    pub slot: usize = 0
}

/// A region: its ID, its dimension, and its players, by entity ID, ascending, with where the
/// server keeps each.
pub struct Region {
    pub id: u32
    pub dim: usize
    pub players: List<i32>
    pub slots: List<usize> = List<usize>()
}

/// The regions, by ID, ascending.
pub struct Layout {
    pub regions: List<Region> = List<Region>()
    // The next new region's ID.
    next_id: u32 = 1
    // What the regions were worked out from, by entity ID, so an unchanged world isn't worked
    // out again.
    placed: List<Placed> = List<Placed>()
}

impl Layout {
    /// No regions, as before anyone's joined.
    pub fn new() -> Layout {
        return Layout()
    }

    /// The regions of the players `placed`, in any order, from these: each part of the players
    /// that are near each other is a region, with the smallest ID of the regions its players were
    /// in that no part before it kept, the parts in the order of their first players, or a new
    /// one. Gives whether the regions changed.
    pub fn update(mut self, placed: List<Placed>) -> bool {
        var now = placed.copy()
        now.sort()
        if same(now, self.placed) {
            return false
        }
        let parts = connected(now)
        // Each player's region before, by entity ID.
        var before = Map<i32, u32>()
        for r in self.regions {
            for p in r.players {
                before.insert(p, r.id)
            }
        }
        // The parts in the order of their first players, which have the smallest entity IDs, so
        // the part with the longest-joined player of a region that split keeps its ID.
        var taken = Set<u32>()
        var made = List<Region>()
        for part in parts {
            var players = List<i32>()
            var slots = List<usize>()
            var keep: u32? = none
            for i in part {
                players.push(now[i].player)
                slots.push(now[i].slot)
                if let id = before.get(now[i].player) {
                    if not taken.contains(id) {
                        keep = match keep {
                            some(k) => some(if id < k { id } else { k }),
                            none => some(id),
                        }
                    }
                }
            }
            let id = match keep {
                some(k) => k,
                none => {
                    let n = self.next_id
                    self.next_id += 1
                    n
                },
            }
            taken.insert(id)
            made.push(Region { id: id, dim: now[part[0]].dim, players: players, slots: slots })
        }
        made.sort()
        let changed = not same_regions(made, self.regions)
        self.regions = made
        self.placed = now
        return changed
    }

    /// The place in `regions` of the region `player` is in, or `none` if they aren't placed.
    pub fn region_of(self, player: i32) -> usize? {
        for i in 0..self.regions.len() {
            for p in self.regions[i].players {
                if p == player {
                    return some(i)
                }
            }
        }
        return none
    }
}

/// Whether the players `a` and `b` are near enough to be in one region: in one dimension, with
/// chunks of their views closer than `MERGE_DISTANCE` on both axes.
pub fn near(a: Placed, b: Placed) -> bool {
    if a.dim != b.dim {
        return false
    }
    let reach = i64(a.view) + i64(b.view) + i64(MERGE_DISTANCE)
    return abs64(i64(a.x) - i64(b.x)) <= reach and abs64(i64(a.z) - i64(b.z)) <= reach
}

// The parts of `placed`, sorted by entity ID, whose players are near each other, each as the
// places of its players, ascending, and the parts in the order of their first players.
//
// The players go into square cells as wide as the least any two can reach, so two in one cell are
// always near, and one cell's are one part from the start. Then each cell is compared only with
// those as close as the most any two can reach, and only while they're in different parts, so
// players crowded together cost little more than sorting them, and so do players far apart.
fn connected(placed: List<Placed>) -> List<List<usize>> {
    let n = placed.len()
    var root = List<usize>()
    var widest: i32 = 0
    var narrowest = i32.MAX
    for i in 0..n {
        root.push(i)
        widest = widest.max(placed[i].view)
        narrowest = narrowest.min(placed[i].view)
    }
    if n < 2 {
        return parts_of(mut root)
    }
    // Two players in one cell are less than `side` apart on both axes, and `near` lets them be
    // as far as their views and the distance between them; cells more than `reach` apart are
    // further apart than any two can be.
    let side = i64(narrowest.max(0)) * 2 + i64(MERGE_DISTANCE)
    let reach = (i64(widest) * 2 + i64(MERGE_DISTANCE) + side - 1) / side
    var cells = List<(usize, i64, i64, usize)>()
    for i in 0..n {
        cells.push((placed[i].dim, floor_div(i64(placed[i].x), side), floor_div(i64(placed[i].z), side), i))
    }
    cells.sort()
    // Each cell's run of players: where it starts, and its cell.
    var starts = List<usize>()
    for c in 0..n {
        if c == 0 or cells[c].0 != cells[c - 1].0 or cells[c].1 != cells[c - 1].1 or cells[c].2 != cells[c - 1].2 {
            starts.push(c)
        } else {
            join(mut root, cells[starts[starts.len() - 1]].3, cells[c].3)
        }
    }
    starts.push(n)
    for a in 0..starts.len() - 1 {
        let (dim, ax, az, first) = cells[starts[a]]
        var b = a + 1
        while b < starts.len() - 1 and cells[starts[b]].0 == dim and cells[starts[b]].1 - ax <= reach {
            let (_, _, bz, other) = cells[starts[b]]
            if abs64(bz - az) <= reach and find(mut root, first) != find(mut root, other) {
                // Any one pair near puts the two cells' parts together.
                var p = starts[a]
                while p < starts[a + 1] {
                    var q = starts[b]
                    while q < starts[b + 1] and not near(placed[cells[p].3], placed[cells[q].3]) {
                        q += 1
                    }
                    if q < starts[b + 1] {
                        join(mut root, cells[p].3, cells[q].3)
                        p = starts[a + 1]
                    } else {
                        p += 1
                    }
                }
            }
            b += 1
        }
    }
    return parts_of(mut root)
}

// Each part of the players `root` joins, by its smallest place, which is its first player's.
fn parts_of(root: mut List<usize>) -> List<List<usize>> {
    let n = root.len()
    var parts = List<List<usize>>()
    // Each root's part, by its place in `parts`.
    var part_of = List<u32>()
    for _ in 0..n {
        part_of.push(u32.MAX)
    }
    for i in 0..n {
        let r = find(mut root, i)
        if part_of[r] != u32.MAX {
            parts[usize(part_of[r])].push(i)
        } else {
            part_of[r] = u32.wrap(parts.len())
            parts.push([i])
        }
    }
    return parts
}

// The root of `i`'s part, each place on the way pointed at it.
fn find(root: mut List<usize>, i: usize) -> usize {
    var r = i
    while root[r] != r {
        r = root[r]
    }
    var at = i
    while root[at] != r {
        let next = root[at]
        root[at] = r
        at = next
    }
    return r
}

// Puts `i`'s and `j`'s parts together, under the smaller root.
fn join(root: mut List<usize>, i: usize, j: usize) {
    let a = find(mut root, i)
    let b = find(mut root, j)
    if a < b {
        root[b] = a
    } else if b < a {
        root[a] = b
    }
}

// By entity ID.
impl Order for Placed {
    fn cmp(self, other: Self) -> Ordering {
        return self.player.cmp(other.player)
    }
}

// By ID.
impl Order for Region {
    fn cmp(self, other: Self) -> Ordering {
        return self.id.cmp(other.id)
    }
}

fn same(a: List<Placed>, b: List<Placed>) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        if a[i].player != b[i].player or a[i].dim != b[i].dim or a[i].x != b[i].x or a[i].z != b[i].z or a[i].view != b[i].view or a[i].slot != b[i].slot {
            return false
        }
    }
    return true
}

fn same_regions(a: List<Region>, b: List<Region>) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        if a[i].id != b[i].id or a[i].dim != b[i].dim or a[i].players != b[i].players {
            return false
        }
    }
    return true
}

// `v / d` rounded down, for `d` above 0.
fn floor_div(v: i64, d: i64) -> i64 {
    return if v >= 0 { v / d } else { -((-v + d - 1) / d) }
}

fn abs64(v: i64) -> i64 {
    return if v < 0 { -v } else { v }
}
