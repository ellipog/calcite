/// The world's regions: which players tick together (D19, D22, D47). A player's loaded chunks
/// are the square of their view around the chunk they're in, and any two players whose squares
/// come closer than `MERGE_DISTANCE` chunks, in one dimension, are in the same region, as are
/// those that are close to them, so a region is a part of a world nothing outside it can reach in
/// a tick. The layout is worked out again at the barrier, from the players' places and the last
/// layout alone, so the same input log gives the same regions, with the same IDs, on any
/// number of threads.
///
/// A region keeps its ID while it's there: one that splits keeps it for the part with the player
/// who's been in the server longest, by entity ID, and the others get new ones; regions that
/// merge keep the smallest of theirs. New IDs count up from 1, and 0 is the world's own actor.
module server.layout

/// Chunks of two players' views closer than this, on both axes, put them in one region (D47).
/// D53's least: every bounded query vanilla makes, 128 blocks at most, stays inside a region.
pub const MERGE_DISTANCE: i32 = 9

/// A player as the layout places them: their entity ID, their dimension, by its place in the
/// world's, the chunk they're in and their view distance.
pub struct Placed {
    pub player: i32
    pub dim: usize
    pub x: i32
    pub z: i32
    pub view: i32
}

/// A region: its ID, its dimension, and its players, by entity ID, ascending.
pub struct Region {
    pub id: u32
    pub dim: usize
    pub players: List<i32>
}

/// The regions, by ID, ascending.
pub struct Layout {
    pub regions: List<Region> = List<Region>()
    // The next new region's ID.
    next_id: u32 = 1
    // What the regions were worked out from, by entity ID, so an unchanged world isn't worked
    // out again.
    placed: List<Placed> = List<Placed>()
}

impl Layout {
    /// No regions, as before anyone's joined.
    pub fn new() -> Layout {
        return Layout()
    }

    /// The regions of the players `placed`, in any order, from these: each part of the players
    /// that are near each other is a region, with the smallest ID of the regions its players were
    /// in that no part before it kept, the parts in the order of their first players, or a new
    /// one. Gives whether the regions changed.
    pub fn update(mut self, placed: List<Placed>) -> bool {
        var now = placed.copy()
        now.sort()
        if same(now, self.placed) {
            return false
        }
        let parts = connected(now)
        // Each player's region before, by entity ID.
        var before = Map<i32, u32>()
        for r in self.regions {
            for p in r.players {
                before.insert(p, r.id)
            }
        }
        // The parts in the order of their first players, which have the smallest entity IDs, so
        // the part with the longest-joined player of a region that split keeps its ID.
        var taken = Set<u32>()
        var made = List<Region>()
        for part in parts {
            var players = List<i32>()
            var keep: u32? = none
            for i in part {
                players.push(now[i].player)
                if let id = before.get(now[i].player) {
                    if not taken.contains(id) {
                        keep = match keep {
                            some(k) => some(if id < k { id } else { k }),
                            none => some(id),
                        }
                    }
                }
            }
            let id = match keep {
                some(k) => k,
                none => {
                    let n = self.next_id
                    self.next_id += 1
                    n
                },
            }
            taken.insert(id)
            made.push(Region { id: id, dim: now[part[0]].dim, players: players })
        }
        made.sort()
        let changed = not same_regions(made, self.regions)
        self.regions = made
        self.placed = now
        return changed
    }

    /// The place in `regions` of the region `player` is in, or `none` if they aren't placed.
    pub fn region_of(self, player: i32) -> usize? {
        for i in 0..self.regions.len() {
            for p in self.regions[i].players {
                if p == player {
                    return some(i)
                }
            }
        }
        return none
    }
}

/// Whether the players `a` and `b` are near enough to be in one region: in one dimension, with
/// chunks of their views closer than `MERGE_DISTANCE` on both axes.
pub fn near(a: Placed, b: Placed) -> bool {
    if a.dim != b.dim {
        return false
    }
    let reach = i64(a.view) + i64(b.view) + i64(MERGE_DISTANCE)
    return abs64(i64(a.x) - i64(b.x)) <= reach and abs64(i64(a.z) - i64(b.z)) <= reach
}

// The parts of `placed`, sorted by entity ID, whose players are near each other, each as the
// places of its players, ascending, and the parts in the order of their first players. Players
// sorted by `x` are only compared with those whose `x` could be near, so a server of players far
// apart costs little more than sorting them.
fn connected(placed: List<Placed>) -> List<List<usize>> {
    let n = placed.len()
    var root = List<usize>()
    var widest: i32 = 0
    for i in 0..n {
        root.push(i)
        if placed[i].view > widest {
            widest = placed[i].view
        }
    }
    var by_x = List<(i32, usize)>()
    for i in 0..n {
        by_x.push((placed[i].x, i))
    }
    by_x.sort()
    let span = i64(widest) * 2 + i64(MERGE_DISTANCE)
    for a in 0..n {
        let (xa, i) = by_x[a]
        var b = a + 1
        while b < n and i64(by_x[b].0) - i64(xa) <= span {
            let j = by_x[b].1
            if near(placed[i], placed[j]) {
                join(mut root, i, j)
            }
            b += 1
        }
    }
    // Each part, by its smallest place, which is its first player's.
    var parts = List<List<usize>>()
    var part_of = Map<usize, usize>()
    for i in 0..n {
        let r = find(mut root, i)
        if let p = part_of.get(r) {
            parts[p].push(i)
        } else {
            part_of.insert(r, parts.len())
            parts.push([i])
        }
    }
    return parts
}

// The root of `i`'s part, each place on the way pointed at it.
fn find(root: mut List<usize>, i: usize) -> usize {
    var r = i
    while root[r] != r {
        r = root[r]
    }
    var at = i
    while root[at] != r {
        let next = root[at]
        root[at] = r
        at = next
    }
    return r
}

// Puts `i`'s and `j`'s parts together, under the smaller root.
fn join(root: mut List<usize>, i: usize, j: usize) {
    let a = find(mut root, i)
    let b = find(mut root, j)
    if a < b {
        root[b] = a
    } else if b < a {
        root[a] = b
    }
}

// By entity ID.
impl Order for Placed {
    fn cmp(self, other: Self) -> Ordering {
        return self.player.cmp(other.player)
    }
}

// By ID.
impl Order for Region {
    fn cmp(self, other: Self) -> Ordering {
        return self.id.cmp(other.id)
    }
}

fn same(a: List<Placed>, b: List<Placed>) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        if a[i].player != b[i].player or a[i].dim != b[i].dim or a[i].x != b[i].x or a[i].z != b[i].z or a[i].view != b[i].view {
            return false
        }
    }
    return true
}

fn same_regions(a: List<Region>, b: List<Region>) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        if a[i].id != b[i].id or a[i].dim != b[i].dim or a[i].players != b[i].players {
            return false
        }
    }
    return true
}

fn abs64(v: i64) -> i64 {
    return if v < 0 { -v } else { v }
}
