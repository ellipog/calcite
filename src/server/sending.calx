/// What the server sends each connection, and the codec threads that encode most of it, off the
/// tick thread (D33, D143).
///
/// A connection's packets are queued in order as the server handles what arrives and ticks,
/// with where its compression and encryption start among them. A flush encodes what each
/// connection queued: compressed, framed and encrypted, as vanilla's encoders do it. The server
/// flushes once a tick ends and after each thing it handles between ticks, as vanilla does, so a
/// tick's packets go to the system in one send a connection.
///
/// A flush of a few small packets, none of them long enough to compress, encodes them on the tick
/// thread, where that costs less than handing them over. More, or any packet to compress, go to a
/// codec thread with the connection's encoder, as vanilla compresses on its network threads, and
/// the bytes and the encoder come back on a queue, waking the poll. Only one batch of a
/// connection is away at a time, so its bytes keep their order, and what it queues meanwhile goes
/// once the encoder is back. A batch of up to `SMALL_BATCH` bytes goes to the one codec thread
/// for small batches; the others take bigger ones, and start as the bytes waiting need them, up
/// to one fewer than the processors.
///
/// A chunk's packet that's kept for several players is compressed once, by whichever player's
/// encoder gets it first: the body comes back for the level to keep, and the others are sent it
/// framed and encrypted as theirs (D196). Compressing is most of what a chunk costs to send.
module server.sending

import protocol.codec.{Encoder}
import protocol.wire.{Writer}
import server.link.{Link}
import std.net.{Conn, Waker}
import std.pool.{workers}
import std.thread.{Task}

/// The most bytes of packets a flush encodes on the tick thread. Encrypting takes about 7 ns a
/// byte and compressing more, while handing a batch to a codec thread costs a few microseconds.
pub const INLINE_BYTES: usize = 1024

/// The most bytes of packets a batch has that goes to the one codec thread for small batches,
/// such as a chat message for each player, or a few chunks. The other threads take only bigger
/// batches, so those a join started sleep once it's done, and don't each wake for a broadcast and
/// give their memory back 2 seconds later, over and over, as they did with 100 bots.
pub const SMALL_BATCH: usize = 16384

/// The bytes of packets in bigger batches each of the other codec threads may have waiting before
/// another starts: about half a millisecond of compressing. A join's batches of chunks start as
/// many as they need.
pub const THREAD_BYTES: usize = 65536

/// One thing a connection sends, in order.
enum Step {
    /// A packet, its ID then its fields.
    Packet(List<u8>)
    /// Bytes that go as they are, such as the answer to the old ping, which isn't framed.
    Raw(List<u8>)
    /// Compression from here on, with this threshold, or none if it's negative.
    Compress(i32)
    /// Encryption from here on, with this secret.
    Encrypt(List<u8>)
    /// A packet kept for other players, whose compressed body comes back with its key and version.
    Shared { packet: List<u8>, key: i64, version: u64 }
    /// A frame's body, compressed already with this threshold.
    Body(List<u8>, i32)
}

/// A packet kept for other players, as a connection's encoder compressed it on the way: the key
/// and version it was queued with, and its frame's body, compressed with `threshold`.
pub struct Compressed {
    pub key: i64
    pub version: u64
    pub body: List<u8>
    pub threshold: i32
}

/// What a connection has queued to send.
pub struct Outbox {
    // The connection's encoder, or `none` while it's away on a codec thread.
    encoder: Encoder?
    steps: Deque<Step>
    // How many bytes of packets the steps hold, and the most one of them has.
    bytes: usize
    largest: usize = 0
    // Whether the connection is to close once everything is sent, and whether it has.
    ending: bool
    ended: bool
}

impl Outbox {
    /// An empty outbox, with neither compression nor encryption, as a connection starts.
    pub fn new() -> Outbox {
        return Outbox { encoder: some(Encoder.new()), steps: Deque<Step>(), bytes: 0, ending: false, ended: false }
    }

    /// Queues a packet, its ID then its fields.
    pub fn packet(mut self, body: own List<u8>) {
        self.bytes += body.len()
        self.largest = self.largest.max(body.len())
        self.steps.push_last(Step.Packet(body))
    }

    /// Queues a packet that's kept for other players. If the connection compresses, the body
    /// it's compressed to comes back from `Sending.take_compressed`, with `key` and `version`.
    pub fn shared(mut self, packet: own List<u8>, key: i64, version: u64) {
        self.bytes += packet.len()
        self.largest = self.largest.max(packet.len())
        self.steps.push_last(Step.Shared { packet: packet, key: key, version: version })
    }

    /// Queues a packet's frame body, compressed already with `threshold`, as another
    /// connection's encoder compressed it.
    pub fn compressed(mut self, body: own List<u8>, threshold: i32) {
        self.bytes += body.len()
        self.steps.push_last(Step.Body(body, threshold))
    }

    /// Queues bytes that go as they are.
    pub fn raw(mut self, bytes: own List<u8>) {
        self.bytes += bytes.len()
        self.steps.push_last(Step.Raw(bytes))
    }

    /// Compresses the packets queued after this with `threshold`, or none if it's negative.
    pub fn start_compression(mut self, threshold: i32) {
        self.steps.push_last(Step.Compress(threshold))
    }

    /// Encrypts what's queued after this, with `secret` as the key and the IV.
    pub fn start_encryption(mut self, secret: List<u8>) {
        self.steps.push_last(Step.Encrypt(secret.copy()))
    }

    /// Closes the connection once everything queued is sent.
    pub fn end(mut self) {
        self.ending = true
    }

    // Whether a packet queued is to be compressed, by the threshold the connection compresses
    // from now: one as long as it is, as vanilla's `CompressionEncoder` compresses it.
    fn compresses(self) -> bool {
        if let e = self.encoder {
            let threshold = e.compression()
            return threshold >= 0 and self.largest >= usize.wrap(threshold)
        }
        return false
    }
}

// A connection's steps and its encoder, on their way to a codec thread, with how many bytes of
// packets the steps hold.
struct Batch {
    conn: Conn
    encoder: Encoder
    steps: Deque<Step>
    size: usize
}

/// A batch a codec thread encoded: its connection's encoder, the bytes to send, why any packet
/// couldn't be, the shared packets it compressed, and how many bytes of packets it had.
pub struct Encoded {
    pub conn: Conn
    encoder: Encoder
    bytes: List<u8>
    problems: List<String>
    compressed: List<Compressed>
    size: usize
}

// A codec thread: it encodes each batch that comes, sends it back, and wakes the poll.
struct CodecThread {
    jobs: Receiver<Batch>
    done: Sender<Encoded>
    waker: Waker
}

impl Task for CodecThread {
    // The poll is woken once the queue's empty, or after a batch of more than `INLINE_BYTES`, so
    // a broadcast's small batches wake it once, not once each, and a tick's chunks go at once.
    fn run(own self) {
        var jobs = self.jobs
        var done = self.done
        while let first = jobs.wait() {
            var job: Batch? = some(first)
            while let b = job.take() {
                var encoder = b.encoder
                var steps = b.steps
                var problems = List<String>()
                var compressed = List<Compressed>()
                let bytes = encode(mut encoder, mut steps, mut problems, mut compressed)
                done.send(Encoded { conn: b.conn, encoder: encoder, bytes: bytes, problems: problems, compressed: compressed, size: b.size })
                if b.size > INLINE_BYTES {
                    self.waker.wake()
                }
                job = jobs.next()
            }
            self.waker.wake()
        }
    }
}

// The steps, taken in order, as the bytes to send through `encoder`. A packet that can't be
// sent, such as one too big, is left out, with why in `problems`. The shared packets compressed
// on the way go in `compressed`.
fn encode(encoder: mut Encoder, steps: mut Deque<Step>, problems: mut List<String>, compressed: mut List<Compressed>) -> List<u8> {
    var w = Writer.new()
    while let s = steps.pop_first() {
        match s {
            Step.Packet(body) => {
                match encoder.encode(body) {
                    ok(bytes) => w.raw(bytes),
                    err(message) => problems.push(message),
                }
            },
            Step.Raw(bytes) => w.raw(bytes),
            Step.Compress(threshold) => encoder.start_compression(threshold),
            Step.Encrypt(secret) => encoder.start_encryption(secret),
            Step.Shared { packet, key, version } => {
                match encoder.body(packet) {
                    ok(body) => {
                        let threshold = encoder.compression()
                        if threshold >= 0 {
                            compressed.push(Compressed { key: key, version: version, body: body.copy(), threshold: threshold })
                        }
                        match encoder.encode_body(body) {
                            ok(bytes) => w.raw(bytes),
                            err(message) => problems.push(message),
                        }
                    },
                    err(message) => problems.push(message),
                }
            },
            Step.Body(body, threshold) => {
                // Every connection compresses from the server's threshold, so this is a mistake.
                if threshold != encoder.compression() {
                    problems.push("A packet compressed from {threshold} bytes can't go where they're compressed from {encoder.compression()}")
                } else {
                    match encoder.encode_body(body) {
                        ok(bytes) => w.raw(bytes),
                        err(message) => problems.push(message),
                    }
                }
            },
        }
    }
    return w.into_bytes()
}

/// The codec threads, and the queues to and from them.
pub struct Sending {
    // What wakes the poll once a batch is back, made with the first batch handed over. Without
    // one, everything is encoded on the tick thread.
    waker: Waker?
    no_waker: bool
    // The bigger batches waiting for a codec thread, which each of those takes from; the small
    // ones, for the small batches' thread; and those coming back.
    jobs: Receiver<Batch>
    to_jobs: Sender<Batch>
    small_jobs: Receiver<Batch>
    to_small: Sender<Batch>
    done: Receiver<Encoded>
    to_done: Sender<Encoded>
    // How many codec threads for bigger batches have started, how many may, whether the small
    // batches' has, how many batches are away, and how many bigger ones, with how many bytes.
    started: usize
    most: usize
    small_started: bool = false
    batches_away: usize
    big_away: usize = 0
    big_bytes: usize = 0
    // The shared packets compressed since they were last taken.
    compressed: List<Compressed>
}

impl Sending {
    /// Sending, with no codec thread started yet.
    pub fn new() -> Sending {
        let jobs = Receiver<Batch>()
        let to_jobs = jobs.sender()
        let small_jobs = Receiver<Batch>()
        let to_small = small_jobs.sender()
        let done = Receiver<Encoded>()
        let to_done = done.sender()
        // The tick thread is busy itself, so the codec threads leave it a processor.
        let processors = unsafe { workers() }
        let most = if processors > 2 { processors - 1 } else { 1 }
        return Sending { waker: none, no_waker: false, jobs: jobs, to_jobs: to_jobs, small_jobs: small_jobs, to_small: to_small, done: done, to_done: to_done, started: 0, most: most, batches_away: 0, compressed: List<Compressed>() }
    }

    /// Encodes what `out` queued for `conn`, and sends it through `link`: here if it's at most
    /// `INLINE_BYTES` of packets, and on a codec thread otherwise. If a codec thread has the
    /// connection's encoder already, it waits for it. Once everything is sent, a connection
    /// that's ending is closed. Why any packet couldn't be sent goes in `problems`.
    pub fn dispatch(mut self, conn: Conn, out: mut Outbox, problems: mut List<String>, link: Link) {
        if out.encoder == none {
            return
        }
        if not out.steps.is_empty() {
            if (out.bytes > INLINE_BYTES or out.compresses()) and self.can_hand_over(link, out.bytes) {
                var steps = Deque<Step>()
                while let s = out.steps.pop_first() {
                    steps.push_last(s)
                }
                let encoder = out.encoder.take()!
                let size = out.bytes
                out.bytes = 0
                out.largest = 0
                let batch = Batch { conn: conn, encoder: encoder, steps: steps, size: size }
                if size <= SMALL_BATCH {
                    self.to_small.send(batch)
                } else {
                    self.to_jobs.send(batch)
                    self.big_away += 1
                    self.big_bytes += size
                }
                self.batches_away += 1
                return
            }
            var encoder = out.encoder.take()!
            let bytes = encode(mut encoder, mut out.steps, mut problems, mut self.compressed)
            out.encoder = some(encoder)
            out.bytes = 0
            out.largest = 0
            link.write(conn, bytes)
        }
        if out.ending and not out.ended {
            out.ended = true
            link.close(conn)
        }
    }

    /// How many codec threads have started, the small batches' among them.
    pub fn threads(self) -> usize {
        return self.started + (if self.small_started { 1usize } else { 0 })
    }

    /// How many batches are on codec threads, or waiting for one.
    pub fn away(self) -> usize {
        return self.batches_away
    }

    /// The batches that have come back from the codec threads.
    pub fn take_done(mut self) -> List<Encoded> {
        var back = List<Encoded>()
        while let e = self.done.next() {
            self.batches_away -= 1
            if e.size > SMALL_BATCH {
                self.big_away -= 1
                self.big_bytes -= e.size
            }
            var got = e
            while let c = got.compressed.pop() {
                self.compressed.push(c)
            }
            back.push(got)
        }
        return back
    }

    /// The shared packets compressed since this was last asked, here or on the codec threads,
    /// whether or not their connections are still open.
    pub fn take_compressed(mut self) -> List<Compressed> {
        var out = List<Compressed>()
        while let c = self.compressed.pop() {
            out.push(c)
        }
        return out
    }

    /// Sends what a batch came back with, gives its connection's encoder back to `out`, and then
    /// dispatches what the connection queued meanwhile.
    pub fn arrived(mut self, e: own Encoded, out: mut Outbox, problems: mut List<String>, link: Link) {
        let conn = e.conn
        link.write(conn, e.bytes)
        for p in e.problems {
            problems.push(p.copy())
        }
        out.encoder = some(e.encoder)
        self.dispatch(conn, mut out, mut problems, link)
    }

    // Whether a batch of `size` bytes of packets can go to a codec thread, starting the small
    // batches' for a small one if it hasn't, or for a bigger one, another if there's none, or if
    // every one started has a batch and they'd have more than `THREAD_BYTES` each with it.
    fn can_hand_over(mut self, link: Link, size: usize) -> bool {
        if self.no_waker {
            return false
        }
        if self.waker == none {
            match link.waker() {
                ok(w) => self.waker = some(w),
                err(_) => {
                    self.no_waker = true
                    return false
                },
            }
        }
        if size <= SMALL_BATCH {
            if not self.small_started {
                let waker = self.waker!
                _ = unsafe { Thread.spawn(CodecThread { jobs: self.small_jobs.share(), done: self.to_done.share(), waker: waker }) }
                self.small_started = true
            }
            return true
        }
        let busy = self.big_away >= self.started and self.big_bytes + size > self.started * THREAD_BYTES
        if self.started < self.most and (self.started == 0 or busy) {
            let waker = self.waker!
            _ = unsafe { Thread.spawn(CodecThread { jobs: self.jobs.share(), done: self.to_done.share(), waker: waker }) }
            self.started += 1
        }
        return true
    }
}
