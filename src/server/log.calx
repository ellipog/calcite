/// The server's log, as vanilla's console shows it: Mojang's log4j2 configuration writes each line
/// as `[%d{HH:mm:ss}] [%t/%level]: %msg%n`, the local time, the thread, the level, then the
/// message.
module server.log

import std.io.{flush}
import std.time.{Timestamp}

/// How much a line matters, as log4j's levels name them.
pub enum Level {
    Info
    Warn
    Error
}

/// A line to log, from code that leaves the logging to its caller.
pub struct Entry {
    pub level: Level
    pub message: String
}

impl Entry {
    pub fn info(message: own String) -> Entry {
        return Entry { level: Level.Info, message: message }
    }

    pub fn warn(message: own String) -> Entry {
        return Entry { level: Level.Warn, message: message }
    }

    pub fn error(message: own String) -> Entry {
        return Entry { level: Level.Error, message: message }
    }
}

/// The line vanilla's console pattern writes for `message`, logged at `at`, `offset` seconds ahead
/// of UTC, on the thread named `thread`.
pub fn line(at: Timestamp, offset: i32, thread: String, level: Level, message: String) -> String {
    let t = at.date_time(offset)
    let name = match level {
        Level.Info => "INFO",
        Level.Warn => "WARN",
        Level.Error => "ERROR",
    }
    return "[{two(t.hour)}:{two(t.minute)}:{two(t.second)}] [{thread}/{name}]: {message}"
}

/// Prints `message` as vanilla's console does, at the wall clock's time now. Each line is written
/// out at once, so the console and anything reading it see it as it happens.
pub fn log(thread: String, level: Level, message: String) {
    let now = unsafe { Timestamp.now() }
    let offset = unsafe { now.local_offset() }
    println(line(now, offset, thread, level, message))
    flush()
}

fn two(n: i32) -> String {
    return if n < 10 { "0{n}" } else { "{n}" }
}
