/// The server's log. logs/latest.log always has vanilla's lines: Mojang's log4j2 configuration
/// writes each as `[%d{HH:mm:ss}] [%t/%level]: %msg%n`, the local time, the thread, the level,
/// then the message. The console has them too, in vanilla's style, which hosting panels and
/// wrappers read. In Calcite's style, the default on a terminal, it has Calcite's own look and
/// words instead: a card when the server is ready, then a line for each thing that happens
/// (CAL-50, D150). With `console-dashboard`, a bar pinned to the terminal shows how the server is
/// doing as the lines scroll past, and its thread draws them (`server.dashboard`).
module server.log

import server.console.{ConsoleInput}
import server.dashboard.{Place, ToConsole, draw_dashboard}
import server.log_file.{FileLine, FileWriter, ToFile}
import server.paint.{Colors, Hue, badge, paint, strong, terminal_colors}
import std.io.{flush, is_terminal}
import std.net.{Waker}
import std.time.{Instant, Timestamp}

/// How much a line matters, as log4j's levels name them.
pub enum Level {
    Info
    Warn
    Error
}

/// How a line shows in Calcite's style. In vanilla's, and in logs/latest.log, it's always
/// vanilla's line.
pub enum Look {
    /// Vanilla's words.
    Plain
    /// Calcite's own words.
    Words(String)
    /// A player came in.
    Join(String)
    /// A player went, or was turned away.
    Leave(String)
    /// What a player said, and whether Mojang signed it.
    Chat { name: String, words: String, signed: bool }
    /// Not shown: a step vanilla logs that tells whoever runs the server nothing new, or that
    /// the card shows instead.
    Quiet
}

/// A line to log, from code that leaves the logging to its caller.
pub struct Entry {
    pub level: Level
    pub message: String
    /// The thread vanilla logs it on, when that isn't the caller's own, such as `User
    /// Authenticator #1` for a login's check with Mojang's session server.
    pub thread: String?
    /// How it shows in Calcite's style.
    pub look: Look
}

impl Entry {
    pub fn info(message: own String) -> Entry {
        return Entry { level: Level.Info, message: message, thread: none, look: Look.Plain }
    }

    pub fn warn(message: own String) -> Entry {
        return Entry { level: Level.Warn, message: message, thread: none, look: Look.Plain }
    }

    pub fn error(message: own String) -> Entry {
        return Entry { level: Level.Error, message: message, thread: none, look: Look.Plain }
    }

    /// The entry, logged on the thread named `thread`.
    pub fn on(own self, thread: own String) -> Entry {
        return Entry { level: self.level, message: self.message, thread: some(thread), look: self.look }
    }

    /// The entry, shown as `look` in Calcite's style.
    pub fn calcite(own self, look: own Look) -> Entry {
        return Entry { level: self.level, message: self.message, thread: self.thread, look: look }
    }

    /// The thread it's logged on: its own, or else `caller`.
    pub fn thread_or(self, caller: String) -> String {
        return self.thread.copy() ?? caller.copy()
    }
}

/// The line vanilla's console pattern writes for `message`, logged at `at`, `offset` seconds ahead
/// of UTC, on the thread named `thread`.
pub fn line(at: Timestamp, offset: i32, thread: String, level: Level, message: String) -> String {
    let t = at.date_time(offset)
    let name = match level {
        Level.Info => "INFO",
        Level.Warn => "WARN",
        Level.Error => "ERROR",
    }
    return "[{two(t.hour)}:{two(t.minute)}:{two(t.second)}] [{thread}/{name}]: {message}"
}

/// How the console shows the server's lines.
pub enum Style {
    /// Vanilla's lines, exactly.
    Vanilla
    /// Calcite's own: a card when the server is ready, then a line for each thing that happens,
    /// with a mark for what kind of thing it is, in Calcite's words where it has them.
    Calcite
}

// Where a line's words start, after its indent, the time and the mark, and where their later
// lines start too.
const INDENT: usize = 15

/// The line Calcite's style shows for one logged at `at`, `offset` seconds ahead of UTC, or
/// `none` for a quiet one: two spaces, the time, faint, then a mark for what happened and the
/// words. A player coming in is a green `→`, one going or turned away a muted `←`, a warning an
/// amber `▲` with its words amber too, and an error a red `×` with its words red. Chat is the
/// player's name in bold, then what they said, with `unsigned` after it, muted, where Mojang
/// didn't sign it. Each later line of the words, such as an exception's, starts under the first,
/// muted.
pub fn styled(at: Timestamp, offset: i32, level: Level, message: String, look: Look, colors: Colors) -> String? {
    var mark = match level {
        Level.Info => String(" "),
        Level.Warn => paint(colors, Hue.Amber, true, "▲"),
        Level.Error => paint(colors, Hue.Red, true, "×"),
    }
    var words = message.copy()
    match look {
        Look.Plain => {},
        Look.Words(w) => words = w.copy(),
        Look.Join(w) => {
            mark = paint(colors, Hue.Green, true, "→")
            words = w.copy()
        },
        Look.Leave(w) => {
            mark = paint(colors, Hue.Muted, true, "←")
            words = w.copy()
        },
        Look.Chat { name, words: said, signed } => {
            words = "{strong(colors, name)}  {said}"
            if not signed {
                words.push_str(paint(colors, Hue.Muted, false, "  unsigned"))
            }
        },
        Look.Quiet => return none,
    }
    let t = at.date_time(offset)
    var out = "  {paint(colors, Hue.Faint, false, "{two(t.hour)}:{two(t.minute)}:{two(t.second)}")}  {mark}  "
    let first_end = words.find("\n") ?? words.len()
    let first = words[..first_end]
    out.push_str(match level {
        Level.Info => first.copy(),
        Level.Warn => paint(colors, Hue.Amber, false, first),
        Level.Error => paint(colors, Hue.Red, false, first),
    })
    var rest = words[first_end..]
    while rest.starts_with("\n") {
        rest = rest[1..]
        let end = rest.find("\n") ?? rest.len()
        out.push_str("\n")
        for _ in 0..INDENT {
            out.push(' ')
        }
        out.push_str(paint(colors, Hue.Muted, false, rest[..end]))
        rest = rest[end..]
    }
    return some(out)
}

/// How players' accounts are checked, as the card says.
pub enum Accounts {
    /// With Mojang's session server: `online-mode=true`.
    Online
    /// Not at all: `online-mode=false`.
    Offline
    /// By the Velocity proxy, with `velocity-forwarding` in calcite.properties.
    Velocity
}

/// What the card shows when the server is ready.
pub struct Card {
    /// Minecraft's version, such as `26.3`.
    pub version: String
    /// How long the server took to be ready, such as `4.8 ms`.
    pub took: String
    /// Where players reach it, such as `localhost:25565`.
    pub address: String
    pub accounts: Accounts
    pub view_distance: i32
    pub simulation_distance: i32
    pub max_players: i32
    /// The settings files the server made because they weren't there, such as on its first start.
    pub made: List<String>
}

// A label's width on the card.
const LABEL: usize = 11

/// The card Calcite's style shows when the server is ready, with a blank line around it:
///
/// ```text
///    calcite   Minecraft 26.3 · ready in 4.8 ms
///
///   ›  Address    localhost:25565
///   ›  Accounts   checked with Mojang
///   ›  World      flat, 10 chunks in view, 10 simulated
///   ›  Players    up to 20
/// ```
///
/// `calcite` is a badge, bold in the logo's ink on the calcite block's off-white. The address and
/// the time are bold, and the rest of the first line, the marks and the labels are muted.
/// Offline mode is amber, with how to turn it off under it. Where the server made settings files
/// that weren't there, a note under the rows names them.
pub fn card(c: Card, colors: Colors) -> String {
    var out = String("\n")
    out.push_str("  {badge(colors)}  {paint(colors, Hue.Muted, false, "Minecraft {c.version} · ready in")} {strong(colors, c.took)}\n\n")
    row(mut out, colors, "Address", strong(colors, c.address))
    match c.accounts {
        Accounts.Online => row(mut out, colors, "Accounts", String("checked with Mojang")),
        Accounts.Offline => {
            row(mut out, colors, "Accounts", paint(colors, Hue.Amber, false, "not checked: offline mode, so anyone can join with any name"))
            row(mut out, colors, "", paint(colors, Hue.Muted, false, "set online-mode=true in server.properties to check them"))
        },
        Accounts.Velocity => row(mut out, colors, "Accounts", String("checked by the Velocity proxy, the only way in")),
    }
    row(mut out, colors, "World", "flat, {c.view_distance} chunks in view, {c.simulation_distance} simulated")
    row(mut out, colors, "Players", "up to {c.max_players}")
    if not c.made.is_empty() {
        var files = String()
        for i in 0..c.made.len() {
            if i > 0 {
                files.push_str(if i + 1 == c.made.len() { " and " } else { ", " })
            }
            files.push_str(c.made[i])
        }
        out.push_str("\n  {paint(colors, Hue.Muted, false, "Made {files}, with every setting at its default.")}\n")
    }
    return out
}

// One row of the card: the mark, the label and the value, or the value alone under the last.
fn row(out: mut String, colors: Colors, label: str, value: String) {
    if label.is_empty() {
        out.push_str("     ")
    } else {
        out.push_str("  {paint(colors, Hue.Muted, true, "›")}  ")
    }
    var padded = String(label)
    while padded.len() < LABEL {
        padded.push(' ')
    }
    out.push_str("{paint(colors, Hue.Muted, false, padded)}{value}\n")
}

/// Where the server's lines go: the console, in its style, and the log file, which a thread of
/// its own writes (`server.log_file`). Where the dashboard is drawn, the console's lines go to its
/// thread, which shows them above the bar.
pub struct Log {
    file: Sender<ToFile>?
    // The file's thread, which the `Log` that opened it waits for as it closes.
    writer: Thread?
    // The dashboard's thread, and where the console's lines go to it, once it's drawn. The `Log`
    // that started it stops it as it closes.
    screen: Sender<ToConsole>?
    drawer: Thread?
    style: Style
    colors: Colors
}

// Calcite's style on a terminal, and vanilla's on a pipe or in a file, which a hosting panel or
// a wrapper reads.
fn default_style() -> Style {
    return if is_terminal() { Style.Calcite } else { Style.Vanilla }
}

impl Log {
    /// The console alone, as a replay logs, so it never touches the log of the server it replays.
    pub fn console() -> Log {
        return Log { file: none, writer: none, screen: none, drawer: none, style: default_style(), colors: terminal_colors() }
    }

    /// The console, and latest.log in `dir`, for a server that started at `start`. The file is
    /// opened on its thread, archiving one left from before, so the server needn't wait for it.
    pub unsafe fn open(dir: String, start: Timestamp) -> Log {
        let lines = Receiver<ToFile>()
        let file = lines.sender()
        let writer = unsafe { Thread.spawn(FileWriter { dir: dir.copy(), start: start, lines: lines }) }
        return Log { file: some(file), writer: some(writer), screen: none, drawer: none, style: default_style(), colors: terminal_colors() }
    }

    /// Shows the console's lines in `style` from now on: Calcite's on a terminal, and vanilla's
    /// elsewhere, until calcite.properties says.
    pub fn set_style(mut self, style: own Style) {
        self.style = style
    }

    /// Draws the dashboard at `place` from now on, for a server that started at `began`, with
    /// standard input already in raw mode: the console's lines go to its thread, and what's typed
    /// goes to `to`, waking `waker`. Logs shared after this go through it too.
    pub unsafe fn draw(mut self, place: own Place, began: Instant, to: own Sender<ConsoleInput>, waker: own Waker) {
        let calcite = match self.style {
            Style.Vanilla => false,
            Style.Calcite => true,
        }
        let (lines, thread) = unsafe { draw_dashboard(place, self.colors, calcite, began, to, waker) }
        self.screen = some(lines)
        self.drawer = some(thread)
    }

    /// Where the dashboard's numbers go, where it's drawn.
    pub fn dashboard(mut self) -> Sender<ToConsole>? {
        if let to = self.screen.take() {
            let shared = to.share()
            self.screen = some(to)
            return some(shared)
        }
        return none
    }

    /// Another handle to the same log, for another thread. Closing it leaves the file open, and
    /// the dashboard drawn.
    pub fn share(mut self) -> Log {
        var shared: Sender<ToFile>? = none
        if let to = self.file.take() {
            shared = some(to.share())
            self.file = some(to)
        }
        var drawn: Sender<ToConsole>? = none
        if let to = self.screen.take() {
            drawn = some(to.share())
            self.screen = some(to)
        }
        let style = match self.style {
            Style.Vanilla => Style.Vanilla,
            Style.Calcite => Style.Calcite,
        }
        return Log { file: shared, writer: none, screen: drawn, drawer: none, style: style, colors: self.colors }
    }

    /// Logs `message`, with vanilla's words in Calcite's style too.
    pub fn log(mut self, thread: String, level: Level, message: String) {
        self.write(thread, level, message, Look.Plain)
    }

    /// Logs `e`, on its thread, or else on `caller`.
    pub fn entry(mut self, caller: String, e: Entry) {
        self.write(e.thread_or(caller), e.level, e.message, e.look)
    }

    /// Logs `message` at the wall clock's time now: to the console in its style, where `look` is
    /// how Calcite's shows it, and to the log file as vanilla's line. Each is printed at once, or
    /// handed to the dashboard's thread where it's drawn, so the console and anything reading it
    /// see it as it happens, and sent to the file's thread.
    pub fn write(mut self, thread: String, level: Level, message: String, look: Look) {
        let now = unsafe { Timestamp.now() }
        let offset = unsafe { now.local_offset() }
        let text = line(now, offset, thread, level, message)
        match self.style {
            Style.Vanilla => self.show(text.copy()),
            Style.Calcite => {
                if let shown = styled(now, offset, level, message, look, self.colors) {
                    self.show(shown)
                }
            },
        }
        if let to = self.file.take() {
            var s = to
            s.send(ToFile.Line(FileLine { at: now, text: "{text}\n" }))
            self.file = some(s)
        }
    }

    /// Shows the card in Calcite's style. Vanilla's style and the log file have vanilla's lines
    /// for the same things instead.
    pub fn show_card(mut self, c: Card) {
        match self.style {
            Style.Vanilla => {},
            Style.Calcite => {
                let text = card(c, self.colors)
                self.show(text)
            },
        }
    }

    // Shows `text` on the console: through the dashboard where it's drawn, or else printed now.
    fn show(mut self, text: own String) {
        if let to = self.screen.take() {
            var s = to
            s.send(ToConsole.Line(text))
            self.screen = some(s)
            return
        }
        println(text)
        flush()
    }

    /// Takes the dashboard away, if this `Log` drew it, putting the terminal back, then waits for
    /// every line logged so far to be in the file, and for its archives to be compressed, if this
    /// `Log` opened it. Lines that other handles log after this go to the console alone.
    pub fn close(own self) {
        var screen = self.screen
        var drawer = self.drawer
        if let d = drawer.take() {
            if let to = screen.take() {
                var s = to
                s.send(ToConsole.Stop)
            }
            d.join()
        }
        var file = self.file
        var writer = self.writer
        if let t = writer.take() {
            if let to = file.take() {
                var s = to
                s.send(ToFile.Stop)
            }
            t.join()
        }
    }
}

fn two(n: i32) -> String {
    return if n < 10 { "0{n}" } else { "{n}" }
}
