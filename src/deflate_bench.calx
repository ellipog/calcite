/// Scratch, for D258: every chunk in a folder's region files, inflated, then deflated again at
/// levels 1 to 6, with the time each level took and the bytes it came to.
///
///     calx run --release src/deflate_bench.calx -- REGION_FOLDER
module deflate_bench

import std.env.{args}
import std.fs.{list, read}
import std.time.{Instant}
import std.zlib.{Format, compress, decompress}

fn main() {
    let a = args()
    let folder = a[0].copy()
    var payloads = List<List<u8>>()
    var stored: usize = 0
    for name in list(folder)! {
        if not name.ends_with(".mca") {
            continue
        }
        let data = read("{folder}/{name}")!
        for i in 0usize..1024 {
            let entry = usize(data[i * 4]) * 65536 + usize(data[i * 4 + 1]) * 256 + usize(data[i * 4 + 2])
            if entry == 0 {
                continue
            }
            let start = entry * 4096
            let length = usize(data[start]) * 16777216 + usize(data[start + 1]) * 65536 + usize(data[start + 2]) * 256 + usize(data[start + 3])
            if data[start + 4] != 2 {
                continue
            }
            var body = List<u8>()
            body.reserve(length - 1)
            for j in start + 5..start + 4 + length {
                body.push(data[j])
            }
            stored += body.len()
            payloads.push(decompress(body, Format.Zlib, 67108864)!)
        }
    }
    var raw: usize = 0
    for p in payloads {
        raw += p.len()
    }
    println("{payloads.len()} chunks, {raw} bytes raw, {stored} as saved")
    for level in 1u32..7 {
        var total: usize = 0
        let t0 = unsafe { Instant.now() }
        for p in payloads {
            total += compress(p, Format.Zlib, level).len()
        }
        let t1 = unsafe { Instant.now() }
        let us = t1.nanos_since(t0) / 1000 / u64(payloads.len())
        println("level {level}: {total} bytes, {us} us a chunk")
    }
}
