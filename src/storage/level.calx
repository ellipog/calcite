/// A world's `level.dat`: its settings and what's kept with them, read as vanilla reads them as
/// a server starts, by `LevelStorageSource.readDataConfig`, `LevelSettings.parse` and
/// `PrimaryLevelData.parse`, and written as `PrimaryLevelData.createTag` writes them. In 26.3 the
/// rest of what older versions kept there, such as the weather, the game rules, the border and
/// how the world generates, is in the world's `data/` folder. Reading never fails and logs
/// nothing: a field that's missing or can't be read has its default, and one 26.3 doesn't read
/// is dropped.
module storage.level

import java.uuid.{Uuid}
import nbt.tag.{Tag}
import protocol.ids.{DATA_VERSION, game_version}
import resources.identifier.{Identifier}
import server.log.{Entry}
import world.modes.{Difficulty, GameType}
import world.pos.{BlockPos}

/// The version of `level.dat`'s own format, which vanilla writes as `version`.
pub const LEVEL_VERSION: i32 = 19133

/// The `version` of a McRegion world's `level.dat`, from before Anvil, which vanilla doesn't
/// convert.
pub const MCREGION_VERSION: i32 = 19132

/// The feature flags on when `level.dat` doesn't say: only `vanilla`.
pub const VANILLA_FEATURES: u32 = 1

/// The feature flags, vanilla's `FeatureFlags`, in the order they're registered, which is each
/// one's bit in `LevelData.features`.
pub fn feature_names() -> List<String> {
    return ["vanilla", "trade_rebalance", "redstone_experiments", "minecart_improvements"]
}

/// Whether a server opens a world, as vanilla's `Main` decides from the world's summary before
/// it loads it.
pub enum Openable {
    /// It does.
    Yes
    /// It's a McRegion world, which vanilla stops for, logging "This world must be opened in an
    /// older version (like 1.6.4) to be safely converted".
    Old
    /// It's from versions of another series than `main`, which vanilla stops for, logging "This
    /// world was created by an incompatible version."
    Incompatible
}

/// Whether a server opens the world whose `level.dat` holds `data`, as
/// `LevelStorageSource.makeLevelSummary` and `Main` decide: its `version` must be 19133, or
/// McRegion's 19132, else it fails with vanilla's exception, such as
/// `net.minecraft.nbt.NbtFormatException: Unknown data version: 0`, and the `Series` in its
/// `Version` must be `main`, as it is if it isn't a string or isn't there.
pub fn openable(data: JavaHashMap<String, Tag>) -> Openable ! String {
    let format = as_int(data, "version", 0)
    if format != LEVEL_VERSION and format != MCREGION_VERSION {
        fail "net.minecraft.nbt.NbtFormatException: Unknown data version: {java_hex(format)}"
    }
    if format != LEVEL_VERSION {
        return Openable.Old
    }
    if data.contains("Version") {
        match data["Version"] {
            Tag.Compound(version) => {
                if version.contains("Series") {
                    match version["Series"] {
                        Tag.Str(series) => {
                            if series != "main" {
                                return Openable.Incompatible
                            }
                        },
                        _ => {},
                    }
                }
            },
            _ => {},
        }
    }
    return Openable.Yes
}

/// The data version the world was saved in, its `DataVersion`, as `NbtUtils.getDataVersion`
/// reads it: -1 if it isn't there or isn't a number.
pub fn data_version(data: JavaHashMap<String, Tag>) -> i32 {
    return as_int(data, "DataVersion", -1)
}

/// The data version a file in the world was saved in, its `DataVersion`, or `fallback` if it
/// isn't there or isn't a number, as `NbtUtils.getDataVersion` reads it.
pub fn data_version_or(data: JavaHashMap<String, Tag>, fallback: i32) -> i32 {
    return as_int(data, "DataVersion", fallback)
}

/// The warning for the file at `path`, saved in the data version `version`, if that's older
/// than 26.3's: vanilla upgrades such a file as it reads it, and Calcite reads it as it is
/// (D169).
pub fn older_file(path: String, version: i32) -> Entry? {
    if version >= DATA_VERSION {
        return none
    }
    return some(Entry.warn("{path} was saved in data version {version}, older than 26.3's {DATA_VERSION}, and is read as it is, without the upgrade vanilla gives it"))
}

// The number as `Integer.toHexString` writes it: its 32 bits, lowercase, with no zeros first.
fn java_hex(v: i32) -> String {
    let digits = "0123456789abcdef"
    var bits = u32.wrap(v)
    var out = List<u8>()
    loop {
        out.push(digits.byte_at(usize(bits & 15)))
        bits >>= 4
        if bits == 0 {
            break
        }
    }
    var text = String()
    var i = out.len()
    while i > 0 {
        i -= 1
        text.push(rune(out[i]))
    }
    return text
}

/// How hard the world is, vanilla's `LevelSettings.DifficultySettings`.
pub struct DifficultySettings {
    pub difficulty: Difficulty
    pub hardcore: bool
    /// Whether the difficulty can't be changed.
    pub locked: bool
}

/// Where players spawn, vanilla's `LevelData.RespawnData`.
pub struct Spawn {
    pub dimension: Identifier
    pub pos: BlockPos
    /// From -180 to 180.
    pub yaw: f32
    /// From -90 to 90.
    pub pitch: f32
}

/// The data packs on and off, vanilla's `DataPackConfig`, by their IDs, such as `vanilla` and
/// `file/my_pack`.
pub struct DataPacks {
    pub enabled: List<String>
    pub disabled: List<String>
}

/// What `level.dat` holds, its `Data` compound, vanilla's `PrimaryLevelData`.
pub struct LevelData {
    pub name: String
    pub game_type: GameType
    pub difficulty: DifficultySettings
    /// Whether players may use commands without being operators, as in single player.
    pub commands: bool
    /// The game time in ticks.
    pub time: i64
    pub spawn: Spawn
    /// Whether the world's spawn has been chosen.
    pub initialized: bool
    /// The brands of the servers that have run the world, each once, the first first.
    pub brands: List<String>
    /// Whether a server that ran the world said it was modded.
    pub modded: bool
    /// The features of data packs that are gone, which vanilla keeps in a `HashSet` and so writes
    /// in its order.
    pub removed_features: JavaHashSet<String>
    /// The data versions the world was saved in, the oldest first.
    pub history: List<i32>
    /// The player of a single-player world.
    pub player: Uuid?
    /// The data packs, or `none` for vanilla's default of only `vanilla`, which isn't written.
    pub packs: DataPacks?
    /// The feature flags on, a bit for each of `feature_names`.
    pub features: u32
}

impl LevelData {
    /// The level that `data`, the `Data` compound of a `level.dat`, holds.
    pub fn parse(data: JavaHashMap<String, Tag>) -> LevelData {
        let game_type = GameType.by_id(as_int(data, "GameType", 0))
        var removed = JavaHashSet<String>()
        for s in strings_in(data, "removed_features") {
            removed.insert(s.copy())
        }
        var brands = List<String>()
        for s in strings_in(data, "ServerBrands") {
            if not brands.contains(s) {
                brands.push(s.copy())
            }
        }
        var history = List<i32>()
        if data.contains("version_history") {
            if let versions = data["version_history"].ints_or(-1) {
                history = versions
            }
        }
        var player: Uuid? = none
        if data.contains("singleplayer_uuid") {
            if let ints = data["singleplayer_uuid"].int_stream() {
                if ints.len() == 4 {
                    player = some(Uuid.from_ints(ints))
                }
            }
        }
        return LevelData {
            name: string_or_empty(data, "LevelName"),
            game_type: game_type,
            difficulty: read_difficulty(data) ?? DifficultySettings { difficulty: Difficulty.Normal, hardcore: false, locked: false },
            commands: as_bool(data, "allowCommands", game_type == GameType.Creative),
            time: as_long(data, "Time", 0),
            spawn: read_spawn(data) ?? Spawn { dimension: Identifier { namespace: "minecraft", path: "overworld" }, pos: BlockPos { x: 0, y: 0, z: 0 }, yaw: 0.0f32, pitch: 0.0f32 },
            initialized: as_bool(data, "initialized", true),
            brands: brands,
            modded: as_bool(data, "WasModded", false),
            removed_features: removed,
            history: history,
            player: player,
            packs: read_packs(data),
            features: read_features(data),
        }
    }

    /// The `Data` compound of a `level.dat`, saved at `last_played`, in milliseconds since 1970.
    pub fn write(self, last_played: i64) -> Tag {
        var tag = JavaHashMap<String, Tag>()
        tag.insert("ServerBrands", strings_tag(self.brands))
        tag.insert("WasModded", flag(self.modded))
        if not self.removed_features.is_empty() {
            var removed = List<Tag>()
            for s in self.removed_features {
                removed.push(Tag.Str(s.copy()))
            }
            tag.insert("removed_features", Tag.List(removed))
        }
        var version = JavaHashMap<String, Tag>()
        version.insert("Name", Tag.Str(game_version()))
        version.insert("Id", Tag.Int(DATA_VERSION))
        version.insert("Snapshot", flag(false))
        version.insert("Series", Tag.Str("main"))
        tag.insert("Version", Tag.Compound(version))
        var history = List<Tag>()
        for v in self.history {
            history.push(Tag.Int(v))
        }
        if self.history.is_empty() or self.history[self.history.len() - 1] != DATA_VERSION {
            history.push(Tag.Int(DATA_VERSION))
        }
        tag.insert("version_history", Tag.List(history))
        tag.insert("DataVersion", Tag.Int(DATA_VERSION))
        tag.insert("GameType", Tag.Int(self.game_type.id()))
        var spawn = JavaHashMap<String, Tag>()
        spawn.insert("dimension", Tag.Str(self.spawn.dimension.to_string()))
        spawn.insert("pos", Tag.IntArray([self.spawn.pos.x, self.spawn.pos.y, self.spawn.pos.z]))
        spawn.insert("yaw", Tag.float(self.spawn.yaw))
        spawn.insert("pitch", Tag.float(self.spawn.pitch))
        tag.insert("spawn", Tag.Compound(spawn))
        tag.insert("Time", Tag.Long(self.time))
        tag.insert("LastPlayed", Tag.Long(last_played))
        tag.insert("LevelName", Tag.Str(self.name.copy()))
        tag.insert("version", Tag.Int(LEVEL_VERSION))
        tag.insert("allowCommands", flag(self.commands))
        tag.insert("initialized", flag(self.initialized))
        var difficulty = JavaHashMap<String, Tag>()
        difficulty.insert("difficulty", Tag.Str(self.difficulty.difficulty.name()))
        difficulty.insert("hardcore", flag(self.difficulty.hardcore))
        difficulty.insert("locked", flag(self.difficulty.locked))
        tag.insert("difficulty_settings", Tag.Compound(difficulty))
        if let player = self.player {
            tag.insert("singleplayer_uuid", Tag.IntArray(player.ints()))
        }
        if let packs = self.packs {
            var fields = JavaHashMap<String, Tag>()
            fields.insert("Enabled", strings_tag(packs.enabled))
            fields.insert("Disabled", strings_tag(packs.disabled))
            tag.insert("DataPacks", Tag.Compound(fields))
        }
        // Vanilla writes the flags from a `HashSet` of their IDs, so in its order.
        if self.features != VANILLA_FEATURES {
            var ids = JavaHashSet<Identifier>()
            let names = feature_names()
            var bit: u32 = 1
            for name in names {
                if self.features & bit != 0 {
                    ids.insert(Identifier { namespace: "minecraft", path: name.copy() })
                }
                bit = bit << 1
            }
            var features = List<Tag>()
            for id in ids {
                features.push(Tag.Str(id.to_string()))
            }
            tag.insert("enabled_features", Tag.List(features))
        }
        return Tag.Compound(tag)
    }
}

// The difficulty settings as `DifficultySettings.CODEC` reads them, all three fields needed.
fn read_difficulty(data: JavaHashMap<String, Tag>) -> DifficultySettings? {
    if not data.contains("difficulty_settings") {
        return none
    }
    match data["difficulty_settings"] {
        Tag.Compound(fields) => {
            if not fields.contains("difficulty") or not fields.contains("hardcore") or not fields.contains("locked") {
                return none
            }
            var difficulty: Difficulty? = none
            match fields["difficulty"] {
                Tag.Str(name) => difficulty = Difficulty.by_name(name),
                _ => {},
            }
            let d = difficulty else return none
            let hardcore = fields["hardcore"].number_bool() else return none
            let locked = fields["locked"].number_bool() else return none
            return some(DifficultySettings { difficulty: d, hardcore: hardcore, locked: locked })
        },
        _ => return none,
    }
}

// The spawn as `RespawnData.CODEC` reads it: a dimension, a position of three ints and a facing
// in range, all needed.
fn read_spawn(data: JavaHashMap<String, Tag>) -> Spawn? {
    if not data.contains("spawn") {
        return none
    }
    match data["spawn"] {
        Tag.Compound(fields) => {
            if not fields.contains("dimension") or not fields.contains("pos") or not fields.contains("yaw") or not fields.contains("pitch") {
                return none
            }
            var dimension: Identifier? = none
            match fields["dimension"] {
                Tag.Str(name) => match Identifier.parse(name) {
                    ok(id) => dimension = some(id),
                    err(_) => {},
                },
                _ => {},
            }
            let at = dimension else return none
            let pos = fields["pos"].int_stream() else return none
            if pos.len() != 3 {
                return none
            }
            let yaw = fields["yaw"].number_float() else return none
            let pitch = fields["pitch"].number_float() else return none
            // Out of range, or NaN, which Java's `Float.compareTo` puts past every float.
            if not (yaw >= -180.0f32 and yaw <= 180.0f32 and pitch >= -90.0f32 and pitch <= 90.0f32) {
                return none
            }
            return some(Spawn { dimension: at, pos: BlockPos { x: pos[0], y: pos[1], z: pos[2] }, yaw: yaw, pitch: pitch })
        },
        _ => return none,
    }
}

// The data packs as `DataPackConfig.CODEC` reads them, or `none` for the default when they're
// missing or can't be read, as `lenientOptionalFieldOf` gives it.
fn read_packs(data: JavaHashMap<String, Tag>) -> DataPacks? {
    if not data.contains("DataPacks") {
        return none
    }
    match data["DataPacks"] {
        Tag.Compound(fields) => {
            if not fields.contains("Enabled") or not fields.contains("Disabled") {
                return none
            }
            let enabled = string_list(fields["Enabled"]) else return none
            let disabled = string_list(fields["Disabled"]) else return none
            return some(DataPacks { enabled: enabled, disabled: disabled })
        },
        _ => return none,
    }
}

// The feature flags as `FeatureFlagRegistry.codec` reads them, or only `vanilla` when they're
// missing or can't be read, or one isn't a flag.
fn read_features(data: JavaHashMap<String, Tag>) -> u32 {
    if not data.contains("enabled_features") {
        return VANILLA_FEATURES
    }
    let ids = string_list(data["enabled_features"]) else return VANILLA_FEATURES
    let names = feature_names()
    var features: u32 = 0
    for text in ids {
        let id = match Identifier.parse(text) {
            ok(id) => id,
            err(_) => return VANILLA_FEATURES,
        }
        var bit: u32 = 1
        var found = false
        for name in names {
            if id.namespace == "minecraft" and id.path == name {
                features = features | bit
                found = true
            }
            bit = bit << 1
        }
        if not found {
            return VANILLA_FEATURES
        }
    }
    return features
}

// The elements of `tag` as `Codec.STRING.listOf()` reads them: a list or an array whose every
// element is a string, so an array only when it's empty, else `none`.
fn string_list(tag: Tag) -> List<String>? {
    var out = List<String>()
    match tag {
        Tag.List(items) => {
            for t in items {
                match t {
                    Tag.Str(s) => out.push(s.copy()),
                    _ => return none,
                }
            }
        },
        Tag.ByteArray(v) => if not v.is_empty() { return none },
        Tag.IntArray(v) => if not v.is_empty() { return none },
        Tag.LongArray(v) => if not v.is_empty() { return none },
        _ => return none,
    }
    return some(out)
}

// The strings among the elements of the field, as `asStream` and `asString` keep them, or none
// if it isn't a list.
fn strings_in(data: JavaHashMap<String, Tag>, key: String) -> List<String> {
    var out = List<String>()
    if data.contains(key) {
        match data[key] {
            Tag.List(items) => {
                for t in items {
                    match t {
                        Tag.Str(s) => out.push(s.copy()),
                        _ => {},
                    }
                }
            },
            _ => {},
        }
    }
    return out
}

// The field as `Dynamic.asString("")` reads it.
fn string_or_empty(data: JavaHashMap<String, Tag>, key: String) -> String {
    if data.contains(key) {
        match data[key] {
            Tag.Str(s) => return s.copy(),
            _ => {},
        }
    }
    return String()
}

// The field as `Dynamic.asInt(fallback)` reads it.
fn as_int(data: JavaHashMap<String, Tag>, key: String, fallback: i32) -> i32 {
    if data.contains(key) {
        if let v = data[key].number_int() {
            return v
        }
    }
    return fallback
}

// The field as `Dynamic.asLong(fallback)` reads it.
fn as_long(data: JavaHashMap<String, Tag>, key: String, fallback: i64) -> i64 {
    if data.contains(key) {
        if let v = data[key].number_long() {
            return v
        }
    }
    return fallback
}

// The field as `Dynamic.asBoolean(fallback)` reads it.
fn as_bool(data: JavaHashMap<String, Tag>, key: String, fallback: bool) -> bool {
    if data.contains(key) {
        if let v = data[key].number_bool() {
            return v
        }
    }
    return fallback
}

fn flag(v: bool) -> Tag {
    return Tag.Byte(if v { 1 } else { 0 })
}

fn strings_tag(values: List<String>) -> Tag {
    var out = List<Tag>()
    for s in values {
        out.push(Tag.Str(s.copy()))
    }
    return Tag.List(out)
}
