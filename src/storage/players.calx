/// Each player's data in a world, `players/data/<uuid>.dat`, as vanilla's `PlayerDataStorage`
/// keeps it: read with the `.dat_old` fallback, a file that can't be read copied aside as
/// `<uuid>_corrupted_` and the time, and saved through a new file moved over the old with
/// `safe_replace`, the old kept as `.dat_old`, each with vanilla's lines.
module storage.players

import java.uuid.{Uuid}
import nbt.tag.{Accounter, Tag}
import server.log.{Entry}
import std.fs.{Kind, is_file, kind, make_dir_all, metadata, read, remove_dir, set_modified, write}
import std.time.{DateTime}
import storage.level.{data_version_or, older_file}
import storage.world.{WorldFolder, file_date, join, read_compressed, safe_replace, write_temp}

/// A world's `players/data`, vanilla's `PlayerDataStorage`.
pub struct PlayerFiles {
    /// The folder, as Java's `Path` writes it.
    pub folder: String
}

impl PlayerFiles {
    /// The world's `players/data`, made if it's missing, as vanilla makes it as the server
    /// starts, with `mkdirs`, which says nothing if it can't.
    pub fn open(world: WorldFolder) -> PlayerFiles {
        let folder = world.resource("players/data")
        match make_dir_all(folder) {
            ok => {},
            err(_) => {},
        }
        return PlayerFiles { folder: folder }
    }

    /// The data of the player `id`, named `name` in the lines, as `load` reads it as they join:
    /// `<id>.dat`, or if that isn't a file or can't be read, a copy of it kept as
    /// `<id>_corrupted_` and the time `now`, local, and `<id>.dat_old` read instead. `none` for
    /// a player new to the world, or whose files can't be read, who starts afresh. Vanilla then
    /// upgrades data saved in an older version than 26.3, or with no `DataVersion`, which
    /// Calcite reads as it is, with `older_file`'s warning (D169).
    pub fn load(self, id: Uuid, name: String, now: DateTime, lines: mut List<Entry>) -> JavaHashMap<String, Tag>? {
        let uuid = id.to_string()
        if let data = self.load_checked("{uuid}.dat", name, mut lines) {
            return some(data)
        }
        self.backup(uuid, name, now, mut lines)
        return self.load_checked("{uuid}.dat_old", name, mut lines)
    }

    // `load_file`, then `older_file`'s warning for what it read.
    fn load_checked(self, file: String, name: String, lines: mut List<Entry>) -> JavaHashMap<String, Tag>? {
        let data = self.load_file(file, name, mut lines) else return none
        if let line = older_file(join(self.folder, file), data_version_or(data, -1)) {
            lines.push(line)
        }
        return some(data)
    }

    /// Writes the data of the player `id`, named `name` in the lines, as `save` writes it: to a
    /// new file, `<id>-` and a random number then `.dat`, moved over `<id>.dat` with
    /// `safe_replace`, the old one kept as `<id>.dat_old`.
    pub fn save(self, id: Uuid, name: String, data: own Tag, lines: mut List<Entry>) {
        let uuid = id.to_string()
        let temp = match write_temp(self.folder, "{uuid}-", ".dat", data) {
            ok(t) => t,
            err(_) => {
                lines.push(Entry.warn("Failed to save player data for {name}"))
                return
            },
        }
        _ = safe_replace(join(self.folder, "{uuid}.dat"), temp, join(self.folder, "{uuid}.dat_old"), false, mut lines)
    }

    // The file's compound, read with no quota, if it's a file and can be read.
    fn load_file(self, file: String, name: String, lines: mut List<Entry>) -> JavaHashMap<String, Tag>? {
        let path = join(self.folder, file)
        if not is_file(path) {
            return none
        }
        var accounter = Accounter.unlimited()
        return match read_compressed(path, mut accounter) {
            ok(data) => some(data),
            err(_) => {
                lines.push(Entry.warn("Failed to load player data for {name}"))
                none
            },
        }
    }

    // `<uuid>.dat`, if it's a file, copied to `<uuid>_corrupted_` and the time then `.dat`, as
    // `Files.copy` copies it with `REPLACE_EXISTING` and `COPY_ATTRIBUTES`: over a file there, or
    // an empty folder, with its modified time.
    fn backup(self, uuid: String, name: String, now: DateTime, lines: mut List<Entry>) {
        let path = join(self.folder, "{uuid}.dat")
        if not is_file(path) {
            return
        }
        let copy = join(self.folder, "{uuid}_corrupted_{file_date(now)}.dat")
        if not copied(path, copy) {
            lines.push(Entry.warn("Failed to copy the player.dat file for {name}"))
        }
    }
}

// Whether `from` was copied to `to`, with its modified time.
fn copied(from: String, to: String) -> bool {
    let bytes = match read(from) {
        ok(b) => b,
        err(_) => return false,
    }
    let modified = match metadata(from) {
        ok(m) => m.modified,
        err(_) => return false,
    }
    match kind(to) {
        ok(some(Kind.Dir)) => match remove_dir(to) {
            ok => {},
            err(_) => return false,
        },
        _ => {},
    }
    match write(to, bytes) {
        ok => {},
        err(_) => return false,
    }
    return match set_modified(to, modified) {
        ok => true,
        err(_) => false,
    }
}
