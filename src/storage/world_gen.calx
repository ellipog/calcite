/// A world's `data/minecraft/world_gen_settings.dat`, vanilla's `WorldGenSettings`: its seed,
/// whether it generates structures and a bonus chest, and each dimension's generator. 26.3 keeps
/// them here, where older versions kept them in `level.dat`. A server reads them as it opens a
/// world that has a `level.dat`, as `LevelStorageSource.getLevelDataAndDimensions` does, and a
/// new world's are made from server.properties, as `Main.createNewWorldData` makes them. Either
/// way they're saved at the server's first save, as `MinecraftServer` marks them to be (D238).
module storage.world_gen

import nbt.tag.{Accounter, Tag}
import resources.identifier.{Identifier}
import std.fs.{read}
import storage.saved.{SavedFiles}
import storage.world.{WorldFolder, exists, read_gzipped}

/// The saved data's ID, which names its file.
pub fn world_gen_id() -> Identifier {
    return Identifier { namespace: "minecraft", path: "world_gen_settings" }
}

/// What a world generates with, vanilla's `WorldGenSettings`: its `WorldOptions` and its
/// `WorldDimensions`.
pub struct WorldGenSettings {
    pub seed: i64
    /// Whether structures are generated, `generate-structures` for a new world.
    pub structures: bool
    /// Whether a chest is put by the spawn, which a dedicated server's new world has only when
    /// it's started with `--bonusChest`.
    pub bonus_chest: bool
    /// The options of a world customized before 1.13, kept as they were read.
    pub legacy: String?
    /// The dimensions by their IDs, each its type and generator as vanilla's `LevelStem` writes
    /// them: as they were read, or as a new world's preset has them.
    pub dimensions: JavaHashMap<String, Tag>
}

impl WorldGenSettings {
    /// A new world's: `seed`, structures if `structures`, no bonus chest, and the dimensions of
    /// the world preset `level_type` names, as `WorldPreset.createWorldDimensions` makes them: a
    /// flat Overworld with the preset's layers, as vanilla's has when `generator-settings` isn't
    /// a flat world's, or a noise one with the preset's noise settings. A preset Calcite can't
    /// generate is `minecraft:normal`'s, as its chunks are (`noise_settings_of`).
    pub fn new_world(seed: i64, structures: bool, level_type: String) -> WorldGenSettings {
        let id = if level_type.contains(":") { level_type.copy() } else { "minecraft:{level_type}" }
        var dimensions = JavaHashMap<String, Tag>()
        let overworld = if id == "minecraft:flat" {
            flat_generator()
        } else if id == "minecraft:large_biomes" {
            noise_generator("minecraft:large_biomes", multi_noise("minecraft:overworld"))
        } else if id == "minecraft:amplified" {
            noise_generator("minecraft:amplified", multi_noise("minecraft:overworld"))
        } else {
            noise_generator("minecraft:overworld", multi_noise("minecraft:overworld"))
        }
        dimensions.insert("minecraft:overworld", stem("minecraft:overworld", overworld))
        dimensions.insert("minecraft:the_nether", stem("minecraft:the_nether", noise_generator("minecraft:nether", multi_noise("minecraft:nether"))))
        var end_source = JavaHashMap<String, Tag>()
        end_source.insert("type", Tag.Str("minecraft:the_end"))
        dimensions.insert("minecraft:the_end", stem("minecraft:the_end", noise_generator("minecraft:end", Tag.Compound(end_source))))
        return WorldGenSettings { seed: seed, structures: structures, bonus_chest: false, legacy: none, dimensions: dimensions }
    }

    /// The settings `data` holds, the `data` of the file, as `WorldGenSettings.CODEC` reads
    /// them: the seed and the dimensions needed, the two flags `true` and `false` where they're
    /// missing, and the legacy options only where they're a string. Fails with the codec's error
    /// where one that's needed is missing or isn't what it should be. Each dimension's key must
    /// be an ID, and its value a compound; what's in it is kept as it is (D238).
    pub fn parse(data: JavaHashMap<String, Tag>) -> WorldGenSettings ! String {
        if not data.contains("seed") {
            fail "No key seed in MapLike[{Tag.Compound(data.copy()).to_snbt()}]"
        }
        let seed = data["seed"].number_long() else fail "Not a number: {data["seed"].to_snbt()}"
        let structures = try flag_or(data, "generate_structures", true)
        let bonus_chest = try flag_or(data, "bonus_chest", false)
        var legacy: String? = none
        if data.contains("legacy_custom_options") {
            match data["legacy_custom_options"] {
                Tag.Str(s) => legacy = some(s.copy()),
                _ => {},
            }
        }
        if not data.contains("dimensions") {
            fail "No key dimensions in MapLike[{Tag.Compound(data.copy()).to_snbt()}]"
        }
        let dimensions = match data["dimensions"] {
            Tag.Compound(d) => d.copy(),
            other => fail "Not a map: {other.to_snbt()}",
        }
        for (key, value) in dimensions {
            match Identifier.parse(key) {
                ok(_) => {},
                err(e) => fail "Not a valid resource location: {key} {e}",
            }
            match value {
                Tag.Compound(_) => {},
                other => fail "Not a map: {other.to_snbt()}",
            }
        }
        return WorldGenSettings { seed: seed, structures: structures, bonus_chest: bonus_chest, legacy: legacy, dimensions: dimensions }
    }

    /// The `data` of the file, as `WorldGenSettings.CODEC` writes it: both flags always.
    pub fn write(self) -> Tag {
        var tag = JavaHashMap<String, Tag>()
        tag.insert("seed", Tag.Long(self.seed))
        tag.insert("generate_structures", flag(self.structures))
        tag.insert("bonus_chest", flag(self.bonus_chest))
        if let s = self.legacy {
            tag.insert("legacy_custom_options", Tag.Str(s.copy()))
        }
        tag.insert("dimensions", Tag.Compound(self.dimensions.copy()))
        return Tag.Compound(tag)
    }

    /// The world preset the Overworld's generator is, as `level-type` names one: `minecraft:flat`
    /// for a flat generator, `minecraft:large_biomes` or `minecraft:amplified` for a noise one
    /// with those noise settings, and `minecraft:normal` for any other, which Calcite generates
    /// as the normal one, as it does a `level-type` it can't generate.
    pub fn overworld_type(self) -> String {
        if not self.dimensions.contains("minecraft:overworld") {
            return String("minecraft:normal")
        }
        let generator = match self.dimensions["minecraft:overworld"] {
            Tag.Compound(fields) => if fields.contains("generator") { fields["generator"].copy() } else { return String("minecraft:normal") },
            _ => return String("minecraft:normal"),
        }
        let fields = match generator {
            Tag.Compound(f) => f,
            _ => return String("minecraft:normal"),
        }
        let kind = string_of(fields, "type") ?? String()
        if kind == "minecraft:flat" {
            return String("minecraft:flat")
        }
        if kind == "minecraft:noise" {
            let settings = string_of(fields, "settings") ?? String()
            if settings == "minecraft:large_biomes" or settings == "minecraft:amplified" {
                return settings
            }
        }
        return String("minecraft:normal")
    }
}

/// The file's root, as `readExistingSavedData` reads it as the server starts: gzipped, with no
/// quota and no upgrade. Fails with the message of what Java throws: for a missing file, its
/// path, as `NoSuchFileException` has it.
pub fn read_world_gen(world: WorldFolder) -> JavaHashMap<String, Tag> ! String {
    let path = try SavedFiles.world(world).file(world_gen_id())
    if not exists(path) {
        fail path
    }
    let bytes = match read(path) {
        ok(b) => b,
        err(_) => fail path,
    }
    var accounter = Accounter.unlimited()
    return match read_gzipped(bytes, mut accounter) {
        ok(tags) => tags,
        // Without the exception's class, as `getMessage` gives it.
        err(e) => fail message_of(e),
    }
}

// `Exception: message` without the exception.
fn message_of(e: String) -> String {
    for i in 0..e.len() {
        if e.byte_at(i) == 58 and i + 1 < e.len() and e.byte_at(i + 1) == 32 {
            return e[i + 2..]
        }
    }
    return e.copy()
}

// A flag as `optionalAlwaysPresentFieldOf(Codec.BOOL, ...)` reads it: `default` where it's
// missing, and an error where it isn't a number.
fn flag_or(data: JavaHashMap<String, Tag>, key: String, default: bool) -> bool ! String {
    if not data.contains(key) {
        return default
    }
    let v = data[key].number_bool() else fail "Not a number: {data[key].to_snbt()}"
    return v
}

fn string_of(fields: JavaHashMap<String, Tag>, key: String) -> String? {
    if not fields.contains(key) {
        return none
    }
    return match fields[key] {
        Tag.Str(s) => some(s.copy()),
        _ => none,
    }
}

// A dimension, its type and generator.
fn stem(dimension_type: String, generator: own Tag) -> Tag {
    var tag = JavaHashMap<String, Tag>()
    tag.insert("type", Tag.Str(dimension_type.copy()))
    tag.insert("generator", generator)
    return Tag.Compound(tag)
}

// A noise generator with the noise settings `settings` and the biome source `source`.
fn noise_generator(settings: String, source: own Tag) -> Tag {
    var tag = JavaHashMap<String, Tag>()
    tag.insert("type", Tag.Str("minecraft:noise"))
    tag.insert("settings", Tag.Str(settings.copy()))
    tag.insert("biome_source", source)
    return Tag.Compound(tag)
}

// A multi-noise biome source with the parameters of the preset `preset`.
fn multi_noise(preset: String) -> Tag {
    var tag = JavaHashMap<String, Tag>()
    tag.insert("type", Tag.Str("minecraft:multi_noise"))
    tag.insert("preset", Tag.Str(preset.copy()))
    return Tag.Compound(tag)
}

// The flat preset's generator, as `FlatLevelGeneratorSettings.getDefault` makes its settings:
// a block of bedrock, two of dirt and one of grass, in plains, with strongholds and villages, and
// no lakes or features.
fn flat_generator() -> Tag {
    var layers = List<Tag>()
    for (block, height) in [("minecraft:bedrock", 1), ("minecraft:dirt", 2), ("minecraft:grass_block", 1)] {
        var layer = JavaHashMap<String, Tag>()
        layer.insert("block", Tag.Str(String(block)))
        layer.insert("height", Tag.Int(height))
        layers.push(Tag.Compound(layer))
    }
    var settings = JavaHashMap<String, Tag>()
    settings.insert("layers", Tag.List(layers))
    settings.insert("biome", Tag.Str("minecraft:plains"))
    settings.insert("structure_overrides", Tag.List([Tag.Str("minecraft:strongholds"), Tag.Str("minecraft:villages")]))
    settings.insert("lakes", flag(false))
    settings.insert("features", flag(false))
    var tag = JavaHashMap<String, Tag>()
    tag.insert("type", Tag.Str("minecraft:flat"))
    tag.insert("settings", Tag.Compound(settings))
    return Tag.Compound(tag)
}

fn flag(v: bool) -> Tag {
    return Tag.Byte(if v { 1 } else { 0 })
}
