/// Players' advancements and statistics, the JSON files of `players/advancements` and
/// `players/stats`, as vanilla's `PlayerAdvancements` and `ServerStatsCounter` keep them: each
/// player's in `<uuid>.json`, read as `StrictJsonParser` reads it (`json.strict`) and written
/// pretty, as vanilla's Gson writes it (`json.gson`), each with vanilla's lines. Statistics
/// kept under a player's name, as they were before 1.7.6, are moved to their UUID's file as
/// vanilla moves them.
///
/// What's in a file is for the advancements' and statistics' codecs to read, which come with
/// them (P6.5). Vanilla upgrades a file saved by an older version as it reads it, which Calcite
/// doesn't: it reads it as it is, with a warning (D169, D170).
module storage.progress

import json.gson.{int_value, pretty}
import json.strict.{Unread, parse_strict}
import json.tree.{Json, Member}
import protocol.ids.{DATA_VERSION}
import server.log.{Entry}
import std.fs.{is_file, kind, make_dir_all, read, rename, separator, write}
import storage.level.{older_file}
import storage.world.{WorldFolder, exists, join}

/// What a folder of progress files keeps.
pub enum Kind {
    Advancements
    Stats
}

/// The data version vanilla reads a file as when it says none, its first with `DataVersion`.
const NO_VERSION: i32 = 1343

/// A folder of players' progress files.
pub struct ProgressFiles {
    pub kind: Kind
    /// The folder, as Java's `Path` writes it.
    pub folder: String
}

impl ProgressFiles {
    /// The world's advancements, `players/advancements`, which isn't made until one's saved.
    pub fn advancements(world: WorldFolder) -> ProgressFiles {
        return ProgressFiles { kind: Kind.Advancements, folder: world.resource("players/advancements") }
    }

    /// The world's statistics, `players/stats`, which isn't made until some are saved.
    pub fn stats(world: WorldFolder) -> ProgressFiles {
        return ProgressFiles { kind: Kind.Stats, folder: world.resource("players/stats") }
    }

    /// The folder `folder`, as it's given, keeping what `what` says.
    pub fn at(what: Kind, folder: String) -> ProgressFiles {
        return ProgressFiles { kind: what, folder: folder.copy() }
    }

    /// The file of the player with the UUID `uuid`, in its usual form: `<uuid>.json` in the
    /// folder.
    pub fn file(self, uuid: String) -> String {
        return join(self.folder, "{uuid}.json")
    }

    /// The file a player's statistics are read from and saved to, as `locateStatsFile` finds
    /// it: their UUID's if there's anything there, else one under their name, if that makes a
    /// name vanilla takes for a file (only lowercase letters, digits and `-._`) and it's a file,
    /// moved to the UUID's. If it can't be moved, the one under the name is kept to, with
    /// vanilla's warning. Otherwise the UUID's, which isn't there yet.
    pub fn locate(self, uuid: String, name: String, lines: mut List<Entry>) -> String {
        let uuid_file = self.file(uuid)
        if exists(uuid_file) {
            return uuid_file
        }
        let name_file = "{name}.json"
        if not valid_segment(name_file) {
            return uuid_file
        }
        let name_path = join(self.folder, name_file)
        if not is_file(name_path) {
            return uuid_file
        }
        // `Files.move` won't replace what's there, which can only be a link to nothing, since
        // `exists` follows links.
        let taken = match kind(uuid_file) {
            ok(some(_)) => true,
            _ => false,
        }
        if not taken {
            match rename(name_path, uuid_file) {
                ok => return uuid_file,
                err(_) => {},
            }
        }
        lines.push(Entry.warn("Failed to copy file {name_file} to {uuid_file}"))
        return name_path
    }

    /// The JSON in the file at `path`, as vanilla reads it before its codec does: `none` if
    /// it's not a regular file, following links, or if it can't be read, with vanilla's error
    /// for that, for which advancements tell bytes that aren't UTF-8 from text that isn't JSON
    /// and statistics tell neither from a file that can't be opened. A file that's empty, or
    /// only white space, is `null`.
    pub fn read_json(self, path: String, lines: mut List<Entry>) -> Json? {
        if not is_file(path) {
            return none
        }
        let bytes = match read(path) {
            ok(b) => b,
            err(_) => {
                lines.push(self.unread(path, false))
                return none
            },
        }
        return match parse_strict(bytes) {
            ok(json) => some(json),
            err(Unread.Io) => {
                lines.push(self.unread(path, self.kind == Kind.Stats))
                none
            },
            err(Unread.Syntax) => {
                lines.push(self.unread(path, true))
                none
            },
        }
    }

    /// The JSON in the file at `path`, as `read_json` reads it, with Calcite's warning for an
    /// object saved in an older version than 26.3, or with no `DataVersion`, or one vanilla
    /// throws for (`version_of`), all of which it reads as they are.
    pub fn load(self, path: String, lines: mut List<Entry>) -> Json? {
        let json = self.read_json(path, mut lines) else return none
        if is_object(json) {
            match version_of(json) {
                some(v) => {
                    if let line = older_file(path, v) {
                        lines.push(line)
                    }
                },
                none => lines.push(Entry.warn("{path} has a DataVersion vanilla can't read as an int, and is read as it is")),
            }
        }
        return some(json)
    }

    /// Writes `members` as the file at `path`, as a save writes it: for advancements, the
    /// members with 26.3's `DataVersion` put in, after them or where one already is; for
    /// statistics, an object with the members as its `stats` and the `DataVersion` after.
    /// Pretty, as vanilla's Gson writes it, over the file, once its folders are made. If that
    /// can't be done, vanilla's error is logged.
    pub fn save(self, path: String, members: own List<Member>, lines: mut List<Entry>) {
        let version = Json.Number("{DATA_VERSION}")
        var root = List<Member>()
        if self.kind == Kind.Stats {
            root.push(Member { key: String("stats"), value: Json.Object(members) })
            root.push(Member { key: String("DataVersion"), value: version })
        } else {
            root = members
            var found = false
            for i in 0..root.len() {
                if root[i].key == "DataVersion" {
                    root[i].value = version.copy()
                    found = true
                }
            }
            if not found {
                root.push(Member { key: String("DataVersion"), value: version })
            }
        }
        let text = pretty(Json.Object(root))
        let failed = match make_dir_all(parent(path)) {
            ok => match write(path, text.to_bytes()) {
                ok => false,
                err(_) => true,
            },
            err(_) => true,
        }
        if failed {
            lines.push(match self.kind {
                Kind.Advancements => Entry.error("Couldn't save player advancements to {path}"),
                Kind.Stats => Entry.error("Couldn't save stats to {path}"),
            })
        }
    }

    // Vanilla's error for a file that can't be read: for advancements, one it can't get at,
    // or, `parsed`, one that isn't JSON; for statistics, one it can't open, or, `parsed`, one
    // it can't read JSON from.
    fn unread(self, path: String, parsed: bool) -> Entry {
        return match self.kind {
            Kind.Advancements => if parsed {
                Entry.error("Couldn't parse player advancements in {path}")
            } else {
                Entry.error("Couldn't access player advancements in {path}")
            },
            Kind.Stats => if parsed {
                Entry.error("Couldn't parse statistics file {path}")
            } else {
                Entry.error("Couldn't read statistics file {path}")
            },
        }
    }
}

/// The data version a progress file was saved in, as vanilla reads it: an object's last
/// `DataVersion`, if it's a number, as Gson reads an `int` from one, and otherwise, or for
/// anything but an object, 1343, as for `true`. `none` for a number Gson throws for, such as
/// `1e10000`, which vanilla doesn't catch.
pub fn version_of(json: Json) -> i32? {
    return match json {
        Json.Object(members) => version_in(members),
        _ => some(NO_VERSION),
    }
}

// The data version of an object with these members.
fn version_in(members: List<Member>) -> i32? {
    var i = members.len()
    while i > 0 {
        i -= 1
        if members[i].key == "DataVersion" {
            return match members[i].value {
                Json.Number(t) => int_value(t),
                _ => some(NO_VERSION),
            }
        }
    }
    return some(NO_VERSION)
}

// Whether `segment` is a name vanilla's `isValidPathSegment` takes: of lowercase letters,
// digits, `-`, `.` and `_` only, and neither `.` nor `..`.
fn valid_segment(segment: String) -> bool {
    if segment.is_empty() or segment == "." or segment == ".." {
        return false
    }
    for i in 0..segment.len() {
        let b = segment.byte_at(i)
        let allowed = (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 45 or b == 46 or b == 95
        if not allowed {
            return false
        }
    }
    return true
}

fn is_object(json: Json) -> bool {
    return match json {
        Json.Object(_) => true,
        _ => false,
    }
}

// The folder `path` is in: all of it before its last separator.
fn parent(path: String) -> String {
    let sep = separator().byte_at(0)
    var i = path.len()
    while i > 0 and path.byte_at(i - 1) != sep {
        i -= 1
    }
    if i == 0 {
        return String(".")
    }
    return path[..i - 1]
}
