/// Entity chunks as vanilla 26.3 saves them in a world's `entities` folder: the NBT
/// `EntityStorage` reads in `loadEntities` and writes in `storeEntities`, each chunk's entities
/// apart from its blocks. This is the NBT alone; finding a chunk in its region file, and keeping
/// the set of chunks known to have no entities, come with the server's world.
///
/// Reading is as lenient as vanilla's: a chunk whose `Position` is wrong or can't be read is
/// still read, with vanilla's lines, and an element of `Entities` that isn't a compound is left
/// out, reported as vanilla's `ProblemReporter` reports it.
module storage.entities

import nbt.tag.{Tag}
import protocol.ids.{DATA_VERSION}
import server.log.{Entry}
import storage.chunk.{field_error}
import storage.level.{data_version_or, older_file}
import storage.problems.{Problems, Step}
import world.pos.{ChunkPos}

/// The logger vanilla's lines about entity chunks come from, whose name `ScopedCollector`'s
/// warning quotes.
pub fn logger() -> String {
    return String("net.minecraft.world.level.chunk.storage.EntityStorage")
}

/// What the chunk's `Position` says of where it is.
pub enum Placed {
    /// Where it's read from.
    Right
    /// Elsewhere, which vanilla logs and reports with `reportMisplacedChunk`.
    Misplaced(ChunkPos)
    /// Nothing that can be read, which vanilla logs and reports with `reportChunkLoadFailure`.
    Unreadable
}

/// An entity as it's saved, with the reporter vanilla reads it with: one of its own, for the
/// element of `Entities` it is, unless it's empty, which vanilla reads with none.
pub struct SavedEntity {
    pub tag: JavaHashMap<String, Tag>
    pub reporter: usize?
}

/// An entity chunk as `loadEntities` reads it, before its entities are made.
pub struct EntityChunk {
    pub pos: ChunkPos
    pub placed: Placed
    pub entities: List<SavedEntity>
    /// The problems met reading it, under `chunk@[x, z]`, which reading the entities adds to
    /// and which are logged, on `logger()`, when that's done.
    pub problems: Problems
}

impl EntityChunk {
    /// The entity chunk `root` holds, read from the place `pos` as vanilla reads it, with what
    /// it logs on the way added to `lines`: `Position`'s, then the warning for a chunk older
    /// than 26.3's, which vanilla upgrades and Calcite reads as it is (D169).
    pub fn read(pos: ChunkPos, root: own JavaHashMap<String, Tag>, lines: mut List<Entry>) -> EntityChunk {
    var tags = root
    let placed = position(pos, tags, mut lines)
    if let line = older_file("Entity chunk [{pos.x}, {pos.z}]", data_version_or(tags, -1)) {
        lines.push(line)
    }
    var problems = Problems.new(Step.Chunk(pos))
    var entities = List<SavedEntity>()
    match tags.remove("Entities") {
        none => {},
        some(Tag.List(items)) => {
            var rest = reversed(items)
            var i: i32 = 0
            while let item = rest.pop() {
                match item {
                    Tag.Compound(fields) => {
                        if fields.is_empty() {
                            entities.push(SavedEntity { tag: fields, reporter: none })
                        } else {
                            let reporter = problems.child(0, Step.IndexedField { name: String("Entities"), index: i })
                            entities.push(SavedEntity { tag: fields, reporter: some(reporter) })
                        }
                    },
                    other => problems.report(0, "Expected list 'Entities' to contain at index {i} value of type COMPOUND, but got {other.type_name()}"),
                }
                i += 1
            }
        },
        some(other) => problems.report(0, "Expected field 'Entities' to contain value of type LIST, but got {other.type_name()}"),
    }
    return EntityChunk { pos: pos, placed: placed, entities: entities, problems: problems }
}
}

/// The NBT `storeEntities` saves for the chunk at `pos` with the saved `entities`, or `none`
/// for a chunk with no entities, whose file vanilla clears.
pub fn write_entities(pos: ChunkPos, entities: own List<Tag>?) -> Tag? {
    let list = entities else return none
    var root = JavaHashMap<String, Tag>()
    root.insert("DataVersion", Tag.Int(DATA_VERSION))
    root.insert("Entities", Tag.List(list))
    root.insert("Position", Tag.IntArray([pos.x, pos.z]))
    return some(Tag.Compound(root))
}

// Where the chunk's `Position` says it is, as `loadEntities` reads it with `ChunkPos.CODEC`,
// with the lines that logs.
fn position(pos: ChunkPos, tags: JavaHashMap<String, Tag>, lines: mut List<Entry>) -> Placed {
    var stored: ChunkPos? = none
    if tags.contains("Position") {
        var error: String? = none
        let ints = tags["Position"].fixed_ints(2, mut error)
        if let message = error {
            lines.push(Entry.error(field_error("Position", tags["Position"], message)))
        }
        if let xz = ints {
            stored = some(ChunkPos { x: xz[0], z: xz[1] })
        }
    }
    let at = stored else {
        lines.push(Entry.warn("Failed to parse chunk [{pos.x}, {pos.z}] position info"))
        return Placed.Unreadable
    }
    if at.x == pos.x and at.z == pos.z {
        return Placed.Right
    }
    lines.push(Entry.error("Chunk file at [{pos.x}, {pos.z}] is in the wrong location. (Expected [{pos.x}, {pos.z}], got [{at.x}, {at.z}])"))
    return Placed.Misplaced(at)
}

// The list's elements, last first, to pop in order.
fn reversed(items: own List<Tag>) -> List<Tag> {
    var rest = items
    var out = List<Tag>()
    while let item = rest.pop() {
        out.push(item)
    }
    return out
}
