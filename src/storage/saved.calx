/// Saved data, the files of a `data` folder, as vanilla's `SavedDataStorage` keeps them: each
/// type's in `<namespace>/<path>.dat`, such as `data/minecraft/raids.dat`, holding its `data`
/// and the `DataVersion` it was saved at, gzipped or not, each with vanilla's lines.
///
/// The world's own `data` holds the scoreboard, command storage, maps, random sequences, the
/// weather, the game rules and the like, and each dimension's holds its chunk tickets and
/// raids. What's in `data` is each type's to read, with its codec. Vanilla upgrades a file saved
/// by an older version as it reads it, which Calcite doesn't: it reads it as it is, with a
/// warning (D169).
module storage.saved

import nbt.tag.{Accounter, Tag, read_unnamed}
import protocol.ids.{DATA_VERSION}
import resources.identifier.{Identifier}
import server.log.{Entry}
import std.fs.{make_dir_all, read, separator}
import storage.level.{data_version_or, older_file}
import storage.world.{WorldFolder, exists, join, read_gzipped, write_compressed}

/// A folder of saved data, vanilla's `SavedDataStorage`.
pub struct SavedFiles {
    /// The folder, as Java's `Path` writes it.
    pub folder: String
}

impl SavedFiles {
    /// The world's own, `data`, which isn't made until something's saved in it.
    pub fn world(world: WorldFolder) -> SavedFiles {
        return SavedFiles { folder: world.resource("data") }
    }

    /// A dimension's, `data` in its folder, made as the dimension's chunk cache makes it as the
    /// server starts, logging vanilla's error if it can't be.
    pub fn dimension(world: WorldFolder, id: Identifier, lines: mut List<Entry>) -> SavedFiles {
        let folder = join(world.dimension(id), "data")
        match make_dir_all(folder) {
            ok => {},
            err(_) => lines.push(Entry.error("Failed to create dimension data storage directory")),
        }
        return SavedFiles { folder: folder }
    }

    /// The folder `folder`, as it's given.
    pub fn at(folder: String) -> SavedFiles {
        return SavedFiles { folder: folder.copy() }
    }

    /// The file of the saved data `id`, `<namespace>/<path>.dat` in the folder, as
    /// `getDataFile` finds it. Fails with the exception vanilla throws for a path whose `..`
    /// leaves the folder.
    pub fn file(self, id: Identifier) -> String ! String {
        let path = join(self.folder, "{id.namespace}/{id.path}.dat")
        let normal_path = normal(path)
        let normal_root = normal(self.folder)
        if not inside(normal_path, normal_root) {
            fail "java.lang.IllegalStateException: Identifier \"{id.to_string()}.dat\" tried to access path \"{normal_path}\" from root \"{normal_root}\""
        }
        return path
    }

    /// What's saved for `id`, its `data` and the `DataVersion` it was saved at, as `get` reads
    /// it the first time a type is asked for: gzipped or not, as the file's first two bytes
    /// say, and with no quota. `none` if there's no file, or if it can't be read, which vanilla
    /// logs, and either way the type starts afresh. One saved in an older version than 26.3,
    /// or with no `DataVersion`, which vanilla reads as 1343's, is read as it is, with
    /// `older_file`'s warning.
    pub fn load(self, id: Identifier, lines: mut List<Entry>) -> JavaHashMap<String, Tag>? {
        let path = match self.file(id) {
            ok(p) => p,
            err(_) => {
                lines.push(Entry.error("Error loading saved data: {described(id)}"))
                return none
            },
        }
        if not exists(path) {
            return none
        }
        return match read_tag(path) {
            ok(tags) => {
                if let line = older_file(path, data_version_or(tags, 1343)) {
                    lines.push(line)
                }
                some(tags)
            },
            err(_) => {
                lines.push(Entry.error("Error loading saved data: {described(id)}"))
                none
            },
        }
    }

    /// Writes `data` as what's saved for `id`, with 26.3's `DataVersion`, as a save writes a
    /// type that's changed: its folders made, then gzipped over the file, not through another
    /// file as a player's or `level.dat` is. If that can't be done, vanilla's error is logged,
    /// which it logs on one of its IO threads. Fails as `file` does, an exception vanilla
    /// throws out of its save.
    pub fn save(self, id: Identifier, data: own Tag, lines: mut List<Entry>) ! String {
        let path = try self.file(id)
        var root = JavaHashMap<String, Tag>()
        root.insert(String("data"), data)
        root.insert(String("DataVersion"), Tag.Int(DATA_VERSION))
        let name = last_name(path)
        let folder = path[..path.len() - name.len() - 1]
        match make_dir_all(folder) {
            ok => {},
            err(_) => {
                lines.push(Entry.error("Could not save data to {name}"))
                return
            },
        }
        match write_compressed(Tag.Compound(root), path) {
            ok => {},
            err(_) => lines.push(Entry.error("Could not save data to {name}")),
        }
    }
}

/// The error vanilla logs when the codec of the saved data `id` can't read its `data`, with
/// the codec's message, after which the type starts afresh.
pub fn parse_failed(id: Identifier, error: String) -> Entry {
    return Entry.error("Failed to parse saved data for '{described(id)}': {error}")
}

// A saved data type as vanilla's `SavedDataType` writes itself.
fn described(id: Identifier) -> String {
    return "SavedDataType[{id.to_string()}]"
}

// The compound in the file at `path`, as `readTagFromDisk` reads it: gzipped if it starts with
// gzip's two bytes, else plain, and with no quota.
fn read_tag(path: String) -> JavaHashMap<String, Tag> ! String {
    let bytes = match read(path) {
        ok(b) => b,
        err(_) => {
            fail String("java.io.IOException: the file can't be read")
        },
    }
    var accounter = Accounter.unlimited()
    if bytes.len() >= 2 and bytes[0] == 31 and bytes[1] == 139 {
        return try read_gzipped(bytes, mut accounter)
    }
    if bytes.is_empty() {
        // Java's `PushbackInputStream` throws, given back the -1 an empty file reads.
        fail String("java.lang.ArrayIndexOutOfBoundsException")
    }
    var at: usize = 0
    return match read_unnamed(bytes, mut at, mut accounter) {
        ok(Tag.Compound(tags)) => tags,
        ok(_) => {
            fail String("java.io.IOException: Root tag must be a named compound tag")
        },
        err(e) => {
            fail "{e.exception}: {e.message}"
        },
    }
}

// The last name in `path`, after its last separator.
fn last_name(path: String) -> String {
    let sep = separator().byte_at(0)
    var i = path.len()
    while i > 0 and path.byte_at(i - 1) != sep {
        i -= 1
    }
    return path[i..]
}

// `path` as Java's `Path.normalize` writes it: without `.` names, each `..` taking the name
// before it away, and kept at the start of a relative path with none before it.
fn normal(path: String) -> String {
    let sep = separator()
    let s = sep.byte_at(0)
    var root = String()
    var start: usize = 0
    if path.len() > 2 and path.byte_at(1) == 58 and path.byte_at(2) == s {
        root = path[..3]
        start = 3
    } else if path.len() > 0 and path.byte_at(0) == s {
        root = sep.copy()
        start = 1
    }
    var names = List<String>()
    var i = start
    while i <= path.len() {
        if i == path.len() or path.byte_at(i) == s {
            let name = path[start..i]
            if name.is_empty() or name == "." {
                // Nothing.
            } else if name == ".." {
                if names.len() > 0 and names[names.len() - 1] != ".." {
                    _ = names.pop()
                } else if root.is_empty() {
                    names.push(name)
                }
            } else {
                names.push(name)
            }
            start = i + 1
        }
        i += 1
    }
    var out = root
    for k in 0..names.len() {
        if k > 0 {
            out.push_str(sep)
        }
        out.push_str(names[k])
    }
    return out
}

// Whether `path` is `root` or in it, name by name, as `Path.startsWith` says.
fn inside(path: String, root: String) -> bool {
    if root.is_empty() {
        return true
    }
    if not path.starts_with(root) {
        return false
    }
    if path.len() == root.len() {
        return true
    }
    let s = separator().byte_at(0)
    return root.byte_at(root.len() - 1) == s or path.byte_at(root.len()) == s
}
