/// Problems met reading or writing a save, as vanilla's `ProblemReporter.Collector` keeps them:
/// each reported at a place in what's read, such as an element of a list, kept once each in the
/// order they came, and written out as `getTreeReport` writes them, which `ScopedCollector` logs
/// when what's read is done.
module storage.problems

import server.log.{Entry}
import world.pos.{ChunkPos}

/// A step on the way to where a problem is, vanilla's `ProblemReporter.PathElement`.
pub enum Step {
    /// Nothing, the root of a collector made without one, `Collector.EMPTY_ROOT`.
    Empty
    /// `chunk@[x, z]`, a chunk, `ChunkAccess.problemPath`.
    Chunk(ChunkPos)
    /// A name of its own, `RootFieldPathElement`.
    Root(String)
    /// `.name`, a field, `FieldPathElement`.
    Field(String)
    /// `.name[i]`, an element of a list in a field, `IndexedFieldPathElement`.
    IndexedField { name: String, index: i32 }
    /// `[i]`, an element of a list, `IndexedPathElement`.
    Indexed(i32)
    /// `.name[key]`, an entry of a map in a field, `MapEntryPathElement`.
    MapEntry { name: String, key: String }
}

impl Step {
    /// The step as vanilla's `get` writes it.
    pub fn text(self) -> String {
        return match self {
            Step.Empty => String(),
            Step.Chunk(pos) => "chunk@[{pos.x}, {pos.z}]",
            Step.Root(name) => name.copy(),
            Step.Field(name) => ".{name}",
            Step.IndexedField { name, index } => ".{name}[{index}]",
            Step.Indexed(index) => "[{index}]",
            Step.MapEntry { name, key } => ".{name}[{key}]",
        }
    }
}

/// The problems of one read or write, under the step it starts from: vanilla's root collector
/// and each reporter made from it with `forChild`, which are numbers here, the root 0.
pub struct Problems {
    // Each reporter's step and the reporter it was made from, the root first.
    steps: List<Step>
    parents: List<usize>
    // Each problem reported, once for each reporter, as vanilla's `LinkedHashSet` keeps them:
    // by the reporter and the problem, here by what it says, as the records of vanilla's
    // problems so far are equal when what they say is.
    reported: List<Reported>
    seen: Set<String>
}

// A problem, by the reporter it was reported to, and what vanilla's `description` says of it.
struct Reported {
    at: usize
    description: String
}

// A node of the report's tree: its step, the problems at it, and its children, in the order the
// problems met them.
struct Node {
    step: Step
    problems: List<String>
    children: List<usize>
}

impl Problems {
    /// No problems yet, under `root`.
    pub fn new(root: own Step) -> Problems {
        return Problems { steps: [root], parents: [0], reported: List<Reported>(), seen: Set<String>() }
    }

    /// A reporter for `step` under the reporter `at`, as `forChild` makes one.
    pub fn child(mut self, at: usize, step: own Step) -> usize {
        self.steps.push(step)
        self.parents.push(at)
        return self.steps.len() - 1
    }

    /// Reports the problem `description` to the reporter `at`, unless it's already reported
    /// there, as `report` adds it to its set.
    pub fn report(mut self, at: usize, description: own String) {
        let key = "{at}:{description}"
        if self.seen.contains(key) {
            return
        }
        self.seen.insert(key)
        self.reported.push(Reported { at: at, description: description })
    }

    /// Whether nothing was reported.
    pub fn is_empty(self) -> bool {
        return self.reported.is_empty()
    }

    /// The problems as `getTreeReport` writes them: each step on the way to them once, its
    /// problems under it, two spaces in, and a step with nothing but one child or one problem
    /// on one line with it.
    pub fn tree(self) -> String {
        var nodes: List<Node> = [Node { step: self.steps[0].copy(), problems: List<String>(), children: List<usize>() }]
        for r in self.reported {
            var path = List<usize>()
            var current = r.at
            while current != 0 {
                path.push(current)
                current = self.parents[current]
            }
            var node: usize = 0
            var i = path.len()
            while i > 0 {
                i -= 1
                node = child_node(mut nodes, node, self.steps[path[i]])
            }
            nodes[node].problems.push(r.description.copy())
        }
        var out = String()
        let lines = node_lines(nodes, 0)
        for i in 0..lines.len() {
            if i > 0 {
                out.push('\n')
            }
            out.push_str(lines[i])
        }
        return out
    }

    /// What `ScopedCollector.close` logs, on the logger `logger`, if anything was reported.
    pub fn close(self, logger: String) -> Entry? {
        if self.is_empty() {
            return none
        }
        return some(Entry.warn("[{logger}] Serialization errors:\n{self.tree()}"))
    }
}

// The child of `nodes[at]` for `step`, made if it isn't there, as `ProblemTreeNode.child` does:
// the steps are equal as vanilla's records are, of one kind with the same fields.
fn child_node(nodes: mut List<Node>, at: usize, step: Step) -> usize {
    for c in nodes[at].children {
        if nodes[c].step == step {
            return c
        }
    }
    nodes.push(Node { step: step.copy(), problems: List<String>(), children: List<usize>() })
    let made = nodes.len() - 1
    nodes[at].children.push(made)
    return made
}

// The lines of `nodes[at]`, as `ProblemTreeNode.getLines` writes them.
fn node_lines(nodes: List<Node>, at: usize) -> List<String> {
    let problems = nodes[at].problems.len()
    let children = nodes[at].children.len()
    if problems == 0 and children == 0 {
        return List<String>()
    }
    let text = nodes[at].step.text()
    if problems == 0 and children == 1 {
        var lines = node_lines(nodes, nodes[at].children[0])
        lines[0] = "{text}{lines[0]}"
        return lines
    }
    if problems == 1 and children == 0 {
        return ["{text}: {nodes[at].problems[0]}"]
    }
    var lines: List<String> = ["{text}:"]
    for c in nodes[at].children {
        for line in node_lines(nodes, c) {
            lines.push("  {line}")
        }
    }
    for p in nodes[at].problems {
        lines.push("  {p}")
    }
    return lines
}
