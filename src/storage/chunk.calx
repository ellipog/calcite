/// Chunks as vanilla 26.3 saves them in region files: the NBT of `SerializableChunkData`, read
/// as its `parse` reads it and written as its `write` writes it, so a chunk read and saved again
/// comes out as vanilla's would.
///
/// Reading is as lenient as vanilla's. A field that's missing or of the wrong type takes its
/// default, a palette entry that isn't a block or a biome becomes air or plains, and a list keeps
/// the elements that can be read, each problem logged with vanilla's line. What vanilla can't
/// read it throws, and so does this, with the same exception and message: `ChunkReadException`
/// for a container with no palette or whose data doesn't fit it, `IllegalArgumentException` for
/// light that isn't 2,048 bytes, and `MissingPaletteEntryException` or `IllegalStateException`
/// for a value past its palette's end, found as late as vanilla finds it, which for a section's
/// biomes is when the chunk is written.
module storage.chunk

import nbt.tag.{Accounter, Tag, put_byte_array_entry, put_byte_entry, put_end, put_entry, put_int_entry, put_key, put_list_head, put_long_array_entry, put_long_entry, put_short, read_unnamed}
import protocol.ids.{DATA_VERSION}
import registry.names.{Names}
import registry.registries.{Registries}
import server.log.{Entry}
import std.palette.{BitStorage, Error, Packed, PalettedContainer, Strategy}
import world.beacon.{loaded_beacon}
import world.blocks.{STATE_COUNT}
import world.chunk.{AIR_STATE, Chunk, MOTION_BLOCKING, MOTION_BLOCKING_NO_LEAVES, OCEAN_FLOOR, WORLD_SURFACE}
import world.pos.{ChunkPos}
import world.states.{StateCodec}

/// The heightmaps' names in saves, in the order of `world.chunk`'s heightmap kinds, which is the
/// order of vanilla's `Heightmap.Types`.
pub fn heightmap_names() -> List<String> {
    return ["WORLD_SURFACE_WG", "WORLD_SURFACE", "OCEAN_FLOOR_WG", "OCEAN_FLOOR", "MOTION_BLOCKING", "MOTION_BLOCKING_NO_LEAVES"]
}

/// What reading or writing a chunk throws in vanilla: the exception, by its class's simple name,
/// and its message.
pub struct ChunkError {
    pub exception: String
    pub message: String
}

/// The registries a chunk's NBT names things from: blocks and their states, fluids, chunk
/// statuses and biomes.
pub struct ChunkFormat {
    pub states: StateCodec
    pub fluids: Names
    pub statuses: Names
    pub biomes: Names
    /// The biome a section without biomes has, `minecraft:plains`.
    pub plains: u32
    air_block: u32
    empty_fluid: u32
    empty_status: u32
    full_status: u32
    terrain_status: u32
    features_status: u32
    light_status: u32
    spawn_status: u32
}

impl ChunkFormat {
    /// The format of the built-in `block`, `fluid` and `chunk_status` registries of `registries`
    /// and its `worldgen/biome`, or what's missing.
    pub fn new(registries: Registries) -> ChunkFormat ! String {
        let block = try builtin(registries, "block")
        let fluid = try builtin(registries, "fluid")
        let status = try builtin(registries, "chunk_status")
        let b = registries.find(String("worldgen/biome")) else fail "there's no biome registry"
        let states = StateCodec.new(registries.builtin[block])
        let fluids = Names.from(registries.builtin[fluid])
        let statuses = Names.from(registries.builtin[status])
        let biomes = Names.from(registries.synced[b])
        let plains = try biomes.parse("minecraft:plains")
        let air_block = try states.blocks.parse("minecraft:air")
        let empty_fluid = try fluids.parse("minecraft:empty")
        let empty_status = try statuses.parse("minecraft:empty")
        let full_status = try statuses.parse("minecraft:full")
        let terrain_status = try statuses.parse("minecraft:terrain")
        let features_status = try statuses.parse("minecraft:features")
        let light_status = try statuses.parse("minecraft:light")
        let spawn_status = try statuses.parse("minecraft:spawn")
        return ChunkFormat {
            states: states,
            fluids: fluids,
            statuses: statuses,
            biomes: biomes,
            plains: plains,
            air_block: air_block,
            empty_fluid: empty_fluid,
            empty_status: empty_status,
            full_status: full_status,
            terrain_status: terrain_status,
            features_status: features_status,
            light_status: light_status,
            spawn_status: spawn_status,
        }
    }

    /// Whether a chunk saved at `status` is full, `minecraft:full`, as its generation leaves it.
    pub fn is_full(self, status: u32) -> bool {
        return status == self.full_status
    }

    /// Whether a chunk saved at `status` has its terrain, `minecraft:terrain` or a status after
    /// it, which the registry lists in the order chunks go through them (D334).
    pub fn has_terrain(self, status: u32) -> bool {
        return status >= self.terrain_status
    }

    /// Whether a chunk saved at `status` has its own features, `minecraft:features` or a status
    /// after it (D334).
    pub fn has_features(self, status: u32) -> bool {
        return status >= self.features_status
    }

    /// Whether a chunk saved at `status` has been lit, `minecraft:light` or a status after it.
    pub fn has_light(self, status: u32) -> bool {
        return status >= self.light_status
    }

    /// Whether a chunk saved at `status` has had its mobs spawned, `minecraft:spawn` or a status
    /// after it (D584).
    pub fn has_spawned(self, status: u32) -> bool {
        return status >= self.spawn_status
    }

    /// The status a chunk whose mobs are still to spawn is saved at, `minecraft:light`, the one
    /// before `minecraft:spawn`, as everything before the spawn step's done (CAL-161).
    pub fn unspawned_status(self) -> u32 {
        return self.light_status
    }

    fn biome_strategy(self) -> Strategy {
        return Strategy.biomes(self.biomes.len())
    }
}

fn block_strategy() -> Strategy {
    return Strategy.block_states(STATE_COUNT)
}

/// A block or fluid tick waiting in a save, vanilla's `SavedTick`: what's ticked, where, in how
/// many ticks, and its priority, from -3, first, to 3.
pub struct SavedTick {
    /// The block's or the fluid's ID.
    pub kind: u32
    pub x: i32
    pub y: i32
    pub z: i32
    pub delay: i32
    pub priority: i32
}

/// What a full chunk saves besides its sections, heightmaps and light, which the server keeps as
/// the generator made it or as it was read, and saves again as it is: its block entities, each a
/// compound; its block and fluid ticks; the blocks it marks for post-processing in each section
/// from the bottom, each a packed position in the section, or `none` for none; and its
/// structures' starts and references, a compound (D288). Until it's full, the entities it has,
/// each a compound, `ProtoChunk.getEntities`, saved with it, `entities`, and taken out to come
/// into its level as it comes to be full (D588).
pub struct ChunkRest {
    pub block_entities: List<Tag>
    pub block_ticks: List<SavedTick>
    pub fluid_ticks: List<SavedTick>
    pub post_processing: List<List<i16>?>
    pub structures: Tag
    pub entities: List<Tag> = List<Tag>()
}

impl ChunkRest {
    /// The rest of a chunk of `sections` sections that has none: no block entities, ticks or
    /// blocks to update, and `structures` with no starts and no references, as vanilla's
    /// `packStructureData` writes it for a chunk with none.
    pub fn empty(sections: usize) -> ChunkRest {
        var post = List<List<i16>?>()
        for _ in 0..sections {
            post.push(none)
        }
        var structures = JavaHashMap<String, Tag>()
        structures.insert("starts", Tag.Compound(JavaHashMap<String, Tag>()))
        structures.insert("References", Tag.Compound(JavaHashMap<String, Tag>()))
        return ChunkRest { block_entities: List<Tag>(), block_ticks: List<SavedTick>(), fluid_ticks: List<SavedTick>(), post_processing: post, structures: Tag.Compound(structures) }
    }
}

/// A chunk's rest as the server keeps it while it holds the chunk: packed in one list of bytes,
/// where `ChunkRest`'s lists and tags are dozens of small blocks. Each of those lived as long as
/// its chunk, on a page among the many that generating the chunk took and let go, and held the
/// page. Packed, and kept with the others in the level's `RestStore`, a still view-32 player's
/// server holds 45 MiB less (D289). Only the server reads it, and it's never saved as it is:
/// `unpack` gives the rest back to save.
///
/// The ticks and the marks are their numbers, each as a varint, 7 bits a byte with the low ones
/// first, and a signed one zig-zagged first, as protobuf's are; a section's count of marks is one
/// more than it has, and 0 where it has none. The block entities and the structures are NBT, as
/// `write_unnamed` writes a save's root. Last, the entities of a chunk that isn't full yet, as
/// many as there are and each NBT, then how many bytes they take, four from the low one up, and a
/// byte of 1; or, where it has none, a byte of 0, so they're found from the end, and taken out,
/// without reading the rest (D588).
pub struct PackedRest {
    bytes: List<u8>
}

impl PackedRest {
    /// `rest`, packed.
    pub fn of(rest: ChunkRest) -> PackedRest {
        var out = List<u8>()
        put_ticks(mut out, rest.block_ticks)
        put_ticks(mut out, rest.fluid_ticks)
        put_var(mut out, u32.wrap(rest.post_processing.len()))
        for p in rest.post_processing {
            if let marks = p {
                put_var(mut out, u32.wrap(marks.len()) + 1)
                for m in marks {
                    put_var(mut out, u32(u16.wrap(m)))
                }
            } else {
                put_var(mut out, 0)
            }
        }
        put_var(mut out, u32.wrap(rest.block_entities.len()))
        for t in rest.block_entities {
            t.write_unnamed(mut out)
        }
        rest.structures.write_unnamed(mut out)
        put_entities(mut out, rest.entities)
        // A copy holds as many bytes as there are, where the list grew to as many as twice.
        return PackedRest { bytes: out.copy() }
    }

    /// The rest it was packed from.
    pub fn unpack(self) -> ChunkRest {
        return unpacked(self.bytes)
    }

    /// How many bytes it holds.
    pub fn len(self) -> usize {
        return self.bytes.len()
    }

    /// How many entities it has, those of a chunk that isn't full yet, found from its end
    /// without reading them (D588).
    pub fn entity_count(self) -> usize {
        let (from, _) = entities_span(self.bytes, 0, self.bytes.len()) else return 0
        var at = from
        return usize(var_at(self.bytes, mut at))
    }

    /// The block entities it saved, as `RestStore.block_entities` gives a held chunk's.
    pub fn block_entities(self) -> List<Tag> {
        return block_entities_at(self.bytes, 0)
    }

    /// The rest with `block_entities` as its block entities, in place of those it had, as a chunk
    /// whose blocks with them were set saves those it has then (CAL-115).
    pub fn with_block_entities(self, block_entities: List<Tag>) -> PackedRest {
        let start = entities_start(self.bytes, 0)
        var at = start
        var accounter = Accounter.unlimited()
        let count = usize(var_at(self.bytes, mut at))
        for _ in 0..count {
            _ = read_unnamed(self.bytes, mut at, mut accounter)!
        }
        var out = List<u8>()
        out.reserve(self.bytes.len())
        for i in 0..start {
            out.push(self.bytes[i])
        }
        put_var(mut out, u32.wrap(block_entities.len()))
        for t in block_entities {
            t.write_unnamed(mut out)
        }
        for i in at..self.bytes.len() {
            out.push(self.bytes[i])
        }
        return PackedRest { bytes: out }
    }

    /// The rest with `block` and `fluid` as its block and fluid ticks, in place of those it had,
    /// as a chunk that ticked saves the ticks it has then (D322).
    pub fn with_ticks(self, block: List<SavedTick>, fluid: List<SavedTick>) -> PackedRest {
        var at: usize = 0
        _ = ticks_at(self.bytes, mut at)
        _ = ticks_at(self.bytes, mut at)
        var out = List<u8>()
        put_ticks(mut out, block)
        put_ticks(mut out, fluid)
        out.reserve(self.bytes.len() - at)
        for i in at..self.bytes.len() {
            out.push(self.bytes[i])
        }
        return PackedRest { bytes: out }
    }
}

/// The packed rests of the chunks a level holds, all in one list of bytes, each chunk's where its
/// span says (D289). A rest in a list of its own was a block of its own, made on the worker that
/// made the chunk, among the many it let go of then: each held a 4 KiB page that was otherwise
/// free, and a still view-32 player's 5,041 chunks held 25 MiB that way for 5 MiB of rests. One
/// list is a big block, which comes from the system and goes back to it whole. Once half of what
/// it holds is rests taken out, those still in it move up to its start, in a list of their own
/// size.
pub struct RestStore {
    bytes: List<u8> = List<u8>()
    // Each chunk's rest, by its packed position: where it starts in `bytes`, in the high half,
    // and how long it is.
    spans: OpenHashMap<i64, u64> = OpenHashMap<i64, u64>()
    // How many of the bytes are no chunk's.
    loose: usize = 0
    // The chunks whose marks for post-processing were taken out, which their rests keep until
    // they're taken out, without them, so taking the marks doesn't copy the rest (D330).
    taken: OpenHashSet<i64> = OpenHashSet<i64>()
}

// The least that moves the rests up, so a small store isn't copied over and over.
const LOOSE_AT_LEAST: usize = 65536

impl RestStore {
    /// Keeps `rest` for the chunk at `k`, in place of any it had.
    pub fn put(mut self, k: i64, rest: own PackedRest) {
        self.forget(k)
        let start = self.bytes.len()
        for b in rest.bytes {
            self.bytes.push(b)
        }
        self.spans.insert(k, (u64(start) << 32) | u64(rest.bytes.len()))
    }

    /// Takes the chunk at `k`'s rest out, if it has one, without the marks taken from it.
    pub fn take(mut self, k: i64) -> PackedRest? {
        let span = self.spans.remove(k) else return none
        let start = usize.wrap(span >> 32)
        let len = usize.wrap(span & 0xFFFFFFFF)
        var out = List<u8>()
        if self.taken.contains(k) {
            self.taken.remove(k)
            out = unmarked(self.bytes, start, start + len)
        } else {
            out.reserve(len)
            for i in start..start + len {
                out.push(self.bytes[i])
            }
        }
        self.loose += len
        self.tidy()
        return some(PackedRest { bytes: out })
    }

    /// A copy of the chunk at `k`'s rest, if it has one, without the marks taken from it, which
    /// stays: what a chunk saved while it's held saves (CAL-145).
    pub fn copied(self, k: i64) -> PackedRest? {
        let span = self.spans.get(k) else return none
        let start = usize.wrap(span >> 32)
        let len = usize.wrap(span & 0xFFFFFFFF)
        if self.taken.contains(k) {
            return some(PackedRest { bytes: unmarked(self.bytes, start, start + len) })
        }
        var out = List<u8>()
        out.reserve(len)
        for i in start..start + len {
            out.push(self.bytes[i])
        }
        return some(PackedRest { bytes: out })
    }

    /// How many chunks it has rests for.
    pub fn len(self) -> usize {
        return self.spans.len()
    }

    /// Takes the entities out of the chunk at `k`'s rest, the rest left with none, as a chunk that
    /// comes to be full adds them to its level, `postLoadProtoChunk`: none if it has no rest or
    /// none in it. Its span's cut short to its byte of 0, from the end, so nothing moves (D588).
    pub fn take_entities(mut self, k: i64) -> List<Tag> {
        let span = self.spans.get(k) else return List<Tag>()
        let start = usize.wrap(span >> 32)
        let len = usize.wrap(span & 0xFFFFFFFF)
        let (from, taken) = entities_span(self.bytes, start, start + len) else return List<Tag>()
        let out = entities_in(self.bytes, start, start + len)
        self.bytes[from] = 0
        let kept = from + 1 - start
        self.spans.insert(k, (u64(start) << 32) | u64(kept))
        self.loose += taken - 1
        self.tidy()
        return out
    }

    /// The block and fluid ticks the chunk at `k`'s rest has, if it has one, which come first in
    /// it (D322).
    pub fn ticks(self, k: i64) -> (List<SavedTick>, List<SavedTick>)? {
        let span = self.spans.get(k) else return none
        var at = usize.wrap(span >> 32)
        let block = ticks_at(self.bytes, mut at)
        let fluid = ticks_at(self.bytes, mut at)
        return some((block, fluid))
    }

    /// The block entities the chunk at `k`'s rest saved, as they were saved, which come after
    /// its ticks and marks, none if it has no rest (CAL-115).
    pub fn block_entities(self, k: i64) -> List<Tag> {
        let span = self.spans.get(k) else return List<Tag>()
        return block_entities_at(self.bytes, usize.wrap(span >> 32))
    }

    /// Whether the chunk at `k`'s rest has any block marked for post-processing (D329).
    pub fn marked(self, k: i64) -> bool {
        if self.taken.contains(k) {
            return false
        }
        let span = self.spans.get(k) else return false
        var at = usize.wrap(span >> 32)
        _ = ticks_at(self.bytes, mut at)
        _ = ticks_at(self.bytes, mut at)
        let sections = var_at(self.bytes, mut at)
        // Each section's count is one more than its marks, so one of 0 or 1 has none after it.
        for _ in 0..sections {
            if var_at(self.bytes, mut at) > 1 {
                return true
            }
        }
        return false
    }

    /// Takes out the blocks the chunk at `k`'s generation marked for post-processing, each
    /// section's from the bottom, `none` where it marked none, and leaves its rest with none
    /// marked, as `postProcessGeneration` clears each list (D329): the rest is taken out without
    /// them, not copied now (D330). Empty if it has no rest, marked none, or they were taken.
    pub fn take_marks(mut self, k: i64) -> List<List<i16>?> {
        var out = List<List<i16>?>()
        if self.taken.contains(k) {
            return out
        }
        let span = self.spans.get(k) else return out
        var at = usize.wrap(span >> 32)
        _ = ticks_at(self.bytes, mut at)
        _ = ticks_at(self.bytes, mut at)
        let sections = var_at(self.bytes, mut at)
        var any = false
        for _ in 0..sections {
            let n = var_at(self.bytes, mut at)
            if n == 0 {
                out.push(none)
                continue
            }
            any = true
            var marks = List<i16>()
            marks.reserve(usize(n - 1))
            for _ in 0..n - 1 {
                marks.push(i16.wrap(var_at(self.bytes, mut at)))
            }
            out.push(some(marks))
        }
        if not any {
            return List<List<i16>?>()
        }
        self.taken.insert(k)
        return out
    }

    /// How many bytes it holds, the rests' and those no chunk's.
    pub fn held(self) -> usize {
        return self.bytes.len()
    }

    // Lets go of the chunk at `k`'s rest, if it has one.
    fn forget(mut self, k: i64) {
        self.taken.remove(k)
        let span = self.spans.remove(k) else return
        self.loose += usize.wrap(span & 0xFFFFFFFF)
        self.tidy()
    }

    // Once half the bytes are no chunk's, moves the rests up into a list of their size.
    fn tidy(mut self) {
        if self.loose < LOOSE_AT_LEAST or self.loose * 2 < self.bytes.len() {
            return
        }
        var out = List<u8>()
        out.reserve(self.bytes.len() - self.loose)
        var spans = OpenHashMap<i64, u64>()
        for (k, span) in self.spans {
            let start = usize.wrap(span >> 32)
            let len = usize.wrap(span & 0xFFFFFFFF)
            spans.insert(k, (u64(out.len()) << 32) | u64(len))
            for i in start..start + len {
                out.push(self.bytes[i])
            }
        }
        self.bytes = out
        self.spans = spans
        self.loose = 0
    }
}

// The packed rest in `b` from `start` to `end`, with each section's marks for post-processing
// left out, as one whose marks were taken is saved (D330).
fn unmarked(b: List<u8>, start: usize, end: usize) -> List<u8> {
    var at = start
    _ = ticks_at(b, mut at)
    _ = ticks_at(b, mut at)
    let marks_at = at
    let sections = var_at(b, mut at)
    // Each section's count is one more than its marks, and 0 where it has none.
    for _ in 0..sections {
        let n = var_at(b, mut at)
        if n > 1 {
            for _ in 0..n - 1 {
                _ = var_at(b, mut at)
            }
        }
    }
    var out = List<u8>()
    out.reserve(end - start)
    for i in start..marks_at {
        out.push(b[i])
    }
    put_var(mut out, sections)
    for _ in 0..sections {
        out.push(0)
    }
    for i in at..end {
        out.push(b[i])
    }
    return out
}

// The rest `b`, a packed rest's bytes, holds.
fn unpacked(b: List<u8>) -> ChunkRest {
    var at: usize = 0
    let block_ticks = ticks_at(b, mut at)
    let fluid_ticks = ticks_at(b, mut at)
    let sections = usize(var_at(b, mut at))
    var post = List<List<i16>?>()
    for _ in 0..sections {
        let n = var_at(b, mut at)
        if n == 0 {
            post.push(none)
            continue
        }
        var marks = List<i16>()
        marks.reserve(usize(n - 1))
        for _ in 0..usize(n - 1) {
            marks.push(i16.wrap(var_at(b, mut at)))
        }
        post.push(some(marks))
    }
    var accounter = Accounter.unlimited()
    let count = usize(var_at(b, mut at))
    var block_entities = List<Tag>()
    for _ in 0..count {
        block_entities.push(read_unnamed(b, mut at, mut accounter)!)
    }
    let structures = read_unnamed(b, mut at, mut accounter)!
    let entities = entities_in(b, 0, b.len())
    return ChunkRest { block_entities: block_entities, block_ticks: block_ticks, fluid_ticks: fluid_ticks, post_processing: post, structures: structures, entities: entities }
}

// A packed rest's entities and their trailer, as `PackedRest.of` ends with them (D588).
fn put_entities(out: mut List<u8>, entities: List<Tag>) {
    if entities.is_empty() {
        out.push(0)
        return
    }
    let start = out.len()
    put_var(mut out, u32.wrap(entities.len()))
    for t in entities {
        t.write_unnamed(mut out)
    }
    let len = u32.wrap(out.len() - start)
    out.push(u8.wrap(len))
    out.push(u8.wrap(len >> 8))
    out.push(u8.wrap(len >> 16))
    out.push(u8.wrap(len >> 24))
    out.push(1)
}

// Where the entities of the packed rest in `b` from `start` to `end` begin, and how many bytes
// they and their trailer take, found from its end; none where it has none (D588).
fn entities_span(b: List<u8>, start: usize, end: usize) -> (usize, usize)? {
    if end <= start or b[end - 1] != 1 or end - start < 6 {
        return none
    }
    let len = usize(u32(b[end - 5]) | (u32(b[end - 4]) << 8) | (u32(b[end - 3]) << 16) | (u32(b[end - 2]) << 24))
    return some((end - 5 - len, len + 5))
}

// The entities of the packed rest in `b` from `start` to `end`, none where it has none (D588).
fn entities_in(b: List<u8>, start: usize, end: usize) -> List<Tag> {
    var out = List<Tag>()
    let (from, _) = entities_span(b, start, end) else return out
    var at = from
    var accounter = Accounter.unlimited()
    let count = usize(var_at(b, mut at))
    for _ in 0..count {
        out.push(read_unnamed(b, mut at, mut accounter)!)
    }
    return out
}

fn put_var(out: mut List<u8>, value: u32) {
    var v = value
    while v >= 0x80 {
        out.push(u8.wrap(v) | 0x80)
        v = v >> 7
    }
    out.push(u8.wrap(v))
}

fn var_at(b: List<u8>, at: mut usize) -> u32 {
    var v: u32 = 0
    var shift: u32 = 0
    loop {
        let byte = u32(b[at])
        at += 1
        v = v | ((byte & 0x7F) << shift)
        if byte < 0x80 {
            return v
        }
        shift += 7
    }
}

// A signed number zig-zagged, so one near 0 either way takes a byte or two.
fn put_signed(out: mut List<u8>, v: i32) {
    put_var(mut out, u32.wrap((v << 1) ^ (v >> 31)))
}

fn signed_at(b: List<u8>, at: mut usize) -> i32 {
    let u = var_at(b, mut at)
    return i32.wrap(u >> 1) ^ -i32.wrap(u & 1)
}

fn put_ticks(out: mut List<u8>, ticks: List<SavedTick>) {
    put_var(mut out, u32.wrap(ticks.len()))
    for t in ticks {
        put_var(mut out, t.kind)
        put_signed(mut out, t.x)
        put_signed(mut out, t.y)
        put_signed(mut out, t.z)
        put_signed(mut out, t.delay)
        put_signed(mut out, t.priority)
    }
}

// Past `n` ticks packed in `b` from `at`, as `ticks_at` reads them.
fn skip_ticks(b: List<u8>, at: mut usize) {
    let n = var_at(b, mut at)
    for _ in 0..n * 6 {
        _ = var_at(b, mut at)
    }
}

// Where the block entities of the rest packed in `b` from `start` begin, past its ticks and its
// marks, which are still there where they were taken (D330).
fn entities_start(b: List<u8>, start: usize) -> usize {
    var at = start
    skip_ticks(b, mut at)
    skip_ticks(b, mut at)
    let sections = var_at(b, mut at)
    for _ in 0..sections {
        let n = var_at(b, mut at)
        if n > 1 {
            for _ in 0..n - 1 {
                _ = var_at(b, mut at)
            }
        }
    }
    return at
}

// The block entities of the rest packed in `b` from `start`.
fn block_entities_at(b: List<u8>, start: usize) -> List<Tag> {
    var at = entities_start(b, start)
    var accounter = Accounter.unlimited()
    let count = usize(var_at(b, mut at))
    var out = List<Tag>()
    for _ in 0..count {
        out.push(read_unnamed(b, mut at, mut accounter)!)
    }
    return out
}

fn ticks_at(b: List<u8>, at: mut usize) -> List<SavedTick> {
    let n = usize(var_at(b, mut at))
    var out = List<SavedTick>()
    out.reserve(n)
    for _ in 0..n {
        let kind = var_at(b, mut at)
        let x = signed_at(b, mut at)
        let y = signed_at(b, mut at)
        let z = signed_at(b, mut at)
        let delay = signed_at(b, mut at)
        let priority = signed_at(b, mut at)
        out.push(SavedTick { kind: kind, x: x, y: y, z: z, delay: delay, priority: priority })
    }
    return out
}

/// What the blender needs of a chunk from before the world grew, vanilla's `BlendingData.Packed`.
pub struct Blending {
    pub min_section: i32
    pub max_section: i32
    /// The old terrain's heights at 16 places around the chunk, if they're saved.
    pub heights: List<f32>?
}

/// A chunk from before the world grew down that's still being generated below zero, vanilla's
/// `BelowZeroRetrogen`.
pub struct Retrogen {
    /// The status the chunk is generated to, never `minecraft:empty`.
    pub target_status: u32
    /// The columns whose bedrock is missing, a bit each, as `BitSet.toLongArray` gives them:
    /// with no zero words at the end.
    pub missing_bedrock: List<i64>
}

/// What's left of a chunk's upgrade from before 1.13, vanilla's `UpgradeData`.
pub struct Upgrade {
    /// Each section's blocks to fix, by section from the bottom, or `none`.
    pub indices: List<List<i32>?>
    /// The neighbours to fix it against, a bit each for the 8 directions of vanilla's
    /// `Direction8`.
    pub sides: u8
    pub neighbor_block_ticks: List<SavedTick>
    pub neighbor_fluid_ticks: List<SavedTick>
}

impl Upgrade {
    /// Whether there's nothing to fix, as vanilla's `isEmpty` has it, which leaves out the
    /// ticks: then it isn't saved.
    pub fn is_empty(self) -> bool {
        for i in self.indices {
            if i != none {
                return false
            }
        }
        return self.sides == 0
    }
}

/// A section as a save holds it.
pub struct SectionData {
    /// Its height in sections.
    pub y: i32
    /// Its block states and biomes, or `none` for a section outside the world, which keeps only
    /// its light.
    pub blocks: PalettedContainer?
    pub biomes: PalettedContainer?
    /// Its light, 2,048 bytes of 4 bits each, if it's saved.
    pub block_light: List<i8>?
    pub sky_light: List<i8>?
    // What vanilla throws when it writes the biomes, for biomes with a value past their palette's
    // end, which are plains here.
    broken: ChunkError?
}

/// A chunk as a save holds it, vanilla's `SerializableChunkData`.
pub struct ChunkData {
    pub pos: ChunkPos
    /// The world's lowest section, which is what's saved, not what was read.
    pub min_section: i32
    pub last_update: i64
    pub inhabited_time: i64
    pub status: u32
    pub blending: Blending?
    pub retrogen: Retrogen?
    /// The upgrade data, if there's a compound of it, even an empty one.
    pub upgrade: Upgrade?
    /// Each heightmap by kind, as `heightmap_names` orders them, if it's saved.
    pub heightmaps: List<List<i64>?>
    /// The ticks in the chunk.
    pub block_ticks: List<SavedTick>
    pub fluid_ticks: List<SavedTick>
    /// The blocks to update after generation in each section from the bottom, each a packed
    /// position in the section, or `none` for none.
    pub post_processing: List<List<i16>?>
    pub light_correct: bool
    /// The sections in the order they're saved, which can be any order and can repeat a height.
    pub sections: List<SectionData>
    /// Entities, saved in a chunk only until it's full, and block entities, each a compound.
    pub entities: List<Tag>
    pub block_entities: List<Tag>
    /// The structures' starts and references, a compound kept as it is.
    pub structures: Tag
}

impl ChunkData {
    /// A chunk the generator finished, at `pos`, as Calcite saves it before the light engine has
    /// had it: `minecraft:full`, unlit, its sections with their blocks and biomes and no light,
    /// the four heightmaps a full chunk keeps, and `rest`, its block entities, ticks, blocks to
    /// update and structures (D288). Read back, it's the chunk the generator handed over.
    pub fn generated(format: ChunkFormat, pos: ChunkPos, chunk: Chunk, rest: own ChunkRest) -> ChunkData {
        let min_section = chunk.min_y() >> 4
        var sections = List<SectionData>()
        for i in 0..chunk.section_count() {
            let s = chunk.section(i)
            sections.push(SectionData { y: min_section + i32.wrap(i), blocks: some(s.states()), biomes: some(s.biomes()), block_light: none, sky_light: none, broken: none })
        }
        let ChunkRest { block_entities: block_entities, block_ticks: block_ticks, fluid_ticks: fluid_ticks, post_processing: post, structures: structures, entities: entities } = rest
        var heightmaps = List<List<i64>?>()
        for kind in 0..heightmap_names().len() {
            let k = i32.wrap(kind)
            let kept = k == WORLD_SURFACE or k == OCEAN_FLOOR or k == MOTION_BLOCKING or k == MOTION_BLOCKING_NO_LEAVES
            heightmaps.push(if kept { some(chunk.heightmap_longs(k)) } else { none })
        }
        return ChunkData {
            pos: pos,
            min_section: min_section,
            last_update: 0,
            inhabited_time: 0,
            status: format.full_status,
            blending: none,
            retrogen: none,
            upgrade: none,
            heightmaps: heightmaps,
            block_ticks: block_ticks,
            fluid_ticks: fluid_ticks,
            post_processing: post,
            light_correct: false,
            sections: sections,
            entities: entities,
            block_entities: block_entities,
            structures: structures,
        }
    }

    /// A chunk the server holds whole, once it's lit, as `SerializableChunkData.copyOf` saves
    /// it: `generated`'s, with its light on, and the light the engine has for each section from
    /// the one below the world to the one above, `sky` and `block`, `none` where it has none or
    /// it's empty. A section outside the world is saved with only its light, and only if it has
    /// some (D258).
    pub fn lit(format: ChunkFormat, pos: ChunkPos, chunk: Chunk, rest: own ChunkRest, sky: own List<List<u8>?>, block: own List<List<u8>?>) -> ChunkData {
        var data = ChunkData.generated(format, pos, chunk, rest)
        var sky_layers = sky
        var block_layers = block
        let count = data.sections.len()
        // Lowest last, to pop in order.
        var inside = List<SectionData>()
        while let s = data.sections.pop() {
            inside.push(s)
        }
        var sections = List<SectionData>()
        for i in 0..count + 2 {
            let b = signed_layer(mut block_layers, i)
            let s = signed_layer(mut sky_layers, i)
            if i == 0 or i == count + 1 {
                if b != none or s != none {
                    sections.push(SectionData { y: data.min_section - 1 + i32.wrap(i), blocks: none, biomes: none, block_light: b, sky_light: s, broken: none })
                }
                continue
            }
            var section = inside.pop() else continue
            section.block_light = b
            section.sky_light = s
            sections.push(section)
        }
        data.sections = sections
        data.light_correct = true
        return data
    }

    /// Whether the chunk is all a chunk Calcite saves whole has, as `generated` or `lit` make
    /// it: full, or lit and waiting for its mobs as Calcite saves one (D584), from no time and no
    /// player's, with its sections, heightmaps and rest, and no entities of its own, so saving it
    /// again from what the server holds of it, with its rest as it was read, loses nothing (D258,
    /// D288). `tags` is what `written_whole` said of its root.
    pub fn whole(self, format: ChunkFormat, tags: bool) -> bool {
        if not tags or not format.has_light(self.status) {
            return false
        }
        if self.blending != none or self.retrogen != none {
            return false
        }
        if let u = self.upgrade {
            if not u.is_empty() {
                return false
            }
        }
        return self.entities.is_empty()
    }

    /// Takes its block entities, ticks, blocks to update and structures out, as the rest the
    /// server keeps of it, for a world of `sections` sections: each section's blocks to update,
    /// none past those saved and none for those past the world's (D288).
    pub fn take_rest(mut self, sections: usize) -> ChunkRest {
        var post = List<List<i16>?>()
        for i in 0..sections {
            post.push(if i < self.post_processing.len() { self.post_processing[i].take() } else { none })
        }
        self.post_processing = List<List<i16>?>()
        let structures = self.structures.copy()
        self.structures = Tag.Compound(JavaHashMap<String, Tag>())
        let rest = ChunkRest { block_entities: self.block_entities.copy(), block_ticks: self.block_ticks.copy(), fluid_ticks: self.fluid_ticks.copy(), post_processing: post, structures: structures, entities: self.entities.copy() }
        self.entities = List<Tag>()
        self.block_entities = List<Tag>()
        self.block_ticks = List<SavedTick>()
        self.fluid_ticks = List<SavedTick>()
        return rest
    }

    /// The chunk `root` holds, as vanilla's `parse` reads it for a world of `sections` sections
    /// from `min_section` up, with what it logs added to `lines`: `none` if there's no `Status`
    /// string, and what vanilla throws if it can't be read.
    pub fn parse(format: ChunkFormat, min_section: i32, sections: i32, root: own JavaHashMap<String, Tag>, lines: mut List<Entry>) -> ChunkData? ! ChunkError {
        var tags = root
        if not tags.contains("Status") or not is_string(tags["Status"]) {
            return none
        }
        let pos = ChunkPos { x: int_or(tags, "xPos", 0), z: int_or(tags, "zPos", 0) }
        let last_update = long_or(tags, "LastUpdate", 0)
        let inhabited_time = long_or(tags, "InhabitedTime", 0)
        var status = format.empty_status
        match format.statuses.decode(tags["Status"]) {
            ok(s) => status = s,
            err(message) => lines.push(Entry.error(field_error("Status", tags["Status"], message))),
        }
        var upgrade: Upgrade? = none
        if tags.contains("UpgradeData") {
            match tags["UpgradeData"] {
                Tag.Compound(fields) => upgrade = some(read_upgrade(format, fields, sections, mut lines)),
                _ => {},
            }
        }
        let light_correct = byte_or(tags, "isLightOn", 0) != 0
        var blending: Blending? = none
        if tags.contains("blending_data") {
            match read_blending(tags["blending_data"]) {
                ok(b) => blending = some(b),
                err(message) => lines.push(Entry.error(field_error("blending_data", tags["blending_data"], message))),
            }
        }
        var retrogen: Retrogen? = none
        if tags.contains("below_zero_retrogen") {
            match read_retrogen(format, tags["below_zero_retrogen"]) {
                ok(r) => retrogen = some(r),
                err(message) => lines.push(Entry.error(field_error("below_zero_retrogen", tags["below_zero_retrogen"], message))),
            }
        }
        var heightmaps = List<List<i64>?>()
        match tags.remove("Heightmaps") {
            some(Tag.Compound(fields)) => {
                var maps = fields
                for name in heightmap_names() {
                    match maps.remove(name) {
                        some(Tag.LongArray(longs)) => heightmaps.push(some(longs)),
                        _ => heightmaps.push(none),
                    }
                }
            },
            _ => {
                for _ in 0..heightmap_names().len() {
                    heightmaps.push(none)
                }
            },
        }
        let block_ticks = in_chunk(read_ticks(tags, "block_ticks", format.states.blocks, none, mut lines), pos)
        let fluid_ticks = in_chunk(read_ticks(tags, "fluid_ticks", format.fluids, none, mut lines), pos)
        var post_processing = List<List<i16>?>()
        if tags.contains("PostProcessing") {
            match tags["PostProcessing"] {
                Tag.List(items) => {
                    for item in items {
                        post_processing.push(offsets(item))
                    }
                },
                _ => {},
            }
        }
        let entities = compounds(tags.remove("entities"))
        // A beacon's levels as it loads, 0, as it saves them but doesn't read them (D520).
        var block_entities = List<Tag>()
        var read_block_entities = reversed(compounds(tags.remove("block_entities")))
        while let be = read_block_entities.pop() {
            block_entities.push(loaded_beacon(be))
        }
        let structures = match tags.remove("structures") {
            some(Tag.Compound(fields)) => Tag.Compound(fields),
            _ => Tag.Compound(JavaHashMap<String, Tag>()),
        }
        var section_list = List<SectionData>()
        match tags.remove("sections") {
            some(Tag.List(items)) => {
                var rest = reversed(items)
                while let item = rest.pop() {
                    match item {
                        Tag.Compound(fields) => section_list.push(try read_section(format, min_section, sections, fields, pos, mut lines)),
                        _ => {},
                    }
                }
            },
            _ => {},
        }
        return some(ChunkData {
            pos: pos,
            min_section: min_section,
            last_update: last_update,
            inhabited_time: inhabited_time,
            status: status,
            blending: blending,
            retrogen: retrogen,
            upgrade: upgrade,
            heightmaps: heightmaps,
            block_ticks: block_ticks,
            fluid_ticks: fluid_ticks,
            post_processing: post_processing,
            light_correct: light_correct,
            sections: section_list,
            entities: entities,
            block_entities: block_entities,
            structures: structures,
        })
    }

    /// The chunk's NBT as vanilla's `write` writes it, or what vanilla throws: a section's
    /// biomes with a value past their palette's end, which vanilla finds only then.
    /// What `write` makes, written as `Tag.write_unnamed` writes it, straight into `out` with no
    /// tree made: each compound's entries in the order Java's `HashMap` iterates them, which is
    /// the order `write`'s `JavaHashMap`s keep, so the bytes are the same (D305). The root always
    /// has 14 to 19 entries and each other compound 12 or fewer, so each map's size is the same
    /// whichever entries it has, and each order is one order with the absent entries left out. A
    /// section's biomes with a value past their palette fail it before a byte is written.
    pub fn write_bytes(own self, format: ChunkFormat, out: mut List<u8>) ! ChunkError {
        var me = self
        for i in 0..me.sections.len() {
            if me.sections[i].biomes != none {
                if let e = me.sections[i].broken.take() {
                    fail e
                }
            }
        }
        out.push(10)
        out.push(0)
        out.push(0)
        put_entry(mut out, "Status", format.statuses.encode(me.status))
        put_int_entry(mut out, "zPos", me.pos.z)
        put_entry(mut out, "block_entities", Tag.List(me.block_entities))
        put_int_entry(mut out, "yPos", me.min_section)
        put_long_entry(mut out, "LastUpdate", me.last_update)
        put_entry(mut out, "structures", me.structures)
        put_long_entry(mut out, "InhabitedTime", me.inhabited_time)
        put_int_entry(mut out, "xPos", me.pos.x)
        if let b = me.blending {
            put_entry(mut out, "blending_data", blending_tag(b))
        }
        put_key(mut out, 10, "Heightmaps")
        let map_names: List<str> = ["OCEAN_FLOOR", "MOTION_BLOCKING_NO_LEAVES", "MOTION_BLOCKING", "WORLD_SURFACE", "OCEAN_FLOOR_WG", "WORLD_SURFACE_WG"]
        let map_kinds: List<usize> = [3, 5, 4, 1, 2, 0]
        for m in 0..map_kinds.len() {
            let k = map_kinds[m]
            if k < me.heightmaps.len() {
                if let longs = me.heightmaps[k].take() {
                    put_long_array_entry(mut out, map_names[m], longs)
                }
            }
        }
        put_end(mut out)
        put_key(mut out, 9, "sections")
        var count: usize = 0
        for i in 0..me.sections.len() {
            if saves_something(me.sections[i]) {
                count += 1
            }
        }
        put_list_head(mut out, if count == 0 { 0 } else { 10 }, count)
        for i in 0..me.sections.len() {
            if not saves_something(me.sections[i]) {
                continue
            }
            if let blocks = me.sections[i].blocks.take() {
                put_container(mut out, format, true, "block_states", blocks.pack())
            }
            if let bytes = me.sections[i].sky_light.take() {
                put_byte_array_entry(mut out, "SkyLight", bytes)
            }
            if let biomes = me.sections[i].biomes.take() {
                put_container(mut out, format, false, "biomes", biomes.pack())
            }
            if let bytes = me.sections[i].block_light.take() {
                put_byte_array_entry(mut out, "BlockLight", bytes)
            }
            put_byte_entry(mut out, "Y", i8.wrap(me.sections[i].y))
            put_end(mut out)
        }
        if me.light_correct {
            put_byte_entry(mut out, "isLightOn", 1)
        }
        if me.status != format.full_status {
            put_entry(mut out, "entities", Tag.List(me.entities))
        }
        if let u = me.upgrade {
            if not u.is_empty() {
                put_entry(mut out, "UpgradeData", upgrade_tag(format, u))
            }
        }
        put_tick_list(mut out, "block_ticks", me.block_ticks, format.states.blocks)
        put_key(mut out, 9, "PostProcessing")
        put_list_head(mut out, if me.post_processing.is_empty() { 0 } else { 9 }, me.post_processing.len())
        for s in 0..me.post_processing.len() {
            if let packed = me.post_processing[s].take() {
                put_list_head(mut out, if packed.is_empty() { 0 } else { 2 }, packed.len())
                for o in packed {
                    put_short(mut out, o)
                }
            } else {
                put_list_head(mut out, 0, 0)
            }
        }
        put_int_entry(mut out, "DataVersion", DATA_VERSION)
        if let r = me.retrogen {
            put_entry(mut out, "below_zero_retrogen", retrogen_tag(format, r))
        }
        put_tick_list(mut out, "fluid_ticks", me.fluid_ticks, format.fluids)
        put_end(mut out)
    }

    pub fn write(own self, format: ChunkFormat) -> Tag ! ChunkError {
        var me = self
        var root = JavaHashMap<String, Tag>()
        root.insert("DataVersion", Tag.Int(DATA_VERSION))
        root.insert("xPos", Tag.Int(me.pos.x))
        root.insert("yPos", Tag.Int(me.min_section))
        root.insert("zPos", Tag.Int(me.pos.z))
        root.insert("LastUpdate", Tag.Long(me.last_update))
        root.insert("InhabitedTime", Tag.Long(me.inhabited_time))
        root.insert("Status", format.statuses.encode(me.status))
        if let b = me.blending {
            root.insert("blending_data", blending_tag(b))
        }
        if let r = me.retrogen {
            root.insert("below_zero_retrogen", retrogen_tag(format, r))
        }
        if let u = me.upgrade {
            if not u.is_empty() {
                root.insert("UpgradeData", upgrade_tag(format, u))
            }
        }
        var section_tags = List<Tag>()
        for i in 0..me.sections.len() {
            var fields = JavaHashMap<String, Tag>()
            if let blocks = me.sections[i].blocks {
                fields.insert("block_states", container_tag(format, true, blocks.pack()))
            }
            if let biomes = me.sections[i].biomes {
                if let e = me.sections[i].broken.take() {
                    fail e
                }
                fields.insert("biomes", container_tag(format, false, biomes.pack()))
            }
            if let bytes = me.sections[i].block_light.take() {
                fields.insert("BlockLight", Tag.ByteArray(bytes))
            }
            if let bytes = me.sections[i].sky_light.take() {
                fields.insert("SkyLight", Tag.ByteArray(bytes))
            }
            if not fields.is_empty() {
                fields.insert("Y", Tag.Byte(i8.wrap(me.sections[i].y)))
                section_tags.push(Tag.Compound(fields))
            }
        }
        root.insert("sections", Tag.List(section_tags))
        if me.light_correct {
            root.insert("isLightOn", Tag.Byte(1))
        }
        root.insert("block_entities", Tag.List(me.block_entities))
        if me.status != format.full_status {
            root.insert("entities", Tag.List(me.entities))
        }
        root.insert("block_ticks", ticks_tag(me.block_ticks, format.states.blocks))
        root.insert("fluid_ticks", ticks_tag(me.fluid_ticks, format.fluids))
        var post = List<Tag>()
        for section in me.post_processing {
            var list = List<Tag>()
            if let packed = section {
                for o in packed {
                    list.push(Tag.Short(o))
                }
            }
            post.push(Tag.List(list))
        }
        root.insert("PostProcessing", Tag.List(post))
        var maps = JavaHashMap<String, Tag>()
        let names = heightmap_names()
        for k in 0..me.heightmaps.len() {
            if let longs = me.heightmaps[k].take() {
                maps.insert(names[k].copy(), Tag.LongArray(longs))
            }
        }
        root.insert("Heightmaps", Tag.Compound(maps))
        root.insert("structures", me.structures)
        return Tag.Compound(root)
    }
}

// A section from its compound, as `parse` reads one: its containers, if it's inside the world,
// then its light.
fn read_section(format: ChunkFormat, min_section: i32, sections: i32, fields: own JavaHashMap<String, Tag>, pos: ChunkPos, lines: mut List<Entry>) -> SectionData ! ChunkError {
    var tags = fields
    let y = i32(byte_or(tags, "Y", 0))
    var blocks: PalettedContainer? = none
    var biomes: PalettedContainer? = none
    var broken: ChunkError? = none
    if y >= min_section and y < min_section + sections {
        var blocks_broken: ChunkError? = none
        let block_values = match tags.remove("block_states") {
            some(Tag.Compound(container)) => try read_container(format, true, container, pos, y, mut lines, mut blocks_broken),
            _ => PalettedContainer.new(AIR_STATE, block_strategy()),
        }
        let biome_values = match tags.remove("biomes") {
            some(Tag.Compound(container)) => try read_container(format, false, container, pos, y, mut lines, mut broken),
            _ => PalettedContainer.new(format.plains, format.biome_strategy()),
        }
        // Vanilla counts the blocks once it has both, which is when it meets a value past the
        // palette's end.
        if let e = blocks_broken.take() {
            fail e
        }
        blocks = some(block_values)
        biomes = some(biome_values)
    }
    let block_light = try light(tags.remove("BlockLight"))
    let sky_light = try light(tags.remove("SkyLight"))
    return SectionData { y: y, blocks: blocks, biomes: biomes, block_light: block_light, sky_light: sky_light, broken: broken }
}

// Light as vanilla's `DataLayer` takes it: a byte array of 2,048 bytes, and nothing for anything
// else.
fn light(taken: own Tag?) -> List<i8>? ! ChunkError {
    match taken {
        some(Tag.ByteArray(bytes)) => {
            if bytes.len() != 2048 {
                fail ChunkError { exception: "IllegalArgumentException", message: "DataLayer should be 2048 bytes not: {bytes.len()}" }
            }
            return some(bytes)
        },
        _ => return none,
    }
}

// A section's block states, or its biomes for `blocks` false, from their compound `fields`, as
// the codecs of vanilla's `PalettedContainerFactory` read them and `parse` logs and throws what
// they fail with. An entry that isn't a block or a biome becomes air or plains, logged. What
// vanilla throws only when it reads the values, for a palette that's empty or that a value is
// past the end of, goes in `broken`, with a container of air or plains in its place.
fn read_container(format: ChunkFormat, blocks: bool, fields: own JavaHashMap<String, Tag>, pos: ChunkPos, y: i32, lines: mut List<Entry>, broken: mut ChunkError?) -> PalettedContainer ! ChunkError {
    var tags = fields
    let strategy = if blocks { block_strategy() } else { format.biome_strategy() }
    let fallback = if blocks { AIR_STATE } else { format.plains }
    if not tags.contains("palette") {
        let message = "No key palette in MapLike[{Tag.Compound(tags).to_snbt()}]"
        fail unreadable(pos, y, message, mut lines)
    }
    var data: List<i64>? = none
    if let d = tags.remove("data") {
        data = longs_of(d)
    }
    var entries = List<u32>()
    var errors = List<String>()
    match tags["palette"] {
        Tag.List(items) => {
            for item in items {
                entry(format, blocks, item, mut entries, mut errors)
            }
        },
        Tag.ByteArray(values) => {
            for v in values {
                entry(format, blocks, Tag.Byte(v), mut entries, mut errors)
            }
        },
        Tag.IntArray(values) => {
            for v in values {
                entry(format, blocks, Tag.Int(v), mut entries, mut errors)
            }
        },
        Tag.LongArray(values) => {
            for v in values {
                entry(format, blocks, Tag.Long(v), mut entries, mut errors)
            }
        },
        _ => {
            let message = "Not a list: {tags["palette"].to_snbt()}"
            fail unreadable(pos, y, message, mut lines)
        },
    }
    // The bits a palette of this size takes on disk, and whether it's an indexed one.
    let count = entries.len()
    let bits = ceil_log2(count)
    let global = if blocks { bits > 8 } else { bits > 3 }
    let stored = if blocks { bits.max(4) } else { bits.max(1) }
    // Vanilla meets a block state past an indexed palette's end when it counts them, in the order
    // of a fastutil map of the values, so those need the values again.
    var kept: List<i64>? = none
    if blocks and not global and count > 1 and (1u64 << stored) > u64(count) {
        if let d = data {
            kept = some(d.copy())
        }
    }
    match PalettedContainer.unpack(strategy, Packed { palette: entries, data: data }) {
        ok(container) => {
            if not errors.is_empty() {
                lines.push(Entry.error(recoverable(pos, y, newest_first(errors))))
            }
            return container
        },
        err(Error.Empty) => {
            broken = some(ChunkError { exception: "IllegalStateException", message: "Missing Palette entry for id 0." })
            return PalettedContainer.new(fallback, strategy)
        },
        err(Error.Index { index, .. }) => {
            // With no palette, vanilla turns the indices into IDs as it reads them, and fails
            // there, before it logs anything.
            if global {
                fail missing_entry(index)
            }
            if not errors.is_empty() {
                lines.push(Entry.error(recoverable(pos, y, newest_first(errors))))
            }
            var first = index
            if let longs = kept.take() {
                first = first_counted_past(stored, strategy.size(), longs, count)
            }
            broken = some(missing_entry(first))
            return PalettedContainer.new(fallback, strategy)
        },
        err(Error.MissingData) => {
            let message = with_errors(errors, "Missing values for non-zero storage")
            fail unreadable(pos, y, message, mut lines)
        },
        err(Error.Length { got, expected }) => {
            let message = with_errors(errors, "Failed to read PalettedContainer: Invalid length given for storage, got: {got} but expected: {expected}")
            fail unreadable(pos, y, message, mut lines)
        },
    }
}

// Adds the palette entry `tag` to `entries`: the block state or biome it names, or air or
// plains, with why in `errors`.
fn entry(format: ChunkFormat, blocks: bool, tag: Tag, entries: mut List<u32>, errors: mut List<String>) {
    if blocks {
        match format.states.decode(tag) {
            ok(state) => entries.push(state),
            err(message) => {
                entries.push(AIR_STATE)
                errors.push("({message} -> using default)")
            },
        }
    } else {
        match format.biomes.decode(tag) {
            ok(biome) => entries.push(biome),
            err(message) => {
                entries.push(format.plains)
                errors.push("({message} -> using default)")
            },
        }
    }
}

// The first value past a palette of `count` entries among the `n` values in `longs`, `bits` bits
// each, in the order vanilla's `PalettedContainer.count` meets them: its `Int2IntOpenHashMap`
// of each value's count, in fastutil's order.
fn first_counted_past(bits: i32, n: usize, longs: own List<i64>, count: usize) -> u32 {
    let storage = match BitStorage.from_longs(bits, n, longs) {
        ok(s) => s,
        err(_) => return 0,
    }
    var seen = OpenHashSet<i32>()
    for v in storage.values() {
        seen.insert(i32.wrap(v))
    }
    for k in seen {
        if usize.wrap(k) >= count {
            return u32.wrap(k)
        }
    }
    return 0
}

fn missing_entry(index: u32) -> ChunkError {
    return ChunkError { exception: "MissingPaletteEntryException", message: "Missing Palette entry for index {index}." }
}

// The section's container couldn't be read: vanilla logs why, then throws it.
fn unreadable(pos: ChunkPos, y: i32, message: own String, lines: mut List<Entry>) -> ChunkError {
    lines.push(Entry.error(recoverable(pos, y, message)))
    return ChunkError { exception: "ChunkReadException", message: message }
}

fn recoverable(pos: ChunkPos, y: i32, message: String) -> String {
    return "Recoverable errors when loading section [{pos.x}, {y}, {pos.z}]: {message}"
}

// A container written as its codec writes it: the palette, then the data if there's any.
// Whether `write` makes a compound of the section: whether it has anything but its height.
fn saves_something(s: SectionData) -> bool {
    return s.blocks != none or s.biomes != none or s.block_light != none or s.sky_light != none
}

// `container_tag`'s compound as an entry of `write_bytes`: `data`, then `palette`, the order
// Java's `HashMap` keeps them in.
fn put_container(out: mut List<u8>, format: ChunkFormat, blocks: bool, name: str, packed: own Packed) {
    var p = packed
    put_key(mut out, 10, name)
    if let longs = p.data.take() {
        put_long_array_entry(mut out, "data", longs)
    }
    var palette = List<Tag>()
    for v in p.palette {
        palette.push(if blocks { format.states.encode(v) } else { format.biomes.encode(v) })
    }
    put_entry(mut out, "palette", Tag.List(palette))
    put_end(mut out)
}

// `ticks_tag`'s list as an entry of `write_bytes`, each tick's fields in the order Java's
// `HashMap` keeps them in: `p`, `t`, `x`, `i`, `y`, `z`.
fn put_tick_list(out: mut List<u8>, name: str, ticks: List<SavedTick>, names: Names) {
    put_key(mut out, 9, name)
    put_list_head(mut out, if ticks.is_empty() { 0 } else { 10 }, ticks.len())
    for t in ticks {
        put_int_entry(mut out, "p", t.priority)
        put_int_entry(mut out, "t", t.delay)
        put_int_entry(mut out, "x", t.x)
        put_entry(mut out, "i", names.encode(t.kind))
        put_int_entry(mut out, "y", t.y)
        put_int_entry(mut out, "z", t.z)
        put_end(mut out)
    }
}

fn container_tag(format: ChunkFormat, blocks: bool, packed: own Packed) -> Tag {
    var p = packed
    var palette = List<Tag>()
    for v in p.palette {
        palette.push(if blocks { format.states.encode(v) } else { format.biomes.encode(v) })
    }
    var fields = JavaHashMap<String, Tag>()
    fields.insert("palette", Tag.List(palette))
    if let longs = p.data.take() {
        fields.insert("data", Tag.LongArray(longs))
    }
    return Tag.Compound(fields)
}

// The ticks at `key`, as `CompoundTag.read` reads them with their codec: those that can be read,
// and why the rest can't, logged. `fallback`, for the upgrade data's ticks, is what one names
// when its `i` can't be read.
fn read_ticks(tags: JavaHashMap<String, Tag>, key: String, names: Names, fallback: u32?, lines: mut List<Entry>) -> List<SavedTick> {
    var out = List<SavedTick>()
    if not tags.contains(key) {
        return out
    }
    var errors = List<String>()
    match tags[key] {
        Tag.List(items) => {
            for item in items {
                read_tick(item, names, fallback, mut out, mut errors)
            }
        },
        Tag.ByteArray(values) => {
            for v in values {
                errors.push("Not a map: {Tag.Byte(v).to_snbt()}")
            }
        },
        Tag.IntArray(values) => {
            for v in values {
                errors.push("Not a map: {Tag.Int(v).to_snbt()}")
            }
        },
        Tag.LongArray(values) => {
            for v in values {
                errors.push("Not a map: {Tag.Long(v).to_snbt()}")
            }
        },
        _ => errors.push("Not a list: {tags[key].to_snbt()}"),
    }
    if not errors.is_empty() {
        lines.push(Entry.error(field_error(key, tags[key], newest_first(errors))))
    }
    return out
}

// Adds the tick `tag` to `out` as vanilla's `SavedTick.codec` reads it, or why it can't be read
// to `errors`: each of its fields that can't be, the last first.
fn read_tick(tag: Tag, names: Names, fallback: u32?, out: mut List<SavedTick>, errors: mut List<String>) {
    match tag {
        Tag.Compound(fields) => {
            var problems = List<String>()
            var kind: u32 = 0
            if not fields.contains("i") {
                problems.push(no_key("i", tag))
            } else {
                match names.decode(fields["i"]) {
                    ok(k) => kind = k,
                    err(message) => {
                        if let f = fallback {
                            kind = f
                        } else {
                            problems.push(message)
                        }
                    },
                }
            }
            let x = int_field(tag, fields, "x", mut problems)
            let y = int_field(tag, fields, "y", mut problems)
            let z = int_field(tag, fields, "z", mut problems)
            let delay = int_field(tag, fields, "t", mut problems)
            let priority = int_field(tag, fields, "p", mut problems)
            if not problems.is_empty() {
                errors.push(newest_first(problems))
                return
            }
            out.push(SavedTick { kind: kind, x: x, y: y, z: z, delay: delay, priority: priority.max(-3).min(3) })
        },
        _ => errors.push("Not a map: {tag.to_snbt()}"),
    }
}

// The ticks of `ticks` in the chunk at `pos`, as `filterTickListForChunk` keeps them.
fn in_chunk(ticks: own List<SavedTick>, pos: ChunkPos) -> List<SavedTick> {
    var out = List<SavedTick>()
    for t in ticks {
        if t.x >> 4 == pos.x and t.z >> 4 == pos.z {
            out.push(SavedTick { kind: t.kind, x: t.x, y: t.y, z: t.z, delay: t.delay, priority: t.priority })
        }
    }
    return out
}

fn ticks_tag(ticks: List<SavedTick>, names: Names) -> Tag {
    var out = List<Tag>()
    for t in ticks {
        var fields = JavaHashMap<String, Tag>()
        fields.insert("i", names.encode(t.kind))
        fields.insert("x", Tag.Int(t.x))
        fields.insert("y", Tag.Int(t.y))
        fields.insert("z", Tag.Int(t.z))
        fields.insert("t", Tag.Int(t.delay))
        fields.insert("p", Tag.Int(t.priority))
        out.push(Tag.Compound(fields))
    }
    return Tag.List(out)
}

// The upgrade data in `fields`, as vanilla's `UpgradeData` reads it for a world of `sections`
// sections.
fn read_upgrade(format: ChunkFormat, fields: JavaHashMap<String, Tag>, sections: i32, lines: mut List<Entry>) -> Upgrade {
    var indices = List<List<i32>?>()
    for i in 0..sections {
        var index: List<i32>? = none
        if fields.contains("Indices") {
            match fields["Indices"] {
                Tag.Compound(by_section) => {
                    let key = "{i}"
                    if by_section.contains(key) {
                        match by_section[key] {
                            Tag.IntArray(values) => index = some(values.copy()),
                            _ => {},
                        }
                    }
                },
                _ => {},
            }
        }
        indices.push(index)
    }
    let sides = u8.wrap(int_or(fields, "Sides", 0) & 0xFF)
    let block_ticks = read_ticks(fields, "neighbor_block_ticks", format.states.blocks, some(format.air_block), mut lines)
    let fluid_ticks = read_ticks(fields, "neighbor_fluid_ticks", format.fluids, some(format.empty_fluid), mut lines)
    return Upgrade { indices: indices, sides: sides, neighbor_block_ticks: block_ticks, neighbor_fluid_ticks: fluid_ticks }
}

fn upgrade_tag(format: ChunkFormat, upgrade: Upgrade) -> Tag {
    var fields = JavaHashMap<String, Tag>()
    var indices = JavaHashMap<String, Tag>()
    for i in 0..upgrade.indices.len() {
        if let values = upgrade.indices[i] {
            if not values.is_empty() {
                indices.insert("{i}", Tag.IntArray(values.copy()))
            }
        }
    }
    if not indices.is_empty() {
        fields.insert("Indices", Tag.Compound(indices))
    }
    fields.insert("Sides", Tag.Byte(i8.wrap(upgrade.sides)))
    if not upgrade.neighbor_block_ticks.is_empty() {
        fields.insert("neighbor_block_ticks", ticks_tag(upgrade.neighbor_block_ticks, format.states.blocks))
    }
    if not upgrade.neighbor_fluid_ticks.is_empty() {
        fields.insert("neighbor_fluid_ticks", ticks_tag(upgrade.neighbor_fluid_ticks, format.fluids))
    }
    return Tag.Compound(fields)
}

// Blending data as `BlendingData.Packed.CODEC` reads it, or why it can't be.
fn read_blending(tag: Tag) -> Blending ! String {
    match tag {
        Tag.Compound(fields) => {
            var problems = List<String>()
            let min_section = int_field(tag, fields, "min_section", mut problems)
            let max_section = int_field(tag, fields, "max_section", mut problems)
            if not problems.is_empty() {
                fail newest_first(problems)
            }
            // A list of heights that isn't all numbers is left out, as if it weren't there.
            var heights: List<f32>? = none
            if fields.contains("heights") {
                heights = floats_of(fields["heights"])
            }
            if let h = heights {
                if h.len() != 16 {
                    fail "heights has to be of length 16"
                }
            }
            return Blending { min_section: min_section, max_section: max_section, heights: heights }
        },
        _ => fail "Not a map: {tag.to_snbt()}",
    }
}

fn blending_tag(blending: Blending) -> Tag {
    var fields = JavaHashMap<String, Tag>()
    fields.insert("min_section", Tag.Int(blending.min_section))
    fields.insert("max_section", Tag.Int(blending.max_section))
    if let heights = blending.heights {
        var list = List<Tag>()
        for h in heights {
            list.push(Tag.float(h))
        }
        fields.insert("heights", Tag.List(list))
    }
    return Tag.Compound(fields)
}

// Below-zero retrogen as `BelowZeroRetrogen.CODEC` reads it, or why it can't be.
fn read_retrogen(format: ChunkFormat, tag: Tag) -> Retrogen ! String {
    match tag {
        Tag.Compound(fields) => {
            if not fields.contains("target_status") {
                fail no_key("target_status", tag)
            }
            let status = try format.statuses.decode(fields["target_status"])
            if status == format.empty_status {
                fail "target_status cannot be empty"
            }
            // Missing bedrock that isn't a list of numbers is left out, as if it weren't there.
            var bedrock = List<i64>()
            if fields.contains("missing_bedrock") {
                if let longs = longs_view(fields["missing_bedrock"]) {
                    bedrock = longs
                }
            }
            while bedrock.len() > 0 and bedrock[bedrock.len() - 1] == 0 {
                _ = bedrock.pop()
            }
            return Retrogen { target_status: status, missing_bedrock: bedrock }
        },
        _ => fail "Not a map: {tag.to_snbt()}",
    }
}

fn retrogen_tag(format: ChunkFormat, retrogen: Retrogen) -> Tag {
    var fields = JavaHashMap<String, Tag>()
    fields.insert("target_status", format.statuses.encode(retrogen.target_status))
    if not retrogen.missing_bedrock.is_empty() {
        fields.insert("missing_bedrock", Tag.LongArray(retrogen.missing_bedrock.copy()))
    }
    return Tag.Compound(fields)
}

// A section's blocks to update after generation, as `parse` reads them: a list's numbers as
// shorts, 0 for anything else, and none for anything but a list, or an empty one.
fn offsets(tag: Tag) -> List<i16>? {
    match tag {
        Tag.List(items) => {
            if items.is_empty() {
                return none
            }
            var out = List<i16>()
            for item in items {
                out.push(item.short_value() ?? 0i16)
            }
            return some(out)
        },
        _ => return none,
    }
}

// The compounds in a list, as `getList(...).stream().flatMap(ListTag::compoundStream)` keeps
// them, or none for anything but a list.
fn compounds(taken: own Tag?) -> List<Tag> {
    var out = List<Tag>()
    match taken {
        some(Tag.List(items)) => {
            var rest = reversed(items)
            while let t = rest.pop() {
                if is_compound(t) {
                    out.push(t)
                }
            }
        },
        _ => {},
    }
    return out
}

// `items` the other way round, so that popping them gives them in their order.
fn reversed(items: own List<Tag>) -> List<Tag> {
    var rest = items
    var out = List<Tag>()
    out.reserve(rest.len())
    while let t = rest.pop() {
        out.push(t)
    }
    return out
}

// The numbers `Codec.LONG_STREAM` reads from `tag`, for a container's data: a long array as it
// is, without a copy, the other arrays widened, and a list's numbers if every element is one.
fn longs_of(tag: own Tag) -> List<i64>? {
    match tag {
        Tag.LongArray(values) => return some(values),
        _ => return longs_view(tag),
    }
}

fn longs_view(tag: Tag) -> List<i64>? {
    var out = List<i64>()
    match tag {
        Tag.LongArray(values) => return some(values.copy()),
        Tag.IntArray(values) => {
            for v in values {
                out.push(i64(v))
            }
        },
        Tag.ByteArray(values) => {
            for v in values {
                out.push(i64(v))
            }
        },
        Tag.List(items) => {
            for item in items {
                let v = item.number_long() else return none
                out.push(v)
            }
        },
        _ => return none,
    }
    return some(out)
}

// The numbers `Codec.FLOAT.listOf()` reads from `tag`, if every element is one.
fn floats_of(tag: Tag) -> List<f32>? {
    var out = List<f32>()
    match tag {
        Tag.List(items) => {
            for item in items {
                let v = item.number_float() else return none
                out.push(v)
            }
        },
        Tag.ByteArray(values) => {
            for v in values {
                out.push(f32(v))
            }
        },
        Tag.IntArray(values) => {
            for v in values {
                out.push(f32.nearest(v))
            }
        },
        Tag.LongArray(values) => {
            for v in values {
                out.push(f32.nearest(v))
            }
        },
        _ => return none,
    }
    return some(out)
}

// The field `key` of the compound `map`, whose tags are `fields`, as `Codec.INT.fieldOf` reads it,
// or 0 with why it can't be in `problems`.
fn int_field(map: Tag, fields: JavaHashMap<String, Tag>, key: String, problems: mut List<String>) -> i32 {
    if not fields.contains(key) {
        problems.push(no_key(key, map))
        return 0
    }
    if let v = fields[key].number_int() {
        return v
    }
    problems.push(String("Not a number"))
    return 0
}

/// What `MapCodec.fieldOf` fails with when the compound `map` has no `key`.
pub fn no_key(key: String, map: Tag) -> String {
    return "No key {key} in MapLike[{map.to_snbt()}]"
}

/// What `CompoundTag.read` logs when the field `key`, holding `tag`, can't be read.
pub fn field_error(key: String, tag: Tag, message: String) -> String {
    return "Failed to read field ({key}={tag.to_logged()}): {message}"
}

/// Errors as DataFixerUpper joins those of a record's fields or a list's elements: the last
/// first.
pub fn newest_first(errors: List<String>) -> String {
    var out = String()
    var i = errors.len()
    while i > 0 {
        i -= 1
        out.push_str(errors[i])
        if i > 0 {
            out.push_str("; ")
        }
    }
    return out
}

// `message` after a list's errors, as `DataResult.flatMap` appends a failure to a partial result.
fn with_errors(errors: List<String>, message: String) -> String {
    if errors.is_empty() {
        return message.copy()
    }
    return "{newest_first(errors)}; {message}"
}

/// Whether a chunk's root was saved by this version, its `DataVersion` this one's: a chunk the
/// generator carries on from has to be, as Calcite doesn't upgrade one saved part-way (D334).
pub fn this_version(root: JavaHashMap<String, Tag>) -> bool {
    return int_or(root, "DataVersion", 0) == DATA_VERSION
}

/// Whether a chunk's root holds no tag but those a chunk Calcite saves whole writes, at this
/// data version, for `ChunkData.whole`: what it reads of them is all that's there (D258).
pub fn written_whole(root: JavaHashMap<String, Tag>) -> bool {
    if int_or(root, "DataVersion", 0) != DATA_VERSION {
        return false
    }
    let names: List<String> = ["DataVersion", "xPos", "yPos", "zPos", "LastUpdate", "InhabitedTime", "Status", "sections", "isLightOn", "block_entities", "block_ticks", "fluid_ticks", "PostProcessing", "Heightmaps", "structures"]
    var known: usize = 0
    for name in names {
        if root.contains(name) {
            known += 1
        }
    }
    return known == root.len()
}

// Layer `i`'s light, taken from `layers`, as a save's bytes, or `none` if there's none there.
fn signed_layer(layers: mut List<List<u8>?>, i: usize) -> List<i8>? {
    if i >= layers.len() {
        return none
    }
    let bytes = layers[i].take() else return none
    let n = bytes.len()
    var out = List<i8>()
    out.reserve(n)
    // Straight into the room made, with no check a byte, as a save's light is much of its bytes
    // (D305).
    unsafe {
        let from = bytes.as_ptr()
        let to = out.as_mut_ptr()
        for k in 0usize..n {
            to.add(k).write(i8.wrap(from.add(k).read()))
        }
        out.set_len(n)
    }
    return some(out)
}

fn int_or(tags: JavaHashMap<String, Tag>, key: String, fallback: i32) -> i32 {
    if tags.contains(key) {
        if let v = tags[key].int_value() {
            return v
        }
    }
    return fallback
}

fn long_or(tags: JavaHashMap<String, Tag>, key: String, fallback: i64) -> i64 {
    if tags.contains(key) {
        if let v = tags[key].long_value() {
            return v
        }
    }
    return fallback
}

fn byte_or(tags: JavaHashMap<String, Tag>, key: String, fallback: i8) -> i8 {
    if tags.contains(key) {
        if let v = tags[key].byte_value() {
            return v
        }
    }
    return fallback
}

fn is_string(tag: Tag) -> bool {
    return match tag {
        Tag.Str(_) => true,
        _ => false,
    }
}

fn is_compound(tag: Tag) -> bool {
    return match tag {
        Tag.Compound(_) => true,
        _ => false,
    }
}

// The fewest bits that number `n` values.
fn ceil_log2(n: usize) -> i32 {
    var bits: i32 = 0
    while (1u64 << bits) < u64(n) {
        bits += 1
    }
    return bits
}

// Where the built-in registry `name` is among those of `registries`.
fn builtin(registries: Registries, name: String) -> usize ! String {
    let i = registries.find_builtin(name) else fail "there's no {name} registry"
    return i
}
