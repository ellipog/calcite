/// A player's profile: their UUID, name and signed properties, such as their skin, as authlib's
/// `GameProfile` holds them and vanilla's `ByteBufCodecs.GAME_PROFILE` writes them.
module auth.profile

import java.uuid.{Uuid}
import protocol.codegen.{wire}

/// A player's profile, as the login's last packet gives it.
@wire
pub struct GameProfile {
    pub id: Uuid
    @max(16)
    pub name: String
    /// In the order they were given. Vanilla keeps them in a multimap by name, which writes
    /// properties with the same name together; the session server gives one of each.
    @max(16)
    pub properties: List<ProfileProperty>
}

/// One of a profile's properties, such as `textures`, with the session server's signature of
/// its value when it has one.
@wire
pub struct ProfileProperty {
    @max(64)
    pub name: String
    pub value: String
    @max(1024)
    pub signature: String?
}
