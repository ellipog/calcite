/// A player's profile: their UUID, name and signed properties, such as their skin, as authlib's
/// `GameProfile` holds them and vanilla's `ByteBufCodecs.GAME_PROFILE` writes them.
module auth.profile

import java.uuid.{Uuid}
import protocol.codegen.{wire}

/// A player's profile, as the login's last packet gives it.
@wire
pub struct GameProfile {
    pub id: Uuid
    @max(16)
    pub name: String
    /// In the order they were given. Vanilla keeps them in a multimap by name, which writes
    /// properties with the same name together; the session server gives one of each.
    @max(16)
    pub properties: List<ProfileProperty>
}

impl GameProfile {
    /// The profile of a player the server doesn't authenticate, as vanilla's
    /// `UUIDUtil.createOfflineProfile`: the name, and the UUID made from `OfflinePlayer:` and the
    /// name.
    pub fn offline(name: String) -> GameProfile {
        let id = Uuid.name_based("OfflinePlayer:{name}".to_bytes())
        return GameProfile { id: id, name: name.copy(), properties: List<ProfileProperty>() }
    }
}

/// Whether vanilla's `StringUtil.isValidPlayerName` takes the name: at most 16 UTF-16 units,
/// each a printable ASCII character other than a space.
pub fn is_valid_name(name: String) -> bool {
    if name.utf16_len() > 16 {
        return false
    }
    for i in 0..name.len() {
        let b = name.byte_at(i)
        if b <= 32 or b >= 127 {
            return false
        }
    }
    return true
}

/// One of a profile's properties, such as `textures`, with the session server's signature of
/// its value when it has one.
@wire
pub struct ProfileProperty {
    @max(64)
    pub name: String
    pub value: String
    @max(1024)
    pub signature: String?
}
