/// Data packs and the files in them, as vanilla's `ResourceManager` lists them: each file under
/// `data/<namespace>/`, named by an identifier of its namespace and path, packs later in the list
/// over earlier ones, and lists in `Identifier` order, path first and then namespace.
module pack.resources

import pack.zip.{Zip}
import protocol.codegen.{wire}
import resources.identifier.{Identifier}

/// A pack the client may have too, so what's in it needn't be sent: vanilla's `KnownPack`. It
/// goes over the wire as its three strings, in configuration's `select_known_packs`.
@wire
pub struct KnownPack {
    pub namespace: String
    pub id: String
    pub version: String
}

/// A data pack.
pub struct Pack {
    /// Its ID, which logs name it by: `vanilla` for the built-in pack.
    pub id: String
    /// Whether the client may know it, as vanilla's `core` pack, which every client of the same
    /// version has.
    pub known: KnownPack?
    zip: Zip
    // Each file under data/, sorted, and its index in `zip`.
    files: List<PackFile>
}

struct PackFile {
    id: Identifier
    index: usize
}

// Vanilla's order of identifiers, its `compareTo`: by path, then by namespace. Identifiers are
// ASCII, so comparing bytes is comparing Java's UTF-16 units.
impl Order for PackFile {
    fn cmp(self, other: Self) -> Ordering {
        return order(self.id, other.id)
    }
}

/// Vanilla's order of identifiers, its `compareTo`: by path, then by namespace.
pub fn order(a: Identifier, b: Identifier) -> Ordering {
    let by_path = a.path.cmp(b.path)
    if by_path != Ordering.Equal {
        return by_path
    }
    return a.namespace.cmp(b.namespace)
}

impl Pack {
    /// The data pack in a zip archive, such as the jar bundled in Mojang's server jar, whose
    /// files are under `data/`. Files whose names aren't identifiers are left out, as vanilla
    /// leaves them out with a warning.
    pub fn from_zip(id: own String, known: own KnownPack?, zip: own Zip) -> Pack {
        var files = List<PackFile>()
        for i in 0..zip.len() {
            let name = zip.name(i)
            if not name.starts_with("data/") or name.ends_with("/") {
                continue
            }
            let rest = name[5..]
            let slash = rest.find("/") else continue
            match Identifier.parse("{rest[..slash]}:{rest[slash + 1..]}") {
                ok(file) => files.push(PackFile { id: file, index: i }),
                err(_) => {},
            }
        }
        files.sort()
        return Pack { id: id, known: known, zip: zip, files: files }
    }
}

/// A file in a pack: its identifier, such as `minecraft:tags/block/logs.json`, and where it is.
pub struct Resource {
    pub id: Identifier
    /// The pack it's in, by its place in the list.
    pub pack: usize
    file: usize
}

/// The files with one identifier, from each pack that has one, earliest first.
pub struct Stack {
    pub id: Identifier
    pub resources: List<Resource>
}

/// The packs, earliest first, so a later one's file stands in for an earlier one's.
pub struct Resources {
    packs: List<Pack>
}

impl Resources {
    pub fn new(packs: own List<Pack>) -> Resources {
        return Resources { packs: packs }
    }

    /// The ID of the pack at `i`.
    pub fn pack_id(self, i: usize) -> String {
        return self.packs[i].id.copy()
    }

    /// What each pack is to a client that may know it, by its place in the list, or `none` for
    /// one no client knows.
    pub fn pack_info(self) -> List<KnownPack?> {
        var out = List<KnownPack?>()
        for p in self.packs {
            out.push(p.known.copy())
        }
        return out
    }

    /// The packs the client may know, in order, as vanilla's `listPacks` gives their
    /// `knownPackInfo`.
    pub fn known_packs(self) -> List<KnownPack> {
        var out = List<KnownPack>()
        for p in self.packs {
            if let k = p.known {
                out.push(k.copy())
            }
        }
        return out
    }

    /// The files under `directory` in each namespace, in it or a folder in it, whose paths end
    /// with `suffix`, from the last pack that has each, in vanilla's order: its `listResources`.
    pub fn list(self, directory: String, suffix: String) -> List<Resource> {
        var out = List<Resource>()
        for s in self.stacks(directory, suffix) {
            let last = s.resources.len() - 1
            out.push(s.resources[last].copy())
        }
        return out
    }

    /// The files `list` gives, each with every pack's file of that identifier: vanilla's
    /// `listResourceStacks`.
    pub fn stacks(self, directory: String, suffix: String) -> List<Stack> {
        var found = List<Resource>()
        let prefix = "{directory}/"
        for p in 0..self.packs.len() {
            // The files are in path order, so those under the directory are together.
            var i = first_at_least(self.packs[p].files, prefix)
            let n = self.packs[p].files.len()
            while i < n and self.packs[p].files[i].id.path.starts_with(prefix) {
                if self.packs[p].files[i].id.path.ends_with(suffix) {
                    found.push(Resource { id: self.packs[p].files[i].id.copy(), pack: p, file: self.packs[p].files[i].index })
                }
                i += 1
            }
        }
        found.sort()
        var out = List<Stack>()
        for r in found {
            let n = out.len()
            if n > 0 and out[n - 1].id == r.id {
                out[n - 1].resources.push(r.copy())
            } else {
                out.push(Stack { id: r.id.copy(), resources: [r.copy()] })
            }
        }
        return out
    }

    /// What the file holds, or why it can't be read.
    pub fn read(self, r: Resource) -> List<u8> ! String {
        return try self.packs[r.pack].zip.read(r.file)
    }
}

// Resources sort by identifier, then by pack, so a stack's files go earliest pack first.
impl Order for Resource {
    fn cmp(self, other: Self) -> Ordering {
        let by_id = order(self.id, other.id)
        if by_id != Ordering.Equal {
            return by_id
        }
        return self.pack.cmp(other.pack)
    }
}

// The first file whose path isn't before `prefix`.
fn first_at_least(files: List<PackFile>, prefix: String) -> usize {
    var low: usize = 0
    var high = files.len()
    while low < high {
        let mid = low + (high - low) / 2
        if files[mid].id.path < prefix {
            low = mid + 1
        } else {
            high = mid
        }
    }
    return low
}
