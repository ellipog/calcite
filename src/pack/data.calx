/// A world's data files by their paths in a pack, such as
/// `data/minecraft/worldgen/noise_settings/overworld.json`, each the file of the top pack that has
/// it, as a `ResourceManager` gives a registry entry's file. Worldgen reads its density functions,
/// noise settings, features, structures and templates through it, so a world's packs change them
/// as they change them in vanilla (CAL-92). It reads as a `Zip` does, by index or by name, so
/// vanilla's own data, a single archive, is one too.
module pack.data

import std.zip.{Zip}

/// Where a file's bytes are: an entry of one of the archives, or read already, from a folder.
pub enum Place {
    Archive(usize, usize)
    Bytes(List<u8>)
}

/// The files, sorted by path, and the archives they're in.
pub struct Data {
    zips: List<Zip>
    paths: List<String>
    places: List<Place>
    found: Map<String, usize>
}

impl Data {
    /// Every file of `zip`, as vanilla's own data is one archive.
    pub fn of_zip(zip: own Zip) -> Data {
        var files = List<(String, Place)>()
        for i in 0..zip.len() {
            let name = zip.name(i)
            if not name.ends_with("/") {
                files.push((name, Place.Archive(0, i)))
            }
        }
        return Data.new([zip], files)
    }

    /// The files `files`, each a path and where its bytes are in `zips`. A path given twice is
    /// the last one's.
    pub fn new(zips: own List<Zip>, files: own List<(String, Place)>) -> Data {
        var found = Map<String, usize>()
        var order = List<(String, usize)>()
        for i in 0..files.len() {
            if not found.contains(files[i].0) {
                order.push((files[i].0.copy(), i))
            }
            found.insert(files[i].0.copy(), i)
        }
        order.sort()
        var paths = List<String>()
        var places = List<Place>()
        var at = Map<String, usize>()
        for (path, _) in order {
            let i = found[path]
            at.insert(path.copy(), paths.len())
            paths.push(path.copy())
            places.push(files[i].1.copy())
        }
        return Data { zips: zips, paths: paths, places: places, found: at }
    }

    /// How many files there are.
    pub fn len(self) -> usize {
        return self.paths.len()
    }

    /// The path of the file at `i`, in order of the paths.
    pub fn name(self, i: usize) -> String {
        return self.paths[i].copy()
    }

    /// Where the file at `path` is, or `none`.
    pub fn find(self, path: String) -> usize? {
        return self.found.get(path)
    }

    /// The bytes of the file at `i`.
    pub fn read(self, i: usize) -> List<u8> ! String {
        return match self.places[i] {
            Place.Archive(z, entry) => try self.zips[z].read(entry),
            Place.Bytes(b) => b.copy(),
        }
    }

    /// The bytes of the file at `path`, or why there aren't any.
    pub fn read_named(self, path: String) -> List<u8> ! String {
        let i = self.find(path) else fail "there's no {path}"
        return try self.read(i)
    }
}
