/// What vanilla's data fixes are written with: when a fix runs for data saved by an older game,
/// and DataFixerUpper's `Dynamic` operations on a compound, as the fixes use them.
module datafix.util

import nbt.tag.{Tag}
import resources.identifier.{Identifier}

/// Whether the fix of schema `version`, subversion `sub`, runs for data saved at data version
/// `from`. DataFixerUpper's `getRule` runs each fix whose key, `version * 10 + sub`, is past the
/// last fix's key at or before `from * 10`, which is the same as past `from * 10`.
pub fn runs(from: i32, version: i32, sub: i32) -> bool {
    return version * 10 + sub > from * 10
}

/// `NamespacedSchema.ensureNamespaced`: `id` with `minecraft:` before it if it has no namespace
/// and is an identifier, or `id` itself if it isn't one.
pub fn namespaced(id: String) -> String {
    return match Identifier.parse(id) {
        ok(i) => i.to_string(),
        err(_) => id.copy(),
    }
}

/// `renameField`: the value at `from` moved to `to`, if there is one.
pub fn rename(m: mut JavaHashMap<String, Tag>, from: str, to: str) {
    if let v = m.remove(from) {
        m.insert(String(to), v)
    }
}

/// The string at `key`, if it's a string.
pub fn string_at(m: JavaHashMap<String, Tag>, key: str) -> String? {
    if not m.contains(key) {
        return none
    }
    return match m[key] {
        Tag.Str(s) => some(s.copy()),
        _ => none,
    }
}

/// The compound at `key`, taken out, if it's a compound; anything else stays.
pub fn take_compound(m: mut JavaHashMap<String, Tag>, key: str) -> JavaHashMap<String, Tag>? {
    if not m.contains(key) {
        return none
    }
    match m[key] {
        Tag.Compound(_) => {},
        _ => return none,
    }
    return match m.remove(key) {
        some(Tag.Compound(c)) => some(c),
        _ => none,
    }
}

/// The list at `key`, taken out, if it's a list; anything else stays.
pub fn take_list(m: mut JavaHashMap<String, Tag>, key: str) -> List<Tag>? {
    if not m.contains(key) {
        return none
    }
    match m[key] {
        Tag.List(_) => {},
        _ => return none,
    }
    return match m.remove(key) {
        some(Tag.List(l)) => some(l),
        _ => none,
    }
}

/// `Dynamic.asInt(fallback)`: the number at `key` as an `int`, or `fallback`.
pub fn int_or(m: JavaHashMap<String, Tag>, key: str, fallback: i32) -> i32 {
    if not m.contains(key) {
        return fallback
    }
    return m[key].number_int() ?? fallback
}

/// `Dynamic.asBoolean(fallback)`: a number at `key` is true unless it's 0, as `NbtOps` reads a
/// boolean, and anything else is `fallback`.
pub fn bool_or(m: JavaHashMap<String, Tag>, key: str, fallback: bool) -> bool {
    if not m.contains(key) {
        return fallback
    }
    return match m[key].number_int() {
        some(v) => v != 0,
        none => fallback,
    }
}

/// `ExtraDataFixUtils.dyeColorIdToName`: a dye color's name from its old ID, white past them.
pub fn dye_color(id: i32) -> String {
    let names: List<str> = ["white", "orange", "magenta", "light_blue", "yellow", "lime", "pink", "gray", "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black"]
    if id >= 0 and id < 16 {
        return String(names[usize.wrap(id)])
    }
    return String("white")
}

/// `ExtraDataFixUtils.fixBlockPos`: a compound of numbers `X`, `Y` and `Z` as an int array, or
/// the tag as it was.
pub fn block_pos(t: Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            if not m.contains("X") or not m.contains("Y") or not m.contains("Z") {
                return t.copy()
            }
            let x = m["X"].number_int() else return t.copy()
            let y = m["Y"].number_int() else return t.copy()
            let z = m["Z"].number_int() else return t.copy()
            return Tag.IntArray([x, y, z])
        },
        _ => return t.copy(),
    }
}

/// `renameAndFixField(from, to, ExtraDataFixUtils::fixBlockPos)`.
pub fn rename_block_pos(m: mut JavaHashMap<String, Tag>, from: str, to: str) {
    if let v = m.remove(from) {
        m.insert(String(to), block_pos(v))
    }
}

/// `ExtraDataFixUtils.fixInlineBlockPos`: the numbers at `fx`, `fy` and `fz` as one int array at
/// `to`, if all three are numbers.
pub fn inline_block_pos(m: mut JavaHashMap<String, Tag>, fx: str, fy: str, fz: str, to: str) {
    if not m.contains(fx) or not m.contains(fy) or not m.contains(fz) {
        return
    }
    let x = m[fx].number_int() else return
    let y = m[fy].number_int() else return
    let z = m[fz].number_int() else return
    _ = m.remove(fx)
    _ = m.remove(fy)
    _ = m.remove(fz)
    m.insert(String(to), Tag.IntArray([x, y, z]))
}
