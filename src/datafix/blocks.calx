/// Vanilla's data fixes of blocks since 1.17: a block state as a compound (`BLOCK_STATE`), as a
/// template's palette holds it, and as a string (`FLAT_BLOCK_STATE`), as a jigsaw's final state
/// is, each upgraded from the data version it was saved at.
module datafix.blocks

import datafix.util.{namespaced, rename, runs, string_at}
import nbt.tag.{Tag}

// `createRenamer`'s rename: `to` if `id`, namespaced, is `of`, else `id` as it was.
fn rename_one(id: String, of: str, to: str) -> String {
    return if namespaced(id) == String(of) { String(to) } else { id.copy() }
}

/// The renames of blocks since 1.17, `LegacyBlockRenameFix`s, each for data from before its
/// schema, in order.
fn rename_block(id: String, from: i32) -> String {
    var now = id.copy()
    if runs(from, 2700, 0) {
        now = rename_one(now, "minecraft:cave_vines_head", "minecraft:cave_vines")
        now = rename_one(now, "minecraft:cave_vines_body", "minecraft:cave_vines_plant")
    }
    if runs(from, 2717, 0) {
        now = rename_one(now, "minecraft:azalea_leaves_flowers", "minecraft:flowering_azalea_leaves")
    }
    if runs(from, 3692, 0) {
        now = rename_one(now, "minecraft:grass", "minecraft:short_grass")
    }
    if runs(from, 4541, 0) {
        now = rename_one(now, "minecraft:chain", "minecraft:iron_chain")
    }
    return now
}

/// A block state of a palette, as vanilla's fixes leave it for 26.3: the renames, the property
/// changes, and since 5006 its fields named `id` and `properties`.
pub fn fix_block_state(m: mut JavaHashMap<String, Tag>, from: i32) {
    // `LegacyBlockRenameFix` for `block_state`: `Name`, if it's a string.
    if let name = string_at(m, "Name") {
        m.insert(String("Name"), Tag.Str(rename_block(name, from)))
    }
    // `LegacyBlockPropertyRenameAndFix`s, on `Properties` where the block, namespaced, is theirs.
    if runs(from, 4294, 0) {
        fix_property(mut m, "minecraft:creaking_heart", "active", "creaking_heart_state", true)
    }
    if runs(from, 4305, 0) {
        fix_property(mut m, "minecraft:test_block", "test_block_mode", "mode", false)
    }
    // `BlockStateFieldNamesFix`.
    if runs(from, 5006, 0) {
        rename(mut m, "Name", "id")
        rename(mut m, "Properties", "properties")
    }
}

// The property `old` of the block `block` renamed `new`, its value made `awake` or `uprooted`
// from `true` or anything else where `creaking`, or kept.
fn fix_property(m: mut JavaHashMap<String, Tag>, block: str, old: str, new: str, creaking: bool) {
    let name = string_at(m, "Name") else return
    if namespaced(name) != String(block) or not m.contains("Properties") {
        return
    }
    match m.remove("Properties") {
        some(Tag.Compound(p)) => {
            var props = p
            if let v = props.remove(old) {
                // `dynamic.asString("")`: a value that isn't a string is "".
                let text = match v {
                    Tag.Str(s) => s.copy(),
                    _ => String(),
                }
                let value = if creaking { String(if text == "true" { "awake" } else { "uprooted" }) } else { text }
                props.insert(String(new), Tag.Str(value))
            }
            m.insert(String("Properties"), Tag.Compound(props))
        },
        some(other) => m.insert(String("Properties"), other),
        none => {},
    }
}

/// A block state written as a string, `minecraft:name[a=b]{...}`, as vanilla's fixes leave it:
/// the renames, of the name before the first `[` or `{` past its start.
pub fn fix_flat_block_state(text: String, from: i32) -> String {
    var end = text.len()
    if let p = text.find("[") {
        if p > 0 {
            end = p
        }
    }
    if let b = text.find("\{") {
        if b > 0 and b < end {
            end = b
        }
    }
    let name = text[..end]
    return "{rename_block(name, from)}{text[end..]}"
}
