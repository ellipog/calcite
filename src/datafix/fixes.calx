fn named_modifier(name: String) -> String? {
    let named: List<(str, str)> = [
        ("Random spawn bonus", "random_spawn_bonus"),
        ("Random zombie-spawn bonus", "zombie_random_spawn_bonus"),
        ("Leader zombie bonus", "leader_zombie_bonus"),
        ("Zombie reinforcement callee charge", "reinforcement_callee_charge"),
        ("Zombie reinforcement caller charge", "reinforcement_caller_charge"),
    ]
    for (n, id) in named {
        if name == String(n) {
            return some("minecraft:{id}")
        }
    }
    return none
}

// `EntityAttributeBaseValueFix`: the follow range's base `was` made `now`.
fn follow_range(c: mut JavaHashMap<String, Tag>, was: f64, now: f64) {
    match c.remove("attributes") {
        some(Tag.List(attrs)) => {
            var out = List<Tag>()
            var attrs_left = reversed(attrs)
            while let a = attrs_left.pop() {
                out.push(match a {
                    Tag.Compound(am) => {
                        var ac = am
                        if namespaced(string_at(ac, "id") ?? String()) == "minecraft:follow_range" {
                            let base = if ac.contains("base") { ac["base"].number_double() ?? 0.0 } else { 0.0 }
                            ac.insert(String("base"), Tag.Double(if base == was { now } else { base }))
                        }
                        Tag.Compound(ac)
                    },
                    other => other,
                })
            }
            c.insert(String("attributes"), Tag.List(out))
        },
        some(other) => {
            // `asStream` of what isn't a list is empty, and the list made of it is too.
            _ = other
            c.insert(String("attributes"), Tag.List([]))
        },
        none => {},
    }
}

// `DropChancesFormatFix`.
fn drop_chances(c: mut JavaHashMap<String, Tag>) {
    let armor = chances(c, "ArmorDropChances")
    let hand = chances(c, "HandDropChances")
    var body = 0.085f32
    if c.contains("body_armor_drop_chance") {
        if let f = c["body_armor_drop_chance"].number_float() {
            body = f
        }
    }
    _ = c.remove("ArmorDropChances")
    _ = c.remove("HandDropChances")
    _ = c.remove("body_armor_drop_chance")
    var slots = JavaHashMap<String, Tag>()
    let armor_names: List<str> = ["feet", "legs", "chest", "head"]
    for i in 0..armor_names.len() {
        if i < armor.len() and armor[i] != 0.085f32 {
            slots.insert(String(armor_names[i]), Tag.Float(armor[i]))
        }
    }
    let hand_names: List<str> = ["mainhand", "offhand"]
    for i in 0..hand_names.len() {
        if i < hand.len() and hand[i] != 0.085f32 {
            slots.insert(String(hand_names[i]), Tag.Float(hand[i]))
        }
    }
    if body != 0.085f32 {
        slots.insert(String("body"), Tag.Float(body))
    }
    if not slots.is_empty() {
        c.insert(String("drop_chances"), Tag.Compound(slots))
    }
}

// `parseDropChances`: each element's `asFloat(0.085F)`.
fn chances(c: JavaHashMap<String, Tag>, key: str) -> List<f32> {
    var out = List<f32>()
    if not c.contains(key) {
        return out
    }
    match c[key] {
        Tag.List(items) => {
            for e in items {
                out.push(e.number_float() ?? 0.085f32)
            }
        },
        _ => {},
    }
    return out
}

// `SaddleEquipmentSlotFix`.
// `SaddleEquipmentSlotFix`, which writes and reads again each entity it's for, so their
// remainders are as it leaves them.
fn saddle(c: mut JavaHashMap<String, Tag>, id: String) {
    let with_item: List<str> = ["horse", "skeleton_horse", "zombie_horse", "donkey", "mule", "camel", "llama", "trader_llama"]
    for e in with_item {
        if id == "minecraft:{e}" {
            if let s = c.remove("SaddleItem") {
                c.insert(String("saddle"), s)
                saddle_drop_chance(mut c)
            }
            keep_remainder(mut c, true)
            return
        }
    }
    if id == "minecraft:pig" or id == "minecraft:strider" {
        let has = bool_or(c, "Saddle", false)
        _ = c.remove("Saddle")
        if has {
            var s = JavaHashMap<String, Tag>()
            s.insert(String("id"), Tag.Str("minecraft:saddle"))
            s.insert(String("count"), Tag.Int(1))
            c.insert(String("saddle"), Tag.Compound(s))
            saddle_drop_chance(mut c)
        }
        keep_remainder(mut c, true)
    }
}

// DataFixerUpper reads a typed field without taking it out of the data around it, the
// remainder, and writes the field back over it; a field the fixes take out of the type without
// taking it out of the remainder too comes back as it was last read. `EquipmentFormatFix` is
// one: `ArmorItems`, `HandItems`, `body_armor_item` and `saddle` stay beside `equipment` as they
// were when the entity was read, which is as the template had them unless a fix since wrote the
// entity and read it again. Each entity keeps them under a key no game data has until then.
fn keep_remainder(c: mut JavaHashMap<String, Tag>, fresh: bool) {
    if not fresh and c.contains("calcite:remainder") {
        return
    }
    var kept = JavaHashMap<String, Tag>()
    for f in ["ArmorItems", "HandItems", "body_armor_item", "saddle"] {
        if c.contains(f) {
            kept.insert(String(f), c[f].copy())
        }
    }
    c.insert(String("calcite:remainder"), Tag.Compound(kept))
}

// The fields `keep_remainder` kept, back as vanilla writes them past `EquipmentFormatFix`.
fn restore_remainder(c: mut JavaHashMap<String, Tag>) {
    match c.remove("calcite:remainder") {
        some(Tag.Compound(kept)) => {
            for (k, v) in kept {
                c.insert(k.copy(), v.copy())
            }
        },
        _ => {},
    }
}

fn saddle_drop_chance(c: mut JavaHashMap<String, Tag>) {
    var d = JavaHashMap<String, Tag>()
    match c.remove("drop_chances") {
        some(Tag.Compound(m)) => d = m,
        some(other) => {
            // `orElseEmptyMap` of what's there keeps it; `set` on what isn't a map fails.
            c.insert(String("drop_chances"), other)
            return
        },
        none => {},
    }
    d.insert(String("saddle"), Tag.Float(2.0f32))
    c.insert(String("drop_chances"), Tag.Compound(d))
}

// `EquipmentFormatFix`: `ArmorItems`, `HandItems`, `body_armor_item` and `saddle` in one
// `equipment`, by slot, leaving out an item with no ID, and the whole of it where all are.
fn equipment(c: mut JavaHashMap<String, Tag>) {
    var armor = List<Tag>()
    match c.remove("ArmorItems") {
        some(Tag.List(l)) => armor = l,
        some(other) => c.insert(String("ArmorItems"), other),
        none => {},
    }
    var hand = List<Tag>()
    match c.remove("HandItems") {
        some(Tag.List(l)) => hand = l,
        some(other) => c.insert(String("HandItems"), other),
        none => {},
    }
    let body = c.remove("body_armor_item")
    let sad = c.remove("saddle")
    var e = JavaHashMap<String, Tag>()
    put_slot(mut e, "mainhand", hand, 0)
    put_slot(mut e, "offhand", hand, 1)
    put_slot(mut e, "feet", armor, 0)
    put_slot(mut e, "legs", armor, 1)
    put_slot(mut e, "chest", armor, 2)
    put_slot(mut e, "head", armor, 3)
    if let b = body {
        e.insert(String("body"), b)
    }
    if let s = sad {
        e.insert(String("saddle"), s)
    }
    if not e.is_empty() {
        c.insert(String("equipment"), Tag.Compound(e))
    }
    restore_remainder(mut c)
}

fn put_slot(e: mut JavaHashMap<String, Tag>, slot: str, items: List<Tag>, i: usize) {
    if i >= items.len() {
        return
    }
    match items[i] {
        Tag.Compound(m) => {
            if m.contains("id") {
                e.insert(String(slot), items[i].copy())
            }
        },
        _ => {},
    }
}

// --- Items ----------------------------------------------------------------------------------

// `EntitySpawnerItemVariantComponentFix`, on an item's components: the variant of a bucket's
// fish or axolotl, or of a painting, out of its entity data into a component of its own.
fn entity_item_variant(c: mut JavaHashMap<String, Tag>, id: String) {
    if id == "minecraft:painting" {
        let data = take_compound(mut c, "minecraft:entity_data") else return
        if string_at(data, "id") != some(String("minecraft:painting")) {
            c.insert(String("minecraft:entity_data"), Tag.Compound(data))
            return
        }
        var rest = data
        let variant = rest.remove("variant")
        // Left out where nothing but its `id` is left.
        if rest.len() > 1 {
            c.insert(String("minecraft:entity_data"), Tag.Compound(rest))
        }
        if let v = variant {
            c.insert(String("minecraft:painting/variant"), v)
        }
        return
    }
    let data = take_compound(mut c, "minecraft:bucket_entity_data") else return
    var b = data
    if id == "minecraft:salmon_bucket" {
        if let size = b.remove("type") {
            c.insert(String("minecraft:salmon/size"), size)
        }
        c.insert(String("minecraft:bucket_entity_data"), Tag.Compound(b))
        return
    }
    let variant_key = if id == "minecraft:axolotl_bucket" { "Variant" } else { "BucketVariantTag" }
    var packed = 0
    var has = false
    if b.contains(variant_key) {
        if let n = b[variant_key].number_int() {
            packed = n
            has = true
        }
    }
    if not has {
        c.insert(String("minecraft:bucket_entity_data"), Tag.Compound(b))
        return
    }
    _ = b.remove(variant_key)
    c.insert(String("minecraft:bucket_entity_data"), Tag.Compound(b))
    if id == "minecraft:axolotl_bucket" {
        let names: List<str> = ["lucy", "wild", "gold", "cyan", "blue"]
        let name = if packed >= 1 and packed <= 4 { names[usize.wrap(packed)] } else { "lucy" }
        c.insert(String("minecraft:axolotl/variant"), Tag.Str(String(name)))
        return
    }
    c.insert(String("minecraft:tropical_fish/pattern"), Tag.Str(String(fish_pattern(packed & 65535))))
    c.insert(String("minecraft:tropical_fish/base_color"), Tag.Str(dye_color((packed >> 16) & 255)))
    c.insert(String("minecraft:tropical_fish/pattern_color"), Tag.Str(dye_color((packed >> 24) & 255)))
}

// A tropical fish's pattern from the low 16 bits of its old packed variant.
fn fish_pattern(n: i32) -> str {
    let patterns: List<(i32, str)> = [(1, "flopper"), (256, "sunstreak"), (257, "stripey"), (512, "snooper"), (513, "glitter"), (768, "dasher"), (769, "blockfish"), (1024, "brinely"), (1025, "betty"), (1280, "spotty"), (1281, "clayfish")]
    for (code, name) in patterns {
        if code == n {
            return name
        }
    }
    return "kob"
}

fn item_rule(r: mut Run, c: mut JavaHashMap<String, Tag>) {
    let k = r.key
    let id = namespaced(string_at(c, "id") ?? String())
    if k == 30940 and id == "minecraft:goat_horn" {
        r.unported(String("a goat horn"))
    } else if k == 30970 and (id == "minecraft:writable_book" or id == "minecraft:written_book") {
        if let v = c.remove("tag") {
            c.insert(String("tag"), match v {
                Tag.Compound(tg) => {
                    var tc = tg
                    _ = tc.remove("filtered_title")
                    _ = tc.remove("filtered_pages")
                    Tag.Compound(tc)
                },
                other => other,
            })
        }
    } else if k == 32090 and id.ends_with("_spawn_egg") {
        r.unported(String("a spawn egg"))
    } else if (k == 33220 or k == 35680) and has_tag(c, ["CustomPotionEffects", "custom_potion_effects", "effects", "Effects"]) {
        r.unported(String("an item's effects"))
    } else if k == 38030 {
        tag_lists(mut c, ["Enchantments", "StoredEnchantments"], "id", sweeping)
    } else if k == 38130 and id == "minecraft:compass" {
        if let v = c.remove("tag") {
            c.insert(String("tag"), match v {
                Tag.Compound(tg) => {
                    var tc = tg
                    if let p = tc.remove("LodestonePos") {
                        tc.insert(String("LodestonePos"), block_pos(p))
                    }
                    Tag.Compound(tc)
                },
                other => other,
            })
        }
    } else if k == 38140 {
        tag_lists(mut c, ["AttributeModifiers"], "AttributeName", jump_strength)
    } else if k == 38185 {
        componentize(mut r, mut c)
    } else if k == 38250 {
        if id == "minecraft:white_banner" or id == "minecraft:filled_map" {
            if let v = c.remove("components") {
                c.insert(String("components"), custom_name_override(v, id == "minecraft:white_banner"))
            }
        }
    } else if k == 40540 and id == "minecraft:white_banner" {
        if let v = c.remove("components") {
            c.insert(String("components"), ominous_rarity(v))
        }
    } else if k == 42990 and (id == "minecraft:salmon_bucket" or id == "minecraft:axolotl_bucket" or id == "minecraft:tropical_fish_bucket" or id == "minecraft:painting") {
        if let v = c.remove("components") {
            c.insert(String("components"), match v {
                Tag.Compound(m) => {
                    var cm = m
                    entity_item_variant(mut cm, id)
                    Tag.Compound(cm)
                },
                other => other,
            })
        }
    } else if (k == 50080 or k == 50160) and id == "minecraft:filled_map" {
        r.unported(String("a map"))
    } else if k == 48880 and id == "minecraft:name_tag" {
        r.unported(String("a name tag"))
    }
}

fn has_tag(c: JavaHashMap<String, Tag>, names: List<str>) -> bool {
    if not c.contains("tag") {
        return false
    }
    match c["tag"] {
        Tag.Compound(tg) => {
            for k in names {
                if tg.contains(k) {
                    return true
                }
            }
            return false
        },
        _ => return false,
    }
}

// In each list at `lists` of the item's tag, each element's string at `key` through `f`.
fn tag_lists(c: mut JavaHashMap<String, Tag>, lists: List<str>, key: str, f: fn(String) -> String) {
    let v = c.remove("tag") else return
    c.insert(String("tag"), match v {
        Tag.Compound(tg) => {
            var tc = tg
            for l in lists {
                if let lv = tc.remove(l) {
                    tc.insert(String(l), map_attributes(lv, key, f))
                }
            }
            Tag.Compound(tc)
        },
        other => other,
    })
}

fn sweeping(id: String) -> String {
    return if namespaced(id) == "minecraft:sweeping" { String("minecraft:sweeping_edge") } else { id.copy() }
}

// `ItemStackCustomNameToOverrideComponentFix`: a custom name that's a white banner's ominous
// name, or a filled map's explorer name, as its item name.
fn custom_name_override(t: own Tag, banner: bool) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            if let name = string_at(c, "minecraft:custom_name") {
                if let key = translation_of(name) {
                    var fits = false
                    if banner {
                        fits = key == "block.minecraft.ominous_banner"
                    } else {
                        let maps: List<str> = ["buried_treasure", "explorer_jungle", "explorer_swamp", "mansion", "monument", "trial_chambers", "village_desert", "village_plains", "village_savanna", "village_snowy", "village_taiga"]
                        for n in maps {
                            fits = fits or key == "filled_map.{n}"
                        }
                    }
                    if fits {
                        rename(mut c, "minecraft:custom_name", "minecraft:item_name")
                    }
                }
            }
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// `ItemStackComponentizationFix`: an item's `Count` and `tag` as its `count` and components.
// An item without a string ID and a numeric count stays as it is.
fn componentize(r: mut Run, c: mut JavaHashMap<String, Tag>) {
    let raw_id = string_at(c, "id") else return
    if not c.contains("Count") {
        return
    }
    let count = c["Count"].number_int() else return
    let item_id = namespaced(raw_id)
    var tag = JavaHashMap<String, Tag>()
    match c.remove("tag") {
        some(Tag.Compound(t)) => tag = t,
        some(other) => {
            // `orElseEmptyMap` of what isn't a map is that value; the fixes on it find nothing.
            r.unported(String("an item whose tag isn't a compound"))
            _ = other
        },
        none => {},
    }
    _ = c.remove("id")
    _ = c.remove("Count")
    var s = Stack { item: item_id, tag: tag, components: JavaHashMap<String, Tag>() }
    fix_item_stack(mut r, mut s)
    // `write`, merged over what's left of the item.
    c.insert(String("id"), Tag.Str(s.item.copy()))
    c.insert(String("count"), Tag.Int(count))
    if not s.tag.is_empty() {
        s.components.insert(String("minecraft:custom_data"), Tag.Compound(s.tag.copy()))
    }
    if not s.components.is_empty() {
        c.insert(String("components"), Tag.Compound(s.components.copy()))
    }
}

// `ItemStackData`: the item's ID, what's left of its tag, and its components so far.
struct Stack {
    item: String
    tag: JavaHashMap<String, Tag>
    components: JavaHashMap<String, Tag>
}

impl Stack {
    fn take(mut self, key: str) -> Tag? {
        return self.tag.remove(key)
    }

    fn set(mut self, component: str, value: own Tag) {
        self.components.insert(String(component), value)
    }

    // `moveTagToComponent` with a default: moved unless it's the default.
    fn move_unless(mut self, key: str, component: str, default: Tag) {
        if let v = self.take(key) {
            if v != default {
                self.set(component, v)
            }
        }
    }

    fn move_to(mut self, key: str, component: str) {
        if let v = self.take(key) {
            self.set(component, v)
        }
    }

    // `moveTagInto`: the tag's value at `key` put in `target` at `to`.
    fn move_into(mut self, key: str, target: mut JavaHashMap<String, Tag>, to: str) {
        if let v = self.take(key) {
            target.insert(String(to), v)
        }
    }

    fn is(self, id: str) -> bool {
        return self.item == String(id)
    }
}

fn fix_item_stack(r: mut Run, s: mut Stack) {
    let hide = match s.take("HideFlags") {
        some(t) => t.number_int() ?? 0,
        none => 0,
    }
    s.move_unless("Damage", "minecraft:damage", Tag.Int(0))
    s.move_unless("RepairCost", "minecraft:repair_cost", Tag.Int(0))
    s.move_to("CustomModelData", "minecraft:custom_model_data")
    if let bst = s.take("BlockStateTag") {
        s.set("minecraft:block_state", block_state_tag(bst))
    }
    s.move_to("EntityTag", "minecraft:entity_data")
    // `fixSubTag("BlockEntityTag", false, ...)`.
    if s.tag.contains("BlockEntityTag") {
        match s.tag.remove("BlockEntityTag") {
            some(Tag.Compound(b)) => {
                let inner_id = namespaced(string_at(b, "id") ?? String())
                var be = b
                block_entity_tag(mut r, mut s, mut be, inner_id)
                var without_id = be.copy()
                _ = without_id.remove("id")
                let kept = if without_id.is_empty() { without_id } else { be }
                if not kept.is_empty() {
                    s.tag.insert(String("BlockEntityTag"), Tag.Compound(kept))
                }
            },
            some(other) => {
                r.unported(String("an item's block entity that isn't a compound"))
                s.tag.insert(String("BlockEntityTag"), other)
            },
            none => {},
        }
    }
    s.move_to("BlockEntityTag", "minecraft:block_entity_data")
    if let u = s.take("Unbreakable") {
        if (u.number_int() ?? 0) != 0 {
            var comp = JavaHashMap<String, Tag>()
            if (hide & 4) != 0 {
                comp.insert(String("show_in_tooltip"), Tag.Byte(0))
            }
            s.set("minecraft:unbreakable", Tag.Compound(comp))
        }
    }
    enchantments(mut s, "Enchantments", "minecraft:enchantments", (hide & 1) != 0)
    if s.is("minecraft:enchanted_book") {
        enchantments(mut s, "StoredEnchantments", "minecraft:stored_enchantments", (hide & 32) != 0)
    }
    // `fixSubTag("display", false, ...)`.
    var display = JavaHashMap<String, Tag>()
    var display_other: Tag? = none
    match s.tag.remove("display") {
        some(Tag.Compound(d)) => display = d,
        some(other) => display_other = some(other),
        none => {},
    }
    if let other = display_other {
        r.unported(String("an item's display that isn't a compound"))
        s.tag.insert(String("display"), other)
    } else {
        fix_display(mut s, mut display, hide)
        if not display.is_empty() {
            s.tag.insert(String("display"), Tag.Compound(display))
        }
    }
    predicates(mut s, "CanDestroy", "minecraft:can_break", (hide & 8) != 0)
    predicates(mut s, "CanPlaceOn", "minecraft:can_place_on", (hide & 16) != 0)
    attribute_modifiers(mut s, (hide & 2) != 0)
    if let trim = s.take("Trim") {
        var fixed = trim
        if (hide & 128) != 0 {
            fixed = match fixed {
                Tag.Compound(tm) => {
                    var tc = tm
                    tc.insert(String("show_in_tooltip"), Tag.Byte(0))
                    Tag.Compound(tc)
                },
                other => other,
            }
        }
        s.set("minecraft:trim", fixed)
    }
    if (hide & 32) != 0 {
        s.set("minecraft:hide_additional_tooltip", Tag.Compound(JavaHashMap<String, Tag>()))
    }
    if s.is("minecraft:crossbow") {
        _ = s.take("Charged")
        s.move_unless("ChargedProjectiles", "minecraft:charged_projectiles", Tag.List([]))
    }
    if s.is("minecraft:bundle") {
        s.move_unless("Items", "minecraft:bundle_contents", Tag.List([]))
    }
    if s.is("minecraft:filled_map") {
        s.move_to("map", "minecraft:map_id")
        if s.tag.contains("Decorations") {
            r.unported(String("a map's decorations"))
        }
    }
    let potions: List<str> = ["minecraft:potion", "minecraft:splash_potion", "minecraft:lingering_potion", "minecraft:tipped_arrow"]
    for p in potions {
        if s.is(p) {
            potion_contents(mut s)
        }
    }
    if s.is("minecraft:writable_book") {
        if let pages = book_pages(mut s) {
            var comp = JavaHashMap<String, Tag>()
            comp.insert(String("pages"), pages)
            s.set("minecraft:writable_book_content", Tag.Compound(comp))
        }
    }
    if s.is("minecraft:written_book") {
        written_book(mut s)
    }
    if s.is("minecraft:suspicious_stew") {
        s.move_to("effects", "minecraft:suspicious_stew_effects")
    }
    if s.is("minecraft:debug_stick") {
        s.move_to("DebugProperty", "minecraft:debug_stick_state")
    }
    let buckets: List<str> = ["minecraft:pufferfish_bucket", "minecraft:salmon_bucket", "minecraft:cod_bucket", "minecraft:tropical_fish_bucket", "minecraft:axolotl_bucket", "minecraft:tadpole_bucket"]
    for b in buckets {
        if s.is(b) {
            var data = JavaHashMap<String, Tag>()
            for key in ["NoAI", "Silent", "NoGravity", "Glowing", "Invulnerable", "Health", "Age", "Variant", "HuntingCooldown", "BucketVariantTag"] {
                s.move_into(key, mut data, key)
            }
            if not data.is_empty() {
                s.set("minecraft:bucket_entity_data", Tag.Compound(data))
            }
        }
    }
    if s.is("minecraft:goat_horn") {
        s.move_to("instrument", "minecraft:instrument")
    }
    if s.is("minecraft:knowledge_book") {
        s.move_to("Recipes", "minecraft:recipes")
    }
    if s.is("minecraft:compass") {
        lodestone_tracker(mut s)
    }
    if s.is("minecraft:firework_rocket") or s.is("minecraft:firework_star") {
        if s.tag.contains("Fireworks") or s.tag.contains("Explosion") {
            r.unported(String("a firework"))
        }
    }
    if s.is("minecraft:player_head") {
        if let owner = s.take("SkullOwner") {
            s.set("minecraft:profile", fix_profile(owner))
        }
    }
}

// `fixBlockStateTag`: a boolean property's value as `true` or `false`, and a number as its
// text.
fn block_state_tag(t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            let booleans: List<str> = ["attached", "bottom", "conditional", "disarmed", "drag", "enabled", "extended", "eye", "falling", "hanging", "has_bottle_0", "has_bottle_1", "has_bottle_2", "has_record", "has_book", "inverted", "in_wall", "lit", "locked", "occupied", "open", "persistent", "powered", "short", "signal_fire", "snowy", "triggered", "unstable", "waterlogged", "berries", "bloom", "shrieking", "can_summon", "up", "down", "north", "east", "south", "west", "slot_0_occupied", "slot_1_occupied", "slot_2_occupied", "slot_3_occupied", "slot_4_occupied", "slot_5_occupied", "cracked", "crafting"]
            var out = JavaHashMap<String, Tag>()
            for (key, value) in m {
                var fixed: Tag? = none
                var boolean = false
                for b in booleans {
                    boolean = boolean or key == String(b)
                }
                if boolean {
                    if let b = value.number_int() {
                        fixed = some(Tag.Str(String(if b != 0 { "true" } else { "false" })))
                    }
                }
                if fixed == none {
                    fixed = match value {
                        Tag.Byte(v) => some(Tag.Str("{v}")),
                        Tag.Short(v) => some(Tag.Str("{v}")),
                        Tag.Int(v) => some(Tag.Str("{v}")),
                        Tag.Long(v) => some(Tag.Str("{v}")),
                        Tag.Float(v) => some(Tag.Str("{v}")),
                        Tag.Double(v) => some(Tag.Str("{v}")),
                        _ => none,
                    }
                }
                out.insert(key.copy(), fixed ?? value.copy())
            }
            return Tag.Compound(out)
        },
        _ => return t,
    }
}

// `fixBlockEntityTag`: what an item's block entity holds that's a component now.
fn block_entity_tag(r: mut Run, s: mut Stack, be: mut JavaHashMap<String, Tag>, id: String) {
    if let lock = be.remove("Lock") {
        s.set("minecraft:lock", lock)
    }
    if be.contains("LootTable") {
        var loot = JavaHashMap<String, Tag>()
        loot.insert(String("loot_table"), be["LootTable"].copy())
        let seed = long_or(be, "LootTableSeed", 0)
        if seed != 0 {
            loot.insert(String("seed"), Tag.Long(seed))
        }
        s.set("minecraft:container_loot", Tag.Compound(loot))
        _ = be.remove("LootTable")
        _ = be.remove("LootTableSeed")
    }
    let containers: List<str> = ["shulker_box", "chest", "trapped_chest", "furnace", "ender_chest", "dispenser", "dropper", "brewing_stand", "hopper", "barrel", "smoker", "blast_furnace", "campfire", "chiseled_bookshelf", "crafter"]
    if id == "minecraft:skull" {
        if let v = be.remove("note_block_sound") {
            s.set("minecraft:note_block_sound", v)
        }
    } else if id == "minecraft:decorated_pot" {
        if let v = be.remove("sherds") {
            s.set("minecraft:pot_decorations", v)
        }
        if let v = be.remove("item") {
            var slot = JavaHashMap<String, Tag>()
            slot.insert(String("slot"), Tag.Int(0))
            slot.insert(String("item"), v)
            s.set("minecraft:container", Tag.List([Tag.Compound(slot)]))
        }
    } else if id == "minecraft:banner" {
        if let v = be.remove("patterns") {
            s.set("minecraft:banner_patterns", v)
        }
        if be.contains("Base") {
            if let b = be["Base"].number_int() {
                s.set("minecraft:base_color", Tag.Str(dye_color(b)))
            }
        }
        _ = be.remove("Base")
    } else if id == "minecraft:beehive" {
        if let v = be.remove("bees") {
            s.set("minecraft:bees", v)
        }
    } else {
        for k in containers {
            if id == "minecraft:{k}" {
                var slots = List<Tag>()
                match be.remove("Items") {
                    some(Tag.List(items)) => {
                        var items_left = reversed(items)
                        while let it = items_left.pop() {
                            match it {
                                Tag.Compound(im) => {
                                    var ic = im
                                    let slot = (ic["Slot"].number_int() ?? 0) & 255
                                    _ = ic.remove("Slot")
                                    var sl = JavaHashMap<String, Tag>()
                                    sl.insert(String("slot"), Tag.Int(slot))
                                    sl.insert(String("item"), Tag.Compound(ic))
                                    slots.push(Tag.Compound(sl))
                                },
                                _ => r.unported(String("an item's container slot that isn't a compound")),
                            }
                        }
                    },
                    some(_) => {},
                    none => {},
                }
                if not slots.is_empty() {
                    s.set("minecraft:container", Tag.List(slots))
                }
            }
        }
    }
}

// `fixEnchantments`.
fn enchantments(s: mut Stack, key: str, component: str, hide: bool) {
    let raw = s.take(key)
    let had = raw != none
    var levels = JavaHashMap<String, Tag>()
    var any = false
    if let rv = raw {
        match rv {
            Tag.List(entries) => {
                var entries_left = reversed(entries)
                while let e = entries_left.pop() {
                    match e {
                        Tag.Compound(em) => {
                            let id = string_at(em, "id") else continue
                            if not em.contains("lvl") {
                                continue
                            }
                            let lvl = em["lvl"].number_int() else continue
                            let level = lvl.max(0).min(255)
                            if level > 0 {
                                levels.insert(id, Tag.Int(level))
                                any = true
                            }
                        },
                        _ => {},
                    }
                }
            },
            _ => {},
        }
    }
    if any or hide {
        var comp = JavaHashMap<String, Tag>()
        comp.insert(String("levels"), Tag.Compound(levels))
        if hide {
            comp.insert(String("show_in_tooltip"), Tag.Byte(0))
        }
        s.set(component, Tag.Compound(comp))
    }
    if had and not any {
        s.set("minecraft:enchantment_glint_override", Tag.Byte(1))
    }
}

// `fixDisplay`.
fn fix_display(s: mut Stack, d: mut JavaHashMap<String, Tag>, hide: i32) {
    if d.contains("Name") and strictly_valid(d["Name"]) {
        s.set("minecraft:custom_name", d["Name"].copy())
    }
    if d.contains("Lore") {
        var lore = List<Tag>()
        match d["Lore"] {
            Tag.List(lines) => {
                for l in lines {
                    if strictly_valid(l) {
                        lore.push(l.copy())
                    }
                }
            },
            _ => {},
        }
        s.set("minecraft:lore", Tag.List(lore))
    }
    var color: i32? = none
    if d.contains("color") {
        color = d["color"].number_int()
    }
    let hide_dye = (hide & 64) != 0
    if color != none or hide_dye {
        var dyed = JavaHashMap<String, Tag>()
        dyed.insert(String("rgb"), Tag.Int(color ?? 10511680))
        if hide_dye {
            dyed.insert(String("show_in_tooltip"), Tag.Byte(0))
        }
        s.set("minecraft:dyed_color", Tag.Compound(dyed))
    }
    if let loc = string_at(d, "LocName") {
        s.set("minecraft:item_name", Tag.Str(translate_json(loc)))
    }
    if s.is("minecraft:filled_map") {
        if d.contains("MapColor") {
            s.set("minecraft:map_color", d["MapColor"].copy())
        }
        _ = d.remove("MapColor")
    }
    _ = d.remove("Name")
    _ = d.remove("Lore")
    _ = d.remove("color")
    _ = d.remove("LocName")
}

// `fixBlockStatePredicates`.
fn predicates(s: mut Stack, key: str, component: str, hide: bool) {
    let old = s.take(key) else return
    var list = List<Tag>()
    match old {
        Tag.List(values) => {
            var values_left = reversed(values)
            while let v = values_left.pop() {
                list.push(match v {
                    Tag.Str(written) => block_predicate(written),
                    other => other,
                })
            }
        },
        _ => {},
    }
    var comp = JavaHashMap<String, Tag>()
    comp.insert(String("predicates"), Tag.List(list))
    if hide {
        comp.insert(String("show_in_tooltip"), Tag.Byte(0))
    }
    s.set(component, Tag.Compound(comp))
}

// `fixBlockStatePredicate`.
fn block_predicate(written: String) -> Tag {
    let start_props = written.find("[")
    let start_nbt = written.find("\{")
    var end = written.len()
    if let p = start_props {
        end = p
    }
    if let b = start_nbt {
        end = end.min(b)
    }
    var p = JavaHashMap<String, Tag>()
    p.insert(String("blocks"), Tag.Str(written[..end].trim()))
    let end_props = written.find("]")
    if let sp = start_props {
        if let ep = end_props {
            var props = JavaHashMap<String, Tag>()
            if ep >= sp + 1 {
                for part in written[sp + 1..ep].split(",") {
                    if let eq = part.find("=") {
                        props.insert(part[..eq].trim(), Tag.Str(part[eq + 1..].trim()))
                    }
                }
            }
            p.insert(String("state"), Tag.Compound(props))
        }
    }
    let end_nbt = written.find("\}")
    if let sn = start_nbt {
        if let en = end_nbt {
            if en >= sn {
                p.insert(String("nbt"), Tag.Str(written[sn..en + 1]))
            }
        }
    }
    return Tag.Compound(p)
}

// `fixAttributeModifiers`.
fn attribute_modifiers(s: mut Stack, hide: bool) {
    let old = s.take("AttributeModifiers") else return
    var mods = List<Tag>()
    match old {
        Tag.List(list) => {
            var list_left = reversed(list)
            while let m = list_left.pop() {
                mods.push(item_modifier(m))
            }
        },
        _ => {},
    }
    var comp = JavaHashMap<String, Tag>()
    comp.insert(String("modifiers"), Tag.List(mods))
    if hide {
        comp.insert(String("show_in_tooltip"), Tag.Byte(0))
    }
    s.set("minecraft:attribute_modifiers", Tag.Compound(comp))
}

// `fixAttributeModifier`.
fn item_modifier(t: Tag) -> Tag {
    var out = JavaHashMap<String, Tag>()
    out.insert(String("name"), Tag.Str(String()))
    out.insert(String("amount"), Tag.Double(0.0))
    out.insert(String("operation"), Tag.Str("add_value"))
    match t {
        Tag.Compound(m) => {
            let copies: List<(str, str)> = [("AttributeName", "type"), ("Slot", "slot"), ("UUID", "uuid"), ("Name", "name"), ("Amount", "amount")]
            for (a, b) in copies {
                if m.contains(a) {
                    out.insert(String(b), m[a].copy())
                }
            }
            if m.contains("Operation") {
                let name = match m["Operation"].number_int() ?? 0 {
                    1 => "add_multiplied_base",
                    2 => "add_multiplied_total",
                    _ => "add_value",
                }
                out.insert(String("operation"), Tag.Str(String(name)))
            }
        },
        _ => {},
    }
    return Tag.Compound(out)
}

// `fixPotionContents`.
fn potion_contents(s: mut Stack) {
    var comp = JavaHashMap<String, Tag>()
    if let p = s.take("Potion") {
        match p {
            Tag.Str(id) => {
                if id != "minecraft:empty" {
                    comp.insert(String("potion"), Tag.Str(id.copy()))
                }
            },
            _ => {},
        }
    }
    s.move_into("CustomPotionColor", mut comp, "custom_color")
    s.move_into("custom_potion_effects", mut comp, "custom_effects")
    if not comp.is_empty() {
        s.set("minecraft:potion_contents", Tag.Compound(comp))
    }
}

// `fixBookPages`: `none` for a book with no pages.
fn book_pages(s: mut Stack) -> Tag? {
    var pages = List<String>()
    match s.take("pages") {
        some(Tag.List(list)) => {
            var list_left = reversed(list)
            while let p = list_left.pop() {
                pages.push(match p {
                    Tag.Str(written) => written.copy(),
                    _ => String(),
                })
            }
        },
        _ => {},
    }
    var filtered = JavaHashMap<String, Tag>()
    match s.take("filtered_pages") {
        some(Tag.Compound(f)) => filtered = f,
        _ => {},
    }
    if pages.is_empty() {
        return none
    }
    var out = List<Tag>()
    for i in 0..pages.len() {
        let key = "{i}"
        var f: String? = none
        if filtered.contains(key) {
            f = some(match filtered[key] {
                Tag.Str(written) => written.copy(),
                _ => String(),
            })
        }
        out.push(filtered_text(pages[i], f))
    }
    return some(Tag.List(out))
}

fn filtered_text(raw: String, filtered: String?) -> Tag {
    var p = JavaHashMap<String, Tag>()
    p.insert(String("raw"), Tag.Str(raw.copy()))
    if let f = filtered {
        p.insert(String("filtered"), Tag.Str(f.copy()))
    }
    return Tag.Compound(p)
}

// `fixWrittenBook`.
fn written_book(s: mut Stack) {
    let pages = book_pages(mut s)
    let title = match s.take("title") {
        some(Tag.Str(t)) => t,
        _ => String(),
    }
    let filtered_title = match s.take("filtered_title") {
        some(Tag.Str(t)) => some(t),
        _ => none,
    }
    var comp = JavaHashMap<String, Tag>()
    comp.insert(String("title"), filtered_text(title, filtered_title))
    s.move_into("author", mut comp, "author")
    s.move_into("resolved", mut comp, "resolved")
    s.move_into("generation", mut comp, "generation")
    if let p = pages {
        comp.insert(String("pages"), p)
    }
    s.set("minecraft:written_book_content", Tag.Compound(comp))
}

// `fixLodestoneTracker`.
fn lodestone_tracker(s: mut Stack) {
    let pos = s.take("LodestonePos")
    let dim = s.take("LodestoneDimension")
    if pos == none and dim == none {
        return
    }
    let tracked = match s.take("LodestoneTracked") {
        some(t) => (t.number_int() ?? 1) != 0,
        none => true,
    }
    var comp = JavaHashMap<String, Tag>()
    if let p = pos {
        if let d = dim {
            var target = JavaHashMap<String, Tag>()
            target.insert(String("pos"), p)
            target.insert(String("dimension"), d)
            comp.insert(String("target"), Tag.Compound(target))
        }
    }
    if not tracked {
        comp.insert(String("tracked"), Tag.Byte(0))
    }
    s.set("minecraft:lodestone_tracker", Tag.Compound(comp))
}

// --- Data components ------------------------------------------------------------------------

fn components_rule(r: mut Run, c: mut JavaHashMap<String, Tag>) {
    let k = r.key
    if k == 38200 {
        // `LodestoneCompassComponentFix`.
        match c.remove("minecraft:lodestone_target") {
            some(Tag.Compound(m)) => {
                var lc = m
                let pos = lc.remove("pos")
                let dim = lc.remove("dimension")
                if let p = pos {
                    if let d = dim {
                        var target = JavaHashMap<String, Tag>()
                        target.insert(String("pos"), p)
                        target.insert(String("dimension"), d)
                        lc.insert(String("target"), Tag.Compound(target))
                    }
                }
                c.insert(String("minecraft:lodestone_tracker"), Tag.Compound(lc))
            },
            some(other) => c.insert(String("minecraft:lodestone_tracker"), other),
            none => {},
        }
    } else if k == 39450 {
        if let v = c.remove("minecraft:attribute_modifiers") {
            c.insert(String("minecraft:attribute_modifiers"), match v {
                Tag.Compound(am) => {
                    var a = am
                    match a.remove("modifiers") {
                        some(Tag.List(list)) => a.insert(String("modifiers"), Tag.List(modifier_ids(list))),
                        some(other) => a.insert(String("modifiers"), other),
                        none => {},
                    }
                    Tag.Compound(a)
                },
                other => other,
            })
        }
    } else if k == 40550 {
        if let v = c.remove("minecraft:attribute_modifiers") {
            c.insert(String("minecraft:attribute_modifiers"), match v {
                Tag.Compound(am) => {
                    var a = am
                    if let mods = a.remove("modifiers") {
                        a.insert(String("modifiers"), map_attributes(mods, "type", prefix_free))
                    }
                    Tag.Compound(a)
                },
                other => other,
            })
        }
    } else if k == 40590 and c.contains("minecraft:food") {
        r.unported(String("a food component"))
    } else if k == 40640 and c.contains("minecraft:fire_resistant") {
        r.unported(String("a fire resistant component"))
    } else if k == 40680 {
        if let lock = c.remove("minecraft:lock") {
            if let fixed = lock_predicate(lock) {
                c.insert(String("minecraft:lock"), fixed)
            }
        }
    } else if k == 41750 {
        // `EquippableAssetRenameFix`.
        if let v = c.remove("minecraft:equippable") {
            c.insert(String("minecraft:equippable"), match v {
                Tag.Compound(e) => {
                    var ec = e
                    rename(mut ec, "model", "asset_id")
                    Tag.Compound(ec)
                },
                other => other,
            })
        }
        // `CustomModelDataExpandFix`: the number, 0 if it isn't one, as the one float of `floats`.
        if let v = c.remove("minecraft:custom_model_data") {
            var m = JavaHashMap<String, Tag>()
            m.insert(String("floats"), Tag.List([Tag.Float(v.number_float() ?? 0.0f32)]))
            c.insert(String("minecraft:custom_model_data"), Tag.Compound(m))
        }
    } else if k == 41760 {
        if c.contains("minecraft:lock") and broken_lock(c["minecraft:lock"]) {
            _ = c.remove("minecraft:lock")
        }
    } else if k == 43070 {
        tooltip_display(mut c)
    } else if k == 48850 {
        if c.contains("minecraft:block_entity_data") and be_id(c["minecraft:block_entity_data"]) == "minecraft:bed" {
            _ = c.remove("minecraft:block_entity_data")
        }
    } else if k == 49960 {
        if let v = c.remove("minecraft:pot_decorations") {
            c.insert(String("minecraft:pot_decorations"), unpack_sherds(v))
        }
    } else if (k == 50070 or k == 50140) and (c.contains("minecraft:swing_animation") or c.contains("minecraft:block_transformer")) {
        r.unported(String("a swing animation or block transformer component"))
    } else if k == 50080 and (c.contains("minecraft:map_color") or c.contains("minecraft:map_decorations")) {
        r.unported(String("a map's color"))
    }
}

// `TooltipDisplayComponentFix`.
fn tooltip_display(c: mut JavaHashMap<String, Tag>) {
    var hidden = JavaHashSet<String>()
    for id in ["minecraft:can_place_on", "minecraft:can_break"] {
        if let v = c.remove(id) {
            c.insert(String(id), match v {
                Tag.Compound(pm) => {
                    if pm.contains("predicates") {
                        if not bool_or(pm, "show_in_tooltip", true) {
                            hidden.insert(String(id))
                        }
                        pm["predicates"].copy()
                    } else {
                        Tag.Compound(pm)
                    }
                },
                other => other,
            })
        }
    }
    let simple: List<str> = ["minecraft:trim", "minecraft:unbreakable"]
    for id in simple {
        hidden_component(mut c, id, "", mut hidden)
    }
    let unwrap: List<(str, str)> = [("minecraft:dyed_color", "rgb"), ("minecraft:attribute_modifiers", "modifiers"), ("minecraft:enchantments", "levels"), ("minecraft:stored_enchantments", "levels"), ("minecraft:jukebox_playable", "song")]
    for (id, inner_key) in unwrap {
        hidden_component(mut c, id, inner_key, mut hidden)
    }
    let hide_tooltip = c.contains("minecraft:hide_tooltip")
    _ = c.remove("minecraft:hide_tooltip")
    let hide_additional = c.contains("minecraft:hide_additional_tooltip")
    _ = c.remove("minecraft:hide_additional_tooltip")
    if hide_additional {
        let converted: List<str> = ["minecraft:banner_patterns", "minecraft:bees", "minecraft:block_entity_data", "minecraft:block_state", "minecraft:bundle_contents", "minecraft:charged_projectiles", "minecraft:container", "minecraft:container_loot", "minecraft:firework_explosion", "minecraft:fireworks", "minecraft:instrument", "minecraft:map_id", "minecraft:painting/variant", "minecraft:pot_decorations", "minecraft:potion_contents", "minecraft:tropical_fish/pattern", "minecraft:written_book_content"]
        for id in converted {
            if c.contains(id) {
                hidden.insert(String(id))
            }
        }
    }
    if hidden.is_empty() and not hide_tooltip {
        return
    }
    var list = List<Tag>()
    for h in hidden {
        list.push(Tag.Str(h.copy()))
    }
    var d = JavaHashMap<String, Tag>()
    d.insert(String("hide_tooltip"), Tag.Byte(if hide_tooltip { 1i8 } else { 0i8 }))
    d.insert(String("hidden_components"), Tag.List(list))
    c.insert(String("minecraft:tooltip_display"), Tag.Compound(d))
}

// `fixRemainderComponent`: its `show_in_tooltip` taken out and noted, and the field `inner_key`
// in its place if it has one and `inner_key` isn't empty.
fn hidden_component(c: mut JavaHashMap<String, Tag>, id: str, inner_key: str, hidden: mut JavaHashSet<String>) {
    let v = c.remove(id) else return
    c.insert(String(id), match v {
        Tag.Compound(m) => {
            var cm = m
            if not bool_or(cm, "show_in_tooltip", true) {
                hidden.insert(String(id))
            }
            _ = cm.remove("show_in_tooltip")
            if inner_key != "" and cm.contains(inner_key) {
                cm[inner_key].copy()
            } else {
                Tag.Compound(cm)
            }
        },
        other => {
            // `get("show_in_tooltip")` of what isn't a map is absent: shown.
            other
        },
    })
}

// --- Block states, last ---------------------------------------------------------------------

// A block of `blocks`: the states in its block entity.
fn block_states_of_block(t: own Tag, from: i32) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            if let nbt = c.remove("nbt") {
                c.insert(String("nbt"), be_states(nbt, from))
            }
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// An entry of `entities`: the states in its entity.
fn block_states_of_entry(t: own Tag, from: i32) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            if let nbt = c.remove("nbt") {
                c.insert(String("nbt"), entity_states(nbt, from))
            }
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

fn state_at(c: mut JavaHashMap<String, Tag>, key: str, from: i32) {
    match c.remove(key) {
        some(Tag.Compound(m)) => {
            var s = m
            fix_block_state(mut s, from)
            c.insert(String(key), Tag.Compound(s))
        },
        some(other) => c.insert(String(key), other),
        none => {},
    }
}

fn be_states(t: own Tag, from: i32) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            let id = namespaced(string_at(c, "id") ?? String())
            if id == "minecraft:jigsaw" {
                if let s = string_at(c, "final_state") {
                    c.insert(String("final_state"), Tag.Str(fix_flat_block_state(s, from)))
                }
            } else if id == "minecraft:piston" {
                state_at(mut c, "blockState", from)
            }
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

fn entity_states(t: own Tag, from: i32) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            let id = namespaced(string_at(c, "id") ?? String())
            if let p = c.remove("Passengers") {
                c.insert(String("Passengers"), map_list(p, from, entity_states))
            }
            if id == "minecraft:falling_block" {
                state_at(mut c, "BlockState", from)
                if let te = c.remove("TileEntityData") {
                    c.insert(String("TileEntityData"), be_states(te, from))
                }
            } else if id == "minecraft:enderman" {
                state_at(mut c, "carriedBlockState", from)
            } else if id == "minecraft:arrow" or id == "minecraft:spectral_arrow" or id == "minecraft:trident" {
                state_at(mut c, "inBlockState", from)
            } else if id.ends_with("minecart") {
                state_at(mut c, "DisplayState", from)
            } else if id == "minecraft:block_display" {
                state_at(mut c, "block_state", from)
            }
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// The elements of `l`, last first, each moved out: popping them again gives them in order.
fn reversed(l: own List<Tag>) -> List<Tag> {
    var from = l
    var out = List<Tag>()
    out.reserve(from.len())
    while let e = from.pop() {
        out.push(e)
    }
    return out
}
