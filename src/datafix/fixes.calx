/// Vanilla's data fixes since 1.17, as DataFixerUpper runs them on a structure template: each fix
/// in its schema's order, over every part of the template its type is, the innermost first, as
/// `fixTypeEverywhere` reaches them. A part's type is what the schema of the fix's input says it
/// is: block entities by their `id`, entities by theirs, the items and texts in them, and the data
/// components of each. Block states are fixed once at the end, since no other fix reads them.
///
/// A fix that touches what Calcite doesn't port yet fails the template where that part is there,
/// as `Unimplemented`, rather than leave it as vanilla wouldn't.
module datafix.fixes

import datafix.blocks.{fix_block_state, fix_flat_block_state}
import datafix.text.{empty_component, fix_text, hover_typed, reads_whole, strictly_valid, translate_json, translation_of, unflatten}
import datafix.util.{block_pos, bool_or, dye_color, inline_block_pos, int_or, namespaced, rename, rename_block_pos, string_at, take_compound}
import nbt.tag.{Tag}

/// The oldest data a template can be upgraded from: 1.17's first snapshot of the Caves & Cliffs
/// schemas. Older data needs fixes Calcite doesn't port.
pub const OLDEST: i32 = 2700

// The fixes' keys, `version * 10 + subversion`, in vanilla's order: each schema that has a fix
// Calcite runs or checks for.
fn fix_keys() -> List<i32> {
    return [27020, 27170, 28310, 30860, 30870, 30900, 30930, 30940, 30970, 32090, 33220, 34380, 34390, 34391, 34470, 34480, 35640, 35641, 35680, 36830, 36850, 36920, 38000, 38030, 38080, 38081, 38082, 38090, 38120, 38130, 38140, 38180, 38181, 38182, 38184, 38185, 38186, 38200, 38250, 38280, 38330, 39380, 39450, 40540, 40550, 40590, 40610, 40640, 40670, 40680, 40810, 41730, 41750, 41760, 41810, 41870, 42900, 42910, 42920, 42930, 42960, 42990, 43000, 43010, 43030, 43060, 43070, 43140, 44200, 44240, 45350, 45410, 46490, 47630, 48850, 48880, 49960, 49961, 50020, 50070, 50080, 50120, 50140, 50160]
}

// One fix's run over the template: its key, what it met that Calcite doesn't port, and whether
// vanilla's fixer throws there.
struct Run {
    key: i32
    problems: List<String>
    throws: bool = false
}

impl Run {
    fn unported(mut self, what: own String) {
        if not self.problems.contains(what) {
            self.problems.push(what)
        }
    }
}

/// A structure template saved at data version `from`, upgraded as `DataFixTypes.STRUCTURE`
/// upgrades it to 26.3's. Its `DataVersion` is kept, as vanilla keeps it. `none` where vanilla's
/// fixer throws, as it does for a text whose JSON is a number: `TemplateSource.load` logs that
/// and has no template.
pub fn fix_structure(given: own JavaHashMap<String, Tag>, from: i32) -> JavaHashMap<String, Tag>? ! String {
    if from < OLDEST {
        fail "a structure template from data version {from}, older than the {OLDEST} Calcite upgrades from"
    }
    var root = given
    for key in fix_keys() {
        if key <= from * 10 {
            continue
        }
        var r = Run { key: key, problems: List<String>() }
        if let blocks = root.remove("blocks") {
            root.insert(String("blocks"), structure_blocks(mut r, blocks))
        }
        if let entities = root.remove("entities") {
            root.insert(String("entities"), structure_entities(mut r, entities))
        }
        if r.throws {
            return none
        }
        if not r.problems.is_empty() {
            fail "Unimplemented: {r.problems[0]}, which vanilla's data fixer upgrades from data version {from}"
        }
    }
    // The block states, last.
    if let p = root.remove("palette") {
        root.insert(String("palette"), states(p, from))
    }
    if let ps = root.remove("palettes") {
        root.insert(String("palettes"), match ps {
            Tag.List(lists) => {
                var out = List<Tag>()
                var lists_left = reversed(lists)
                while let p = lists_left.pop() {
                    out.push(states(p, from))
                }
                Tag.List(out)
            },
            other => other,
        })
    }
    if let blocks = root.remove("blocks") {
        root.insert(String("blocks"), map_list(blocks, from, block_states_of_block))
    }
    if let entities = root.remove("entities") {
        root.insert(String("entities"), map_list(entities, from, block_states_of_entry))
    }
    return some(root)
}

// A palette's states fixed.
fn states(p: own Tag, from: i32) -> Tag {
    match p {
        Tag.List(items) => {
            var out = List<Tag>()
            var items_left = reversed(items)
            while let s = items_left.pop() {
                out.push(match s {
                    Tag.Compound(m) => {
                        var c = m
                        fix_block_state(mut c, from)
                        Tag.Compound(c)
                    },
                    other => other,
                })
            }
            return Tag.List(out)
        },
        _ => return p,
    }
}

// Each element of a list through `f`.
fn map_list(t: own Tag, from: i32, f: fn(own Tag, i32) -> Tag) -> Tag {
    match t {
        Tag.List(items) => {
            var out = List<Tag>()
            var items_left = reversed(items)
            while let e = items_left.pop() {
                out.push(f(e, from))
            }
            return Tag.List(out)
        },
        _ => return t,
    }
}

// The template's `blocks`: each one's `nbt`, a block entity, and at 4885 a bed's taken away.
fn structure_blocks(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.List(items) => {
            var out = List<Tag>()
            var items_left = reversed(items)
            while let b = items_left.pop() {
                out.push(match b {
                    Tag.Compound(m) => {
                        var c = m
                        if let nbt = c.remove("nbt") {
                            let fixed = block_entity(mut r, nbt)
                            if r.key == 48850 and be_id(fixed) == "minecraft:bed" {
                                // `RemoveBlockEntityTagFix`: the field goes.
                            } else {
                                c.insert(String("nbt"), fixed)
                            }
                        }
                        Tag.Compound(c)
                    },
                    other => other,
                })
            }
            return Tag.List(out)
        },
        _ => return t,
    }
}

// The template's `entities`: each one's `nbt`, an entity with its passengers.
fn structure_entities(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.List(items) => {
            var out = List<Tag>()
            var items_left = reversed(items)
            while let e = items_left.pop() {
                out.push(match e {
                    Tag.Compound(m) => {
                        var c = m
                        if let nbt = c.remove("nbt") {
                            c.insert(String("nbt"), entity_tree(mut r, nbt))
                        }
                        Tag.Compound(c)
                    },
                    other => other,
                })
            }
            return Tag.List(out)
        },
        _ => return t,
    }
}

// A block entity's ID, namespaced, or "".
fn be_id(t: Tag) -> String {
    return match t {
        Tag.Compound(m) => namespaced(string_at(m, "id") ?? String()),
        _ => String(),
    }
}

// --- Walking the parts ---------------------------------------------------------------------

// The value at `key` of `m`, through `f`, if it's there.
fn field(r: mut Run, m: mut JavaHashMap<String, Tag>, key: str, f: fn(mut Run, own Tag) -> Tag) {
    if let v = m.remove(key) {
        m.insert(String(key), f(mut r, v))
    }
}

// Each element of the list at `key`, through `f`.
fn each(r: mut Run, m: mut JavaHashMap<String, Tag>, key: str, f: fn(mut Run, own Tag) -> Tag) {
    if let v = m.remove(key) {
        m.insert(String(key), each_of(mut r, v, f))
    }
}

fn each_of(r: mut Run, t: own Tag, f: fn(mut Run, own Tag) -> Tag) -> Tag {
    match t {
        Tag.List(items) => {
            var out = List<Tag>()
            var items_left = reversed(items)
            while let e = items_left.pop() {
                out.push(f(mut r, e))
            }
            return Tag.List(out)
        },
        _ => return t,
    }
}

// The compound at `key`, and its field `inner` through `f`.
fn inner(r: mut Run, m: mut JavaHashMap<String, Tag>, key: str, inner_key: str, f: fn(mut Run, own Tag) -> Tag) {
    if let v = m.remove(key) {
        m.insert(String(key), match v {
            Tag.Compound(c) => {
                var cc = c
                field(mut r, mut cc, inner_key, f)
                Tag.Compound(cc)
            },
            other => other,
        })
    }
}

// Whether a text, or a text in it, has a hover event with a `value` and an action that isn't
// `show_text`, `show_item` or `show_entity`.
fn legacy_hover(t: Tag) -> bool {
    match t {
        Tag.List(items) => {
            for e in items {
                if legacy_hover(e) {
                    return true
                }
            }
            return false
        },
        Tag.Compound(m) => {
            if m.contains("hoverEvent") {
                match m["hoverEvent"] {
                    Tag.Compound(h) => {
                        let action = string_at(h, "action") ?? String()
                        let typed = action == "show_text" or action == "show_item" or action == "show_entity"
                        if h.contains("value") and not typed {
                            return true
                        }
                    },
                    _ => {},
                }
            }
            if m.contains("extra") and legacy_hover(m["extra"]) {
                return true
            }
            return m.contains("separator") and legacy_hover(m["separator"])
        },
        _ => return false,
    }
}

// Whether the fix of `key` reaches texts: the three text fixes, and after them the fixes of
// items, which reach the items of `show_item` hover events once texts are NBT.
fn is_text_key(key: i32) -> bool {
    return key >= 42900
}

// A text component, at one of the text fixes or after. `LegacyHoverEventFix`, at 4291, is for a
// hover event whose action the schema doesn't know, which keeps its legacy `value`; Calcite
// doesn't port it.
fn text_part(r: mut Run, t: own Tag) -> Tag {
    if r.key == 42910 and legacy_hover(t) {
        r.unported(String("a legacy hover event"))
    }
    if r.key == 42900 {
        return match unflatten(t) {
            some(read) => read,
            none => {
                r.throws = true
                Tag.End
            },
        }
    }
    // The items in it first, which are inside it.
    let walked = hover_items(mut r, t)
    if r.key == 42910 {
        return fix_text(walked, 1)
    }
    if r.key == 42920 {
        return fix_text(walked, 2)
    }
    return walked
}

// The items of a text's `show_item` hover events, through `item_part`, where the fixes reach
// them: in a hover event's `contents` before 4292, and after it the `hover_event` itself, which
// 4292's schema makes an item stack. A text's typed parts, as `fix_text` goes through them.
fn hover_items(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.List(items) => {
            var out = List<Tag>()
            var items_left = reversed(items)
            while let e = items_left.pop() {
                out.push(if reads_whole(e) { hover_items(mut r, e) } else { e })
            }
            return Tag.List(out)
        },
        Tag.Compound(m) => {
            var c = m
            if c.contains("extra") and reads_whole(c["extra"]) {
                field(mut r, mut c, "extra", hover_items)
            }
            if c.contains("separator") and reads_whole(c["separator"]) {
                field(mut r, mut c, "separator", hover_items)
            }
            let key = if r.key <= 42920 { "hoverEvent" } else { "hover_event" }
            if hover_typed(c, key) {
                if let h = c.remove(key) {
                    c.insert(String(key), match h {
                        Tag.Compound(hm) => {
                            var hc = hm
                            let action = string_at(hc, "action") ?? String()
                            if r.key <= 42920 {
                                if action == "show_text" and hc.contains("contents") and reads_whole(hc["contents"]) {
                                    field(mut r, mut hc, "contents", hover_items)
                                } else if action == "show_item" and hc.contains("contents") {
                                    match hc["contents"] {
                                        Tag.Compound(_) => field(mut r, mut hc, "contents", item_part),
                                        _ => {},
                                    }
                                }
                                Tag.Compound(hc)
                            } else if action == "show_text" {
                                if hc.contains("value") and reads_whole(hc["value"]) {
                                    field(mut r, mut hc, "value", hover_items)
                                }
                                Tag.Compound(hc)
                            } else if action == "show_item" {
                                item_part(mut r, Tag.Compound(hc))
                            } else {
                                Tag.Compound(hc)
                            }
                        },
                        other => other,
                    })
                }
            }
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

fn texts_at(r: mut Run, m: mut JavaHashMap<String, Tag>, key: str) {
    if is_text_key(r.key) {
        field(mut r, mut m, key, text_part)
    }
}

// The kinds of block entity that keep their items in `Items`.
fn inventory(id: String) -> bool {
    let kinds: List<str> = ["furnace", "chest", "trapped_chest", "dispenser", "dropper", "brewing_stand", "hopper", "shulker_box", "barrel", "smoker", "blast_furnace", "campfire", "chiseled_bookshelf", "crafter", "shelf"]
    for k in kinds {
        if id == "minecraft:{k}" {
            return true
        }
    }
    return false
}

// The kinds whose `CustomName` is a text.
fn nameable(id: String) -> bool {
    let kinds: List<str> = ["beacon", "banner", "brewing_stand", "chest", "trapped_chest", "dispenser", "dropper", "enchanting_table", "furnace", "hopper", "shulker_box", "barrel", "smoker", "blast_furnace", "campfire", "crafter"]
    for k in kinds {
        if id == "minecraft:{k}" {
            return true
        }
    }
    return false
}

// A block entity, with what's in it.
fn block_entity(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            let raw = string_at(c, "id") ?? String()
            let id = namespaced(raw)
            if c.contains("id") {
                c.insert(String("id"), Tag.Str(id.copy()))
            }
            // What's inside, first.
            if r.key > 38183 {
                field(mut r, mut c, "components", components)
            }
            if inventory(id) {
                each(mut r, mut c, "Items", item_part)
            }
            if id == "minecraft:jukebox" {
                field(mut r, mut c, "RecordItem", item_part)
            } else if id == "minecraft:lectern" {
                field(mut r, mut c, "Book", item_part)
            } else if id == "minecraft:decorated_pot" {
                field(mut r, mut c, "item", item_part)
                if r.key > 49961 {
                    for side in ["back", "left", "right", "front"] {
                        inner(mut r, mut c, "sherds", side, item_part)
                    }
                } else if r.key > 34480 {
                    // Not where they were read as `sherds` but were in the remainder beside
                    // `shards`, until the unflattening writes the pot and reads it again.
                    if not c.contains("calcite:untyped") {
                        names_at(r.key, mut c, "sherds")
                    }
                } else {
                    // Its remainder's `shards`, kept for `DecoratedPotFieldRenameFix`.
                    if not c.contains("calcite:remainder") {
                        var kept = JavaHashMap<String, Tag>()
                        if c.contains("shards") {
                            kept.insert(String("shards"), c["shards"].copy())
                        }
                        c.insert(String("calcite:remainder"), Tag.Compound(kept))
                    }
                    names_at(r.key, mut c, "shards")
                }
            } else if id == "minecraft:brushable_block" or id == "minecraft:suspicious_sand" {
                field(mut r, mut c, "item", item_part)
            } else if id == "minecraft:beehive" {
                if r.key > 38180 {
                    each(mut r, mut c, "bees", bee)
                } else {
                    each(mut r, mut c, "Bees", old_bee)
                }
            } else if id == "minecraft:mob_spawner" {
                spawner_parts(mut r, mut c)
            } else if id == "minecraft:trial_spawner" {
                each(mut r, mut c, "spawn_potentials", spawn_entry)
                field(mut r, mut c, "spawn_data", spawn_data)
            } else if id == "minecraft:vault" {
                inner(mut r, mut c, "config", "key_item", item_part)
                if let v = c.remove("server_data") {
                    c.insert(String("server_data"), match v {
                        Tag.Compound(sd) => {
                            var s = sd
                            each(mut r, mut s, "items_to_eject", item_part)
                            Tag.Compound(s)
                        },
                        other => other,
                    })
                }
                inner(mut r, mut c, "shared_data", "display_item", item_part)
            }
            // The texts.
            if is_text_key(r.key) {
                if nameable(id) {
                    texts_at(mut r, mut c, "CustomName")
                }
                if id == "minecraft:skull" {
                    texts_at(mut r, mut c, "custom_name")
                }
                if id == "minecraft:command_block" {
                    texts_at(mut r, mut c, "LastOutput")
                }
                if id == "minecraft:sign" or id == "minecraft:hanging_sign" {
                    for side in ["front_text", "back_text"] {
                        if let v = c.remove(side) {
                            c.insert(String(side), match v {
                                Tag.Compound(s) => {
                                    var sc = s
                                    each(mut r, mut sc, "messages", text_part)
                                    each(mut r, mut sc, "filtered_messages", text_part)
                                    Tag.Compound(sc)
                                },
                                other => other,
                            })
                        }
                    }
                }
                if id == "minecraft:test_instance_block" {
                    r.unported(String("a test instance block's texts"))
                }
            }
            be_rule(mut r, id, mut c)
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// A bee in a beehive from before 3818: its entity, `EntityData`.
fn old_bee(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            field(mut r, mut c, "EntityData", entity_tree)
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// A bee in a beehive or a `bees` component: `entity_data`.
fn bee(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            field(mut r, mut c, "entity_data", entity_tree)
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// A spawner's entities, as `UNTAGGED_SPAWNER` has them: before 2831, `SpawnData` and each
// `SpawnPotentials` `Entity` are entities themselves; from it, each is in an `entity` field.
fn spawner_parts(r: mut Run, c: mut JavaHashMap<String, Tag>) {
    if r.key <= 28310 {
        field(mut r, mut c, "SpawnData", entity_tree)
        each(mut r, mut c, "SpawnPotentials", old_spawn_entry)
    } else {
        field(mut r, mut c, "SpawnData", spawn_data)
        each(mut r, mut c, "SpawnPotentials", spawn_entry)
    }
}

fn old_spawn_entry(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            field(mut r, mut c, "Entity", entity_tree)
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

fn spawn_data(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            field(mut r, mut c, "entity", entity_tree)
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

fn spawn_entry(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            field(mut r, mut c, "data", spawn_data)
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// An entity with its passengers.
fn entity_tree(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            each(mut r, mut c, "Passengers", entity_tree)
            entity(mut r, mut c)
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// The entities that hold one item in `Item`.
fn holds_item(id: String) -> bool {
    let kinds: List<str> = ["item", "item_frame", "glow_item_frame", "potion", "splash_potion", "lingering_potion", "snowball", "egg", "ender_pearl", "experience_bottle", "eye_of_ender", "fireball", "small_fireball"]
    for k in kinds {
        if id == "minecraft:{k}" {
            return true
        }
    }
    return false
}

// An entity, with what's in it.
fn entity(r: mut Run, c: mut JavaHashMap<String, Tag>) {
    let id = namespaced(string_at(c, "id") ?? String())
    if c.contains("id") {
        c.insert(String("id"), Tag.Str(id.copy()))
    }
    // Its equipment, its remainder kept as it's first read.
    if r.key <= 43010 {
        keep_remainder(mut c, false)
        each(mut r, mut c, "ArmorItems", item_part)
        each(mut r, mut c, "HandItems", item_part)
        field(mut r, mut c, "body_armor_item", item_part)
        if r.key > 43000 {
            field(mut r, mut c, "saddle", item_part)
        }
    } else {
        if let v = c.remove("equipment") {
            c.insert(String("equipment"), match v {
                Tag.Compound(e) => {
                    var ec = e
                    for slot in ["mainhand", "offhand", "feet", "legs", "chest", "head", "body", "saddle"] {
                        field(mut r, mut ec, slot, item_part)
                    }
                    Tag.Compound(ec)
                },
                other => other,
            })
        }
    }
    if holds_item(id) {
        field(mut r, mut c, "Item", item_part)
    }
    if id == "minecraft:ominous_item_spawner" or id == "minecraft:item_display" {
        field(mut r, mut c, "item", item_part)
    }
    if id == "minecraft:villager" or id == "minecraft:wandering_trader" or id == "minecraft:zombie_villager" {
        if let v = c.remove("Offers") {
            c.insert(String("Offers"), match v {
                Tag.Compound(o) => {
                    var oc = o
                    each(mut r, mut oc, "Recipes", trade)
                    Tag.Compound(oc)
                },
                other => other,
            })
        }
    }
    let with_inventory: List<str> = ["villager", "wandering_trader", "pillager", "piglin", "allay"]
    for k in with_inventory {
        if id == "minecraft:{k}" {
            each(mut r, mut c, "Inventory", item_part)
        }
    }
    let with_items: List<str> = ["chest_minecart", "hopper_minecart", "llama", "trader_llama", "donkey", "mule"]
    for k in with_items {
        if id == "minecraft:{k}" {
            each(mut r, mut c, "Items", item_part)
        }
    }
    if id.ends_with("_chest_boat") or id == "minecraft:chest_boat" or id == "minecraft:chest_raft" {
        each(mut r, mut c, "Items", item_part)
    }
    if r.key <= 43000 {
        field(mut r, mut c, "SaddleItem", item_part)
        field(mut r, mut c, "ArmorItem", item_part)
        field(mut r, mut c, "DecorItem", item_part)
    }
    if id == "minecraft:falling_block" {
        field(mut r, mut c, "TileEntityData", block_entity)
    }
    if id == "minecraft:spawner_minecart" {
        spawner_parts(mut r, mut c)
    }
    let projectiles: List<str> = ["arrow", "spectral_arrow", "trident", "firework_rocket", "area_effect_cloud"]
    for k in projectiles {
        if id == "minecraft:{k}" and (c.contains("item") or c.contains("weapon") or c.contains("Trident") or c.contains("FireworksItem") or c.contains("Potion") or c.contains("potion_contents")) {
            r.unported("a {id}'s items")
        }
    }
    if is_text_key(r.key) {
        texts_at(mut r, mut c, "CustomName")
        if id == "minecraft:text_display" {
            texts_at(mut r, mut c, "text")
        }
        if id == "minecraft:command_block_minecart" {
            texts_at(mut r, mut c, "LastOutput")
        }
    }
    entity_rule(mut r, id, mut c)
}

// A villager's trade, its three items.
fn trade(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            field(mut r, mut c, "buy", item_part)
            field(mut r, mut c, "buyB", item_part)
            field(mut r, mut c, "sell", item_part)
            if r.key == 38280 {
                // `EmptyItemInVillagerTradeFix`.
                var empty = true
                if c.contains("buyB") {
                    match c["buyB"] {
                        Tag.Compound(b) => {
                            let bid = namespaced(string_at(b, "id") ?? String("minecraft:air"))
                            empty = bid == "minecraft:air" or int_or(b, "count", 0) == 0
                        },
                        _ => {},
                    }
                }
                if empty {
                    _ = c.remove("buyB")
                }
            }
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// A list of items' names at `key` of `m`, as the renames of items reach it, each namespaced.
fn names_at(k: i32, m: mut JavaHashMap<String, Tag>, key: str) {
    match m.remove(key) {
        some(Tag.List(names)) => {
            var out = List<Tag>()
            var names_left = reversed(names)
            while let n = names_left.pop() {
                out.push(match n {
                    Tag.Str(s) => Tag.Str(rename_item(k, namespaced(s))),
                    other => other,
                })
            }
            m.insert(String(key), Tag.List(out))
        },
        some(other) => m.insert(String(key), other),
        none => {},
    }
}

// The renames of items, `ItemRenameFix`, at `key`: `createRenamer`'s rename of the namespaced
// ID, or the ID as it was.
fn rename_item(key: i32, id: String) -> String {
    let full = namespaced(id)
    if key == 27170 and full == "minecraft:azalea_leaves_flowers" {
        return String("minecraft:flowering_azalea_leaves")
    }
    if key == 34380 {
        let shards: List<str> = ["archer", "prize", "arms_up", "skull"]
        for s in shards {
            if full == "minecraft:pottery_shard_{s}" {
                return "minecraft:{s}_pottery_shard"
            }
        }
    }
    if key == 34470 {
        let shards: List<str> = ["angler", "archer", "arms_up", "blade", "brewer", "burn", "danger", "explorer", "friend", "heart", "heartbreak", "howl", "miner", "mourner", "plenty", "prize", "sheaf", "shelter", "skull", "snort"]
        for s in shards {
            if full == "minecraft:{s}_pottery_shard" {
                return "minecraft:{s}_pottery_sherd"
            }
        }
    }
    if key == 36920 and full == "minecraft:grass" {
        return String("minecraft:short_grass")
    }
    if key == 38000 and full == "minecraft:scute" {
        return String("minecraft:turtle_scute")
    }
    if key == 45410 and full == "minecraft:chain" {
        return String("minecraft:iron_chain")
    }
    if key == 50120 {
        let maps: List<(str, str)> = [("ocean_explorer_map", "ocean_monument_map"), ("swamp_explorer_map", "swamp_hut_map"), ("trial_explorer_map", "buried_trial_chambers_map"), ("woodland_explorer_map", "woodland_mansion_map"), ("jungle_explorer_map", "jungle_pyramid_map")]
        for (a, b) in maps {
            if full == "minecraft:{a}" {
                return "minecraft:{b}"
            }
        }
    }
    return id.copy()
}

// An item stack, with what's in it.
fn item_part(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            if let id = string_at(c, "id") {
                c.insert(String("id"), Tag.Str(rename_item(r.key, namespaced(id))))
            }
            let id = string_at(c, "id") ?? String()
            if r.key <= 38185 {
                // Before componentization, what's in its tag.
                if let v = c.remove("tag") {
                    c.insert(String("tag"), match v {
                        Tag.Compound(tg) => {
                            var tc = tg
                            if tc.contains("BlockEntityTag") {
                                var has_id = false
                                match tc["BlockEntityTag"] {
                                    Tag.Compound(b) => has_id = b.contains("id"),
                                    _ => {},
                                }
                                if not has_id {
                                    r.unported(String("an item's block entity without its ID"))
                                }
                                field(mut r, mut tc, "BlockEntityTag", block_entity)
                            }
                            field(mut r, mut tc, "EntityTag", entity_tree)
                            if id == "minecraft:bundle" {
                                each(mut r, mut tc, "Items", item_part)
                            }
                            if id == "minecraft:crossbow" {
                                each(mut r, mut tc, "ChargedProjectiles", item_part)
                            }
                            Tag.Compound(tc)
                        },
                        other => other,
                    })
                }
            } else {
                field(mut r, mut c, "components", components)
            }
            item_rule(mut r, mut c)
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// An item's or a block entity's data components, with what's in them.
fn components(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            each(mut r, mut c, "minecraft:bees", bee)
            field(mut r, mut c, "minecraft:block_entity_data", block_entity)
            each(mut r, mut c, "minecraft:bundle_contents", item_part)
            each(mut r, mut c, "minecraft:charged_projectiles", item_part)
            each(mut r, mut c, "minecraft:container", slot_item)
            field(mut r, mut c, "minecraft:entity_data", entity_tree)
            if r.key <= 40590 {
                inner(mut r, mut c, "minecraft:food", "using_converts_to", item_part)
            } else {
                field(mut r, mut c, "minecraft:use_remainder", item_part)
            }
            if r.key > 49960 {
                for side in ["back", "left", "right", "front"] {
                    inner(mut r, mut c, "minecraft:pot_decorations", side, item_part)
                }
            } else {
                names_at(r.key, mut c, "minecraft:pot_decorations")
            }
            if is_text_key(r.key) {
                texts_at(mut r, mut c, "minecraft:custom_name")
                texts_at(mut r, mut c, "minecraft:item_name")
                each(mut r, mut c, "minecraft:lore", text_part)
                if let v = c.remove("minecraft:written_book_content") {
                    c.insert(String("minecraft:written_book_content"), match v {
                        Tag.Compound(b) => {
                            var bc = b
                            each(mut r, mut bc, "pages", page)
                            Tag.Compound(bc)
                        },
                        other => other,
                    })
                }
            }
            components_rule(mut r, mut c)
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// A slot of a `container` component: its `item`.
fn slot_item(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            field(mut r, mut c, "item", item_part)
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// A written book's page: `raw` and `filtered` texts, or a text itself.
fn page(r: mut Run, t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            if m.contains("raw") or m.contains("filtered") {
                var c = m
                texts_at(mut r, mut c, "raw")
                texts_at(mut r, mut c, "filtered")
                return Tag.Compound(c)
            }
            return text_part(mut r, Tag.Compound(m))
        },
        _ => return text_part(mut r, t),
    }
}

// --- Block entities -------------------------------------------------------------------------

fn be_rule(r: mut Run, id: String, c: mut JavaHashMap<String, Tag>) {
    let k = r.key
    let sign = id == "minecraft:sign"
    let hanging = id == "minecraft:hanging_sign"
    if k == 28310 and id == "minecraft:mob_spawner" {
        spawner_data_fix(mut c)
    } else if k == 30970 and sign {
        for n in ["FilteredText1", "FilteredText2", "FilteredText3", "FilteredText4"] {
            _ = c.remove(n)
        }
    } else if k == 34380 {
        var now = id.copy()
        if id == "minecraft:suspicious_sand" {
            now = String("minecraft:brushable_block")
            c.insert(String("id"), Tag.Str(now.copy()))
        }
        if now == "minecraft:brushable_block" {
            rename(mut c, "loot_table", "LootTable")
            rename(mut c, "loot_table_seed", "LootTableSeed")
        }
    } else if (k == 34390 and sign) or (k == 34391 and hanging) {
        double_sided(mut c)
    } else if (k == 35640 and sign) or (k == 35641 and hanging) {
        if bool_or(c, "_filtered_correct", false) {
            _ = c.remove("_filtered_correct")
        } else {
            drop_invalid_sign_data(mut c)
        }
    } else if k == 38130 and id == "minecraft:beehive" {
        rename_block_pos(mut c, "FlowerPos", "flower_pos")
    } else if k == 38130 and id == "minecraft:end_gateway" {
        rename_block_pos(mut c, "ExitPortal", "exit_portal")
    } else if k == 38180 and id == "minecraft:beehive" {
        match c.remove("Bees") {
            some(Tag.List(bees)) => {
                var out = List<Tag>()
                var bees_left = reversed(bees)
                while let b = bees_left.pop() {
                    out.push(match b {
                        Tag.Compound(bm) => {
                            var bc = bm
                            rename(mut bc, "EntityData", "entity_data")
                            rename(mut bc, "TicksInHive", "ticks_in_hive")
                            rename(mut bc, "MinOccupationTicks", "min_ticks_in_hive")
                            Tag.Compound(bc)
                        },
                        other => other,
                    })
                }
                c.insert(String("bees"), Tag.List(out))
            },
            _ => {},
        }
    } else if k == 38181 and id == "minecraft:banner" {
        banner_patterns(mut c)
    } else if k == 38200 and id == "minecraft:skull" {
        var owner: Tag? = none
        if c.contains("SkullOwner") {
            owner = some(c["SkullOwner"].copy())
        } else if c.contains("ExtraType") {
            owner = some(c["ExtraType"].copy())
        }
        if let o = owner {
            _ = c.remove("SkullOwner")
            _ = c.remove("ExtraType")
            c.insert(String("profile"), fix_profile(o))
        }
    } else if k == 38250 and id == "minecraft:banner" {
        if let name = string_at(c, "CustomName") {
            if translation_of(name) == some(String("block.minecraft.ominous_banner")) {
                var comps = JavaHashMap<String, Tag>()
                comps.insert(String("minecraft:item_name"), Tag.Str(name.copy()))
                comps.insert(String("minecraft:hide_additional_tooltip"), Tag.Compound(JavaHashMap<String, Tag>()))
                c.insert(String("components"), Tag.Compound(comps))
                _ = c.remove("CustomName")
            }
        }
    } else if (k == 38250 or k == 40610) and id == "minecraft:trial_spawner" {
        r.unported(String("a trial spawner's configuration"))
    } else if k == 38330 and id == "minecraft:brushable_block" {
        if c.contains("item") {
            var empty = false
            match c["item"] {
                Tag.Compound(it) => {
                    let iid = namespaced(string_at(it, "id") ?? String("minecraft:air"))
                    empty = iid == "minecraft:air" or int_or(it, "count", 0) == 0
                },
                _ => {},
            }
            if empty {
                _ = c.remove("item")
            }
        }
    } else if k == 39450 and id == "minecraft:jukebox" {
        let since = long_or(c, "TickCount", 0) - long_or(c, "RecordStartTick", 0)
        _ = c.remove("IsPlaying")
        _ = c.remove("TickCount")
        _ = c.remove("RecordStartTick")
        if since > 0 {
            c.insert(String("ticks_since_song_started"), Tag.Long(since))
        }
    } else if k == 40540 and id == "minecraft:banner" {
        if let comps = c.remove("components") {
            c.insert(String("components"), ominous_rarity(comps))
        }
    } else if k == 40680 {
        if let lock = c.remove("Lock") {
            if let fixed = lock_predicate(lock) {
                c.insert(String("lock"), fixed)
            }
        }
    } else if k == 41760 {
        if c.contains("lock") {
            if broken_lock(c["lock"]) {
                _ = c.remove("lock")
            }
        }
    } else if k == 41810 and (id == "minecraft:furnace" or id == "minecraft:smoker" or id == "minecraft:blast_furnace") {
        rename(mut c, "CookTime", "cooking_time_spent")
        rename(mut c, "CookTimeTotal", "cooking_total_time")
        rename(mut c, "BurnTime", "lit_time_remaining")
        if c.contains("lit_time_remaining") {
            c.insert(String("lit_total_time"), c["lit_time_remaining"].copy())
        }
    } else if k == 34480 and id == "minecraft:decorated_pot" {
        // `DecoratedPotFieldRenameFix` only calls the typed `shards` `sherds`, so the shards as
        // the template had them stay beside them, from the remainder.
        if let s = c.remove("shards") {
            c.insert(String("sherds"), s)
        } else if c.contains("sherds") {
            c.insert(String("calcite:untyped"), Tag.Byte(1))
        }
        match c.remove("calcite:remainder") {
            some(Tag.Compound(kept)) => {
                for (key, v) in kept {
                    c.insert(key.copy(), v.copy())
                }
            },
            _ => {},
        }
    } else if k == 49961 and id == "minecraft:decorated_pot" {
        _ = c.remove("calcite:untyped")
        var original = Tag.List([])
        if let s = c.remove("sherds") {
            original = s
        }
        c.insert(String("sherds"), unpack_sherds(original))
    } else if k == 50020 and (sign or hanging) {
        c.insert(String("allow_op_features"), Tag.Byte(1))
    }
}

fn long_or(m: JavaHashMap<String, Tag>, key: str, fallback: i64) -> i64 {
    if not m.contains(key) {
        return fallback
    }
    return m[key].number_long() ?? fallback
}

// `SpawnerDataFix`: `SpawnData` wrapped as `{entity: ...}`, and each of `SpawnPotentials` as
// `{data: {entity: ..., the rest}, weight}`.
fn spawner_data_fix(c: mut JavaHashMap<String, Tag>) {
    if let d = c.remove("SpawnData") {
        var w = JavaHashMap<String, Tag>()
        w.insert(String("entity"), d)
        c.insert(String("SpawnData"), Tag.Compound(w))
    }
    match c.remove("SpawnPotentials") {
        some(Tag.List(entries)) => {
            var out = List<Tag>()
            var entries_left = reversed(entries)
            while let e = entries_left.pop() {
                match e {
                    Tag.Compound(em) => {
                        var rest = em
                        let weight = int_or(rest, "Weight", 1)
                        let spawned = rest.remove("Entity")
                        _ = rest.remove("Weight")
                        var data = rest
                        if let en = spawned {
                            data.insert(String("entity"), en)
                        }
                        var entry = JavaHashMap<String, Tag>()
                        entry.insert(String("data"), Tag.Compound(data))
                        entry.insert(String("weight"), Tag.Int(weight))
                        out.push(Tag.Compound(entry))
                    },
                    other => out.push(other),
                }
            }
            c.insert(String("SpawnPotentials"), Tag.List(out))
        },
        some(other) => c.insert(String("SpawnPotentials"), other),
        none => {},
    }
}

// The legacy sign fields `BlockEntitySignDoubleSidedEditableTextFix` drops.
fn legacy_sign_fields() -> List<str> {
    return ["Text1", "Text2", "Text3", "Text4", "FilteredText1", "FilteredText2", "FilteredText3", "FilteredText4", "Color", "GlowingText"]
}

// `BlockEntitySignDoubleSidedEditableTextFix`.
fn double_sided(c: mut JavaHashMap<String, Tag>) {
    var lines = List<Tag>()
    var filtered = List<Tag?>()
    var any_filtered = false
    for i in 1..5 {
        let key = "Text{i}"
        lines.push(if c.contains(key) { c[key].copy() } else { empty_component() })
        let fkey = "FilteredText{i}"
        if c.contains(fkey) {
            filtered.push(some(c[fkey].copy()))
            any_filtered = true
        } else {
            filtered.push(none)
        }
    }
    var front = JavaHashMap<String, Tag>()
    front.insert(String("messages"), Tag.List(lines.copy()))
    front.insert(String("color"), if c.contains("Color") { c["Color"].copy() } else { Tag.Str("black") })
    front.insert(String("has_glowing_text"), if c.contains("GlowingText") { c["GlowingText"].copy() } else { Tag.Byte(0) })
    if any_filtered {
        var fl = List<Tag>()
        for i in 0..lines.len() {
            fl.push(match filtered[i] {
                some(t) => t.copy(),
                none => lines[i].copy(),
            })
        }
        front.insert(String("filtered_messages"), Tag.List(fl))
    }
    var back = JavaHashMap<String, Tag>()
    back.insert(String("messages"), Tag.List([empty_component(), empty_component(), empty_component(), empty_component()]))
    back.insert(String("color"), Tag.Str("black"))
    back.insert(String("has_glowing_text"), Tag.Byte(0))
    c.insert(String("front_text"), Tag.Compound(front))
    c.insert(String("back_text"), Tag.Compound(back))
    c.insert(String("is_waxed"), Tag.Byte(0))
    c.insert(String("_filtered_correct"), Tag.Byte(1))
    for f in legacy_sign_fields() {
        _ = c.remove(f)
    }
}

// `DropInvalidSignDataFix.fix`.
fn drop_invalid_sign_data(c: mut JavaHashMap<String, Tag>) {
    for side in ["front_text", "back_text"] {
        if let v = c.remove(side) {
            c.insert(String(side), match v {
                Tag.Compound(s) => {
                    var sc = s
                    fix_filtered(mut sc)
                    Tag.Compound(sc)
                },
                other => other,
            })
        }
    }
    for f in legacy_sign_fields() {
        _ = c.remove(f)
    }
}

fn fix_filtered(s: mut JavaHashMap<String, Tag>) {
    if not s.contains("filtered_messages") {
        return
    }
    let filtered = match s["filtered_messages"] {
        Tag.List(l) => l.copy(),
        _ => return,
    }
    var lines = List<Tag>()
    if s.contains("messages") {
        match s["messages"] {
            Tag.List(l) => lines = l.copy(),
            _ => {},
        }
    }
    let empty = empty_component()
    var fixed = List<Tag>()
    for i in 0..filtered.len() {
        let fallback = if i < lines.len() { lines[i].copy() } else { empty.copy() }
        fixed.push(if filtered[i] == empty { fallback } else { filtered[i].copy() })
    }
    if fixed == lines {
        _ = s.remove("filtered_messages")
    } else {
        s.insert(String("filtered_messages"), Tag.List(fixed))
    }
}

// `BannerPatternFormatFix`: `Patterns` as `patterns`, each layer's pattern by its ID and its
// color by name.
fn banner_patterns(c: mut JavaHashMap<String, Tag>) {
    let old = c.remove("Patterns") else return
    let layers = match old {
        Tag.List(l) => l,
        // `asStream` of what isn't a list is empty.
        _ => List<Tag>(),
    }
    var out = List<Tag>()
    var layers_left = reversed(layers)
    while let layer = layers_left.pop() {
        match layer {
            Tag.Compound(lm) => {
                var l = lm
                if let p = l.remove("Pattern") {
                    l.insert(String("pattern"), match p {
                        Tag.Str(s) => Tag.Str(pattern_id(s)),
                        other => other,
                    })
                }
                let color = int_or(l, "Color", 0)
                l.insert(String("color"), Tag.Str(dye_color(color)))
                _ = l.remove("Color")
                out.push(Tag.Compound(l))
            },
            other => {
                // A layer that isn't a map takes neither change; `set` on it fails and leaves it.
                out.push(other)
            },
        }
    }
    c.insert(String("patterns"), Tag.List(out))
}

fn pattern_id(code: String) -> String {
    let codes: List<(str, str)> = [
        ("b", "base"), ("bl", "square_bottom_left"), ("br", "square_bottom_right"), ("tl", "square_top_left"), ("tr", "square_top_right"),
        ("bs", "stripe_bottom"), ("ts", "stripe_top"), ("ls", "stripe_left"), ("rs", "stripe_right"), ("cs", "stripe_center"),
        ("ms", "stripe_middle"), ("drs", "stripe_downright"), ("dls", "stripe_downleft"), ("ss", "small_stripes"), ("cr", "cross"),
        ("sc", "straight_cross"), ("bt", "triangle_bottom"), ("tt", "triangle_top"), ("bts", "triangles_bottom"), ("tts", "triangles_top"),
        ("ld", "diagonal_left"), ("rd", "diagonal_up_right"), ("lud", "diagonal_up_left"), ("rud", "diagonal_right"), ("mc", "circle"),
        ("mr", "rhombus"), ("vh", "half_vertical"), ("hh", "half_horizontal"), ("vhr", "half_vertical_right"), ("hhb", "half_horizontal_bottom"),
        ("bo", "border"), ("cbo", "curly_border"), ("gra", "gradient"), ("gru", "gradient_up"), ("bri", "bricks"),
        ("glb", "globe"), ("cre", "creeper"), ("sku", "skull"), ("flo", "flower"), ("moj", "mojang"), ("pig", "piglin"),
    ]
    for (a, b) in codes {
        if code == String(a) {
            return "minecraft:{b}"
        }
    }
    return code.copy()
}

// `ItemStackComponentizationFix.fixProfile`.
fn fix_profile(t: Tag) -> Tag {
    var profile = JavaHashMap<String, Tag>()
    match t {
        Tag.Str(name) => {
            if valid_player_name(name) {
                profile.insert(String("name"), Tag.Str(name.copy()))
            }
            return Tag.Compound(profile)
        },
        Tag.Compound(m) => {
            let name = string_at(m, "Name") ?? String()
            if valid_player_name(name) {
                profile.insert(String("name"), Tag.Str(name))
            }
            if m.contains("Id") {
                profile.insert(String("id"), m["Id"].copy())
            }
            if m.contains("Properties") {
                if let props = profile_properties(m["Properties"]) {
                    profile.insert(String("properties"), props)
                }
            }
            return Tag.Compound(profile)
        },
        _ => {
            // `get("Name")` of what isn't a map fails: an empty profile.
            return Tag.Compound(profile)
        },
    }
}

fn valid_player_name(name: String) -> bool {
    var units = 0
    for ch in name.chars() {
        let u = u32(ch)
        units += if u > 0xFFFF { 2 } else { 1 }
        if u <= 32 or u >= 127 {
            return false
        }
    }
    return units <= 16
}

// `fixProfileProperties`: each property's values as `{name, value, signature}`, in the order
// of the compound's keys, or `none` if there are none.
fn profile_properties(t: Tag) -> Tag? {
    let m = match t {
        Tag.Compound(m) => m.copy(),
        _ => return none,
    }
    if m.is_empty() {
        return none
    }
    var out = List<Tag>()
    for (name, values) in m {
        match values {
            Tag.List(vs) => {
                for v in vs {
                    var p = JavaHashMap<String, Tag>()
                    p.insert(String("name"), Tag.Str(name.copy()))
                    var value = String()
                    var signature: String? = none
                    match v {
                        Tag.Compound(pm) => {
                            value = string_at(pm, "Value") ?? String()
                            signature = string_at(pm, "Signature")
                        },
                        _ => {},
                    }
                    p.insert(String("value"), Tag.Str(value))
                    if let s = signature {
                        p.insert(String("signature"), Tag.Str(s))
                    }
                    out.push(Tag.Compound(p))
                }
            },
            _ => {},
        }
    }
    return some(Tag.List(out))
}

// `OminousBannerRarityFix` on a banner's or a white banner's components: where `item_name` is
// the ominous banner's, it's made again as plain JSON, and the rarity is uncommon.
fn ominous_rarity(t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            if let name = string_at(c, "minecraft:item_name") {
                if translation_of(name) == some(String("block.minecraft.ominous_banner")) {
                    c.insert(String("minecraft:item_name"), Tag.Str(translate_json(String("block.minecraft.ominous_banner"))))
                    c.insert(String("minecraft:rarity"), Tag.Str("uncommon"))
                }
            }
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// `LockComponentPredicateFix.fixLock`: a lock's name as a predicate on an item's custom name,
// or `none` for one that isn't a string or is empty.
fn lock_predicate(t: Tag) -> Tag? {
    let name = match t {
        Tag.Str(s) => s.copy(),
        _ => return none,
    }
    if name.is_empty() {
        return none
    }
    // Guava's escaper of `"` and `\`: the backslashes first, so the quotes' aren't escaped twice.
    var escaped = String("\"")
    escaped.push_str(name.replace("\\", "\\\\").replace("\"", "\\\""))
    escaped.push_str("\"")
    var comps = JavaHashMap<String, Tag>()
    comps.insert(String("minecraft:custom_name"), Tag.Str(escaped))
    var p = JavaHashMap<String, Tag>()
    p.insert(String("components"), Tag.Compound(comps))
    return some(Tag.Compound(p))
}

// `InvalidLockComponentFix.isBrokenLock`: a predicate on nothing but a custom name of `""`.
fn broken_lock(t: Tag) -> bool {
    match t {
        Tag.Compound(m) => {
            if m.len() != 1 or not m.contains("components") {
                return false
            }
            match m["components"] {
                Tag.Compound(cm) => {
                    if cm.len() != 1 {
                        return false
                    }
                    return string_at(cm, "minecraft:custom_name") == some(String("\"\""))
                },
                _ => return false,
            }
        },
        _ => return false,
    }
}

// `PotDecorationsComponentUnflatteningFix.unpackList`: four sides from a list of item names,
// a brick where there's none, as items with no count; anything that isn't a list stays.
fn unpack_sherds(t: own Tag) -> Tag {
    let ids = match t {
        Tag.List(l) => l.copy(),
        _ => return t,
    }
    var out = JavaHashMap<String, Tag>(4)
    let sides: List<str> = ["back", "left", "right", "front"]
    for i in 0..sides.len() {
        var id = String("minecraft:brick")
        if i < ids.len() {
            match ids[i] {
                Tag.Str(s) => id = s.copy(),
                _ => {},
            }
        }
        if id.is_empty() {
            return Tag.List(ids)
        }
        var stack = JavaHashMap<String, Tag>()
        stack.insert(String("id"), Tag.Str(id))
        out.insert(String(sides[i]), Tag.Compound(stack))
    }
    return Tag.Compound(out)
}

// --- Entities -------------------------------------------------------------------------------

fn entity_rule(r: mut Run, id: String, c: mut JavaHashMap<String, Tag>) {
    let k = r.key
    if k == 27020 and (id == "minecraft:arrow" or id == "minecraft:spectral_arrow" or id == "minecraft:trident") {
        if not c.contains("pickup") {
            let from_player = bool_or(c, "player", true)
            c.insert(String("pickup"), Tag.Byte(if from_player { 1i8 } else { 0i8 }))
            _ = c.remove("player")
        }
    } else if k == 28310 and id == "minecraft:spawner_minecart" {
        spawner_data_fix(mut c)
    } else if k == 30860 and id == "minecraft:cat" {
        if c.contains("CatType") {
            if let n = c["CatType"].number_int() {
                let names: List<str> = ["tabby", "black", "red", "siamese", "british", "calico", "persian", "ragdoll", "white", "jellie", "all_black"]
                let name = if n >= 0 and n < 11 { names[usize.wrap(n)] } else { "tabby" }
                c.insert(String("variant"), Tag.Str("minecraft:{name}"))
            }
        }
    } else if k == 30870 and id == "minecraft:frog" {
        if c.contains("Variant") {
            if let n = c["Variant"].number_int() {
                let names: List<str> = ["temperate", "warm", "cold"]
                if n >= 0 and n < 3 {
                    c.insert(String("variant"), Tag.Str("minecraft:{names[usize.wrap(n)]}"))
                } else {
                    r.unported(String("a frog's unknown variant"))
                }
            }
        }
    } else if k == 30900 and id == "minecraft:painting" {
        rename(mut c, "Motive", "variant")
        rename(mut c, "Facing", "facing")
    } else if k == 30930 and id == "minecraft:goat" {
        r.unported(String("a goat"))
    } else if k == 30970 and id == "minecraft:cat" {
        if string_at(c, "variant") == some(String("minecraft:british")) {
            c.insert(String("variant"), Tag.Str("minecraft:british_shorthair"))
        }
    } else if (k == 33220 or k == 35680) and (c.contains("ActiveEffects") or c.contains("active_effects") or c.contains("Effects") or c.contains("effects")) {
        r.unported(String("an entity's effects"))
    } else if k == 36830 and (id == "minecraft:tnt" or id == "minecraft:tnt_minecart") {
        r.unported(String("primed TNT"))
    } else if k == 36850 and (id == "minecraft:arrow" or id == "minecraft:spectral_arrow" or id == "minecraft:trident" or id == "minecraft:potion") {
        r.unported("a {id}'s stored item")
    } else if k == 38080 and id == "minecraft:horse" {
        // `HorseBodyArmorItemFix`s write the entity and read it again.
        horse_armor(mut c, "ArmorItem", true)
        keep_remainder(mut c, true)
    } else if k == 38081 and id == "minecraft:llama" {
        horse_armor(mut c, "DecorItem", false)
        keep_remainder(mut c, true)
    } else if k == 38082 and id == "minecraft:trader_llama" {
        horse_armor(mut c, "DecorItem", false)
        keep_remainder(mut c, true)
    } else if k == 38090 and (id == "minecraft:llama" or id == "minecraft:trader_llama" or id == "minecraft:donkey" or id == "minecraft:mule") and c.contains("Items") {
        r.unported(String("a chested horse's inventory"))
    } else if k == 38120 and id == "minecraft:wolf" {
        r.unported(String("a wolf's health"))
    } else if k == 38130 {
        if id == "minecraft:bee" {
            rename_block_pos(mut c, "HivePos", "hive_pos")
            rename_block_pos(mut c, "FlowerPos", "flower_pos")
        } else if id == "minecraft:end_crystal" {
            rename_block_pos(mut c, "BeamTarget", "beam_target")
        } else if id == "minecraft:wandering_trader" {
            rename_block_pos(mut c, "WanderTarget", "wander_target")
        } else {
            let patrolling: List<str> = ["witch", "ravager", "pillager", "illusioner", "evoker", "vindicator"]
            for p in patrolling {
                if id == "minecraft:{p}" {
                    rename_block_pos(mut c, "PatrolTarget", "patrol_target")
                }
            }
        }
        rename_block_pos(mut c, "Leash", "leash")
    } else if k == 38140 {
        if let v = c.remove("Attributes") {
            c.insert(String("Attributes"), map_attributes(v, "Name", jump_strength))
        }
    } else if (k == 38182 or k == 38186 or k == 38184) and (id == "minecraft:arrow" or id == "minecraft:area_effect_cloud") {
        r.unported("a {id}'s potion")
    } else if k == 38280 {
        // The trades, in `trade`.
    } else if k == 39380 and (id == "minecraft:arrow" or id == "minecraft:spectral_arrow") {
        r.unported("a {id}'s weapon")
    } else if k == 39450 {
        if let v = c.remove("Attributes") {
            c.insert(String("attributes"), match v {
                Tag.List(attrs) => {
                    var out = List<Tag>()
                    var attrs_left = reversed(attrs)
                    while let a = attrs_left.pop() {
                        out.push(fix_attribute(a))
                    }
                    Tag.List(out)
                },
                other => other,
            })
        }
    } else if k == 40550 {
        if let v = c.remove("attributes") {
            c.insert(String("attributes"), map_attributes(v, "id", prefix_free))
        }
    } else if k == 40670 and (id.ends_with("boat") or id.ends_with("raft")) {
        r.unported(String("a boat"))
    } else if k == 40810 and id == "minecraft:salmon" {
        r.unported(String("a salmon"))
    } else if k == 41730 and id == "minecraft:tnt_minecart" {
        rename(mut c, "TNTFuse", "fuse")
    } else if k == 41870 {
        let pairs: List<(str, f64, f64)> = [("villager", 48.0, 16.0), ("bee", 48.0, 16.0), ("allay", 48.0, 16.0), ("llama", 40.0, 16.0), ("piglin_brute", 16.0, 12.0), ("warden", 16.0, 24.0)]
        for (e, was, now) in pairs {
            if id == "minecraft:{e}" {
                follow_range(mut c, was, now)
            }
        }
    } else if k == 42930 {
        drop_chances(mut c)
    } else if k == 42960 and id == "minecraft:area_effect_cloud" {
        r.unported(String("an area effect cloud"))
    } else if k == 43000 {
        saddle(mut c, id)
    } else if k == 43010 {
        equipment(mut c)
    } else if k == 43030 {
        if let v = c.remove("FallDistance") {
            c.insert(String("fall_distance"), Tag.Double(f64(v.number_float() ?? 0.0f32)))
        }
    } else if k == 43060 and id == "minecraft:potion" {
        r.unported(String("a thrown potion"))
    } else if k == 43140 {
        inline_block_pos(mut c, "SleepingX", "SleepingY", "SleepingZ", "sleeping_pos")
        if id == "minecraft:vex" {
            rename(mut c, "LifeTicks", "life_ticks")
            inline_block_pos(mut c, "BoundX", "BoundY", "BoundZ", "bound_pos")
        } else if id == "minecraft:phantom" {
            rename(mut c, "Size", "size")
            inline_block_pos(mut c, "AX", "AY", "AZ", "anchor_pos")
        } else if id == "minecraft:turtle" {
            _ = c.remove("TravelPosX")
            _ = c.remove("TravelPosY")
            _ = c.remove("TravelPosZ")
            inline_block_pos(mut c, "HomePosX", "HomePosY", "HomePosZ", "home_pos")
            rename(mut c, "HasEgg", "has_egg")
        } else if id == "minecraft:item_frame" or id == "minecraft:glow_item_frame" or id == "minecraft:painting" or id == "minecraft:leash_knot" {
            inline_block_pos(mut c, "TileX", "TileY", "TileZ", "block_pos")
        }
    } else if k == 44240 {
        // `AddFieldFix`, which gives back the field at its path with `style` set in place of the
        // entity it's in, where the entity has it.
        if c.contains("locator_bar_icon") {
            r.unported(String("an entity's locator bar icon"))
        }
    } else if k == 45350 and id == "minecraft:copper_golem" {
        r.unported(String("a copper golem"))
    } else if k == 46490 and id == "minecraft:trident" {
        r.unported(String("a trident"))
    } else if k == 47630 and (id == "minecraft:villager" or id == "minecraft:zombie_villager") {
        c.insert(String("VillagerDataFinalized"), Tag.Byte(1))
    } else if k == 48850 and id == "minecraft:falling_block" {
        if c.contains("TileEntityData") and be_id(c["TileEntityData"]) == "minecraft:bed" {
            _ = c.remove("TileEntityData")
        }
    }
}

// `HorseBodyArmorItemFix`.
fn horse_armor(c: mut JavaHashMap<String, Tag>, old: str, clear: bool) {
    let armor = c.remove(old) else return
    if clear {
        match c.remove("ArmorItems") {
            some(Tag.List(items)) => {
                var out = items
                if out.len() > 2 {
                    out[2] = Tag.Compound(JavaHashMap<String, Tag>())
                }
                c.insert(String("ArmorItems"), Tag.List(out))
            },
            some(other) => c.insert(String("ArmorItems"), other),
            none => {},
        }
        match c.remove("ArmorDropChances") {
            some(Tag.List(items)) => {
                var out = items
                if out.len() > 2 {
                    out[2] = Tag.Float(0.085f32)
                }
                c.insert(String("ArmorDropChances"), Tag.List(out))
            },
            some(other) => c.insert(String("ArmorDropChances"), other),
            none => {},
        }
    }
    c.insert(String("body_armor_item"), armor)
    c.insert(String("body_armor_drop_chance"), Tag.Float(2.0f32))
}

// Each attribute's string at `key` through `f`.
fn map_attributes(t: own Tag, key: str, f: fn(String) -> String) -> Tag {
    match t {
        Tag.List(attrs) => {
            var out = List<Tag>()
            var attrs_left = reversed(attrs)
            while let a = attrs_left.pop() {
                out.push(match a {
                    Tag.Compound(am) => {
                        var ac = am
                        if let s = string_at(ac, key) {
                            ac.insert(String(key), Tag.Str(f(s)))
                        }
                        Tag.Compound(ac)
                    },
                    other => other,
                })
            }
            return Tag.List(out)
        },
        _ => return t,
    }
}

// `AttributesRenameLegacy`'s rename at 3814.
fn jump_strength(id: String) -> String {
    return if namespaced(id) == "minecraft:horse.jump_strength" { String("minecraft:generic.jump_strength") } else { id.copy() }
}

// `AttributeIdPrefixFix`: the prefixes `generic.`, `horse.`, `player.` and `zombie.` dropped.
fn prefix_free(id: String) -> String {
    let full = namespaced(id)
    for p in ["generic.", "horse.", "player.", "zombie."] {
        let prefixed = "minecraft:{p}"
        if full.starts_with(prefixed) {
            return "minecraft:{full[prefixed.len()..]}"
        }
    }
    return id.copy()
}

// `AttributeModifierIdFix.fixAttribute`.
fn fix_attribute(t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            rename(mut c, "Name", "id")
            rename(mut c, "Base", "base")
            if let mods = c.remove("Modifiers") {
                c.insert(String("modifiers"), match mods {
                    Tag.List(list) => {
                        var converted = List<Tag>()
                        var list_left = reversed(list)
                        while let md = list_left.pop() {
                            converted.push(entity_modifier(md))
                        }
                        Tag.List(modifier_ids(converted))
                    },
                    other => other,
                })
            }
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// `convertModifierForEntity`.
fn entity_modifier(t: own Tag) -> Tag {
    match t {
        Tag.Compound(m) => {
            var c = m
            rename(mut c, "UUID", "uuid")
            rename(mut c, "Name", "name")
            rename(mut c, "Amount", "amount")
            if let op = c.remove("Operation") {
                let name = match op.number_int() ?? 0 {
                    0 => "add_value",
                    1 => "add_multiplied_base",
                    2 => "add_multiplied_total",
                    _ => "invalid",
                }
                c.insert(String("operation"), Tag.Str(String(name)))
            }
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// `AttributeModifierIdFix.fixModifiers`: each modifier's ID from its UUID or name, the ones of
// one name summed, kept in the order they're first met.
fn modifier_ids(modifiers: List<Tag>) -> List<Tag> {
    var ids = List<String>()
    var values = List<Tag>()
    for t in modifiers {
        var c = match t {
            Tag.Compound(m) => m.copy(),
            _ => JavaHashMap<String, Tag>(),
        }
        var uuid: String? = none
        if c.contains("uuid") {
            if let ints = c["uuid"].int_stream() {
                if ints.len() == 4 {
                    uuid = some(uuid_text(ints))
                }
            }
        }
        let name = string_at(c, "name") ?? String()
        var from_uuid: String? = none
        if let u = uuid {
            from_uuid = known_modifier(u)
        }
        let from_name = named_modifier(name)
        if let id = from_uuid {
            c.insert(String("id"), Tag.Str(id.copy()))
            _ = c.remove("uuid")
            _ = c.remove("name")
            put_modifier(mut ids, mut values, id, Tag.Compound(c))
        } else if let id = from_name {
            var at: usize? = none
            for i in 0..ids.len() {
                if ids[i] == id {
                    at = some(i)
                }
            }
            match at {
                none => {
                    c.insert(String("id"), Tag.Str(id.copy()))
                    _ = c.remove("uuid")
                    _ = c.remove("name")
                    put_modifier(mut ids, mut values, id, Tag.Compound(c))
                },
                some(i) => {
                    let added = if c.contains("amount") { c["amount"].number_double() ?? 0.0 } else { 0.0 }
                    var updated: JavaHashMap<String, Tag>? = none
                    match values[i] {
                        Tag.Compound(pm) => {
                            var p = pm.copy()
                            let amount = if p.contains("amount") { p["amount"].number_double() ?? 0.0 } else { 0.0 }
                            p.insert(String("amount"), Tag.Double(amount + added))
                            updated = some(p)
                        },
                        _ => {},
                    }
                    if let p = updated {
                        values[i] = Tag.Compound(p)
                    }
                },
            }
        } else {
            let id = match uuid {
                some(u) => "minecraft:{u}",
                none => String("minecraft:unknown"),
            }
            c.insert(String("id"), Tag.Str(id.copy()))
            _ = c.remove("uuid")
            _ = c.remove("name")
            put_modifier(mut ids, mut values, id, Tag.Compound(c))
        }
    }
    return values
}

// `Object2ObjectArrayMap.put`: a key that's there keeps its place and takes the value.
fn put_modifier(ids: mut List<String>, values: mut List<Tag>, id: String, value: own Tag) {
    for i in 0..ids.len() {
        if ids[i] == id {
            values[i] = value
            return
        }
    }
    ids.push(id.copy())
    values.push(value)
}

// A UUID from four ints, as `UUID.toString` writes it, lowercase.
fn uuid_text(ints: List<i32>) -> String {
    let hex = "0123456789abcdef"
    var s = String()
    var at = 0
    for i in 0..ints.len() {
        let v = u32.wrap(ints[i])
        for n in 0..8 {
            let shift = u32.wrap(28 - 4 * n)
            let d = usize((v >> shift) & 15)
            s.push_str(hex[d..d + 1])
            if at == 7 or at == 11 or at == 15 or at == 19 {
                s.push_str("-")
            }
            at += 1
        }
    }
    return s
}

fn known_modifier(uuid: String) -> String? {
    let known: List<(str, str)> = [
        ("736565d2-e1a7-403d-a3f8-1aeb3e302542", "creative_mode_block_range"),
        ("98491ef6-97b1-4584-ae82-71a8cc85cf73", "creative_mode_entity_range"),
        ("91aeaa56-376b-4498-935b-2f7f68070635", "effect.speed"),
        ("7107de5e-7ce8-4030-940e-514c1f160890", "effect.slowness"),
        ("af8b6e3f-3328-4c0a-aa36-5ba2bb9dbef3", "effect.haste"),
        ("55fced67-e92a-486e-9800-b47f202c4386", "effect.mining_fatigue"),
        ("648d7064-6a60-4f59-8abe-c2c23a6dd7a9", "effect.strength"),
        ("c0105bf3-aef8-46b0-9ebc-92943757ccbe", "effect.jump_boost"),
