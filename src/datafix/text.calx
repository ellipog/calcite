/// Vanilla's data fixes of text components: the JSON a text was kept as before 1.21.5, its
/// helpers in `LegacyComponentDataFixUtils`, and the fixes of 4290 to 4292, which unflatten that
/// JSON into NBT, read its flags as booleans and rename its events.
module datafix.text

import datafix.util.{namespaced, string_at}
import java.uri.{Uri}
import json.gson.{JsonWriter}
import json.strict.{parse_lenient, parse_strict}
import json.tree.{Json}
import nbt.tag.{Tag}

/// `createTextComponentJson`: `{"text":...}`, as `GsonHelper.toStableString` writes it.
pub fn text_json(text: String) -> String {
    var w = JsonWriter.new()
    w.begin_object()
    w.name(String("text"))
    w.string(text)
    w.end_object()
    return w.into_string()
}

/// `createTranslatableComponentJson`: `{"translate":...}`.
pub fn translate_json(key: String) -> String {
    var w = JsonWriter.new()
    w.begin_object()
    w.name(String("translate"))
    w.string(key)
    w.end_object()
    return w.into_string()
}

/// `createEmptyComponent`: the empty text's JSON, as a string tag.
pub fn empty_component() -> Tag {
    return Tag.Str(text_json(String()))
}

// The JSON in `text`, as `LenientJsonParser` reads it, or `none` where it can't be read.
fn parse_json(text: String) -> Json? {
    return match parse_lenient(text) {
        ok(v) => some(v),
        err(_) => none,
    }
}

/// `extractTranslationString`: the `translate` key of the JSON object in `text`, if it's a
/// primitive, as its string.
pub fn translation_of(text: String) -> String? {
    let v = parse_json(text) else return none
    match v {
        Json.Object(members) => {
            for m in members {
                if m.key == "translate" {
                    return match m.value {
                        Json.Str(s) => some(s.copy()),
                        Json.Number(n) => some(n.copy()),
                        Json.Bool(b) => some(String(if b { "true" } else { "false" })),
                        _ => none,
                    }
                }
            }
            return none
        },
        _ => return none,
    }
}

/// `isStrictlyValidJson`: whether the tag is a string `StrictJsonParser` reads.
pub fn strictly_valid(t: Tag) -> bool {
    return match t {
        Tag.Str(s) => match parse_strict(s.to_bytes()) {
            ok(_) => true,
            err(_) => false,
        },
        _ => false,
    }
}

/// `UnflattenTextComponentFix` (4290): a text kept as JSON, as NBT. Text whose JSON can't be
/// read, or is `null`, stays a string. The NBT is read as 4290's text type with what it takes
/// in part (`read_text`), and `none` where that read fails, where the JSON is a number or a
/// boolean: vanilla throws, and the template with it doesn't load.
pub fn unflatten(t: own Tag) -> Tag? {
    match t {
        Tag.Str(s) => {
            let v = parse_json(s) else return some(Tag.Str(s))
            return match v {
                Json.Null => some(Tag.Str(s)),
                // A `null` inside is `EndTag`, which a list or a compound can't take, so the
                // conversion throws, and the fix keeps the string.
                _ => match nbt_of_json(v) {
                    some(nbt) => read_text(nbt),
                    none => some(Tag.Str(s)),
                },
            }
        },
        _ => return some(t),
    }
}

// `JsonOps.convertTo(NbtOps)` of a value inside which there's no `null`, or `none`.
fn nbt_of_json(v: Json) -> Tag? {
    match v {
        Json.Null => return none,
        Json.Array(items) => {
            var out = List<Tag>()
            for e in items {
                let nbt = nbt_of_json(e) else return none
                out.push(nbt)
            }
            return some(Tag.List(out))
        },
        Json.Object(members) => {
            var c = JavaHashMap<String, Tag>()
            for m in members {
                let nbt = nbt_of_json(m.value) else return none
                c.insert(m.key.copy(), nbt)
            }
            return some(Tag.Compound(c))
        },
        _ => return some(Tag.from_json(v)),
    }
}

// A text as DataFixerUpper reads it as 4290's text type, a string, a list of texts, or a
// compound whose `extra`, `separator` and hover event are typed where they read whole: `none`
// where it can't be read at all. A list keeps the elements that read and loses the rest, as
// `ListCodec`'s partial result does, which the fix takes; a compound always reads, what's in it
// that doesn't read whole left as it was, in its remainder.
fn read_text(t: own Tag) -> Tag? {
    match t {
        Tag.Str(_) => return some(t),
        Tag.Compound(_) => return some(t),
        Tag.List(items) => {
            var out = List<Tag>()
            var items_left = reversed(items)
            while let e = items_left.pop() {
                if let kept = read_text(e) {
                    out.push(kept)
                }
            }
            return some(Tag.List(out))
        },
        _ => return none,
    }
}

/// Whether a text reads whole as the text type, with nothing lost: a part of a compound that
/// doesn't isn't typed, and the fixes don't reach into it.
pub fn reads_whole(t: Tag) -> bool {
    return match t {
        Tag.Str(_) => true,
        Tag.Compound(_) => true,
        Tag.List(items) => {
            for e in items {
                if not reads_whole(e) {
                    return false
                }
            }
            true
        },
        _ => false,
    }
}

/// Whether the hover event at `key` is typed: a compound whose `action` is one the schema
/// knows.
pub fn hover_typed(m: JavaHashMap<String, Tag>, key: str) -> bool {
    if not m.contains(key) {
        return false
    }
    return match m[key] {
        Tag.Compound(h) => match string_at(h, "action") {
            some(a) => a == "show_text" or a == "show_item" or a == "show_entity",
            none => false,
        },
        _ => false,
    }
}

/// The fixes of text components that are NBT, from 4291 (`stage` 1) or 4292 (`stage` 2), to a
/// text and the texts in it that are typed, the innermost first: 4291's
/// `TextComponentStringifiedFlagsFix` reads a flag kept as a string as `Boolean.parseBoolean`
/// does, and 4292's `TextComponentHoverAndClickEventFix` renames the events and their fields.
pub fn fix_text(t: own Tag, stage: i32) -> Tag {
    match t {
        Tag.List(items) => {
            var out = List<Tag>()
            var items_left = reversed(items)
            while let e = items_left.pop() {
                out.push(if reads_whole(e) { fix_text(e, stage) } else { e })
            }
            return Tag.List(out)
        },
        Tag.Compound(m) => {
            var c = m
            // The texts inside, first, where they're typed.
            if let extra = c.remove("extra") {
                c.insert(String("extra"), match extra {
                    Tag.List(items) => {
                        let whole = reads_whole(Tag.List(items.copy()))
                        if whole {
                            var out = List<Tag>()
                            var items_left = reversed(items)
                            while let e = items_left.pop() {
                                out.push(fix_text(e, stage))
                            }
                            Tag.List(out)
                        } else {
                            Tag.List(items)
                        }
                    },
                    other => other,
                })
            }
            if let sep = c.remove("separator") {
                c.insert(String("separator"), if reads_whole(sep) { fix_text(sep, stage) } else { sep })
            }
            if hover_typed(c, "hoverEvent") {
                if let h = c.remove("hoverEvent") {
                    c.insert(String("hoverEvent"), fix_hover_texts(h, stage))
                }
            }
            if stage == 1 {
                for flag in ["bold", "italic", "underlined", "strikethrough", "obfuscated"] {
                    if let s = string_at(c, flag) {
                        c.insert(String(flag), Tag.Byte(if s.to_lower_root() == "true" { 1i8 } else { 0i8 }))
                    }
                }
            } else {
                let has_hover = hover_typed(c, "hoverEvent")
                let has_click = c.contains("clickEvent")
                if has_hover or has_click {
                    if let h = c.remove("hoverEvent") {
                        c.insert(String("hover_event"), fix_hover_event(h))
                    }
                    if let k = c.remove("clickEvent") {
                        if let fixed = fix_click_event(k) {
                            c.insert(String("click_event"), fixed)
                        }
                    }
                }
            }
            return Tag.Compound(c)
        },
        _ => return t,
    }
}

// The texts in a typed hover event the fixes reach: `show_text`'s contents. A `show_entity`'s
// name is typed as a text too, but vanilla's text fixes don't reach it, as its output shows.
fn fix_hover_texts(h: own Tag, stage: i32) -> Tag {
    match h {
        Tag.Compound(m) => {
            var c = m
            if string_at(c, "action") == some(String("show_text")) {
                if let v = c.remove("contents") {
                    c.insert(String("contents"), if reads_whole(v) { fix_text(v, stage) } else { v })
                }
            }
            return Tag.Compound(c)
        },
        _ => return h,
    }
}

// `fixHoverEvent`.
fn fix_hover_event(h: own Tag) -> Tag {
    match h {
        Tag.Compound(m) => {
            var c = m
            let action = string_at(c, "action") ?? String()
            if action == "show_text" {
                if let v = c.remove("contents") {
                    c.insert(String("value"), v)
                }
            } else if action == "show_item" or action == "show_entity" {
                let fields: List<str> = if action == "show_item" { ["id", "count", "components"] } else { ["id", "type", "name"] }
                var contents = JavaHashMap<String, Tag>()
                match c.remove("contents") {
                    some(Tag.Compound(cm)) => contents = cm,
                    // An item stack since 3818.5 reads a plain ID as that item, one of it
                    // (`V3818_5.UNPACK_PLAIN_ID`).
                    some(Tag.Str(s)) => {
                        if action == "show_item" {
                            contents.insert(String("id"), Tag.Str(s))
                            contents.insert(String("count"), Tag.Int(1))
                        }
                    },
                    _ => {},
                }
                // The item's `id` is an item name, and the entity's `type` an entity name, each
                // namespaced as it's read.
                let named = if action == "show_item" { "id" } else { "type" }
                if let id = string_at(contents, named) {
                    contents.insert(String(named), Tag.Str(namespaced(id)))
                }
                for f in fields {
                    if contents.contains(f) {
                        c.insert(String(f), contents[f].copy())
                    }
                }
                if action == "show_entity" {
                    if let id = c.remove("id") {
                        c.insert(String("uuid"), id)
                    }
                    if let ty = c.remove("type") {
                        c.insert(String("id"), ty)
                    }
                }
            }
            return Tag.Compound(c)
        },
        _ => return h,
    }
}

// `fixClickEvent`: `none` where the event is dropped.
fn fix_click_event(k: own Tag) -> Tag? {
    match k {
        Tag.Compound(m) => {
            var c = m
            let action = string_at(c, "action") ?? String()
            let value = string_at(c, "value") ?? String()
            if action == "open_url" {
                match Uri.untrusted(value) {
                    ok(_) => {},
                    err(_) => return none,
                }
                if let v = c.remove("value") {
                    c.insert(String("url"), v)
                }
            } else if action == "open_file" {
                if let v = c.remove("value") {
                    c.insert(String("path"), v)
                }
            } else if action == "run_command" or action == "suggest_command" {
                for ch in value.chars() {
                    let u = u32(ch)
                    if u == 167 or u < 32 or u == 127 {
                        return none
                    }
                }
                if let v = c.remove("value") {
                    c.insert(String("command"), v)
                }
            } else if action == "change_page" {
                let page = old_page(c) else return none
                _ = c.remove("value")
                c.insert(String("page"), Tag.Int(page.max(1)))
            }
            return some(Tag.Compound(c))
        },
        _ => return some(k),
    }
}

// `parseOldPage`: a number's `intValue`, or a string's `Integer.parseInt`.
fn old_page(c: JavaHashMap<String, Tag>) -> i32? {
    if not c.contains("value") {
        return none
    }
    if let n = c["value"].number_int() {
        return some(n)
    }
    let s = string_at(c, "value") else return none
    return i32.parse(s)
}

// The elements of `l`, last first, each moved out: popping them again gives them in order.
fn reversed(l: own List<Tag>) -> List<Tag> {
    var from = l
    var out = List<Tag>()
    out.reserve(from.len())
    while let e = from.pop() {
        out.push(e)
    }
    return out
}
