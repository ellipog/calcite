/// JSON written as vanilla's Gson writes it: compact, with members in the order they're added,
/// and strings escaped as `new GsonBuilder().disableHtmlEscaping()` escapes them.
module json.gson

/// Writes JSON as it goes, with no tree in between: `begin_object`, then `name` and a value for
/// each member, then `end_object`. Commas go where they belong.
pub struct JsonWriter {
    out: String
    // Whether a value was just written, so the next one needs a comma first.
    after_value: bool
}

impl JsonWriter {
    pub fn new() -> JsonWriter {
        return JsonWriter { out: String(), after_value: false }
    }

    /// The JSON written.
    pub fn into_string(own self) -> String {
        return self.out
    }

    pub fn begin_object(mut self) {
        self.comma()
        self.out.push('{')
        self.after_value = false
    }

    pub fn end_object(mut self) {
        self.out.push('}')
        self.after_value = true
    }

    pub fn begin_array(mut self) {
        self.comma()
        self.out.push('[')
        self.after_value = false
    }

    pub fn end_array(mut self) {
        self.out.push(']')
        self.after_value = true
    }

    /// The next member's name, before its value.
    pub fn name(mut self, key: String) {
        self.comma()
        self.quoted(key)
        self.out.push(':')
        self.after_value = false
    }

    pub fn string(mut self, s: String) {
        self.comma()
        self.quoted(s)
        self.after_value = true
    }

    pub fn i32(mut self, v: i32) {
        self.comma()
        self.out.push_str("{v}")
        self.after_value = true
    }

    pub fn i64(mut self, v: i64) {
        self.comma()
        self.out.push_str("{v}")
        self.after_value = true
    }

    pub fn bool(mut self, v: bool) {
        self.comma()
        self.out.push_str(if v { "true" } else { "false" })
        self.after_value = true
    }

    pub fn null(mut self) {
        self.comma()
        self.out.push_str("null")
        self.after_value = true
    }

    fn comma(mut self) {
        if self.after_value {
            self.out.push(',')
        }
    }

    // `s` in quotes. Gson escapes `"` and `\`, the control characters below U+0020, as `\t`,
    // `\b`, `\n`, `\r` and `\f` or else `\u00xx`, and U+2028 and U+2029, which end a line in
    // JavaScript. Everything else is written as itself.
    fn quoted(mut self, s: String) {
        self.out.push('"')
        var start: usize = 0
        var i: usize = 0
        let n = s.len()
        while i < n {
            let b = s.byte_at(i)
            var escape = String()
            var width: usize = 1
            if b == 34 {
                escape = "\\\""
            } else if b == 92 {
                escape = "\\\\"
            } else if b < 0x20 {
                escape = control(b)
            } else if b == 0xE2 and i + 2 < n and s.byte_at(i + 1) == 0x80 and (s.byte_at(i + 2) == 0xA8 or s.byte_at(i + 2) == 0xA9) {
                escape = if s.byte_at(i + 2) == 0xA8 { String("\\u2028") } else { String("\\u2029") }
                width = 3
            }
            if escape.is_empty() {
                i += 1
            } else {
                self.out.push_str(s[start..i])
                self.out.push_str(escape)
                i += width
                start = i
            }
        }
        self.out.push_str(s[start..n])
        self.out.push('"')
    }
}

// A control character's escape.
fn control(b: u8) -> String {
    return match b {
        9 => String("\\t"),
        8 => String("\\b"),
        10 => String("\\n"),
        13 => String("\\r"),
        12 => String("\\f"),
        _ => {
            let hex = "0123456789abcdef"
            "\\u00{hex[usize(b / 16)..usize(b / 16) + 1]}{hex[usize(b % 16)..usize(b % 16) + 1]}"
        },
    }
}
