/// JSON written as vanilla's Gson writes it: compact, with members in the order they're added,
/// and strings escaped as `new GsonBuilder().disableHtmlEscaping()` escapes them, or pretty, as
/// vanilla writes the JSON files it keeps. And what Gson reads from a value: the text for a
/// `String` field, and the `int` of a number.
module json.gson

import json.tree.{Json, Member}

/// The text Gson reads for a `String` field from the value: a string, or a number or boolean as
/// its text. `none` for `null`, no value, or an array or object, which `is_text` tells apart.
pub fn text_of(value: Json?) -> String? {
    return match value {
        some(Json.Str(s)) => some(s.copy()),
        some(Json.Number(t)) => some(t.copy()),
        some(Json.Bool(b)) => some(String(if b { "true" } else { "false" })),
        _ => none,
    }
}

/// Whether Gson can read a `String` field from the value: anything but an array or object.
pub fn is_text(value: Json?) -> bool {
    return match value {
        some(Json.Array(_)) => false,
        some(Json.Object(_)) => false,
        _ => true,
    }
}

/// Writes JSON as it goes, with no tree in between: `begin_object`, then `name` and a value for
/// each member, then `end_object`. Commas go where they belong.
pub struct JsonWriter {
    out: String
    // Whether a value was just written, so the next one needs a comma first.
    after_value: bool
}

impl JsonWriter {
    pub fn new() -> JsonWriter {
        return JsonWriter { out: String(), after_value: false }
    }

    /// The JSON written.
    pub fn into_string(own self) -> String {
        return self.out
    }

    pub fn begin_object(mut self) {
        self.comma()
        self.out.push('{')
        self.after_value = false
    }

    pub fn end_object(mut self) {
        self.out.push('}')
        self.after_value = true
    }

    pub fn begin_array(mut self) {
        self.comma()
        self.out.push('[')
        self.after_value = false
    }

    pub fn end_array(mut self) {
        self.out.push(']')
        self.after_value = true
    }

    /// The next member's name, before its value.
    pub fn name(mut self, key: String) {
        self.comma()
        self.quoted(key)
        self.out.push(':')
        self.after_value = false
    }

    pub fn string(mut self, s: String) {
        self.comma()
        self.quoted(s)
        self.after_value = true
    }

    pub fn i32(mut self, v: i32) {
        self.comma()
        self.out.push_str("{v}")
        self.after_value = true
    }

    pub fn i64(mut self, v: i64) {
        self.comma()
        self.out.push_str("{v}")
        self.after_value = true
    }

    /// A float as Gson writes a `Float`, with Java's `Float.toString`.
    pub fn f32(mut self, v: f32) {
        self.comma()
        self.out.push_str("{v}")
        self.after_value = true
    }

    /// A double as Gson writes a `Double`, with Java's `Double.toString`.
    pub fn f64(mut self, v: f64) {
        self.comma()
        self.out.push_str("{v}")
        self.after_value = true
    }

    pub fn bool(mut self, v: bool) {
        self.comma()
        self.out.push_str(if v { "true" } else { "false" })
        self.after_value = true
    }

    pub fn null(mut self) {
        self.comma()
        self.out.push_str("null")
        self.after_value = true
    }

    /// `value` as Gson's `JsonElement.toString` writes it, each number as its text. A key an
    /// object has more than once is written once, where it first was, with its last value, as
    /// Gson's `JsonObject` keeps it when it reads them.
    pub fn tree(mut self, value: Json) {
        match value {
            Json.Null => self.null(),
            Json.Bool(b) => self.bool(b),
            Json.Number(t) => {
                self.comma()
                self.out.push_str(t)
                self.after_value = true
            },
            Json.Str(s) => self.string(s),
            Json.Array(items) => {
                self.begin_array()
                for item in items {
                    self.tree(item)
                }
                self.end_array()
            },
            Json.Object(members) => {
                self.begin_object()
                for i in kept(members) {
                    self.name(members[i].key)
                    self.tree(members[i].value)
                }
                self.end_object()
            },
        }
    }

    fn comma(mut self) {
        if self.after_value {
            self.out.push(',')
        }
    }

    fn quoted(mut self, s: String) {
        push_quoted(mut self.out, s, false)
    }
}

// A control character's escape.
fn control(b: u8) -> String {
    return match b {
        9 => String("\\t"),
        8 => String("\\b"),
        10 => String("\\n"),
        13 => String("\\r"),
        12 => String("\\f"),
        _ => unicode(b),
    }
}

// `s` in quotes, onto `out`. Gson escapes `"` and `\`, the control characters below U+0020, as
// `\t`, `\b`, `\n`, `\r` and `\f` or else `\u00xx`, and U+2028 and U+2029, which end a line in
// JavaScript. With `html`, as a Gson that escapes HTML does, `<`, `>`, `&`, `=` and `'` are
// written as `\u00xx` too. Everything else is written as itself.
fn push_quoted(out: mut String, s: String, html: bool) {
    out.push('"')
    var start: usize = 0
    var i: usize = 0
    let n = s.len()
    while i < n {
        let b = s.byte_at(i)
        var escape = String()
        var width: usize = 1
        if b == 34 {
            escape = "\\\""
        } else if b == 92 {
            escape = "\\\\"
        } else if b < 0x20 {
            escape = control(b)
        } else if html and (b == 60 or b == 62 or b == 38 or b == 61 or b == 39) {
            escape = unicode(b)
        } else if b == 0xE2 and i + 2 < n and s.byte_at(i + 1) == 0x80 and (s.byte_at(i + 2) == 0xA8 or s.byte_at(i + 2) == 0xA9) {
            escape = String("\\u20")
            escape.push_str(if s.byte_at(i + 2) == 0xA8 { "28" } else { "29" })
            width = 3
        }
        if escape.is_empty() {
            i += 1
        } else {
            out.push_str(s[start..i])
            out.push_str(escape)
            i += width
            start = i
        }
    }
    out.push_str(s[start..n])
    out.push('"')
}

// The escape `\u00xx` of a character below U+0080.
fn unicode(b: u8) -> String {
    let hex = "0123456789abcdef"
    return "\\u00{hex[usize(b / 16)..usize(b / 16) + 1]}{hex[usize(b % 16)..usize(b % 16) + 1]}"
}

// The members of an object that Gson's `JsonObject` keeps when it reads them: each key once,
// where it first was, as the position of its last value.
fn kept(members: List<Member>) -> List<usize> {
    var out = List<usize>()
    let n = members.len()
    if n <= 16 {
        for i in 0..n {
            if first_of(members, i) {
                out.push(last_of(members, i))
            }
        }
        return out
    }
    // Where in `out` each key is.
    var at = Map<String, usize>()
    for i in 0..n {
        if let k = at.get(members[i].key) {
            out[k] = i
        } else {
            at.insert(members[i].key.copy(), out.len())
            out.push(i)
        }
    }
    return out
}

/// `value` as vanilla writes the JSON files it keeps, with a Gson that pretty-prints: each item
/// and member on a line of its own, indented two spaces a level, with a space after a member's
/// colon, an empty array or object as `[]` or `{}`, and `<`, `>`, `&`, `=` and `'` escaped for
/// HTML as well. A member that's `null` is left out, as Gson leaves it out unless it's told to
/// keep them; an item that's `null` stays. Keys an object has more than once are written as
/// `JsonWriter.tree` writes them. No new line ends the text.
pub fn pretty(value: Json) -> String {
    var out = String()
    write_pretty(mut out, value, 0)
    return out
}

// `value`, at `depth` levels in, onto `out`.
fn write_pretty(out: mut String, value: Json, depth: usize) {
    match value {
        Json.Null => out.push_str("null"),
        Json.Bool(b) => out.push_str(if b { "true" } else { "false" }),
        Json.Number(t) => out.push_str(t),
        Json.Str(s) => push_quoted(mut out, s, true),
        Json.Array(items) => {
            out.push('[')
            var any = false
            for item in items {
                if any {
                    out.push(',')
                }
                any = true
                line(mut out, depth + 1)
                write_pretty(mut out, item, depth + 1)
            }
            if any {
                line(mut out, depth)
            }
            out.push(']')
        },
        Json.Object(members) => {
            out.push('{')
            var any = false
            for i in kept(members) {
                if is_null(members[i].value) {
                    continue
                }
                if any {
                    out.push(',')
                }
                any = true
                line(mut out, depth + 1)
                push_quoted(mut out, members[i].key, true)
                out.push_str(": ")
                write_pretty(mut out, members[i].value, depth + 1)
            }
            if any {
                line(mut out, depth)
            }
            out.push('}')
        },
    }
}

// A new line, indented `depth` levels.
fn line(out: mut String, depth: usize) {
    out.push('\n')
    for _ in 0..depth {
        out.push_str("  ")
    }
}

fn is_null(value: Json) -> bool {
    return match value {
        Json.Null => true,
        _ => false,
    }
}

/// The `int` Gson reads from a number, given its JSON text, as `LazilyParsedNumber.intValue`
/// reads it: the text as an `int` if it is one, else as a `long` cut to its low 32 bits, else as
/// a `BigDecimal` with its fraction dropped, cut the same way. `none` where Java throws: for
/// text that isn't a number, text longer than 10,000 characters, and a scale, the digits after
/// the point less the exponent, of 10,000 or more either way.
pub fn int_value(text: String) -> i32? {
    if let v = i32.parse(text) {
        return some(v)
    }
    if let v = i64.parse(text) {
        return some(i32.wrap(v))
    }
    let n = text.len()
    if n > 10000 {
        return none
    }
    var i: usize = 0
    var negative = false
    if i < n and (text.byte_at(i) == 45 or text.byte_at(i) == 43) {
        negative = text.byte_at(i) == 45
        i += 1
    }
    // The digits, with the point taken out, and how many came after it.
    var digits = List<u8>()
    var fraction: i64 = 0
    var point = false
    while i < n {
        let b = text.byte_at(i)
        if b >= 48 and b <= 57 {
            digits.push(b - 48)
            if point {
                fraction += 1
            }
        } else if b == 46 and not point {
            point = true
        } else {
            break
        }
        i += 1
    }
    if digits.is_empty() {
        return none
    }
    // The exponent, held at a billion once it's past one: any scale from there is out of reach.
    var exponent: i64 = 0
    if i < n {
        let e = text.byte_at(i)
        if e != 101 and e != 69 {
            return none
        }
        i += 1
        var minus = false
        if i < n and (text.byte_at(i) == 45 or text.byte_at(i) == 43) {
            minus = text.byte_at(i) == 45
            i += 1
        }
        if i == n {
            return none
        }
        while i < n {
            let b = text.byte_at(i)
            if b < 48 or b > 57 {
                return none
            }
            if exponent < 1000000000 {
                exponent = exponent * 10 + i64(b - 48)
            }
            i += 1
        }
        if minus {
            exponent = 0 - exponent
        }
    }
    let scale = fraction - exponent
    if scale >= 10000 or scale <= -10000 {
        return none
    }
    // The whole part, mod 2^32: the digits less the last `scale` of them, or with `-scale`
    // zeros after them, which make it 0 mod 2^32 after 32.
    let count = digits.len()
    var keep = count
    if scale > 0 {
        let cut = usize.wrap(scale)
        keep = if cut >= count { 0 } else { count - cut }
    }
    var whole: u64 = 0
    for k in 0..keep {
        whole = (whole * 10 + u64(digits[k])) & 0xFFFFFFFF
    }
    var zeros: i64 = if scale < 0 { 0 - scale } else { 0 }
    while zeros > 0 and whole != 0 {
        whole = (whole * 10) & 0xFFFFFFFF
        zeros -= 1
    }
    let low = i32.wrap(whole)
    return some(if negative { 0 - low } else { low })
}

// Whether no member before `i` has its key.
fn first_of(members: List<Member>, i: usize) -> bool {
    for j in 0..i {
        if members[j].key == members[i].key {
            return false
        }
    }
    return true
}

// The last member with member `i`'s key.
fn last_of(members: List<Member>, i: usize) -> usize {
    var last = i
    for j in i + 1..members.len() {
        if members[j].key == members[i].key {
            last = j
        }
    }
    return last
}
