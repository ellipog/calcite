/// JSON read as vanilla reads the JSON files it keeps, players' advancements and statistics
/// among them: through `Files.newBufferedReader` (`java.reader`) with `StrictJsonParser`, which
/// is Gson's `JsonReader` in its strict mode building a `JsonElement`. What it takes and what it
/// refuses are Gson's, and so is which of a file's faults it meets first, text that isn't JSON
/// or bytes that aren't UTF-8, since vanilla logs the two apart.
///
/// Gson's reader holds 1024 chars of the text at a time, and reads on from where it is when it
/// needs more, so it meets bytes that aren't UTF-8 only if it reads that far before it finds a
/// fault in the text. Strict mode takes JSON as RFC 8259 has it, with arrays and objects nested
/// at most 255 deep and numbers under 1024 chars, and a byte order mark at the start. A
/// document that's empty, or only white space, is `null`, and after a `null` nothing more is
/// read. An object keeps the first place of a key it's given twice, with the last value. A
/// `\u` escape of half a surrogate pair is U+FFFD, since a `String` is UTF-8, where Java keeps
/// the half (D170).
///
/// `parse_lenient` reads text as vanilla's `LenientJsonParser` does, Gson's `JsonParser` with the
/// reader in its lenient mode, as the data fixes read old text components.
module json.strict

import java.reader.{buffered_utf8}
import json.tree.{Json, Member}

/// Why a file's text can't be read.
pub enum Unread {
    /// Bytes that aren't UTF-8, for which `StrictJsonParser` throws `JsonIOException`.
    Io
    /// Text that isn't JSON as strict Gson takes it, its `JsonSyntaxException`.
    Syntax
}

/// The value in a file's bytes, as vanilla's `StrictJsonParser` reads it from them.
pub fn parse_strict(bytes: List<u8>) -> Json ! Unread {
    let chars = buffered_utf8(bytes)
    var r = Reader { units: chars.units, fails_from: chars.fails_from, pos: 0, limit: 0, lines: false, line_start: 0, depth: 0, lenient: false }
    let first = try r.next()
    let c = first else return Json.Null
    let value = try r.value(c, false)
    if is_null(value) {
        return value
    }
    let after = try r.next()
    if after != none {
        fail Unread.Syntax
    }
    return value
}

/// The first value in text already decoded, as `GsonHelper.parse` reads one: Gson's adapter for
/// `JsonElement` over a `JsonReader` in its strict mode, which reads that value and nothing
/// after it, so what follows it may be anything. `none` if there's no value, the text empty or
/// only white space, where the reader throws `EOFException`.
pub fn parse_first(units: own List<u16>) -> Json? ! Unread {
    var r = Reader { units: units, fails_from: none, pos: 0, limit: 0, lines: false, line_start: 0, depth: 0, lenient: false }
    let first = try r.next()
    let c = first else return none
    return some(try r.value(c, false))
}

/// The value in `text` as `LenientJsonParser.parse` reads it: Gson's `JsonParser.parseString`,
/// whose reader is lenient while it reads the value. Lenient Gson takes comments (`//`, `#` and
/// `/* */`), strings and names in single quotes or none, `;` between values as well as `,`, `=`
/// or `=>` after a name as well as `:`, `true`, `false` and `null` in capitals, a `)]}'` line
/// before the value, and an empty place in an array as `null`. Text with no value is `null`, and
/// so is text whose value is `null`, whatever follows it; after any other value there may only
/// be white space, which the parser checks with the reader strict again.
pub fn parse_lenient(text: String) -> Json ! Unread {
    var units = List<u16>()
    for ch in text.chars() {
        units.push(u16(ch))
    }
    var r = Reader { units: units, fails_from: none, pos: 0, limit: 0, lines: false, line_start: 0, depth: 0, lenient: true }
    // `consumeNonExecutePrefix`, past white space and comments.
    let first = try r.next()
    if first == none {
        return Json.Null
    }
    r.pos -= 1
    var room = r.pos + 5 <= r.limit
    if not room {
        room = try r.fill_here(5)
    }
    if room {
        let prefix: List<u16> = [41, 93, 125, APOSTROPHE, NEWLINE]
        var all = true
        for k in 0..prefix.len() {
            if r.units[r.pos + k] != prefix[k] {
                all = false
            }
        }
        if all {
            r.pos += 5
        }
    }
    let start = try r.next()
    let c = start else return Json.Null
    let value = try r.value(c, false)
    if is_null(value) {
        return value
    }
    r.lenient = false
    let after = try r.next()
    if after != none {
        fail Unread.Syntax
    }
    return value
}

// The chars Gson's reader holds at a time.
const WINDOW: usize = 1024

// The deepest arrays and objects can nest.
const NESTING: usize = 255

// The keys an object finds by a table once it has this many, rather than by looking at each.
const INDEXED: usize = 16

const TAB: u16 = 9
const NEWLINE: u16 = 10
const FORM_FEED: u16 = 12
const RETURN: u16 = 13
const SPACE: u16 = 32
const QUOTE: u16 = 34
const HASH: u16 = 35
const APOSTROPHE: u16 = 39
const PLUS: u16 = 43
const COMMA: u16 = 44
const MINUS: u16 = 45
const POINT: u16 = 46
const SLASH: u16 = 47
const ZERO: u16 = 48
const NINE: u16 = 57
const COLON: u16 = 58
const SEMICOLON: u16 = 59
const EQUALS: u16 = 61
const GREATER: u16 = 62
const UPPER_A: u16 = 65
const UPPER_E: u16 = 69
const UPPER_F: u16 = 70
const UPPER_N: u16 = 78
const UPPER_T: u16 = 84
const STAR: u16 = 42
const OPEN_ARRAY: u16 = 91
const BACKSLASH: u16 = 92
const CLOSE_ARRAY: u16 = 93
const LOWER_A: u16 = 97
const LOWER_B: u16 = 98
const LOWER_E: u16 = 101
const LOWER_F: u16 = 102
const LOWER_N: u16 = 110
const LOWER_R: u16 = 114
const LOWER_T: u16 = 116
const LOWER_U: u16 = 117
const OPEN_OBJECT: u16 = 123
const CLOSE_OBJECT: u16 = 125
const BOM: u16 = 0xFEFF

const REPLACEMENT: rune = '\u{FFFD}'

// Gson's `JsonReader` over the text: the window it holds is from where it last filled to
// `limit`.
struct Reader {
    units: List<u16>
    // Where reading the file throws, if it does.
    fails_from: usize?
    pos: usize
    limit: usize
    // Whether a line has ended, and where the last began, which say whether a fill looks for a
    // byte order mark.
    lines: bool
    line_start: usize
    depth: usize
    // Whether the reader is in Gson's lenient mode rather than its strict one.
    lenient: bool
}

// What a number has had last, as Gson's `peekNumber` follows it.
enum Part {
    Nothing
    Sign
    Digit
    Point
    Fraction
    E
    ExpSign
    ExpDigit
}

impl Reader {
    // Gson's `fillBuffer`: keeps the chars from `at` on and reads up to a window's worth from
    // there, which throws if it reaches where the file stops decoding. Whether there are at
    // least `minimum` from `at`. A fill at the start of the first line steps past a byte order
    // mark.
    fn fill(mut self, at: usize, minimum: usize) -> bool ! Unread {
        let end = at + WINDOW
        if let f = self.fails_from {
            if end > f {
                fail Unread.Io
            }
        }
        self.limit = end.min(self.units.len())
        self.pos = at
        var need = minimum
        if not self.lines and self.line_start == at and self.limit > at and self.units[at] == BOM {
            self.pos += 1
            self.line_start += 1
            need += 1
        }
        return self.limit - at >= need
    }

    // A fill from where the reader is.
    fn fill_here(mut self, minimum: usize) -> bool ! Unread {
        let at = self.pos
        return try self.fill(at, minimum)
    }

    // Gson's `nextNonWhitespace`: the next char that isn't white space, stepped past, or `none`
    // at the end. Comments are syntax errors in strict mode, but a `/` at the end of the window
    // reads on first, to see what follows it; the lenient mode steps past them.
    fn next(mut self) -> u16? ! Unread {
        loop {
            if self.pos == self.limit {
                if not try self.fill_here(1) {
                    return none
                }
            }
            let c = self.units[self.pos]
            self.pos += 1
            if c == NEWLINE {
                self.lines = true
                self.line_start = self.pos
            } else if c == SPACE or c == RETURN or c == TAB {
                // White space.
            } else if c == SLASH {
                if self.pos == self.limit {
                    let at = self.pos - 1
                    let loaded = try self.fill(at, 2)
                    self.pos = at + 1
                    if not loaded {
                        if not self.lenient {
                            fail Unread.Syntax
                        }
                        return some(c)
                    }
                }
                if not self.lenient {
                    fail Unread.Syntax
                }
                let then = self.units[self.pos]
                if then == STAR {
                    self.pos += 1
                    if not try self.skip_comment() {
                        fail Unread.Syntax
                    }
                    self.pos += 2
                } else if then == SLASH {
                    self.pos += 1
                    try self.skip_line()
                } else {
                    return some(c)
                }
            } else if c == HASH {
                if not self.lenient {
                    fail Unread.Syntax
                }
                try self.skip_line()
            } else {
                return some(c)
            }
        }
    }

    // Gson's `skipTo("*/")`: on to the `*/` that ends a comment, or whether there's none.
    fn skip_comment(mut self) -> bool ! Unread {
        loop {
            if self.pos + 2 > self.limit {
                if not try self.fill_here(2) {
                    return false
                }
            }
            let c = self.units[self.pos]
            if c == NEWLINE {
                self.lines = true
                self.line_start = self.pos + 1
            } else if c == STAR and self.units[self.pos + 1] == SLASH {
                return true
            }
            self.pos += 1
        }
    }

    // Gson's `skipToEndOfLine`: past the next `\n` or `\r`, or to the end.
    fn skip_line(mut self) ! Unread {
        loop {
            if self.pos == self.limit {
                if not try self.fill_here(1) {
                    return
                }
            }
            let c = self.units[self.pos]
            self.pos += 1
            if c == NEWLINE {
                self.lines = true
                self.line_start = self.pos
                return
            }
            if c == RETURN {
                return
            }
        }
    }

    // The value that starts with `c`, read as `doPeek` and Gson's adapter for `JsonElement`
    // read it. In an array, the lenient mode reads an empty place as `null`, the `,`, `;` or `]`
    // after it read again.
    fn value(mut self, c: u16, in_array: bool) -> Json ! Unread {
        if c == QUOTE {
            return Json.Str(try self.quoted(QUOTE))
        }
        if c == APOSTROPHE and self.lenient {
            return Json.Str(try self.quoted(APOSTROPHE))
        }
        if c == OPEN_ARRAY or c == OPEN_OBJECT {
            if self.depth == NESTING {
                fail Unread.Syntax
            }
            self.depth += 1
            let v = if c == OPEN_ARRAY { try self.array() } else { try self.object() }
            self.depth -= 1
            return v
        }
        if c == CLOSE_ARRAY or c == COMMA or c == SEMICOLON {
            if self.lenient and in_array {
                self.pos -= 1
                return Json.Null
            }
            fail Unread.Syntax
        }
        if c == APOSTROPHE {
            fail Unread.Syntax
        }
        // A keyword or a number, read from its first char.
        self.pos -= 1
        if let word = try self.keyword() {
            return word
        }
        if let text = try self.number() {
            return Json.Number(text)
        }
        // An unquoted string, which strict mode refuses.
        if self.lenient and try literal(self.units[self.pos], true) {
            return Json.Str(try self.unquoted())
        }
        fail Unread.Syntax
    }

    // An array's values, after its `[`. The lenient mode takes `;` between them too.
    fn array(mut self) -> Json ! Unread {
        var items = List<Json>()
        let first = try self.next()
        var c = first else fail Unread.Syntax
        if c == CLOSE_ARRAY {
            return Json.Array(items)
        }
        loop {
            items.push(try self.value(c, true))
            let after = try self.next()
            let a = after else fail Unread.Syntax
            if a == CLOSE_ARRAY {
                return Json.Array(items)
            }
            if a != COMMA and not (self.lenient and a == SEMICOLON) {
                fail Unread.Syntax
            }
            let more = try self.next()
            let m = more else fail Unread.Syntax
            c = m
        }
    }

    // An object's members, after its `{`. The lenient mode takes a name in single quotes or
    // none, `=` or `=>` after it, and `;` between members.
    fn object(mut self) -> Json ! Unread {
        var members = List<Member>()
        var index = Map<String, usize>()
        let first = try self.next()
        var c = first else fail Unread.Syntax
        if c == CLOSE_OBJECT {
            return Json.Object(members)
        }
        loop {
            var key = String()
            if c == QUOTE {
                key = try self.quoted(QUOTE)
            } else if self.lenient and c == APOSTROPHE {
                key = try self.quoted(APOSTROPHE)
            } else if self.lenient {
                self.pos -= 1
                if not try literal(self.units[self.pos], true) {
                    fail Unread.Syntax
                }
                key = try self.unquoted()
            } else {
                fail Unread.Syntax
            }
            let colon = try self.next()
            let sep = colon else fail Unread.Syntax
            if sep == EQUALS and self.lenient {
                var room = self.pos < self.limit
                if not room {
                    room = try self.fill_here(1)
                }
                if room and self.units[self.pos] == GREATER {
                    self.pos += 1
                }
            } else if sep != COLON {
                fail Unread.Syntax
            }
            let start = try self.next()
            let s = start else fail Unread.Syntax
            let v = try self.value(s, false)
            put(mut members, mut index, key, v)
            let after = try self.next()
            let a = after else fail Unread.Syntax
            if a == CLOSE_OBJECT {
                return Json.Object(members)
            }
            if a != COMMA and not (self.lenient and a == SEMICOLON) {
                fail Unread.Syntax
            }
            let more = try self.next()
            let m = more else fail Unread.Syntax
            c = m
        }
    }

    // Gson's `nextQuotedValue`: a string's text, from after its opening quote to past its
    // closing one, `quote`. A control char in it is a syntax error in strict mode.
    fn quoted(mut self, quote: u16) -> String ! Unread {
        var text = List<u16>()
        loop {
            while self.pos < self.limit {
                let c = self.units[self.pos]
                self.pos += 1
                if c < SPACE and not self.lenient {
                    fail Unread.Syntax
                }
                if c == quote {
                    return utf8_of(text)
                }
                if c == BACKSLASH {
                    text.push(try self.escape())
                } else {
                    if c == NEWLINE {
                        self.lines = true
                        self.line_start = self.pos
                    }
                    text.push(c)
                }
            }
            if not try self.fill_here(1) {
                fail Unread.Syntax
            }
        }
    }

    // Gson's `nextUnquotedValue`: a literal's text from `pos`, to the first char that can't go
    // on one, or the end.
    fn unquoted(mut self) -> String ! Unread {
        var text = List<u16>()
        loop {
            if self.pos == self.limit {
                if not try self.fill_here(1) {
                    break
                }
            }
            let c = self.units[self.pos]
            if not try literal(c, true) {
                break
            }
            text.push(c)
            self.pos += 1
        }
        return utf8_of(text)
    }

    // Gson's `readEscapeCharacter`, after the backslash. Strict mode refuses `\'` and an
    // escaped line break, which the lenient mode reads as themselves.
    fn escape(mut self) -> u16 ! Unread {
        if self.pos == self.limit {
            if not try self.fill_here(1) {
                fail Unread.Syntax
            }
        }
        let e = self.units[self.pos]
        self.pos += 1
        if e == LOWER_U {
            if self.pos + 4 > self.limit {
                if not try self.fill_here(4) {
                    fail Unread.Syntax
                }
            }
            var v: u32 = 0
            for k in self.pos..self.pos + 4 {
                let h = self.units[k]
                let d = if h >= ZERO and h <= NINE {
                    h - ZERO
                } else if h >= LOWER_A and h <= LOWER_F {
                    h - LOWER_A + 10
                } else if h >= UPPER_A and h <= UPPER_F {
                    h - UPPER_A + 10
                } else {
                    fail Unread.Syntax
                }
                v = (v << 4) | u32(d)
            }
            self.pos += 4
            return u16.wrap(v)
        }
        if e == LOWER_T {
            return TAB
        }
        if e == LOWER_B {
            return 8
        }
        if e == LOWER_N {
            return NEWLINE
        }
        if e == LOWER_R {
            return RETURN
        }
        if e == LOWER_F {
            return FORM_FEED
        }
        if e == QUOTE or e == BACKSLASH or e == SLASH {
            return e
        }
        if self.lenient and e == APOSTROPHE {
            return e
        }
        if self.lenient and e == NEWLINE {
            self.lines = true
            self.line_start = self.pos
            return e
        }
        fail Unread.Syntax
    }

    // Gson's `peekKeyword`: `true`, `false` or `null` from `pos`, lowercase as strict mode wants
    // them, or with any of their letters capitals in the lenient mode, and not followed by a char
    // that goes on a literal, or `none`.
    fn keyword(mut self) -> Json? ! Unread {
        let c = self.units[self.pos]
        let up = self.lenient
        let word = if c == LOWER_T or (up and c == UPPER_T) {
            "true"
        } else if c == LOWER_F or (up and c == UPPER_F) {
            "false"
        } else if c == LOWER_N or (up and c == UPPER_N) {
            "null"
        } else {
            return none
        }
        let n = word.len()
        for i in 0..n {
            if self.pos + i >= self.limit {
                if not try self.fill_here(i + 1) {
                    return none
                }
            }
            let u = self.units[self.pos + i]
            let lower = u16(word.byte_at(i))
            if u != lower and not (up and u == lower - 32) {
                return none
            }
        }
        var more = self.pos + n < self.limit
        if not more {
            more = try self.fill_here(n + 1)
        }
        if more {
            if try literal(self.units[self.pos + n], self.lenient) {
                return none
            }
        }
        self.pos += n
        if word == "true" {
            return some(Json.Bool(true))
        }
        if word == "false" {
            return some(Json.Bool(false))
        }
        return some(Json.Null)
    }

    // Gson's `peekNumber`: a number's text from `pos`, or `none` if what's there isn't one Gson
    // takes: JSON's grammar, no zero before another digit, and under 1024 chars, ended by a char
    // that can't go on a literal.
    fn number(mut self) -> String? ! Unread {
        let p = self.pos
        var last = Part.Nothing
        // The digits so far, negated, wrapping as Java's `long` does: a zero that comes after
        // them is a leading zero only by this.
        var value: i64 = 0
        var i: usize = 0
        loop {
            if p + i == self.limit {
                if i == WINDOW {
                    return none
                }
                if not try self.fill(p, i + 1) {
                    break
                }
            }
            let c = self.units[p + i]
            if c == MINUS {
                last = match last {
                    Part.Nothing => Part.Sign,
                    Part.E => Part.ExpSign,
                    _ => return none,
                }
            } else if c == PLUS {
                last = match last {
                    Part.E => Part.ExpSign,
                    _ => return none,
                }
            } else if c == LOWER_E or c == UPPER_E {
                last = match last {
                    Part.Digit => Part.E,
                    Part.Fraction => Part.E,
                    _ => return none,
                }
            } else if c == POINT {
                last = match last {
                    Part.Digit => Part.Point,
                    _ => return none,
                }
            } else if c < ZERO or c > NINE {
                if try literal(c, self.lenient) {
                    return none
                }
                break
            } else {
                let d = i64(c - ZERO)
                last = match last {
                    Part.Nothing => {
                        value = -d
                        Part.Digit
                    },
                    Part.Sign => {
                        value = -d
                        Part.Digit
                    },
                    Part.Digit => {
                        if value == 0 {
                            return none
                        }
                        value = value * 10 - d
                        Part.Digit
                    },
                    Part.Point => Part.Fraction,
                    Part.Fraction => Part.Fraction,
                    Part.E => Part.ExpDigit,
                    Part.ExpSign => Part.ExpDigit,
                    Part.ExpDigit => Part.ExpDigit,
                }
            }
            i += 1
        }
        let whole = match last {
            Part.Digit => true,
            Part.Fraction => true,
            Part.ExpDigit => true,
            _ => false,
        }
        if not whole {
            return none
        }
        var text = String()
        for k in p..p + i {
            text.push(rune(u8.wrap(self.units[k])))
        }
        self.pos = p + i
        return some(text)
    }
}

// Gson's `isLiteral`: whether `c` can go on an unquoted literal, which a number or keyword
// mustn't be followed by. `/`, `\`, `;`, `#` and `=` are syntax errors in strict mode, and end
// one in the lenient mode.
fn literal(c: u16, lenient: bool) -> bool ! Unread {
    if c == SLASH or c == BACKSLASH or c == SEMICOLON or c == HASH or c == EQUALS {
        if not lenient {
            fail Unread.Syntax
        }
        return false
    }
    return not (c == OPEN_OBJECT or c == CLOSE_OBJECT or c == OPEN_ARRAY or c == CLOSE_ARRAY or c == COLON or c == COMMA or c == SPACE or c == TAB or c == FORM_FEED or c == RETURN or c == NEWLINE)
}

// Adds a member as Gson's `JsonObject` does: a key it has already keeps its place, with the new
// value. `index` finds keys once there are `INDEXED`.
fn put(members: mut List<Member>, index: mut Map<String, usize>, key: own String, value: own Json) {
    if not index.is_empty() {
        match index.get(key) {
            some(i) => {
                members[i].value = value
            },
            none => {
                index.insert(key.copy(), members.len())
                members.push(Member { key: key, value: value })
            },
        }
        return
    }
    for i in 0..members.len() {
        if members[i].key == key {
            members[i].value = value
            return
        }
    }
    members.push(Member { key: key, value: value })
    if members.len() == INDEXED {
        for i in 0..members.len() {
            index.insert(members[i].key.copy(), i)
        }
    }
}

// The text of UTF-16 code units, with half a surrogate pair that's alone as U+FFFD.
fn utf8_of(units: List<u16>) -> String {
    var s = String()
    let n = units.len()
    var i: usize = 0
    while i < n {
        let u = u32(units[i])
        if u >= 0xD800 and u < 0xDC00 and i + 1 < n and u32(units[i + 1]) >= 0xDC00 and u32(units[i + 1]) < 0xE000 {
            let cp = 0x10000 + ((u - 0xD800) << 10) + (u32(units[i + 1]) - 0xDC00)
            s.push(rune.try_from(cp) ?? REPLACEMENT)
            i += 2
        } else {
            s.push(rune.try_from(u) ?? REPLACEMENT)
            i += 1
        }
    }
    return s
}

fn is_null(value: Json) -> bool {
    return match value {
        Json.Null => true,
        _ => false,
    }
}
