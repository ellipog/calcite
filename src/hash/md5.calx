/// MD5 (RFC 1321). Vanilla uses it, through Guava's `Hashing.md5()`, to seed positional random
/// sources from names, and Java uses it for offline players' UUIDs. It isn't for security.
module hash.md5

/// The MD5 digest of the text's UTF-8 bytes, as Guava's `Hashing.md5().hashString(s, UTF_8)`.
pub fn md5_text(s: String) -> [u8; 16] {
    var bytes: List<u8> = []
    bytes.reserve(s.len())
    for i in 0..s.len() {
        bytes.push(s.byte_at(i))
    }
    return md5(bytes)
}

/// The 16-byte MD5 digest of the bytes.
pub fn md5(data: List<u8>) -> [u8; 16] {
    // floor(2^32 * abs(sin(i + 1)))
    let k: [u32; 64] = [
        0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
        0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
        0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
        0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
        0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
        0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
        0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
        0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
        0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
    ]
    // Each round's four rotations.
    let shifts: [i32; 16] = [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21]

    // The message, then 0x80, zeros up to 56 bytes past a multiple of 64, and the length in
    // bits, little-endian.
    var msg = data.copy()
    let bits = u64(data.len()) * 8
    msg.push(0x80)
    while msg.len() % 64 != 56 {
        msg.push(0)
    }
    for i in 0..8 {
        msg.push(u8.wrap(bits >> (8 * i)))
    }

    var a0: u32 = 0x67452301
    var b0: u32 = 0xefcdab89
    var c0: u32 = 0x98badcfe
    var d0: u32 = 0x10325476
    var m: [u32; 16] = [0; 16]
    let words: usize = 16
    let steps: usize = 64
    var chunk: usize = 0
    while chunk < msg.len() {
        for j in 0..words {
            let p = chunk + j * 4
            m[j] = u32(msg[p]) | (u32(msg[p + 1]) << 8) | (u32(msg[p + 2]) << 16) | (u32(msg[p + 3]) << 24)
        }
        var a = a0
        var b = b0
        var c = c0
        var d = d0
        for i in 0..steps {
            let (f, g) = if i < 16 {
                ((b & c) | (~b & d), i)
            } else if i < 32 {
                ((d & b) | (~d & c), (5 * i + 1) % 16)
            } else if i < 48 {
                (b ^ c ^ d, (3 * i + 5) % 16)
            } else {
                (c ^ (b | ~d), (7 * i) % 16)
            }
            let sum = f + a + k[i] + m[g]
            a = d
            d = c
            c = b
            b = b + sum.rotate_left(shifts[(i / 16) * 4 + i % 4])
        }
        a0 += a
        b0 += b
        c0 += c
        d0 += d
        chunk += 64
    }

    var out: [u8; 16] = [0; 16]
    let state: [u32; 4] = [a0, b0, c0, d0]
    let n: usize = 4
    for w in 0..n {
        for byte in 0..n {
            out[w * 4 + byte] = u8.wrap(state[w] >> (8 * byte))
        }
    }
    return out
}
