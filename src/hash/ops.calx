/// Vanilla's `HashOps.CRC32C_INSTANCE`: a value hashed as a codec writes it, with a token for
/// each kind of value before its bytes, so a byte and a boolean hash apart, and so do a list of
/// ints and an int array. Numbers go in little-endian, as Guava's hashers put them; a string
/// goes in as its length in UTF-16 units, then each unit; a hash goes in as its four bytes,
/// little-endian. A map's entries go in sorted by their keys' hashes, then by their values',
/// each read as an unsigned number, so the order they come in doesn't count. Vanilla hashes item
/// stacks' components with it, so the client and the server can check each other's slots
/// (CAL-136).
module hash.ops

import hash.crc32c.{crc32c}
import nbt.tag.{Tag}

const EMPTY: u8 = 1
const MAP_START: u8 = 2
const MAP_END: u8 = 3
const LIST_START: u8 = 4
const LIST_END: u8 = 5
const BYTE: u8 = 6
const SHORT: u8 = 7
const INT: u8 = 8
const LONG: u8 = 9
const FLOAT: u8 = 10
const DOUBLE: u8 = 11
const STRING: u8 = 12
const BOOLEAN: u8 = 13
const BYTE_ARRAY_START: u8 = 14
const BYTE_ARRAY_END: u8 = 15
const INT_ARRAY_START: u8 = 16
const INT_ARRAY_END: u8 = 17
const LONG_ARRAY_START: u8 = 18
const LONG_ARRAY_END: u8 = 19

/// `empty()`, what's hashed for nothing.
pub fn hash_empty() -> u32 {
    return crc32c([EMPTY])
}

pub fn hash_byte(v: i8) -> u32 {
    return crc32c([BYTE, u8.wrap(v)])
}

pub fn hash_short(v: i16) -> u32 {
    let u = u32(u16.wrap(v))
    return crc32c([SHORT, u8.wrap(u & 255), u8.wrap(u >> 8)])
}

pub fn hash_int(v: i32) -> u32 {
    var b: List<u8> = [INT]
    put32(mut b, u32.wrap(v))
    return crc32c(b)
}

pub fn hash_long(v: i64) -> u32 {
    var b: List<u8> = [LONG]
    put64(mut b, u64.wrap(v))
    return crc32c(b)
}

/// A float, by its bits as `Float.floatToRawIntBits` gives them.
pub fn hash_float(v: f32) -> u32 {
    var b: List<u8> = [FLOAT]
    put32(mut b, v.to_bits())
    return crc32c(b)
}

/// A double, by its bits as `Double.doubleToRawLongBits` gives them.
pub fn hash_double(v: f64) -> u32 {
    var b: List<u8> = [DOUBLE]
    put64(mut b, v.to_bits())
    return crc32c(b)
}

/// A string: its length in UTF-16 units, as Java's `String.length` counts it, then each unit,
/// as `putUnencodedChars` puts them.
pub fn hash_string(s: String) -> u32 {
    var units = List<u32>()
    for c in s.chars() {
        let v = u32(c)
        if v >= 0x10000 {
            let w = v - 0x10000
            units.push(0xD800 + (w >> 10))
            units.push(0xDC00 + (w & 0x3FF))
        } else {
            units.push(v)
        }
    }
    var b: List<u8> = [STRING]
    b.reserve(5 + units.len() * 2)
    put32(mut b, u32.wrap(units.len()))
    for u in units {
        b.push(u8.wrap(u & 255))
        b.push(u8.wrap(u >> 8))
    }
    return crc32c(b)
}

pub fn hash_bool(v: bool) -> u32 {
    return crc32c([BOOLEAN, if v { 1u8 } else { 0u8 }])
}

/// A map, of its entries' keys' and values' hashes, in any order.
pub fn hash_map(entries: List<(u32, u32)>) -> u32 {
    var sorted = List<u64>()
    sorted.reserve(entries.len())
    for (k, v) in entries {
        sorted.push((u64(k) << 32) | u64(v))
    }
    sorted.sort()
    var b: List<u8> = [MAP_START]
    b.reserve(2 + sorted.len() * 8)
    for e in sorted {
        put32(mut b, u32.wrap(e >> 32))
        put32(mut b, u32.wrap(e & 0xFFFFFFFF))
    }
    b.push(MAP_END)
    return crc32c(b)
}

/// A list, of its elements' hashes, in order.
pub fn hash_list(items: List<u32>) -> u32 {
    var b: List<u8> = [LIST_START]
    b.reserve(2 + items.len() * 4)
    for h in items {
        put32(mut b, h)
    }
    b.push(LIST_END)
    return crc32c(b)
}

/// `createByteList`: a byte array.
pub fn hash_byte_array(values: List<i8>) -> u32 {
    var b: List<u8> = [BYTE_ARRAY_START]
    b.reserve(2 + values.len())
    for v in values {
        b.push(u8.wrap(v))
    }
    b.push(BYTE_ARRAY_END)
    return crc32c(b)
}

/// `createIntList`: an int array, or an int stream, as a UUID's codec writes one.
pub fn hash_int_array(values: List<i32>) -> u32 {
    var b: List<u8> = [INT_ARRAY_START]
    b.reserve(2 + values.len() * 4)
    for v in values {
        put32(mut b, u32.wrap(v))
    }
    b.push(INT_ARRAY_END)
    return crc32c(b)
}

/// `createLongList`: a long array.
pub fn hash_long_array(values: List<i64>) -> u32 {
    var b: List<u8> = [LONG_ARRAY_START]
    b.reserve(2 + values.len() * 8)
    for v in values {
        put64(mut b, u64.wrap(v))
    }
    b.push(LONG_ARRAY_END)
    return crc32c(b)
}

/// A tag hashed as `NbtOps.convertTo` gives it to `HashOps`, each by its own type, as a codec
/// that passes NBT through, such as `CompoundTag.CODEC`, writes it.
pub fn hash_tag(t: Tag) -> u32 {
    return match t {
        Tag.End => hash_empty(),
        Tag.Byte(v) => hash_byte(v),
        Tag.Short(v) => hash_short(v),
        Tag.Int(v) => hash_int(v),
        Tag.Long(v) => hash_long(v),
        Tag.Float(v) => hash_float(v),
        Tag.Double(v) => hash_double(v),
        Tag.ByteArray(a) => hash_byte_array(a),
        Tag.Str(s) => hash_string(s),
        Tag.List(items) => {
            var hashes = List<u32>()
            hashes.reserve(items.len())
            for item in items {
                hashes.push(hash_tag(item))
            }
            hash_list(hashes)
        },
        Tag.Compound(m) => {
            var entries = List<(u32, u32)>()
            entries.reserve(m.len())
            for (k, v) in m {
                entries.push((hash_string(k), hash_tag(v)))
            }
            hash_map(entries)
        },
        Tag.IntArray(a) => hash_int_array(a),
        Tag.LongArray(a) => hash_long_array(a),
    }
}

fn put32(b: mut List<u8>, v: u32) {
    b.push(u8.wrap(v & 255))
    b.push(u8.wrap((v >> 8) & 255))
    b.push(u8.wrap((v >> 16) & 255))
    b.push(u8.wrap(v >> 24))
}

fn put64(b: mut List<u8>, v: u64) {
    put32(mut b, u32.wrap(v & 0xFFFFFFFF))
    put32(mut b, u32.wrap(v >> 32))
}
