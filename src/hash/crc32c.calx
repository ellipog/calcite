/// CRC-32C (Castagnoli, RFC 3720), as Guava's `Hashing.crc32c()` computes it: what vanilla's
/// `HashOps.CRC32C_INSTANCE` hashes item stacks' components with, so the client and the server
/// can check each other's slots without sending the stacks (CAL-136). It isn't for security.
module hash.crc32c

// The polynomial 0x1EDC6F41, its bits reversed, as CRC-32C reads each byte low bit first.
const POLYNOMIAL: u32 = 0x82F63B78

/// The CRC-32C of `data`, as Guava's `HashCode.asInt` gives it.
pub fn crc32c(data: List<u8>) -> u32 {
    var crc: u32 = 0xFFFFFFFF
    for b in data {
        crc = crc ^ u32(b)
        for _ in 0..8 {
            if crc & 1 != 0 {
                crc = (crc >> 1) ^ POLYNOMIAL
            } else {
                crc = crc >> 1
            }
        }
    }
    return crc ^ 0xFFFFFFFF
}
