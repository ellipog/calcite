/// Scratch, for CAL-73: answers the globs in a file as build/scratch/glob/Globs.java does, with
/// java.glob. Not a test.
module glob_diff

import java.glob.{glob_regex}
import std.env.{args}
import std.fs.{read_text}

fn digit(b: u8) -> u32 {
    let v = u32(b)
    if v <= 57 {
        return v - 48
    }
    return (v | 32) - 87
}

fn text_of(s: String) -> String {
    var units = List<u32>()
    var i: usize = 0
    while i + 4 <= s.len() {
        var v: u32 = 0
        for k in 0usize..4 {
            v = v * 16 + digit(s.byte_at(i + k))
        }
        units.push(v)
        i += 4
    }
    var out = String()
    var j: usize = 0
    while j < units.len() {
        var c = units[j]
        j += 1
        if c >= 0xD800 and c <= 0xDBFF and j < units.len() {
            let d = units[j]
            if d >= 0xDC00 and d <= 0xDFFF {
                c = 0x10000 + ((c - 0xD800) << 10) + (d - 0xDC00)
                j += 1
            }
        }
        out.push(rune.try_from(c) ?? '?')
    }
    return out
}

fn hex(s: String) -> String {
    let digits = "0123456789abcdef"
    var out = String()
    for c in s.chars() {
        let v = u32(c)
        var shift: u32 = 12
        loop {
            let d = usize((v >> shift) & 15)
            out.push_str(digits[d..d + 1])
            if shift == 0 {
                break
            }
            shift -= 4
        }
    }
    return out
}

fn main() {
    let a = args()
    let text = read_text(a[0].copy())! ?? String("")
    var out = String()
    var start: usize = 0
    while start < text.len() {
        var end = start
        while end < text.len() and text.byte_at(end) != 10 {
            end += 1
        }
        let line = text[start..end]
        start = end + 1
        let glob = text_of(line)
        for windows in [false, true] {
            match glob_regex(glob, windows) {
                ok(r) => out.push_str("ok {hex(r)}"),
                err(e) => out.push_str("err {hex(e.description)} {e.index}"),
            }
            out.push('\n')
        }
    }
    print(out)
}
