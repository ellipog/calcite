module cases.nbt.gen

// Writes cases/nbt/limits.json: nesting and size near vanilla's limits, too long to write by
// hand.
//
//     calx cases/nbt/gen.calx

import std.json.{Json}
import cases.kit.{case, case_with, file, hex_blob, obj, s}
import rig.runner.cases.{write_file}

/// `depth` compounds inside each other, in network form.
fn nested_compounds(depth: usize) -> String {
    return "0a{"0a000161".repeat(depth - 1)}{"00".repeat(depth)}"
}

/// `depth` lists inside each other, each holding one list, the innermost empty.
fn nested_lists(depth: usize) -> String {
    return "09{"0900000001".repeat(depth - 1)}0000000000"
}

fn snbt(text: own String) -> Json {
    return obj([(String("from"), s("snbt")), (String("snbt"), s(text))])
}

fn binary() -> Json {
    return obj([(String("from"), s("binary"))])
}

pub fn main() {
    var cases: List<Json> = []
    for depth in [128usize, 256, 511, 512, 513, 514] {
        cases.push(case("snbt-compound-depth-{depth}", snbt("{"\{a:".repeat(depth - 1)}\{\}{"\}".repeat(depth - 1)}")))
        cases.push(case("snbt-list-depth-{depth}", snbt("\{a:{"[".repeat(depth - 1)}{"]".repeat(depth - 1)}\}")))
        cases.push(case_with("bin-compound-depth-{depth}", binary(), [hex_blob(nested_compounds(depth))]))
        cases.push(case_with("bin-list-depth-{depth}", binary(), [hex_blob(nested_lists(depth))]))
    }
    // A 65,535-byte string is the longest writeUTF can write.
    for count in [65535usize, 65536] {
        cases.push(case("snbt-string-{count}", snbt("\{a:\"{"x".repeat(count)}\"\}")))
    }
    write_file(file("nbt", "limits.json"), String("nbt"), String("cases/nbt/gen.calx"), cases, 1)
}
