{
  "probe": "nbt",
  "probe_version": 1,
  "cases": [
    {"id": "empty-compound", "input": {"from": "snbt", "snbt": "{}"}},
    {"id": "all-number-types", "input": {"from": "snbt", "snbt": "{b:1b,s:2s,i:3,l:4L,f:5.5f,d:6.25d,d2:7.0}"}},
    {"id": "number-limits", "input": {"from": "snbt", "snbt": "{b:127b,bn:-128b,s:32767s,sn:-32768s,i:2147483647,in:-2147483648,l:9223372036854775807L,ln:-9223372036854775808L}"}},
    {"id": "byte-overflow", "input": {"from": "snbt", "snbt": "{b:128b}"}},
    {"id": "int-overflow", "input": {"from": "snbt", "snbt": "{i:2147483648}"}},
    {"id": "unsigned-suffix", "input": {"from": "snbt", "snbt": "{a:255ub,b:-1sb,c:65535us,d:4294967295ui}"}},
    {"id": "hex-and-binary", "input": {"from": "snbt", "snbt": "{a:0xff,b:0b1010,c:0x7FFFFFFFFFFFFFFFL,d:0xFFub}"}},
    {"id": "underscores", "input": {"from": "snbt", "snbt": "{a:1_000_000,b:1_0.5_0f}"}},
    {"id": "float-forms", "input": {"from": "snbt", "snbt": "{a:.5f,b:5.f,c:1e10,d:1.5e-3f,e:-0.0,f:1E+2d}"}},
    {"id": "float-extremes", "input": {"from": "snbt", "snbt": "{a:3.4028235e38f,b:1.4e-45f,c:1.7976931348623157e308,d:4.9e-324,e:1e39f}"}},
    {"id": "booleans", "input": {"from": "snbt", "snbt": "{a:true,b:false,c:TRUE}"}},
    {"id": "bool-operation", "input": {"from": "snbt", "snbt": "{a:bool(1),b:bool(0b),c:bool(true)}"}},
    {"id": "uuid-operation", "input": {"from": "snbt", "snbt": "{u:uuid(f81d4fae-7dec-11d0-a765-00a0c91e6bf6)}"}},
    {"id": "strings-quoted", "input": {"from": "snbt", "snbt": "{a:\"double\",b:'single',c:\"it's\",d:'say \"hi\"',e:\"\"}"}},
    {"id": "strings-unquoted", "input": {"from": "snbt", "snbt": "{a:hello,b:a.b-c_d+e,c:minecraft:stone}"}},
    {"id": "string-escapes", "input": {"from": "snbt", "snbt": "{a:\"tab\\there\",b:\"nl\\nx\",c:\"\\\\\",d:\"\\x41\\u00e9\\U0001F600\",e:\"\\N{SNOWMAN}\",f:\"\\b\\f\\r\\s\"}"}},
    {"id": "string-bad-escape", "input": {"from": "snbt", "snbt": "{a:\"\\q\"}"}},
    {"id": "string-unicode-raw", "input": {"from": "snbt", "snbt": "{a:\"é中😀\",\"key é\":1}"}},
    {"id": "keys-needing-quotes", "input": {"from": "snbt", "snbt": "{\"\":1,\"a b\":2,\"1\":3,\"{\":4,'q\"':5}"}},
    {"id": "key-order", "input": {"from": "snbt", "snbt": "{z:1,a:2,m:3,A:4,_:5,\"0\":6}"}},
    {"id": "duplicate-key", "input": {"from": "snbt", "snbt": "{a:1,a:2b}"}},
    {"id": "lists", "input": {"from": "snbt", "snbt": "{a:[],b:[1,2,3],c:[\"x\",\"y\"],d:[[1],[2b]],e:[{a:1},{}]}"}},
    {"id": "list-mixed-types", "input": {"from": "snbt", "snbt": "{a:[1,2b,\"three\",{four:4},[5]]}"}},
    {"id": "list-trailing-comma", "input": {"from": "snbt", "snbt": "{a:[1,2,]}"}},
    {"id": "arrays", "input": {"from": "snbt", "snbt": "{b:[B;1b,2b,-3b],i:[I;1,-2,2147483647],l:[L;1L,-2L],e:[I;]}"}},
    {"id": "array-untyped-elements", "input": {"from": "snbt", "snbt": "{b:[B;1,2],l:[L;1,2]}"}},
    {"id": "array-wrong-element", "input": {"from": "snbt", "snbt": "{b:[B;1L]}"}},
    {"id": "array-bad-prefix", "input": {"from": "snbt", "snbt": "{x:[X;1]}"}},
    {"id": "nested-deep", "input": {"from": "snbt", "snbt": "{a:{b:{c:{d:{e:{f:{g:[{h:[[[1]]]}]}}}}}}}"}},
    {"id": "whitespace", "input": {"from": "snbt", "snbt": "  {  a  :  1  ,  b : [ 1 , 2 ]  }  "}},
    {"id": "syntax-unclosed", "input": {"from": "snbt", "snbt": "{a:1"}},
    {"id": "syntax-missing-value", "input": {"from": "snbt", "snbt": "{a:"}},
    {"id": "syntax-trailing-data", "input": {"from": "snbt", "snbt": "{a:1} extra"}},
    {"id": "syntax-empty", "input": {"from": "snbt", "snbt": ""}},
    {"id": "not-a-compound", "input": {"from": "snbt", "snbt": "[1,2,3]"}},
    {"id": "any-byte", "input": {"from": "snbt_any", "snbt": "1b"}},
    {"id": "any-string", "input": {"from": "snbt_any", "snbt": "\"text\""}},
    {"id": "any-unquoted", "input": {"from": "snbt_any", "snbt": "minecraft:stone"}},
    {"id": "any-list", "input": {"from": "snbt_any", "snbt": "[1,2,3]"}},
    {"id": "any-double", "input": {"from": "snbt_any", "snbt": "0.1"}},
    {"id": "any-nan-word", "input": {"from": "snbt_any", "snbt": "NaN"}},
    {"id": "any-infinity-word", "input": {"from": "snbt_any", "snbt": "Infinity"}},
    {"id": "any-true", "input": {"from": "snbt_any", "snbt": "true"}},
    {"id": "any-empty", "input": {"from": "snbt_any", "snbt": ""}}
  ]
}
