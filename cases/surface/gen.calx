module cases.surface.gen

// Writes cases/surface/generated.json: chunks filled and given their materials, by vanilla's rules
// and by rules written out.
//
//     calx cases/surface/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the same
// file.
//
// The cases name vanilla's material by id and never copy it. Each of vanilla's noise settings gives
// chunks their materials with its own rule and the biomes its world has, near the origin and far
// out. Then the Overworld's rule runs over sources that put one biome everywhere, for the biomes
// whose materials are their own (badlands and their pillars, frozen oceans and their icebergs,
// peaks, shores, swamps, caves), and over checkerboards that change biome every few quarts, where
// the zoom between biomes counts. Then rules written out try each condition and rule on their own
// and nested, with anchors of each kind; worlds that aren't the noise's; chunks at the ends of
// `int`; and sources and rules vanilla doesn't read.
//
// Each draw is a statement of its own, in the order the Python drew them: a dict's values in the
// order they're written, a list's items before the pick among them.

import std.json
import std.json.{Json}
import cases.kit.{arr, b, case, file, ints, n, obj, s, strs, with}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}
import tools.repo.{die}

const SEED: u64 = 20261105
const LONG_SEEDS: [str; 6] = ["0", "1", "-1", "9223372036854775807", "-9223372036854775808", "12345"]
const BORDER: i64 = 1874999
// The Overworld's biomes, the ones with materials of their own first.
const SPECIAL: [str; 34] = [
    "eroded_badlands", "badlands", "wooded_badlands", "frozen_ocean", "deep_frozen_ocean",
    "frozen_peaks", "jagged_peaks", "stony_peaks", "snowy_slopes", "grove", "ice_spikes",
    "stony_shore", "mangrove_swamp", "swamp", "mushroom_fields", "desert", "beach", "snowy_beach",
    "windswept_hills", "windswept_gravelly_hills", "windswept_savanna", "old_growth_pine_taiga",
    "old_growth_spruce_taiga", "dripstone_caves", "sulfur_caves", "dappled_forest", "lush_caves",
    "deep_dark", "frozen_river", "river", "warm_ocean", "ocean", "deep_ocean", "snowy_plains",
]
const OTHERS: [str; 22] = [
    "plains", "sunflower_plains", "forest", "flower_forest", "birch_forest", "dark_forest",
    "pale_garden", "taiga", "snowy_taiga", "savanna", "savanna_plateau", "jungle", "sparse_jungle",
    "bamboo_jungle", "meadow", "cherry_grove", "cold_ocean", "lukewarm_ocean", "deep_cold_ocean",
    "deep_lukewarm_ocean", "windswept_forest", "old_growth_birch_forest",
]
const NETHER: [str; 5] = ["nether_wastes", "soul_sand_valley", "crimson_forest", "warped_forest", "basalt_deltas"]
const TAGS: [str; 10] = ["is_badlands", "is_ocean", "is_deep_ocean", "is_mountain", "is_beach", "is_river", "is_taiga", "is_forest", "is_overworld", "is_nether"]
const NOISES: [str; 16] = [
    "surface", "surface_secondary", "gravel", "powder_snow", "calcite", "packed_ice", "ice",
    "surface_swamp", "sulfur_cave_gradient", "badlands_pillar", "patch", "netherrack", "nether_wart",
    "soul_sand_layer", "gravel_layer", "nether_state_selector",
]
// Vanilla's named rules and conditions.
const RULES: [str; 15] = [
    "overworld", "overworld_caves", "overworld_floating_islands", "nether", "end", "bedrock_floor",
    "bedrock_roof", "overworld/surface", "overworld/underground", "overworld/copper_ore_vein",
    "overworld/iron_ore_vein", "overworld/biome_surface", "overworld/under_biome_surface",
    "overworld/sulfur_cave_bands", "overworld/powder_snow_surface",
]
const CONDITIONS: [str; 8] = [
    "on_floor", "under_floor", "deep_under_floor", "very_deep_under_floor", "on_ceiling",
    "under_ceiling", "not_underwater", "not_under_deep_water",
]
const STATES: str = #"["minecraft:stone","minecraft:dirt","minecraft:sand","minecraft:red_sand","minecraft:gravel","minecraft:packed_ice","minecraft:snow_block","minecraft:mud","minecraft:deepslate","minecraft:water","minecraft:lava","minecraft:air","minecraft:cave_air",{"id":"minecraft:grass_block","properties":{"snowy":"true"}},{"id":"minecraft:oak_log","properties":{"axis":"x"}},{"id":"minecraft:water","properties":{"level":"3"}},{"id":"minecraft:sea_pickle","properties":{"waterlogged":"true","pickles":"2"}},{"id":"minecraft:kelp"},"minecraft:seagrass","minecraft:glass"]"#
const DENSITIES: [str; 6] = [
    "minecraft:overworld/ore_vein/copper_density", "minecraft:overworld/ore_vein/iron_density",
    "minecraft:overworld/ore_vein/richness", "minecraft:overworld/ore_vein/gap",
    "minecraft:overworld/depth", "minecraft:overworld/continents",
]

/// Each settings' world, as (min_y, height), and the source its world preset gives it.
fn worlds() -> List<(str, i64, i64, str)> {
    return [("overworld", -64, 384, "overworld"), ("large_biomes", -64, 384, "overworld"), ("amplified", -64, 384, "overworld"), ("caves", -64, 384, "overworld"), ("floating_islands", -64, 384, "overworld"), ("nether", 0, 256, "nether"), ("end", 0, 256, "end")]
}

fn world_of(settings: str) -> (i64, i64, str) {
    for (name, min_y, height, source) in worlds() {
        if name == settings {
            return (min_y, height, source)
        }
    }
    die("no settings {settings}")
}

/// JSON written out, as the Python wrote its dicts and lists.
fn j(text: String) -> Json {
    return match json.parse(text.copy()) {
        ok(v) => v,
        err(e) => die("{text}: {e}"),
    }
}

fn list(text: String) -> List<Json> {
    if let Json.Array(xs) = j(text.copy()) {
        return xs
    }
    die("not a list: {text}")
}

fn rounded(x: f64) -> f64 {
    return f64.parse("{x:.4}") ?? x
}

struct Gen {
    r: SplitMix64
}

fn gen(seed: u64) -> Gen {
    return Gen { r: splitmix64(seed) }
}

impl Gen {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn between(mut self, lo: i64, hi: i64) -> i64 {
        return lo + self.below(hi - lo + 1)
    }

    fn chance(mut self, bound: i64) -> bool {
        return self.below(bound) == 0
    }

    fn pick(mut self, items: List<str>) -> str {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    fn pick_value(mut self, items: List<Json>) -> Json {
        return items[usize.wrap(self.below(i64.wrap(items.len())))].copy()
    }

    /// A float in [0, 1]: the draw over 2^64, as Python divided it.
    fn unit(mut self) -> f64 {
        return f64.nearest(self.r.next()) / 18446744073709551616.0
    }

    /// A float in [lo, hi], rounded to 4 places as Python's `round` rounds.
    fn real(mut self, lo: f64, hi: f64) -> f64 {
        return rounded(lo + (hi - lo) * self.unit())
    }

    fn long(mut self) -> String {
        return "{i64.wrap(self.r.next())}"
    }

    fn seed(mut self) -> String {
        if self.chance(4) {
            return String(LONG_SEEDS[usize.wrap(self.below(6))])
        }
        return self.long()
    }

    fn near_chunk(mut self, spread: i64) -> (i64, i64) {
        let x = self.between(-spread, spread)
        let z = self.between(-spread, spread)
        return (x, z)
    }

    fn far_chunk(mut self) -> (i64, i64) {
        let x = self.between(-BORDER, BORDER)
        let z = self.between(-BORDER, BORDER)
        return (x, z)
    }
}

fn m(name: str) -> String {
    return "minecraft:{name}"
}

fn preset(name: str) -> Json {
    if name == "end" {
        return obj([(String("type"), s("minecraft:the_end"))])
    }
    return obj([(String("type"), s("minecraft:multi_noise")), (String("preset"), s(m(name)))])
}

fn fixed(biome: str) -> Json {
    return obj([(String("type"), s("minecraft:fixed")), (String("biome"), s(m(biome)))])
}

fn checkerboard(biomes: List<str>, scale: i64) -> Json {
    var named: List<String> = []
    for biome in biomes {
        named.push(m(biome))
    }
    return obj([(String("type"), s("minecraft:checkerboard")), (String("biomes"), strs(named)), (String("scale"), n(scale))])
}

/// `("type", "minecraft:<name>")`, the first member of most of what the cases write.
fn kind(name: str) -> (String, Json) {
    return (String("type"), s(m(name)))
}

fn member(key: str, v: own Json) -> (String, Json) {
    return (String(key), v)
}

struct Case {
    id: String,
    seed: String,
    settings: str,
    min_y: i64,
    height: i64,
    source: Json,
    rule: Json?,
    ops: List<Json>,
}

fn start(id: own String, seed: own String, settings: str, level: (i64, i64), source: own Json, given: own Json?) -> Case {
    return Case { id: id, seed: seed, settings: settings, min_y: level.0, height: level.1, source: source, rule: given, ops: [] }
}

impl Case {
    fn surface(mut self, chunk: (i64, i64)) {
        self.ops.push(arr([s("surface"), n(chunk.0), n(chunk.1)]))
    }

    fn build(self) -> Json {
        var input: List<(String, Json)> = [member("seed", s(self.seed.copy())), member("settings", s(m(self.settings))), member("level", ints([self.min_y, self.height])), member("source", self.source.copy())]
        if let r = self.rule {
            input.push(member("rule", r.copy()))
        }
        input.push(member("ops", arr(self.ops.copy())))
        return case(self.id.copy(), obj(input))
    }
}

// Rules written out.

fn anchor(g: mut Gen) -> Json {
    let which = g.below(4)
    if which == 0 {
        return obj([member("absolute", n(g.between(-80, 330)))])
    }
    if which == 1 {
        return obj([member("above_bottom", n(g.between(-10, 80)))])
    }
    if which == 2 {
        return obj([member("below_top", n(g.between(-10, 300)))])
    }
    return obj([member("relative_to_sea_level", n(g.between(-60, 120)))])
}

fn state(g: mut Gen) -> Json {
    return g.pick_value(list(String(STATES)))
}

fn biomes_all() -> List<str> {
    var out = SPECIAL.to_list()
    out.extend(OTHERS.to_list())
    return out
}

fn condition(g: mut Gen, depth: i64) -> Json {
    let which = g.below(if depth < 3 { 14 } else { 12 })
    if which == 0 {
        let form = g.below(3)
        var biome_is = Json.Null
        if form == 0 {
            biome_is = s(m(g.pick(biomes_all())))
        } else if form == 1 {
            let count = g.between(1, 4)
            var named: List<String> = []
            for _ in 0..count {
                named.push(m(g.pick(biomes_all())))
            }
            biome_is = strs(named)
        } else {
            biome_is = s("#{m(g.pick(TAGS.to_list()))}")
        }
        return obj([kind("biome"), member("biome_is", biome_is)])
    }
    if which == 1 {
        let low = g.real(-1.2, 0.8)
        let noise = m(g.pick(NOISES.to_list()))
        let high = rounded(low + g.real(0.0, 1.5))
        var c: List<(String, Json)> = [kind("noise_threshold"), member("noise", s(noise)), member("min_threshold", Json.Float(low)), member("max_threshold", Json.Float(high))]
        if g.chance(2) {
            c.push(member("is_3d", b(g.chance(2))))
        }
        return obj(c)
    }
    if which == 2 {
        let name = m(g.pick(["bedrock_floor", "deepslate", "gradient", "surface"]))
        let below = anchor(mut g)
        let above = anchor(mut g)
        return obj([kind("vertical_gradient"), member("random_name", s(name)), member("true_at_and_below", below), member("false_at_and_above", above)])
    }
    if which == 3 {
        let at = anchor(mut g)
        let multiplier = g.between(-20, 20)
        let add = g.chance(2)
        return obj([kind("y_above"), member("anchor", at), member("surface_depth_multiplier", n(multiplier)), member("add_stone_depth", b(add))])
    }
    if which == 4 {
        let offset = g.between(-12, 6)
        let multiplier = g.between(-3, 3)
        let add = g.chance(2)
        return obj([kind("water"), member("offset", n(offset)), member("surface_depth_multiplier", n(multiplier)), member("add_stone_depth", b(add))])
    }
    if which == 5 {
        return obj([kind("temperature")])
    }
    if which == 6 {
        return obj([kind("steep")])
    }
    if which == 7 {
        return obj([kind("hole")])
    }
    if which == 8 {
        return obj([kind("above_preliminary_surface")])
    }
    if which == 9 or which == 10 {
        let offset = g.between(-3, 12)
        let add = g.chance(2)
        let ranges: List<Json> = [n(0), n(0), n(1), n(6), n(30), n(-4)]
        let range = g.pick_value(ranges)
        let surface = g.pick(["floor", "ceiling"])
        return obj([kind("stone_depth"), member("offset", n(offset)), member("add_surface_depth", b(add)), member("secondary_depth_range", range), member("surface_type", s(String(surface)))])
    }
    if which == 11 {
        return s(m(g.pick(CONDITIONS.to_list())))
    }
    return obj([kind("not"), member("invert", condition(mut g, depth + 1))])
}

fn block(g: mut Gen) -> Json {
    return obj([kind("block"), member("result_state", state(mut g))])
}

fn rule(g: mut Gen, depth: i64) -> Json {
    let which = g.below(if depth < 3 { 8 } else { 3 })
    if which == 0 or which == 1 {
        return block(mut g)
    }
    if which == 2 {
        if g.chance(3) {
            return obj([kind("bandlands")])
        }
        return block(mut g)
    }
    if which >= 3 and which <= 5 {
        let when = condition(mut g, depth)
        let then = rule(mut g, depth + 1)
        return obj([kind("condition"), member("if_true", when), member("then_run", then)])
    }
    if which == 6 {
        let count = g.between(0, 4)
        var steps: List<Json> = []
        for _ in 0..count {
            steps.push(rule(mut g, depth + 1))
        }
        return obj([kind("sequence"), member("sequence", arr(steps))])
    }
    if g.chance(2) {
        // `RULES[5:]`: the rules that aren't a dimension's whole.
        var named: List<str> = []
        for i in 5usize..RULES.len() {
            named.push(RULES[i])
        }
        return s(m(g.pick(named)))
    }
    return ore_vein(mut g)
}

fn constant(v: f64) -> Json {
    return obj([(String("type"), s("minecraft:constant")), member("value", Json.Float(v))])
}

fn ore_vein(g: mut Gen) -> Json {
    let low = constant(g.real(-0.2, 1.0))
    let density = g.pick_value([s(String(DENSITIES[0])), s(String(DENSITIES[1])), low])
    let ore = state(mut g)
    let raw = state(mut g)
    let filler = state(mut g)
    let chance = g.pick_value([Json.Float(0.0), Json.Float(0.02), Json.Float(0.5), Json.Float(1.0)])
    let rich = constant(g.real(0.0, 1.0))
    let richness = g.pick_value([s(String(DENSITIES[2])), rich])
    let gap = g.pick_value([s(String(DENSITIES[3])), Json.Float(-0.5), Json.Float(0.5), s("minecraft:overworld/depth")])
    return obj([kind("ore_vein"), member("ore_block", ore), member("raw_ore_block", raw), member("filler_block", filler), member("raw_ore_chance", chance), member("density", density), member("richness", richness), member("filler_gap", gap)])
}

/// A rule of conditions each giving a block, as the Overworld's are built, written out.
fn written(g: mut Gen) -> Json {
    var steps: List<Json> = []
    let count = g.between(3, 8)
    for _ in 0..count {
        let when = condition(mut g, 0)
        let then = rule(mut g, 1)
        steps.push(obj([kind("condition"), member("if_true", when), member("then_run", then)]))
    }
    if g.chance(2) {
        steps.push(block(mut g))
    }
    return obj([kind("sequence"), member("sequence", arr(steps))])
}

/// A rule that gives glass where `c` holds, and otherwise leaves the block.
fn one_condition(c: own Json) -> Json {
    return obj([kind("condition"), member("if_true", c), member("then_run", j(#"{"type":"minecraft:block","result_state":"minecraft:glass"}"#))])
}

fn without(v: own Json, key: str) -> Json {
    if let Json.Object(members) = v {
        var kept = LinkedMap<String, Json>()
        for (k, x) in members {
            if k != key {
                kept.insert(k.copy(), x.copy())
            }
        }
        return Json.Object(kept)
    }
    return v
}

fn invalid_rules() -> List<(str, Json)> {
    let stone = #"{"type":"minecraft:block","result_state":"minecraft:stone"}"#
    var g1 = gen(1)
    var g2 = gen(2)
    var g3 = gen(3)
    return [
        ("no-type", j(#"{"result_state":"minecraft:stone"}"#)),
        ("unknown-type", j(#"{"type":"minecraft:mystery"}"#)),
        ("unknown-reference", s("minecraft:nowhere")),
        ("bad-reference", s("Not An Id")),
        ("unknown-block", j(#"{"type":"minecraft:block","result_state":"minecraft:nope"}"#)),
        ("bad-property", j(#"{"type":"minecraft:block","result_state":{"id":"minecraft:oak_log","properties":{"axis":"w"}}}"#)),
        ("no-result", j(#"{"type":"minecraft:block"}"#)),
        ("sequence-not-list", j(#"{"type":"minecraft:sequence","sequence":#{stone}}"#)),
        ("sequence-bad-entry", j(#"{"type":"minecraft:sequence","sequence":[#{stone},3]}"#)),
        ("condition-no-if", j(#"{"type":"minecraft:condition","then_run":#{stone}}"#)),
        ("condition-unknown", one_condition(j(#"{"type":"minecraft:mystery"}"#))),
        ("condition-unknown-reference", one_condition(s("minecraft:nowhere"))),
        ("biome-unknown", one_condition(j(#"{"type":"minecraft:biome","biome_is":"minecraft:nowhere"}"#))),
        ("biome-missing-tag", one_condition(j(##"{"type":"minecraft:biome","biome_is":"#minecraft:is_nowhere"}"##))),
        ("y-multiplier-21", one_condition(j(#"{"type":"minecraft:y_above","anchor":{"absolute":0},"surface_depth_multiplier":21,"add_stone_depth":false}"#))),
        ("y-multiplier-minus-21", one_condition(j(#"{"type":"minecraft:y_above","anchor":{"absolute":0},"surface_depth_multiplier":-21,"add_stone_depth":false}"#))),
        ("y-two-anchors", one_condition(j(#"{"type":"minecraft:y_above","anchor":{"absolute":0,"above_bottom":2},"surface_depth_multiplier":0,"add_stone_depth":false}"#))),
        ("y-no-add", one_condition(j(#"{"type":"minecraft:y_above","anchor":{"absolute":0},"surface_depth_multiplier":0}"#))),
        ("water-multiplier-21", one_condition(j(#"{"type":"minecraft:water","offset":0,"surface_depth_multiplier":21,"add_stone_depth":false}"#))),
        ("stone-depth-middle", one_condition(j(#"{"type":"minecraft:stone_depth","offset":0,"add_surface_depth":false,"secondary_depth_range":0,"surface_type":"middle"}"#))),
        ("stone-depth-no-range", one_condition(j(#"{"type":"minecraft:stone_depth","offset":0,"add_surface_depth":false,"surface_type":"floor"}"#))),
        ("gradient-bad-name", one_condition(j(#"{"type":"minecraft:vertical_gradient","random_name":"Not An Id","true_at_and_below":{"absolute":0},"false_at_and_above":{"absolute":8}}"#))),
        ("noise-bad-id", one_condition(j(#"{"type":"minecraft:noise_threshold","noise":"Not An Id","min_threshold":0,"max_threshold":1}"#))),
        ("noise-no-max", one_condition(j(#"{"type":"minecraft:noise_threshold","noise":"minecraft:surface","min_threshold":0}"#))),
        ("not-nothing", one_condition(j(#"{"type":"minecraft:not"}"#))),
        ("ore-chance-above-1", with(ore_vein(mut g1), "raw_ore_chance", Json.Float(1.5))),
        ("ore-unknown-density", with(ore_vein(mut g2), "density", s("minecraft:nowhere"))),
        ("ore-no-gap", without(ore_vein(mut g3), "filler_gap")),
    ]
}

pub fn main() {
    var g = gen(SEED)
    var cases: List<Json> = []

    // Each settings in its world, with its own rule.
    for (settings, min_y, height, source) in worlds() {
        let level = (min_y, height)
        var origin = start("{settings}-origin", g.seed(), settings, level, preset(source), none)
        origin.surface((0, 0))
        origin.surface((-1, -1))
        origin.surface(g.near_chunk(64))
        cases.push(origin.build())
        for i in 0..2 {
            var c = start("{settings}-near-{i}", g.seed(), settings, level, preset(source), none)
            c.surface(g.near_chunk(600))
            c.surface(g.near_chunk(600))
            cases.push(c.build())
        }
        var far = start("{settings}-far", g.seed(), settings, level, preset(source), none)
        far.surface(g.far_chunk())
        far.surface(g.far_chunk())
        cases.push(far.build())
    }

    // The Overworld's materials with more seeds, where worlds are.
    for i in 0usize..16 {
        let settings = ["overworld", "overworld", "large_biomes", "amplified"][i % 4]
        var c = start("overworld-seeds-{i}", g.seed(), settings, (-64, 384), preset("overworld"), none)
        c.surface(g.near_chunk(3000))
        c.surface(g.near_chunk(3000))
        cases.push(c.build())
    }

    // One biome everywhere: each biome's own materials over the Overworld's terrain, over land and
    // sea.
    for biome in SPECIAL {
        var c = start("fixed-{biome}", g.seed(), "overworld", (-64, 384), fixed(biome), none)
        for _ in 0..3 {
            c.surface(g.near_chunk(2000))
        }
        cases.push(c.build())
    }
    for biome in ["frozen_ocean", "deep_frozen_ocean", "eroded_badlands"] {
        for i in 0..3 {
            var c = start("fixed-{biome}-{i}", g.seed(), "overworld", (-64, 384), fixed(biome), none)
            for _ in 0..3 {
                c.surface(g.near_chunk(20000))
            }
            cases.push(c.build())
        }
    }
    for biome in NETHER {
        var c = start("fixed-{biome}", g.seed(), "nether", (0, 256), fixed(biome), none)
        c.surface(g.near_chunk(500))
        c.surface(g.near_chunk(500))
        cases.push(c.build())
    }

    // Checkerboards: the biome changes every few quarts, so the zoom picks between them.
    for i in 0..12 {
        let count = g.between(2, 6)
        var biomes: List<str> = []
        for _ in 0..count {
            biomes.push(g.pick(biomes_all()))
        }
        let seed = g.seed()
        let scale = g.between(0, 3)
        var c = start("checkerboard-{i}", seed, "overworld", (-64, 384), checkerboard(biomes, scale), none)
        c.surface(g.near_chunk(2000))
        c.surface(g.near_chunk(2000))
        cases.push(c.build())
    }
    var nether_board = NETHER.to_list()
    nether_board.push("frozen_ocean")
    var mixed_up = start(String("checkerboard-nether-in-overworld"), g.seed(), "overworld", (-64, 384), checkerboard(nether_board, 0), none)
    mixed_up.surface(g.near_chunk(500))
    cases.push(mixed_up.build())

    // Rules written out, over mixed biomes.
    let mixed = checkerboard(["frozen_ocean", "eroded_badlands", "snowy_slopes", "plains", "desert", "swamp", "frozen_peaks"], 1)
    for i in 0..40 {
        let settings = g.pick(["overworld", "overworld", "overworld", "amplified", "nether", "caves"])
        let (min_y, height, preset_name) = world_of(settings)
        let source = if g.chance(2) { mixed.copy() } else { preset(preset_name) }
        let seed = g.seed()
        var c = start("written-{i}", seed, settings, (min_y, height), source, some(written(mut g)))
        c.surface(g.near_chunk(1000))
        c.surface(g.near_chunk(1000))
        cases.push(c.build())
    }
    // Each of vanilla's rules and conditions on its own, in the Overworld.
    for name in RULES {
        var c = start("rule-{name.replace("/", "-")}", g.seed(), "overworld", (-64, 384), preset("overworld"), some(s(m(name))))
        c.surface(g.near_chunk(1000))
        cases.push(c.build())
    }
    for name in CONDITIONS {
        var c = start("condition-{name}", g.seed(), "overworld", (-64, 384), mixed.copy(), some(one_condition(s(m(name)))))
        c.surface(g.near_chunk(1000))
        cases.push(c.build())
    }
    // The simplest rules: none at all, an empty sequence, one block everywhere, bands everywhere.
    var g4 = gen(4)
    let simple: List<(str, Json)> = [
        ("empty-sequence", j(#"{"type":"minecraft:sequence","sequence":[]}"#)),
        ("one-in-sequence", j(#"{"type":"minecraft:sequence","sequence":[{"type":"minecraft:bandlands"}]}"#)),
        ("all-glass", j(#"{"type":"minecraft:block","result_state":"minecraft:glass"}"#)),
        ("all-air", j(#"{"type":"minecraft:block","result_state":"minecraft:air"}"#)),
        ("all-water", j(#"{"type":"minecraft:block","result_state":"minecraft:water"}"#)),
        ("bands", j(#"{"type":"minecraft:bandlands"}"#)),
        ("temperature", one_condition(j(#"{"type":"minecraft:temperature"}"#))),
        ("steep", one_condition(j(#"{"type":"minecraft:steep"}"#))),
        ("hole", one_condition(j(#"{"type":"minecraft:hole"}"#))),
        ("preliminary", one_condition(j(#"{"type":"minecraft:above_preliminary_surface"}"#))),
        ("noise-3d", one_condition(j(#"{"type":"minecraft:noise_threshold","noise":"minecraft:surface","min_threshold":0.0,"max_threshold":1.0e308,"is_3d":true}"#))),
        ("missing-noise", one_condition(j(#"{"type":"minecraft:noise_threshold","noise":"minecraft:nowhere","min_threshold":0.0,"max_threshold":1.0}"#))),
        ("ceiling-secondary", one_condition(j(#"{"type":"minecraft:stone_depth","offset":2,"add_surface_depth":true,"secondary_depth_range":12,"surface_type":"ceiling"}"#))),
        ("ore-everywhere", with(ore_vein(mut g4), "density", constant(2.0))),
    ]
    for (name, r) in simple {
        for settings in ["overworld", "nether"] {
            let (min_y, height, source) = world_of(settings)
            let world_source = if settings == "overworld" { mixed.copy() } else { preset(source) }
            var c = start("simple-{name}-{settings}", g.seed(), settings, (min_y, height), world_source, some(r.copy()))
            c.surface(g.near_chunk(300))
            cases.push(c.build())
        }
    }

    // Worlds that aren't the noise's: taller, shorter, overlapping its top or bottom, or past it.
    let levels: List<(str, i64, i64)> = [("tall", -128, 512), ("short", 0, 128), ("one-section", -64, 16), ("top-section", 304, 16), ("above", 320, 64), ("below", -2032, 16), ("low", -512, 448)]
    for (name, min_y, height) in levels {
        for settings in ["overworld", "nether"] {
            let (_, _, source) = world_of(settings)
            var c = start("level-{name}-{settings}", g.seed(), settings, (min_y, height), preset(source), none)
            c.surface(g.near_chunk(64))
            cases.push(c.build())
        }
    }
    var end_in = start(String("level-end-in-overworld"), g.seed(), "end", (-64, 384), preset("end"), none)
    end_in.surface((0, 0))
    end_in.surface(g.near_chunk(200))
    cases.push(end_in.build())

    // The ends of `int`, where blocks and quarts wrap. (A chunk at one end in x and the other in z
    // makes an aquifer grid too big for any heap.)
    for (i, chunk) in [(134217727i64, 134217727i64), (-134217728, -134217728), (134217727, 134217727)].enumerate() {
        let source = if i == 2 { fixed("eroded_badlands") } else { preset("overworld") }
        var c = start("edge-{i}", g.seed(), "overworld", (-64, 384), source, none)
        c.surface(chunk)
        cases.push(c.build())
    }

    // Sources and rules vanilla doesn't read.
    for (name, r) in invalid_rules() {
        var c = start("invalid-rule-{name}", String("0"), "overworld", (-64, 384), preset("overworld"), some(r.copy()))
        c.surface((0, 0))
        cases.push(c.build())
    }
    let sources: List<(str, Json)> = [("no-type", j(#"{"biome":"minecraft:plains"}"#)), ("unknown-biome", j(#"{"type":"minecraft:fixed","biome":"minecraft:nowhere"}"#)), ("unknown-preset", preset("mystery"))]
    for (name, source) in sources {
        var c = start("invalid-source-{name}", String("0"), "overworld", (-64, 384), source.copy(), none)
        c.surface((0, 0))
        cases.push(c.build())
    }
    var both = start(String("invalid-both"), String("0"), "overworld", (-64, 384), j(#"{"type":"x"}"#), some(s("minecraft:nowhere")))
    both.surface((0, 0))
    cases.push(both.build())

    write_file(file("surface", "generated.json"), String("surface"), "cases/surface/gen.calx, seed {SEED}", cases, 1)
}
