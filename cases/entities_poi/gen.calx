module cases.entities_poi.gen

// Writes cases/entities_poi/generated.json: chunks of a world's `entities/` and `poi/` folders, as
// SNBT, read as vanilla's EntityStorage reads an entity chunk before it makes the entities,
// written as it stores one, and read and written back as SectionStorage reads and writes a chunk
// of points of interest for PoiManager.
//
//     calx cases/entities_poi/gen.calx
//
// The entity cases cover the chunk's position, written well, badly, in the wrong place and in
// every kind of list and array, and its `Entities`, as a list of compounds, of other tags, empty,
// and missing. The POI cases cover sections by height, inside the world and outside it, their
// `Valid` flag in every kind of number and in others, and their records: positions, types by
// name, with and without a namespace, unknown and malformed, tickets, records at the same place in
// a section, and enough of them to fill a section's map in the order vanilla's keeps them.
//
// Every chunk is from 26.3, or newer, since an older one is upgraded by vanilla and read as it is
// by Calcite (D169).

import std.json.{Json}
import cases.kit.{case, file, n, obj, s}
import rig.runner.cases.{splitmix64, write_file}

const SEED: u64 = 20261031

/// A dimension's lowest Y and its height in sections.
struct Height {
    min_y: i64,
    sections: i64,
}

const OVERWORLD: Height = Height { min_y: -64, sections: 24 }
const NETHER: Height = Height { min_y: 0, sections: 16 }

const PIG: str = #"{id:"minecraft:pig",Pos:[0.5d,64.0d,0.5d],Motion:[0.0d,0.0d,0.0d],Rotation:[0.0f,0.0f],UUID:[I;1,2,3,4]}"#
const ZOMBIE: str = #"{id:"minecraft:zombie",Pos:[17.5d,-20.0d,-3.5d],Health:20.0f,Passengers:[{id:"minecraft:chicken"}]}"#
const ITEM: str = #"{id:"minecraft:item",Item:{id:"minecraft:stone",count:3},Age:5s}"#

fn load(out: mut List<Json>, name: str, snbt: String?, x: i64, z: i64) {
    var input: List<(String, Json)> = [(String("op"), s("entities_load")), (String("x"), n(x)), (String("z"), n(z))]
    if let text = snbt {
        input.push((String("snbt"), s(text.copy())))
    }
    out.push(case("load-{name}", obj(input)))
}

/// An entity chunk: its version, position, entities and anything else, each left out where none.
fn entity_chunk(entities: String?, position: String?, version: str, extra: str) -> String {
    var parts: List<String> = ["DataVersion:{version}"]
    if let p = position {
        parts.push("Position:{p}")
    }
    if let e = entities {
        parts.push("Entities:{e}")
    }
    if extra.len() > 0 {
        parts.push(String(extra))
    }
    return "\{{parts.join(",")}\}"
}

/// A 26.3 entity chunk at 0, 0, or at `position`.
fn ents(entities: own String) -> String {
    return entity_chunk(some(entities), some(String("[I;0,0]")), "5023", "")
}

fn ents_at(entities: own String, position: str) -> String {
    return entity_chunk(some(entities), some(String(position)), "5023", "")
}

fn pig() -> String {
    return "[{PIG}]"
}

fn loads() -> List<Json> {
    var out: List<Json> = []
    load(mut out, "none", none, 0, 0)
    load(mut out, "one", some(ents(pig())), 0, 0)
    load(mut out, "three", some(ents("[{PIG},{ZOMBIE},{ITEM}]")), 0, 0)
    load(mut out, "placed", some(ents_at(pig(), "[I;5,-7]")), 5, -7)
    load(mut out, "far", some(ents_at(pig(), "[I;-1875000,1874999]")), -1875000, 1874999)
    load(mut out, "empty-list", some(ents(String("[]"))), 0, 0)
    load(mut out, "no-entities", some(entity_chunk(none, some(String("[I;0,0]")), "5023", "")), 0, 0)
    load(mut out, "empty-root", some(String("\{DataVersion:5023\}")), 0, 0)
    load(mut out, "only-entities", some(entity_chunk(some(pig()), none, "5023", "")), 0, 0)
    load(mut out, "entities-int", some(ents(String("5"))), 0, 0)
    load(mut out, "entities-compound", some(ents(String(PIG))), 0, 0)
    load(mut out, "entities-string", some(ents(String(#""pig""#))), 0, 0)
    load(mut out, "entities-int-array", some(ents(String("[I;1,2]"))), 0, 0)
    load(mut out, "entities-long-array", some(ents(String("[L;1L]"))), 0, 0)
    load(mut out, "entities-byte-array", some(ents(String("[B;1b]"))), 0, 0)
    load(mut out, "entities-mixed", some(ents("[{PIG},5,\"x\",{ZOMBIE},[1,2],\{\}]")), 0, 0)
    load(mut out, "entities-not-compounds", some(ents(String("[1,2,3]"))), 0, 0)
    load(mut out, "entities-lists", some(ents(String(#"[[{a:1}],[]]"#))), 0, 0)
    load(mut out, "entities-empty-compounds", some(ents(String(#"[{},{},{a:1b}]"#))), 0, 0)
    load(mut out, "entities-nested-lists", some(ents("[{PIG},[{PIG}]]")), 0, 0)
    load(mut out, "entities-all-kinds", some(ents(String(#"[1b,2s,3,4L,5.0f,6.0d,[B;1b],"s",[1],{a:1},[I;1],[L;1L]]"#))), 0, 0)
    load(mut out, "misplaced", some(ents_at(pig(), "[I;3,4]")), 0, 0)
    load(mut out, "misplaced-elsewhere", some(ents_at(pig(), "[I;0,0]")), 9, -9)
    load(mut out, "misplaced-and-bad", some(ents_at(String("[1]"), "[I;3,4]")), 0, 0)
    load(mut out, "no-position", some(entity_chunk(some(pig()), none, "5023", "")), 0, 0)
    load(mut out, "no-position-bad", some(entity_chunk(some(String("5")), none, "5023", "")), 0, 0)
    load(mut out, "position-list", some(ents_at(pig(), "[0,0]")), 0, 0)
    load(mut out, "position-list-placed", some(ents_at(pig(), "[2,3]")), 2, 3)
    load(mut out, "position-bytes", some(ents_at(pig(), "[B;1b,2b]")), 1, 2)
    load(mut out, "position-longs", some(ents_at(pig(), "[L;1L,2L]")), 1, 2)
    load(mut out, "position-longs-wrap", some(ents_at(pig(), "[L;4294967297L,-4294967298L]")), 1, -2)
    load(mut out, "position-doubles", some(ents_at(pig(), "[1.9d,-2.9d]")), 1, -2)
    load(mut out, "position-floats", some(ents_at(pig(), "[1.5f,2.5f]")), 0, 0)
    load(mut out, "position-mixed-numbers", some(ents_at(pig(), "[1b,2L]")), 1, 2)
    load(mut out, "position-three", some(ents_at(pig(), "[I;0,0,7]")), 0, 0)
    load(mut out, "position-three-misplaced", some(ents_at(pig(), "[I;1,0,0]")), 0, 0)
    load(mut out, "position-four-list", some(ents_at(pig(), "[0,0,1,2]")), 0, 0)
    load(mut out, "position-one", some(ents_at(pig(), "[I;0]")), 0, 0)
    load(mut out, "position-empty", some(ents_at(pig(), "[I;]")), 0, 0)
    load(mut out, "position-empty-list", some(ents_at(pig(), "[]")), 0, 0)
    load(mut out, "position-string", some(ents_at(pig(), #""0,0""#)), 0, 0)
    load(mut out, "position-int", some(ents_at(pig(), "0")), 0, 0)
    load(mut out, "position-compound", some(ents_at(pig(), #"{x:0,z:0}"#)), 0, 0)
    load(mut out, "position-strings", some(ents_at(pig(), #"["a","b"]"#)), 0, 0)
    load(mut out, "position-some-strings", some(ents_at(pig(), #"[0,"b"]"#)), 0, 0)
    load(mut out, "position-compounds", some(ents_at(pig(), #"[{a:1},{b:2}]"#)), 0, 0)
    load(mut out, "position-lists", some(ents_at(pig(), "[[0],[0]]")), 0, 0)
    load(mut out, "position-quotes", some(ents_at(pig(), #"["it's",'"x"']"#)), 0, 0)
    load(mut out, "bad-position-bad-entities", some(ents_at(String(#"[1,"x"]"#), "[I;0]")), 0, 0)
    load(mut out, "newer", some(entity_chunk(some(pig()), some(String("[I;0,0]")), "9999", "")), 0, 0)
    load(mut out, "newer-misplaced", some(entity_chunk(some(pig()), some(String("[I;1,1]")), "6000", "")), 0, 0)
    load(mut out, "extra-keys", some(entity_chunk(some(pig()), some(String("[I;0,0]")), "5023", #"Other:"kept",Level:{}"#)), 0, 0)
    var numbers: List<String> = []
    for i in 0..12 {
        numbers.push("{i}")
    }
    load(mut out, "many-bad", some(ents("[{numbers.join(",")}]")), 3, 4)
    return out
}

fn save(out: mut List<Json>, name: str, snbt: String, x: i64, z: i64) {
    out.push(case("save-{name}", obj([(String("op"), s("entities_save")), (String("x"), n(x)), (String("z"), n(z)), (String("snbt"), s(snbt.copy()))])))
}

fn saves() -> List<Json> {
    var out: List<Json> = []
    save(mut out, "none", String("\{\}"), 0, 0)
    save(mut out, "none-other-keys", String("\{Other:1\}"), 0, 0)
    save(mut out, "declined", String("\{Entities:[]\}"), 0, 0)
    save(mut out, "one", "\{Entities:[{PIG}]\}", 0, 0)
    save(mut out, "three", "\{Entities:[{PIG},{ZOMBIE},{ITEM}]\}", 7, -8)
    save(mut out, "far", "\{Entities:[{ITEM}]\}", 1874999, -1875000)
    save(mut out, "min", "\{Entities:[{ITEM}]\}", -2147483648, 2147483647)
    return out
}

fn poi_in(out: mut List<Json>, name: String, snbt: String?, x: i64, z: i64, height: Height) {
    var input: List<(String, Json)> = [(String("op"), s("poi")), (String("x"), n(x)), (String("z"), n(z)), (String("min_y"), n(height.min_y)), (String("sections"), n(height.sections))]
    if let text = snbt {
        input.push((String("snbt"), s(text.copy())))
    }
    out.push(case("poi-{name}", obj(input)))
}

/// A POI case at 0, 0 in the Overworld.
fn poi(out: mut List<Json>, name: String, snbt: own String) {
    poi_in(mut out, name, some(snbt), 0, 0, OVERWORLD)
}

/// A record; `kind` is SNBT, a quoted name or any other tag.
fn record(pos: String, kind: String, tickets: String?, extra: str) -> String {
    var parts: List<String> = ["pos:{pos}", "type:{kind}"]
    if let t = tickets {
        parts.push("free_tickets:{t}")
    }
    if extra.len() > 0 {
        parts.push(String(extra))
    }
    return "\{{parts.join(",")}\}"
}

fn named(name: String) -> String {
    return "\"{name}\""
}

/// A home at `pos`.
fn home_at(pos: str) -> String {
    return record(String(pos), named(String("minecraft:home")), none, "")
}

fn kind_at(pos: str, kind: str) -> String {
    return record(String(pos), named(String(kind)), none, "")
}

fn home_tickets(tickets: str) -> String {
    return record(String("[I;1,2,3]"), named(String("minecraft:home")), some(String(tickets)), "")
}

fn home() -> String {
    return home_at("[I;1,2,3]")
}

fn bell() -> String {
    return record(String("[I;4,5,6]"), named(String("minecraft:meeting")), some(String("32")), "")
}

/// A section: `Valid` and the records' list, each left out where none.
fn section_of(records: String?, valid: str?) -> String {
    var parts: List<String> = []
    if let v = valid {
        parts.push("Valid:{v}")
    }
    if let r = records {
        parts.push("Records:{r}")
    }
    return "\{{parts.join(",")}\}"
}

/// A valid section of `records`.
fn sec(records: List<String>) -> String {
    return section_of(some("[{records.join(",")}]"), some("1b"))
}

fn sec_valid(records: List<String>, valid: str?) -> String {
    return section_of(some("[{records.join(",")}]"), valid)
}

/// `Sections` with the sections given at each key, in the order given.
fn keyed(sections: List<(String, String)>) -> String {
    var parts: List<String> = []
    for (y, section) in sections {
        parts.push("\"{y}\":{section}")
    }
    return "\{{parts.join(",")}\}"
}

fn at(sections: List<(i64, String)>) -> String {
    var named_keys: List<(String, String)> = []
    for (y, section) in sections {
        named_keys.push(("{y}", section.copy()))
    }
    return keyed(named_keys)
}

fn poi_chunk(sections: String?, version: str, extra: str) -> String {
    var parts: List<String> = ["DataVersion:{version}"]
    if let value = sections {
        parts.push("Sections:{value}")
    }
    if extra.len() > 0 {
        parts.push(String(extra))
    }
    return "\{{parts.join(",")}\}"
}

/// A 26.3 POI chunk of these sections.
fn pc(sections: own String) -> String {
    return poi_chunk(some(sections), "5023", "")
}

/// A 26.3 POI chunk with one valid section, at 0, of `records`.
fn one(records: List<String>) -> String {
    return pc(at([(0, sec(records))]))
}

const KINDS: [str; 21] = ["armorer", "butcher", "cartographer", "cleric", "farmer", "fisherman", "fletcher", "leatherworker", "librarian", "mason", "shepherd", "toolsmith", "weaponsmith", "home", "meeting", "beehive", "bee_nest", "nether_portal", "lodestone", "test_instance", "lightning_rod"]

fn pois() -> List<Json> {
    var g = splitmix64(SEED)
    var many: List<String> = []
    for _ in 0..40 {
        let v = g.next()
        many.push(record("[I;{v & 15},{(v >> 4) & 15},{(v >> 8) & 15}]", named("minecraft:{KINDS[usize.wrap((v >> 12) % 21)]}"), some("{(v >> 20) % 3}"), ""))
    }
    var backwards = many.copy()
    backwards.reverse()
    var full: List<String> = []
    for x in 0..16 {
        for z in 0..16 {
            for y in [0, 15] {
                full.push(record("[I;{x},{32 + y},{z}]", named(String("minecraft:nether_portal")), none, ""))
            }
        }
    }
    var types: List<String> = []
    for (i, k) in KINDS.enumerate() {
        types.push(record("[I;{i % 16},{i / 16},0]", named("minecraft:{k}"), none, ""))
    }
    var out: List<Json> = []
    poi_in(mut out, "none", none, 0, 0, OVERWORLD)
    poi_in(mut out, "none-nether", none, 0, 0, NETHER)
    poi(mut out, "one", one([home()]))
    poi(mut out, "two", one([home(), bell()]))
    poi(mut out, "sections", pc(at([(-4, sec([home_at("[I;0,-64,0]")])), (3, sec([bell()])), (19, sec([kind_at("[I;15,319,15]", "minecraft:lodestone")]))])))
    poi_in(mut out, "sections-placed", some(pc(at([(1, sec([home_at("[I;-31,16,47]")]))]))), -2, 2, OVERWORLD)
    poi(mut out, "outside", pc(at([(-5, sec([home()])), (20, sec([bell()])), (0, sec([home()]))])))
    poi_in(mut out, "nether", some(pc(at([(-1, sec([home()])), (0, sec([home()])), (15, sec([bell()])), (16, sec([bell()]))]))), 0, 0, NETHER)
    poi(mut out, "odd-keys", pc(keyed([(String("01"), sec([home()])), (String("+1"), sec([home()])), (String(" 2"), sec([home()])), (String("x"), sec([home()])), (String("3"), sec([bell()]))])))
    poi(mut out, "no-sections", poi_chunk(none, "5023", ""))
    poi(mut out, "empty-sections", pc(at([])))
    poi(mut out, "empty-root", String("\{DataVersion:5023\}"))
    poi(mut out, "sections-int", pc(String("5")))
    poi(mut out, "sections-list", pc(String(#"[{Valid:1b,Records:[]}]"#)))
    poi(mut out, "section-int", pc(at([(0, String("5")), (1, sec([home()]))])))
    poi(mut out, "section-list", pc(at([(0, String("[1,2]"))])))
    poi(mut out, "section-string", pc(at([(0, String(#""x""#))])))
    poi(mut out, "section-empty", pc(at([(0, String("\{\}"))])))
    poi(mut out, "records-empty", one([]))
    poi(mut out, "records-empty-invalid", pc(at([(0, sec_valid([], none))])))
    poi(mut out, "records-missing", pc(at([(0, section_of(none, some("1b"))), (1, sec([home()]))])))
    poi(mut out, "records-int", pc(at([(0, section_of(some(String("5")), some("1b")))])))
    poi(mut out, "records-compound", pc(at([(0, section_of(some(home()), some("1b")))])))
    poi(mut out, "records-string", pc(at([(0, section_of(some(String(#""x""#)), some("1b")))])))
    poi(mut out, "records-int-array", pc(at([(0, section_of(some(String("[I;1,2]")), some("1b")))])))
    poi(mut out, "valid-missing", pc(at([(0, sec_valid([home()], none))])))
    for (name, valid) in [("false", "0b"), ("two", "2b"), ("int", "1"), ("256", "256"), ("257", "257s"), ("half", "0.5d"), ("float", "1.9f"), ("long", "4294967297L"), ("negative", "-1b"), ("string", #""true""#), ("list", "[1b]")] {
        poi(mut out, "valid-{name}", pc(at([(0, sec_valid([home()], some(valid)))])))
    }
    poi(mut out, "valid-string-no-records", pc(at([(0, section_of(none, some(#""true""#)))])))
    poi(mut out, "type-short", one([kind_at("[I;1,2,3]", "home")]))
    poi(mut out, "type-unknown", one([home(), kind_at("[I;2,2,3]", "minecraft:nope"), bell()]))
    poi(mut out, "type-other-namespace", one([kind_at("[I;2,2,3]", "mod:home")]))
    poi(mut out, "type-malformed", one([kind_at("[I;2,2,3]", "Bad Name"), home()]))
    poi(mut out, "type-malformed-namespace", one([kind_at("[I;2,2,3]", "a b:c")]))
    poi(mut out, "type-int", one([record(String("[I;2,2,3]"), String("5"), none, ""), home()]))
    poi(mut out, "type-compound", one([record(String("[I;2,2,3]"), String("\{id:home\}"), none, "")]))
    poi(mut out, "type-missing", one([String("\{pos:[I;2,2,3]\}"), home()]))
    poi(mut out, "types", one(types))
    poi(mut out, "pos-list", one([home_at("[1,2,3]")]))
    poi(mut out, "pos-longs", one([home_at("[L;1L,2L,4294967299L]")]))
    poi(mut out, "pos-bytes", one([home_at("[B;1b,2b,3b]")]))
    poi(mut out, "pos-doubles", one([home_at("[1.5d,2.5d,-3.5d]")]))
    poi(mut out, "pos-four", one([home_at("[I;1,2,3,4]")]))
    poi(mut out, "pos-four-bad-type", one([kind_at("[I;1,2,3,4]", "minecraft:nope")]))
    poi(mut out, "pos-two", one([home_at("[I;1,2]"), bell()]))
    poi(mut out, "pos-empty", one([home_at("[I;]")]))
    poi(mut out, "pos-string", one([home_at(#""1,2,3""#)]))
    poi(mut out, "pos-strings", one([home_at(#"["1","2","3"]"#)]))
    poi(mut out, "pos-missing", one([String(#"{type:"minecraft:home"}"#), bell()]))
    poi(mut out, "pos-and-type-bad", one([kind_at("[I;1]", "minecraft:nope")]))
    poi(mut out, "pos-and-type-missing", one([String("\{free_tickets:1\}")]))
    poi(mut out, "all-bad", one([record(String("[I;1]"), named(String("minecraft:nope")), some(String(#""x""#)), "")]))
    poi(mut out, "pos-outside", one([home_at("[I;100,-200,300]")]))
    poi(mut out, "pos-in-another-section", pc(at([(0, sec([home_at("[I;1,18,3]")])), (1, sec([home_at("[I;1,2,3]")]))])))
    for (name, tickets) in [("zero", "0"), ("byte", "3b"), ("double", "1.9d"), ("negative", "-5"), ("long", "4294967297L")] {
        poi(mut out, "tickets-{name}", one([home_tickets(tickets)]))
    }
    poi(mut out, "tickets-string", one([home_tickets(#""1""#), bell()]))
    poi(mut out, "tickets-list", one([home_tickets("[1]")]))
    poi(mut out, "extra-fields", pc(at([(0, String(#"{Valid:1b,Records:[{pos:[I;1,2,3],type:"minecraft:home",free_tickets:1,extra:5}],More:1}"#))])))
    poi(mut out, "record-int", one([String("5"), home()]))
    poi(mut out, "record-list", one([String("[1,2,3]"), home()]))
    poi(mut out, "record-empty", one([String("\{\}"), home()]))
    poi(mut out, "records-all-bad", one([String("5"), String("\{\}"), home_at("[I;1]")]))
    poi(mut out, "same-place", one([home(), home_tickets("1")]))
    poi(mut out, "same-place-other-type", one([home(), kind_at("[I;1,2,3]", "minecraft:meeting")]))
    poi(mut out, "same-place-short-name", one([home(), kind_at("[I;1,2,3]", "home")]))
    poi(mut out, "same-relative-place", one([home(), home_at("[I;17,2,3]")]))
    poi(mut out, "same-relative-other-type", one([home(), record(String("[I;17,-14,35]"), named(String("minecraft:farmer")), some(String("2")), "")]))
    poi(mut out, "same-place-three", one([home(), kind_at("[I;1,2,3]", "minecraft:meeting"), kind_at("[I;1,2,3]", "minecraft:farmer"), kind_at("[I;1,2,3]", "minecraft:farmer")]))
    poi(mut out, "zero-key", one([home_at("[I;5,5,5]"), home_at("[I;0,0,0]"), kind_at("[I;16,16,16]", "minecraft:meeting")]))
    poi(mut out, "many", pc(at([(0, sec(many)), (5, sec(backwards))])))
    poi(mut out, "full", pc(at([(2, sec_valid(full, some("0b")))])))
    poi(mut out, "newer", poi_chunk(some(at([(0, sec([home()]))])), "9999", ""))
    poi(mut out, "no-other-root", poi_chunk(some(at([(0, sec([home()]))])), "5023", #"Other:"dropped""#))
    poi(mut out, "bad-sections-and-good", pc(at([(-4, section_of(none, some("1b"))), (-3, String("5")), (-2, sec([home_at("[I;1]")])), (-1, sec([home(), String("1")])), (0, sec([bell()])), (7, sec_valid([], some("1b")))])))
    return out
}

pub fn main() {
    var cases = loads()
    cases.extend(saves())
    cases.extend(pois())
    write_file(file("entities_poi", "generated.json"), String("entities_poi"), String("cases/entities_poi/gen.calx"), cases, 1)
}
