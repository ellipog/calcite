module cases.components

// The item components the `packs` and `items` cases share (CAL-77): a patch of each type Calcite
// reads, in shapes vanilla writes back another way, and patches that don't read, each stopping the
// registries loading. The packs cases put them in dialogs, and the items cases read them as stacks.
//
// They're written as the Python generators wrote their dicts, with a comma after an object's or a
// list's last member, which `loose` takes out, and `@NAME@` where the Python repeated a string or
// a list, which `filled` puts in.

import std.json
import std.json.{Json}
import tools.repo.{die}

/// `text` with each comma before a `}` or `]` taken out, outside the strings.
fn loose(text: String) -> String {
    let bytes = text.to_bytes()
    var out: List<u8> = []
    var quoted = false
    var escaped = false
    var i: usize = 0
    while i < bytes.len() {
        let c = bytes[i]
        if quoted {
            if escaped {
                escaped = false
            } else if c == 92 {
                escaped = true
            } else if c == 34 {
                quoted = false
            }
            out.push(c)
            i += 1
            continue
        }
        if c == 34 {
            quoted = true
        } else if c == 44 {
            var k = i + 1
            while k < bytes.len() and (bytes[k] == 32 or bytes[k] == 10 or bytes[k] == 13) {
                k += 1
            }
            if k < bytes.len() and (bytes[k] == 125 or bytes[k] == 93) {
                i += 1
                continue
            }
        }
        out.push(c)
        i += 1
    }
    return String.from_utf8(out) ?? die("components: not UTF-8")
}

/// The repeats the Python wrote as `"x" * 33` and the like, put in.
fn filled(text: String) -> String {
    var props: List<String> = []
    for i in 0..17 {
        props.push("\"k{i}\": [\"v\"]")
    }
    var prop_list: List<String> = []
    var xs: List<String> = []
    for _ in 0..17 {
        prop_list.push(#"{"name": "k", "value": "v"}"#)
    }
    for _ in 0..101 {
        xs.push("\"x\"")
    }
    let smile = "\u{1F600}"
    return text.replace("@X32765@", "x".repeat(32765)).replace("@X32766@", "x".repeat(32766)).replace("@X33@", "x".repeat(33)).replace("@X1025@", "x".repeat(1025)).replace("@K65@", "k".repeat(65)).replace("@SMILE16@", smile.repeat(16)).replace("@SMILE17@", smile.repeat(17)).replace("@XS101@", "[{xs.join(", ")}]").replace("@PROPS17@", "\{{props.join(", ")}\}").replace("@PROPLIST17@", "[{prop_list.join(", ")}]")
}

fn parsed(text: str) -> Json {
    return match json.parse(filled(loose(String(text)))) {
        ok(v) => v,
        err(e) => die("components: {e}"),
    }
}

/// Components of each type Calcite reads, in shapes vanilla writes back another way: IDs without
/// their namespace, defaults given, one block predicate alone, numbers that are other numbers;
/// then the types with codecs of their own, from attribute modifiers to fuels; then tooltips,
/// books, the debug stick, profiles and signs.
pub fn item_components() -> List<Json> {
    if let Json.Array(xs) = parsed(ITEMS) {
        return xs
    }
    die("components: not a list")
}

/// Patches that don't read, by name, in the order the Python's dict had them.
pub fn bad_components() -> List<(String, Json)> {
    var out: List<(String, Json)> = []
    if let Json.Object(m) = parsed(BAD) {
        for (k, v) in m {
            out.push((k.copy(), v.copy()))
        }
    }
    return out
}

