module cases.carvers.gen

// Writes cases/carvers/generated.json: chunks filled, given their materials and then carved, by the
// carvers of their biomes and by carvers written out.
//
//     calx cases/carvers/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the same
// file.
//
// The cases name vanilla's carvers by id and never copy them. Each of vanilla's noise settings
// carves chunks with the carvers of the biomes its world has, near the origin and far out. Then
// sources that put one biome everywhere carve under each biome's materials, where a cave through
// grass gives the dirt under it the biome's top material; carvers written out try each value
// provider, room, split, floor and canyon width on their own, over worlds that aren't the noise's;
// chunks at the ends of `int`; rules written out for the top material; and carvers vanilla doesn't
// read, or that throw.
//
// Each draw is a statement of its own, in the order the Python drew them: a dict's values in the
// order they're written, a list's items before the pick among them, and `or`'s right side only
// when its left fails. A carver with fields changed is `with`, which keeps a member where it was,
// as `{**c, k: v}` did.

import std.json
import std.json.{Json}
import cases.kit.{arr, b, case, file, ints, n, obj, s, strs, with}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}
import tools.repo.{die}

const SEED: u64 = 20261107
const LONG_SEEDS: [str; 6] = ["0", "1", "-1", "9223372036854775807", "-9223372036854775808", "12345"]
const BORDER: i64 = 1874999
// Biomes whose materials differ, so a cave through their grass gives the dirt under it its own.
const OVERWORLD: [str; 24] = [
    "plains", "desert", "badlands", "eroded_badlands", "mushroom_fields", "frozen_ocean", "ocean",
    "deep_ocean", "swamp", "mangrove_swamp", "snowy_slopes", "frozen_peaks", "stony_peaks",
    "windswept_gravelly_hills", "beach", "river", "lush_caves", "deep_dark", "dripstone_caves",
    "sulfur_caves", "old_growth_pine_taiga", "forest", "jungle", "savanna",
]
const NETHER: [str; 5] = ["nether_wastes", "soul_sand_valley", "crimson_forest", "warped_forest", "basalt_deltas"]
const CARVERS: [str; 4] = ["cave", "cave_extra_underground", "canyon", "nether_cave"]
const PICKLES: str = #"{"id":"minecraft:sea_pickle","properties":{"waterlogged":"true","pickles":"2"}}"#

/// Each settings' world, as (min_y, height), and the source its world preset gives it.
fn worlds() -> List<(str, i64, i64, str)> {
    return [("overworld", -64, 384, "overworld"), ("large_biomes", -64, 384, "overworld"), ("amplified", -64, 384, "overworld"), ("caves", -64, 384, "overworld"), ("floating_islands", -64, 384, "overworld"), ("nether", 0, 256, "nether"), ("end", 0, 256, "end")]
}

fn world_of(settings: str) -> (i64, i64, str) {
    for (name, min_y, height, source) in worlds() {
        if name == settings {
            return (min_y, height, source)
        }
    }
    die("no settings {settings}")
}

/// JSON written out, as the Python wrote its dicts and lists.
fn j(text: String) -> Json {
    return match json.parse(text.copy()) {
        ok(v) => v,
        err(e) => die("{text}: {e}"),
    }
}

fn rounded(x: f64) -> f64 {
    return f64.parse("{x:.4}") ?? x
}

struct Gen {
    r: SplitMix64
}

fn gen(seed: u64) -> Gen {
    return Gen { r: splitmix64(seed) }
}

impl Gen {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn between(mut self, lo: i64, hi: i64) -> i64 {
        return lo + self.below(hi - lo + 1)
    }

    fn chance(mut self, bound: i64) -> bool {
        return self.below(bound) == 0
    }

    fn pick(mut self, items: List<str>) -> str {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    fn pick_value(mut self, items: List<Json>) -> Json {
        return items[usize.wrap(self.below(i64.wrap(items.len())))].copy()
    }

    /// A float in [0, 1]: the draw over 2^64, as Python divided it.
    fn unit(mut self) -> f64 {
        return f64.nearest(self.r.next()) / 18446744073709551616.0
    }

    /// A float in [lo, hi], rounded to 4 places as Python's `round` rounds.
    fn real(mut self, lo: f64, hi: f64) -> f64 {
        return rounded(lo + (hi - lo) * self.unit())
    }

    fn long(mut self) -> String {
        return "{i64.wrap(self.r.next())}"
    }

    fn seed(mut self) -> String {
        if self.chance(4) {
            return String(LONG_SEEDS[usize.wrap(self.below(6))])
        }
        return self.long()
    }

    fn near_chunk(mut self, spread: i64) -> (i64, i64) {
        let x = self.between(-spread, spread)
        let z = self.between(-spread, spread)
        return (x, z)
    }

    fn far_chunk(mut self) -> (i64, i64) {
        let x = self.between(-BORDER, BORDER)
        let z = self.between(-BORDER, BORDER)
        return (x, z)
    }
}

fn m(name: str) -> String {
    return "minecraft:{name}"
}

fn preset(name: str) -> Json {
    if name == "end" {
        return obj([(String("type"), s("minecraft:the_end"))])
    }
    return obj([(String("type"), s("minecraft:multi_noise")), (String("preset"), s(m(name)))])
}

fn fixed(biome: str) -> Json {
    return obj([(String("type"), s("minecraft:fixed")), (String("biome"), s(m(biome)))])
}

fn checkerboard(biomes: List<str>, scale: i64) -> Json {
    var named: List<String> = []
    for biome in biomes {
        named.push(m(biome))
    }
    return obj([(String("type"), s("minecraft:checkerboard")), (String("biomes"), strs(named)), (String("scale"), n(scale))])
}

/// `("type", "minecraft:<name>")`, the first member of most of what the cases write.
fn kind(name: str) -> (String, Json) {
    return (String("type"), s(m(name)))
}

fn member(key: str, v: own Json) -> (String, Json) {
    return (String(key), v)
}

fn float(v: f64) -> Json {
    return Json.Float(v)
}

struct Case {
    id: String,
    seed: String,
    settings: str,
    min_y: i64,
    height: i64,
    source: Json,
    carvers: Json?,
    rule: Json?,
    ops: List<Json>,
}

fn start(id: own String, seed: own String, settings: str, level: (i64, i64), source: own Json, carvers: own Json?, given: own Json?) -> Case {
    return Case { id: id, seed: seed, settings: settings, min_y: level.0, height: level.1, source: source, carvers: carvers, rule: given, ops: [] }
}

impl Case {
    fn carve(mut self, chunk: (i64, i64)) {
        self.ops.push(arr([s("carve"), n(chunk.0), n(chunk.1)]))
    }

    fn build(self) -> Json {
        var input: List<(String, Json)> = [member("seed", s(self.seed.copy())), member("settings", s(m(self.settings))), member("level", ints([self.min_y, self.height])), member("source", self.source.copy())]
        if let c = self.carvers {
            input.push(member("carvers", c.copy()))
        }
        if let r = self.rule {
            input.push(member("rule", r.copy()))
        }
        input.push(member("ops", arr(self.ops.copy())))
        return case(self.id.copy(), obj(input))
    }
}

// Value providers.

fn anchor(g: mut Gen) -> Json {
    let which = g.below(4)
    if which == 0 {
        return obj([member("absolute", n(g.between(-70, 200)))])
    }
    if which == 1 {
        return obj([member("above_bottom", n(g.between(-4, 80)))])
    }
    if which == 2 {
        return obj([member("below_top", n(g.between(0, 300)))])
    }
    return obj([member("relative_to_sea_level", n(g.between(-90, 100)))])
}

fn heights(g: mut Gen, depth: i64) -> Json {
    let which = g.below(if depth == 0 { 7 } else { 6 })
    if which == 0 {
        return anchor(mut g)
    }
    if which == 1 {
        return obj([kind("constant"), member("value", anchor(mut g))])
    }
    if which == 2 {
        let low = anchor(mut g)
        let high = anchor(mut g)
        return obj([kind("uniform"), member("min_inclusive", low), member("max_inclusive", high)])
    }
    if which == 3 {
        let biased = m(g.pick(["biased_to_bottom", "very_biased_to_bottom"]))
        let bottom = g.between(0, 20)
        let high = anchor(mut g)
        var h: List<(String, Json)> = [(String("type"), s(biased)), member("min_inclusive", obj([member("above_bottom", n(bottom))])), member("max_inclusive", high)]
        if g.chance(2) {
            h.push(member("inner", n(g.between(1, 12))))
        }
        return obj(h)
    }
    if which == 4 {
        let low = anchor(mut g)
        let high = anchor(mut g)
        var h: List<(String, Json)> = [kind("trapezoid"), member("min_inclusive", low), member("max_inclusive", high)]
        if g.chance(2) {
            h.push(member("plateau", n(g.between(-4, 60))))
        }
        return obj(h)
    }
    if which == 5 {
        let top = g.between(40, 180)
        return obj([kind("uniform"), member("min_inclusive", j(#"{"above_bottom":8}"#)), member("max_inclusive", obj([member("absolute", n(top))]))])
    }
    let count = g.between(1, 3)
    var distribution: List<Json> = []
    for _ in 0..count {
        let data = heights(mut g, 1)
        let weight = g.between(0, 5)
        distribution.push(obj([member("data", data), member("weight", n(weight))]))
    }
    let last = heights(mut g, 1)
    distribution.push(obj([member("data", last), member("weight", n(1))]))
    return obj([kind("weighted_list"), member("distribution", arr(distribution))])
}

fn counts(g: mut Gen, depth: i64) -> Json {
    let which = g.below(if depth == 0 { 8 } else { 7 })
    let lo = g.between(0, 2)
    let hi = lo + g.between(0, 4)
    if which == 0 {
        return n(g.between(0, 4))
    }
    if which == 1 {
        return obj([kind("constant"), member("value", n(g.between(0, 4)))])
    }
    if which == 2 {
        let named = m(g.pick(["uniform", "biased_to_bottom", "very_biased_to_bottom"]))
        return obj([(String("type"), s(named)), member("min_inclusive", n(lo)), member("max_inclusive", n(hi))])
    }
    if which == 3 {
        let source = counts(mut g, 1)
        return obj([kind("clamped"), member("source", source), member("min_inclusive", n(lo)), member("max_inclusive", n(hi))])
    }
    if which == 4 {
        let mean = g.real(-1.0, 5.0)
        let deviation = g.real(0.0, 3.0)
        return obj([kind("clamped_normal"), member("mean", float(mean)), member("deviation", float(deviation)), member("min_inclusive", n(lo)), member("max_inclusive", n(hi))])
    }
    if which == 5 {
        let plateau = g.between(0, hi - lo)
        return obj([kind("trapezoid"), member("min", n(lo)), member("max", n(hi)), member("plateau", n(plateau))])
    }
    if which == 6 {
        let top = g.between(2, 14)
        return obj([kind("very_biased_to_bottom"), member("min_inclusive", n(0)), member("max_inclusive", n(top))])
    }
    let entries = g.between(1, 3)
    var distribution: List<Json> = []
    for _ in 0..entries {
        let data = counts(mut g, 1)
        let weight = g.between(1, 4)
        distribution.push(obj([member("data", data), member("weight", n(weight))]))
    }
    return obj([kind("weighted_list"), member("distribution", arr(distribution))])
}

/// A float provider whose values stay within [lo, hi].
fn floats(g: mut Gen, lo: f64, hi: f64) -> Json {
    let which = g.below(5)
    let x = g.real(lo, hi)
    let y = g.real(lo, hi)
    var a = if y < x { y } else { x }
    var b2 = if y < x { x } else { y }
    if b2 == a {
        b2 = if a + 0.01 <= hi { rounded(a + 0.01) } else { a }
        a = rounded(b2 - 0.01)
    }
    if which == 0 {
        return float(a)
    }
    if which == 1 {
        return obj([kind("constant"), member("value", float(b2))])
    }
    if which == 2 {
        return obj([kind("uniform"), member("min_inclusive", float(a)), member("max_exclusive", float(b2))])
    }
    if which == 3 {
        let deviation = g.real(0.0, hi - lo)
        return obj([kind("clamped_normal"), member("mean", float(rounded((a + b2) / 2.0))), member("deviation", float(deviation)), member("min", float(a)), member("max", float(b2))])
    }
    let plateau = rounded((b2 - a) * g.unit() * 0.9)
    return obj([kind("trapezoid"), member("min", float(a)), member("max", float(b2)), member("plateau", float(plateau))])
}

fn cave(g: mut Gen) -> Json {
    let r = g.real(0.0, 1.0)
    let probability = g.pick_value([float(0.15), float(0.3), float(0.6), float(1.0), float(r)])
    let y = heights(mut g, 0)
    let number = counts(mut g, 0)
    let thickness = floats(mut g, 0.0, 6.0)
    let room = floats(mut g, 0.0, 2.0)
    let horizontal = floats(mut g, 0.3, 2.5)
    let vertical = floats(mut g, 0.3, 2.5)
    let floor = floats(mut g, -1.0, 1.0)
    var c: List<(String, Json)> = [kind("cave"), member("probability", probability), member("y", y), member("count", number), member("thickness", thickness), member("room_vertical_radius_multiplier", room), member("horizontal_radius_multiplier", horizontal), member("vertical_radius_multiplier", vertical), member("floor_level", floor)]
    if g.chance(2) {
        c.push(member("weird_thickness_bias", b(g.chance(2))))
    }
    if g.chance(2) {
        c.push(member("start_vertical_radius_multiplier", floats(mut g, 0.2, 6.0)))
    }
    return obj(c)
}

fn canyon(g: mut Gen) -> Json {
    let r = g.real(0.0, 0.3)
    let probability = g.pick_value([float(0.01), float(0.05), float(0.2), float(1.0), float(r)])
    let y = heights(mut g, 0)
    let rotation = floats(mut g, -0.5, 0.5)
    let distance = floats(mut g, 0.1, 1.5)
    let thickness = floats(mut g, 0.0, 8.0)
    let smoothness = g.pick_value([n(1), n(2), n(3), n(5), n(40)])
    let horizontal = floats(mut g, 0.5, 1.5)
    let default_factor = g.real(0.0, 2.0)
    let center_factor = g.real(-1.0, 2.0)
    let y_scale = floats(mut g, 0.5, 5.0)
    let shape = obj([member("distance_factor", distance), member("thickness", thickness), member("width_smoothness", smoothness), member("horizontal_radius_factor", horizontal), member("vertical_radius_default_factor", float(default_factor)), member("vertical_radius_center_factor", float(center_factor)), member("y_scale", y_scale)])
    return obj([kind("canyon"), member("probability", probability), member("y", y), member("vertical_rotation", rotation), member("shape", shape)])
}

fn carver(g: mut Gen) -> Json {
    if g.chance(3) or g.chance(2) {
        return cave(mut g)
    }
    return canyon(mut g)
}

fn written(g: mut Gen) -> Json {
    var out: List<Json> = []
    if g.chance(4) {
        let count = g.between(1, 3)
        for _ in 0..count {
            out.push(s(m(g.pick(CARVERS.to_list()))))
        }
        return arr(out)
    }
    let count = g.between(1, 3)
    for _ in 0..count {
        out.push(carver(mut g))
    }
    return arr(out)
}

/// An object without one member.
fn without(v: own Json, key: str) -> Json {
    if let Json.Object(members) = v {
        var kept = LinkedMap<String, Json>()
        for (k, x) in members {
            if k != key {
                kept.insert(k.copy(), x.copy())
            }
        }
        return Json.Object(kept)
    }
    return v
}

fn member_of(v: Json, key: str) -> Json {
    return (v.get(String(key)) ?? Json.Null).copy()
}

/// The good canyon with a field of its shape changed, or taken out where `value` is none.
fn shape_with(good: Json, key: str, value: own Json?) -> Json {
    let shape = member_of(good, "shape")
    let changed = if let v = value { with(shape, key, v) } else { without(shape, key) }
    return arr([with(good.copy(), "shape", changed)])
}

/// The good cave with a field changed, as `cave_with` did.
fn cave_with(good: Json, key: str, value: str) -> Json {
    return one(with(good.copy(), key, j(String(value))))
}

fn one(c: own Json) -> Json {
    return arr([c])
}

fn invalid_carvers() -> List<(str, Json)> {
    var g1 = gen(1)
    var g2 = gen(2)
    let good_cave = cave(mut g1)
    let good_canyon = with(canyon(mut g2), "probability", float(0.5))
    return [
        ("no-type", one(without(good_cave.copy(), "type"))),
        ("unknown-type", one(with(good_cave.copy(), "type", s("minecraft:mystery")))),
        ("unknown-reference", strs([String("minecraft:nowhere")])),
        ("unknown-single-reference", s("minecraft:nowhere")),
        ("missing-tag", s("#minecraft:nowhere")),
        ("not-a-carver", ints([3])),
        ("mixed-kinds-unknown", arr([s("minecraft:cave"), good_cave.copy(), s("minecraft:nowhere")])),
        ("probability-above-1", cave_with(good_cave, "probability", "1.5")),
        ("probability-below-0", cave_with(good_cave, "probability", "-0.1")),
        ("probability-minus-0", cave_with(good_cave, "probability", "-0.0")),
        ("no-y", one(without(good_cave.copy(), "y"))),
        ("y-two-anchors", cave_with(good_cave, "y", #"{"absolute":0,"above_bottom":2}"#)),
        ("y-bad-inner", cave_with(good_cave, "y", #"{"type":"minecraft:biased_to_bottom","min_inclusive":{"absolute":0},"max_inclusive":{"absolute":40},"inner":0}"#)),
        ("count-negative", cave_with(good_cave, "count", "-1")),
        ("count-uniform-negative", cave_with(good_cave, "count", #"{"type":"minecraft:uniform","min_inclusive":-1,"max_inclusive":3}"#)),
        ("count-uniform-backwards", cave_with(good_cave, "count", #"{"type":"minecraft:uniform","min_inclusive":3,"max_inclusive":1}"#)),
        ("count-empty-weights", cave_with(good_cave, "count", #"{"type":"minecraft:weighted_list","distribution":[]}"#)),
        ("count-zero-weights", cave_with(good_cave, "count", #"{"type":"minecraft:weighted_list","distribution":[{"data":1,"weight":0}]}"#)),
        ("count-negative-weight", cave_with(good_cave, "count", #"{"type":"minecraft:weighted_list","distribution":[{"data":1,"weight":-1}]}"#)),
        ("count-plateau-past-span", cave_with(good_cave, "count", #"{"type":"minecraft:trapezoid","min":0,"max":2,"plateau":3}"#)),
        ("thickness-negative", cave_with(good_cave, "thickness", #"{"type":"minecraft:uniform","min_inclusive":-1.0,"max_exclusive":2.0}"#)),
        ("thickness-uniform-empty", cave_with(good_cave, "thickness", #"{"type":"minecraft:uniform","min_inclusive":2.0,"max_exclusive":2.0}"#)),
        ("thickness-normal-backwards", cave_with(good_cave, "thickness", #"{"type":"minecraft:clamped_normal","mean":1.0,"deviation":1.0,"min":3.0,"max":1.0}"#)),
        ("floor-above-1", cave_with(good_cave, "floor_level", "1.5")),
        ("floor-uniform-below-minus-1", cave_with(good_cave, "floor_level", #"{"type":"minecraft:uniform","min_inclusive":-1.5,"max_exclusive":0.0}"#)),
        ("no-floor", one(without(good_cave.copy(), "floor_level"))),
        ("bad-start-vertical", cave_with(good_cave, "start_vertical_radius_multiplier", #""wide""#)),
        ("bad-weird", cave_with(good_cave, "weird_thickness_bias", #""yes""#)),
        ("unknown-float-type", cave_with(good_cave, "horizontal_radius_multiplier", #"{"type":"minecraft:mystery"}"#)),
        ("canyon-no-shape", one(without(good_canyon.copy(), "shape"))),
        ("canyon-smoothness-0", shape_with(good_canyon, "width_smoothness", some(n(0)))),
        ("canyon-no-y-scale", shape_with(good_canyon, "y_scale", none)),
        ("canyon-factor-not-number", shape_with(good_canyon, "vertical_radius_center_factor", some(s("big")))),
        ("canyon-bad-rotation", one(with(good_canyon.copy(), "vertical_rotation", j(#"{"type":"minecraft:uniform","min_inclusive":1.0,"max_exclusive":0.0}"#)))),
    ]
}

fn uniform(low: str, high: str) -> Json {
    return j(#"{"type":"minecraft:uniform","min_inclusive":#{low},"max_inclusive":#{high}}"#)
}

pub fn main() {
    var g = gen(SEED)
    var cases: List<Json> = []

    // Each settings in its world, with its biomes' carvers.
    for (settings, min_y, height, source) in worlds() {
        let level = (min_y, height)
        var origin = start("{settings}-origin", g.seed(), settings, level, preset(source), none, none)
        origin.carve((0, 0))
        origin.carve((-1, -1))
        origin.carve(g.near_chunk(64))
        cases.push(origin.build())
        for i in 0..2 {
            var c = start("{settings}-near-{i}", g.seed(), settings, level, preset(source), none, none)
            c.carve(g.near_chunk(600))
            c.carve(g.near_chunk(600))
            cases.push(c.build())
        }
        var far = start("{settings}-far", g.seed(), settings, level, preset(source), none, none)
        far.carve(g.far_chunk())
        far.carve(g.far_chunk())
        cases.push(far.build())
    }

    // The Overworld's carvers with more seeds, where worlds are.
    for i in 0usize..16 {
        let settings = ["overworld", "overworld", "large_biomes", "amplified"][i % 4]
        var c = start("overworld-seeds-{i}", g.seed(), settings, (-64, 384), preset("overworld"), none, none)
        c.carve(g.near_chunk(3000))
        c.carve(g.near_chunk(3000))
        cases.push(c.build())
    }

    // One biome everywhere: caves through each biome's materials.
    for biome in OVERWORLD {
        var c = start("fixed-{biome}", g.seed(), "overworld", (-64, 384), fixed(biome), none, none)
        for _ in 0..2 {
            c.carve(g.near_chunk(2000))
        }
        cases.push(c.build())
    }
    for biome in NETHER {
        var c = start("fixed-{biome}", g.seed(), "nether", (0, 256), fixed(biome), none, none)
        c.carve(g.near_chunk(500))
        c.carve(g.near_chunk(500))
        cases.push(c.build())
    }
    for biome in ["nether_wastes", "plains"] {
        let other = if biome == "nether_wastes" { "overworld" } else { "nether" }
        let (min_y, height, _) = world_of(other)
        var c = start("fixed-{biome}-in-{other}", g.seed(), other, (min_y, height), fixed(biome), none, none)
        c.carve(g.near_chunk(500))
        c.carve(g.near_chunk(500))
        cases.push(c.build())
    }
    // Checkerboards: the chunks around have the carvers of different biomes.
    var everywhere = OVERWORLD.to_list()
    everywhere.extend(NETHER.to_list())
    everywhere.extend(["the_end", "small_end_islands"])
    for i in 0..6 {
        let count = g.between(2, 5)
        var biomes: List<str> = []
        for _ in 0..count {
            biomes.push(g.pick(everywhere))
        }
        let seed = g.seed()
        let scale = g.between(0, 3)
        var c = start("checkerboard-{i}", seed, "overworld", (-64, 384), checkerboard(biomes, scale), none, none)
        c.carve(g.near_chunk(2000))
        c.carve(g.near_chunk(2000))
        cases.push(c.build())
    }

    // Carvers written out, over the Overworld's terrain and others.
    for i in 0..48 {
        let settings = g.pick(["overworld", "overworld", "overworld", "amplified", "nether", "caves", "end", "floating_islands"])
        let (min_y, height, preset_name) = world_of(settings)
        let source = if g.chance(2) { preset(preset_name) } else { fixed(g.pick(OVERWORLD.to_list())) }
        let seed = g.seed()
        var c = start("written-{i}", seed, settings, (min_y, height), source, some(written(mut g)), none)
        c.carve(g.near_chunk(1000))
        cases.push(c.build())
    }
    // Vanilla's carvers on their own and together.
    for name in CARVERS {
        var c = start("carver-{name}", g.seed(), "overworld", (-64, 384), preset("overworld"), some(strs([m(name)])), none)
        c.carve(g.near_chunk(1000))
        c.carve(g.near_chunk(1000))
        cases.push(c.build())
    }
    var single = start(String("carver-single"), g.seed(), "overworld", (-64, 384), preset("overworld"), some(s(m("canyon"))), none)
    single.carve(g.near_chunk(1000))
    cases.push(single.build())
    let single_seed = g.seed()
    var single_written = start(String("carver-single-written"), single_seed, "overworld", (-64, 384), preset("overworld"), some(with(canyon(mut g), "probability", float(1.0))), none)
    single_written.carve(g.near_chunk(1000))
    cases.push(single_written.build())
    var no_carvers = start(String("carver-none"), g.seed(), "overworld", (-64, 384), preset("overworld"), some(arr([])), none)
    no_carvers.carve(g.near_chunk(1000))
    cases.push(no_carvers.build())
    var repeated = start(String("carver-repeated"), g.seed(), "overworld", (-64, 384), preset("overworld"), some(strs([m("cave"), m("cave"), m("canyon"), m("cave")])), none)
    repeated.carve(g.near_chunk(1000))
    cases.push(repeated.build())
    let mixed_seed = g.seed()
    let mixed_cave = with(cave(mut g), "probability", float(0.5))
    var mixed = start(String("carver-mixed"), mixed_seed, "overworld", (-64, 384), preset("overworld"), some(arr([s(m("canyon")), mixed_cave, s("cave")])), none)
    mixed.carve(g.near_chunk(1000))
    cases.push(mixed.build())
    // Many caves near the surface: grass cut to dirt, and the dirt's top material.
    for i in 0..6 {
        let base = with(with(cave(mut g), "probability", float(1.0)), "y", uniform(#"{"absolute":55}"#, #"{"absolute":110}"#))
        let shallow = with(base, "count", n(g.between(1, 3)))
        let seed = g.seed()
        let biome = g.pick(["plains", "mushroom_fields", "snowy_slopes", "swamp", "badlands", "frozen_ocean"])
        var c = start("shallow-{i}", seed, "overworld", (-64, 384), fixed(biome), some(arr([shallow])), none)
        c.carve(g.near_chunk(1000))
        cases.push(c.build())
    }
    // Rooms and splits: thick tunnels split, rooms of every height.
    for i in 0..4 {
        let thick = with(with(with(with(cave(mut g), "probability", float(1.0)), "count", n(1)), "thickness", j(#"{"type":"minecraft:uniform","min_inclusive":1.5,"max_exclusive":6.0}"#)), "weird_thickness_bias", b(true))
        var c = start("thick-{i}", g.seed(), "overworld", (-64, 384), preset("overworld"), some(arr([thick])), none)
        c.carve(g.near_chunk(1000))
        cases.push(c.build())
    }
    // Canyons always, through land, sea and the bottom of the world.
    for i in 0..4 {
        let deep = with(canyon(mut g), "probability", float(1.0))
        let settings = if i % 2 == 0 { "overworld" } else { "nether" }
        let (min_y, height, source) = world_of(settings)
        var c = start("canyon-{i}", g.seed(), settings, (min_y, height), preset(source), some(arr([deep])), none)
        c.carve(g.near_chunk(1000))
        cases.push(c.build())
    }
    // The bottom and top of the generated world: bedrock isn't carved, the top 7 blocks never.
    let bottom = with(with(with(cave(mut g), "probability", float(1.0)), "count", n(2)), "y", uniform(#"{"above_bottom":-4}"#, #"{"above_bottom":6}"#))
    let top = with(with(with(cave(mut g), "probability", float(1.0)), "count", n(2)), "y", uniform(#"{"below_top":6}"#, #"{"below_top":-4}"#))
    for (name, cv) in [("bottom", bottom), ("top", top)] {
        for settings in ["overworld", "nether"] {
            let (min_y, height, source) = world_of(settings)
            var c = start("edge-{name}-{settings}", g.seed(), settings, (min_y, height), preset(source), some(arr([cv.copy()])), none)
            c.carve(g.near_chunk(300))
            cases.push(c.build())
        }
    }

    // Rules written out for the top material.
    let rules: List<(str, Json)> = [
        ("all-glass", j(#"{"type":"minecraft:block","result_state":"minecraft:glass"}"#)),
        ("all-water", j(#"{"type":"minecraft:block","result_state":"minecraft:water"}"#)),
        ("empty", j(#"{"type":"minecraft:sequence","sequence":[]}"#)),
        ("water-condition", j(#"{"type":"minecraft:condition","if_true":{"type":"minecraft:water","offset":0,"surface_depth_multiplier":0,"add_stone_depth":false},"then_run":{"type":"minecraft:block","result_state":"minecraft:mycelium"}}"#)),
        ("pickles", j(#"{"type":"minecraft:block","result_state":#{PICKLES}}"#)),
    ]
    for (name, r) in rules {
        let shallow = with(with(with(cave(mut g), "probability", float(1.0)), "y", uniform(#"{"absolute":58}"#, #"{"absolute":100}"#)), "count", n(2))
        var c = start("rule-{name}", g.seed(), "overworld", (-64, 384), fixed("plains"), some(arr([shallow])), some(r.copy()))
        c.carve(g.near_chunk(500))
        cases.push(c.build())
    }
    var overworld_rule = start(String("rule-overworld-in-nether"), g.seed(), "nether", (0, 256), fixed("plains"), none, some(s(m("overworld"))))
    overworld_rule.carve(g.near_chunk(300))
    cases.push(overworld_rule.build())

    // Worlds that aren't the noise's: taller, shorter, overlapping its top or bottom, or past it.
    let levels: List<(str, i64, i64)> = [("tall", -128, 512), ("short", 0, 128), ("one-section", -64, 16), ("top-section", 304, 16), ("above", 320, 64), ("low", -512, 448), ("partial", -32, 48)]
    for (name, min_y, height) in levels {
        for settings in ["overworld", "nether"] {
            let (_, _, source) = world_of(settings)
            var c = start("level-{name}-{settings}", g.seed(), settings, (min_y, height), preset(source), none, none)
            c.carve(g.near_chunk(64))
            cases.push(c.build())
        }
    }
    for settings in ["end", "nether"] {
        let (_, _, source) = world_of(settings)
        let seed = g.seed()
        let partial = with(with(with(cave(mut g), "probability", float(1.0)), "count", n(3)), "y", j(#"{"absolute":0}"#))
        var c = start("level-partial-written-{settings}", seed, settings, (-32, 48), preset(source), some(arr([partial])), none)
        c.carve(g.near_chunk(64))
        cases.push(c.build())
    }

    // The ends of `int`, where blocks and quarts wrap.
    for (i, chunk) in [(134217727i64, 134217727i64), (-134217728, -134217728), (134217723, -134217725)].enumerate() {
        let seed = g.seed()
        let source = if i < 2 { preset("overworld") } else { fixed("plains") }
        var carvers: Json? = none
        if i >= 2 {
            carvers = some(arr([with(with(cave(mut g), "probability", float(1.0)), "count", n(2))]))
        }
        var c = start("int-edge-{i}", seed, "overworld", (-64, 384), source, carvers, none)
        c.carve(chunk)
        cases.push(c.build())
    }

    // Carvers that throw: a count whose bound wraps past an int.
    var g5 = gen(5)
    var g6 = gen(6)
    var g7 = gen(7)
    let wrapping = with(with(cave(mut g5), "probability", float(1.0)), "count", uniform("0", "2147483647"))
    var throws = start(String("throws-count-bound"), String("0"), "overworld", (-64, 384), preset("overworld"), some(arr([wrapping])), none)
    throws.carve((0, 0))
    cases.push(throws.build())
    let wrapping_height = with(with(with(cave(mut g6), "probability", float(1.0)), "count", n(1)), "y", uniform(#"{"absolute":-2032}"#, #"{"absolute":2031}"#))
    var wide = start(String("height-wide"), String("0"), "overworld", (-64, 384), preset("overworld"), some(arr([wrapping_height])), none)
    wide.carve((0, 0))
    cases.push(wide.build())
    let empty_height = with(with(with(cave(mut g7), "probability", float(1.0)), "count", n(1)), "y", uniform(#"{"absolute":100}"#, #"{"absolute":20}"#))
    var empty = start(String("height-empty"), String("0"), "overworld", (-64, 384), preset("overworld"), some(arr([empty_height])), none)
    empty.carve((0, 0))
    cases.push(empty.build())

    // Carvers vanilla doesn't read.
    for (name, cv) in invalid_carvers() {
        var c = start("invalid-carvers-{name}", String("0"), "overworld", (-64, 384), preset("overworld"), some(cv.copy()), none)
        c.carve((0, 0))
        cases.push(c.build())
    }
    var rule_first = start(String("invalid-rule-first"), String("0"), "overworld", (-64, 384), preset("overworld"), some(strs([String("minecraft:nowhere")])), some(s("minecraft:nowhere")))
    rule_first.carve((0, 0))
    cases.push(rule_first.build())

    write_file(file("carvers", "generated.json"), String("carvers"), "cases/carvers/gen.calx, seed {SEED}", cases, 1)
}
