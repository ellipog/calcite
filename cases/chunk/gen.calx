module cases.chunk.gen

// Writes cases/chunk/generated.json: chunks with blocks set as LevelChunk.setBlockState sets them,
// their sections' counts and bytes, and their heightmaps kept, updated and primed.
//
//     calx cases/chunk/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the same
// file.
//
// The states are 26.3's, picked for what each heightmap and count makes of them: air, cave air and
// void air, which are all air but only the first is skipped when heightmaps are primed; full
// blocks; leaves, which one motion-blocking heightmap leaves out; water and lava, and blocks
// waterlogged or holding water as kelp does, which count as fluids; blocks that take random ticks;
// and ones nothing stands on, as torches and grass. The cases build the flat world, stack and
// clear columns of them, tell the generation heightmaps of states as the flat generator does, set
// thousands at random until a section's palette holds every kind, and prime every heightmap, in
// dimensions from one section high to the most a dimension has.

import std.json.{Json}
import cases.kit.{arr, case, file, ints, n, obj, s}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}

const SEED: u64 = 20261030
const STATES: i64 = 35723

const AIR: i64 = 0
const STONE: i64 = 1
const GRASS_BLOCK: i64 = 9
const DIRT: i64 = 10
const BEDROCK: i64 = 88
const CAVE_AIR: i64 = 18650
const VOID_AIR: i64 = 18649
const WATER: i64 = 89
const WATER_FLOWING: i64 = 90
const LAVA: i64 = 105
const OAK_LEAVES: i64 = 267
const OAK_LEAVES_DEFAULT: i64 = 294
const GLASS: i64 = 661
const SHORT_GRASS: i64 = 2363
const TORCH: i64 = 4926
const COBWEB: i64 = 2362
const SEAGRASS: i64 = 2370
const OAK_SLAB_FIRST: i64 = 15177 // top, bottom and double, each waterlogged and not
const KELP: i64 = 18419
const BUBBLE_COLUMN: i64 = 18651
const OAK_FENCE: i64 = 8666
const SUGAR_CANE: i64 = 8617
const SNOW: i64 = 8589
const OAK_SAPLING: i64 = 30
const CHEST: i64 = 5544
const LADDER: i64 = 7308
const POWDER_SNOW: i64 = 30519
const SCAFFOLDING: i64 = 24094
const OAK_TRAPDOOR: i64 = 8799
const WHEAT: i64 = 6867
const FIRE: i64 = 4962

const KEPT: [i64; 4] = [1, 3, 4, 5]

/// A dimension's lowest Y and its height in sections.
struct Dimension {
    min_y: i64,
    sections: i64,
}

const OVERWORLD: Dimension = Dimension { min_y: -64, sections: 24 }

/// A state of each kind, for random sets.
fn pool() -> List<i64> {
    var out: List<i64> = [AIR, AIR, AIR, CAVE_AIR, VOID_AIR, STONE, GRASS_BLOCK, DIRT, BEDROCK, WATER, WATER_FLOWING, LAVA, LAVA + 3, OAK_LEAVES, OAK_LEAVES_DEFAULT, GLASS, SHORT_GRASS, TORCH, COBWEB, SEAGRASS]
    for state in OAK_SLAB_FIRST..OAK_SLAB_FIRST + 6 {
        out.push(state)
    }
    out.extend([KELP, KELP + 25, BUBBLE_COLUMN, OAK_FENCE, SUGAR_CANE, SNOW, SNOW + 7, OAK_SAPLING, CHEST, CHEST + 1, LADDER, LADDER + 1, POWDER_SNOW, SCAFFOLDING, OAK_TRAPDOOR, WHEAT, WHEAT + 7, FIRE])
    return out
}

struct Gen {
    r: SplitMix64
}

impl Gen {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    /// A long for the probe's LCG, as a string.
    fn seed(mut self) -> Json {
        return s("{i64.wrap(self.r.next())}")
    }
}

/// An op of integers: `[name, values...]`.
fn op(name: str, values: List<i64>) -> Json {
    var parts: List<Json> = [s(String(name))]
    for v in values {
        parts.push(n(v))
    }
    return arr(parts)
}

fn prime_all() -> Json {
    return arr([s("prime"), ints([0, 1, 2, 3, 4, 5])])
}

fn look() -> List<Json> {
    var out: List<Json> = []
    for k in 0..6i64 {
        out.push(op("heightmap", [k]))
    }
    out.extend([op("counts", []), op("highest", []), op("write", [])])
    return out
}

fn random_sets(seed: own Json, count: i64, states: List<i64>, low: i64, high: i64) -> Json {
    return arr([s("random_sets"), seed, n(count), ints(states), n(low), n(high)])
}

fn chunk_case(name: str, d: Dimension, ops: own List<Json>) -> Json {
    return case(String(name), obj([(String("min_y"), n(d.min_y)), (String("sections"), n(d.sections)), (String("ops"), arr(ops))]))
}

fn flat() -> Json {
    var ops: List<Json> = []
    for (y, state) in [BEDROCK, DIRT, DIRT, GRASS_BLOCK].enumerate() {
        let at = -64 + i64.wrap(y)
        ops.push(op("fill", [0, at, 0, 15, at, 15, state]))
    }
    ops.extend(look())
    ops.extend([op("recount", []), op("counts", [])])
    return chunk_case("flat", OVERWORLD, ops)
}

/// What setBlockState leaves alone: air in a section of only air, and a state already there.
fn no_change() -> Json {
    var ops: List<Json> = []
    for state in [AIR, CAVE_AIR, CAVE_AIR, STONE, STONE, AIR, AIR] {
        ops.push(op("set", [3, 70, 9, state]))
    }
    ops.push(op("block", [3, 70, 9]))
    ops.extend(look())
    return chunk_case("no-change", OVERWORLD, ops)
}

/// One column stacked with a state of each kind, then cleared from the top down, and the rest
/// from the bottom up, looking at the heightmaps after each.
fn column() -> Json {
    let stack: List<i64> = [STONE, OAK_LEAVES_DEFAULT, WATER, GLASS, TORCH, OAK_SLAB_FIRST + 1, CAVE_AIR, COBWEB, KELP, OAK_LEAVES, SHORT_GRASS, LAVA, SNOW, STONE, VOID_AIR, OAK_FENCE]
    var kept: List<Json> = []
    for k in KEPT {
        kept.push(op("heightmap", [k]))
    }
    var ops: List<Json> = []
    for (i, state) in stack.enumerate() {
        ops.push(op("set", [5, 10 + i64.wrap(i), 12, state]))
        ops.extend(kept.copy())
    }
    var i = i64.wrap(stack.len()) - 1
    while i >= 8 {
        ops.push(op("set", [5, 10 + i, 12, AIR]))
        ops.extend(kept.copy())
        i -= 1
    }
    for j in 0..8i64 {
        ops.push(op("set", [5, 10 + j, 12, AIR]))
        ops.extend(kept.copy())
    }
    ops.extend(look())
    return chunk_case("column", OVERWORLD, ops)
}

/// The generation heightmaps told of each state as the flat generator tells them, in layers with
/// gaps, then primed again, which a column of cave air under the top doesn't stop.
fn generation() -> Json {
    let layers: List<(i64, i64)> = [(-64, BEDROCK), (-63, STONE), (-61, WATER), (-60, OAK_LEAVES_DEFAULT), (-58, CAVE_AIR), (-56, TORCH)]
    var ops: List<Json> = []
    for (y, state) in layers {
        for x in 0..16i64 {
            for z in 0..16i64 {
                ops.push(op("set", [x, y, z, state]))
                ops.push(op("update", [2, x, y, z, state]))
                ops.push(op("update", [0, x, y, z, state]))
            }
        }
    }
    ops.extend([op("heightmap", [0]), op("heightmap", [2]), prime_all()])
    ops.extend(look())
    return chunk_case("generation", OVERWORLD, ops)
}

/// `update` on its own, for states that weren't set: below the top, at it, and just over it.
fn updates(g: mut Gen) -> Json {
    let states = pool()
    var ops: List<Json> = [op("fill", [0, 0, 0, 15, 3, 15, STONE])]
    for _ in 0..300 {
        let kind = g.below(6)
        let x = g.below(16)
        let z = g.below(16)
        let y = g.below(10) - 2
        let state = states[usize.wrap(g.below(i64.wrap(states.len())))]
        ops.push(op("update", [kind, x, y, z, state]))
    }
    ops.extend(look())
    return chunk_case("updates", OVERWORLD, ops)
}

/// Random sets of the pool, over a few sections and then the whole height, growing the palettes,
/// then the whole range of states, so a section holds more than 256.
fn randoms(g: mut Gen) -> List<Json> {
    // Python built the whole table before the loop, so these draws come first.
    var picked: List<i64> = []
    for _ in 0..600 {
        picked.push(g.below(STATES))
    }
    picked.extend([AIR, WATER, LAVA])
    picked.sort()
    var distinct: List<i64> = []
    for state in picked {
        if distinct.len() == 0 or distinct[distinct.len() - 1] != state {
            distinct.push(state)
        }
    }
    let table: List<(str, Dimension, i64, i64, i64, List<i64>)> = [
        ("random-low", OVERWORLD, -64, -33, 6000, pool()),
        ("random-high", OVERWORLD, 250, 319, 3000, pool()),
        ("random-all", OVERWORLD, -64, 319, 30000, pool()),
        ("random-states", OVERWORLD, 0, 15, 4000, distinct),
        ("random-nether", Dimension { min_y: 0, sections: 16 }, 0, 255, 20000, pool()),
        ("random-one-section", Dimension { min_y: 16, sections: 1 }, 16, 31, 3000, pool()),
        ("random-tall", Dimension { min_y: -2032, sections: 254 }, -2032, 2031, 20000, pool()),
    ]
    var out: List<Json> = []
    for (name, d, low, high, count, states) in table {
        var ops: List<Json> = [random_sets(g.seed(), count, states, low, high)]
        ops.extend(look())
        ops.push(random_sets(g.seed(), count / 3, [AIR, CAVE_AIR, VOID_AIR], low, high))
        ops.extend(look())
        ops.push(prime_all())
        ops.extend(look())
        ops.extend([op("recount", []), op("counts", [])])
        out.push(chunk_case(name, d, ops))
    }
    return out
}

/// Sections filled and emptied again, so the highest section and the heightmaps fall.
fn cleared(g: mut Gen) -> Json {
    var ops: List<Json> = [op("fill", [0, 100, 0, 15, 140, 15, OAK_LEAVES_DEFAULT]), op("fill", [0, 0, 0, 15, 2, 15, WATER])]
    ops.extend(look())
    ops.push(op("fill", [0, 100, 0, 15, 140, 15, CAVE_AIR]))
    ops.extend(look())
    ops.push(random_sets(g.seed(), 2000, [STONE, AIR, KELP], 60, 75))
    ops.push(op("fill", [0, 0, 0, 15, 2, 15, AIR]))
    ops.extend(look())
    ops.push(prime_all())
    ops.extend(look())
    return chunk_case("cleared", OVERWORLD, ops)
}

pub fn main() {
    var g = Gen { r: splitmix64(SEED) }
    var cases: List<Json> = [flat(), no_change(), column(), generation(), updates(mut g)]
    cases.extend(randoms(mut g))
    cases.push(cleared(mut g))
    write_file(file("chunk", "generated.json"), String("chunk"), "cases/chunk/gen.calx, seed {SEED}", cases, 1)
}
