module cases.rng.gen

// Writes cases/rng/generated.json: random operation sequences on every kind of source.
//
//     calx cases/rng/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the same
// file. Each draw is a statement of its own, in the order the Python generator drew them.

import std.json.{Json}
import std.text.python.{repr_float}
import cases.kit.{arr, case, file, n, obj, s}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}

const SEED: u64 = 20261027
const CASES_PER_KIND: i64 = 25
const OPS_PER_CASE: i64 = 100
const KINDS: [str; 6] = ["legacy", "single_threaded", "xoroshiro", "xoroshiro128", "worldgen_legacy", "worldgen_xoroshiro"]

struct Gen {
    r: SplitMix64
}

impl Gen {
    fn u64(mut self) -> u64 {
        return self.r.next()
    }

    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn i32(mut self, lo: i64, hi: i64) -> i64 {
        return lo + self.below(hi - lo + 1)
    }

    /// Mostly random 64-bit seeds, sometimes small ones, as worlds often use.
    fn seed(mut self) -> Json {
        if self.below(4) != 0 {
            return s("{i64.wrap(self.u64())}")
        }
        return s("{self.i32(-1000, 1000)}")
    }

    /// Powers of two take a different path in nextInt(bound), so weight them.
    fn bound(mut self) -> i64 {
        let pick = self.below(4)
        if pick == 0 {
            return 1i64 << self.below(31)
        }
        if pick == 1 {
            return self.i32(1, 64)
        }
        return self.i32(1, (1i64 << 31) - 1)
    }

    fn coord(mut self) -> i64 {
        return self.i32(-30000000, 30000000)
    }
}

fn named(name: str) -> Json {
    return s(String(name))
}

fn op(g: mut Gen, worldgen: bool) -> Json {
    var choices: List<str> = ["nextInt", "nextIntBound", "nextIntRange", "nextIntBetween", "nextLong", "nextBoolean", "nextFloat", "nextDouble", "nextGaussian", "triangle", "consume"]
    if worldgen {
        choices.extend(["setDecorationSeed", "setFeatureSeed", "setLargeFeatureSeed", "setLargeFeatureWithSalt"])
    }
    let name = choices[usize.wrap(g.below(i64.wrap(choices.len())))]
    if name == "nextIntBound" {
        return arr([named("nextInt"), n(g.bound())])
    }
    if name == "nextIntRange" {
        let lo = g.i32(-(1i64 << 30), 1i64 << 30)
        return arr([named("nextIntRange"), n(lo), n(lo + g.i32(1, 1i64 << 30))])
    }
    if name == "nextIntBetween" {
        let lo = g.i32(-(1i64 << 30), 1i64 << 30)
        return arr([named("nextIntBetween"), n(lo), n(lo + g.i32(0, 1i64 << 30))])
    }
    if name == "triangle" {
        let mode = f64.nearest(g.i32(-1000, 1000)) / 8.0
        let deviation = f64.nearest(g.i32(0, 1000)) / 16.0
        return arr([named("triangle"), s(repr_float(mode)), s(repr_float(deviation))])
    }
    if name == "consume" {
        return arr([named("consume"), n(g.i32(0, 50))])
    }
    if name == "setDecorationSeed" or name == "setLargeFeatureSeed" {
        let seed = g.seed()
        let x = g.i32(-1875000, 1875000)
        let z = g.i32(-1875000, 1875000)
        return arr([named(name), seed, n(x), n(z)])
    }
    if name == "setFeatureSeed" {
        let seed = g.seed()
        let index = g.i32(0, 200)
        let step = g.i32(0, 11)
        return arr([named(name), seed, n(index), n(step)])
    }
    if name == "setLargeFeatureWithSalt" {
        let seed = g.seed()
        let x = g.i32(-60000, 60000)
        let z = g.i32(-60000, 60000)
        let salt = g.i32(-(1i64 << 31), (1i64 << 31) - 1)
        return arr([named(name), seed, n(x), n(z), n(salt)])
    }
    return arr([named(name)])
}

pub fn main() {
    var g = Gen { r: splitmix64(SEED) }
    var cases: List<Json> = []
    for kind in KINDS {
        let worldgen = kind.starts_with("worldgen")
        for number in 0..CASES_PER_KIND {
            var input: List<(String, Json)> = [(String("kind"), named(kind))]
            if kind == "xoroshiro128" {
                let lo = i64.wrap(g.u64())
                let hi = i64.wrap(g.u64())
                input.push((String("seed_lo"), s("{lo}")))
                input.push((String("seed_hi"), s("{hi}")))
            } else {
                input.push((String("seed"), g.seed()))
            }
            var ops: List<Json> = []
            for _ in 0..OPS_PER_CASE {
                ops.push(op(mut g, worldgen))
            }
            // End most cases with a fork into a positional source, so those paths are covered too.
            if not worldgen {
                if g.below(3) == 0 {
                    let x = g.coord()
                    let y = g.i32(-64, 319)
                    let z = g.coord()
                    ops.push(arr([named("at"), n(x), n(y), n(z)]))
                    ops.push(arr([named("nextLong")]))
                    ops.push(arr([named("nextInt"), n(g.bound())]))
                } else if g.below(2) == 0 {
                    ops.push(arr([named("fork")]))
                    ops.push(arr([named("nextLong")]))
                    ops.push(arr([named("nextDouble")]))
                }
            }
            input.push((String("ops"), arr(ops)))
            cases.push(case("{kind.replace("_", "-")}-{number:02}", obj(input)))
        }
    }
    write_file(file("rng", "generated.json"), String("rng"), "cases/rng/gen.calx, seed {SEED}", cases, 1)
}
