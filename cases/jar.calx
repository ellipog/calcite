module cases.jar

// Vanilla's data for the generators that name it: the server jar bundled in the pinned jar,
// oracle/jars/server-26.3.jar, which `calx oracle/fetch.calx` fetches. The generator tests skip
// the generators that read it where it hasn't been fetched.

import std.fs.{read}
import std.json
import std.json.{Json}
import std.zip.{Zip}
import tools.repo.{die, under}

const JAR: str = "oracle/jars/server-26.3.jar"
const INNER: str = "META-INF/versions/26.3/server-26.3.jar"

/// The server jar bundled in the pinned one.
pub fn vanilla() -> Zip {
    let path = under(String(JAR))
    let bytes = match read(path.copy()) {
        ok(b) => b,
        err(e) => die("couldn't read {path}: {e}; run `calx oracle/fetch.calx` first"),
    }
    let outer = match Zip.open(bytes) {
        ok(z) => z,
        err(e) => die("{path}: {e}"),
    }
    let inner = match outer.read_named(String(INNER)) {
        ok(b) => b,
        err(e) => die("{path}: {INNER}: {e}"),
    }
    return match Zip.open(inner) {
        ok(z) => z,
        err(e) => die("{path}: {INNER}: {e}"),
    }
}

/// What the entry at `name` holds, as text.
pub fn text(z: Zip, name: String) -> String {
    let bytes = match z.read_named(name.copy()) {
        ok(b) => b,
        err(e) => die("{INNER}: {name}: {e}"),
    }
    let decoded = String.from_utf8(bytes) else die("{INNER}: {name} isn't UTF-8")
    return decoded
}

/// The JSON in the entry at `name`.
pub fn json_at(z: Zip, name: String) -> Json {
    return match json.parse(text(z, name.copy())) {
        ok(v) => v,
        err(e) => die("{INNER}: {name}: {e}"),
    }
}

/// The names of the entries under `prefix` that end with `suffix`, in Python's sorted order.
pub fn names(z: Zip, prefix: str, suffix: str) -> List<String> {
    var out: List<String> = []
    for i in 0..z.len() {
        let name = z.name(i)
        if name.starts_with(prefix) and name.ends_with(suffix) {
            out.push(name)
        }
    }
    out.sort()
    return out
}

/// Each `.json` file under `prefix`, by its name without the prefix and `.json`, in name order.
pub fn json_files(z: Zip, prefix: str) -> List<(String, Json)> {
    var out: List<(String, Json)> = []
    for name in names(z, prefix, ".json") {
        let short = name[prefix.len()..name.len() - 5]
        out.push((short, json_at(z, name.copy())))
    }
    return out
}
