module cases.levels.gen

// Writes cases/levels/generated.json: random operations on a chunk tracker's graph of levels, as
// each of vanilla's trackers has it, and as none does.
//
//     calx cases/levels/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the same
// file.
//
// Each case gives the graph's level count, the level of a chunk with none, the level from which a
// set level is taken out, and the source level of a chunk with no source, as the loading, the
// simulation, the natural spawn and the player ticket trackers have them, or at random. Its
// operations change chunks' sources and tell the graph, as ticket storage and players coming and
// going do, run the updates, all at once or a few at a time, and dump the levels. The `random`
// cases also tell the graph what doesn't match the sources, and the `desync` cases change levels
// behind the graph's back, as a chunk holder's removal does to the loading tracker, which can
// leave a chunk queued twice, so their runs are bounded. The `edge` cases are next to the chunk
// vanilla takes as the source, and where `x` and `z` wrap around.
//
// The draws are in the order the Python generator made them: a list's items before the pick
// among them, a conditional's test before its branch, and `and`'s right side only when its left
// holds.

import std.json.{Json}
import cases.kit.{arr, b, case, file, n, obj, s}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}

const SEED: u64 = 20261101
const INT_MAX: i64 = 2147483647
const INT_MIN: i64 = -2147483648
const SOURCE: i64 = 1875066

/// A tracker's levels: its count, the level of a chunk with none, the level from which a set
/// level is taken out, and the source level of a chunk with no source.
struct Config {
    level_count: i64,
    unset: i64,
    keep_below: i64,
    no_source: i64,
}

impl Config {
    fn same(self, other: Config) -> bool {
        return self.level_count == other.level_count and self.unset == other.unset and self.keep_below == other.keep_below and self.no_source == other.no_source
    }
}

const LOADING: Config = Config { level_count: 46, unset: 45, keep_below: 45, no_source: 45 }
const SIMULATION: Config = Config { level_count: 34, unset: 33, keep_below: 33, no_source: 45 }
const SPAWN: Config = Config { level_count: 10, unset: 10, keep_below: 9, no_source: INT_MAX }
const PLAYER: Config = Config { level_count: 34, unset: 34, keep_below: 33, no_source: INT_MAX }

struct Rng {
    r: SplitMix64
}

impl Rng {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn chance(mut self, p: f64) -> bool {
        return self.below(1i64 << 20) < i64.saturate(p * 1048576.0)
    }

    fn pick(mut self, items: List<i64>) -> i64 {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    fn pick_str(mut self, items: List<str>) -> str {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }
}

/// `size` chunks: in a small square, spread out, by the source chunk, or where `x` and `z` wrap.
fn pool(rng: mut Rng, size: i64, style: str) -> List<(i64, i64)> {
    var out: List<(i64, i64)> = []
    var span = rng.pick([3, 6, 12, 30])
    while span * span < size * 2 {
        span += 1
    }
    while i64.wrap(out.len()) < size {
        var x = 0i64
        var z = 0i64
        if style == "near" {
            x = rng.below(span) - span / 2
            z = rng.below(span) - span / 2
        } else if style == "spread" {
            x = rng.below(3749999) - 1874999
            z = rng.below(3749999) - 1874999
        } else if style == "source" {
            x = SOURCE - 4 + rng.below(9)
            z = SOURCE - 4 + rng.below(9)
        } else {
            x = wrapped(mut rng)
            z = wrapped(mut rng)
        }
        if not out.any(|c| c.0 == x and c.1 == z) {
            out.push((x, z))
        }
    }
    return out
}

/// A coordinate by either end of `int`, or by 0.
fn wrapped(rng: mut Rng) -> i64 {
    let high = INT_MAX - rng.below(3)
    let low = INT_MIN + rng.below(3)
    let middle = rng.below(5) - 2
    return rng.pick([high, low, middle])
}

/// A ticket's level, mostly those vanilla's tickets have.
fn ticket_level(rng: mut Rng) -> i64 {
    let r = rng.below(100)
    if r < 30 {
        return 31
    }
    if r < 45 {
        return 33
    }
    if r < 85 {
        return 34 + rng.below(11)
    }
    if r < 90 {
        return 22 + rng.below(9)
    }
    return rng.below(46)
}

/// Any level, or past either end, mostly near the top, so a source reaches a few chunks.
fn any_level(rng: mut Rng, count: i64) -> i64 {
    let r = rng.below(100)
    if r < 5 {
        return rng.pick([INT_MAX, INT_MIN, -1])
    }
    if r < 15 {
        return count + rng.below(4)
    }
    if r < 25 {
        return rng.below(count)
    }
    let reach = if count < 9 { count } else { 9 }
    return count - 1 - rng.below(reach)
}

fn op(name: str, values: List<i64>) -> Json {
    var parts: List<Json> = [s(String(name))]
    for v in values {
        parts.push(n(v))
    }
    return arr(parts)
}

/// `count` operations on `chunks`, sources coming and going as `kind` has them: `ticket` levels,
/// `player` levels of 0, or `any`, which also tells the graph what doesn't match.
fn ops_for(rng: mut Rng, config: Config, chunks: List<(i64, i64)>, count: i64, kind: str) -> List<Json> {
    var sources: Map<(i64, i64), i64> = Map()
    var ops: List<Json> = []
    let bounded = kind == "desync"
    for _ in 0..count {
        let r = rng.below(1000)
        let (x, z) = chunks[usize.wrap(rng.below(i64.wrap(chunks.len())))]
        let old = sources.get((x, z)) ?? config.no_source
        if r < 450 {
            // A source comes, goes or changes, and the graph is told as vanilla tells it.
            var new = 0i64
            if kind == "player" {
                new = if sources.contains((x, z)) { config.no_source } else { 0 }
            } else {
                var gone = false
                if sources.contains((x, z)) {
                    gone = rng.chance(0.4)
                }
                if gone {
                    new = config.no_source
                } else if kind == "ticket" {
                    new = ticket_level(mut rng)
                } else {
                    new = any_level(mut rng, config.level_count)
                }
            }
            if new == config.no_source {
                _ = sources.remove((x, z))
                ops.push(op("unsource", [x, z]))
            } else {
                sources.insert((x, z), new)
                ops.push(op("source", [x, z, new]))
            }
            if new != old {
                ops.push(arr([s("update"), n(x), n(z), n(new), b(new < old)]))
            }
        } else if r < 520 and (kind == "any" or kind == "desync") {
            // The graph told something the sources don't say.
            let level = any_level(mut rng, config.level_count)
            let decreasing = rng.chance(0.5)
            ops.push(arr([s("update"), n(x), n(z), n(level), b(decreasing)]))
        } else if r < 560 and kind == "desync" {
            ops.push(op("set", [x, z, any_level(mut rng, config.level_count)]))
        } else if r < 900 {
            var some_steps = bounded
            if not some_steps {
                some_steps = rng.chance(0.15)
            }
            if some_steps {
                let most = rng.pick([5, 60, 800, 3000])
                ops.push(op("run", [1 + rng.below(most)]))
            } else {
                ops.push(op("run", [INT_MAX]))
            }
        } else if r < 940 {
            ops.push(op("dump", []))
        }
    }
    if bounded {
        ops.push(op("run", [4000]))
    } else {
        ops.push(op("run", [INT_MAX]))
    }
    ops.push(op("dump", []))
    return ops
}

fn levels_case(rng: mut Rng, name: own String, config: Config, kind: str, style: str, sizes: List<i64>, counts: List<i64>) -> Json {
    let size = rng.pick(sizes)
    let chunks = pool(mut rng, size, style)
    let count = rng.pick(counts)
    let ops = ops_for(mut rng, config, chunks, count, kind)
    return case(name, obj([(String("level_count"), n(config.level_count)), (String("unset"), n(config.unset)), (String("keep_below"), n(config.keep_below)), (String("no_source"), n(config.no_source)), (String("ops"), arr(ops))]))
}

fn random_config(rng: mut Rng) -> Config {
    let most = rng.pick([8, 30, 60])
    let count = 2 + rng.below(most)
    let unset = count - 2 + rng.below(5)
    let keep_below = 1 + rng.below(count + 1)
    let no_source = rng.pick([count - 1, count, count + 3, INT_MAX, 45])
    return Config { level_count: count, unset: unset, keep_below: keep_below, no_source: no_source }
}

/// One of `configs`, picked as Python's `rng.pick` picks from a list.
fn pick_config(rng: mut Rng, configs: List<Config>) -> Config {
    return configs[usize.wrap(rng.below(i64.wrap(configs.len())))]
}

pub fn main() {
    var rng = Rng { r: splitmix64(SEED) }
    var cases: List<Json> = []
    for i in 0..60 {
        let style = rng.pick_str(["near", "near", "near", "spread"])
        cases.push(levels_case(mut rng, "loading-{i}", LOADING, "ticket", style, [1, 3, 8, 20], [10, 30, 80]))
    }
    for i in 0..40 {
        cases.push(levels_case(mut rng, "simulation-{i}", SIMULATION, "ticket", "near", [1, 3, 8, 20], [10, 30, 80]))
    }
    for i in 0..40 {
        let style = rng.pick_str(["near", "spread"])
        cases.push(levels_case(mut rng, "spawn-{i}", SPAWN, "player", style, [1, 2, 5, 12], [10, 30, 80]))
    }
    for i in 0..16 {
        cases.push(levels_case(mut rng, "player-{i}", PLAYER, "player", "near", [1, 2, 4], [4, 8, 16]))
    }
    for i in 0..60 {
        let config = random_config(mut rng)
        cases.push(levels_case(mut rng, "random-{i}", config, "any", "near", [2, 5, 12, 30], [20, 60, 150]))
    }
    for i in 0..30 {
        // The random one is drawn whether it's picked or not, as the Python's list held it.
        let drawn = random_config(mut rng)
        let config = pick_config(mut rng, [LOADING, SIMULATION, SPAWN, drawn])
        cases.push(levels_case(mut rng, "desync-{i}", config, "desync", "near", [2, 5, 12], [20, 60, 120]))
    }
    for i in 0..24 {
        let config = pick_config(mut rng, [LOADING, SIMULATION, SPAWN, PLAYER])
        let kind = if config.same(SPAWN) or config.same(PLAYER) { "player" } else { "ticket" }
        let style = rng.pick_str(["source", "wrap"])
        cases.push(levels_case(mut rng, "edge-{i}", config, kind, style, [1, 3, 8], [10, 30, 60]))
    }
    write_file(file("levels", "generated.json"), String("levels"), "cases/levels/gen.calx, seed {SEED}", cases, 1)
}
