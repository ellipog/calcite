module cases.collections.gen

// Writes cases/collections/generated.json: random operations on every collection, with every key
// type, and the iteration order checked as they go. And cases/collections/removal.json: more of
// fastutil's open tables, with many loops that remove keys with the iterator.
//
//     calx cases/collections/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, and the removal cases with
// REMOVAL_SEED, so rerunning it gives the same files.
//
// Each case alternates phases that mostly add, which grow the table, with phases that mostly
// remove, which shrink fastutil's, and looks at the order every few operations. The keys come from
// one of a few styles: random over a span, a dense run from 0, and keys whose Java hashes collide,
// so HashMap's bins turn into trees. Strings are ASCII, which Java and Calcite order the same.

import std.json.{Json}
import cases.kit.{arr, case, file, n, obj, s}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}

const SEED: u64 = 20261028
const CASES_PER_PAIR: i64 = 6
// A loop that removes with fastutil's iterator goes over a key that a removal moved past the end
// of the table after the rest, and halves the table only in that last part, so it takes many loops
// to see both: in its 240 cases, 152 loops go out of the table's order and 13 halve it.
const REMOVAL_SEED: u64 = 7777031
const REMOVAL_CASES_PER_PAIR: i64 = 40
const KEYS: [str; 3] = ["int", "long", "string"]
const MAPS: [str; 4] = ["hash_map", "linked_hash_map", "tree_map", "open_hash_map"]
const SIZED: [str; 4] = ["hash_map", "hash_set", "open_hash_map", "open_hash_set"]
const WORDS: [str; 20] = ["stone", "dirt", "grass_block", "oak_log", "water", "lava", "sand", "gravel", "iron_ore", "chest", "furnace", "torch", "glass", "wool", "bedrock", "obsidian", "ice", "snow", "cactus", "pumpkin"]

fn collections() -> List<str> {
    return ["hash_map", "linked_hash_map", "tree_map", "open_hash_map", "hash_set", "linked_hash_set", "tree_set", "open_hash_set", "priority_queue", "array_deque"]
}

struct Gen {
    r: SplitMix64
}

impl Gen {
    fn u64(mut self) -> u64 {
        return self.r.next()
    }

    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn chance(mut self, percent: i64) -> bool {
        return self.below(100) < percent
    }
}

/// A case's keys: a style and a span, so most operations hit keys the case has seen.
struct Keys {
    kind: str,
    style: str,
    span: i64,
}

fn keys_of(g: mut Gen, kind: str) -> Keys {
    let styles: [str; 3] = ["random", "dense", "collide"]
    let style = styles[usize.wrap(g.below(3))]
    let span = [8i64, 40, 300, 2000][usize.wrap(g.below(4))]
    return Keys { kind: kind, style: style, span: span }
}

fn key(g: mut Gen, keys: Keys) -> String {
    let at = g.below(keys.span)
    if keys.kind == "int" {
        if keys.style == "dense" {
            return "{at}"
        }
        if keys.style == "collide" {
            // (i << 16) | i: the high and low halves cancel in HashMap's spread, so every key
            // lands in bin 0 of any table under 65,536 bins.
            return "{i32.wrap((at << 16) | at)}"
        }
        if g.chance(20) {
            return "{i32.wrap(g.u64() & 0xFFFFFFFF)}"
        }
        let sign = if g.below(2) == 0 { 1i64 } else { -1 }
        return "{at * sign * 7919}"
    }
    if keys.kind == "long" {
        if keys.style == "dense" {
            return "{at - keys.span / 2}"
        }
        if keys.style == "collide" {
            // (i << 32) | i: Long.hashCode xors the halves, so every one hashes to 0.
            return "{(at << 32) | at}"
        }
        if g.chance(20) {
            return "{i64.wrap(g.u64())}"
        }
        return "{i64.wrap(u64.wrap(at) * 0x9E3779B97F4A7C15)}"
    }
    if keys.style == "dense" {
        return "minecraft:{WORDS[usize.wrap(at % 20)]}_{at / 20}"
    }
    if keys.style == "collide" {
        // "Aa" and "BB" have the same hashCode, so every string of them of one length does.
        var text = String()
        for i in 0..6i64 {
            text.push_str(if (at >> i) & 1 != 0 { "Aa" } else { "BB" })
        }
        return "{text}{at >> 6}"
    }
    return "k{at}"
}

/// Whether `a` comes before `b` or is `b`, in the keys' natural order: numbers by value, ASCII
/// strings by their characters.
fn in_order(kind: str, a: String, b: String) -> bool {
    if kind == "string" {
        return a <= b
    }
    let x = i64.parse(a) ?? 0
    let y = i64.parse(b) ?? 0
    return x <= y
}

/// Two keys for a range, the first not after the second.
fn bounds(g: mut Gen, keys: Keys) -> (String, String) {
    let a = key(mut g, keys)
    let b = key(mut g, keys)
    if in_order(keys.kind, a.copy(), b.copy()) {
        return (a, b)
    }
    return (b, a)
}

fn value(g: mut Gen) -> i64 {
    return g.below(2000) - 1000
}

fn act(name: str) -> Json {
    return arr([s(String(name))])
}

fn with_key(name: str, k: own String) -> Json {
    return arr([s(String(name)), s(k)])
}

fn pick_of(g: mut Gen, names: List<str>) -> str {
    return names[usize.wrap(g.below(i64.wrap(names.len())))]
}

fn ops_for(g: mut Gen, collection: str, keys: Keys, count: i64, removal: bool) -> List<Json> {
    var ops: List<Json> = []
    var adding = true
    var phase = 0i64
    for i in 0..count {
        if phase == 0 {
            adding = if i != 0 { not adding } else { true }
            phase = 20 + g.below(200)
        }
        phase -= 1
        if i % 37 == 36 {
            ops.push(act("iter"))
            continue
        }
        ops.push(op(mut g, collection, keys, adding, removal))
    }
    ops.push(act("size"))
    ops.push(act("iter"))
    return ops
}

fn clear_or(g: mut Gen, percent: i64, other: str) -> Json {
    if g.chance(percent) {
        return act("clear")
    }
    return act(other)
}

fn remove_iter(g: mut Gen) -> Json {
    let every = 2 + g.below(5)
    let offset = g.below(2)
    return arr([s("remove_iter"), n(every), n(offset)])
}

fn op(g: mut Gen, collection: str, keys: Keys, adding: bool, removal: bool) -> Json {
    let roll = g.below(100)
    if collection == "priority_queue" {
        if roll < (if adding { 55 } else { 15 }) {
            return with_key("add", key(mut g, keys))
        }
        if roll < 70 {
            return act("poll")
        }
        if roll < 75 {
            return act("peek")
        }
        if roll < 85 {
            return with_key("remove", key(mut g, keys))
        }
        if roll < 92 {
            return with_key("contains", key(mut g, keys))
        }
        if roll < 95 {
            return remove_iter(mut g)
        }
        if roll < 99 {
            return act("size")
        }
        return clear_or(mut g, 30, "iter")
    }
    if collection == "array_deque" {
        if roll < (if adding { 55 } else { 15 }) {
            let name = pick_of(mut g, ["add_first", "add_last"])
            return with_key(name, key(mut g, keys))
        }
        if roll < 75 {
            return act(pick_of(mut g, ["poll_first", "poll_last"]))
        }
        if roll < 82 {
            return act(pick_of(mut g, ["first", "last"]))
        }
        if roll < 92 {
            return with_key("contains", key(mut g, keys))
        }
        if roll < 99 {
            return act("size")
        }
        return clear_or(mut g, 30, "iter")
    }
    let is_map = MAPS.any(|m| m == collection)
    if roll < (if adding { 60 } else { 15 }) {
        if is_map {
            let k = key(mut g, keys)
            return arr([s("put"), s(k), n(value(mut g))])
        }
        return with_key("add", key(mut g, keys))
    }
    if roll < 78 {
        return with_key("remove", key(mut g, keys))
    }
    if roll < 86 {
        return with_key(if is_map { "get" } else { "contains" }, key(mut g, keys))
    }
    if roll < 89 {
        return with_key("contains", key(mut g, keys))
    }
    if roll < 90 {
        return clear_or(mut g, 25, "size")
    }
    if collection.starts_with("open") {
        // A loop that removes with the iterator, as vanilla's TicketStorage.removeTicketIf does.
        if roll < (if removal { 91 } else { 92 }) {
            return act("trim")
        }
        if roll < (if removal { 99 } else { 97 }) {
            return remove_iter(mut g)
        }
        return act("size")
    }
    if collection.starts_with("linked") {
        let pick = g.below(6)
        if pick < 2 {
            let names: [str; 2] = if is_map { ["put_first", "put_last"] } else { ["add_first", "add_last"] }
            let name = names[usize.wrap(pick)]
            if is_map {
                let k = key(mut g, keys)
                return arr([s(String(name)), s(k), n(value(mut g))])
            }
            return with_key(name, key(mut g, keys))
        }
        let ends: [str; 4] = ["first", "last", "poll_first", "poll_last"]
        return act(ends[usize.wrap(pick - 2)])
    }
    if collection.starts_with("tree") {
        let pick = g.below(9)
        if pick < 4 {
            let ends: [str; 4] = ["first", "last", "poll_first", "poll_last"]
            return act(ends[usize.wrap(pick)])
        }
        if pick < 8 {
            let near: [str; 4] = ["floor", "ceiling", "lower", "higher"]
            return with_key(near[usize.wrap(pick - 4)], key(mut g, keys))
        }
        let (a, b) = bounds(mut g, keys)
        return arr([s("range"), s(a), s(b)])
    }
    return act("size")
}

fn generate(seed: u64, which: List<str>, per_pair: i64, prefix: str, removal: bool) -> List<Json> {
    var g = Gen { r: splitmix64(seed) }
    var cases: List<Json> = []
    for collection in which {
        for kind in KEYS {
            for number in 0..per_pair {
                var keys = keys_of(mut g, kind)
                // Mostly short cases, and one long one per pair, which grows big tables.
                let count = if number == 0 { 1500i64 } else { 150 + g.below(350) }
                if number == 0 {
                    keys.span = 2000
                }
                var input: List<(String, Json)> = [(String("collection"), s(String(collection))), (String("key"), s(String(kind)))]
                if SIZED.any(|c| c == collection) and g.chance(40) {
                    input.push((String("capacity"), n([0i64, 1, 3, 12, 17, 64, 100, 1000][usize.wrap(g.below(8))])))
                }
                input.push((String("ops"), arr(ops_for(mut g, collection, keys, count, removal))))
                cases.push(case("{prefix}{collection.replace("_", "-")}-{kind}-{keys.style}-{number}", obj(input)))
            }
        }
    }
    return cases
}

pub fn main() {
    write_file(file("collections", "generated.json"), String("collections"), "cases/collections/gen.calx, seed {SEED}", generate(SEED, collections(), CASES_PER_PAIR, "", false), 1)
    write_file(file("collections", "removal.json"), String("collections"), "cases/collections/gen.calx, seed {REMOVAL_SEED}", generate(REMOVAL_SEED, ["open_hash_map", "open_hash_set"], REMOVAL_CASES_PER_PAIR, "removal-", true), 1)
}
