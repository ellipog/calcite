module cases.distance.gen

// Writes cases/distance/generated.json: players coming, going and walking about, tickets added
// and taken out, and the view and simulation distances changing, on a dimension's distance
// manager, with its dispatcher, its main thread and its chunks' entities ticking run in random
// interleavings.
//
//     calx cases/distance/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the same
// file.
//
// Each case is a list of operations. Players join, leave and walk, a chunk or a jump at a time.
// Tickets of every type come and go at levels that load a few hundred to a few thousand chunks.
// The updates run, the dispatcher's jobs and the main thread's tasks run a few at a time or all at
// once, the holders waited for tick their entities, a few or all at once or one by one, and the
// dropped holders move out and unload. The cases ask whether players are near chunks and how many
// chunks they spawn in, and dump the manager's state as they go, briefly, and in full at the end,
// after rounds that let it settle.
//
// The players stay within a few hundred chunks of 0, so no holder is out of vanilla's bounds, and
// a player only leaves the chunk it's in, since vanilla fails on any other.
//
// The draws are in the order the Python generator made them: a call's arguments before its body,
// a list's items before the pick among them, and `and`'s right side only when its left holds.

import std.json.{Json}
import cases.kit.{arr, case, file, n, obj, s}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}

const SEED: u64 = 20261031
const TYPES: [str; 9] = ["player_spawn", "spawn_search", "dragon", "player_loading", "player_simulation", "forced", "portal", "ender_pearl", "unknown"]
const BIG: i64 = 1048576

struct Rng {
    r: SplitMix64
}

impl Rng {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn chance(mut self, p: f64) -> bool {
        return self.below(1i64 << 20) < i64.saturate(p * 1048576.0)
    }

    fn pick(mut self, items: List<i64>) -> i64 {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }
}

/// A ticket: its type, level and chunk.
struct Ticket {
    kind: str,
    level: i64,
    x: i64,
    z: i64,
}

/// A case's operations, with where its players are, so each leaves the chunk it's in.
struct Case {
    span: i64,
    ops: List<Json>,
    // Each player there: its ID and chunk.
    players: List<(i64, i64, i64)>,
    next_id: i64,
    tickets: List<Ticket>,
    briefs: i64,
}

fn op(name: str, values: List<i64>) -> Json {
    var parts: List<Json> = [s(String(name))]
    for v in values {
        parts.push(n(v))
    }
    return arr(parts)
}

fn ticket_op(name: str, t: Ticket) -> Json {
    return arr([s(String(name)), s(String(t.kind)), n(t.level), n(t.x), n(t.z)])
}

impl Case {
    fn ids(self) -> List<i64> {
        var out: List<i64> = []
        for (id, _, _) in self.players {
            out.push(id)
        }
        out.sort()
        return out
    }

    fn at(self, player: i64) -> (i64, i64) {
        for (id, x, z) in self.players {
            if id == player {
                return (x, z)
            }
        }
        return (0, 0)
    }

    fn put(mut self, player: i64, x: i64, z: i64) {
        var kept: List<(i64, i64, i64)> = []
        for p in self.players {
            if p.0 != player {
                kept.push(p)
            }
        }
        kept.push((player, x, z))
        self.players = kept
    }

    fn take(mut self, player: i64) {
        var kept: List<(i64, i64, i64)> = []
        for p in self.players {
            if p.0 != player {
                kept.push(p)
            }
        }
        self.players = kept
    }

    fn chunk(self, rng: mut Rng) -> (i64, i64) {
        var near = false
        if self.players.len() > 0 {
            near = rng.chance(0.7)
        }
        if near {
            var spots: List<(i64, i64)> = []
            for (_, x, z) in self.players {
                spots.push((x, z))
            }
            spots.sort()
            let (x, z) = spots[usize.wrap(rng.below(i64.wrap(spots.len())))]
            let d = rng.pick([0, 1, 2, 4, 8, 14])
            let nx = x + rng.below(2 * d + 1) - d
            let nz = z + rng.below(2 * d + 1) - d
            return (nx, nz)
        }
        let x = rng.below(2 * self.span + 1) - self.span
        let z = rng.below(2 * self.span + 1) - self.span
        return (x, z)
    }

    fn join(mut self, rng: mut Rng) {
        // Sometimes a player that left comes back, as the adapter keeps it.
        var gone: List<i64> = []
        let here = self.ids()
        for i in 1..self.next_id {
            if not here.any(|h| h == i) {
                gone.push(i)
            }
        }
        var back = false
        if gone.len() > 0 {
            back = rng.chance(0.3)
        }
        var player = 0i64
        if back {
            player = rng.pick(gone)
        } else {
            player = self.next_id
            self.next_id += 1
        }
        let (x, z) = self.chunk(mut rng)
        self.put(player, x, z)
        self.ops.push(op("player", [player, x, z]))
    }

    fn leave(mut self, rng: mut Rng) {
        let player = rng.pick(self.ids())
        let (x, z) = self.at(player)
        self.take(player)
        self.ops.push(op("unplayer", [player, x, z]))
    }

    fn walk(mut self, rng: mut Rng) {
        let player = rng.pick(self.ids())
        let (x, z) = self.at(player)
        var dx = 0i64
        var dz = 0i64
        if rng.chance(0.85) {
            let steps: [(i64, i64); 6] = [(1, 0), (-1, 0), (0, 1), (0, -1), (1, 1), (-1, 1)]
            let (sx, sz) = steps[usize.wrap(rng.below(6))]
            dx = sx
            dz = sz
        } else {
            dx = rng.below(41) - 20
            dz = rng.below(41) - 20
        }
        let nx = clamp(x + dx, self.span)
        let nz = clamp(z + dz, self.span)
        self.ops.push(op("unplayer", [player, x, z]))
        self.put(player, nx, nz)
        self.ops.push(op("player", [player, nx, nz]))
    }

    fn ticket(mut self, rng: mut Rng) {
        var drop = false
        if self.tickets.len() > 0 {
            drop = rng.chance(0.45)
        }
        if drop {
            let t = self.tickets[usize.wrap(rng.below(i64.wrap(self.tickets.len())))]
            if rng.chance(0.85) {
                // The first ticket equal to it, as Python's `list.remove` takes.
                var kept: List<Ticket> = []
                var removed = false
                for other in self.tickets {
                    if not removed and other.kind == t.kind and other.level == t.level and other.x == t.x and other.z == t.z {
                        removed = true
                    } else {
                        kept.push(other)
                    }
                }
                self.tickets = kept
            }
            self.ops.push(ticket_op("unticket", t))
            return
        }
        let r = rng.below(100)
        var level = 0i64
        if r < 35 {
            level = 31
        } else if r < 50 {
            level = 33
        } else if r < 80 {
            level = 32 + rng.below(13)
        } else if r < 95 {
            level = 22 + rng.below(9)
        } else {
            level = 12 + rng.below(10)
        }
        let (x, z) = self.chunk(mut rng)
        let t = Ticket { kind: TYPES[usize.wrap(rng.below(9))], level: level, x: x, z: z }
        self.tickets.push(t)
        self.ops.push(ticket_op("ticket", t))
    }

    fn count(rng: mut Rng) -> i64 {
        return rng.pick([1, 1, 1, 2, 3, 4, 6, 10, 40, BIG])
    }

    /// One operation, from `mix`'s weights.
    fn step(mut self, rng: mut Rng, mix: List<(str, i64)>) {
        var total = 0i64
        for (_, w) in mix {
            total += w
        }
        var r = rng.below(total)
        var kind = ""
        for (k, w) in mix {
            kind = k
            if r < w {
                break
            }
            r -= w
        }
        if kind == "join" {
            if self.players.len() < 4 {
                self.join(mut rng)
            } else {
                self.walk(mut rng)
            }
        } else if kind == "leave" {
            if self.players.len() > 0 {
                self.leave(mut rng)
            }
        } else if kind == "walk" {
            if self.players.len() > 0 {
                self.walk(mut rng)
            }
        } else if kind == "view" {
            self.ops.push(op("view", [rng.pick([0, 1, 2, 2, 3, 3, 3, 4, 5, 6])]))
        } else if kind == "simulation" {
            self.ops.push(op("simulation", [rng.pick([0, 2, 5, 8, 10, 12, 32])]))
        } else if kind == "ticket" {
            self.ticket(mut rng)
        } else if kind == "update" {
            self.ops.push(op("update", []))
        } else if kind == "dispatch" {
            self.ops.push(op("dispatch", [Case.count(mut rng)]))
        } else if kind == "main" {
            self.ops.push(op("main", [Case.count(mut rng)]))
        } else if kind == "ready" {
            if rng.chance(0.75) {
                self.ops.push(op("ready_first", [Case.count(mut rng)]))
            } else {
                let (x, z) = self.chunk(mut rng)
                self.ops.push(op("ready", [x, z]))
            }
        } else if kind == "drop" {
            self.ops.push(op("drop", []))
        } else if kind == "unload" {
            self.ops.push(op("unload", [Case.count(mut rng)]))
        } else if kind == "promote" {
            self.ops.push(op("promote", []))
        } else if kind == "nearby" {
            if rng.chance(0.8) {
                let (x, z) = self.chunk(mut rng)
                self.ops.push(op("nearby", [x, z]))
            } else {
                self.ops.push(op("spawn_count", []))
            }
        } else if kind == "brief" {
            if self.briefs < 6 {
                self.briefs += 1
                self.ops.push(op("brief", []))
            }
        }
    }

    /// Rounds that run everything there is and have every chunk waited for tick its entities,
    /// enough for the chunks in view to get their tickets. Half the cases update twice a round, so
    /// the dispatcher waits on the holders before they're ready.
    fn settle(mut self, rng: mut Rng, rounds: i64) {
        let updates = rng.pick([1, 2])
        for _ in 0..rounds {
            for _ in 0..updates {
                self.ops.push(op("update", []))
            }
            for _ in 0..4 {
                self.ops.push(op("dispatch", [BIG]))
                self.ops.push(op("main", [BIG]))
            }
            self.ops.push(op("ready_first", [BIG]))
        }
        self.ops.push(op("update", []))
    }

    fn finish(mut self, rng: mut Rng, view: i64) {
        let players = if self.players.len() > 1 { i64.wrap(self.players.len()) } else { 1 }
        let side = 2 * view + 1
        let rounds = side * side * players + 30
        self.settle(mut rng, if rounds < 250 { rounds } else { 250 })
        self.ops.push(op("dump", []))
        self.ops.extend([op("drop", []), op("unload", [BIG]), op("promote", []), op("promote", []), op("brief", [])])
    }
}

fn clamp(v: i64, span: i64) -> i64 {
    if v < -span {
        return -span
    }
    if v > span {
        return span
    }
    return v
}

// The weights of each kind of operation, by the kind of case.
fn steady() -> List<(str, i64)> {
    return [("update", 30), ("dispatch", 25), ("main", 25), ("ready", 15), ("brief", 2), ("nearby", 3)]
}

fn walking() -> List<(str, i64)> {
    var out = steady()
    out.extend([("walk", 12), ("drop", 3), ("unload", 3), ("promote", 1)])
    return out
}

fn crowd() -> List<(str, i64)> {
    var out = walking()
    out.extend([("join", 4), ("leave", 3), ("view", 3), ("simulation", 2)])
    return out
}

fn ticketing() -> List<(str, i64)> {
    var out = steady()
    out.extend([("ticket", 25), ("drop", 4), ("unload", 4), ("promote", 2)])
    return out
}

fn everything() -> List<(str, i64)> {
    var out = crowd()
    out.push(("ticket", 10))
    return out
}

fn distance_case(rng: mut Rng, name: own String, mix: List<(str, i64)>, views: List<i64>, joins: i64, steps: i64, span: i64) -> Json {
    var c = Case { span: span, ops: [], players: [], next_id: 1, tickets: [], briefs: 0 }
    let view = rng.pick(views)
    if rng.chance(0.3) {
        c.ops.push(op("simulation", [rng.pick([2, 5, 8, 12])]))
    }
    var largest = view
    if rng.chance(0.5) {
        c.ops.push(op("view", [view]))
    }
    for _ in 0..joins {
        c.join(mut rng)
    }
    if not rng.chance(0.5) {
        c.ops.push(op("view", [view]))
    }
    for _ in 0..steps {
        c.step(mut rng, mix)
    }
    for o in c.ops {
        if let Json.Array(parts) = o {
            if let Json.Str(first) = parts[0] {
                if first == "view" {
                    if let Json.Int(v) = parts[1] {
                        if v > largest {
                            largest = v
                        }
                    }
                }
            }
        }
    }
    c.finish(mut rng, largest)
    return case(name, obj([(String("ops"), arr(c.ops))]))
}

pub fn main() {
    var rng = Rng { r: splitmix64(SEED) }
    var cases: List<Json> = []
    for i in 0..20 {
        let steps = rng.pick([20, 60, 150])
        cases.push(distance_case(mut rng, "join-{i}", steady(), [0, 1, 2, 3, 4], 1, steps, 40))
    }
    for i in 0..20 {
        let steps = rng.pick([60, 150, 300])
        cases.push(distance_case(mut rng, "walk-{i}", walking(), [2, 3, 4], 1, steps, 40))
    }
    for i in 0..16 {
        let joins = 1 + rng.below(3)
        let steps = rng.pick([80, 200, 400])
        cases.push(distance_case(mut rng, "crowd-{i}", crowd(), [1, 2, 3], joins, steps, 12))
    }
    for i in 0..16 {
        let joins = rng.below(2)
        let steps = rng.pick([40, 120, 250])
        cases.push(distance_case(mut rng, "tickets-{i}", ticketing(), [2, 3], joins, steps, 20))
    }
    for i in 0..30 {
        let joins = rng.below(3)
        let steps = rng.pick([100, 250, 500])
        cases.push(distance_case(mut rng, "random-{i}", everything(), [0, 2, 3, 4], joins, steps, 16))
    }
    write_file(file("distance", "generated.json"), String("distance"), "cases/distance/gen.calx, seed {SEED}", cases, 1)
}
