module cases.block_entity.gen

// Writes cases/block_entity/generated.json: block entities loaded from data and saved again, as a
// structure template's are when it places them, for each type Calcite loads, with data as 26.3's
// templates have it and data that's off in each way a codec meets.
//
//     calx cases/block_entity/gen.calx

import std.json.{Json}
import cases.kit.{case, file, obj, s}
import rig.runner.cases.{write_file}

const BEE: str = #"{id:"minecraft:bee",Age:0,PersistenceRequired:0b,Health:10.0f,HasStung:0b,AbsorptionAmount:0.0f,HasNectar:0b,attributes:[{base:16.0d,id:"minecraft:follow_range",modifiers:[{amount:0.0895d,id:"minecraft:random_spawn_bonus",operation:"add_multiplied_base"}]}],AngerTime:0,Invulnerable:0b}"#

/// An item stack: its ID, count and components.
fn item(id: str, count: i64, components: String) -> String {
    return "\{id:\"{id}\",count:{count},components:{components}\}"
}

/// One of an item, with no components.
fn bare_item(id: str) -> String {
    return "\{id:\"{id}\",count:1\}"
}

fn cat(parts: List<String>) -> String {
    return parts.join("")
}

fn add(out: mut List<Json>, id: own String, kind: str, snbt: own String) {
    out.push(case(id, obj([(String("id"), s("minecraft:{kind}")), (String("snbt"), s(snbt))])))
}

fn cases() -> List<Json> {
    var out: List<Json> = []
    // Beehives: their bees through `Occupant.CODEC`, and the flower's position.
    add(mut out, "beehive-empty", "beehive", #"{}"#)
    add(mut out, "beehive-one", "beehive", cat([#"{bees:[{entity_data:"#, String(BEE), #",ticks_in_hive:2558,min_ticks_in_hive:600}]}"#]))
    var three: List<String> = []
    for t in [2558, 2598, 0] {
        three.push(cat([#"{entity_data:"#, String(BEE), ",ticks_in_hive:{t},min_ticks_in_hive:600\}"]))
    }
    add(mut out, "beehive-three", "beehive", cat([#"{bees:["#, three.join(","), "],flower_pos:[I;1,64,-3]\}"]))
    add(mut out, "beehive-short-id", "beehive", #"{bees:[{entity_data:{id:"bee",Health:10.0f},ticks_in_hive:5,min_ticks_in_hive:600}]}"#)
    add(mut out, "beehive-other-mob", "beehive", #"{bees:[{entity_data:{id:"minecraft:pig"},ticks_in_hive:5,min_ticks_in_hive:1}]}"#)
    add(mut out, "beehive-unknown-mob", "beehive", #"{bees:[{entity_data:{id:"minecraft:dragonfly"},ticks_in_hive:5,min_ticks_in_hive:1},{entity_data:{id:"minecraft:bee"},ticks_in_hive:6,min_ticks_in_hive:1}]}"#)
    add(mut out, "beehive-no-id", "beehive", #"{bees:[{entity_data:{Health:10.0f},ticks_in_hive:5,min_ticks_in_hive:1}]}"#)
    add(mut out, "beehive-bad-id", "beehive", #"{bees:[{entity_data:{id:"Minecraft:Bee"},ticks_in_hive:5,min_ticks_in_hive:1}]}"#)
    add(mut out, "beehive-number-id", "beehive", #"{bees:[{entity_data:{id:5},ticks_in_hive:5,min_ticks_in_hive:1}]}"#)
    add(mut out, "beehive-no-min", "beehive", #"{bees:[{entity_data:{id:"minecraft:bee"},ticks_in_hive:5},{entity_data:{id:"minecraft:bee"},ticks_in_hive:7,min_ticks_in_hive:2}]}"#)
    add(mut out, "beehive-number-types", "beehive", #"{bees:[{entity_data:{id:"minecraft:bee"},ticks_in_hive:5b,min_ticks_in_hive:600L},{entity_data:{id:"minecraft:bee"},ticks_in_hive:3.9d,min_ticks_in_hive:1e12d}]}"#)
    add(mut out, "beehive-string-count", "beehive", #"{bees:[{entity_data:{id:"minecraft:bee"},ticks_in_hive:"5",min_ticks_in_hive:1}]}"#)
    add(mut out, "beehive-extra-fields", "beehive", #"{bees:[{entity_data:{id:"minecraft:bee"},ticks_in_hive:5,min_ticks_in_hive:1,TicksInHive:9}],extra:1b}"#)
    add(mut out, "beehive-entity-not-compound", "beehive", #"{bees:[{entity_data:[1,2],ticks_in_hive:5,min_ticks_in_hive:1}]}"#)
    add(mut out, "beehive-bees-not-list", "beehive", #"{bees:{a:1}}"#)
    add(mut out, "beehive-bees-int-array", "beehive", #"{bees:[I;1,2]}"#)
    add(mut out, "beehive-old-fields", "beehive", #"{Bees:[{EntityData:{id:"minecraft:bee"},TicksInHive:5,MinOccupationTicks:600}],FlowerPos:{X:1,Y:2,Z:3}}"#)
    add(mut out, "beehive-flower-list", "beehive", #"{flower_pos:[1,2,3]}"#)
    add(mut out, "beehive-flower-bytes", "beehive", #"{flower_pos:[B;1b,2b,3b]}"#)
    add(mut out, "beehive-flower-longs", "beehive", #"{flower_pos:[L;1L,4294967298L,3L]}"#)
    add(mut out, "beehive-flower-short", "beehive", #"{flower_pos:[I;1,2]}"#)
    add(mut out, "beehive-flower-long", "beehive", #"{flower_pos:[I;1,2,3,4]}"#)
    add(mut out, "beehive-flower-doubles", "beehive", #"{flower_pos:[1.5d,-2.5d,3.0d]}"#)
    add(mut out, "beehive-flower-strings", "beehive", #"{flower_pos:["1","2","3"]}"#)
    add(mut out, "beehive-flower-compound", "beehive", #"{flower_pos:{X:1,Y:2,Z:3}}"#)

    // Lecterns: the book through `ItemStack.CODEC`, the page clamped to its pages.
    let sand: String = #"{"minecraft:written_book_content":{pages:[{raw:"I don't like sand. It's coarse and rough."}],author:"Pillager 28",title:{raw:"Sand"},resolved:1b}}"#
    add(mut out, "lectern-empty", "lectern", #"{}"#)
    add(mut out, "lectern-written", "lectern", cat([#"{Page:0,Book:"#, item("minecraft:written_book", 1, sand.copy()), #"}"#]))
    add(mut out, "lectern-page-past", "lectern", cat([#"{Page:5,Book:"#, item("minecraft:written_book", 1, sand.copy()), #"}"#]))
    add(mut out, "lectern-page-negative", "lectern", cat([#"{Page:-2,Book:"#, item("minecraft:written_book", 1, sand.copy()), #"}"#]))
    add(mut out, "lectern-no-page", "lectern", cat([#"{Book:"#, item("minecraft:written_book", 1, sand.copy()), #"}"#]))
    add(mut out, "lectern-count", "lectern", cat([#"{Book:"#, item("minecraft:written_book", 3, sand.copy()), #"}"#]))
    add(mut out, "lectern-no-count", "lectern", cat([#"{Book:{id:"minecraft:written_book",components:"#, sand.copy(), #"}}"#]))
    add(mut out, "lectern-short-id", "lectern", cat([#"{Book:{id:"written_book",count:1b,components:"#, sand.copy(), #"}}"#]))
    let pages: String = #"[{raw:"one"},{raw:{text:"two",bold:1b,color:"red"},filtered:"2"},"three",{text:"four",italic:0b},["five",{text:"!"}],{raw:{translate:"book.title",with:["a",3]}}]"#
    let full = cat([#"{"minecraft:written_book_content":{title:{raw:"T",filtered:"t"},author:"A",generation:2,pages:"#, pages.copy(), ",resolved:0b\}\}"])
    add(mut out, "lectern-pages", "lectern", cat([#"{Page:3,Book:"#, item("minecraft:written_book", 1, full.copy()), #"}"#]))
    add(mut out, "lectern-title-string", "lectern", cat([#"{Book:"#, item("minecraft:written_book", 1, #"{"minecraft:written_book_content":{title:"Plain",author:"A"}}"#), #"}"#]))
    add(mut out, "lectern-generation-zero", "lectern", cat([#"{Book:"#, item("minecraft:written_book", 1, #"{"minecraft:written_book_content":{title:"G",author:"A",generation:0,pages:[]}}"#), #"}"#]))
    add(mut out, "lectern-writable-empty", "lectern", cat([#"{Page:4,Book:"#, bare_item("minecraft:writable_book"), #"}"#]))
    add(mut out, "lectern-writable-pages", "lectern", cat([#"{Page:1,Book:"#, item("minecraft:writable_book", 1, #"{"minecraft:writable_book_content":{pages:[{raw:"a"},"b",{raw:"c",filtered:"C"}]}}"#), #"}"#]))
    add(mut out, "lectern-writable-empty-content", "lectern", cat([#"{Page:0,Book:"#, item("minecraft:writable_book", 1, #"{"minecraft:writable_book_content":{pages:[]}}"#), #"}"#]))
    add(mut out, "lectern-written-writable", "lectern", cat([#"{Page:2,Book:"#, item("minecraft:written_book", 1, #"{"minecraft:writable_book_content":{pages:["x","y","z"]}}"#), #"}"#]))
    add(mut out, "lectern-written-no-content", "lectern", cat([#"{Page:1,Book:"#, bare_item("minecraft:written_book"), #"}"#]))

    // The other types a template's data reaches, with data as templates have it.
    let apple: String = #"{Slot:0b,id:"minecraft:apple",count:3}"#
    let sword: String = #"{Slot:5b,id:"minecraft:diamond_sword",count:1,components:{"minecraft:damage":5}}"#
    add(mut out, "chest-empty", "chest", #"{}"#)
    add(mut out, "chest-loot", "chest", #"{LootTable:"minecraft:chests/simple_dungeon"}"#)
    add(mut out, "chest-loot-seed", "chest", #"{LootTable:"minecraft:chests/simple_dungeon",LootTableSeed:12345L}"#)
    add(mut out, "chest-loot-and-items", "chest", cat([#"{LootTable:"minecraft:chests/simple_dungeon",Items:["#, apple.copy(), #"]}"#]))
    add(mut out, "chest-items", "chest", cat([#"{Items:["#, apple.copy(), ",", sword.copy(), #"]}"#]))
    add(mut out, "chest-name", "chest", #"{CustomName:"Loot",Items:[]}"#)
    add(mut out, "trapped-chest-loot", "trapped_chest", #"{LootTable:"minecraft:chests/jungle_temple"}"#)
    add(mut out, "barrel-loot", "barrel", #"{LootTable:"minecraft:chests/village/village_fisher"}"#)
    add(mut out, "dispenser-items", "dispenser", #"{Items:[{Slot:4b,id:"minecraft:arrow",count:9}]}"#)
    add(mut out, "dropper-empty", "dropper", #"{}"#)
    add(mut out, "hopper-empty", "hopper", #"{}"#)
    add(mut out, "hopper-cooldown", "hopper", cat([#"{TransferCooldown:8,Items:["#, apple.copy(), #"]}"#]))
    add(mut out, "shulker-items", "shulker_box", cat([#"{Items:["#, apple.copy(), #"]}"#]))
    add(mut out, "pot-sherds", "decorated_pot", #"{sherds:{back:"minecraft:brick",front:"minecraft:angler_pottery_sherd"}}"#)
    add(mut out, "pot-item", "decorated_pot", #"{item:{id:"minecraft:emerald",count:2}}"#)
    add(mut out, "pot-loot", "decorated_pot", #"{LootTable:"minecraft:pots/trial_chambers/corridor",LootTableSeed:7L}"#)
    add(mut out, "brushable-loot", "brushable_block", #"{LootTable:"minecraft:archaeology/desert_pyramid",LootTableSeed:3L}"#)
    add(mut out, "furnace-empty", "furnace", #"{}"#)
    add(mut out, "furnace-cooking", "furnace", #"{Items:[{Slot:0b,id:"minecraft:iron_ore",count:4}],cooking_time_spent:5s,cooking_total_time:200,lit_time_remaining:100,lit_total_time:1600}"#)
    add(mut out, "blast-furnace-empty", "blast_furnace", #"{}"#)
    add(mut out, "smoker-name", "smoker", #"{CustomName:"Smoky"}"#)
    add(mut out, "campfire-cooking", "campfire", #"{Items:[{Slot:0b,id:"minecraft:beef",count:1}],CookingTimes:[I;10,0,0,0],CookingTotalTimes:[I;600,0,0,0]}"#)
    add(mut out, "campfire-empty", "campfire", #"{}"#)
    add(mut out, "brewing-empty", "brewing_stand", #"{}"#)
    add(mut out, "brewing-fields", "brewing_stand", #"{BrewTime:5s,Fuel:3b,Items:[{Slot:3b,id:"minecraft:nether_wart",count:1}]}"#)
    add(mut out, "comparator-signal", "comparator", #"{OutputSignal:5}"#)
    add(mut out, "sculk-sensor", "sculk_sensor", #"{last_vibration_frequency:3}"#)
    add(mut out, "sign-text", "sign", #"{front_text:{messages:["","Hi","",""],color:"black",has_glowing_text:0b},back_text:{messages:["","","",""],color:"black",has_glowing_text:0b},is_waxed:0b}"#)
    add(mut out, "sign-styled", "sign", #"{front_text:{messages:[{text:"A",color:"red"},"","",""],color:"blue",has_glowing_text:1b},is_waxed:1b}"#)
    add(mut out, "sign-empty", "sign", #"{}"#)
    // A side through `SignText.DIRECT_CODEC`: lines written as the component codec writes them,
    // the first four of more, none of fewer, filtered lines only where they differ, a dye's color
    // (D288).
    add(mut out, "sign-compound-lines", "sign", #"{front_text:{messages:[{text:""},{text:"Hi"},"",[{text:"a"},"b"]],color:"black",has_glowing_text:0b}}"#)
    add(mut out, "sign-filtered-same", "sign", #"{front_text:{messages:["a","","",""],filtered_messages:[{text:"a"},"","",""],color:"red",has_glowing_text:2b}}"#)
    add(mut out, "sign-filtered-other", "sign", ##"{front_text:{messages:["a","","",""],filtered_messages:["#","","",""],color:"red",has_glowing_text:1b}}"##)
    add(mut out, "sign-filtered-bad", "sign", ##"{front_text:{messages:["a","","",""],filtered_messages:["#"],color:"red",has_glowing_text:1b}}"##)
    add(mut out, "sign-bad-color", "sign", #"{front_text:{messages:["a","","",""],color:"rainbow",has_glowing_text:0b}}"#)
    add(mut out, "sign-three-lines", "sign", #"{front_text:{messages:["a","b","c"],color:"blue",has_glowing_text:1b}}"#)
    add(mut out, "sign-five-lines", "sign", #"{front_text:{messages:["a","b","c","d","e"],color:"blue",has_glowing_text:1b}}"#)
    add(mut out, "sign-no-color", "hanging_sign", #"{back_text:{messages:["","","","x"]}}"#)
    add(mut out, "sign-bad-line", "sign", #"{front_text:{messages:["a",5,"c","d"],color:"blue",has_glowing_text:1b}}"#)
    add(mut out, "hanging-sign-text", "hanging_sign", #"{front_text:{messages:["","Inn","",""],color:"black",has_glowing_text:0b}}"#)
    add(mut out, "banner-patterns", "banner", #"{patterns:[{pattern:"minecraft:stripe_top",color:"red"},{pattern:"minecraft:border",color:"black"}]}"#)
    add(mut out, "banner-empty-patterns", "banner", #"{patterns:[]}"#)
    add(mut out, "banner-name", "banner", #"{CustomName:{color:"gold",translate:"block.minecraft.ominous_banner"}}"#)
    add(mut out, "skull-profile", "skull", #"{profile:{name:"Steve"}}"#)
    add(mut out, "skull-sound", "skull", #"{note_block_sound:"minecraft:entity.zombie.ambient"}"#)
    add(mut out, "skull-empty", "skull", #"{}"#)
    add(mut out, "vault-config", "vault", #"{config:{loot_table:"minecraft:chests/trial_chambers/reward"}}"#)
    add(mut out, "vault-ominous", "vault", #"{config:{loot_table:"minecraft:chests/trial_chambers/reward_ominous",key_item:{id:"minecraft:ominous_trial_key",count:1}}}"#)
    add(mut out, "vault-empty", "vault", #"{}"#)
    add(mut out, "trial-spawner-configs", "trial_spawner", #"{normal_config:"minecraft:trial_chamber/breeze/normal",ominous_config:"minecraft:trial_chamber/breeze/ominous",required_player_range:14,target_cooldown_length:36000}"#)
    add(mut out, "trial-spawner-empty", "trial_spawner", #"{}"#)
    add(mut out, "spawner-template", "mob_spawner", #"{MaxNearbyEntities:6s,RequiredPlayerRange:16s,SpawnCount:4s,MaxSpawnDelay:800s,Delay:20s,SpawnRange:4s,MinSpawnDelay:200s,SpawnData:{entity:{id:"minecraft:spider"}},SpawnPotentials:[]}"#)
    add(mut out, "spawner-empty", "mob_spawner", #"{}"#)
    add(mut out, "creaking-heart-empty", "creaking_heart", #"{}"#)
    add(mut out, "enchanting-table-name", "enchanting_table", #"{CustomName:"Runes"}"#)
    add(mut out, "bell-empty", "bell", #"{}"#)
    add(mut out, "ender-chest-empty", "ender_chest", #"{}"#)
    add(mut out, "jukebox-record", "jukebox", #"{RecordItem:{id:"minecraft:music_disc_cat",count:1},ticks_since_song_started:0L}"#)
    add(mut out, "chiseled-bookshelf-books", "chiseled_bookshelf", #"{Items:[{Slot:1b,id:"minecraft:book",count:1}],last_interacted_slot:1}"#)
    add(mut out, "command-block", "command_block", #"{Command:"say hi",auto:0b,powered:0b,SuccessCount:0,TrackOutput:1b,UpdateLastExecution:1b}"#)

    // A pot's sherds, each an `ItemStackTemplate`.
    add(mut out, "pot-sherds-objects", "decorated_pot", #"{sherds:{back:{id:"minecraft:brick",count:1},left:{id:"brick",count:2},right:"minecraft:not_an_item",front:{id:"minecraft:brick",count:100}}}"#)
    add(mut out, "pot-sherds-air", "decorated_pot", #"{sherds:{back:"minecraft:air",front:{id:"minecraft:air"},left:"minecraft:brick"}}"#)
    add(mut out, "pot-sherds-empty-components", "decorated_pot", #"{sherds:{back:{id:"minecraft:brick",components:{}}}}"#)
    add(mut out, "pot-sherds-not-compound", "decorated_pot", #"{sherds:"minecraft:brick"}"#)
    add(mut out, "pot-sherds-list", "decorated_pot", #"{sherds:["minecraft:brick","minecraft:brick","minecraft:brick","minecraft:brick"]}"#)
    add(mut out, "pot-sherds-number", "decorated_pot", #"{sherds:{back:5,front:"minecraft:brick"}}"#)

    // Every other type, new and with data as a template might have it.
    for kind in ["jukebox", "piston", "end_portal", "beacon", "structure_block", "command_block", "conduit", "sculk_catalyst", "sculk_shrieker", "chiseled_bookshelf", "shelf", "crafter", "test_block", "test_instance_block", "daylight_detector", "copper_golem_statue", "jigsaw", "end_gateway", "potent_sulfur", "calibrated_sculk_sensor"] {
        add(mut out, "{kind.replace("_", "-")}-new", kind, String("\{\}"))
    }
    add(mut out, "jukebox-playing", "jukebox", #"{RecordItem:{id:"minecraft:music_disc_cat",count:1},ticks_since_song_started:100L}"#)
    add(mut out, "jukebox-not-a-disc", "jukebox", #"{RecordItem:{id:"minecraft:stone",count:1},ticks_since_song_started:5L}"#)
    add(mut out, "jukebox-no-ticks", "jukebox", #"{RecordItem:{id:"minecraft:music_disc_pigstep",count:1}}"#)
    add(mut out, "piston-moving", "piston", #"{blockState:{Name:"minecraft:stone"},facing:1,progress:0.5f,extending:1b,source:0b}"#)
    add(mut out, "beacon-effects", "beacon", #"{primary_effect:"minecraft:speed",secondary_effect:"minecraft:regeneration",CustomName:"B",Levels:4}"#)
    add(mut out, "structure-block-save", "structure_block", #"{name:"minecraft:test",author:"x",metadata:"",posX:0,posY:1,posZ:0,sizeX:5,sizeY:5,sizeZ:5,rotation:"NONE",mirror:"NONE",mode:"SAVE",ignoreEntities:1b,strict:0b,powered:0b,showair:0b,showboundingbox:1b,integrity:1.0f,seed:0L}"#)
    add(mut out, "structure-block-data", "structure_block", #"{mode:"DATA",metadata:"chest"}"#)
    add(mut out, "conduit-target", "conduit", #"{Target:[I;1,2,3,4]}"#)
    add(mut out, "sculk-catalyst-cursors", "sculk_catalyst", #"{cursors:[{pos:[I;1,2,3],charge:5,decay_delay:1,update_delay:0}]}"#)
    add(mut out, "sculk-shrieker-warning", "sculk_shrieker", #"{warning_level:2}"#)
    add(mut out, "chiseled-bookshelf-slot-only", "chiseled_bookshelf", #"{last_interacted_slot:3}"#)
    add(mut out, "shelf-items", "shelf", #"{Items:[{Slot:0b,id:"minecraft:book",count:1}],align_items_to_bottom:1b}"#)
    add(mut out, "crafter-slots", "crafter", #"{disabled_slots:[I;0,4],triggered:1,crafting_ticks_remaining:3}"#)
    add(mut out, "crafter-loot", "crafter", #"{LootTable:"minecraft:chests/simple_dungeon"}"#)
    add(mut out, "test-block-message", "test_block", #"{mode:"start",message:"hi",powered:0b}"#)
    add(mut out, "end-gateway-exit", "end_gateway", #"{Age:100L,exit_portal:[I;1,2,3],ExactTeleport:1b}"#)
    add(mut out, "potent-sulfur-countdown", "potent_sulfur", #"{countdown:5}"#)
    add(mut out, "daylight-detector-data", "daylight_detector", #"{x:1}"#)
    add(mut out, "enchanting-table-styled-name", "enchanting_table", #"{CustomName:{text:"Runes",color:"aqua"}}"#)

    // Where each type's fields are read with a default, a range or a check.
    add(mut out, "piston-state-string", "piston", #"{blockState:"minecraft:stone",facing:2,progress:1.0f,extending:0b,source:1b}"#)
    add(mut out, "piston-state-props", "piston", #"{blockState:"minecraft:piston_head[facing=up,short=true,type=sticky]",facing:1}"#)
    add(mut out, "piston-state-log", "piston", #"{blockState:"minecraft:oak_log[axis=x]"}"#)
    add(mut out, "piston-state-log-default", "piston", #"{blockState:"minecraft:oak_log[axis=y]"}"#)
    add(mut out, "piston-state-empty-props", "piston", #"{blockState:"minecraft:stone[]"}"#)
    add(mut out, "piston-state-log-bare", "piston", #"{blockState:"minecraft:oak_log"}"#)
    add(mut out, "piston-state-short", "piston", #"{blockState:"stone"}"#)
    add(mut out, "piston-state-compound-props", "piston", #"{blockState:{Name:"minecraft:oak_log",Properties:{axis:"x"}}}"#)
    add(mut out, "piston-odd", "piston", #"{blockState:"nope",facing:9,progress:2.5f}"#)
    add(mut out, "beacon-not-beacon-effect", "beacon", #"{primary_effect:"minecraft:poison",secondary_effect:"speed"}"#)
    add(mut out, "beacon-unknown-effect", "beacon", #"{primary_effect:"minecraft:flying",Levels:2}"#)
    add(mut out, "structure-block-odd", "structure_block", #"{name:"Bad Name!",posX:100,posY:-60,posZ:3,sizeX:60,sizeY:-2,sizeZ:7,integrity:2.0f,rotation:"BAD",mirror:"FRONT_BACK",mode:"bad",showair:1b,seed:-4L}"#)
    add(mut out, "structure-block-path", "structure_block", #"{name:"ok/path",mode:"LOAD",rotation:"CLOCKWISE_90",integrity:-1.0f}"#)
    add(mut out, "command-block-last", "command_block", #"{Command:"x",LastExecution:5L,LastOutput:"out",CustomName:"Cmd",SuccessCount:2,auto:1b}"#)
    add(mut out, "command-block-no-update", "command_block", #"{UpdateLastExecution:0b,LastExecution:5L,TrackOutput:0b,LastOutput:"out",conditionMet:1b,powered:1b}"#)
    add(mut out, "sculk-catalyst-delays", "sculk_catalyst", #"{cursors:[{pos:[I;0,0,0],charge:3,decay_delay:3,update_delay:2,facings:["up","north"]}]}"#)
    add(mut out, "sculk-catalyst-odd", "sculk_catalyst", #"{cursors:[{pos:[I;0,0,0],charge:2000},{charge:1},{pos:[I;5,5,5],charge:-1}]}"#)
    add(mut out, "sculk-shrieker-odd", "sculk_shrieker", #"{warning_level:9,listener:{event_delay:3,selector:{tick:5L}}}"#)
    add(mut out, "chiseled-bookshelf-slot-high", "chiseled_bookshelf", #"{last_interacted_slot:10}"#)
    add(mut out, "crafter-odd", "crafter", #"{disabled_slots:[I;4,0,4,12,-1],triggered:5,crafting_ticks_remaining:-3}"#)
    add(mut out, "test-block-odd", "test_block", #"{mode:"bad",message:5}"#)
    add(mut out, "test-block-log", "test_block", #"{mode:"log"}"#)
    add(mut out, "end-gateway-odd", "end_gateway", #"{Age:-5L,ExactTeleport:0b,exit_portal:[I;1,2]}"#)
    add(mut out, "potent-sulfur-string", "potent_sulfur", #"{countdown:"x"}"#)
    add(mut out, "jigsaw-template", "jigsaw", #"{name:"minecraft:bottom",target:"minecraft:top",pool:"minecraft:village/plains/houses",final_state:"minecraft:air",joint:"rollable",placement_priority:2,selection_priority:-1}"#)
    add(mut out, "jigsaw-odd", "jigsaw", #"{name:"Bad!",target:"top",joint:"sideways",final_state:"minecraft:stone["}"#)
    add(mut out, "conduit-long-target", "conduit", #"{Target:[I;1,2,3,4,5]}"#)
    add(mut out, "conduit-string-target", "conduit", #"{Target:"x"}"#)
    add(mut out, "sculk-sensor-listener-no-delay", "sculk_sensor", #"{listener:{selector:{tick:5L}}}"#)
    add(mut out, "sculk-sensor-listener-negative", "sculk_sensor", #"{listener:{event_delay:-1,selector:{tick:0L}}}"#)
    add(mut out, "sculk-sensor-listener-no-selector", "sculk_sensor", #"{listener:{event_delay:2}}"#)
    add(mut out, "sculk-sensor-listener-not-compound", "calibrated_sculk_sensor", #"{listener:5,last_vibration_frequency:4}"#)
    // `getIntOr` rounds a float down, `getBooleanOr` takes a number's low byte, and a codec's
    // `Codec.INT` cuts toward zero.
    add(mut out, "hopper-float-cooldown", "hopper", #"{TransferCooldown:-2.5f}"#)
    add(mut out, "comparator-double-signal", "comparator", #"{OutputSignal:3.9d}"#)
    add(mut out, "sign-waxed-256", "sign", #"{is_waxed:256,allow_op_features:512}"#)
    add(mut out, "sign-waxed-half", "sign", #"{is_waxed:0.5f}"#)
    add(mut out, "trial-spawner-float", "trial_spawner", #"{total_mobs_spawned:-2.7f,required_player_range:3.9d,cooldown_ends_at:-1.5d}"#)
    add(mut out, "lectern-float-page", "lectern", cat([#"{Page:-0.5f,Book:"#, item("minecraft:written_book", 1, sand.copy()), #"}"#]))
    // A count that doesn't read is the default, 1, the partial value of its optional field.
    add(mut out, "lectern-bad-count", "lectern", cat([#"{Book:{id:"minecraft:written_book",count:200,components:"#, sand.copy(), #"}}"#]))
    add(mut out, "lectern-string-count", "lectern", cat([#"{Book:{id:"minecraft:written_book",count:"x",components:"#, sand.copy(), #"}}"#]))
    add(mut out, "pot-sherds-bad-counts", "decorated_pot", #"{sherds:{back:{id:"minecraft:brick",count:"x"},left:{id:"minecraft:brick",count:0},front:{id:"minecraft:brick",components:5}}}"#)
    add(mut out, "jukebox-bad-count", "jukebox", #"{RecordItem:{id:"minecraft:music_disc_cat",count:0},ticks_since_song_started:7L}"#)
    add(mut out, "jukebox-components", "jukebox", #"{RecordItem:{id:"minecraft:music_disc_cat",count:1,components:{}},ticks_since_song_started:3}"#)

    // Items through vanilla's codecs (D367): a container's as `ContainerHelper` loads them into its
    // slots and saves them in their order, each `ItemStackWithSlot.CODEC`, and each other item
    // `ItemStack.CODEC` or `ItemStackTemplate.CODEC`, with its components.
    let named: String = #"{"minecraft:custom_name":"Named"}"#
    add(mut out, "chest-items-unsorted", "chest", #"{Items:[{Slot:5b,id:"minecraft:stone",count:2},{Slot:0b,id:"minecraft:dirt",count:1},{Slot:3b,id:"minecraft:apple",count:7}]}"#)
    add(mut out, "chest-items-same-slot", "chest", #"{Items:[{Slot:2b,id:"minecraft:stone",count:2},{Slot:2b,id:"minecraft:dirt",count:5}]}"#)
    add(mut out, "chest-items-out-of-range", "chest", #"{Items:[{Slot:27b,id:"minecraft:stone",count:1},{Slot:-1b,id:"minecraft:dirt",count:1},{Slot:26b,id:"minecraft:apple",count:1},{Slot:283,id:"minecraft:bread",count:1},{Slot:1.9f,id:"minecraft:egg",count:1}]}"#)
    add(mut out, "chest-items-no-slot", "chest", #"{Items:[{id:"minecraft:stone",count:3},{Slot:4b,id:"minecraft:dirt",count:1}]}"#)
    add(mut out, "chest-items-bad", "chest", #"{Items:[{Slot:0b,id:"minecraft:air",count:1},{Slot:1b,id:"minecraft:not_an_item",count:1},5,{Slot:"x",id:"minecraft:stone",count:2},{Slot:3b,id:"minecraft:dirt",count:0},{Slot:4b,id:"minecraft:apple",count:200},{Slot:5b,id:"stick",count:1b},{Slot:6b,count:1},{Slot:7b,id:"minecraft:egg",count:3,components:5}]}"#)
    add(mut out, "chest-items-components", "chest", #"{Items:[{Slot:0b,id:"minecraft:diamond_sword",count:1,components:{"minecraft:damage":0}},{Slot:1b,id:"minecraft:diamond_sword",count:1,components:{"minecraft:damage":7,"minecraft:custom_name":{text:"Edge",color:"red"}}},{Slot:2b,id:"minecraft:stone",count:1,components:{"!minecraft:max_stack_size":{},"!minecraft:food":{}}},{Slot:3b,id:"minecraft:apple",count:1,components:{"minecraft:max_stack_size":64,"minecraft:rarity":"epic"}},{Slot:4b,id:"minecraft:stone",count:1,components:{"minecraft:not_a_component":1}}]}"#)
    add(mut out, "chest-items-nested", "chest", #"{Items:[{Slot:0b,id:"minecraft:shulker_box",count:1,components:{"minecraft:container":[{slot:0,item:{id:"minecraft:diamond_sword",count:1,components:{"minecraft:damage":0,"minecraft:custom_name":"In"}}},{slot:3,item:{id:"minecraft:apple",count:2,components:{"minecraft:max_stack_size":64}}}]}},{Slot:1b,id:"minecraft:bundle",count:1,components:{"minecraft:bundle_contents":[{id:"minecraft:stone",count:3,components:{"minecraft:rarity":"common"}}]}}]}"#)
    add(mut out, "chest-items-not-list", "chest", #"{Items:{Slot:0b,id:"minecraft:stone",count:1}}"#)
    add(mut out, "chest-items-list-of-lists", "chest", #"{Items:[[{Slot:0b,id:"minecraft:stone",count:1}]]}"#)
    add(mut out, "trapped-chest-items", "trapped_chest", #"{Items:[{Slot:9b,id:"minecraft:gold_ingot",count:4}]}"#)
    add(mut out, "barrel-items", "barrel", #"{Items:[{Slot:26b,id:"minecraft:cod",count:16},{Slot:1b,id:"minecraft:salmon",count:2}]}"#)
    add(mut out, "shulker-empty", "shulker_box", #"{}"#)
    add(mut out, "shulker-no-items", "shulker_box", #"{Items:[]}"#)
    add(mut out, "shulker-bad-items", "shulker_box", #"{Items:[{Slot:30b,id:"minecraft:stone",count:1},{Slot:0b,id:"minecraft:air",count:1}]}"#)
    add(mut out, "shulker-loot", "shulker_box", #"{LootTable:"minecraft:chests/end_city_treasure"}"#)
    add(mut out, "hopper-slot-past", "hopper", #"{Items:[{Slot:4b,id:"minecraft:stone",count:1},{Slot:5b,id:"minecraft:dirt",count:1}]}"#)
    add(mut out, "dispenser-slot-past", "dispenser", #"{Items:[{Slot:8b,id:"minecraft:arrow",count:1},{Slot:9b,id:"minecraft:arrow",count:2}]}"#)
    add(mut out, "dropper-items", "dropper", #"{Items:[{Slot:3b,id:"minecraft:stone",count:5},{Slot:0b,id:"minecraft:dirt",count:1}]}"#)
    add(mut out, "crafter-items", "crafter", #"{Items:[{Slot:8b,id:"minecraft:stick",count:1},{Slot:9b,id:"minecraft:stick",count:1}]}"#)
    add(mut out, "furnace-slot-past", "furnace", #"{Items:[{Slot:2b,id:"minecraft:iron_ingot",count:3},{Slot:3b,id:"minecraft:coal",count:1}]}"#)
    add(mut out, "smoker-items", "smoker", #"{Items:[{Slot:1b,id:"minecraft:coal",count:2},{Slot:0b,id:"minecraft:beef",count:1}]}"#)
    add(mut out, "campfire-slot-past", "campfire", #"{Items:[{Slot:3b,id:"minecraft:beef",count:1},{Slot:4b,id:"minecraft:cod",count:1}]}"#)
    add(mut out, "brewing-slot-past", "brewing_stand", #"{Items:[{Slot:4b,id:"minecraft:blaze_powder",count:1},{Slot:5b,id:"minecraft:potion",count:1}]}"#)
    add(mut out, "chiseled-bookshelf-slot-past", "chiseled_bookshelf", #"{Items:[{Slot:5b,id:"minecraft:book",count:1},{Slot:6b,id:"minecraft:book",count:1}]}"#)
    add(mut out, "shelf-slot-past", "shelf", #"{Items:[{Slot:2b,id:"minecraft:book",count:1},{Slot:3b,id:"minecraft:book",count:1}]}"#)
    add(mut out, "chiseled-bookshelf-named-book", "chiseled_bookshelf", #"{Items:[{Slot:0b,id:"minecraft:enchanted_book",count:1,components:{"minecraft:stored_enchantments":{"minecraft:mending":1}}}]}"#)
    add(mut out, "pot-item-components", "decorated_pot", cat([#"{item:{id:"minecraft:emerald",count:3,components:"#, named.copy(), #"}}"#]))
    add(mut out, "pot-item-air", "decorated_pot", #"{item:{id:"minecraft:air",count:1}}"#)
    add(mut out, "pot-item-bad-count", "decorated_pot", #"{item:{id:"minecraft:emerald",count:500}}"#)
    add(mut out, "pot-item-not-compound", "decorated_pot", #"{item:"minecraft:emerald"}"#)
    add(mut out, "pot-loot-and-item", "decorated_pot", #"{LootTable:"minecraft:pots/trial_chambers/corridor",item:{id:"minecraft:emerald",count:1}}"#)
    add(mut out, "pot-sherds-components", "decorated_pot", cat([#"{sherds:{back:{id:"minecraft:brick",components:"#, named.copy(), #"},front:{id:"minecraft:angler_pottery_sherd",count:1,components:{"!minecraft:rarity":{}}}}}"#]))
    add(mut out, "brushable-item", "brushable_block", #"{item:{id:"minecraft:emerald",count:1}}"#)
    add(mut out, "brushable-item-components", "brushable_block", cat([#"{item:{id:"minecraft:diamond",count:2,components:"#, named.copy(), #"},hit_direction:2}"#]))
    add(mut out, "brushable-loot-and-item", "brushable_block", #"{LootTable:"minecraft:archaeology/desert_pyramid",item:{id:"minecraft:emerald",count:1}}"#)
    add(mut out, "jukebox-stone-with-song", "jukebox", #"{RecordItem:{id:"minecraft:stone",count:1,components:{"minecraft:jukebox_playable":"minecraft:cat"}},ticks_since_song_started:40L}"#)
    add(mut out, "jukebox-disc-without-song", "jukebox", #"{RecordItem:{id:"minecraft:music_disc_cat",count:1,components:{"!minecraft:jukebox_playable":{}}},ticks_since_song_started:40L}"#)
    add(mut out, "jukebox-disc-named", "jukebox", cat([#"{RecordItem:{id:"minecraft:music_disc_13",count:1,components:"#, named.copy(), #"},ticks_since_song_started:9L}"#]))
    add(mut out, "jukebox-two-discs", "jukebox", #"{RecordItem:{id:"minecraft:music_disc_cat",count:2},ticks_since_song_started:5L}"#)
    add(mut out, "lectern-stone", "lectern", #"{Page:3,Book:{id:"minecraft:stone",count:1}}"#)
    add(mut out, "lectern-not-an-item", "lectern", #"{Page:3,Book:{id:"minecraft:not_an_item",count:1}}"#)
    add(mut out, "lectern-book-named", "lectern", cat([#"{Page:0,Book:"#, item("minecraft:written_book", 1, #"{"minecraft:written_book_content":{title:"T",author:"A",pages:["a","b"]},"minecraft:custom_name":"Mine"}"#), #"}"#]))
    add(mut out, "lectern-writable-default", "lectern", cat([#"{Page:2,Book:"#, item("minecraft:writable_book", 1, #"{"minecraft:writable_book_content":{}}"#), #"}"#]))
    add(mut out, "lectern-stone-with-pages", "lectern", cat([#"{Page:1,Book:"#, item("minecraft:stone", 1, #"{"minecraft:writable_book_content":{pages:["x","y","z"]}}"#), #"}"#]))
    add(mut out, "vault-key-components", "vault", cat([#"{config:{key_item:{id:"minecraft:trial_key",count:1,components:"#, named.copy(), #"}}}"#]))
    add(mut out, "vault-key-air", "vault", #"{config:{key_item:{id:"minecraft:air",count:1}}}"#)
    add(mut out, "vault-key-bad-count", "vault", #"{config:{key_item:{id:"minecraft:trial_key",count:500}}}"#)
    // Names and sign text read with `ComponentSerialization.CODEC`: every kind of contents, what's
    // read in part, and what doesn't read, which is left out (D370).
    add(mut out, "chest-name-keybind", "chest", #"{CustomName:{keybind:"key.inventory",color:"gold"}}"#)
    add(mut out, "chest-name-bad", "chest", #"{CustomName:5}"#)
    add(mut out, "chest-name-bad-color", "chest", #"{CustomName:{text:"Loot",color:"nope"}}"#)
    add(mut out, "chest-name-no-contents", "chest", #"{CustomName:{color:"red"}}"#)
    add(mut out, "chest-name-list", "chest", #"{CustomName:["a",{text:"b",bold:1b}]}"#)
    add(mut out, "barrel-name-typed", "barrel", #"{CustomName:{type:"translatable",translate:"container.barrel",with:[1b,"x"]}}"#)
    add(mut out, "barrel-name-bad-arg", "barrel", #"{CustomName:{type:"translatable",translate:"k",with:[{a:1}]}}"#)
    add(mut out, "banner-name-object", "banner", #"{CustomName:{object:"atlas",sprite:"block/stone"}}"#)
    add(mut out, "beacon-name-score", "beacon", #"{CustomName:{score:{name:"*",objective:"o"}},Levels:1}"#)
    add(mut out, "enchanting-table-name-nbt", "enchanting_table", #"{CustomName:{nbt:"a.b",storage:"x:y",interpret:1b}}"#)
    add(mut out, "enchanting-table-name-bad-path", "enchanting_table", #"{CustomName:{type:"nbt",nbt:"a..b",storage:"x"}}"#)
    add(mut out, "sign-contents", "sign", #"{front_text:{messages:[{keybind:"key.jump"},{selector:"@p"},{score:{name:"@s",objective:"o"}},{nbt:"Pos",entity:"@s",separator:"/"}],color:"green",has_glowing_text:1b}}"#)
    add(mut out, "sign-object-lines", "sign", #"{front_text:{messages:[{sprite:"item/apple"},{player:{name:"Steve"},hat:0b},"",""]}}"#)
    add(mut out, "sign-click-command", "sign", #"{front_text:{messages:[{text:"Go",click_event:{action:"run_command",command:"/say hi"}},"","",""]}}"#)
    add(mut out, "sign-bad-style-line", "sign", #"{front_text:{messages:[{text:"a",color:"nope"},"b","c","d"]}}"#)
    add(mut out, "sign-bad-contents-line", "sign", #"{front_text:{messages:[{type:"keybind"},"b","c","d"]}}"#)
    add(mut out, "sign-filtered-other-contents", "sign", #"{front_text:{messages:["a","b","c","d"],filtered_messages:[{keybind:"k"},"b","c","d"]}}"#)
    add(mut out, "sign-filtered-bad-line", "sign", #"{front_text:{messages:["a","b","c","d"],filtered_messages:[5,"b","c","d"]}}"#)
    add(mut out, "sign-hover-item", "hanging_sign", #"{back_text:{messages:[{text:"i",hover_event:{action:"show_item",id:"minecraft:stone",count:2}},"","",""]}}"#)
    add(mut out, "sign-text-not-compound", "sign", #"{front_text:"x",back_text:[1]}"#)
    add(mut out, "skull-profile-string", "skull", #"{profile:"Alex"}"#)
    add(mut out, "skull-profile-bad", "skull", #"{profile:{name:"bad name!"}}"#)
    add(mut out, "skull-sound-bad", "skull", #"{note_block_sound:"Not Valid"}"#)
    add(mut out, "skull-sound-number", "skull", #"{note_block_sound:5}"#)
    add(mut out, "skull-name", "skull", #"{custom_name:{text:"Head",italic:0b}}"#)
    add(mut out, "skull-name-bad", "skull", #"{custom_name:{type:"nope"}}"#)
    add(mut out, "command-block-output-styled", "command_block", #"{Command:"x",LastOutput:{text:"[12:00] ok",color:"gray"},TrackOutput:1b}"#)
    add(mut out, "command-block-output-bad", "command_block", #"{Command:"x",LastOutput:{bold:"x"},TrackOutput:1b,CustomName:{keybind:"a"}}"#)
    return out
}

pub fn main() {
    write_file(file("block_entity", "generated.json"), String("block_entity"), String("cases/block_entity/gen.calx"), cases(), 1)
}
