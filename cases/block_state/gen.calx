module cases.block_state.gen

// Writes cases/block_state/ranges.json: every block state ID and every block, in chunks (P2.5).
//
//     calx cases/block_state/gen.calx
//
// The cases hold only ID ranges, so no game data is committed. The ranges run past 26.3's 35,723
// states and 1,286 blocks, so they still cover every ID after an update adds some, and the IDs
// past the end, which the game reads as missing.

import std.json.{Json}
import cases.kit.{case, file, n, obj, s}
import rig.runner.cases.{write_file}

const STATE_CHUNK: i64 = 1024
const STATE_END: i64 = 40960
const BLOCK_CHUNK: i64 = 256
const BLOCK_END: i64 = 1536
const INT_MAX: i64 = 2147483647

fn range(op: str, from: i64, count: i64) -> Json {
    return obj([(String("op"), s(String(op))), (String("from"), n(from)), (String("count"), n(count))])
}

pub fn main() {
    var cases: List<Json> = []
    var start = 0i64
    while start < STATE_END {
        cases.push(case("by-id-{start:05}", range("by_id", start, STATE_CHUNK)))
        start += STATE_CHUNK
    }
    cases.push(case(String("by-id-negative"), range("by_id", -4, 4)))
    cases.push(case(String("by-id-int-max"), range("by_id", INT_MAX - 3, 4)))
    start = 0
    while start < BLOCK_END {
        cases.push(case("blocks-{start:04}", range("blocks", start, BLOCK_CHUNK)))
        start += BLOCK_CHUNK
    }
    cases.push(case(String("blocks-negative"), range("blocks", -4, 4)))
    cases.push(case(String("blocks-int-max"), range("blocks", INT_MAX - 3, 4)))
    write_file(file("block_state", "ranges.json"), String("block_state"), String("cases/block_state/gen.calx"), cases, 1)
}
