module cases.environment.gen

// Writes cases/environment/generated.json: the environment attributes' dimension values, as a
// level's `EnvironmentAttributeSystem` gives them, at many clocks and weathers.
//
//     calx cases/environment/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the same
// file.
//
// The `vanilla` cases are vanilla's dimension types, with the weather's layers where a level of
// that type can have weather and, for the Overworld and the Nether, also where it can't. Their
// records go through the day's keyframes tick by tick, the moon's phases, the end of the early
// game, negative and huge clocks, and the rain and thunder as the weather moves them and at
// random. The `pack` cases are made as a data pack would make them: a map of attributes with every
// modifier, and timelines with every modifier and easing, cubic Béziers among them, periods or
// none, and keyframes that repeat a tick, all read at random clocks and weathers.
//
// Each record is the ticks every clock has run, an i64, then the rain and thunder levels, f32s.
//
// The draws are in the order the Python generator made them: a list's items before the pick
// among them, a conditional's test before its branch, and `and`'s and `or`'s right side only when
// their left doesn't decide.

import std.bytes
import std.bytes.{base64}
import std.json.{Json}
import cases.kit.{arr, b, file, n, obj, s, strs}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}

const SEED: u64 = 20261103
const I64_MAX: i64 = 9223372036854775807

/// Every float attribute, with its range, if an override must keep within one: the highest is
/// none where it's unbounded.
fn floats() -> List<(str, (f64, f64?)?)> {
    let unbounded: (f64, f64?)? = some((0.0, none))
    let unit: (f64, f64?)? = some((0.0, some(1.0)))
    return [
        ("minecraft:visual/fog_start_distance", none),
        ("minecraft:visual/fog_end_distance", unbounded),
        ("minecraft:visual/sky_fog_end_distance", unbounded),
        ("minecraft:visual/cloud_fog_end_distance", unbounded),
        ("minecraft:visual/water_fog_start_distance", none),
        ("minecraft:visual/water_fog_end_distance", unbounded),
        ("minecraft:visual/cloud_height", none),
        ("minecraft:visual/star_brightness", unit),
        ("minecraft:visual/sky_light_factor", unit),
        ("minecraft:audio/music_volume", unit),
        ("minecraft:gameplay/sky_light_level", some((0.0, some(15.0)))),
        ("minecraft:gameplay/turtle_egg_hatch_chance", unit),
        ("minecraft:gameplay/surface_slime_spawn_chance", unit),
        ("minecraft:gameplay/cat_waking_up_gift_chance", unit),
        ("minecraft:gameplay/creature_world_gen_spawn_probability", some((0.0, some(0.9999999)))),
    ]
}

fn booleans() -> List<str> {
    return ["minecraft:audio/firefly_bush_sounds", "minecraft:gameplay/can_start_raid", "minecraft:gameplay/water_evaporates", "minecraft:gameplay/respawn_anchor_works", "minecraft:gameplay/nether_portal_spawns_piglin", "minecraft:gameplay/fast_lava", "minecraft:gameplay/increased_fire_burnout", "minecraft:gameplay/piglins_zombify", "minecraft:gameplay/snow_golem_melts", "minecraft:gameplay/creaking_active", "minecraft:gameplay/bees_stay_in_hive", "minecraft:gameplay/monsters_burn", "minecraft:gameplay/can_pillager_patrol_spawn"]
}

fn float_names() -> List<str> {
    var out: List<str> = []
    for (name, _) in floats() {
        out.push(name)
    }
    return out
}

/// Every attribute the cases read: the floats, then the booleans.
fn read_all() -> List<str> {
    var out = float_names()
    out.extend(booleans())
    return out
}

fn names(xs: List<str>) -> Json {
    var out: List<String> = []
    for x in xs {
        out.push(String(x))
    }
    return strs(out)
}

const FLOAT_OPS: [str; 7] = ["override", "alpha_blend", "add", "subtract", "multiply", "minimum", "maximum"]
const BOOL_OPS: [str; 7] = ["override", "and", "nand", "or", "nor", "xor", "xnor"]
const EASINGS: [str; 32] = ["constant", "linear", "in_back", "in_bounce", "in_circ", "in_cubic", "in_elastic", "in_expo", "in_quad", "in_quart", "in_quint", "in_sine", "in_out_back", "in_out_bounce", "in_out_circ", "in_out_cubic", "in_out_elastic", "in_out_expo", "in_out_quad", "in_out_quart", "in_out_quint", "in_out_sine", "out_back", "out_bounce", "out_circ", "out_cubic", "out_elastic", "out_expo", "out_quad", "out_quart", "out_quint", "out_sine"]
const CLOCKS: [str; 2] = ["minecraft:overworld", "minecraft:the_end"]

struct Rng {
    r: SplitMix64
}

impl Rng {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn unit(mut self) -> f64 {
        return f64.nearest(i64.wrap(self.r.next() >> 11)) / 9007199254740992.0
    }

    fn chance(mut self, p: f64) -> bool {
        return self.unit() < p
    }

    fn pick(mut self, items: List<i64>) -> i64 {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    fn pick_f64(mut self, items: List<f64>) -> f64 {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    fn pick_str(mut self, items: List<str>) -> str {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    /// A long from a whole draw, as `(x & (2^64 - 1)) - 2^63` gives it.
    fn long(mut self) -> i64 {
        return i64.wrap(self.r.next() ^ 0x8000000000000000)
    }
}

/// The float nearest `x`, as an `f64`, which JSON writes so it reads back exactly.
fn f32_of(x: f64) -> f64 {
    return f64(f32.nearest(x))
}

fn min1(x: f64) -> f64 {
    return if x < 1.0 { x } else { 1.0 }
}

fn record(out: mut List<u8>, ticks: i64, rain: f64, thunder: f64) {
    bytes.put_i64_be(mut out, ticks)
    bytes.put_f32_be(mut out, f32.nearest(rain))
    bytes.put_f32_be(mut out, f32.nearest(thunder))
}

/// Rain and thunder as the weather moves them, by 0.01 a tick and clamped, as it is, and at
/// random, thunder under rain or over it.
fn weathers(rng: mut Rng, count: usize) -> List<(f64, f64)> {
    var out: List<(f64, f64)> = [(0.0, 0.0), (1.0, 0.0), (1.0, 1.0), (0.0, 1.0)]
    let step = f32_of(0.01)
    var level = 0.0
    while level < 1.0 {
        level = f32_of(level + step)
        out.push((min1(level), 0.0))
    }
    let rain = 1.0
    var thunder = 0.0
    while thunder < 1.0 {
        thunder = f32_of(thunder + step)
        // `getThunderLevel` is the thunder's level times the rain's.
        out.push((rain, f32_of(min1(thunder) * rain)))
    }
    while out.len() < count {
        var r = 0.0
        if rng.chance(0.8) {
            r = f32_of(rng.unit())
        } else {
            r = rng.pick_f64([0.0, 1.0, f32_of(1.0e-7), f32_of(0.999999)])
        }
        var t = 0.0
        if rng.chance(0.5) {
            t = f32_of(rng.unit())
        } else {
            t = f32_of(r * f32_of(rng.unit()))
        }
        out.push((r, t))
    }
    return out
}

fn push_range(ticks: mut List<i64>, from: i64, until: i64) {
    for t in from..until {
        ticks.push(t)
    }
}

/// The day's keyframes tick by tick, the moon's phases, the early game's end, and clocks that are
/// negative, past the period many times, or near a long's ends.
fn vanilla_ticks(rng: mut Rng) -> List<i64> {
    var ticks: List<i64> = []
    push_range(mut ticks, 0, 400)
    for k in [11867i64, 13670, 22330, 23999] {
        push_range(mut ticks, k - 60, k + 60)
    }
    for phase in 0..9i64 {
        ticks.extend([phase * 24000 - 1, phase * 24000, phase * 24000 + 1])
    }
    push_range(mut ticks, 119990, 120011)
    ticks.extend([-1, -133, -1670, -24000, -24001, -192000, 2147483647, 2147483648, -2147483648, -2147483649])
    let low = i64.wrap(0x8000000000000000u64)
    ticks.extend([I64_MAX, low, I64_MAX - 23999, low + 1, 1i64 << 40, -(1i64 << 40)])
    for _ in 0..400 {
        ticks.push(rng.below(400000) - 20000)
    }
    for _ in 0..40 {
        ticks.push(rng.long())
    }
    return ticks
}

fn vanilla_case(rng: mut Rng, number: usize, type_id: str, weather: bool) -> Json {
    let ticks = vanilla_ticks(mut rng)
    let ws = weathers(mut rng, ticks.len())
    var records: List<u8> = []
    for (i, t) in ticks.enumerate() {
        // The clear sky for most, every weather over the day's dusk.
        let day = ((t % 24000) + 24000) % 24000
        if weather and (i % 3 == 0 or (11800 <= day and day <= 13800)) {
            let (r, th) = ws[i]
            record(mut records, t, r, th)
        } else {
            record(mut records, t, 0.0, 0.0)
        }
    }
    for (r, th) in ws {
        record(mut records, rng.pick([6000, 12000, 13000, 18000, 23000, 100]), r, th)
    }
    let input = obj([(String("type"), s(String(type_id))), (String("weather"), b(weather)), (String("read"), names(read_all()))])
    return obj([(String("id"), s("vanilla-{number}")), (String("input"), input), (String("blobs"), arr([s(base64(records))]))])
}

fn bounds_of(attr: str) -> (f64, f64?)? {
    for (name, bounds) in floats() {
        if name == attr {
            return bounds
        }
    }
    return none
}

fn is_boolean(attr: str) -> bool {
    return booleans().any(|x| x == attr)
}

/// A value of the float attribute `attr`, within its range where an override needs it.
fn float_value(rng: mut Rng, attr: str, op: str) -> f64 {
    if op == "override" {
        if let (lo, top) = bounds_of(attr) {
            let hi = top ?? 4096.0
            let a = lo + (hi - lo) * rng.unit()
            let c = lo + (hi - lo) * rng.unit()
            return f32_of(rng.pick_f64([lo, hi, a, c]))
        }
    }
    let wide = rng.unit() * 32.0 - 16.0
    let narrow = rng.unit() * 2.0
    let far = -rng.unit() * 600.0
    return f32_of(rng.pick_f64([0.0, 1.0, -1.0, 0.5, 2.0, 15.0, wide, narrow, far]))
}

fn argument(rng: mut Rng, attr: str, op: str) -> Json {
    if is_boolean(attr) {
        return b(rng.chance(0.5))
    }
    if op == "alpha_blend" {
        let value = float_value(mut rng, attr, op)
        if rng.chance(0.3) {
            return Json.Float(value)
        }
        let a = rng.unit()
        let c = rng.unit()
        let alpha = f32_of(rng.pick_f64([0.0, 1.0, 0.5, a, c]))
        return obj([(String("value"), Json.Float(value)), (String("alpha"), Json.Float(alpha))])
    }
    return Json.Float(float_value(mut rng, attr, op))
}

fn ops_of(attr: str) -> List<str> {
    var out: List<str> = []
    for o in if is_boolean(attr) { BOOL_OPS } else { FLOAT_OPS } {
        out.push(o)
    }
    return out
}

fn easing(rng: mut Rng) -> Json {
    if rng.chance(0.15) {
        let x1 = f32_of(rng.unit())
        let x2 = f32_of(rng.unit())
        let y1 = f32_of(rng.unit() * 3.0 - 1.0)
        let y2 = f32_of(rng.unit() * 3.0 - 1.0)
        return obj([(String("cubic_bezier"), arr([Json.Float(x1), Json.Float(y1), Json.Float(x2), Json.Float(y2)]))])
    }
    return s(String(EASINGS[usize.wrap(rng.below(32))]))
}

fn triple(ticks: List<i64>, i: usize) -> bool {
    return ticks[i] == ticks[i - 1] and ticks[i - 1] == ticks[i - 2]
}

fn track(rng: mut Rng, attr: str, period: i64?) -> Json {
    let op = rng.pick_str(ops_of(attr))
    let span = period ?? rng.pick([10, 100, 24000, 200000])
    let count = rng.pick([1, 2, 2, 3, 4, 6])
    var ticks: List<i64> = []
    for _ in 0..count {
        ticks.push(rng.below(span + 1))
    }
    ticks.sort()
    // A tick may come twice, never three times in a row.
    for i in 2..ticks.len() {
        if triple(ticks, i) {
            ticks[i] = if ticks[i] + 1 < span { ticks[i] + 1 } else { span }
        }
    }
    ticks.sort()
    for i in 2..ticks.len() {
        if triple(ticks, i) {
            ticks.truncate(i)
            break
        }
    }
    var keyframes: List<Json> = []
    for t in ticks {
        keyframes.push(obj([(String("ticks"), n(t)), (String("value"), argument(mut rng, attr, op))]))
    }
    var members: List<(String, Json)> = [(String("keyframes"), arr(keyframes)), (String("ease"), easing(mut rng))]
    var modified = op != "override"
    if not modified {
        modified = rng.chance(0.5)
    }
    if modified {
        members.push((String("modifier"), s(String(op))))
    }
    return obj(members)
}

fn pack_case(rng: mut Rng, number: i64) -> Json {
    let which = rng.below(3)
    let attrs = if which == 0 { read_all() } else if which == 1 { float_names() } else { booleans() }
    var mapping: List<(String, Json)> = []
    for attr in attrs {
        if rng.chance(0.4) {
            let op = rng.pick_str(ops_of(attr))
            let arg = argument(mut rng, attr, op)
            var plain = false
            if op == "override" {
                plain = rng.chance(0.5)
            }
            if plain {
                mapping.push((String(attr), arg))
            } else {
                mapping.push((String(attr), obj([(String("modifier"), s(String(op))), (String("argument"), arg)])))
            }
        }
    }
    var timelines: List<Json> = []
    var periods: List<i64> = []
    let lines = rng.pick([0, 1, 1, 2, 3])
    for _ in 0..lines {
        let choices: [i64?; 6] = [none, some(24000), some(100), some(7), some(192000), some(1)]
        let period = choices[usize.wrap(rng.below(6))]
        var tracks: List<(String, Json)> = []
        for attr in attrs {
            if rng.chance(0.35) {
                tracks.push((String(attr), track(mut rng, attr, period)))
            }
        }
        var t: List<(String, Json)> = [(String("clock"), s(String(CLOCKS[usize.wrap(rng.below(2))]))), (String("tracks"), obj(tracks))]
        if let p = period {
            t.push((String("period_ticks"), n(p)))
        }
        timelines.push(obj(t))
        periods.push(period ?? 200000)
    }
    var records: List<u8> = []
    var longest = 1000i64
    for p in periods {
        if p > longest {
            longest = p
        }
    }
    let ws = weathers(mut rng, 300)
    var i = 0usize
    while i < ws.len() {
        let (r, th) = ws[i]
        record(mut records, rng.below(longest * 3) - longest, r, th)
        i += 3
    }
    for _ in 0..300 {
        let t = if rng.chance(0.8) { rng.below(longest + 2) } else { rng.long() }
        if rng.chance(0.5) {
            record(mut records, t, 0.0, 0.0)
        } else {
            let r = f32_of(rng.unit())
            let th = f32_of(rng.unit())
            record(mut records, t, r, th)
        }
    }
    var input: List<(String, Json)> = [(String("weather"), b(rng.chance(0.6))), (String("read"), names(read_all()))]
    var mapped = mapping.len() > 0
    if not mapped {
        mapped = rng.chance(0.5)
    }
    if mapped {
        input.push((String("attributes_map"), obj(mapping)))
    }
    var timed = timelines.len() > 0
    if not timed {
        timed = rng.chance(0.5)
    }
    if timed {
        input.push((String("timelines"), arr(timelines)))
    }
    return obj([(String("id"), s("pack-{number}")), (String("input"), obj(input)), (String("blobs"), arr([s(base64(records))]))])
}

pub fn main() {
    var rng = Rng { r: splitmix64(SEED) }
    var cases: List<Json> = []
    let vanilla: List<(str, bool)> = [("minecraft:overworld", true), ("minecraft:overworld", false), ("minecraft:overworld_caves", false), ("minecraft:the_nether", false), ("minecraft:the_nether", true), ("minecraft:the_end", false)]
    for (number, (type_id, weather)) in vanilla.enumerate() {
        cases.push(vanilla_case(mut rng, number, type_id, weather))
    }
    for number in 0i64..40 {
        cases.push(pack_case(mut rng, number))
    }
    write_file(file("environment", "generated.json"), String("environment"), "cases/environment/gen.calx, seed {SEED}", cases, 1)
}
