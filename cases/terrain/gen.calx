module cases.terrain.gen

// Writes cases/terrain/generated.json: chunks filled by vanilla's noise settings, and base
// columns.
//
//     calx cases/terrain/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the same
// file.
//
// Each of vanilla's noise settings fills chunks of the world it's made for, near the origin and
// far out, and gives base columns and heights there; the Overworld's runs with many seeds, as its
// aquifers are where the most can differ. Then the settings fill worlds taller and shorter than
// their noise, worlds that only overlap it, and worlds it doesn't reach, where nothing is filled;
// and chunks and columns at the ends of `int`, where the aquifer's grid wraps.

import std.json.{Json}
import cases.kit.{arr, case, file, ints, n, obj, s}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}

const SEED: u64 = 20261104
const LONG_SEEDS: [str; 6] = ["0", "1", "-1", "9223372036854775807", "-9223372036854775808", "12345"]
const INT_MAX: i64 = 2147483647
const INT_MIN: i64 = -2147483648
// The world border, in chunks.
const BORDER: i64 = 1874999

/// A world, its lowest Y and its height.
struct Level {
    min_y: i64,
    height: i64,
}

const SURFACE: Level = Level { min_y: -64, height: 384 }
const NETHER: Level = Level { min_y: 0, height: 256 }

/// Each settings' world.
fn worlds() -> List<(str, Level)> {
    return [("overworld", SURFACE), ("large_biomes", SURFACE), ("amplified", SURFACE), ("caves", SURFACE), ("floating_islands", SURFACE), ("nether", NETHER), ("end", NETHER)]
}

fn world_of(settings: str) -> Level {
    for (name, level) in worlds() {
        if name == settings {
            return level
        }
    }
    return SURFACE
}

struct Gen {
    r: SplitMix64
}

impl Gen {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn between(mut self, lo: i64, hi: i64) -> i64 {
        return lo + self.below(hi - lo + 1)
    }

    fn seed(mut self) -> String {
        if self.below(4) == 0 {
            return String(LONG_SEEDS[usize.wrap(self.below(6))])
        }
        return "{i64.wrap(self.r.next())}"
    }

    /// A chunk within `spread` of the origin: x, then z.
    fn near(mut self, spread: i64) -> (i64, i64) {
        let x = self.between(-spread, spread)
        let z = self.between(-spread, spread)
        return (x, z)
    }

    fn far(mut self) -> (i64, i64) {
        return self.near(BORDER)
    }
}

struct Case {
    id: String,
    seed: String,
    settings: str,
    level: Level,
    ops: List<Json>,
}

impl Case {
    fn fill(mut self, at: (i64, i64)) {
        self.ops.push(arr([s("fill"), n(at.0), n(at.1)]))
    }

    fn column(mut self, x: i64, z: i64) {
        self.ops.push(arr([s("column"), n(x), n(z)]))
    }

    fn build(self) -> Json {
        let input = obj([(String("seed"), s(self.seed.copy())), (String("settings"), s("minecraft:{self.settings}")), (String("level"), ints([self.level.min_y, self.level.height])), (String("ops"), arr(self.ops.copy()))])
        return case(self.id.copy(), input)
    }
}

fn start(id: own String, seed: own String, settings: str, level: Level) -> Case {
    return Case { id: id, seed: seed, settings: settings, level: level, ops: [] }
}

fn columns(g: mut Gen, c: mut Case, count: i64, spread: i64) {
    for _ in 0..count {
        let x = g.between(-spread, spread)
        let z = g.between(-spread, spread)
        c.column(x, z)
    }
}

pub fn main() {
    var g = Gen { r: splitmix64(SEED) }
    var cases: List<Json> = []

    // Each settings in its world: the chunks at the origin, one near it, and columns around them.
    for (settings, level) in worlds() {
        var c = start("{settings}-origin", g.seed(), settings, level)
        c.fill((0, 0))
        c.fill((-1, -1))
        c.fill(g.near(64))
        c.column(0, 0)
        c.column(-1, -1)
        columns(mut g, mut c, 6, 1024)
        cases.push(c.build())
        var far = start("{settings}-far", g.seed(), settings, level)
        far.fill(g.far())
        let (x, z) = g.far()
        let column_x = x * 16 + g.below(16)
        let column_z = z * 16 + g.below(16)
        far.column(column_x, column_z)
        columns(mut g, mut far, 3, 30000000)
        cases.push(far.build())
        var spread = start("{settings}-columns", g.seed(), settings, level)
        columns(mut g, mut spread, 48, 4096)
        cases.push(spread.build())
    }

    // The Overworld and its kin with more seeds, for aquifers: oceans, caves and lava below.
    let kin: [str; 4] = ["overworld", "overworld", "large_biomes", "amplified"]
    for i in 0..24usize {
        let settings = kin[i % 4]
        var c = start("aquifers-{i}", g.seed(), settings, world_of(settings))
        c.fill(g.near(400))
        c.fill(g.near(400))
        cases.push(c.build())
    }

    // The same chunk twice, and its neighbours: each fill is a chunk of its own.
    var repeated = start(String("overworld-repeated"), String("20261104"), "overworld", SURFACE)
    for at in [(3i64, 5i64), (3, 5), (4, 5), (3, 6)] {
        repeated.fill(at)
    }
    cases.push(repeated.build())

    // Worlds that aren't the noise's: taller, shorter, overlapping its top or bottom, or past it.
    let levels: List<(str, Level)> = [
        ("tall", Level { min_y: -128, height: 512 }),
        ("short", Level { min_y: 0, height: 128 }),
        ("one-section", Level { min_y: -64, height: 16 }),
        ("top-section", Level { min_y: 304, height: 16 }),
        ("above", Level { min_y: 320, height: 64 }),
        ("below", Level { min_y: -2032, height: 16 }),
        ("whole", Level { min_y: -2032, height: 4064 }),
        ("low", Level { min_y: -512, height: 448 }),
    ]
    for (name, level) in levels {
        for settings in ["overworld", "nether"] {
            var c = start("level-{name}-{settings}", g.seed(), settings, level)
            c.fill(g.near(16))
            let x = g.between(-256, 256)
            let z = g.between(-256, 256)
            c.column(x, z)
            cases.push(c.build())
        }
    }
    var end = start(String("level-end-in-overworld"), g.seed(), "end", SURFACE)
    end.fill((0, 0))
    end.fill(g.near(200))
    end.column(0, 0)
    cases.push(end.build())

    // The ends of `int`, where blocks, quarts and the aquifer's grid wrap.
    for (i, at) in [((1i64 << 27) - 1, (1i64 << 27) - 1), (-(1i64 << 27), -(1i64 << 27))].enumerate() {
        var c = start("edge-{i}", g.seed(), "overworld", SURFACE)
        c.fill(at)
        cases.push(c.build())
    }
    // A column each, as the first that throws ends its case.
    for (i, x) in [INT_MAX, INT_MIN, INT_MAX - 5, INT_MIN + 4, INT_MAX - 40, INT_MIN + 40].enumerate() {
        for (j, z) in [INT_MAX, INT_MIN, 7].enumerate() {
            var c = start("edge-column-{i}-{j}", g.seed(), "overworld", SURFACE)
            c.column(x, z)
            cases.push(c.build())
        }
    }

    write_file(file("terrain", "generated.json"), String("terrain"), "cases/terrain/gen.calx, seed {SEED}", cases, 1)
}
