module cases.light.gen

// Writes cases/light/generated.json: chunks lit by vanilla's light engines, block light and sky
// light, as a server lights the chunks it makes and loads, and lit again as blocks change.
//
//     calx cases/light/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the same
// file.
//
// The states are 26.3's, picked for what light makes of them: air, and blocks that let light
// through whole or take one level from it, as glass, leaves and water; full blocks that stop it;
// blocks that give it, from a redstone torch's 7 to glowstone's and lava's 15, some of which stop
// it too; and blocks whose shape light sees, as slabs, stairs, snow and paths, which stop it only
// on some faces. The cases light flat chunks, terrain at random, caves under a roof, towers with
// empty sections between them, chunks with no neighbours, dimensions with no sky and of every
// height, and chunks loaded with light already saved, then change blocks and light them again.

import std.json.{Json}
import std.path
import rig.runner.cases.{SplitMix64, splitmix64, write_file}
import tools.repo.{under}

pub const SEED: u64 = 20261031

pub const AIR: i64 = 0
pub const STONE: i64 = 1
pub const GRASS_BLOCK: i64 = 9
pub const DIRT: i64 = 10
pub const BEDROCK: i64 = 88
pub const CAVE_AIR: i64 = 18650
pub const GLASS: i64 = 661
pub const TINTED_GLASS: i64 = 30518
pub const ICE: i64 = 8597
pub const COBWEB: i64 = 2362
pub const OAK_LEAVES: i64 = 294
pub const WATER: i64 = 89
pub const LAVA: i64 = 105
pub const TORCH: i64 = 4926
pub const SOUL_TORCH: i64 = 8676
pub const REDSTONE_TORCH: i64 = 8555
pub const END_ROD: i64 = 16615
pub const LANTERN: i64 = 24197
pub const GLOWSTONE: i64 = 8686
pub const SEA_LANTERN: i64 = 14739
pub const JACK_O_LANTERN: i64 = 8693
pub const SHROOMLIGHT: i64 = 24333
pub const MAGMA: i64 = 16826
pub const BEACON: i64 = 11722
pub const LAMP_ON: i64 = 11213
pub const LAMP_OFF: i64 = 11214
pub const SLAB_TOP: i64 = 15178
pub const SLAB_BOTTOM: i64 = 15180
pub const SLAB_DOUBLE: i64 = 15182
pub const SLAB_BOTTOM_WET: i64 = 15179
pub const STAIRS_NORTH: i64 = 5474
pub const STAIRS_EAST_TOP: i64 = 5524
pub const STAIRS_OUTER: i64 = 19170
pub const SNOW: i64 = 8589
pub const DIRT_PATH: i64 = 16796
pub const FARMLAND: i64 = 6875
pub const SCULK_SENSOR: i64 = 30521
pub const DAYLIGHT_DETECTOR: i64 = 13062
pub const LECTERN: i64 = 24144
pub const OAK_FENCE: i64 = 8666
pub const CHEST: i64 = 5544

fn clear() -> List<i64> {
    return [AIR, AIR, AIR, CAVE_AIR, GLASS, TINTED_GLASS, ICE, COBWEB, OAK_LEAVES, WATER, OAK_FENCE, CHEST]
}

fn solid() -> List<i64> {
    return [STONE, STONE, DIRT, BEDROCK, SLAB_DOUBLE, LAMP_OFF]
}

fn glows() -> List<i64> {
    return [TORCH, SOUL_TORCH, REDSTONE_TORCH, END_ROD, LANTERN, GLOWSTONE, SEA_LANTERN, JACK_O_LANTERN, SHROOMLIGHT, MAGMA, BEACON, LAMP_ON, LAVA, SCULK_SENSOR]
}

fn shaped() -> List<i64> {
    return [SLAB_TOP, SLAB_BOTTOM, SLAB_BOTTOM_WET, STAIRS_NORTH, STAIRS_EAST_TOP, STAIRS_OUTER, SNOW, DIRT_PATH, FARMLAND, DAYLIGHT_DETECTOR, LECTERN]
}

/// The states the random fills draw from: `CLEAR * 3 + SOLID * 3 + GLOW + SHAPED * 2`.
pub fn pool() -> List<i64> {
    var out: List<i64> = []
    for _ in 0..3 {
        out.extend(clear())
    }
    for _ in 0..3 {
        out.extend(solid())
    }
    out.extend(glows())
    for _ in 0..2 {
        out.extend(shaped())
    }
    return out
}

/// A dimension: its lowest y and its sections.
pub struct Dimension {
    min_y: i64
    sections: i64
}

pub const OVERWORLD: Dimension = Dimension { min_y: -64, sections: 24 }
pub const NETHER: Dimension = Dimension { min_y: 0, sections: 16 }

pub struct Gen {
    r: SplitMix64
}

pub fn gen(seed: u64) -> Gen {
    return Gen { r: splitmix64(seed) }
}

impl Gen {
    pub fn below(mut self, n: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(n))
    }

    /// A long for the probe's LCG, as text.
    pub fn seed(mut self) -> Json {
        return Json.Str("{i64.wrap(self.r.next())}")
    }
}

fn ints(values: List<i64>) -> Json {
    var out: List<Json> = []
    for v in values {
        out.push(Json.Int(v))
    }
    return Json.Array(out)
}

/// An op of a name and numbers.
pub fn op(name: str, values: List<i64>) -> Json {
    var out: List<Json> = [Json.Str(String(name))]
    for v in values {
        out.push(Json.Int(v))
    }
    return Json.Array(out)
}

/// A `random` op: `["random", changes, seed, count, states, x0, y0, z0, x1, y1, z1]`.
pub fn random(changes: i64, seed: own Json, count: i64, states: List<i64>, area: List<i64>) -> Json {
    var out: List<Json> = [Json.Str("random"), Json.Int(changes), seed, Json.Int(count), ints(states)]
    for v in area {
        out.push(Json.Int(v))
    }
    return Json.Array(out)
}

/// A case: its name, and the input the `light` probe reads.
pub fn case(name: own String, d: Dimension, sky: i64, ops: own List<Json>) -> Json {
    var input = LinkedMap<String, Json>()
    input.insert("min_y", Json.Int(d.min_y))
    input.insert("sections", Json.Int(d.sections))
    input.insert("sky", Json.Int(sky))
    input.insert("ops", Json.Array(ops))
    var c = LinkedMap<String, Json>()
    c.insert("id", Json.Str(name))
    c.insert("input", Json.Object(input))
    return Json.Object(c)
}

pub fn square(radius: i64) -> List<(i64, i64)> {
    var out: List<(i64, i64)> = []
    for x in -radius..=radius {
        for z in -radius..=radius {
            out.push((x, z))
        }
    }
    return out
}

/// The classic flat preset's layers in a chunk, set as generation sets them.
pub fn flat_fill(cx: i64, cz: i64, min_y: i64) -> List<Json> {
    let x = cx * 16
    let z = cz * 16
    var out: List<Json> = []
    for (i, s) in [BEDROCK, DIRT, DIRT, GRASS_BLOCK].enumerate() {
        let y = min_y + i64.wrap(i)
        out.push(op("fill", [x, y, z, x + 15, y, z + 15, s]))
    }
    return out
}

/// The INITIALIZE_LIGHT status for each chunk: its sky sources, its sections, and light on or
/// off, as `ThreadedLevelLightEngine.initializeLight` and a run between give them.
pub fn initialize(chunks: List<(i64, i64)>, lighted: bool) -> List<Json> {
    var out: List<Json> = []
    for (cx, cz) in chunks {
        out.push(op("sources", [cx, cz]))
        out.push(op("sections", [cx, cz]))
        out.push(op("run", []))
        out.push(op("enable", [cx, cz, if lighted { 1 } else { 0 }]))
        out.push(op("retain", [cx, cz, 0]))
    }
    return out
}

/// The LIGHT status for each chunk: its sources spread, then a run.
pub fn light(chunks: List<(i64, i64)>) -> List<Json> {
    var out: List<Json> = []
    for (cx, cz) in chunks {
        out.push(op("propagate", [cx, cz]))
        out.push(op("run", []))
    }
    return out
}

pub fn generate(chunks: List<(i64, i64)>) -> List<Json> {
    var out = initialize(chunks, false)
    out.extend(light(chunks))
    return out
}

/// Each chunk's light as a packet sends it, every section's layers, and light at `values`
/// random blocks.
fn look(chunks: List<(i64, i64)>, d: Dimension, g: mut Gen, values: i64, sky: i64) -> List<Json> {
    var out: List<Json> = [op("work", [])]
    for (cx, cz) in chunks {
        out.push(op("light", [cx, cz]))
        out.push(op("on", [cx, cz]))
        for sy in (d.min_y >> 4) - 1..(d.min_y >> 4) + d.sections + 1 {
            out.push(op("layer", [1, cx, sy, cz]))
            out.push(op("layer", [0, cx, sy, cz]))
        }
    }
    if values > 0 {
        var (x0, x1, z0, z1) = (i64.MAX, i64.MIN, i64.MAX, i64.MIN)
        for (cx, cz) in chunks {
            x0 = x0.min(cx)
            x1 = x1.max(cx)
            z0 = z0.min(cz)
            z1 = z1.max(cz)
        }
        for _ in 0..values {
            let x = x0 * 16 + g.below((x1 - x0 + 1) * 16)
            let z = z0 * 16 + g.below((z1 - z0 + 1) * 16)
            let y = d.min_y - 32 + g.below(d.sections * 16 + 64)
            let which = if sky != 0 { g.below(2) } else { 0 }
            out.push(op("value", [which, x, y, z]))
        }
    }
    return out
}

/// Each chunk's light as a packet sends it, without blocks at random.
fn look_plain(chunks: List<(i64, i64)>, d: Dimension) -> List<Json> {
    var unused = gen(0)
    return look(chunks, d, mut unused, 0, 1)
}

pub fn made(chunks: List<(i64, i64)>) -> List<Json> {
    var out: List<Json> = []
    for (cx, cz) in chunks {
        out.push(op("chunk", [cx, cz]))
    }
    return out
}

/// Flat ground in each chunk, made then filled.
fn flat_chunks(chunks: List<(i64, i64)>) -> List<Json> {
    var out = made(chunks)
    for (cx, cz) in chunks {
        out.extend(flat_fill(cx, cz, -64))
    }
    return out
}

/// Flat chunks, as `world.flat` sends them: the sky down to the grass, and no block light.
fn flat(g: mut Gen) -> Json {
    let chunks = square(1)
    var ops = flat_chunks(chunks)
    ops.extend(generate(chunks))
    ops.extend(look(chunks, OVERWORLD, mut g, 300, 1))
    return case(String("flat"), OVERWORLD, 1, ops)
}

/// A 5 by 5 of flat chunks lit in the order a player's view makes them, from the middle out.
fn flat_wide(g: mut Gen) -> Json {
    var chunks = square(2)
    chunks.sort_by_key(|c| (c.0.abs().max(c.1.abs()), c.0, c.1))
    var ops = flat_chunks(chunks)
    ops.extend(initialize(chunks, false))
    ops.extend(light(chunks))
    ops.extend(look(chunks[..9], OVERWORLD, mut g, 200, 1))
    return case(String("flat-wide"), OVERWORLD, 1, ops)
}

/// A block of each kind that gives light, on flat ground, lit as it's made.
fn glow(g: mut Gen) -> Json {
    let chunks = square(1)
    var ops = flat_chunks(chunks)
    for (i, state) in glows().enumerate() {
        let n = i64.wrap(i)
        let x = -14 + (n % 5) * 7
        let z = -14 + (n / 5) * 7
        ops.push(op("fill", [x, -60, z, x, -60 + n % 3, z, state]))
    }
    ops.extend(generate(chunks))
    ops.extend(look(chunks, OVERWORLD, mut g, 400, 1))
    return case(String("glow"), OVERWORLD, 1, ops)
}

/// Blocks of every kind at random, set as generation sets them, then lit.
fn terrain(g: mut Gen, name: str, d: Dimension, sky: i64, count: i64, low: i64, high: i64, radius: i64) -> Json {
    let chunks = square(radius)
    var ops = made(chunks)
    ops.push(op("fill", [-radius * 16, d.min_y, -radius * 16, radius * 16 + 15, d.min_y + 2, radius * 16 + 15, STONE]))
    let seed = g.seed()
    ops.push(random(0, seed, count, pool(), [-radius * 16, low, -radius * 16, radius * 16 + 15, high, radius * 16 + 15]))
    ops.extend(generate(chunks))
    ops.extend(look(chunks, d, mut g, 400, sky))
    return case(String(name), d, sky, ops)
}

/// A stone roof with holes over open ground: the sky comes in sideways under it, and the sources
/// move as the holes open and close.
fn caves(g: mut Gen) -> Json {
    let chunks = square(1)
    var ops = flat_chunks(chunks)
    ops.push(op("fill", [-16, -20, -16, 31, -18, 31, STONE]))
    for _ in 0..12 {
        let x = -16 + g.below(48)
        let z = -16 + g.below(48)
        let x1 = (x + g.below(3)).min(31)
        let z1 = (z + g.below(3)).min(31)
        ops.push(op("fill", [x, -20, z, x1, -18, z1, AIR]))
    }
    var states = glows()
    states.extend([GLASS, WATER, SLAB_TOP])
    let seed = g.seed()
    ops.push(random(0, seed, 300, states, [-16, -60, -16, 31, -21, 31]))
    ops.extend(generate(chunks))
    ops.extend(look(chunks, OVERWORLD, mut g, 300, 1))
    for _ in 0..40 {
        let x = -16 + g.below(48)
        let z = -16 + g.below(48)
        let y = -19 - g.below(2)
        let state = [AIR, STONE, GLASS, SLAB_BOTTOM, OAK_LEAVES][usize.wrap(g.below(5))]
        ops.push(op("set", [x, y, z, state]))
        if g.below(4) == 0 {
            ops.push(op("run", []))
        }
    }
    ops.push(op("run", []))
    ops.extend(look(chunks, OVERWORLD, mut g, 300, 1))
    return case(String("caves"), OVERWORLD, 1, ops)
}

/// Blocks high up and low down with empty sections between them, so sky light goes down past
/// sections kept for nothing, and comes out sideways at the bottom of the gap.
fn towers(g: mut Gen) -> Json {
    let chunks = square(1)
    var ops = made(chunks)
    ops.push(op("fill", [-16, -64, -16, 31, -62, 31, STONE]))
    ops.push(op("fill", [0, 200, 0, 15, 200, 15, STONE]))
    ops.push(op("fill", [3, 100, 3, 9, 140, 9, GLASS]))
    ops.push(op("fill", [-16, 40, 20, -10, 40, 31, LAVA]))
    let seed = g.seed()
    ops.push(random(0, seed, 600, pool(), [-16, 150, -16, 31, 260, 31]))
    ops.extend(generate(chunks))
    ops.extend(look(chunks, OVERWORLD, mut g, 400, 1))
    ops.push(op("set", [5, 200, 5, AIR]))
    ops.push(op("set", [0, 200, 0, AIR]))
    ops.push(op("set", [15, 200, 15, AIR]))
    ops.push(op("run", []))
    ops.push(op("set", [6, 140, 6, STONE]))
    ops.push(op("set", [6, 141, 6, TORCH]))
    ops.push(op("run", []))
    let again = g.seed()
    ops.push(random(1, again, 3000, [AIR], [3, 100, 3, 9, 140, 9]))
    for x in 3..10i64 {
        for z in 3..10i64 {
            ops.push(op("set", [x, 120, z, AIR]))
        }
    }
    ops.push(op("run", []))
    ops.extend(look(chunks, OVERWORLD, mut g, 300, 1))
    return case(String("towers"), OVERWORLD, 1, ops)
}

/// A chunk lit with no chunks around it: light stops at its edges as at bedrock, and its sky
/// sources around are taken to go on below the world.
fn alone(g: mut Gen) -> Json {
    let only: List<(i64, i64)> = [(0, 0)]
    var ops: List<Json> = [op("chunk", [0, 0])]
    ops.extend(flat_fill(0, 0, -64))
    let seed = g.seed()
    ops.push(random(0, seed, 800, pool(), [0, -60, 0, 15, -40, 15]))
    ops.extend(generate(only))
    ops.extend(look(only, OVERWORLD, mut g, 300, 1))
    ops.push(op("set", [0, -50, 0, GLOWSTONE]))
    ops.push(op("set", [15, -50, 15, TORCH]))
    ops.push(op("run", []))
    ops.extend(look(only, OVERWORLD, mut g, 100, 1))
    return case(String("alone"), OVERWORLD, 1, ops)
}

/// Chunks with nothing in some columns, open to the void, where the sky goes all the way down,
/// and a chunk with nothing at all.
fn open_void(g: mut Gen) -> Json {
    let chunks = square(1)
    var ops = made(chunks)
    ops.push(op("fill", [0, 0, 0, 15, 0, 15, STONE]))
    ops.push(op("fill", [4, 0, 4, 11, 0, 11, AIR]))
    ops.push(op("fill", [-16, 10, -16, -1, 10, -1, GLASS]))
    ops.push(op("fill", [16, 30, 16, 31, 30, 31, TORCH]))
    ops.extend(generate(chunks))
    ops.extend(look(chunks, OVERWORLD, mut g, 300, 1))
    ops.push(op("set", [8, 0, 8, STONE]))
    ops.push(op("set", [8, -64, 8, STONE]))
    ops.push(op("run", []))
    ops.push(op("set", [4, 0, 4, GLOWSTONE]))
    ops.push(op("run", []))
    ops.extend(look(chunks, OVERWORLD, mut g, 200, 1))
    return case(String("open-void"), OVERWORLD, 1, ops)
}

/// Lit terrain, then blocks changed at random as a world changes them, lit after each round.
fn edits(g: mut Gen, name: str, d: Dimension, sky: i64, rounds: i64, per_round: i64) -> Json {
    let chunks = square(1)
    let top = d.min_y + d.sections * 16 - 1
    var ops = made(chunks)
    ops.push(op("fill", [-16, d.min_y, -16, 31, d.min_y + 3, 31, STONE]))
    let seed = g.seed()
    ops.push(random(0, seed, 4000, pool(), [-16, d.min_y, -16, 31, (d.min_y + 80).min(top), 31]))
    ops.extend(generate(chunks))
    for r in 0..rounds {
        let low = d.min_y + g.below(80i64.min(d.sections * 16 - 16))
        let round_seed = g.seed()
        let high = (low + 15 + g.below(30)).min(top)
        ops.push(random(1, round_seed, per_round, pool(), [-16, low, -16, 31, high, 31]))
        ops.push(op("run", []))
        if r % 3 == 2 {
            ops.extend(look(chunks, d, mut g, 50, sky))
        }
    }
    ops.extend(look(chunks, d, mut g, 300, sky))
    return case(String(name), d, sky, ops)
}

/// Blocks checked that didn't change, and blocks outside any section light is kept for.
fn checks(g: mut Gen) -> Json {
    let chunks = square(1)
    var ops = flat_chunks(chunks)
    ops.push(op("fill", [2, -60, 2, 4, -58, 4, GLOWSTONE]))
    ops.extend(generate(chunks))
    for _ in 0..200 {
        let x = -16 + g.below(48)
        let y = -80 + g.below(400)
        let z = -16 + g.below(48)
        ops.push(op("check", [x, y, z]))
    }
    ops.push(op("run", []))
    ops.push(op("work", []))
    ops.extend(look(chunks, OVERWORLD, mut g, 200, 1))
    return case(String("checks"), OVERWORLD, 1, ops)
}

/// Sections emptied of blocks and filled again: light stops being kept for them and their
/// neighbours, and starts again, with the column's light kept and not.
fn emptied(g: mut Gen) -> Json {
    let chunks = square(1)
    var ops = flat_chunks(chunks)
    ops.push(op("fill", [0, 64, 0, 15, 64, 15, STONE]))
    ops.push(op("fill", [5, 65, 5, 5, 65, 5, TORCH]))
    ops.extend(generate(chunks))
    ops.extend(look_plain(chunks, OVERWORLD))
    // Empty the section at 64 to 79 a block at a time, keeping the column's light once.
    ops.push(op("retain", [0, 0, 1]))
    ops.push(op("set", [5, 65, 5, AIR]))
    for x in 0..16i64 {
        for z in 0..16i64 {
            ops.push(op("set", [x, 64, z, AIR]))
        }
    }
    ops.push(op("work", []))
    ops.push(op("run", []))
    ops.extend(look_plain(chunks, OVERWORLD))
    ops.push(op("retain", [0, 0, 0]))
    ops.push(op("set", [8, 70, 8, GLOWSTONE]))
    ops.push(op("run", []))
    ops.extend(look_plain(chunks, OVERWORLD))
    ops.push(op("set", [8, 70, 8, AIR]))
    ops.push(op("run", []))
    ops.extend(look(chunks, OVERWORLD, mut g, 200, 1))
    ops.push(op("status", [3, 10, 3, 0]))
    ops.push(op("run", []))
    ops.push(op("status", [3, 10, 3, 1]))
    ops.push(op("status", [3, 10, 3, 1]))
    ops.push(op("run", []))
    ops.extend(look_plain([(3, 3)], OVERWORLD))
    return case(String("emptied"), OVERWORLD, 1, ops)
}

/// A queued layer: none, all one level, or at random from a seed.
fn layer(g: mut Gen, kind: i64) -> List<Json> {
    if kind == 0 {
        return [Json.Int(0), Json.Int(0)]
    }
    if kind == 1 {
        return [Json.Int(1), Json.Int(g.below(16))]
    }
    return [Json.Int(2), g.seed()]
}

/// A `queue` op: `["queue", sky, cx, sy, cz]` and the layer.
fn queue(values: List<i64>, layer_of: List<Json>) -> Json {
    var out: List<Json> = [Json.Str("queue")]
    for v in values {
        out.push(Json.Int(v))
    }
    out.extend(layer_of)
    return Json.Array(out)
}

/// Chunks loaded with their light saved, as `ChunkSerializer` queues it, lighted, so their
/// sources don't spread, and one saved with no light, which `setLightEnabled` fills.
fn loaded(g: mut Gen) -> Json {
    let chunks = square(1)
    var ops = flat_chunks(chunks)
    ops.push(op("fill", [0, -60, 0, 3, -50, 3, GLOWSTONE]))
    for (cx, cz) in chunks {
        ops.push(op("retain", [cx, cz, 1]))
        // The middle chunk is saved with no light at all: its layers are drawn, and left out.
        let kept = not (cx == 0 and cz == 0)
        for sy in -5..2i64 {
            if g.below(3) != 0 {
                let kind = g.below(3)
                let l = layer(mut g, kind)
                if kept {
                    ops.push(queue([1, cx, sy, cz], l))
                }
            }
            if g.below(2) != 0 {
                let kind = g.below(3)
                let l = layer(mut g, kind)
                if kept {
                    ops.push(queue([0, cx, sy, cz], l))
                }
            }
        }
    }
    ops.extend(initialize(chunks, true))
    ops.push(op("run", []))
    ops.extend(look(chunks, OVERWORLD, mut g, 300, 1))
    // A section loaded for a chunk that then goes, and one queued and taken back.
    let first = layer(mut g, 2)
    ops.push(queue([1, 5, 0, 5], first))
    let second = layer(mut g, 2)
    ops.push(queue([0, 5, 0, 5], second))
    ops.push(op("work", []))
    ops.push(op("queue", [0, 5, 0, 5, 0, 0]))
    ops.push(op("run", []))
    ops.push(op("set", [1, -49, 1, TORCH]))
    ops.push(op("set", [7, -60, 7, AIR]))
    ops.push(op("run", []))
    ops.extend(look(chunks, OVERWORLD, mut g, 300, 1))
    return case(String("loaded"), OVERWORLD, 1, ops)
}

/// A dimension with no sky, lava and glowstone in netherrack's place.
fn nether(g: mut Gen) -> Json {
    let chunks = square(1)
    var ops = made(chunks)
    ops.push(op("fill", [-16, 0, -16, 31, 4, 31, STONE]))
    ops.push(op("fill", [-16, 120, -16, 31, 127, 31, STONE]))
    ops.push(op("fill", [-16, 31, -16, 31, 31, 31, LAVA]))
    let seed = g.seed()
    ops.push(random(0, seed, 3000, [STONE, STONE, AIR, AIR, AIR, GLOWSTONE, LAVA, MAGMA, SHROOMLIGHT, SLAB_TOP], [-16, 5, -16, 31, 119, 31]))
    ops.extend(generate(chunks))
    ops.extend(look(chunks, NETHER, mut g, 400, 0))
    let again = g.seed()
    ops.push(random(1, again, 300, [AIR, STONE, GLOWSTONE, TORCH], [-16, 30, -16, 31, 60, 31]))
    ops.push(op("run", []))
    ops.extend(look(chunks, NETHER, mut g, 200, 0))
    return case(String("nether"), NETHER, 0, ops)
}

fn heights(g: mut Gen) -> List<Json> {
    var out: List<Json> = []
    let dims: List<(str, Dimension)> = [("one-section", Dimension { min_y: 16, sections: 1 }), ("tall", Dimension { min_y: -2032, sections: 254 }), ("low", Dimension { min_y: -2032, sections: 16 }), ("high", Dimension { min_y: 1920, sections: 7 })]
    for (name, d) in dims {
        let top = d.min_y + d.sections * 16 - 1
        let chunks = square(1)
        var ops = made(chunks)
        ops.push(op("fill", [-16, d.min_y, -16, 31, d.min_y, 31, STONE]))
        let seed = g.seed()
        ops.push(random(0, seed, 3000, pool(), [-16, d.min_y, -16, 31, top, 31]))
        let seen: List<(i64, i64)> = if d.sections > 64 { [(0, 0)] } else { chunks.copy() }
        ops.extend(generate(chunks))
        ops.extend(look(seen, d, mut g, 200, 1))
        let again = g.seed()
        ops.push(random(1, again, 300, pool(), [-16, d.min_y, -16, 31, top, 31]))
        ops.push(op("run", []))
        ops.extend(look(seen, d, mut g, 200, 1))
        out.push(case(String(name), d, 1, ops))
    }
    return out
}

/// Chunks made a ring at a time, each ring lit while the one inside is already lit, as a world
/// grows around its players, then blocks changed across the rings' edges.
fn growing(g: mut Gen) -> Json {
    var ops: List<Json> = []
    var done: List<(i64, i64)> = []
    for ring in 0..3i64 {
        var chunks: List<(i64, i64)> = []
        for c in square(ring) {
            if not done.contains(c) {
                chunks.push(c)
            }
        }
        ops.extend(flat_chunks(chunks))
        let x0 = -ring * 16
        let seed = g.seed()
        ops.push(random(0, seed, 1500 * (ring + 1), pool(), [x0, -60, x0, ring * 16 + 15, 0, ring * 16 + 15]))
        ops.extend(generate(chunks))
        done.extend(chunks)
    }
    ops.extend(look(square(1), OVERWORLD, mut g, 300, 1))
    let seed = g.seed()
    ops.push(random(1, seed, 2000, pool(), [-32, -64, -32, 47, 20, 47]))
    ops.push(op("run", []))
    ops.extend(look(square(1), OVERWORLD, mut g, 300, 1))
    return case(String("growing"), OVERWORLD, 1, ops)
}

/// Every operation at random over lit terrain: blocks set, checked and told empty, chunks' light
/// turned on and off, kept and let go, light queued and spread again, and runs between, so the
/// engines meet what a world does in any order.
fn chaos(g: mut Gen, name: String, d: Dimension, sky: i64, count: i64) -> Json {
    let top = d.min_y + d.sections * 16 - 1
    let low = (d.min_y >> 4) - 1
    let high = (d.min_y >> 4) + d.sections
    let chunks = square(1)
    let states = pool()
    var ops = made(chunks)
    ops.push(op("fill", [-16, d.min_y, -16, 31, d.min_y + 2, 31, STONE]))
    let seed = g.seed()
    ops.push(random(0, seed, 6000, states.copy(), [-16, d.min_y, -16, 31, (d.min_y + 100).min(top), 31]))
    ops.extend(generate(chunks))
    for _ in 0..count {
        let kind = g.below(100)
        if kind < 45 {
            let x = -16 + g.below(48)
            let y = d.min_y + g.below(120i64.min(d.sections * 16))
            let z = -16 + g.below(48)
            let state = states[usize.wrap(g.below(i64.wrap(states.len())))]
            ops.push(op("set", [x, y, z, state]))
        } else if kind < 55 {
            let x = -24 + g.below(64)
            let y = d.min_y - 16 + g.below(d.sections * 16 + 32)
            let z = -24 + g.below(64)
            ops.push(op("check", [x, y, z]))
        } else if kind < 62 {
            let cx = -2 + g.below(5)
            let sy = low + g.below(high - low + 1)
            let cz = -2 + g.below(5)
            let empty = g.below(2)
            ops.push(op("status", [cx, sy, cz, empty]))
        } else if kind < 66 {
            let cx = -2 + g.below(5)
            let cz = -2 + g.below(5)
            let on = g.below(2)
            ops.push(op("enable", [cx, cz, on]))
        } else if kind < 70 {
            let cx = -2 + g.below(5)
            let cz = -2 + g.below(5)
            let keep = g.below(2)
            ops.push(op("retain", [cx, cz, keep]))
        } else if kind < 74 {
            let cx = -2 + g.below(5)
            let cz = -2 + g.below(5)
            ops.push(op("propagate", [cx, cz]))
        } else if kind < 80 {
            let which = g.below(2)
            let cx = -2 + g.below(5)
            let sy = low + g.below(high - low + 1)
            let cz = -2 + g.below(5)
            let layer_kind = g.below(3)
            let l = layer(mut g, layer_kind)
            ops.push(queue([which, cx, sy, cz], l))
        } else if kind < 84 {
            let which = if sky != 0 { g.below(2) } else { 0 }
            let x = -24 + g.below(64)
            let y = d.min_y - 32 + g.below(d.sections * 16 + 64)
            let z = -24 + g.below(64)
            ops.push(op("value", [which, x, y, z]))
        } else if kind < 86 {
            ops.push(op("work", []))
        } else if kind < 88 {
            let cx = -2 + g.below(5)
            let cz = -2 + g.below(5)
            ops.push(op("on", [cx, cz]))
        } else if kind < 89 {
            let cx = -2 + g.below(5)
            let cz = -2 + g.below(5)
            ops.push(op("light", [cx, cz]))
        } else {
            ops.push(op("run", []))
        }
    }
    ops.push(op("run", []))
    ops.extend(look(chunks, d, mut g, 300, sky))
    return case(name.copy(), d, sky, ops)
}

/// Light queued, sections told empty and not, columns' light turned on and off and kept, with the
/// light read between and runs now and then: what's read before a run is what the run before
/// left, and what's queued for a section that's started is the section's own light.
fn churn(g: mut Gen, name: String, sky: i64, count: i64) -> Json {
    let chunks = square(1)
    let states = pool()
    var ops = flat_chunks(chunks)
    let seed = g.seed()
    ops.push(random(0, seed, 1500, states.copy(), [-16, -60, -16, 31, -20, 31]))
    ops.extend(generate(chunks))
    for _ in 0..count {
        let kind = g.below(100)
        if kind < 20 {
            let which = g.below(2)
            let cx = -1 + g.below(3)
            let sy = -5 + g.below(6)
            let cz = -1 + g.below(3)
            let layer_kind = g.below(3)
            let l = layer(mut g, layer_kind)
            ops.push(queue([which, cx, sy, cz], l))
        } else if kind < 35 {
            let cx = -1 + g.below(3)
            let sy = -5 + g.below(6)
            let cz = -1 + g.below(3)
            let empty = g.below(2)
            ops.push(op("status", [cx, sy, cz, empty]))
        } else if kind < 45 {
            let cx = -1 + g.below(3)
            let cz = -1 + g.below(3)
            let on = g.below(2)
            ops.push(op("enable", [cx, cz, on]))
        } else if kind < 52 {
            let cx = -1 + g.below(3)
            let cz = -1 + g.below(3)
            let keep = g.below(2)
            ops.push(op("retain", [cx, cz, keep]))
        } else if kind < 56 {
            let cx = -1 + g.below(3)
            let cz = -1 + g.below(3)
            ops.push(op("propagate", [cx, cz]))
        } else if kind < 64 {
            let x = -16 + g.below(48)
            let y = -64 + g.below(64)
            let z = -16 + g.below(48)
            let state = states[usize.wrap(g.below(i64.wrap(states.len())))]
            ops.push(op("set", [x, y, z, state]))
        } else if kind < 80 {
            let which = g.below(2)
            let cx = -1 + g.below(3)
            let sy = -5 + g.below(6)
            let cz = -1 + g.below(3)
            ops.push(op("layer", [which, cx, sy, cz]))
        } else if kind < 88 {
            let which = g.below(2)
            let x = -16 + g.below(48)
            let y = -96 + g.below(100)
            let z = -16 + g.below(48)
            ops.push(op("value", [which, x, y, z]))
        } else if kind < 90 {
            let cx = -1 + g.below(3)
            let cz = -1 + g.below(3)
            ops.push(op("light", [cx, cz]))
        } else if kind < 92 {
            ops.push(op("work", []))
        } else {
            ops.push(op("run", []))
        }
    }
    ops.push(op("run", []))
    ops.extend(look(chunks, OVERWORLD, mut g, 200, 1))
    return case(name.copy(), OVERWORLD, sky, ops)
}

pub fn main() {
    var g = gen(SEED)
    var cases: List<Json> = [flat(mut g), flat_wide(mut g), glow(mut g)]
    cases.push(terrain(mut g, "terrain-low", OVERWORLD, 1, 20000, -64, -1, 1))
    cases.push(terrain(mut g, "terrain-surface", OVERWORLD, 1, 12000, 40, 100, 1))
    cases.push(terrain(mut g, "terrain-sparse", OVERWORLD, 1, 2000, -64, 319, 2))
    cases.push(caves(mut g))
    cases.push(towers(mut g))
    cases.push(alone(mut g))
    cases.push(open_void(mut g))
    cases.push(checks(mut g))
    cases.push(emptied(mut g))
    cases.push(loaded(mut g))
    cases.push(edits(mut g, "edits", OVERWORLD, 1, 9, 300))
    cases.push(edits(mut g, "edits-many", OVERWORLD, 1, 4, 3000))
    cases.push(nether(mut g))
    cases.extend(heights(mut g))
    cases.push(growing(mut g))
    for i in 0..6 {
        cases.push(chaos(mut g, "chaos-{i}", OVERWORLD, 1, 3000))
    }
    cases.push(chaos(mut g, String("chaos-nether"), NETHER, 0, 3000))
    cases.push(chaos(mut g, String("chaos-one-section"), Dimension { min_y: 0, sections: 1 }, 1, 2000))
    for i in 0..4 {
        cases.push(churn(mut g, "churn-{i}", 1, 4000))
    }
    cases.push(churn(mut g, String("churn-no-sky"), 0, 4000))
    write_file(path.join(under("cases/light"), "generated.json"), String("light"), "cases/light/gen.calx, seed {SEED}", cases, 1)
}
