module cases.structures.gen

// Writes cases/structures/generated.json: where vanilla's structure sets place structures, and
// the structure starts made there.
//
//     calx cases/structures/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED and from the names in vanilla's
// data pack, so rerunning it gives the same file.
//
// Every settings' world is asked which chunks of a square near the origin and one far out each
// structure set places in, and the Overworld's worlds where their strongholds' rings are. Then
// each structure in `worldgen/structure` is started in a world of one biome it may start in, at
// the chunks its set's random spread picks near the origin and far out, which the cases work out
// with Java's `Random` as `RandomSpreadStructurePlacement` does; whether the start is made there
// is vanilla's to say. The strongholds start at their rings' first positions.
//
// Last, each kind of structure that adapts the terrain about it gets a world where its terrain is
// filled, with its structures' beardifier, at a chunk its set may place it in and one beside
// another; the strongholds' at their rings' first position.

import std.json.{Json}
import cases.jar.{json_files, vanilla}
import cases.kit.{arr, case, file, ints, n, obj, s}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}
import tools.repo.{die}

const SEED: u64 = 20261109
const LONG_SEEDS: [str; 6] = ["0", "1", "-1", "9223372036854775807", "-9223372036854775808", "12345"]
const MASK: u64 = 0xFFFFFFFFFFFF
const NETHER: [str; 5] = ["nether_wastes", "soul_sand_valley", "crimson_forest", "warped_forest", "basalt_deltas"]
const END: [str; 5] = ["the_end", "end_highlands", "end_midlands", "small_end_islands", "end_barrens"]
// Structures whose starts the chunks a case tries seldom make.
const RARE: [str; 2] = ["end_city", "pillager_outpost"]
// Structures that adapt the terrain, one of each kind of adaptation and each village.
const BEARDED: [str; 11] = ["abandoned_camp_forest", "ancient_city", "nether_fossil", "pillager_outpost", "trail_ruins", "trial_chambers", "village_desert", "village_plains", "village_savanna", "village_snowy", "village_taiga"]

/// Each settings' world: its lowest Y and height, and the biome source its own world has.
fn worlds() -> List<(str, i64, i64, str)> {
    return [("overworld", -64, 384, "overworld"), ("large_biomes", -64, 384, "overworld"), ("amplified", -64, 384, "overworld"), ("caves", -64, 384, "overworld"), ("floating_islands", -64, 384, "overworld"), ("nether", 0, 256, "nether"), ("end", 0, 256, "end")]
}

fn level_of(settings: str) -> (i64, i64) {
    for (name, min_y, height, _) in worlds() {
        if name == settings {
            return (min_y, height)
        }
    }
    die("no settings {settings}")
}

struct Gen {
    r: SplitMix64
}

impl Gen {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn between(mut self, lo: i64, hi: i64) -> i64 {
        return lo + self.below(hi - lo + 1)
    }

    fn seed(mut self) -> String {
        if self.below(4) == 0 {
            return String(LONG_SEEDS[usize.wrap(self.below(6))])
        }
        return "{i64.wrap(self.r.next())}"
    }
}

/// `LegacyRandomSource`: Java's `Random`.
struct JavaRandom {
    s: u64,
}

fn java_random(seed: i64) -> JavaRandom {
    return JavaRandom { s: (u64.wrap(seed) ^ 0x5DEECE66D) & MASK }
}

impl JavaRandom {
    fn next(mut self, bits: i64) -> i64 {
        self.s = (self.s * 0x5DEECE66D + 0xB) & MASK
        let r = i64.wrap(self.s >> u64.wrap(48 - bits))
        // Java's int: only 32 bits can come out negative.
        if bits == 32 and r >= 1i64 << 31 {
            return r - (1i64 << 32)
        }
        return r
    }

    fn next_int(mut self, bound: i64) -> i64 {
        if bound & (bound - 1) == 0 {
            return (bound * self.next(31)) >> 31
        }
        loop {
            let sample = self.next(31)
            let modulo = sample % bound
            if sample - modulo + (bound - 1) < 1i64 << 31 {
                return modulo
            }
        }
    }

    fn next_float(mut self) -> f64 {
        return f64.nearest(self.next(24)) / 16777216.0
    }

    fn next_double(mut self) -> f64 {
        let high = self.next(26) << 27
        let low = self.next(27)
        return f64.nearest(high + low) * (1.0 / 9007199254740992.0)
    }
}

fn large_feature_with_salt(seed: i64, x: i64, z: i64, salt: i64) -> JavaRandom {
    return java_random(x * 341873128712 + z * 132897987541 + seed + salt)
}

/// `setLargeFeatureSeed`: two longs from the seed, mixed with the chunk.
fn large_feature(seed: i64, x: i64, z: i64) -> JavaRandom {
    var r = java_random(seed)
    let a_high = r.next(32) << 32
    let a = a_high + r.next(32)
    let b_high = r.next(32) << 32
    let b = b_high + r.next(32)
    return java_random((x * a) ^ (z * b) ^ seed)
}

fn m(name: str) -> String {
    return "minecraft:{name}"
}

fn bare(name: String) -> String {
    if name.starts_with("minecraft:") {
        return name[10..name.len()]
    }
    return name.copy()
}

fn preset(name: str) -> Json {
    if name == "end" {
        return obj([(String("type"), s("minecraft:the_end"))])
    }
    return obj([(String("type"), s("minecraft:multi_noise")), (String("preset"), s(m(name)))])
}

fn fixed(biome: String) -> Json {
    return obj([(String("type"), s("minecraft:fixed")), (String("biome"), s("minecraft:{biome}"))])
}

fn world_of(biome: String) -> str {
    if NETHER.any(|b| b == biome) {
        return "nether"
    }
    if END.any(|b| b == biome) {
        return "end"
    }
    return "overworld"
}

fn find(files: List<(String, Json)>, name: String) -> Json {
    for (key, v) in files {
        if key == name {
            return v.copy()
        }
    }
    die("no {name} in the jar")
}

/// The biomes a holder set names, tags resolved, in order.
fn biomes_of(value: Json, tags: List<(String, Json)>) -> List<String> {
    var out: List<String> = []
    if let Json.Array(items) = value {
        for v in items {
            out.extend(biomes_of(v, tags))
        }
        return out
    }
    let text = value.as_str() ?? String("")
    if text.starts_with("#") {
        let tag = find(tags, bare(text[1..text.len()]))
        if let Json.Array(values) = tag.get(String("values")) ?? Json.Null {
            for v in values {
                let id = if let Json.Object(_) = v { v.get(String("id")) ?? Json.Null } else { v.copy() }
                out.extend(biomes_of(id, tags))
            }
        }
        return out
    }
    out.push(bare(text))
    return out
}

/// A structure set's placement, as the cases read it.
struct Placement {
    kind: String,
    spacing: i64,
    separation: i64,
    salt: i64,
    triangular: bool,
    frequency: f64,
    method: String,
}

fn int_of(p: Json, key: str, fallback: i64) -> i64 {
    if let v = p.get(String(key)) {
        return v.as_i64() ?? fallback
    }
    return fallback
}

fn text_of(p: Json, key: str, fallback: str) -> String {
    if let v = p.get(String(key)) {
        return v.as_str() ?? String(fallback)
    }
    return String(fallback)
}

fn placement_of(p: Json) -> Placement {
    var frequency = 1.0
    if let v = p.get(String("frequency")) {
        frequency = v.as_f64() ?? 1.0
    }
    return Placement { kind: text_of(p, "type", ""), spacing: int_of(p, "spacing", 0), separation: int_of(p, "separation", 0), salt: int_of(p, "salt", 0), triangular: text_of(p, "spread_type", "linear") == "triangular", frequency: frequency, method: text_of(p, "frequency_reduction_method", "default") }
}

/// `RandomSpreadStructurePlacement.getPotentialStructureChunk` of the grid cell.
fn spread_chunk(seed: i64, p: Placement, gx: i64, gz: i64) -> (i64, i64) {
    var r = large_feature_with_salt(seed, gx, gz, p.salt)
    let limit = p.spacing - p.separation
    var x = 0i64
    var z = 0i64
    if p.triangular {
        let x1 = r.next_int(limit)
        x = (x1 + r.next_int(limit)) / 2
        let z1 = r.next_int(limit)
        z = (z1 + r.next_int(limit)) / 2
    } else {
        x = r.next_int(limit)
        z = r.next_int(limit)
    }
    return (gx * p.spacing + x, gz * p.spacing + z)
}

/// `applyAdditionalChunkRestrictions`.
fn passes_frequency(seed: i64, p: Placement, x: i64, z: i64) -> bool {
    if p.frequency >= 1.0 {
        return true
    }
    if p.method == "default" {
        var r = large_feature_with_salt(seed, x, z, p.salt)
        return r.next_float() < p.frequency
    }
    if p.method == "legacy_type_2" {
        var r = large_feature_with_salt(seed, x, z, 10387320)
        return r.next_float() < p.frequency
    }
    if p.method == "legacy_type_3" {
        var r = large_feature(seed, x, z)
        return r.next_double() < p.frequency
    }
    var r = java_random((x >> 4) ^ ((z >> 4) << 4) ^ seed)
    _ = r.next(32)
    return r.next_int(i64.saturate(1.0 / p.frequency)) == 0
}

/// Chunks the placement may place in: near the origin, or far out.
fn candidates(g: mut Gen, seed_text: String, p: Placement, count: usize, far: bool) -> List<(i64, i64)> {
    let seed = i64.parse(seed_text) ?? 0
    var found: List<(i64, i64)> = []
    let reach = if far { 30000i64 } else { 6 }
    let cx = g.between(-reach, reach)
    let cz = g.between(-reach, reach)
    if p.spacing == 1 {
        var tries = 0i64
        while found.len() < count and tries < 20000 {
            let x = cx + tries % 141
            let z = cz + tries / 141
            if passes_frequency(seed, p, x, z) {
                found.push((x, z))
            }
            tries += 1
        }
        return found
    }
    // Grid cells about the chunk, those whose chunk the frequency keeps.
    var k = 0i64
    while found.len() < count and k < 400 {
        let gx = (cx * 16).floor_div(p.spacing * 16) + k % 20
        let gz = (cz * 16).floor_div(p.spacing * 16) + k / 20
        let (x, z) = spread_chunk(seed, p, gx, gz)
        if passes_frequency(seed, p, x, z) {
            found.push((x, z))
        }
        k += 1
    }
    return found
}

struct Case {
    id: String,
    seed: String,
    settings: str,
    source: Json,
    ops: List<Json>,
}

impl Case {
    fn op(mut self, name: str, values: List<i64>) {
        var parts: List<Json> = [s(String(name))]
        for v in values {
            parts.push(n(v))
        }
        self.ops.push(arr(parts))
    }

    fn build(self) -> Json {
        let (min_y, height) = level_of(self.settings)
        return case(self.id.copy(), obj([(String("seed"), s(self.seed.copy())), (String("settings"), s(m(self.settings))), (String("level"), ints([min_y, height])), (String("source"), self.source.copy()), (String("ops"), arr(self.ops.copy()))]))
    }
}

fn start(id: own String, seed: own String, settings: str, source: own Json) -> Case {
    return Case { id: id, seed: seed, settings: settings, source: source, ops: [] }
}

fn placements(g: mut Gen, cases: mut List<Json>) {
    for (settings, _, _, source) in worlds() {
        for i in 0..2 {
            var c = start("placement-{settings}-{i}", g.seed(), settings, preset(source))
            c.op("placement", [-32, -32, 64])
            let x = g.between(-1900, 1900)
            let z = g.between(-1900, 1900)
            c.op("placement", [x, z, 32])
            cases.push(c.build())
        }
    }
}

fn rings(g: mut Gen, cases: mut List<Json>) {
    for settings in ["overworld", "large_biomes", "amplified"] {
        for i in 0..2 {
            var c = start("rings-{settings}-{i}", g.seed(), settings, preset("overworld"))
            c.op("rings", [])
            cases.push(c.build())
        }
    }
    for biome in ["plains", "desert"] {
        var c = start("rings-fixed-{biome}", g.seed(), "overworld", fixed(String(biome)))
        c.op("rings", [])
        cases.push(c.build())
    }
}

/// Each structure's set: the first set, in name order, that has it.
fn set_of(sets: List<(String, Json)>, structure: String) -> String? {
    for (id, set) in sets {
        if let Json.Array(entries) = set.get(String("structures")) ?? Json.Null {
            for entry in entries {
                let named = entry.get(String("structure")) ?? Json.Null
                if bare(named.as_str() ?? String("")) == structure {
                    return some(id.copy())
                }
            }
        }
    }
    return none
}

fn placement_for(sets: List<(String, Json)>, structure: String) -> Placement? {
    let set = set_of(sets, structure.copy()) else {
        return none
    }
    return some(placement_of(find(sets, set).get(String("placement")) ?? Json.Null))
}

fn starts(g: mut Gen, cases: mut List<Json>, sets: List<(String, Json)>, structures: List<(String, Json)>, tags: List<(String, Json)>) {
    var sorted = structures.copy()
    sorted.sort_by(|a, b| a.0.cmp(b.0))
    for (id, structure) in sorted {
        let biomes = biomes_of(structure.get(String("biomes")) ?? Json.Null, tags)
        if biomes.len() == 0 {
            continue
        }
        let biome = biomes[usize.wrap(g.below(i64.wrap(biomes.len())))].copy()
        let settings = world_of(biome.copy())
        let placement = placement_for(sets, id.copy())
        let seed = g.seed()
        var c = start("starts-{id}", seed.copy(), settings, fixed(biome))
        let p = placement else {
            continue
        }
        if p.kind != "minecraft:random_spread" {
            if p.kind == "minecraft:concentric_rings" {
                c.op("ring_starts", [3])
                cases.push(c.build())
            }
            continue
        }
        // Structures that start rarely where they may get more chunks to try.
        let rare = RARE.any(|r| r == id)
        let near_count = if rare { 16usize } else { 4 }
        let far_count = if rare { 8usize } else { 2 }
        var chunks = candidates(mut g, seed.copy(), p, near_count, false)
        chunks.extend(candidates(mut g, seed, p, far_count, true))
        for (x, z) in chunks {
            c.op("starts", [x, z])
        }
        cases.push(c.build())
    }
    for i in 0..3 {
        var c = start("starts-strongholds-{i}", g.seed(), "overworld", preset("overworld"))
        c.op("ring_starts", [4])
        cases.push(c.build())
    }
}

fn bearded(g: mut Gen, cases: mut List<Json>, sets: List<(String, Json)>, structures: List<(String, Json)>, tags: List<(String, Json)>) {
    for id in BEARDED {
        let biomes = biomes_of(find(structures, String(id)).get(String("biomes")) ?? Json.Null, tags)
        let biome = biomes[usize.wrap(g.below(i64.wrap(biomes.len())))].copy()
        let seed = g.seed()
        var c = start("bearded-{id}", seed.copy(), world_of(biome.copy()), fixed(biome))
        let p = placement_for(sets, String(id)) else {
            die("{id} is in no structure set")
        }
        let found = candidates(mut g, seed, p, 2, false)
        c.op("bearded", [found[0].0, found[0].1])
        c.op("bearded", [found[1].0 + 1, found[1].1 - 1])
        cases.push(c.build())
    }
    var c = start(String("bearded-strongholds"), g.seed(), "overworld", preset("overworld"))
    c.op("ring_bearded", [0])
    cases.push(c.build())
}

pub fn main() {
    var g = Gen { r: splitmix64(SEED) }
    let jar = vanilla()
    let sets = json_files(jar, "data/minecraft/worldgen/structure_set/")
    let structures = json_files(jar, "data/minecraft/worldgen/structure/")
    let tags = json_files(jar, "data/minecraft/tags/worldgen/biome/")
    var cases: List<Json> = []
    placements(mut g, mut cases)
    rings(mut g, mut cases)
    starts(mut g, mut cases, sets, structures, tags)
    bearded(mut g, mut cases, sets, structures, tags)
    write_file(file("structures", "generated.json"), String("structures"), "cases/structures/gen.calx, seed {SEED}", cases, 2)
}
