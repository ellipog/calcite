module cases.chunk_nbt.gen

// Writes cases/chunk_nbt/generated.json: chunks' NBT, as SNBT, read and written back as vanilla's
// SerializableChunkData reads and writes a chunk it loads from its region file and saves again.
//
//     calx cases/chunk_nbt/gen.calx
//
// Deterministic: sections' palettes and data come from SplitMix64, seeded here, so rerunning it
// gives the same file.
//
// The cases cover each field the chunk keeps, written well and badly: the status, the position and
// times, the sections' block states and biomes by name and properties, packed in every size a
// palette comes in and in sizes the palette doesn't need, light, heightmaps, scheduled ticks,
// post-processing, entities, block entities, structures, and the upgrade, blending and retrogen
// data of chunks from older versions.

import std.json.{Json}
import cases.kit.{case, file, n, obj, s}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}

const SEED: u64 = 20261029

// States written as vanilla writes them, one a line: a default state as its block's name, any
// other as its block's name and its properties, every one, in name order.
const STATES: str = #"
"minecraft:air"
"minecraft:stone"
"minecraft:granite"
"minecraft:dirt"
"minecraft:grass_block"
{id:"minecraft:grass_block",properties:{snowy:"true"}}
"minecraft:oak_log"
{id:"minecraft:oak_log",properties:{axis:"x"}}
{id:"minecraft:oak_log",properties:{axis:"z"}}
"minecraft:oak_leaves"
{id:"minecraft:oak_leaves",properties:{distance:"1",persistent:"true",waterlogged:"false"}}
"minecraft:water"
{id:"minecraft:water",properties:{level:"8"}}
"minecraft:lava"
{id:"minecraft:wheat",properties:{age:"7"}}
"minecraft:wheat"
"minecraft:bedrock"
"minecraft:deepslate"
"minecraft:diamond_ore"
"minecraft:cave_air"
"minecraft:oak_planks"
"minecraft:torch"
{id:"minecraft:wall_torch",properties:{facing:"east"}}
"minecraft:glass"
{id:"minecraft:oak_slab",properties:{type:"top",waterlogged:"true"}}
"minecraft:sand"
"minecraft:gravel"
"minecraft:cobblestone"
{id:"minecraft:snow",properties:{layers:"4"}}
{id:"minecraft:oak_stairs",properties:{facing:"west",half:"top",shape:"outer_left",waterlogged:"false"}}
{id:"minecraft:redstone_wire",properties:{east:"side",north:"up",power:"15",south:"none",west:"none"}}
{id:"minecraft:chest",properties:{facing:"south",type:"left",waterlogged:"false"}}
"minecraft:short_grass"
{id:"minecraft:kelp",properties:{age:"25"}}
"minecraft:coal_ore"
"minecraft:iron_ore"
"#
const BIOMES: str = "plains forest desert ocean river taiga swamp jungle savanna badlands dripstone_caves lush_caves deep_dark beach snowy_plains mushroom_fields cherry_grove meadow"

/// A world's height: its lowest block and how many sections it has.
struct Height {
    min_y: i64
    sections: i64
}

fn overworld() -> Height {
    return Height { min_y: -64, sections: 24 }
}

fn nether() -> Height {
    return Height { min_y: 0, sections: 16 }
}

fn below(g: mut SplitMix64, bound: u64) -> u64 {
    return g.next() % bound
}

fn state_names() -> List<String> {
    var out: List<String> = []
    for line in String(STATES).split("\n") {
        if not line.is_empty() {
            out.push(line.copy())
        }
    }
    return out
}

fn biome_names() -> List<String> {
    var out: List<String> = []
    for name in String(BIOMES).split(" ") {
        out.push("\"minecraft:{name}\"")
    }
    return out
}

/// Vanilla's names, space-separated, quoted and joined as a palette's entries.
fn ids(names: String) -> String {
    var out: List<String> = []
    for name in names.split(" ") {
        out.push("\"minecraft:{name}\"")
    }
    return out.join(",")
}

/// The first `count` of `choices`, joined as a palette's entries.
fn first(choices: List<String>, count: usize) -> String {
    var out: List<String> = []
    for i in 0..count {
        out.push(choices[i].copy())
    }
    return out.join(",")
}

/// `item` `count` times, joined with commas.
fn rep(item: String, count: usize) -> String {
    var out: List<String> = []
    for _ in 0..count {
        out.push(item.copy())
    }
    return out.join(",")
}

/// `pattern` `count` times over.
fn times(pattern: List<u64>, count: usize) -> List<u64> {
    var out: List<u64> = []
    for _ in 0..count {
        out.extend(pattern.copy())
    }
    return out
}

fn plus(head: own List<u64>, tail: List<u64>) -> List<u64> {
    var out = head
    out.extend(tail.copy())
    return out
}

fn upto(count: u64) -> List<u64> {
    var out: List<u64> = []
    for v in 0u64..count {
        out.push(v)
    }
    return out
}

fn same(v: i64, count: usize) -> List<i64> {
    var out: List<i64> = []
    for _ in 0..count {
        out.push(v)
    }
    return out
}

fn ceil_log2(count: u64) -> u64 {
    var bits = 0u64
    while (1u64 << bits) < count {
        bits += 1
    }
    return bits
}

/// Values of `bits` bits each in longs, as many whole ones in each as fit, from the low bits.
fn pack(values: List<u64>, bits: u64) -> List<i64> {
    let per = 64 / bits
    var out: List<i64> = []
    var v = 0u64
    var j = 0u64
    for x in values {
        v |= x << (j * bits)
        j += 1
        if j == per {
            out.push(i64.wrap(v))
            v = 0
            j = 0
        }
    }
    if j > 0 {
        out.push(i64.wrap(v))
    }
    return out
}

fn longs(values: List<i64>) -> String {
    var parts: List<String> = []
    for v in values {
        parts.push("{v}L")
    }
    return "[L;{parts.join(",")}]"
}

fn packed(values: List<u64>, bits: u64) -> String? {
    return some(longs(pack(values, bits)))
}

/// A container: its palette's entries, joined, and its data, if it has any.
fn container(palette: String, data: String?) -> String {
    var out = "palette:[{palette}]"
    if let d = data {
        out = "{out},data:{d}"
    }
    return "\{{out}\}"
}

fn block_bits(count: usize) -> u64 {
    if count <= 1 {
        return 0
    }
    let bits = ceil_log2(u64(count))
    if count <= 256 and bits < 4 {
        return 4
    }
    return bits
}

fn biome_bits(count: usize) -> u64 {
    return ceil_log2(u64(count))
}

/// A container of `size` values drawn from the first `count` of `choices`, or `used` of them,
/// packed in `bits` bits each.
fn random_container(g: mut SplitMix64, choices: List<String>, count: usize, size: usize, bits: u64, used: usize) -> String {
    let palette = first(choices, count)
    var values: List<u64> = []
    for _ in 0..size {
        values.push(below(mut g, u64(used)))
    }
    if bits == 0 {
        return container(palette, none)
    }
    return container(palette, packed(values, bits))
}

fn chunk(status: String, x: i64, z: i64, sections: List<String>?, extra: String) -> String {
    var out = "DataVersion:5023,xPos:{x},yPos:-4,zPos:{z},LastUpdate:1234L,InhabitedTime:56L,Status:{status}"
    if let secs = sections {
        out = "{out},sections:[{secs.join(",")}]"
    }
    if not extra.is_empty() {
        out = "{out},{extra}"
    }
    return "\{{out}\}"
}

/// A full chunk with `extra` after its fields.
fn full(extra: String) -> String {
    return chunk(#""minecraft:full""#, 0, 0, none, extra)
}

/// A full chunk with these sections.
fn full_of(sections: own List<String>) -> String {
    return chunk(#""minecraft:full""#, 0, 0, some(sections), "")
}

fn section(y: i64, blocks: String?, biomes: String?, extra: String) -> String {
    var parts: List<String> = []
    if let b = blocks {
        parts.push("block_states:{b}")
    }
    if let b = biomes {
        parts.push("biomes:{b}")
    }
    if not extra.is_empty() {
        parts.push(extra.copy())
    }
    parts.push("Y:{y}b")
    return "\{{parts.join(",")}\}"
}

fn add_in(out: mut List<Json>, name: own String, snbt: own String, height: Height) {
    let input = obj([(String("min_y"), n(height.min_y)), (String("sections"), n(height.sections)), (String("snbt"), s(snbt))])
    out.push(case(name, input))
}

fn add(out: mut List<Json>, name: own String, snbt: own String) {
    add_in(mut out, name, snbt, overworld())
}

fn stone() -> String {
    return container(ids("stone"), none)
}

fn plains() -> String {
    return container(ids("plains"), none)
}

fn nope() -> String {
    return container(ids("nope"), none)
}

/// A full chunk of one section, Y 0, of these blocks and plains.
fn one(out: mut List<Json>, name: own String, blocks: String) {
    one_in(mut out, name, blocks, plains())
}

/// A full chunk of one section, Y 0, of these blocks and biomes.
fn one_in(out: mut List<Json>, name: own String, blocks: String, biomes: String) {
    add(mut out, name, full_of([section(0, some(blocks.copy()), some(biomes.copy()), "")]))
}

fn basics(out: mut List<Json>) {
    add(mut out, "no-status", #"{xPos:1,zPos:2}"#)
    add(mut out, "empty-status", #"{Status:""}"#)
    add(mut out, "status-not-string", #"{Status:5}"#)
    add(mut out, "minimal", #"{Status:"minecraft:full"}"#)
    add(mut out, "unknown-status", #"{Status:"minecraft:nope"}"#)
    add(mut out, "bad-status-name", #"{Status:"Not A Status"}"#)
    add(mut out, "short-status-name", #"{Status:"features"}"#)
    add(mut out, "status-terrain", #"{Status:"minecraft:terrain"}"#)
    add(mut out, "status-upper-case", #"{Status:"minecraft:FULL"}"#)
    add(mut out, "status-other-namespace", #"{Status:"calcite:full"}"#)
    add(mut out, "everything-empty", full(""))
    for status in ["empty", "structure_starts", "structure_references", "biomes", "noise", "surface", "carvers", "features", "initialize_light", "light", "spawn", "full"] {
        add(mut out, "status-{status}", chunk("\"minecraft:{status}\"", 0, 0, none, #"entities:[{id:"minecraft:pig"}]"#))
    }
    add(mut out, "position", chunk(#""minecraft:full""#, -31, 1000000, none, ""))
    add(mut out, "position-not-int", #"{Status:"minecraft:full",xPos:"3",zPos:2.5d}"#)
    add(mut out, "position-byte", #"{Status:"minecraft:full",xPos:3b,zPos:-2s}"#)
    add(mut out, "position-long", #"{Status:"minecraft:full",xPos:4294967297L,zPos:-1L}"#)
    add(mut out, "times-as-ints", #"{Status:"minecraft:full",LastUpdate:5,InhabitedTime:7b}"#)
    add(mut out, "times-as-doubles", #"{Status:"minecraft:full",LastUpdate:5.9d,InhabitedTime:-7.5f}"#)
    add(mut out, "times-negative-fractions", #"{Status:"minecraft:full",LastUpdate:-7.5d,InhabitedTime:-7.5f,xPos:-1.5d,zPos:-0.5f}"#)
    add(mut out, "times-huge-doubles", #"{Status:"minecraft:full",LastUpdate:1.0e30d,InhabitedTime:-1.0e30f,xPos:1.0e30d,zPos:-1.0e30f}"#)
    add(mut out, "times-as-strings", #"{Status:"minecraft:full",LastUpdate:"5",InhabitedTime:[I;1]}"#)
    add(mut out, "data-version-old", #"{DataVersion:100,Status:"minecraft:full"}"#)
    add(mut out, "y-pos-wrong", #"{yPos:7,Status:"minecraft:full"}"#)
    add(mut out, "light-on", #"{Status:"minecraft:full",isLightOn:1b}"#)
    add(mut out, "light-off", #"{Status:"minecraft:full",isLightOn:0b}"#)
    add(mut out, "light-five", #"{Status:"minecraft:full",isLightOn:5b}"#)
    add(mut out, "light-256", #"{Status:"minecraft:full",isLightOn:256}"#)
    add(mut out, "light-half", #"{Status:"minecraft:full",isLightOn:0.5d}"#)
    add(mut out, "light-minus-half", #"{Status:"minecraft:full",isLightOn:-0.5d}"#)
    add(mut out, "light-int", #"{Status:"minecraft:full",isLightOn:1}"#)
    add(mut out, "light-string", #"{Status:"minecraft:full",isLightOn:"true"}"#)
    add(mut out, "unknown-keys", #"{Status:"minecraft:full",foo:1,Level:{bar:2},CarvingMasks:{}}"#)
}

/// A section of stone and plains at `y`, with `extra`.
fn stone_at(y: i64, extra: String) -> List<String> {
    return [section(y, some(stone()), some(plains()), extra)]
}

fn section_cases(out: mut List<Json>) {
    add(mut out, "one-stone-section", full_of(stone_at(0, "")))
    add(mut out, "section-without-containers", full_of([section(0, none, none, "")]))
    add(mut out, "section-blocks-only", full_of([section(1, some(stone()), none, "")]))
    add(mut out, "section-biomes-only", full_of([section(1, none, some(container(ids("desert"), none)), "")]))
    add(mut out, "section-y-missing", full_of(["\{block_states:{stone()}\}"]))
    add(mut out, "section-y-int", full_of(["\{block_states:{stone()},Y:3\}"]))
    add(mut out, "section-y-below", full_of(stone_at(-5, "")))
    add(mut out, "section-y-above", full_of(stone_at(20, "")))
    add(mut out, "section-y-top", full_of(stone_at(19, "")))
    add(mut out, "section-y-bottom", full_of(stone_at(-4, "")))
    add(mut out, "section-y-below-light", full_of(stone_at(-5, "SkyLight:[B;{rep("17b", 2048)}]")))
    add(mut out, "section-y-far-below", full_of(["\{block_states:{stone()},Y:-56b\}"]))
    add(mut out, "section-y-int-wraps", full_of(["\{block_states:{stone()},Y:200\}"]))
    add(mut out, "section-y-int-wraps-in", full_of(["\{block_states:{stone()},Y:258\}"]))
    add(mut out, "section-y-double", full_of(["\{block_states:{stone()},Y:1.9d\}", "\{block_states:{stone()},Y:-0.5f\}"]))
    add(mut out, "section-y-string", full_of(["\{block_states:{stone()},Y:\"3\"\}"]))
    add(mut out, "sections-twice", full_of([section(0, some(stone()), none, ""), section(0, some(container(ids("dirt"), none)), none, "")]))
    add(mut out, "sections-out-of-order", full_of([section(5, some(stone()), none, ""), section(-2, some(stone()), none, ""), section(1, none, some(plains()), "")]))
    add(mut out, "sections-not-list", full("sections:\{a:1\}"))
    add(mut out, "sections-of-ints", full("sections:[1,2,3]"))
    add(mut out, "sections-mixed", full("sections:[[],\{Y:1b,block_states:{stone()}\}]"))
    add_in(mut out, "nether-section-negative", full_of(stone_at(-1, "")), nether())
    var nether_sections: List<String> = []
    for y in 0i64..16 {
        nether_sections.push(section(y, some(stone()), some(plains()), ""))
    }
    add_in(mut out, "nether-sections", full_of(nether_sections), nether())
    add_in(mut out, "one-section-world", full_of([section(1, some(stone()), some(plains()), ""), section(2, some(stone()), none, "")]), Height { min_y: 16, sections: 1 })
    add(mut out, "light-only", full_of([section(3, none, none, "BlockLight:[B;{rep("1b", 2048)}]")]))
    var sky: List<String> = []
    for i in 0..2048 {
        sky.push("{i % 100}b")
    }
    add(mut out, "light-both", full_of(stone_at(3, "BlockLight:[B;{rep("-1b", 2048)}],SkyLight:[B;{sky.join(",")}]")))
    add(mut out, "light-short", full_of(stone_at(3, "BlockLight:[B;1b,2b,3b]")))
    add(mut out, "light-long", full_of(stone_at(3, "SkyLight:[B;{rep("0b", 2049)}]")))
    add(mut out, "light-empty", full_of(stone_at(3, "SkyLight:[B;]")))
    add(mut out, "light-not-bytes", full_of(stone_at(3, #"SkyLight:[I;1,2],BlockLight:"x""#)))
    add(mut out, "light-list-of-bytes", full_of(stone_at(3, "SkyLight:[{rep("1b", 2048)}]")))
}

fn palettes(out: mut List<Json>) {
    let all_states = state_names()
    let all_biomes = biome_names()
    add(mut out, "bad-index-then-bad-section", full_of([section(0, some(container(ids("stone dirt"), packed(times([0, 5], 2048), 4))), some(plains()), ""), section(1, some(nope()), some(plains()), "")]))
    add(mut out, "bad-biome-index-then-bad-section", full_of([section(0, some(stone()), some(container(first(all_biomes, 3), packed(times([3], 64), 2))), ""), section(1, some(nope()), some(plains()), ""), section(2, some(stone()), some(plains()), "BlockLight:[B;1b]")]))
    add(mut out, "bad-light-after-logged-error", full_of([section(0, some(nope()), some(nope()), "BlockLight:[B;1b]")]))
    add(mut out, "light-checked-outside-world", full_of([section(-10, some(stone()), some(plains()), "BlockLight:[B;1b]")]))
    one(mut out, "palette-missing", #"{}"#)
    one(mut out, "palette-missing-with-data", #"{data:[L;1L]}"#)
    one(mut out, "palette-not-list", #"{palette:5}"#)
    one(mut out, "palette-empty", #"{palette:[]}"#)
    one(mut out, "palette-empty-with-data", #"{palette:[],data:[L;0L]}"#)
    one(mut out, "palette-unknown-name", nope())
    one(mut out, "palette-bad-name", container(#""Not A Block""#, none))
    one(mut out, "palette-no-namespace", container(#""stone""#, none))
    one(mut out, "palette-other-namespace", container(#""other:stone""#, none))
    one(mut out, "palette-int", container("5", none))
    one(mut out, "palette-list", container("[]", none))
    one(mut out, "palette-no-id", container(#"{properties:{axis:"x"}}"#, none))
    one(mut out, "palette-empty-compound", container(#"{}"#, none))
    one(mut out, "palette-unknown-id", container(#"{id:"minecraft:nope"}"#, none))
    one(mut out, "palette-bad-id", container(#"{id:"Not A Block"}"#, none))
    one(mut out, "palette-id-int", container(#"{id:5}"#, none))
    one(mut out, "palette-name-key", container(#"{Name:"minecraft:oak_log",Properties:{axis:"x"}}"#, none))
    one(mut out, "palette-default-written-out", container(#"{id:"minecraft:oak_log",properties:{axis:"y"}}"#, none))
    one(mut out, "palette-id-alone", container(#"{id:"minecraft:oak_log"}"#, none))
    one(mut out, "palette-id-alone-singleton", container(#"{id:"minecraft:stone"}"#, none))
    one(mut out, "palette-singleton-properties", container(#"{id:"minecraft:stone",properties:{axis:"x"}}"#, none))
    one(mut out, "palette-singleton-properties-int", container(#"{id:"minecraft:stone",properties:5}"#, none))
    one(mut out, "palette-bad-value", container(#"{id:"minecraft:oak_log",properties:{axis:"w"}}"#, none))
    one(mut out, "palette-unknown-property", container(#"{id:"minecraft:oak_log",properties:{facing:"x"}}"#, none))
    one(mut out, "palette-value-int", container(#"{id:"minecraft:wheat",properties:{age:3}}"#, none))
    one(mut out, "palette-value-byte-bool", container(#"{id:"minecraft:grass_block",properties:{snowy:1b}}"#, none))
    one(mut out, "palette-properties-int", container(#"{id:"minecraft:oak_log",properties:5}"#, none))
    one(mut out, "palette-properties-list", container(#"{id:"minecraft:oak_log",properties:[]}"#, none))
    one(mut out, "palette-some-properties", container(#"{id:"minecraft:oak_stairs",properties:{half:"top",shape:"inner_left"}}"#, none))
    one(mut out, "palette-some-bad-properties", container(#"{id:"minecraft:oak_stairs",properties:{half:"middle",shape:"inner_left",facing:"up"}}"#, none))
    one(mut out, "palette-extra-keys", container(#"{id:"minecraft:oak_log",properties:{axis:"x"},foo:1}"#, none))
    one(mut out, "palette-upper-case-value", container(#"{id:"minecraft:oak_log",properties:{axis:"X"}}"#, none))
    one(mut out, "palette-two-bad", container(#""minecraft:nope","minecraft:stone",7"#, none))
    one(mut out, "palette-three-bad", container(#""minecraft:nope",7,{},"minecraft:dirt""#, packed(times([0, 1, 2, 3], 1024), 4)))
    one(mut out, "palette-names", container(#""Minecraft:stone",":stone","minecraft:","a:b:c","","minecraft:stone ""#, packed(plus(times([0, 1, 2, 3, 4, 5], 682), times([0], 4)), 4)))
    one(mut out, "palette-int-array", "\{palette:[I;1,2],data:{longs(pack(times([0, 1], 2048), 4))}\}")
    one(mut out, "palette-mixed-list", container(#""minecraft:stone",{id:"minecraft:oak_log",properties:{axis:"x"}},5"#, packed(plus(times([0, 1, 2], 1365), [0]), 4)))
    one(mut out, "palette-property-order", container(#"{id:"minecraft:oak_stairs",properties:{half:"top"}},{id:"minecraft:powered_rail",properties:{powered:"true"}},{id:"minecraft:piston_head",properties:{short:"true",facing:"up"}}"#, packed(times([0, 1, 2, 0], 1024), 4)))
    one(mut out, "palette-all-bad-to-air", container(ids("nope nada"), packed(times([0, 1], 2048), 4)))
    one(mut out, "palette-index-past-end-many", container(ids("stone dirt"), packed(times([0, 9, 1, 5, 3, 14, 7, 12], 512), 4)))
    one(mut out, "palette-index-past-end-17", container(first(all_states, 17), packed(plus(times(upto(17), 240), times([31, 20, 25, 18], 4)), 5)))
    one(mut out, "palette-index-past-end-global", container(rep(all_states[0].copy(), 257), packed(plus(times([0, 300, 1, 511, 257], 819), [0]), 9)))
    one_in(mut out, "biomes-index-past-end", stone(), container(first(all_biomes, 3), packed(times([0, 1, 3, 2], 16), 2)))
    one_in(mut out, "biomes-index-past-end-global", stone(), container(first(all_biomes, 9), packed(times([0, 15, 1, 9], 16), 4)))
    one_in(mut out, "biomes-empty-palette", stone(), #"{palette:[]}"#)
    one_in(mut out, "blocks-bad-index-and-bad-biome", container(ids("stone dirt"), packed(times([0, 1, 2, 3], 1024), 4)), nope())
    one_in(mut out, "blocks-empty-and-bad-biome", #"{palette:[]}"#, nope())
    one(mut out, "palette-same-state-twice", container(#""minecraft:oak_log",{id:"minecraft:oak_log",properties:{axis:"y"}}"#, packed(times([0, 1], 2048), 4)))
    one(mut out, "palette-two-no-data", container(ids("stone dirt"), none))
    one(mut out, "palette-two-data-short", container(ids("stone dirt"), some(String("[L;1L,2L]"))))
    one(mut out, "palette-two-data-long", container(ids("stone dirt"), some(longs(same(0, 257)))))
    one(mut out, "palette-two-data-empty", container(ids("stone dirt"), some(String("[L;]"))))
    one(mut out, "palette-two-data-ints", container(ids("stone dirt"), some("[I;{rep("1", 256)}]")))
    one(mut out, "palette-two-data-list", container(ids("stone dirt"), some("[{rep("1L", 256)}]")))
    one(mut out, "palette-two-data-string", container(ids("stone dirt"), some(String(#""x""#))))
    one(mut out, "palette-one-with-data", container(ids("stone"), some(longs(same(7, 256)))))
    one(mut out, "palette-one-with-short-data", container(ids("stone"), some(String("[L;7L]"))))
    one(mut out, "palette-index-past-end", container(ids("stone dirt"), packed(times([0, 1, 2, 15], 1024), 4)))
    one(mut out, "palette-bits-5-for-2", container(ids("stone dirt"), packed(times([0, 1], 2048), 5)))
    one(mut out, "palette-unused-entries", container(ids("stone dirt sand"), packed(times([2, 0], 2048), 4)))
    one(mut out, "palette-all-one-value", container(ids("stone dirt"), packed(times([1], 4096), 4)))
    one_in(mut out, "biomes-missing-palette", stone(), #"{}"#)
    one_in(mut out, "biomes-unknown", stone(), nope())
    one_in(mut out, "biomes-bad-name", stone(), container(#""Nope Nope""#, none))
    one_in(mut out, "biomes-compound", stone(), container(#"{id:"minecraft:plains"}"#, none))
    one_in(mut out, "biomes-int", stone(), container("3", none))
    one_in(mut out, "biomes-two-no-data", stone(), container(ids("plains desert"), none))
    one_in(mut out, "biomes-two", stone(), container(ids("plains desert"), packed(times([1, 0, 0, 1], 16), 1)))
    one_in(mut out, "biomes-two-bits-4", stone(), container(ids("plains desert"), packed(times([1, 0, 0, 1], 16), 4)))
    one_in(mut out, "biomes-short-data", stone(), container(ids("plains desert"), some(String("[L;]"))))
    one_in(mut out, "blocks-and-biomes-bad", nope(), nope())
    one(mut out, "blocks-bad-and-short", container(ids("nope stone"), some(String("[L;1L]"))))

    var g = splitmix64(SEED)
    for count in [2usize, 3, 4, 5, 8, 9, 15, 16, 17, 20, 31, 32, 33, 36] {
        let kept = if count < all_states.len() { count } else { all_states.len() }
        one(mut out, "blocks-{kept}", random_container(mut g, all_states, kept, 4096, block_bits(kept), kept))
    }
    one(mut out, "blocks-36-using-3", random_container(mut g, all_states, 36, 4096, block_bits(36), 3))
    one(mut out, "blocks-17-using-16", random_container(mut g, all_states, 17, 4096, block_bits(17), 16))
    one(mut out, "blocks-5-using-1", random_container(mut g, all_states, 5, 4096, block_bits(5), 1))
    for count in [2usize, 3, 4, 5, 8, 9, 13, 18] {
        one_in(mut out, "biomes-{count}", stone(), random_container(mut g, all_biomes, count, 64, biome_bits(count), count))
    }
    one_in(mut out, "biomes-9-using-2", stone(), random_container(mut g, all_biomes, 9, 64, biome_bits(9), 2))
    one_in(mut out, "biomes-4-using-1", stone(), random_container(mut g, all_biomes, 4, 64, biome_bits(4), 1))
    // More than 256 states, which take the registry's IDs: every age of every crop and every
    // stair, spelled out.
    var many: List<String> = []
    for facing in ["north", "south", "west", "east"] {
        for half in ["top", "bottom"] {
            for shape in ["straight", "inner_left", "inner_right", "outer_left", "outer_right"] {
                for wl in ["true", "false"] {
                    for stair in ["oak_stairs", "stone_stairs", "spruce_stairs", "birch_stairs"] {
                        many.push("\{id:\"minecraft:{stair}\",properties:\{facing:\"{facing}\",half:\"{half}\",shape:\"{shape}\",waterlogged:\"{wl}\"\}\}")
                    }
                }
            }
        }
    }
    for count in [257usize, 300, 320] {
        one(mut out, "blocks-global-{count}", random_container(mut g, many, count, 4096, block_bits(count), count))
    }
    one(mut out, "blocks-global-300-using-200", random_container(mut g, many, 300, 4096, block_bits(300), 200))
    one(mut out, "blocks-global-300-using-2", random_container(mut g, many, 300, 4096, block_bits(300), 2))
}

fn tick(id: str, x: i64, y: i64, z: i64, t: i64, p: i64) -> String {
    return "\{i:\"{id}\",x:{x},y:{y},z:{z},t:{t},p:{p}\}"
}

fn ticks(out: mut List<Json>) {
    add(mut out, "block-ticks", full("block_ticks:[{tick("minecraft:water", 1, 64, 2, 1, 0)},{tick("minecraft:stone", 15, -64, 15, 20, -3)}]"))
    add(mut out, "fluid-ticks", full("fluid_ticks:[{tick("minecraft:water", 1, 64, 2, 5, 3)},{tick("minecraft:flowing_lava", 0, 0, 0, 1, 0)}]"))
    add(mut out, "ticks-outside-chunk", chunk(#""minecraft:full""#, 2, -1, none, "block_ticks:[{tick("minecraft:stone", 32, 0, -16, 1, 0)},{tick("minecraft:stone", 47, 0, -1, 1, 0)},{tick("minecraft:stone", 48, 0, -1, 1, 0)},{tick("minecraft:stone", 40, 0, -17, 1, 0)}]"))
    add(mut out, "ticks-unknown-block", full("block_ticks:[{tick("minecraft:nope", 1, 2, 3, 1, 0)},{tick("minecraft:stone", 1, 2, 3, 1, 0)}]"))
    add(mut out, "ticks-missing-field", full(#"block_ticks:[{i:"minecraft:stone",x:1,y:2,t:1,p:0},{i:"minecraft:dirt",x:1,y:2,z:3,t:1,p:0}]"#))
    add(mut out, "ticks-no-priority", full(#"block_ticks:[{i:"minecraft:stone",x:1,y:2,z:3,t:1}]"#))
    add(mut out, "ticks-priority-far", full("block_ticks:[{tick("minecraft:stone", 1, 2, 3, 1, 9)},{tick("minecraft:stone", 1, 2, 3, 1, -9)}]"))
    add(mut out, "ticks-same-twice", full("block_ticks:[{tick("minecraft:stone", 1, 2, 3, 1, 0)},{tick("minecraft:stone", 1, 2, 3, 7, 0)}]"))
    add(mut out, "ticks-bad-types", full(#"block_ticks:[{i:"minecraft:stone",x:1b,y:2s,z:3L,t:1.5d,p:0b}]"#))
    add(mut out, "ticks-not-list", full(#"block_ticks:{i:"minecraft:stone"},fluid_ticks:5"#))
    add(mut out, "ticks-list-of-ints", full("block_ticks:[1,2]"))
    add(mut out, "ticks-fluid-as-block", full("fluid_ticks:[{tick("minecraft:stone", 1, 2, 3, 1, 0)}]"))
    add(mut out, "ticks-empty-compound", full(#"block_ticks:[{}]"#))
    add(mut out, "ticks-all-bad", full(#"block_ticks:[{i:5,x:"a",y:1,z:1,t:"b",p:"c"}]"#))
    add(mut out, "ticks-pos-missing", full(#"block_ticks:[{i:"minecraft:stone",t:1,p:0}]"#))
    add(mut out, "ticks-x-and-t-missing", full(#"block_ticks:[{i:"minecraft:nope",y:1,z:1,p:0}]"#))
    add(mut out, "ticks-three-bad", full(#"block_ticks:[1,{},{i:"minecraft:nope",x:1,y:1,z:1,t:1,p:1}]"#))
    add(mut out, "ticks-number-kinds", full(#"block_ticks:[{i:"minecraft:stone",x:1.9d,y:4294967297L,z:-0.5f,t:-1.5d,p:-1.5d},{i:"minecraft:stone",x:15.9f,y:-1.5d,z:2b,t:3s,p:2.9f}]"#))
    add(mut out, "ticks-huge", full(#"block_ticks:[{i:"minecraft:stone",x:0,y:-1.0e30f,z:0,t:1.0e30d,p:-1.0e30d},{i:"minecraft:stone",x:0,y:1.0e30d,z:0,t:-9223372036854775808L,p:9223372036854775807L}]"#))
    add(mut out, "ticks-array-not-list", full("block_ticks:[I;1,2]"))
    add(mut out, "ticks-other-chunk-and-bad", full(#"block_ticks:[{i:"minecraft:stone",x:100,y:1,z:1,t:1,p:0},{i:"minecraft:nope",x:1,y:1,z:1,t:1,p:0}]"#))
    add(mut out, "ticks-extra-keys", full(#"block_ticks:[{i:"minecraft:stone",x:1,y:2,z:3,t:1,p:0,q:9}]"#))
}

fn others(out: mut List<Json>) {
    var counting: List<i64> = []
    for i in 0i64..37 {
        counting.push(i)
    }
    add(mut out, "heightmaps", full("Heightmaps:\{MOTION_BLOCKING:{longs(counting)},WORLD_SURFACE:{longs(same(5, 37))},OCEAN_FLOOR_WG:[L;1L]\}"))
    var maps: List<String> = []
    var i = 0i64
    for k in ["WORLD_SURFACE_WG", "WORLD_SURFACE", "OCEAN_FLOOR_WG", "OCEAN_FLOOR", "MOTION_BLOCKING", "MOTION_BLOCKING_NO_LEAVES"] {
        maps.push("{k}:{longs(same(i, 37))}")
        i += 1
    }
    add(mut out, "heightmaps-all", full("Heightmaps:\{{maps.join(",")}\}"))
    add(mut out, "heightmaps-bad", full(#"Heightmaps:{MOTION_BLOCKING:[I;1,2],WORLD_SURFACE:"x",LIGHT_BLOCKING:[L;1L],motion_blocking:[L;2L],OCEAN_FLOOR:[L;]}"#))
    add(mut out, "heightmaps-not-compound", full("Heightmaps:[L;1L]"))
    add(mut out, "post-processing", full("PostProcessing:[[],[1s,2s,3s],[],[-1s],[]]"))
    add(mut out, "post-processing-types", full(#"PostProcessing:[[1b,2b],[1,2],[1L],["x"],[[1s]],[1.5d]]"#))
    add(mut out, "post-processing-not-lists", full(#"PostProcessing:[1s,{a:1},"x",[5s]]"#))
    add(mut out, "post-processing-long", full("PostProcessing:[{rep("[1s]", 30)}]"))
    add(mut out, "post-processing-int-array", full("PostProcessing:[[I;1,2],[B;3b],[L;4L]]"))
    add(mut out, "post-processing-negative-fractions", full("PostProcessing:[[-1.5d,-0.5f,70000,1.0e30d]]"))
    add(mut out, "post-processing-not-list", full(#"PostProcessing:{a:[1s]}"#))
    add(mut out, "entities-full", full(#"entities:[{id:"minecraft:pig",Pos:[1.0d,2.0d,3.0d]}]"#))
    add(mut out, "entities-proto", chunk(#""minecraft:features""#, 0, 0, none, #"entities:[{id:"minecraft:pig"},5,{id:"minecraft:cow"}]"#))
    add(mut out, "entities-proto-not-list", chunk(#""minecraft:features""#, 0, 0, none, #"entities:{id:"minecraft:pig"}"#))
    add(mut out, "block-entities", full(#"block_entities:[{id:"minecraft:chest",x:1,y:2,z:3,Items:[]},{id:"minecraft:sign",x:0,y:0,z:0,keepPacked:1b}]"#))
    add(mut out, "block-entities-mixed", full(#"block_entities:[{id:"minecraft:chest"},"x",[],{}]"#))
    add(mut out, "block-entities-not-list", full(#"block_entities:{id:"minecraft:chest"}"#))
    add(mut out, "structures", full(#"structures:{starts:{"minecraft:village_plains":{id:"INVALID"}},References:{"minecraft:mineshaft":[L;1L,2L]}}"#))
    add(mut out, "structures-not-compound", full("structures:[1]"))
    add(mut out, "structures-anything", full(#"structures:{foo:1b,bar:{baz:[I;1]}}"#))
    add(mut out, "upgrade-data", full(#"UpgradeData:{Indices:{"0":[I;1,2,3],"5":[I;4]},Sides:5b}"#))
    add(mut out, "upgrade-data-sides-only", full(#"UpgradeData:{Sides:255}"#))
    add(mut out, "upgrade-data-sides-high", full(#"UpgradeData:{Sides:256}"#))
    add(mut out, "upgrade-data-empty", full(#"UpgradeData:{}"#))
    add(mut out, "upgrade-data-empty-index", full(#"UpgradeData:{Indices:{"0":[I;]}}"#))
    add(mut out, "upgrade-data-index-past", full(#"UpgradeData:{Indices:{"24":[I;1],"23":[I;2],"-1":[I;3],"01":[I;4]}}"#))
    add(mut out, "upgrade-data-ticks-only", full(#"UpgradeData:{neighbor_block_ticks:[{i:"minecraft:stone",x:1,y:2,z:3,t:1,p:0}]}"#))
    add(mut out, "upgrade-data-ticks", full(#"UpgradeData:{Sides:1b,neighbor_block_ticks:[{i:"minecraft:stone",x:100,y:2,z:3,t:1,p:0},{i:"minecraft:nope",x:1,y:2,z:3,t:1,p:0}],neighbor_fluid_ticks:[{i:"minecraft:water",x:1,y:2,z:3,t:1,p:5}]}"#))
    add(mut out, "upgrade-data-sides-double", full(#"UpgradeData:{Sides:3.9d}"#))
    add(mut out, "upgrade-data-bad-ticks", full(#"UpgradeData:{Sides:1b,neighbor_block_ticks:[{i:"minecraft:stone"}],neighbor_fluid_ticks:5}"#))
    add(mut out, "upgrade-data-some-bad-ticks", full(#"UpgradeData:{Sides:1b,neighbor_block_ticks:[{i:"minecraft:nope",x:100,y:1,z:1,t:1,p:9},5,{i:"minecraft:stone",x:1,y:1,z:1,t:1,p:0}],neighbor_fluid_ticks:[{i:"minecraft:water",x:-1,y:1,z:1,t:1,p:0},{i:7,x:1,y:1,z:1,t:1,p:0}]}"#))
    add(mut out, "upgrade-data-not-compound", full("UpgradeData:5"))
    add(mut out, "upgrade-data-index-types", full(#"UpgradeData:{Indices:{"0":[B;1b],"1":[L;1L],"2":[1,2]}}"#))
    add_in(mut out, "upgrade-data-nether", full(#"UpgradeData:{Indices:{"15":[I;1],"16":[I;2]}}"#), nether())
    add(mut out, "blending-data", full(#"blending_data:{min_section:-4,max_section:20}"#))
    var halves: List<String> = []
    var whole_ones: List<String> = []
    for h in 0..16 {
        halves.push("{h}.5f")
        whole_ones.push("{h}")
    }
    add(mut out, "blending-data-heights", full("blending_data:\{min_section:-4,max_section:20,heights:[{halves.join(",")}]\}"))
    add(mut out, "blending-data-heights-short", full(#"blending_data:{min_section:-4,max_section:20,heights:[1.0f]}"#))
    add(mut out, "blending-data-heights-doubles", full("blending_data:\{min_section:0,max_section:1,heights:[{rep("1.0d", 16)}]\}"))
    add(mut out, "blending-data-heights-bad", full(#"blending_data:{min_section:0,max_section:1,heights:"x"}"#))
    add(mut out, "blending-data-missing", full(#"blending_data:{min_section:-4}"#))
    add(mut out, "blending-data-not-compound", full("blending_data:5"))
    add(mut out, "blending-data-both-missing", full(#"blending_data:{}"#))
    add(mut out, "blending-data-bad-types", full(#"blending_data:{min_section:"a",max_section:1.5d}"#))
    add(mut out, "blending-data-heights-ints", full("blending_data:\{min_section:0,max_section:1,heights:[{whole_ones.join(",")}]\}"))
    add(mut out, "blending-data-heights-mixed", full("blending_data:\{min_section:0,max_section:1,heights:[{rep("1.0f", 15)},\"x\"]\}"))
    add(mut out, "blending-data-heights-array", full("blending_data:\{min_section:0,max_section:1,heights:[I;{rep("2", 16)}]\}"))
    add(mut out, "blending-data-short-and-missing", full(#"blending_data:{min_section:0,heights:[1.0f]}"#))
    add(mut out, "blending-data-extra", full(#"blending_data:{min_section:1,max_section:2,old_noise:1b}"#))
    add(mut out, "retrogen", full(#"below_zero_retrogen:{target_status:"minecraft:spawn",missing_bedrock:[L;5L,-1L]}"#))
    add(mut out, "retrogen-no-bedrock", full(#"below_zero_retrogen:{target_status:"minecraft:features"}"#))
    add(mut out, "retrogen-empty-bedrock", full(#"below_zero_retrogen:{target_status:"minecraft:features",missing_bedrock:[L;0L]}"#))
    add(mut out, "retrogen-empty-status", full(#"below_zero_retrogen:{target_status:"minecraft:empty"}"#))
    add(mut out, "retrogen-unknown-status", full(#"below_zero_retrogen:{target_status:"minecraft:nope"}"#))
    add(mut out, "retrogen-no-status", full(#"below_zero_retrogen:{}"#))
    add(mut out, "retrogen-bedrock-ints", full(#"below_zero_retrogen:{target_status:"minecraft:full",missing_bedrock:[I;3]}"#))
    add(mut out, "retrogen-bedrock-list", full(#"below_zero_retrogen:{target_status:"minecraft:full",missing_bedrock:[1.9d,-1.5d]}"#))
    add(mut out, "retrogen-bedrock-bad", full(#"below_zero_retrogen:{target_status:"minecraft:full",missing_bedrock:[1,"x"]}"#))
    add(mut out, "retrogen-status-int", full(#"below_zero_retrogen:{target_status:5}"#))
    add(mut out, "retrogen-bedrock-trailing-zero", full(#"below_zero_retrogen:{target_status:"minecraft:full",missing_bedrock:[L;3L,0L]}"#))
}

/// Heightmap longs of 60 bits each, drawn.
fn heights(g: mut SplitMix64) -> String {
    var values: List<i64> = []
    for _ in 0..37 {
        values.push(i64.wrap(below(mut g, 1u64 << 60)))
    }
    return longs(values)
}

/// A chunk with every section full, as a world's are, of up to `kinds` blocks and `climates`
/// biomes a section.
fn whole_chunk(out: mut List<Json>, g: mut SplitMix64, name: own String, height: Height, kinds: u64, climates: u64) {
    let all_states = state_names()
    let all_biomes = biome_names()
    var secs: List<String> = []
    let bottom = height.min_y.floor_div(16)
    for y in (bottom - 1)..(bottom + height.sections + 1) {
        let k = usize.wrap(1 + below(mut g, kinds))
        let b = usize.wrap(1 + below(mut g, climates))
        var light: List<String> = []
        for _ in 0..2048 {
            light.push("{i64.wrap(below(mut g, 256)) - 128}b")
        }
        let blocks = random_container(mut g, all_states, k, 4096, block_bits(k), k)
        let biome = random_container(mut g, all_biomes, b, 64, biome_bits(b), b)
        secs.push(section(y, some(blocks), some(biome), "SkyLight:[B;{light.join(",")}]"))
    }
    let motion = heights(mut g)
    let surface = heights(mut g)
    let extra = "isLightOn:1b,Heightmaps:\{MOTION_BLOCKING:{motion},WORLD_SURFACE:{surface}\},block_entities:[\{id:\"minecraft:chest\",x:1,y:2,z:3\}],PostProcessing:[{rep("[]", usize.wrap(height.sections))}],structures:\{starts:\{\},References:\{\}\},block_ticks:[],fluid_ticks:[\{i:\"minecraft:water\",x:1,y:2,z:3,t:4,p:0\}]"
    add_in(mut out, name, chunk(#""minecraft:full""#, 0, 0, some(secs), extra), height)
}

fn whole(out: mut List<Json>) {
    var g = splitmix64(SEED + 1)
    whole_chunk(mut out, mut g, "whole-overworld", overworld(), 12, 3)
    whole_chunk(mut out, mut g, "whole-nether", nether(), 6, 2)
}

pub fn main() {
    var out: List<Json> = []
    basics(mut out)
    section_cases(mut out)
    palettes(mut out)
    ticks(mut out)
    others(mut out)
    whole(mut out)
    write_file(file("chunk_nbt", "generated.json"), String("chunk_nbt"), String("cases/chunk_nbt/gen.calx"), out, 1)
}
