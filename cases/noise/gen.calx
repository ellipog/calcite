module cases.noise.gen

// Writes cases/noise/generated.json: vanilla's noises sampled at points and over volumes.
//
//     calx cases/noise/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, and the vanilla noises'
// parameters from the pinned server jar in oracle/jars/, so rerunning it gives the same file.
//
// Each kind of noise is made from legacy and xoroshiro sources, with seeds at the ends of the
// `long` range and at random, then sampled where worldgen samples it: near the origin, across the
// 30,000,000 blocks of a world at the scales worldgen uses, far past where `wrap` folds the input,
// and at the points where it folds, as halves, integers, zeros of both signs, infinities and NaN.
// Volumes are a noise chunk's cells, a section's blocks, flat ones with a `y` scale of 0, and some
// at random, as `NoiseFunction` samples them. The normal noises are every one of the vanilla data
// pack's, and others at random with zero amplitudes, every normalization and up to 32 octaves;
// the legacy Nether ones include the two the Nether's biomes use, and parameters vanilla rejects.

import std.json.{Json}
import std.text.python.{repr_float}
import cases.jar.{json_files, vanilla}
import cases.kit.{arr, b, case, file, ints, n, obj, s, strs}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}
import tools.repo.{die}

const SEED: u64 = 20261101

// The edges of `GradientNoise.wrap`: 2^24, the largest double below it, 2^25, and around them.
const EDGES: [str; 33] = ["0", "-0", "0.5", "-0.5", "1", "-1", "0x1.fffffffffffffp-1", "-0x1.fffffffffffffp-1", "16777216", "-16777216", "0x1.fffffffffffffp23", "-0x1.fffffffffffffp23", "16777217.5", "-16777217.5", "33554432", "-33554432", "50331648", "-50331648", "1e9", "-1e9", "2147483648", "-2147483649", "9007199254740993", "1e20", "-1e20", "1e300", "inf", "-inf", "nan", "0x1p-1074", "123456.789", "-29999999.5", "29999999.5"]

const LONG_SEEDS: [str; 6] = ["0", "1", "-1", "9223372036854775807", "-9223372036854775808", "12345"]

struct Gen {
    r: SplitMix64
}

impl Gen {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn between(mut self, lo: i64, hi: i64) -> i64 {
        return lo + self.below(hi - lo + 1)
    }

    fn unit(mut self) -> f64 {
        return f64.nearest(i64.wrap(self.r.next() >> 11)) / 9007199254740992.0
    }

    fn seed(mut self) -> String {
        if self.below(3) == 0 {
            return String(LONG_SEEDS[usize.wrap(self.below(6))])
        }
        return "{i64.wrap(self.r.next())}"
    }

    fn blob_seed(mut self) -> Json {
        return s("{self.r.next() >> 1}")
    }
}

/// `-x` and `x`, as the Python's f-strings wrote them.
fn span(x: String) -> Json {
    return strs(["-{x}", x.copy()])
}

fn points(g: mut Gen, count: i64, xz: String, y: String) -> Json {
    let seed = g.blob_seed()
    return obj([(String("gen"), s("f64_range")), (String("seed"), seed), (String("count"), n(count)), (String("ranges"), arr([span(xz.copy()), span(y), span(xz)]))])
}

/// Each axis drawn on its own from the edge values.
fn edges(g: mut Gen, count: i64) -> Json {
    var out: List<String> = []
    for _ in 0..count {
        out.push(String(EDGES[usize.wrap(g.below(33))]))
    }
    return obj([(String("f64"), strs(out))])
}

fn pairs(g: mut Gen, count: i64, scale: i64) -> Json {
    let seed = g.blob_seed()
    return obj([(String("gen"), s("f64_range")), (String("seed"), seed), (String("count"), n(count)), (String("ranges"), arr([span("{scale}"), span("{scale}")]))])
}

fn noise_case(id: own String, random: str, seed: own String, noise: Json, function: str, blob: Json?, extra: own List<(String, Json)>) -> Json {
    var input: List<(String, Json)> = [(String("random"), s(String(random))), (String("seed"), s(seed)), (String("noise"), noise.copy()), (String("fn"), s(String(function)))]
    input.extend(extra)
    var c = case(id, obj(input))
    if let blob_part = blob {
        if let Json.Object(m) = c {
            var members = m
            members.insert("blobs", arr([blob_part.copy()]))
            c = Json.Object(members)
        }
    }
    return c
}

/// A scale of the world's 30,000,000 blocks, which the Python wrote as an int where it was 1.
struct Scale {
    whole: bool,
    v: f64,
}

fn times(base: i64, scale: Scale) -> String {
    if scale.whole {
        return "{base}"
    }
    return repr_float(f64.nearest(base) * scale.v)
}

/// A noise from both sources, at points near and far, and at the edges.
fn sampled(g: mut Gen, prefix: String, noise: Json, scales: List<Scale>, two_d: bool) -> List<Json> {
    var out: List<Json> = []
    for random in ["legacy", "xoroshiro"] {
        let p = "{prefix}-{random}"
        let near = g.seed()
        out.push(noise_case("{p}-near", random, near, noise, "get3", some(points(mut g, 400, String("64"), String("64"))), []))
        for (i, scale) in scales.enumerate() {
            let seed = g.seed()
            out.push(noise_case("{p}-far-{i}", random, seed, noise, "get3", some(points(mut g, 300, times(30000000, scale), times(320, scale))), []))
        }
        let huge = g.seed()
        out.push(noise_case("{p}-huge", random, huge, noise, "get3", some(points(mut g, 200, String("1e12"), String("1e9"))), []))
        let at_edges = g.seed()
        out.push(noise_case("{p}-edges", random, at_edges, noise, "get3", some(edges(mut g, 300)), []))
        if two_d {
            let flat = g.seed()
            out.push(noise_case("{p}-2d", random, flat, noise, "get2", some(pairs(mut g, 300, 100000)), []))
            let flat_edges = g.seed()
            out.push(noise_case("{p}-2d-edges", random, flat_edges, noise, "get2", some(edges(mut g, 160)), []))
        }
        let range = g.seed()
        out.push(noise_case("{p}-range", random, range, noise, "range", none, []))
    }
    return out
}

fn volume(g: mut Gen, id: own String, random: str, noise: Json, dims: List<i64>, xz: String, y: String, amplitude: String) -> Json {
    let seed = g.seed()
    return noise_case(id, random, seed, noise, "volume", none, [(String("volume"), ints(dims)), (String("xz_scale"), s(xz.copy())), (String("y_scale"), s(y.copy())), (String("amplitude"), s(amplitude.copy()))])
}

/// A noise over the volumes worldgen samples, at the scales given.
fn volumes(g: mut Gen, prefix: String, noise: Json, scales: List<(str, str)>) -> List<Json> {
    var out: List<Json> = []
    let (first_xz, first_y) = scales[0]
    for random in ["legacy", "xoroshiro"] {
        let p = "{prefix}-{random}"
        for (i, (xz, y)) in scales.enumerate() {
            let cx = g.between(-1875000, 1874999)
            let cz = g.between(-1875000, 1874999)
            // A noise chunk's cell corners: 5 by 49 by 5, 4 blocks apart across and 8 up.
            out.push(volume(mut g, "{p}-cells-{i}", random, noise, [5, 49, 5, cx * 16, -64, cz * 16, 4, 8, 4], String(xz), String(y), String("1")))
            // A section's blocks, one apart.
            let sy = g.between(-4, 19) * 16
            out.push(volume(mut g, "{p}-section-{i}", random, noise, [16, 16, 16, cx * 16, sy, cz * 16, 1, 1, 1], String(xz), String(y), String("1")))
        }
        let fx = g.between(-1000, 1000)
        let fz = g.between(-1000, 1000)
        out.push(volume(mut g, "{p}-flat", random, noise, [16, 1, 16, fx, 0, fz, 1, 1, 1], String(first_xz), String("0"), String("1")))
        out.push(volume(mut g, "{p}-amplified", random, noise, [7, 9, 3, -40, -64, 13, 3, 5, 7], String(first_xz), String(first_y), String("-2.5")))
        for i in 0..2 {
            var dims: List<i64> = []
            dims.push(g.between(1, 12))
            dims.push(g.between(1, 40))
            dims.push(g.between(1, 12))
            dims.push(g.between(-30000000, 30000000))
            dims.push(g.between(-2048, 2048))
            dims.push(g.between(-30000000, 30000000))
            dims.push(g.between(1, 9))
            dims.push(g.between(1, 9))
            dims.push(g.between(1, 9))
            let xz = repr_float(g.unit() * 2.0)
            let y = repr_float(g.unit() * 2.0)
            let amplitude = repr_float(g.unit() * 4.0 - 2.0)
            out.push(volume(mut g, "{p}-random-{i}", random, noise, dims, xz, y, amplitude))
        }
    }
    return out
}

/// `x` rounded to `digits` decimal places, as Python's `round(x, digits)` rounds it.
fn rounded(x: f64, digits: i64) -> f64 {
    let text = if digits == 12 { "{x:.12}" } else { "{x:.6}" }
    return f64.parse(text) ?? x
}

/// A normal noise's parameters, at random.
struct Params {
    base_octave: i64,
    base_amplitude: f64?,
    octave_count: i64?,
    modifiers: List<f64>?,
    normalize: Json?,
}

impl Params {
    fn json(self) -> Json {
        var members: List<(String, Json)> = [(String("base_octave"), n(self.base_octave))]
        if let a = self.base_amplitude {
            members.push((String("base_amplitude"), Json.Float(a)))
        }
        if let c = self.octave_count {
            members.push((String("octave_count"), n(c)))
        }
        if let mods = self.modifiers {
            var listed: List<Json> = []
            for m in mods {
                listed.push(Json.Float(m))
            }
            members.push((String("amplitude_modifiers"), arr(listed)))
        }
        if let v = self.normalize {
            members.push((String("normalize"), v.copy()))
        }
        return obj(members)
    }
}

fn random_parameters(g: mut Gen) -> Params {
    let count = g.between(1, 32)
    let base_octave = if g.below(2) != 0 { g.between(-32, 32 - count) } else { g.between(-32, 0) }
    var p = Params { base_octave: base_octave, base_amplitude: none, octave_count: none, modifiers: none, normalize: none }
    if g.below(4) != 0 {
        p.base_amplitude = some(rounded(0.2 + g.unit() * 3.0, 12))
    }
    var counted = count != 1
    if not counted {
        counted = g.below(2) != 0
    }
    if counted {
        p.octave_count = some(count)
    }
    if g.below(3) != 0 {
        var mods: List<f64> = []
        for _ in 0..count {
            let r = g.below(5)
            mods.push(if r == 0 { 0.0 } else if r == 1 { 1.0 } else { rounded(g.unit() * 3.0, 6) })
        }
        p.modifiers = some(mods)
    }
    let r = g.below(5)
    if r == 0 {
        p.normalize = some(b(false))
    } else if r == 1 {
        p.normalize = some(s("legacy"))
    } else if r == 2 {
        p.normalize = some(b(true))
    }
    return p
}

fn typed(kind: str) -> Json {
    return obj([(String("type"), s(String(kind)))])
}

fn with_parameters(kind: str, parameters: own Json) -> Json {
    return obj([(String("type"), s(String(kind))), (String("parameters"), parameters)])
}

fn find(noises: List<(String, Json)>, name: str) -> Json {
    for (key, v) in noises {
        if key == name {
            return v.copy()
        }
    }
    die("no {name} noise in the jar")
}

fn whole() -> Scale {
    return Scale { whole: true, v: 1.0 }
}

fn part(v: f64) -> Scale {
    return Scale { whole: false, v: v }
}

pub fn main() {
    var g = Gen { r: splitmix64(SEED) }
    var cases: List<Json> = []

    let perlin = typed("perlin")
    cases.extend(sampled(mut g, "perlin", perlin, [whole(), part(0.25), part(1.0 / 1024.0)], true))
    cases.extend(volumes(mut g, "perlin", perlin, [("0.25", "0"), ("1", "1"), ("0.015625", "0.0078125")]))

    for (i, fudge) in ["684.412", "8.555150000000001", "1", "0.5", "1e-3", "-3"].enumerate() {
        let smeared = obj([(String("type"), s("smeared")), (String("fudge_y_scale"), s(String(fudge)))])
        cases.extend(sampled(mut g, "smeared-{i}", smeared, [part(1.0 / 16384.0), whole()], true))
        cases.extend(volumes(mut g, "smeared-{i}", smeared, [("171.103", "85.5515"), ("1", "0.5")]))
    }

    for discard in [false, true] {
        let simplex = obj([(String("type"), s("simplex")), (String("discard_offset"), b(discard))])
        let name = if discard { "simplex-at-0" } else { "simplex" }
        cases.extend(sampled(mut g, name, simplex, [whole(), part(0.125)], true))
        cases.extend(volumes(mut g, name, simplex, [("0.5", "0.5")]))
    }

    let noises = json_files(vanilla(), "data/minecraft/worldgen/noise/")
    for (name, parameters) in noises {
        let normal = with_parameters("normal", parameters.copy())
        let id = "normal-{name.replace("/", "-")}"
        for random in ["legacy", "xoroshiro"] {
            let far = g.seed()
            cases.push(noise_case("{id}-{random}", random, far, normal, "get3", some(points(mut g, 200, String("30000000"), String("320"))), []))
            let near = g.seed()
            cases.push(noise_case("{id}-{random}-near", random, near, normal, "get3", some(points(mut g, 100, String("64"), String("64"))), []))
        }
        let range = g.seed()
        cases.push(noise_case("{id}-range", "xoroshiro", range, normal, "range", none, []))
    }
    for name in ["temperature", "continentalness", "spaghetti_3d_1", "aquifer_barrier"] {
        cases.extend(volumes(mut g, "normal-{name}", with_parameters("normal", find(noises, name)), [("0.25", "0"), ("1", "1")]))
    }
    for i in 0..40 {
        let normal = with_parameters("normal", random_parameters(mut g).json())
        let random = if i % 2 != 0 { "legacy" } else { "xoroshiro" }
        let far = g.seed()
        cases.push(noise_case("normal-random-{i}", random, far, normal, "get3", some(points(mut g, 150, String("30000000"), String("320"))), []))
        let flat = g.seed()
        cases.push(noise_case("normal-random-{i}-2d", random, flat, normal, "get2", some(pairs(mut g, 100, 3000000)), []))
        let range = g.seed()
        cases.push(noise_case("normal-random-{i}-range", random, range, normal, "range", none, []))
    }

    var nether: List<Json> = [find(noises, "nether/temperature"), find(noises, "nether/vegetation")]
    for i in 0..12 {
        var parameters = random_parameters(mut g)
        // Vanilla rejects positive octaves here, so most keep below 0, and some don't.
        if i < 9 {
            let most = 1 - (parameters.octave_count ?? 1)
            if most < parameters.base_octave {
                parameters.base_octave = most
            }
        }
        nether.push(parameters.json())
    }
    for (i, parameters) in nether.enumerate() {
        let noise = with_parameters("legacy_nether", parameters.copy())
        let far = g.seed()
        cases.push(noise_case("legacy-nether-{i}", "legacy", far, noise, "get3", some(points(mut g, 200, String("30000000"), String("128"))), []))
        let near = g.seed()
        cases.push(noise_case("legacy-nether-{i}-xoroshiro", "xoroshiro", near, noise, "get3", some(points(mut g, 100, String("1000"), String("128"))), []))
        let range = g.seed()
        cases.push(noise_case("legacy-nether-{i}-range", "legacy", range, noise, "range", none, []))
    }
    cases.extend(volumes(mut g, "legacy-nether-0", with_parameters("legacy_nether", nether[0].copy()), [("0.25", "0")]))

    // BlendedNoise's three stacks with the overworld's settings, then others.
    let fbms: List<(i64, str, str)> = [(-15, "684.412", "0.9999847412109375"), (-7, "8.555150000000001", "12.75"), (0, "1", "1"), (-3, "0.5", "-2"), (-20, "1e4", "3.5"), (1, "1", "1")]
    for (i, (first, smear, factor)) in fbms.enumerate() {
        let fbm = obj([(String("type"), s("fbm")), (String("first_octave"), n(first)), (String("smear_scale_y"), s(String(smear))), (String("value_factor"), s(String(factor)))])
        cases.extend(sampled(mut g, "fbm-{i}", fbm, [part(171.103 / 30000000.0 * 4.0), whole()], false))
        if first <= 0 {
            cases.extend(volumes(mut g, "fbm-{i}", fbm, [("171.103", "85.5515"), ("2.1387875", "0.5346969")]))
        }
    }

    write_file(file("noise", "generated.json"), String("noise"), "cases/noise/gen.calx, seed {SEED}", cases, 1)
}
