module cases.allow_list.gen

// Writes cases/allow_list/generated.json: allowed_symlinks.txt read as a server reads it as it
// starts, by vanilla's LevelStorageSource.parseValidator, then asked about link targets.
//
//     calx cases/allow_list/gen.calx
//
// Every case is for one system, since Windows matches globs with \ between names and regular
// expressions without regard to case, and a target is a path as that system's Path writes it. So
// each case here comes twice, for Windows and for Linux, with the paths written as each writes
// them. Then random files of globs, regular expressions and prefixes, with random targets.

import std.bytes.{base64}
import std.json.{Json}
import cases.kit.{arr, file, obj, s, strs}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}

/// A Linux path as Windows writes the same: under C: if it's absolute, with \ between names.
fn win(path: String) -> String {
    if path.starts_with("/") {
        return "C:{path}".replace("/", "\\")
    }
    return path.replace("/", "\\")
}

fn wins(paths: List<String>) -> List<String> {
    var out: List<String> = []
    for p in paths {
        out.push(win(p.copy()))
    }
    return out
}

/// Whether Windows' Path takes `path`: none of `<>:"|?*` or controls, but a drive's colon, and no
/// name ending in a space.
fn windows_path(path: String) -> bool {
    var i = 0
    for r in path.runes() {
        let c = u32(r)
        if c == 60 or c == 62 or c == 34 or c == 124 or c == 63 or c == 42 or c < 32 or (c == 58 and i != 1) {
            return false
        }
        i += 1
    }
    for name in path.split("\\") {
        if name.ends_with(" ") {
            return false
        }
    }
    return true
}

/// One system's case: its paths, and its file as a blob if it has one.
fn entry(system: str, name: String, text: List<u8>?, paths: List<String>) -> Json {
    var members: List<(String, Json)> = [(String("id"), s("{system}-{name}")), (String("system"), s(String(system))), (String("input"), obj([(String("paths"), strs(paths))]))]
    if let bytes = text {
        members.push((String("blobs"), arr([s(base64(bytes.copy()))])))
    }
    return obj(members)
}

/// The case for each system. `text` is the file, or none for no file; `wtext` and `wpaths` are
/// Windows' if they aren't the same with paths as Windows writes them.
fn put(cases: mut List<Json>, name: String, text: List<u8>?, paths: List<String>, wpaths: List<String>?, wtext: List<u8>?) {
    cases.push(entry("linux", name, text, paths))
    var ws: List<String> = []
    if let w = wpaths {
        ws = w.copy()
    } else {
        ws = wins(paths)
    }
    var kept: List<String> = []
    for p in ws {
        if windows_path(p.copy()) {
            kept.push(p.copy())
        }
    }
    if let w = wtext {
        cases.push(entry("windows", name, some(w.copy()), kept))
    } else {
        cases.push(entry("windows", name, text, kept))
    }
}

fn plain(cases: mut List<Json>, name: String, text: String, paths: List<String>) {
    put(mut cases, name, some(text.to_bytes()), paths, none, none)
}

fn on_windows(cases: mut List<Json>, name: String, text: String, paths: List<String>, wtext: String) {
    put(mut cases, name, some(text.to_bytes()), paths, none, some(wtext.to_bytes()))
}

fn windows_paths(cases: mut List<Json>, name: String, text: String, paths: List<String>, wpaths: List<String>) {
    put(mut cases, name, some(text.to_bytes()), paths, some(wpaths.copy()), none)
}

fn windows_both(cases: mut List<Json>, name: String, text: String, paths: List<String>, wtext: String, wpaths: List<String>) {
    put(mut cases, name, some(text.to_bytes()), paths, some(wpaths.copy()), some(wtext.to_bytes()))
}

/// Targets most cases ask about.
fn targets() -> List<String> {
    return ["/data/x", "/data/x/y", "/datax", "/other/x", "relative/x", "../up", "/DATA/X", "/"]
}

fn plus(base: List<String>, more: List<String>) -> List<String> {
    var out = base.copy()
    out.extend(more)
    return out
}

/// Bytes that aren't all UTF-8: `head`, then `odd`, then `tail`.
fn raw(head: str, odd: List<u8>, tail: str) -> List<u8> {
    var out = String(head).to_bytes()
    out.extend(odd.copy())
    out.extend(String(tail).to_bytes())
    return out
}

fn by_hand() -> List<Json> {
    var cases: List<Json> = []
    let some_paths = targets()
    // Reading the file.
    put(mut cases, "no-file", none, some_paths, none, none)
    plain(mut cases, "empty", "", some_paths)
    plain(mut cases, "only-comments", "# a comment\n#/data\n", some_paths)
    plain(mut cases, "blank-lines", "\n\n   \n\t\n\u{2028}\n\u{3000}\n/data\n", some_paths)
    windows_paths(mut cases, "no-break-space-is-an-entry", "\u{A0}\n/data\n", plus(some_paths, ["\u{A0}x"]), plus(wins(some_paths), ["\u{A0}x"]))
    plain(mut cases, "crlf", "# x\r\n/data/\r\n[prefix]/other\r\n", some_paths)
    plain(mut cases, "cr-only", "/data/\r/other", some_paths)
    plain(mut cases, "no-newline-at-end", "/other", some_paths)
    plain(mut cases, "byte-order-mark", "\u{FEFF}/data", some_paths)
    plain(mut cases, "byte-order-mark-comment", "\u{FEFF}# x\n/other", some_paths)
    windows_paths(mut cases, "leading-space-is-a-prefix", " [prefix]/data", plus(some_paths, [" [prefix]/data/x"]), plus(wins(some_paths), [#" [prefix]C:\data"#]))
    windows_paths(mut cases, "comment-after-space", " # x\n/other", plus(some_paths, [" # x"]), plus(wins(some_paths), [" # x"]))
    // Prefixes.
    plain(mut cases, "prefix-plain", "/data/", some_paths)
    plain(mut cases, "prefix-typed", "[prefix]/data", some_paths)
    plain(mut cases, "prefix-empty-allows-all", "[prefix]", some_paths)
    plain(mut cases, "prefix-relative", "[prefix]..", some_paths)
    on_windows(mut cases, "prefix-forward-slash", "/data/", some_paths, "C:/data/")
    on_windows(mut cases, "prefix-case", "/DATA", some_paths, #"C:\DATA"#)
    plain(mut cases, "prefixes-several", "/nothing\n/other/\n[prefix]/data/x/", some_paths)
    // Lines that aren't entries.
    for (name, text) in [("unterminated", "[prefix/data"), ("unterminated-empty", "["), ("type-case", "[Glob]/data/*"), ("type-empty", "[]/data"), ("type-unknown", "[path]/data"), ("type-space", "[ glob]/data/*"), ("bad-after-good", "/data\n[nope]x"), ("bad-before-good", "[nope]x\n/data"), ("bad-after-bad-regex", "[regex](\n[nope]")] {
        plain(mut cases, String(name), String(text), some_paths)
    }
    windows_paths(mut cases, "bracket-in-contents", "[glob]]x", ["]x", "/data"], ["]x", #"C:\data"#])
    plain(mut cases, "type-then-bracket", "[regex]][a]", ["]a", "]]a"])
    // Bytes that aren't UTF-8.
    put(mut cases, "not-utf8", some(raw("/data\n", [0xFFu8], "\n")), some_paths, none, none)
    put(mut cases, "not-utf8-first", some(raw("", [0xC3u8], "(\n/data")), some_paths, none, none)
    put(mut cases, "overlong", some(raw("/da", [0xC0u8, 0xAF], "ta")), some_paths, none, none)
    put(mut cases, "surrogate", some(raw("/data", [0xEDu8, 0xA0, 0x80], "")), some_paths, none, none)
    put(mut cases, "cut-off", some(raw("/data", [0xE2u8, 0x82], "")), some_paths, none, none)
    put(mut cases, "past-unicode", some(raw("/", [0xF4u8, 0x90, 0x80, 0x80], "")), some_paths, none, none)
    plain(mut cases, "four-byte-utf8", "/data/\u{1F600}", ["/data/\u{1F600}x", "/data/x"])
    // Globs.
    on_windows(mut cases, "glob-star", "[glob]/data/*", some_paths, "[glob]C:/data/*")
    on_windows(mut cases, "glob-star-star", "[glob]/data/**", some_paths, "[glob]C:/data/**")
    on_windows(mut cases, "glob-question", "[glob]/data/?", plus(some_paths, ["/data/\u{E9}", "/data/\u{1F600}"]), "[glob]C:/data/?")
    on_windows(mut cases, "glob-braces", #"[glob]/{data,other}/*"#, some_paths, #"[glob]C:/{data,other}/*"#)
    on_windows(mut cases, "glob-class", "[glob]/data/[!y]", plus(some_paths, ["/data/y", "/data/z"]), "[glob]C:/data/[!y]")
    on_windows(mut cases, "glob-range", "[glob]/data/[a-x]", plus(some_paths, ["/data/y"]), "[glob]C:/data/[a-x]")
    plain(mut cases, "glob-relative", "[glob]*/*", some_paths)
    windows_both(mut cases, "glob-backslash-escapes", #"[glob]/data/\*"#, plus(some_paths, ["/data/*"]), #"[glob]C:\\data\\*"#, plus(wins(some_paths), [#"C:\data\x"#]))
    plain(mut cases, "glob-dots", "[glob]../*", some_paths)
    plain(mut cases, "glob-regex-characters", "[glob]/d(a)+t|a$/^*", ["/d(a)+t|a$/^x", "/data/x"])
    on_windows(mut cases, "glob-case", "[glob]/DATA/*", some_paths, "[glob]C:/DATA/*")
    on_windows(mut cases, "glob-unicode-case", "[glob]/\u{E4}/*", ["/\u{C4}/x", "/\u{E4}/x"], "[glob]C:/\u{E4}/*")
    for (name, glob) in [("glob-unclosed-brace", #"/data/{a"#), ("glob-nested-braces", #"/{a,{b}}"#), ("glob-unclosed-class", "/data/[a"), ("glob-trailing-escape", #"/data/\"#), ("glob-separator-in-class", "/data/[/]"), ("glob-bad-range", "/data/[z-a]")] {
        plain(mut cases, String(name), "/data\n[glob]{glob}", some_paths)
    }
    plain(mut cases, "glob-error-unused", #"[glob]{"#, [])
    // Regular expressions.
    on_windows(mut cases, "regex-dot-star", "[regex]/data/.*", some_paths, #"[regex]C:\\data\\.*"#)
    plain(mut cases, "regex-whole", "[regex]/data", plus(some_paths, ["/data"]))
    on_windows(mut cases, "regex-alternatives", "[regex]/(data|other)/x", some_paths, #"[regex]C:\\(data|other)\\x"#)
    on_windows(mut cases, "regex-digits", #"[regex]/data/\d+"#, ["/data/1", "/data/12a", "/data/x"], #"[regex]C:\\data\\\d+"#)
    on_windows(mut cases, "regex-case", "[regex]/DATA/X", some_paths, #"[regex]C:\\DATA\\X"#)
    on_windows(mut cases, "regex-inline-flag", "[regex](?i)/data/x", some_paths, #"[regex](?-i)C:\\data\\x"#)
    windows_both(mut cases, "regex-unicode-case", "[regex]/\u{E4}.*", ["/\u{C4}x", "/\u{E4}x"], "[regex]C:\\\\\u{E4}.*", ["C:\\\u{C4}x", "C:\\\u{E4}x"])
    windows_both(mut cases, "regex-sigma", "[regex]/\u{3C3}", ["/\u{3A3}", "/\u{3C2}"], "[regex]\\\\\u{3C3}", ["\\\u{3A3}", "\\\u{3C2}"])
    windows_both(mut cases, "regex-kelvin", "[regex]/k", ["/K", "/\u{212A}"], #"[regex]\\k"#, [#"\K"#, "\\\u{212A}"])
    windows_both(mut cases, "regex-backref", #"[regex]/(.+)/\1"#, ["/ab/ab", "/ab/AB", "/ab/cd"], #"[regex]\\(.+)\\\1"#, [#"\ab\ab"#, #"\ab\AB"#, #"\ab\cd"#])
    plain(mut cases, "regex-lookahead", "[regex](?!/data).*", some_paths)
    windows_both(mut cases, "regex-quoted", #"[regex]\Q/data/.*\E"#, plus(some_paths, ["/data/.*"]), #"[regex]\QC:\data\.*\E"#, plus(wins(some_paths), [#"C:\data\.*"#]))
    plain(mut cases, "regex-empty", "[regex]", some_paths)
    on_windows(mut cases, "regex-comments-flag", "[regex](?x) / data / .* # anything", some_paths, #"[regex](?x) C: \\ data \\ .* # anything"#)
    for (name, regex) in [("regex-unclosed-group", "(/data"), ("regex-dangling", "*/data"), ("regex-unclosed-class", "[a"), ("regex-bad-escape", #"\y"#), ("regex-bad-repetition", #"a{2,1}"#), ("regex-trailing-backslash", #"/data\"#), ("regex-unknown-group", #"\k<n>"#)] {
        plain(mut cases, String(name), "/data\n[regex]{regex}", some_paths)
    }
    plain(mut cases, "regex-error-after-good", "[regex]/data/.*\n[regex](", some_paths)
    plain(mut cases, "regex-error-unused", "[regex](", [])
    // Targets on Windows.
    let w: List<String> = [#"C:\data\x"#, #"c:\data\x"#, #"\\server\share\x"#, "C:x", #"\data\x"#, #"D:\"#]
    cases.push(obj([(String("id"), s("windows-roots")), (String("system"), s("windows")), (String("input"), obj([(String("paths"), strs(w))])), (String("blobs"), arr([s(base64(String("[glob]?:/data/*\n[regex]\\\\\\\\server.*\n[prefix]C:").to_bytes()))]))]))
    cases.push(obj([(String("id"), s("windows-glob-backslash-in-class")), (String("system"), s("windows")), (String("input"), obj([(String("paths"), strs(w))])), (String("blobs"), arr([s(base64(String(#"[glob]C:\\data\\[\\]"#).to_bytes()))]))]))
    return cases
}

// Pieces of random entries, as Linux paths, which Windows' cases write as Windows does.
fn glob_pieces() -> List<str> {
    return ["/", "data", "x", "y", "*", "**", "?", "[a-x]", "[!y]", #"{data,other}"#, #"{x,y,}"#, ".", "..", "-", "\u{E9}", "X", "[xy]", "/data/", "D"]
}

fn regex_pieces() -> List<str> {
    return ["/", "data", "x", "y", ".", ".*", ".+", "[a-z]", "[^/]*", "(?i)", "(data|other)", "x?", #"\d"#, "(?:/[^/]+)*", "X", "\u{E9}", "$", "^", #"\w+"#, "(?=/d)", "(?!/o)"]
}

fn path_pieces() -> List<str> {
    return ["data", "other", "x", "y", "X", "DATA", ".", "..", "\u{E9}", "\u{C9}", "1", "xy", "a-b", "d"]
}

fn pick(rand: mut SplitMix64, items: List<str>) -> str {
    return items[usize.wrap(rand.next() % u64(items.len()))]
}

fn random_cases(count: i64, seed: u64) -> List<Json> {
    let globs = glob_pieces()
    let regexes = regex_pieces()
    let names = path_pieces()
    var rand = splitmix64(seed)
    var cases: List<Json> = []
    for k in 0..count {
        var lines: List<String> = []
        var wlines: List<String> = []
        let entries = 1 + rand.next() % 3
        for _ in 0..entries {
            let kind = rand.next() % 3
            let pieces = 1 + rand.next() % 5
            if kind == 0 {
                var g = String()
                for _ in 0..pieces {
                    g.push_str(pick(mut rand, globs))
                }
                lines.push("[glob]{g}")
                wlines.push("[glob]{g}")
            } else if kind == 1 {
                var r = String()
                for _ in 0..pieces {
                    r.push_str(pick(mut rand, regexes))
                }
                lines.push("[regex]{r}")
                // Windows writes \ between names, which a regular expression escapes.
                wlines.push("[regex]{r.replace("/", "\\\\")}")
            } else {
                var parts: List<String> = []
                for _ in 0..pieces % 3 {
                    parts.push(String(pick(mut rand, names)))
                }
                let p = "/{parts.join("/")}"
                lines.push(p.copy())
                wlines.push(win(p))
            }
        }
        var paths: List<String> = []
        for _ in 0..6 {
            var parts: List<String> = []
            let many = 1 + rand.next() % 3
            for _ in 0..many {
                parts.push(String(pick(mut rand, names)))
            }
            if rand.next() % 4 != 0 {
                paths.push("/{parts.join("/")}")
            } else {
                paths.push(parts.join("/"))
            }
        }
        let text = "{lines.join("\n")}\n"
        let wtext = "{wlines.join("\n")}\n"
        put(mut cases, "random-{k}", some(text.to_bytes()), paths, none, some(wtext.to_bytes()))
    }
    return cases
}

pub fn main() {
    var cases = by_hand()
    cases.extend(random_cases(300, 20261031))
    write_file(file("allow_list", "generated.json"), String("allow_list"), String("cases/allow_list/gen.calx"), cases, 1)
}
