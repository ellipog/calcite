module cases.density.gen

// Writes cases/density/generated.json: density functions compiled by a RandomState and sampled.
//
//     calx cases/density/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, and the vanilla ids from the
// pinned server jar in oracle/jars/, so rerunning it gives the same file.
//
// The cases name vanilla's material by id and never copy it: every density function of the vanilla
// data pack, by reference, and every field of every noise settings' router. Each is sampled where
// worldgen samples it: at points near the origin, across a world, and at the ends of `int`, and
// over a noise chunk's cells, a section's blocks, and volumes at random. Then synthetic functions
// cover every type and its edges one at a time, and random trees of them cover how they combine:
// constant folding, ranges that decide which sampler compiles, caches shared between functions and
// sampled through one context, interpolation over aligned and unaligned volumes at every step, and
// functions vanilla rejects as it works out their ranges or compiles them.
//
// Each draw is a statement of its own, in the order the Python drew them: a dict's values in the
// order they're written, a list's items before the pick among them, and `or`'s right side only
// when its left fails. The synthetic functions are JSON text with `@` where a noise function
// drawn at random goes, filled in the order they're written. Numbers are JSON values, integers or
// floats as the Python's were, and the names that hold one write it as Python's `str` did.

import std.json
import std.json.{Json}
import std.zip.{Zip}
import cases.jar.{names, vanilla}
import cases.kit.{arr, b, case_with, file, ints, n, obj, s}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}
import tools.pyjson.{compact}
import tools.repo.{die}

const SEED: u64 = 20261102
const ROUTER: [str; 8] = ["temperature", "vegetation", "continents", "erosion", "depth", "ridges", "chunk_surface_level", "final_density"]
const LONG_SEEDS: [str; 6] = ["0", "1", "-1", "9223372036854775807", "-9223372036854775808", "12345"]
const INT_MAX: i64 = 2147483647
const INT_MIN: i64 = -2147483648
// Coordinates at the edges: of `int`, of a world, and of the bits `BlockPos.asLong` packs them in.
const EDGE_INTS: [i64; 35] = [0, -1, 1, 2, -2, 15, 16, -16, -17, 4, 8, -64, 320, 2031, -2032, 2047, 2048, -2048, -2049, 30000000, -30000000, 29999999, -29999984, 33554431, -33554432, 33554432, -33554433, 67108864, -67108864, 2147483647, -2147483648, 2147483646, -2147483647, 1073741824, -1073741824]
const CONSTANTS: str = "[0,-0.0,1,-1,0.5,-0.5,2,1000000,-1000000,0.25,3,-3,1e-7,64,-64,0.1]"
const UNARY: [str; 11] = ["abs", "square", "cube", "sqrt", "half_negative", "quarter_negative", "reciprocal", "negate", "squeeze", "log", "sign"]
const BINARY: [str; 6] = ["add", "sub", "mul", "div", "min", "max"]
const ROUND: [str; 4] = ["floor", "round", "ceil", "truncate"]
const METRICS: [str; 4] = ["euclidean", "euclidean_squared", "manhattan", "chebyshev"]
const TILINGS: [str; 3] = ["clamp_to_edge", "repeat", "mirrored_repeat"]
const AXES: [str; 3] = ["x", "y", "z"]

/// JSON written out, as the Python wrote its dicts and lists.
fn j(text: String) -> Json {
    return match json.parse(text.copy()) {
        ok(v) => v,
        err(e) => die("{text}: {e}"),
    }
}

fn list(text: String) -> List<Json> {
    if let Json.Array(xs) = j(text.copy()) {
        return xs
    }
    die("not a list: {text}")
}

/// A number's value, an integer's or a float's.
fn value(v: Json) -> f64 {
    return match v {
        Json.Int(i) => f64.nearest(i),
        Json.Float(f) => f,
        _ => die("not a number: {v}"),
    }
}

fn float(v: f64) -> Json {
    return Json.Float(v)
}

/// Floats sorted as Python's `sorted` sorts them: by value, those equal in the order they came.
fn sorted(xs: List<f64>) -> List<f64> {
    var out: List<f64> = []
    for x in xs {
        var at = out.len()
        while at > 0 and x < out[at - 1] {
            at -= 1
        }
        out.insert(at, x)
    }
    return out
}

struct Gen {
    r: SplitMix64
}

impl Gen {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn between(mut self, lo: i64, hi: i64) -> i64 {
        return lo + self.below(hi - lo + 1)
    }

    fn unit(mut self) -> f64 {
        return f64.nearest(i64.wrap(self.r.next() >> 11)) / 9007199254740992.0
    }

    fn chance(mut self, bound: i64) -> bool {
        return self.below(bound) == 0
    }

    fn pick(mut self, items: List<str>) -> str {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    fn pick_text(mut self, items: List<String>) -> String {
        return items[usize.wrap(self.below(i64.wrap(items.len())))].copy()
    }

    fn pick_value(mut self, items: List<Json>) -> Json {
        return items[usize.wrap(self.below(i64.wrap(items.len())))].copy()
    }

    fn pick_int(mut self, items: List<i64>) -> i64 {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    fn long(mut self) -> String {
        return "{i64.wrap(self.r.next())}"
    }

    fn seed(mut self) -> String {
        if self.chance(3) {
            return String(LONG_SEEDS[usize.wrap(self.below(6))])
        }
        return self.long()
    }

    fn blob_seed(mut self) -> String {
        return "{self.r.next() >> 1}"
    }

    /// A float in [lo, hi], rounded to 4 places as Python's `round` rounds, so the JSON stays
    /// short.
    fn real(mut self, lo: f64, hi: f64) -> f64 {
        let x = lo + (hi - lo) * self.unit()
        return f64.parse("{x:.4}") ?? x
    }
}

/// The vanilla data pack's density functions, noises and noise settings, by id.
struct Ids {
    functions: List<String>,
    noises: List<String>,
    settings: List<String>,
}

fn ids_of(jar: Zip, prefix: str) -> List<String> {
    var out: List<String> = []
    for name in names(jar, prefix, ".json") {
        out.push("minecraft:{name[prefix.len()..name.len() - 5]}")
    }
    return out
}

fn member(key: str, v: own Json) -> (String, Json) {
    return (String(key), v)
}

fn typed(kind: str) -> (String, Json) {
    return (String("type"), s(String(kind)))
}

/// One case: functions, the ops that sample them in order, and the points those ops read.
struct Case {
    id: String,
    seed: String,
    settings: String?,
    legacy: bool,
    functions: List<Json>,
    cached: bool,
    ops: List<Json>,
    parts: List<Json>,
}

fn start(id: own String, seed: own String, settings: own String?, legacy: bool, cached: bool) -> Case {
    return Case { id: id, seed: seed, settings: settings, legacy: legacy, functions: [], cached: cached, ops: [], parts: [] }
}

impl Case {
    fn function(mut self, f: own Json) -> i64 {
        self.functions.push(obj([member("function", f)]))
        return i64.wrap(self.functions.len()) - 1
    }

    fn router(mut self, field: str) -> i64 {
        self.functions.push(obj([member("router", s(String(field)))]))
        return i64.wrap(self.functions.len()) - 1
    }

    fn points(mut self, index: i64, part: own Json, count: i64) {
        self.ops.push(obj([member("fn", n(index)), member("points", n(count))]))
        self.parts.push(part)
    }

    fn volume(mut self, index: i64, dims: List<i64>) {
        self.ops.push(obj([member("fn", n(index)), member("volume", ints(dims))]))
    }

    fn build(self) -> Json {
        var input: List<(String, Json)> = [member("seed", s(self.seed.copy()))]
        if let settings = self.settings {
            input.push(member("settings", s(settings.copy())))
        } else {
            input.push(member("legacy_random", b(self.legacy)))
        }
        input.push(member("functions", arr(self.functions.copy())))
        input.push(member("cached", b(self.cached)))
        input.push(member("ops", arr(self.ops.copy())))
        let blob = if self.parts.is_empty() { obj([(String("i32"), arr([]))]) } else { arr(self.parts.copy()) }
        return case_with(self.id.copy(), obj(input), [blob])
    }
}

fn ranged(g: mut Gen, count: i64, ranges: List<(str, str)>) -> Json {
    let seed = g.blob_seed()
    var spans: List<Json> = []
    for (lo, hi) in ranges {
        spans.push(arr([s(String(lo)), s(String(hi))]))
    }
    return obj([member("gen", s("i32_range")), member("seed", s(seed)), member("count", n(count)), member("ranges", arr(spans))])
}

fn near(g: mut Gen, count: i64) -> Json {
    return ranged(mut g, count, [("-300", "300"), ("-80", "340"), ("-300", "300")])
}

fn far(g: mut Gen, count: i64) -> Json {
    return ranged(mut g, count, [("-30000000", "30000000"), ("-2100", "2100"), ("-30000000", "30000000")])
}

fn anywhere(g: mut Gen, count: i64) -> Json {
    return ranged(mut g, count, [("-2147483648", "2147483647"), ("-2147483648", "2147483647"), ("-2147483648", "2147483647")])
}

fn edges(g: mut Gen, count: i64) -> Json {
    var out: List<i64> = []
    for _ in 0..count * 3 {
        out.push(g.pick_int(EDGE_INTS.to_list()))
    }
    return obj([member("i32", ints(out))])
}

fn listed(triples: List<(i64, i64, i64)>) -> Json {
    var out: List<i64> = []
    for (x, y, z) in triples {
        out.push(x)
        out.push(y)
        out.push(z)
    }
    return obj([member("i32", ints(out))])
}

/// A noise chunk's cell corners: 5 by 49 by 5, 4 blocks apart across and 8 up.
fn cells(g: mut Gen) -> List<i64> {
    let x = g.between(-1875000, 1874999) * 16
    let z = g.between(-1875000, 1874999) * 16
    return [5, 49, 5, x, -64, z, 4, 8, 4]
}

fn section(g: mut Gen) -> List<i64> {
    let x = g.between(-1875000, 1874999) * 16
    let y = g.between(-4, 19) * 16
    let z = g.between(-1875000, 1874999) * 16
    return [16, 16, 16, x, y, z, 1, 1, 1]
}

fn column(g: mut Gen) -> List<i64> {
    let x = g.between(-100000, 100000)
    let y = g.between(-64, 320)
    let z = g.between(-100000, 100000)
    return [16, 1, 16, x, y, z, 1, 1, 1]
}

fn random_volume(g: mut Gen, limit: i64) -> List<i64> {
    var sx = 0i64
    var sy = 0i64
    var sz = 0i64
    loop {
        sx = g.between(1, 12)
        sy = g.between(1, 40)
        sz = g.between(1, 12)
        if sx * sy * sz <= limit {
            break
        }
    }
    let span = if g.chance(4) { 30000000i64 } else { 2000 }
    let x = g.between(-span, span)
    let y = g.between(-2100, 2100)
    let z = g.between(-span, span)
    let tx = g.between(1, 9)
    let ty = g.between(1, 9)
    let tz = g.between(1, 9)
    return [sx, sy, sz, x, y, z, tx, ty, tz]
}

/// Points on the grid of a volume, and some just off it.
fn inside(g: mut Gen, dims: List<i64>, count: i64) -> List<(i64, i64, i64)> {
    var out: List<(i64, i64, i64)> = []
    for _ in 0..count {
        let x = dims[3] + g.below(dims[0]) * dims[6]
        let y = dims[4] + g.below(dims[1]) * dims[7]
        let z = dims[5] + g.below(dims[2]) * dims[8]
        var p = [x, y, z]
        if g.chance(4) {
            let axis = usize.wrap(g.below(3))
            p[axis] += g.pick_int([-1, 1])
        }
        out.push((p[0], p[1], p[2]))
    }
    return out
}

/// A function at points near, far and at the edges, and over the volumes worldgen uses.
fn sampled(g: mut Gen, c: mut Case, index: i64, heavy: bool) {
    c.points(index, near(mut g, 120), 120)
    c.points(index, far(mut g, 100), 100)
    c.points(index, edges(mut g, 30), 30)
    c.volume(index, cells(mut g))
    if heavy {
        c.volume(index, section(mut g))
    }
    c.volume(index, column(mut g))
    c.volume(index, random_volume(mut g, 2000))
}

/// Ops that reach every cache cell's paths: a volume, points on it and off it, a point twice,
/// another volume, then the first again, across all the functions in turn.
fn cached_ops(g: mut Gen, c: mut Case, fns: List<i64>) {
    let first = cells(mut g)
    let second = random_volume(mut g, 600)
    for index in fns {
        c.volume(index, first)
        var pts = inside(mut g, first, 40)
        let (p0, p1) = (pts[0], pts[1])
        pts.push(p0)
        pts.push(p0)
        pts.push(p1)
        c.points(index, listed(pts), i64.wrap(pts.len()))
    }
    for index in fns {
        c.volume(index, second)
        var pts = inside(mut g, first, 20)
        pts.extend(inside(mut g, second, 20))
        // Points that `BlockPos.asLong` packs to the same key as the one before.
        let (x, y, z) = pts[pts.len() - 1]
        pts.push((x + (1i64 << 26), y, z))
        pts.push((x, y + 4096, z))
        pts.push((x, y, z - (1i64 << 26)))
        c.points(index, listed(pts), i64.wrap(pts.len()))
        c.volume(index, first)
    }
}

// Synthetic functions.

fn constant(g: mut Gen) -> Json {
    var v = Json.Null
    if g.chance(2) {
        v = g.pick_value(list(String(CONSTANTS)))
    } else {
        v = float(g.real(-10.0, 10.0))
    }
    if g.chance(3) {
        return v
    }
    return obj([typed("constant"), member("value", v)])
}

fn noise_id(g: mut Gen, ids: Ids) -> String {
    return g.pick_text(ids.noises)
}

fn noise_fn(g: mut Gen, ids: Ids, depth: i64) -> Json {
    let noise = noise_id(mut g, ids)
    let xz_real = g.real(0.0, 3.0)
    let xz = g.pick_value([n(0), float(0.25), n(1), float(0.5), float(xz_real), n(1000)])
    let y_real = g.real(0.0, 3.0)
    let y = g.pick_value([n(0), float(0.25), n(1), float(y_real)])
    var f: List<(String, Json)> = [typed("noise"), member("noise", s(noise)), member("xz_scale", xz), member("y_scale", y)]
    for axis in AXES {
        if g.chance(3) {
            let shift = if depth > 0 { leaf(mut g, ids) } else { constant(mut g) }
            f.push(("shift_{axis}", shift))
        }
    }
    return obj(f)
}

fn gradient(g: mut Gen) -> Json {
    var a = g.between(-400, 400)
    var c = g.between(-400, 400)
    if g.chance(8) {
        a = g.pick_int([INT_MIN, INT_MAX, 0, -30000000])
        c = g.pick_int([INT_MAX, INT_MIN, 1, 30000000])
    }
    if a == c {
        c = if a < INT_MAX { a + 1 } else { a - 1 }
    }
    let axis = g.pick(AXES.to_list())
    let from_real = g.real(-5.0, 5.0)
    let from_value = g.pick_value([n(1), n(-1), n(0), n(1000000), float(from_real)])
    let to_real = g.real(-5.0, 5.0)
    let to_value = g.pick_value([n(-1), n(1), n(0), n(-1000000), float(to_real)])
    var f: List<(String, Json)> = [typed("gradient"), member("axis", s(String(axis))), member("from_coordinate", n(a)), member("to_coordinate", n(c)), member("from_value", from_value), member("to_value", to_value)]
    if not g.chance(3) {
        f.push(member("tiling", s(String(g.pick(TILINGS.to_list())))))
    }
    return obj(f)
}

fn distance(g: mut Gen) -> Json {
    let span = g.pick_int([100, 30000000, INT_MAX])
    let x = g.between(-span, span)
    let y = g.between(-span, span)
    let z = g.between(-span, span)
    let metric = g.pick(METRICS.to_list())
    return obj([typed("distance_to_point"), member("point", ints([x, y, z])), member("metric", s(String(metric)))])
}

fn blended(g: mut Gen) -> Json {
    let r1 = g.real(0.001, 4.0)
    let xz_scale = g.pick_value([float(0.25), n(1), float(r1), n(1000), float(0.001)])
    let r2 = g.real(0.001, 4.0)
    let y_scale = g.pick_value([float(0.125), n(1), float(r2), n(1000)])
    let r3 = g.real(0.001, 400.0)
    let xz_factor = g.pick_value([n(80), n(160), float(r3), n(1000)])
    let r4 = g.real(0.001, 400.0)
    let y_factor = g.pick_value([n(160), n(90), float(r4), float(0.001)])
    let r5 = g.real(1.0, 8.0)
    let smear = g.pick_value([n(8), n(4), n(1), float(r5)])
    return obj([typed("old_blended_noise"), member("xz_scale", xz_scale), member("y_scale", y_scale), member("xz_factor", xz_factor), member("y_factor", y_factor), member("smear_scale_multiplier", smear)])
}

fn leaf(g: mut Gen, ids: Ids) -> Json {
    let k = g.below(16)
    if k < 4 {
        return constant(mut g)
    }
    if k < 6 {
        return noise_fn(mut g, ids, 0)
    }
    if k < 8 {
        return gradient(mut g)
    }
    if k == 8 {
        return distance(mut g)
    }
    if k == 9 {
        let kind = g.pick(["shift_a", "shift_b", "shift"])
        let noise = noise_id(mut g, ids)
        return obj([typed(kind), member("noise", s(noise))])
    }
    if k == 10 {
        return s(String(g.pick(["minecraft:y", "minecraft:zero", "minecraft:shift_x", "minecraft:shift_z", "minecraft:overworld/continents", "minecraft:overworld/erosion", "minecraft:overworld/ridges"])))
    }
    if k == 11 {
        return obj([typed(g.pick(["blend_alpha", "blend_offset", "beardifier"]))])
    }
    if k == 12 {
        return obj([typed("end_outer_islands")])
    }
    if k == 13 {
        return blended(mut g)
    }
    return constant(mut g)
}

fn spline(g: mut Gen, ids: Ids, depth: i64) -> Json {
    if depth <= 0 or g.chance(3) {
        let r = g.real(-2.0, 2.0)
        return g.pick_value([n(0), n(1), n(-1), float(0.5), float(r)])
    }
    let count = g.between(1, 5)
    var drawn: List<f64> = []
    for _ in 0..count {
        drawn.push(g.real(-1.5, 1.5))
    }
    var locations = sorted(drawn)
    if g.chance(8) {
        locations.reverse()
    }
    let coordinate = if g.chance(3) { tree(mut g, ids, depth - 1) } else { leaf(mut g, ids) }
    var points: List<Json> = []
    for location in locations {
        let v = spline(mut g, ids, depth - 1)
        let r = g.real(-3.0, 3.0)
        let derivative = g.pick_value([n(0), n(0), n(1), n(-1), float(r)])
        points.push(obj([member("location", float(location)), member("value", v), member("derivative", derivative)]))
    }
    return obj([member("coordinate", coordinate), member("points", arr(points))])
}

fn tree(g: mut Gen, ids: Ids, depth: i64) -> Json {
    if depth <= 0 or g.chance(5) {
        return leaf(mut g, ids)
    }
    let k = g.below(20)
    let next = depth - 1
    if k < 5 {
        let kind = g.pick(BINARY.to_list())
        let left = tree(mut g, ids, next)
        let right = tree(mut g, ids, next)
        return obj([typed(kind), member("left", left), member("right", right)])
    }
    if k < 8 {
        let kind = g.pick(UNARY.to_list())
        return obj([typed(kind), member("input", tree(mut g, ids, next))])
    }
    if k == 8 {
        let kind = g.pick(ROUND.to_list())
        var f: List<(String, Json)> = [typed(kind), member("input", tree(mut g, ids, next))]
        if g.chance(2) {
            let multiple = if g.chance(2) { g.pick_value([n(1), n(0), float(0.5), n(2), n(16)]) } else { tree(mut g, ids, next) }
            f.push(member("multiple", multiple))
        }
        return obj(f)
    }
    if k == 9 {
        let lo = g.real(-2.0, 2.0)
        let input = tree(mut g, ids, next)
        let r = g.real(0.0, 3.0)
        let add = g.pick_value([n(0), float(r)])
        return obj([typed("clamp"), member("input", input), member("min", float(lo)), member("max", float(lo + value(add)))])
    }
    if k == 10 {
        let alpha = tree(mut g, ids, next)
        let first = tree(mut g, ids, next)
        let second = tree(mut g, ids, next)
        return obj([typed("lerp"), member("alpha", alpha), member("first", first), member("second", second)])
    }
    if k == 11 {
        let lo = g.real(-1.5, 1.5)
        let input = tree(mut g, ids, next)
        let hi = lo + g.real(-0.5, 2.0)
        let in_range = tree(mut g, ids, next)
        let out_of_range = tree(mut g, ids, next)
        return obj([typed("range_choice"), member("input", input), member("min_inclusive", float(lo)), member("max_exclusive", float(hi)), member("when_in_range", in_range), member("when_out_of_range", out_of_range)])
    }
    if k == 12 {
        let count = g.between(2, 5)
        let input = tree(mut g, ids, next)
        var drawn: List<f64> = []
        for _ in 0..count - 1 {
            drawn.push(g.real(-1.5, 1.5))
        }
        var thresholds: List<Json> = []
        for t in sorted(drawn) {
            thresholds.push(float(t))
        }
        var functions: List<Json> = []
        for _ in 0..count {
            functions.push(tree(mut g, ids, next))
        }
        return obj([typed("interval_select"), member("input", input), member("thresholds", arr(thresholds)), member("functions", arr(functions))])
    }
    if k == 13 {
        let base = tree(mut g, ids, next)
        let exponent = if g.chance(2) { g.pick_value(list("[0.5,1,2,3,-0.5,-1,-2,-3,0,1.5]")) } else { tree(mut g, ids, next) }
        return obj([typed("pow"), member("base", base), member("exponent", exponent)])
    }
    if k == 14 {
        return obj([typed("spline"), member("spline", spline(mut g, ids, depth))])
    }
    if k == 15 {
        return obj([typed("cache"), member("input", tree(mut g, ids, next))])
    }
    if k == 16 {
        let input = tree(mut g, ids, next)
        let xz = g.pick_int([4, 1, 2, 3, 8])
        let y = g.pick_int([8, 4, 1, 3, 16])
        return obj([typed("interpolated"), member("input", input), member("cell_size_xz", n(xz)), member("cell_size_y", n(y))])
    }
    if k == 17 {
        let axis = g.pick(AXES.to_list())
        let coordinate = g.between(-100, 100)
        let input = tree(mut g, ids, next)
        return obj([typed("slice"), member("axis", s(String(axis))), member("coordinate", n(coordinate)), member("input", input)])
    }
    if k == 18 {
        return obj([typed("blend_density"), member("input", tree(mut g, ids, next))])
    }
    let lower = g.between(-200, 100)
    let density = tree(mut g, ids, next)
    let above = lower + g.between(0, 300)
    let clamped = obj([typed("clamp"), member("input", tree(mut g, ids, next)), member("min", n(-200)), member("max", n(400))])
    let upper = g.pick_value([n(above), clamped])
    let cell = g.pick_int([8, 4, 16, 1, 5])
    return obj([typed("find_top_surface"), member("density", density), member("upper_bound", upper), member("lower_bound", n(lower)), member("cell_height", n(cell))])
}

/// JSON text with each `@` a noise function drawn at random, drawn in the order they're written.
fn fill(g: mut Gen, ids: Ids, text: String) -> Json {
    let pieces = text.split("@")
    var out = String()
    for (i, piece) in pieces.enumerate() {
        if i > 0 {
            out.push_str(compact(noise_fn(mut g, ids, 0)))
        }
        out.push_str(piece)
    }
    return j(out)
}

/// A number as Python's `str` wrote it in a name.
fn text_of(v: Json) -> String {
    return compact(v)
}

/// Functions that cover each type and its edges, in a list of (name, function).
fn synthetic(g: mut Gen, ids: Ids) -> List<(String, Json)> {
    var out: List<(String, Json)> = []
    for v in list(String(CONSTANTS)) {
        out.push(("constant-{text_of(v)}", v.copy()))
        out.push(("constant-typed-{text_of(v)}", obj([typed("constant"), member("value", v.copy())])))
    }
    for name in UNARY {
        out.push(("{name}-noise", fill(mut g, ids, #"{"type":"#{name}","input":@}"#)))
        out.push(("{name}-gradient", j(#"{"type":"#{name}","input":{"type":"gradient","axis":"y","from_coordinate":-64,"to_coordinate":320,"from_value":2,"to_value":-2}}"#)))
        for v in list("[0,-0.0,1,-1,0.5,-1000000,1000000]") {
            out.push(("{name}-const-{text_of(v)}", obj([typed(name), member("input", v.copy())])))
        }
        out.push(("{name}-beardifier", j(#"{"type":"#{name}","input":{"type":"beardifier"}}"#)))
        out.push(("{name}-distance", j(#"{"type":"#{name}","input":{"type":"sub","left":{"type":"distance_to_point","point":[0,64,0],"metric":"chebyshev"},"right":100}}"#)))
    }
    for name in BINARY {
        out.push(("{name}-noises", fill(mut g, ids, #"{"type":"#{name}","left":@,"right":@}"#)))
        let left = g.pick_value(list("[0,2,-0.5]"))
        out.push(("{name}-const-left", fill(mut g, ids, #"{"type":"#{name}","left":#{compact(left)},"right":@}"#)))
        let noise = noise_fn(mut g, ids, 0)
        let right = g.pick_value(list("[0,2,-0.5]"))
        out.push(("{name}-const-right", obj([typed(name), member("left", noise), member("right", right)])))
        let a = g.real(-3.0, 3.0)
        let c = g.real(-3.0, 3.0)
        out.push(("{name}-consts", obj([typed(name), member("left", float(a)), member("right", float(c))])))
        out.push(("{name}-zero", fill(mut g, ids, #"{"type":"#{name}","left":@,"right":0}"#)))
        // Ranges that don't meet: min and max pick a side as they compile.
        out.push(("{name}-apart", fill(mut g, ids, #"{"type":"#{name}","left":{"type":"add","left":@,"right":10},"right":@}"#)))
        out.push(("{name}-apart-2", fill(mut g, ids, #"{"type":"#{name}","left":@,"right":{"type":"add","left":@,"right":10}}"#)))
        out.push(("{name}-touch", fill(mut g, ids, #"{"type":"#{name}","left":{"type":"clamp","input":@,"min":0,"max":1},"right":{"type":"clamp","input":@,"min":1,"max":2}}"#)))
        out.push(("{name}-infinite", fill(mut g, ids, #"{"type":"#{name}","left":{"type":"reciprocal","input":@},"right":{"type":"beardifier"}}"#)))
    }
    for name in ROUND {
        for multiple in list("[null,1,0,0.5,4,-2]") {
            var f: List<(String, Json)> = [typed(name), member("input", fill(mut g, ids, #"{"type":"mul","left":@,"right":40}"#))]
            var label = String("default")
            if multiple != Json.Null {
                label = text_of(multiple)
                f.push(member("multiple", multiple.copy()))
            }
            out.push(("{name}-multiple-{label}", obj(f)))
        }
        out.push(("{name}-multiple-fn", fill(mut g, ids, #"{"type":"#{name}","input":{"type":"mul","left":@,"right":40},"multiple":@}"#)))
        out.push(("{name}-halves", j(#"{"type":"#{name}","input":{"type":"gradient","axis":"x","from_coordinate":-8,"to_coordinate":8,"from_value":-4,"to_value":4}}"#)))
    }
    for pair in list("[[0,1],[-1,1],[0.5,0.5],[-1000000,1000000],[2,3]]") {
        let lo = compact((pair.at(0) ?? Json.Null).copy())
        let hi = compact((pair.at(1) ?? Json.Null).copy())
        out.push(("clamp-{lo}-{hi}", fill(mut g, ids, #"{"type":"clamp","input":{"type":"mul","left":@,"right":3},"min":#{lo},"max":#{hi}}"#)))
    }
    out.push((String("lerp"), fill(mut g, ids, #"{"type":"lerp","alpha":@,"first":@,"second":@}"#)))
    out.push((String("lerp-const-first"), fill(mut g, ids, #"{"type":"lerp","alpha":@,"first":2,"second":@}"#)))
    out.push((String("lerp-const-second"), fill(mut g, ids, #"{"type":"lerp","alpha":@,"first":@,"second":-1}"#)))
    out.push((String("lerp-alpha-clamped"), fill(mut g, ids, #"{"type":"lerp","alpha":{"type":"clamp","input":{"type":"mul","left":@,"right":4},"min":0,"max":1},"first":@,"second":@}"#)))
    out.push((String("lerp-alpha-const"), fill(mut g, ids, #"{"type":"lerp","alpha":0.25,"first":@,"second":@}"#)))
    out.push((String("lerp-alpha-gradient"), fill(mut g, ids, #"{"type":"lerp","alpha":{"type":"gradient","axis":"y","from_coordinate":0,"to_coordinate":64,"from_value":-0.5,"to_value":1.5},"first":@,"second":@}"#)))
    out.push((String("lerp-infinite"), fill(mut g, ids, #"{"type":"lerp","alpha":@,"first":{"type":"beardifier"},"second":{"type":"reciprocal","input":@}}"#)))
    for pair in list("[[-0.2,0.3],[0,0],[0.5,0.1],[-1000000,1000000]]") {
        let lo = compact((pair.at(0) ?? Json.Null).copy())
        let hi = compact((pair.at(1) ?? Json.Null).copy())
        out.push(("range-choice-{lo}-{hi}", fill(mut g, ids, #"{"type":"range_choice","input":@,"min_inclusive":#{lo},"max_exclusive":#{hi},"when_in_range":@,"when_out_of_range":@}"#)))
        out.push(("range-choice-const-{lo}-{hi}", fill(mut g, ids, #"{"type":"range_choice","input":@,"min_inclusive":#{lo},"max_exclusive":#{hi},"when_in_range":1,"when_out_of_range":-1}"#)))
    }
    out.push((String("range-choice-one-const"), fill(mut g, ids, #"{"type":"range_choice","input":@,"min_inclusive":0,"max_exclusive":1,"when_in_range":1,"when_out_of_range":@}"#)))
    out.push((String("interval-select-1"), fill(mut g, ids, #"{"type":"interval_select","input":@,"thresholds":[0.1],"functions":[@,@]}"#)))
    out.push((String("interval-select-1-const"), fill(mut g, ids, #"{"type":"interval_select","input":@,"thresholds":[0],"functions":[1,-1]}"#)))
    out.push((String("interval-select-4"), fill(mut g, ids, #"{"type":"interval_select","input":@,"thresholds":[-0.5,0,0,0.5],"functions":[@,1,@,2,@]}"#)))
    for e in list("[0.5,1,2,3,-0.5,-1,-2,-3,0,1.5,-1.5,10]") {
        let text = compact(e)
        out.push(("pow-exponent-{text}", fill(mut g, ids, #"{"type":"pow","base":{"type":"abs","input":@},"exponent":#{text}}"#)))
        out.push(("pow-signed-{text}", fill(mut g, ids, #"{"type":"pow","base":@,"exponent":#{text}}"#)))
    }
    for base in list("[2,0.5,0,-2,1]") {
        let text = compact(base)
        out.push(("pow-base-{text}", fill(mut g, ids, #"{"type":"pow","base":#{text},"exponent":{"type":"mul","left":@,"right":3}}"#)))
    }
    out.push((String("pow-both"), fill(mut g, ids, #"{"type":"pow","base":{"type":"add","left":{"type":"abs","input":@},"right":0.5},"exponent":@}"#)))
    out.push((String("pow-zero-base"), fill(mut g, ids, #"{"type":"pow","base":{"type":"clamp","input":@,"min":0,"max":0},"exponent":@}"#)))
    out.push((String("pow-negative-base"), fill(mut g, ids, #"{"type":"pow","base":{"type":"sub","left":{"type":"clamp","input":@,"min":-1,"max":0},"right":1},"exponent":@}"#)))
    for axis in AXES {
        for tiling in TILINGS {
            for (a, c) in [(-64i64, 320i64), (320, -64), (0, 1), (INT_MIN, INT_MAX), (5, -5)] {
                out.push(("gradient-{axis}-{tiling}-{a}-{c}", j(#"{"type":"gradient","axis":"#{axis}","tiling":"#{tiling}","from_coordinate":#{a},"to_coordinate":#{c},"from_value":1.5,"to_value":-1.5}"#)))
            }
        }
        out.push(("gradient-{axis}-default", j(#"{"type":"gradient","axis":"#{axis}","from_coordinate":0,"to_coordinate":16,"from_value":0,"to_value":1}"#)))
        let coordinate = g.between(-50, 50)
        out.push(("slice-{axis}", fill(mut g, ids, #"{"type":"slice","axis":"#{axis}","coordinate":#{coordinate},"input":@}"#)))
        let far_coordinate = g.pick_int([INT_MAX, INT_MIN, 30000000])
        out.push(("slice-{axis}-far", fill(mut g, ids, #"{"type":"slice","axis":"#{axis}","coordinate":#{far_coordinate},"input":@}"#)))
    }
    out.push((String("slice-xz"), fill(mut g, ids, #"{"type":"slice","axis":"x","coordinate":7,"input":{"type":"slice","axis":"z","coordinate":-3,"input":@}}"#)))
    out.push((String("slice-zx"), fill(mut g, ids, #"{"type":"slice","axis":"z","coordinate":12,"input":{"type":"slice","axis":"x","coordinate":100,"input":@}}"#)))
    out.push((String("slice-yx"), fill(mut g, ids, #"{"type":"slice","axis":"y","coordinate":64,"input":{"type":"slice","axis":"x","coordinate":2,"input":@}}"#)))
    out.push((String("slice-xx"), fill(mut g, ids, #"{"type":"slice","axis":"x","coordinate":1,"input":{"type":"slice","axis":"x","coordinate":2,"input":@}}"#)))
    let uniform_noise = noise_id(mut g, ids)
    out.push((String("slice-uniform"), j(#"{"type":"slice","axis":"y","coordinate":0,"input":{"type":"add","left":{"type":"noise","noise":"#{uniform_noise}","xz_scale":1,"y_scale":0},"right":{"type":"gradient","axis":"x","from_coordinate":0,"to_coordinate":10,"from_value":0,"to_value":1}}}"#)))
    for metric in METRICS {
        for (x, y, z) in [(0i64, 0i64, 0i64), (100, -64, -100), (INT_MAX, INT_MIN, INT_MAX), (-30000000, 2031, 30000000)] {
            out.push(("distance-{metric}-{x}", j(#"{"type":"distance_to_point","point":[#{x},#{y},#{z}],"metric":"#{metric}"}"#)))
        }
    }
    out.push((String("end-islands"), j(#"{"type":"end_outer_islands"}"#)))
    out.push((String("end-islands-scaled"), j(#"{"type":"mul","left":{"type":"end_outer_islands"},"right":0.5}"#)))
    for name in ["shift_a", "shift_b", "shift"] {
        let noise = noise_id(mut g, ids)
        out.push((String(name), obj([typed(name), member("noise", s(noise))])))
        out.push(("{name}-offset", j(#"{"type":"#{name}","noise":"minecraft:offset"}"#)))
    }
    for name in ["blend_alpha", "blend_offset", "beardifier"] {
        out.push((String(name), obj([typed(name)])))
    }
    out.push((String("blend-density"), fill(mut g, ids, #"{"type":"blend_density","input":@}"#)))
    let plain = noise_id(mut g, ids)
    out.push((String("noise-plain"), j(#"{"type":"noise","noise":"#{plain}","xz_scale":1,"y_scale":1}"#)))
    let flat = noise_id(mut g, ids)
    out.push((String("noise-flat"), j(#"{"type":"noise","noise":"#{flat}","xz_scale":0.25,"y_scale":0}"#)))
    let zero = noise_id(mut g, ids)
    out.push((String("noise-zero"), j(#"{"type":"noise","noise":"#{zero}","xz_scale":0,"y_scale":0}"#)))
    let shift_xz = noise_id(mut g, ids)
    out.push((String("noise-shift-xz"), j(#"{"type":"noise","noise":"#{shift_xz}","xz_scale":0.25,"y_scale":0,"shift_x":"minecraft:shift_x","shift_z":"minecraft:shift_z"}"#)))
    let shift_xyz = noise_id(mut g, ids)
    out.push((String("noise-shift-xyz"), fill(mut g, ids, #"{"type":"noise","noise":"#{shift_xyz}","xz_scale":1,"y_scale":1,"shift_x":@,"shift_y":@,"shift_z":@}"#)))
    let shift_zero = noise_id(mut g, ids)
    out.push((String("noise-shift-zero"), j(#"{"type":"noise","noise":"#{shift_zero}","xz_scale":1,"y_scale":1,"shift_x":0,"shift_y":0.0,"shift_z":{"type":"constant","value":0}}"#)))
    let negative_zero = noise_id(mut g, ids)
    out.push((String("noise-shift-negative-zero"), j(#"{"type":"noise","noise":"#{negative_zero}","xz_scale":1,"y_scale":1,"shift_x":-0.0,"shift_y":-0.0,"shift_z":-0.0}"#)))
    let huge = noise_id(mut g, ids)
    out.push((String("noise-huge-scale"), j(#"{"type":"noise","noise":"#{huge}","xz_scale":1e9,"y_scale":1e9}"#)))
    out.push((String("noise-nether-temperature"), j(#"{"type":"noise","noise":"minecraft:nether/temperature","xz_scale":1,"y_scale":1}"#)))
    out.push((String("noise-nether-vegetation"), j(#"{"type":"noise","noise":"minecraft:nether/vegetation","xz_scale":0.25,"y_scale":0}"#)))
    for i in 0..4 {
        out.push(("blended-{i}", blended(mut g)))
    }
    out.push((String("blended-overworld"), j(#"{"type":"old_blended_noise","xz_scale":0.25,"y_scale":0.125,"xz_factor":80,"y_factor":160,"smear_scale_multiplier":8}"#)))
    out.push((String("blended-extremes"), j(#"{"type":"old_blended_noise","xz_scale":1000,"y_scale":1000,"xz_factor":0.001,"y_factor":0.001,"smear_scale_multiplier":1}"#)))
    for (xz, y) in [(4i64, 8i64), (1, 1), (2, 3), (8, 16), (3, 5), (16, 1)] {
        out.push(("interpolated-{xz}-{y}", fill(mut g, ids, #"{"type":"interpolated","input":{"type":"add","left":@,"right":@},"cell_size_xz":#{xz},"cell_size_y":#{y}}"#)))
    }
    out.push((String("interpolated-cached-input"), fill(mut g, ids, #"{"type":"interpolated","input":{"type":"cache","input":@},"cell_size_xz":4,"cell_size_y":8}"#)))
    out.push((String("interpolated-nested"), fill(mut g, ids, #"{"type":"interpolated","input":{"type":"interpolated","input":@,"cell_size_xz":2,"cell_size_y":4},"cell_size_xz":4,"cell_size_y":8}"#)))
    out.push((String("spline-const"), j(#"{"type":"spline","spline":0.5}"#)))
    out.push((String("spline-one"), fill(mut g, ids, #"{"type":"spline","spline":{"coordinate":@,"points":[{"location":0,"value":1,"derivative":2}]}}"#)))
    out.push((String("spline-flat"), fill(mut g, ids, #"{"type":"spline","spline":{"coordinate":@,"points":[{"location":-0.5,"value":-1,"derivative":0},{"location":0.5,"value":1,"derivative":0}]}}"#)))
    out.push((String("spline-same-location"), fill(mut g, ids, #"{"type":"spline","spline":{"coordinate":@,"points":[{"location":0,"value":-1,"derivative":1},{"location":0,"value":1,"derivative":-1},{"location":0.5,"value":0,"derivative":0}]}}"#)))
    out.push((String("spline-reversed"), fill(mut g, ids, #"{"type":"spline","spline":{"coordinate":@,"points":[{"location":0.5,"value":-1,"derivative":1},{"location":-0.5,"value":1,"derivative":3}]}}"#)))
    out.push((String("spline-huge"), fill(mut g, ids, #"{"type":"spline","spline":{"coordinate":@,"points":[{"location":-3e38,"value":1e39,"derivative":1e30},{"location":3e38,"value":-2,"derivative":0}]}}"#)))
    let shared = compact(noise_fn(mut g, ids, 0))
    out.push((String("spline-shared-coordinate"), fill(mut g, ids, #"{"type":"spline","spline":{"coordinate":#{shared},"points":[{"location":-0.5,"value":{"coordinate":#{shared},"points":[{"location":0,"value":1,"derivative":0.5},{"location":1,"value":2,"derivative":0}]},"derivative":0},{"location":0.5,"value":{"coordinate":@,"points":[{"location":-1,"value":-1,"derivative":0},{"location":1,"value":0.5,"derivative":1}]},"derivative":-1}]}}"#)))
    out.push((String("spline-nan-coordinate"), fill(mut g, ids, #"{"type":"spline","spline":{"coordinate":{"type":"log","input":@},"points":[{"location":-1,"value":0,"derivative":1},{"location":1,"value":1,"derivative":0}]}}"#)))
    out.push((String("spline-overworld-offset"), s("minecraft:overworld/offset")))
    for cell in [8i64, 4, 1, 16] {
        out.push(("find-top-surface-{cell}", fill(mut g, ids, #"{"type":"find_top_surface","density":{"type":"add","left":{"type":"gradient","axis":"y","from_coordinate":-64,"to_coordinate":320,"from_value":1,"to_value":-1},"right":{"type":"mul","left":@,"right":0.5}},"upper_bound":320,"lower_bound":-64,"cell_height":#{cell}}"#)))
    }
    out.push((String("find-top-surface-low"), fill(mut g, ids, #"{"type":"find_top_surface","density":@,"upper_bound":-100,"lower_bound":-64,"cell_height":8}"#)))
    out.push((String("find-top-surface-bound-fn"), fill(mut g, ids, #"{"type":"find_top_surface","density":@,"upper_bound":{"type":"add","left":{"type":"mul","left":@,"right":100},"right":64},"lower_bound":-64,"cell_height":8}"#)))
    out.push((String("find-top-surface-limits"), j(#"{"type":"find_top_surface","density":{"type":"gradient","axis":"y","from_coordinate":0,"to_coordinate":1,"from_value":1,"to_value":-1},"upper_bound":4100,"lower_bound":-4064,"cell_height":64}"#)))
    out.push((String("cache"), fill(mut g, ids, #"{"type":"cache","input":@}"#)))
    out.push((String("cache-nested"), fill(mut g, ids, #"{"type":"cache","input":{"type":"cache","input":@}}"#)))
    out.push((String("reference-zero"), s("minecraft:zero")))
    out.push((String("reference-y"), s("minecraft:y")))
    return out
}

/// Functions vanilla rejects as it works out their ranges or compiles them.
fn rejected(g: mut Gen, ids: Ids) -> List<(str, Json)> {
    return [
        ("inline-noise", j(#"{"type":"noise","noise":{"base_octave":-3,"octave_count":2},"xz_scale":1,"y_scale":1}"#)),
        ("inline-shift", j(#"{"type":"shift_a","noise":{"base_octave":-3,"octave_count":2}}"#)),
        ("nan-range-add", j(#"{"type":"add","left":{"type":"beardifier"},"right":{"type":"negate","input":{"type":"beardifier"}}}"#)),
        ("nan-range-mul", fill(mut g, ids, #"{"type":"mul","left":{"type":"reciprocal","input":@},"right":{"type":"beardifier"}}"#)),
        ("nan-monotonic", j(#"{"type":"cube","input":{"type":"add","left":{"type":"beardifier"},"right":{"type":"beardifier"}}}"#)),
        ("top-surface-nan-bound", fill(mut g, ids, #"{"type":"find_top_surface","density":@,"upper_bound":{"type":"add","left":{"type":"beardifier"},"right":{"type":"negate","input":{"type":"beardifier"}}},"lower_bound":0,"cell_height":8}"#)),
        ("spline-backwards-range", fill(mut g, ids, #"{"type":"spline","spline":{"coordinate":@,"points":[{"location":1,"value":5,"derivative":100},{"location":0,"value":-5,"derivative":100}]}}"#)),
        ("log-negative", fill(mut g, ids, #"{"type":"log","input":{"type":"sub","left":{"type":"clamp","input":@,"min":-1,"max":0},"right":2}}"#)),
        ("sqrt-negative", fill(mut g, ids, #"{"type":"sqrt","input":{"type":"sub","left":{"type":"clamp","input":@,"min":-1,"max":0},"right":2}}"#)),
        ("reciprocal-zero", j(#"{"type":"reciprocal","input":0}"#)),
        ("pow-infinite", j(#"{"type":"pow","base":{"type":"beardifier"},"exponent":{"type":"beardifier"}}"#)),
        ("lerp-infinite-alpha", j(#"{"type":"lerp","alpha":{"type":"beardifier"},"first":{"type":"beardifier"},"second":1}"#)),
        ("div-zero", fill(mut g, ids, #"{"type":"div","left":@,"right":0}"#)),
    ]
}

pub fn main() {
    var g = Gen { r: splitmix64(SEED) }
    let jar = vanilla()
    let ids = Ids { functions: ids_of(jar, "data/minecraft/worldgen/density_function/"), noises: ids_of(jar, "data/minecraft/worldgen/noise/"), settings: ids_of(jar, "data/minecraft/worldgen/noise_settings/") }
    var cases: List<Json> = []

    // Every vanilla density function, by reference.
    for fid in ids.functions {
        let name = fid[10..fid.len()].replace("/", "-")
        var c = start("vanilla-{name}", g.seed(), none, false, false)
        let index = c.function(s(fid.copy()))
        sampled(mut g, mut c, index, true)
        cases.push(c.build())
        var cached = start("vanilla-{name}-legacy-cached", g.seed(), none, true, true)
        let cached_index = cached.function(s(fid.copy()))
        cached_ops(mut g, mut cached, [cached_index])
        cases.push(cached.build())
    }

    // Every noise settings' router, one case each, then cached with the fields sharing caches.
    for sid in ids.settings {
        let name = sid[10..sid.len()]
        for field in ROUTER {
            var c = start("router-{name}-{field}", g.seed(), some(sid.copy()), false, false)
            let index = c.router(field)
            sampled(mut g, mut c, index, field == "final_density")
            cases.push(c.build())
        }
        var cached = start("router-{name}-cached", g.seed(), some(sid.copy()), false, true)
        var fns: List<i64> = []
        for field in ROUTER {
            fns.push(cached.router(field))
        }
        cached_ops(mut g, mut cached, fns)
        cases.push(cached.build())
        var uncached = start("router-{name}-uncached", g.seed(), some(sid.copy()), false, false)
        var routers: List<i64> = []
        for field in ROUTER {
            routers.push(uncached.router(field))
        }
        let first = cells(mut g)
        for index in routers {
            uncached.volume(index, first)
            uncached.points(index, near(mut g, 40), 40)
        }
        cases.push(uncached.build())
    }

    // Each type and its edges.
    for (name, f) in synthetic(mut g, ids) {
        let legacy = g.chance(3)
        let seed = g.seed()
        var c = start("type-{name}", seed, none, legacy, g.chance(4))
        let index = c.function(f.copy())
        c.points(index, near(mut g, 60), 60)
        c.points(index, far(mut g, 40), 40)
        c.points(index, edges(mut g, 20), 20)
        c.points(index, anywhere(mut g, 10), 10)
        c.volume(index, cells(mut g))
        let x = g.between(-1000, 1000)
        let y = g.between(-100, 300)
        let z = g.between(-1000, 1000)
        c.volume(index, [8, 8, 8, x, y, z, 1, 1, 1])
        c.volume(index, column(mut g))
        c.volume(index, random_volume(mut g, 800))
        cases.push(c.build())
    }

    // Interpolation over every kind of volume: aligned at the cell's step, unaligned, at block
    // steps, at other steps, and one block thick.
    for i in 0..24 {
        let steps: List<(i64, i64)> = [(4, 8), (1, 1), (2, 4), (3, 5), (8, 2), (16, 16)]
        let (xz, y) = steps[usize.wrap(g.below(i64.wrap(steps.len())))]
        let input = tree(mut g, ids, 2)
        let f = obj([typed("interpolated"), member("input", input), member("cell_size_xz", n(xz)), member("cell_size_y", n(y))])
        let seed = g.seed()
        var c = start("interpolated-volumes-{i}", seed, none, false, g.chance(2))
        let index = c.function(f)
        let bx = g.between(-300, 300)
        let by = g.between(-64, 256)
        let bz = g.between(-300, 300)
        let ax = bx - bx.floor_mod(xz)
        let ay = by - by.floor_mod(y)
        let az = bz - bz.floor_mod(xz)
        c.volume(index, [5, 9, 5, ax, ay, az, xz, y, xz])
        c.volume(index, [5, 9, 5, bx, by, bz, xz, y, xz])
        c.volume(index, [1, 9, 1, bx, by, bz, xz, y, xz])
        c.volume(index, [9, 1, 9, ax, by, az, xz, 1, xz])
        c.volume(index, [10, 12, 7, bx, by, bz, 1, 1, 1])
        let tx = g.between(1, 5)
        let ty = g.between(1, 5)
        let tz = g.between(1, 5)
        c.volume(index, [6, 6, 6, bx, by, bz, tx, ty, tz])
        c.volume(index, [3, 4, 5, ax, ay, az, 1, 1, 1])
        c.points(index, listed(inside(mut g, [5, 9, 5, ax, ay, az, xz, y, xz], 30)), 30)
        c.points(index, near(mut g, 30), 30)
        cases.push(c.build())
    }

    // Random trees, alone and several to a case sharing caches.
    for i in 0..160 {
        let seed = g.seed()
        let legacy = g.chance(3)
        var c = start("tree-{i}", seed, none, legacy, g.chance(2))
        let depth = g.between(2, 4)
        let index = c.function(tree(mut g, ids, depth))
        c.points(index, near(mut g, 50), 50)
        c.points(index, far(mut g, 30), 30)
        c.points(index, edges(mut g, 10), 10)
        c.volume(index, cells(mut g))
        c.volume(index, random_volume(mut g, 600))
        cases.push(c.build())
    }
    for i in 0..24 {
        let seed = g.seed()
        var c = start("trees-shared-{i}", seed, none, g.chance(3), true)
        let common = obj([typed("cache"), member("input", tree(mut g, ids, 2))])
        var fns: List<i64> = []
        let count = g.between(2, 4)
        for _ in 0..count {
            let f = tree(mut g, ids, 2)
            let kind = g.pick(BINARY.to_list())
            fns.push(c.function(obj([typed(kind), member("left", common.copy()), member("right", f)])))
        }
        cached_ops(mut g, mut c, fns)
        cases.push(c.build())
    }

    for (name, f) in rejected(mut g, ids) {
        var c = start("rejected-{name}", g.seed(), none, false, false)
        let index = c.function(f.copy())
        c.points(index, near(mut g, 10), 10)
        c.volume(index, cells(mut g))
        cases.push(c.build())
    }
    // A rejection after other functions have compiled: the earlier ones' answers are never written.
    var after = start(String("rejected-after-others"), g.seed(), none, false, false)
    _ = after.function(s("minecraft:overworld/continents"))
    let index = after.function(j(#"{"type":"noise","noise":{"base_octave":-3},"xz_scale":1,"y_scale":1}"#))
    after.points(index, near(mut g, 5), 5)
    cases.push(after.build())

    write_file(file("density", "generated.json"), String("density"), "cases/density/gen.calx, seed {SEED}", cases, 1)
}
