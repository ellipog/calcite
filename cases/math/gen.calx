module cases.math.gen

// Writes the math, strictmath and mth case files.
//
//     calx cases/math/gen.calx
//
// `math` and `strictmath` get the same inputs, so their goldens can be compared (P1.5, D58). The
// files hold generator specs, not values: the runner expands them (rig/README.md).

import std.json.{Json}
import cases.kit.{arr, case, case_with, file, n, obj, s, strs}
import rig.runner.cases.{write_file}

const SEED: i64 = 20261027
const COUNT: i64 = 2000

fn special() -> List<String> {
    return ["0", "-0", "1", "-1", "0.5", "-0.5", "2", "-2", "10", "100", "1e-8", "1e-300", "1e22", "1e300", "-1e300", "inf", "-inf", "nan", "0x1p-1074", "-0x1p-1074", "0x1p-1022", "0x0.fffffffffffffp-1022", "0x1.fffffffffffffp1023", "-0x1.fffffffffffffp1023", "0x1p-30", "0x1p30", "0x1p52", "0x1p53", "3.141592653589793", "-3.141592653589793", "1.5707963267948966", "0.7853981633974483", "6.283185307179586", "2.718281828459045", "709.782712893384", "710", "-745.1332191019412", "-746", "0.9999999999999999", "1.0000000000000002", "-0.9999999999999999"]
}

fn pair_special() -> List<String> {
    return ["0", "-0", "1", "-1", "0.5", "2", "-2", "3", "inf", "-inf", "nan", "0x1p-1074", "1e300"]
}

/// Every pair of PAIR_SPECIAL's, flattened: `[a1, b1, a1, b2, ...]`.
fn pairs() -> List<String> {
    var out: List<String> = []
    for a in pair_special() {
        for b in pair_special() {
            out.push(a.copy())
            out.push(b.copy())
        }
    }
    return out
}

/// For each function with one argument, the ranges its random arguments come from.
fn unary() -> List<(str, List<(str, str)>)> {
    return [
        ("sin", [("-10", "10"), ("-1e6", "1e6"), ("-1e300", "1e300")]),
        ("cos", [("-10", "10"), ("-1e6", "1e6"), ("-1e300", "1e300")]),
        ("tan", [("-10", "10"), ("-1e6", "1e6")]),
        ("asin", [("-1", "1")]),
        ("acos", [("-1", "1")]),
        ("atan", [("-100", "100"), ("-1e300", "1e300")]),
        ("exp", [("-745", "710"), ("-1", "1")]),
        ("expm1", [("-40", "710"), ("-1e-5", "1e-5")]),
        ("log", [("0", "2"), ("0", "1e300")]),
        ("log10", [("0", "2"), ("0", "1e300")]),
        ("log1p", [("-1", "1"), ("-1", "1e300")]),
        ("sqrt", [("0", "1e300")]),
        ("cbrt", [("-1e300", "1e300")]),
        ("sinh", [("-720", "720"), ("-1", "1")]),
        ("cosh", [("-720", "720")]),
        ("tanh", [("-25", "25")]),
    ]
}

fn binary() -> List<(str, List<List<(str, str)>>)> {
    return [
        ("atan2", [[("-10", "10"), ("-10", "10")], [("-1e300", "1e300"), ("-1e300", "1e300")]]),
        ("pow", [[("0", "100"), ("-20", "20")], [("0", "2"), ("-1000", "1000")], [("-10", "0"), ("-5", "5")]]),
        ("hypot", [[("-1e3", "1e3"), ("-1e3", "1e3")], [("-1e300", "1e300"), ("-1e300", "1e300")]]),
    ]
}

fn fn_input(name: str) -> Json {
    return obj([(String("fn"), s(String(name)))])
}

fn values(kind: str, xs: List<String>) -> Json {
    return obj([(String(kind), strs(xs))])
}

fn range(seed: i64, count: i64, lo: str, hi: str) -> Json {
    return obj([(String("gen"), s("f64_range")), (String("seed"), s("{seed}")), (String("count"), n(count)), (String("min"), s(String(lo))), (String("max"), s(String(hi)))])
}

fn ranges(seed: i64, count: i64, rs: List<(str, str)>) -> Json {
    var listed: List<Json> = []
    for (lo, hi) in rs {
        listed.push(strs([String(lo), String(hi)]))
    }
    return obj([(String("gen"), s("f64_range")), (String("seed"), s("{seed}")), (String("count"), n(count)), (String("ranges"), arr(listed))])
}

fn bits(gen: str, seed: i64, count: i64) -> Json {
    return obj([(String("gen"), s(String(gen))), (String("seed"), s("{seed}")), (String("count"), n(count))])
}

fn math_cases() -> List<Json> {
    var cases: List<Json> = []
    var seed = SEED
    for (name, rs) in unary() {
        cases.push(case_with("{name}-special", fn_input(name), [values("f64", special())]))
        for (i, (lo, hi)) in rs.enumerate() {
            seed += 1
            cases.push(case_with("{name}-range-{i}", fn_input(name), [range(seed, COUNT, lo, hi)]))
        }
        seed += 1
        cases.push(case_with("{name}-bits", fn_input(name), [bits("f64_bits", seed, COUNT)]))
    }
    for (name, sets) in binary() {
        cases.push(case_with("{name}-special", fn_input(name), [values("f64", pairs())]))
        for (i, rs) in sets.enumerate() {
            seed += 1
            cases.push(case_with("{name}-range-{i}", fn_input(name), [ranges(seed, COUNT, rs)]))
        }
        seed += 1
        cases.push(case_with("{name}-bits", fn_input(name), [bits("f64_bits", seed, 2 * COUNT)]))
    }
    return cases
}

fn with_more(base: List<String>, more: List<String>) -> List<String> {
    var out = base.copy()
    out.extend(more)
    return out
}

fn mth_cases() -> List<Json> {
    var seed = SEED + 1000
    let angles = with_more(special(), ["-1e-300", "102943.70603", "-102943.70603", "1e15", "-1e15"])
    var cases: List<Json> = [case(String("sin-table"), fn_input("sin_table"))]
    for name in ["sin", "cos"] {
        cases.push(case_with("{name}-special", fn_input(name), [values("f64", angles)]))
        seed += 1
        cases.push(case_with("{name}-range", fn_input(name), [range(seed, COUNT, "-1000", "1000")]))
    }
    cases.push(case_with(String("atan2-special"), fn_input("atan2"), [values("f64", pairs())]))
    seed += 1
    cases.push(case_with(String("atan2-range"), fn_input("atan2"), [ranges(seed, COUNT, [("-10", "10"), ("-10", "10")])]))
    cases.push(case_with(String("fast-inv-sqrt-special"), fn_input("fast_inv_sqrt"), [values("f64", special())]))
    seed += 1
    cases.push(case_with(String("fast-inv-sqrt-range"), fn_input("fast_inv_sqrt"), [range(seed, COUNT, "0", "1000")]))
    let wrap: List<String> = ["0", "-0", "180", "-180", "179.99998", "180.00002", "360", "-360", "540", "1e10", "-1e10", "inf", "-inf", "nan", "0x1p-149", "3.4028235e38", "-3.4028235e38", "359.99997", "-179.99998"]
    cases.push(case_with(String("wrap-degrees-special"), fn_input("wrap_degrees"), [values("f32", wrap)]))
    seed += 1
    var f32_range = range(seed, COUNT, "-100000", "100000")
    if let Json.Object(m) = f32_range {
        var members = m
        members.insert("gen", s("f32_range"))
        f32_range = Json.Object(members)
    }
    cases.push(case_with(String("wrap-degrees-range"), fn_input("wrap_degrees"), [f32_range]))
    seed += 1
    cases.push(case_with(String("wrap-degrees-bits"), fn_input("wrap_degrees"), [bits("f32_bits", seed, COUNT)]))
    let floors = with_more(special(), ["2147483647", "2147483648", "-2147483648", "-2147483649", "-0.5", "-1e-300", "1.9999999999999998"])
    cases.push(case_with(String("floor-special"), fn_input("floor"), [values("f64", floors)]))
    seed += 1
    cases.push(case_with(String("floor-range"), fn_input("floor"), [range(seed, COUNT, "-3e7", "3e7")]))
    let seed_points: List<String> = ["0", "0", "0", "1", "2", "3", "-1", "-1", "-1", "30000000", "319", "-30000000", "-2147483648", "2147483647", "-2147483648"]
    cases.push(case_with(String("get-seed-special"), fn_input("get_seed"), [values("i32", seed_points)]))
    seed += 1
    let points = obj([(String("gen"), s("i32_range")), (String("seed"), s("{seed}")), (String("count"), n(3 * COUNT)), (String("min"), s("-30000000")), (String("max"), s("30000000"))])
    cases.push(case_with(String("get-seed-range"), fn_input("get_seed"), [points]))
    return cases
}

pub fn main() {
    let cases = math_cases()
    let by = "cases/math/gen.calx, seed {SEED}"
    write_file(file("math", "generated.json"), String("math"), by.copy(), cases.copy(), 2)
    write_file(file("strictmath", "generated.json"), String("strictmath"), by.copy(), cases, 2)
    write_file(file("mth", "generated.json"), String("mth"), by, mth_cases(), 2)
}
