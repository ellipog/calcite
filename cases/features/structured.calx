module cases.features.structured

// Writes cases/features/structured.json: chunks decorated with their structures' pieces placed
// before each step's features.
//
//     calx cases/features/structured.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED and from the names in vanilla's
// data pack, so rerunning it gives the same file.
//
// Each structure a set places by random spread gets a world of one biome it may start in,
// decorated at a chunk its set may place it in, as the `structures` cases pick them; whether a
// start is made there is vanilla's to say. Abandoned camps, which differ only by their biome, get
// three of the eighteen.
//
// Strongholds, End cities and Nether fortresses also get chunks their pieces fill, a start's own
// chunk seldom holding much of them: each in a world of one biome with a seed of its own, at
// chunks picked by asking the `structures` probe where those worlds' starts are and which chunks
// their pieces reach, among them a stronghold's portal room and library, an End city's ship and a
// fortress's blaze spawner.
//
// Chunks of the full Overworld of one seed where a structure's edge meets coral and kelp follow,
// each alone, then in a shared world after the eight around it.

import std.json.{Json}
import cases.jar.{json_files, vanilla}
import cases.kit.{b, file, with}
import cases.structures.gen.{biomes_of, candidates, fixed, gen, placement_for, preset, start, world_of}
import rig.runner.cases.{write_file}

const SEED: u64 = 20261110
const CAMPS: [str; 3] = ["abandoned_camp_forest", "abandoned_camp_savanna", "abandoned_camp_snowy_taiga"]

/// Worlds of one biome, and the chunks in them where a structure's pieces are, by name.
fn filled() -> List<(str, str, str, List<(str, i64, i64)>)> {
    return [
        ("stronghold", "plains", "20261110", [
            ("start", -96, -36), ("portal", -95, -37), ("crossings", 85, -72), ("library", 85, -73),
            ("stairs", 86, -71), ("library2", 12, 110), ("portal2", 11, 108),
        ]),
        ("end_city", "end_highlands", "20261111", [
            ("start", 105, 3), ("towers", 104, 3), ("bridges", 104, 4), ("small", 144, 6),
            ("far", 223, 4), ("long", 263, 2), ("farthest", 362, 26),
        ]),
        ("fortress", "nether_wastes", "20261112", [
            ("start", 22, 9), ("well", 21, 9), ("corridors", 20, 6), ("spawner", 25, 10),
            ("stalks", 21, 8), ("busy", 91, 21), ("bridges", 205, 6),
        ]),
    ]
}

// Chunks of the full Overworld where a structure's edge updates the shapes of what grew beside
// it: coral, coral wall fans and kelp by shipwrecks and ocean ruins, which a pregeneration of seed
// 20261101 out to 60 chunks found (CAL-90).
const SHAPED_SEED: str = "20261101"
const SHAPED: [(i64, i64); 7] = [(-31, -35), (-29, -35), (-33, -31), (-29, -14), (-62, -69), (-51, -32), (-50, -33)]

/// A case's input with `shared` added last, as the Python set it after making the case.
fn shared(c: own Json) -> Json {
    let input = (c.get(String("input")) ?? Json.Null).copy()
    return with(c, "input", with(input, "shared", b(true)))
}

pub fn main() {
    var g = gen(SEED)
    let jar = vanilla()
    let sets = json_files(jar, "data/minecraft/worldgen/structure_set/")
    var defs = json_files(jar, "data/minecraft/worldgen/structure/")
    let tags = json_files(jar, "data/minecraft/tags/worldgen/biome/")
    defs.sort_by(|a, c| a.0.cmp(c.0))
    var cases: List<Json> = []
    for (id, structure) in defs {
        if id.starts_with("abandoned_camp_") and not CAMPS.any(|camp| camp == id) {
            continue
        }
        let p = placement_for(sets, id.copy()) else {
            continue
        }
        if p.kind != "minecraft:random_spread" {
            continue
        }
        let biomes = biomes_of(structure.get(String("biomes")) ?? Json.Null, tags)
        if biomes.len() == 0 {
            continue
        }
        let biome = biomes[usize.wrap(g.below(i64.wrap(biomes.len())))].copy()
        let seed = g.seed()
        var c = start("structured-{id}", seed.copy(), world_of(biome.copy()), fixed(biome))
        let found = candidates(mut g, seed, p, 1, false)
        c.op("structured", [found[0].0, found[0].1])
        cases.push(c.build())
    }
    for (id, biome, seed, chunks) in filled() {
        for (name, x, z) in chunks {
            var c = start("structured-{id}-{name}", String(seed), world_of(String(biome)), fixed(String(biome)))
            c.op("structured", [x, z])
            cases.push(c.build())
        }
    }
    for (x, z) in SHAPED {
        var alone = start("structured-overworld-shapes-{x}-{z}", String(SHAPED_SEED), "overworld", preset("overworld"))
        alone.op("structured", [x, z])
        cases.push(alone.build())
        // In one world: the eight around it decorated first, so what grew in them is there when
        // its structures' edges meet it, as on a server.
        var around = start("structured-overworld-shapes-{x}-{z}-shared", String(SHAPED_SEED), "overworld", preset("overworld"))
        for dz in -1i64..2 {
            for dx in -1i64..2 {
                if dx != 0 or dz != 0 {
                    around.op("structured", [x + dx, z + dz])
                }
            }
        }
        around.op("structured", [x, z])
        cases.push(shared(around.build()))
    }
    write_file(file("features", "structured.json"), String("features"), "cases/features/structured.calx, seed {SEED}", cases, 4)
}
