module cases.features.orders

// Writes cases/features/orders.json: the same chunks decorated in different orders (CAL-33).
//
//     calx cases/features/orders.calx
//
// Deterministic: rerunning it gives the same file.
//
// Vanilla decorates a chunk once the chunks around it have their terrain, so the order a server
// decorates neighbouring chunks in, and so what each decoration finds its neighbours' features
// left, depends on which chunks were loaded first: vanilla's results can depend on it (MC-55596,
// MC-272481, MC-241546). Calcite decorates them by the rank of each chunk's color (D29, D214).
//
// For a few seeds of the grid and the Overworld and the Nether, the 3×3 chunks about the origin
// and about a chunk out at 100, -60 are decorated with `structured` in one shared world in each
// of four orders: by color, as Calcite does; row by row, `z` then `x`; the reverse of that; and
// from the center out, the corners last. Each case is `final`, so it's the world the decorations
// left, whatever their order, and two orders give the same blob exactly when the order made no
// difference. `rig.calx orders` says which.

import std.json.{Json}
import cases.kit.{arr, b, case, file, ints, n, obj, s}
import rig.runner.cases.{write_file}

const SEEDS: [str; 3] = ["0", "12345", "20261101"]
// Each color's rank, by `x mod 3 + 3 * (z mod 3)`, as `worldgen.generator.rank_of` has them.
const RANKS: [i64; 9] = [0, 7, 8, 1, 6, 5, 2, 3, 4]

/// Each dimension's noise settings, its world as (min_y, height), and the source its preset gives.
fn dimensions() -> List<(str, i64, i64, Json)> {
    return [
        ("overworld", -64, 384, obj([(String("type"), s("minecraft:multi_noise")), (String("preset"), s("minecraft:overworld"))])),
        ("nether", 0, 256, obj([(String("type"), s("minecraft:multi_noise")), (String("preset"), s("minecraft:nether"))])),
    ]
}

fn rank_of(c: (i64, i64)) -> i64 {
    return RANKS[usize.wrap(c.0.floor_mod(3) + 3 * c.1.floor_mod(3))]
}

fn orders(cx: i64, cz: i64) -> List<(str, List<(i64, i64)>)> {
    var chunks: List<(i64, i64)> = []
    for dz in -1i64..2 {
        for dx in -1i64..2 {
            chunks.push((cx + dx, cz + dz))
        }
    }
    var colored = chunks.copy()
    colored.sort_by(|a, c| rank_of(a).cmp(rank_of(c)))
    var reverse = chunks.copy()
    reverse.reverse()
    // The center, then its four sides, then the corners.
    var out = chunks.copy()
    out.sort_by(|a, c| ((a.0 - cx).abs() + (a.1 - cz).abs(), a.1, a.0).cmp(((c.0 - cx).abs() + (c.1 - cz).abs(), c.1, c.0)))
    return [("colored", colored), ("rows", chunks), ("reverse", reverse), ("center-out", out)]
}

pub fn main() {
    var cases: List<Json> = []
    for seed in SEEDS {
        for (name, min_y, height, source) in dimensions() {
            for (area, cx, cz) in [("origin", 0i64, 0i64), ("out", 100, -60)] {
                for (order, chunks) in orders(cx, cz) {
                    var ops: List<Json> = []
                    for (x, z) in chunks {
                        ops.push(arr([s("structured"), n(x), n(z)]))
                    }
                    cases.push(case("orders-{name}-{seed}-{area}-{order}", obj([
                        (String("seed"), s(String(seed))),
                        (String("settings"), s("minecraft:{name}")),
                        (String("level"), ints([min_y, height])),
                        (String("source"), source.copy()),
                        (String("shared"), b(true)),
                        (String("final"), b(true)),
                        (String("ops"), arr(ops)),
                    ])))
                }
            }
        }
    }
    write_file(file("features", "orders.json"), String("features"), String("cases/features/orders.calx"), cases, 4)
}
