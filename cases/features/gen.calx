module cases.features.gen

// Writes cases/features/generated.json: chunks decorated with their biomes' features, and
// features placed on their own.
//
//     calx cases/features/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED and from the names in vanilla's
// data pack, so rerunning it gives the same file.
//
// The cases name vanilla's features by id and never copy them. Every settings' world is decorated
// near the origin and far out, and every biome on its own through a fixed source. Every feature in
// `worldgen/feature` is placed under placements the cases write: on the heightmap a placed feature
// of it uses, through the world's height where one ranges over it, on every layer, or at one
// position. Simple blocks then try each placement modifier and block predicate on their own, and
// features, placements and providers vanilla doesn't read are compared as that.

import std.json
import std.json.{Json}
import std.math.{PI, cos, sin}
import cases.jar.{json_files, vanilla}
import cases.kit.{arr, case, file, ints, n, obj, s}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}
import tools.repo.{die}

const SEED: u64 = 20261108
const LONG_SEEDS: [str; 6] = ["0", "1", "-1", "9223372036854775807", "-9223372036854775808", "12345"]
const NETHER: [str; 5] = ["nether_wastes", "soul_sand_valley", "crimson_forest", "warped_forest", "basalt_deltas"]
const END: [str; 5] = ["the_end", "end_highlands", "end_midlands", "small_end_islands", "end_barrens"]
const FAR: i64 = 30000

/// Each settings' world, as (min_y, height), and the source its world preset gives it.
fn worlds() -> List<(str, i64, i64, str)> {
    return [("overworld", -64, 384, "overworld"), ("large_biomes", -64, 384, "overworld"), ("amplified", -64, 384, "overworld"), ("caves", -64, 384, "overworld"), ("floating_islands", -64, 384, "overworld"), ("nether", 0, 256, "nether"), ("end", 0, 256, "end")]
}

fn level_of(settings: str) -> (i64, i64) {
    for (name, min_y, height, _) in worlds() {
        if name == settings {
            return (min_y, height)
        }
    }
    die("no settings {settings}")
}

struct Gen {
    r: SplitMix64
}

impl Gen {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn between(mut self, lo: i64, hi: i64) -> i64 {
        return lo + self.below(hi - lo + 1)
    }

    fn pick(mut self, items: List<str>) -> str {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    fn long(mut self) -> String {
        return "{i64.wrap(self.r.next())}"
    }

    fn seed(mut self) -> String {
        if self.below(4) == 0 {
            return String(LONG_SEEDS[usize.wrap(self.below(6))])
        }
        return self.long()
    }

    fn chunk(mut self, reach: i64) -> (i64, i64) {
        let x = self.between(-reach, reach)
        let z = self.between(-reach, reach)
        return (x, z)
    }
}

fn m(name: String) -> String {
    return "minecraft:{name}"
}

fn bare(name: String) -> String {
    if name.starts_with("minecraft:") {
        return name[10..name.len()]
    }
    return name.copy()
}

fn preset(name: str) -> Json {
    if name == "end" {
        return obj([(String("type"), s("minecraft:the_end"))])
    }
    return obj([(String("type"), s("minecraft:multi_noise")), (String("preset"), s("minecraft:{name}"))])
}

fn fixed(biome: String) -> Json {
    return obj([(String("type"), s("minecraft:fixed")), (String("biome"), s("minecraft:{biome}"))])
}

/// The settings a biome's world has.
fn world_of(biome: String) -> str {
    if NETHER.any(|b| b == biome) {
        return "nether"
    }
    if END.any(|b| b == biome) {
        return "end"
    }
    return "overworld"
}

/// JSON written out, as the Python wrote its dicts and lists.
fn j(text: String) -> Json {
    return match json.parse(text.copy()) {
        ok(v) => v,
        err(e) => die("{text}: {e}"),
    }
}

/// A JSON list's items.
fn list(text: String) -> List<Json> {
    if let Json.Array(xs) = j(text.copy()) {
        return xs
    }
    die("not a list: {text}")
}

/// `a + b`, as Python adds lists.
fn plus(a: List<Json>, b: List<Json>) -> List<Json> {
    var out = a.copy()
    out.extend(b.copy())
    return out
}

/// `xs[1:]`.
fn rest(xs: List<Json>) -> List<Json> {
    var out: List<Json> = []
    for i in 1..xs.len() {
        out.push(xs[i].copy())
    }
    return out
}

/// A biome's placed features, a placed feature's feature and the modifier types and heightmap of
/// its placement, from vanilla's data pack.
struct Placed {
    id: String,
    feature: String?,
    types: List<String>,
    heightmap: String?,
}

fn biome_features(v: Json) -> List<String> {
    var out: List<String> = []
    if let Json.Array(steps) = v.get(String("features")) ?? Json.Null {
        for step in steps {
            if let Json.Array(ps) = step {
                for p in ps {
                    if let Json.Str(text) = p {
                        out.push(bare(text))
                    }
                }
            }
        }
    }
    return out
}

fn placed_of(id: own String, v: Json) -> Placed {
    var types: List<String> = []
    var heightmap: String? = none
    if let Json.Array(mods) = v.get(String("placement")) ?? Json.Null {
        for one in mods {
            let kind = (one.get(String("type")) ?? Json.Null).as_str() ?? String("")
            types.push(bare(kind.copy()))
            if kind == "minecraft:heightmap" {
                heightmap = (one.get(String("heightmap")) ?? Json.Null).as_str()
            }
        }
    }
    var feature: String? = none
    if let Json.Str(text) = v.get(String("feature")) ?? Json.Null {
        feature = some(bare(text))
    }
    return Placed { id: id, feature: feature, types: types, heightmap: heightmap }
}

struct Case {
    id: String,
    seed: String,
    settings: str,
    source: Json,
    feature: Json?,
    ops: List<Json>,
}

fn start(id: own String, seed: own String, settings: str, source: own Json, feature: own Json?) -> Case {
    return Case { id: id, seed: seed, settings: settings, source: source, feature: feature, ops: [] }
}

impl Case {
    fn decorate(mut self, cx: i64, cz: i64) {
        self.ops.push(arr([s("decorate"), n(cx), n(cz)]))
    }

    fn place(mut self, cx: i64, cz: i64, x: i64, y: i64, z: i64, seed: own String) {
        self.ops.push(arr([s("place"), n(cx), n(cz), n(x), n(y), n(z), s(seed)]))
    }

    fn build(self) -> Json {
        let (min_y, height) = level_of(self.settings)
        var input: List<(String, Json)> = [(String("seed"), s(self.seed.copy())), (String("settings"), s("minecraft:{self.settings}")), (String("level"), ints([min_y, height])), (String("source"), self.source.copy())]
        if let f = self.feature {
            input.push((String("feature"), f.copy()))
        }
        input.push((String("ops"), arr(self.ops.copy())))
        return case(self.id.copy(), obj(input))
    }
}

/// A feature and its placement, as a case gives it.
fn feature_with(feature: own Json, placement: own List<Json>) -> Json {
    return obj([(String("feature"), feature), (String("placement"), arr(placement))])
}

fn surface(heightmap: str, count: i64) -> List<Json> {
    return list(#"[{"type":"minecraft:count","count":#{count}},{"type":"minecraft:in_square"},{"type":"minecraft:heightmap","heightmap":"#{heightmap}"}]"#)
}

fn through_height(count: i64) -> List<Json> {
    return list(#"[{"type":"minecraft:count","count":#{count}},{"type":"minecraft:in_square"},{"type":"minecraft:height_range","height":{"type":"minecraft:uniform","min_inclusive":{"above_bottom":0},"max_inclusive":{"below_top":0}}}]"#)
}

/// A placement of the cases' own for a feature whose placed feature uses `types`.
fn placement_like(types: List<String>, heightmap: String?) -> List<Json> {
    if let h = heightmap {
        return list(#"[{"type":"minecraft:count","count":4},{"type":"minecraft:in_square"},{"type":"minecraft:heightmap","heightmap":"#{h}"}]"#)
    }
    if types.any(|t| t == "height_range") {
        return through_height(8)
    }
    if types.any(|t| t == "count_on_every_layer") {
        return list(#"[{"type":"minecraft:count_on_every_layer","count":2}]"#)
    }
    return []
}

fn decorations(g: mut Gen, cases: mut List<Json>, biomes: List<(String, List<String>)>) {
    for (settings, _, _, source) in worlds() {
        var origin = start("decorate-{settings}-origin", g.seed(), settings, preset(source), none)
        origin.decorate(0, 0)
        cases.push(origin.build())
        var far = start("decorate-{settings}-far", g.seed(), settings, preset(source), none)
        let (x1, z1) = g.chunk(FAR)
        far.decorate(x1, z1)
        let (x2, z2) = g.chunk(FAR)
        far.decorate(x2, z2)
        cases.push(far.build())
    }
    for (biome, _) in biomes {
        var c = start("decorate-biome-{biome}", g.seed(), world_of(biome.copy()), fixed(biome.copy()), none)
        let (cx, cz) = g.chunk(64)
        c.decorate(cx, cz)
        cases.push(c.build())
    }
}

/// Each feature placed under a placement like its placed feature's, in a biome that lists one, at
/// two chunks.
fn each_feature(g: mut Gen, cases: mut List<Json>, biomes: List<(String, List<String>)>, placed: List<Placed>, features: List<String>) {
    // Each feature's first placed feature, by name, and the first biome, by name, that lists it.
    var uses: List<(String, Placed, String?)> = []
    for p in placed {
        let fid = p.feature else {
            continue
        }
        if uses.any(|u| u.0 == fid) {
            continue
        }
        var home: String? = none
        for (b, ps) in biomes {
            if ps.any(|q| q == p.id) {
                home = some(b.copy())
                break
            }
        }
        uses.push((fid.copy(), p.copy(), home))
    }
    for fid in features {
        var types: List<String> = []
        var heightmap: String? = some(String("MOTION_BLOCKING"))
        var biome = String("plains")
        for (used, p, home) in uses {
            if used == fid {
                types = p.types.copy()
                heightmap = p.heightmap.copy()
                if let h = home {
                    biome = h.copy()
                }
                break
            }
        }
        let settings = world_of(biome.copy())
        let placement = placement_like(types, heightmap)
        let empty = placement.is_empty()
        var c = start("feature-{fid.replace("/", "-")}", g.seed(), settings, fixed(biome), some(feature_with(s(m(fid.copy())), placement)))
        let (min_y, height) = level_of(settings)
        for _ in 0..2 {
            let (cx, cz) = g.chunk(200)
            var y = 0i64
            if empty {
                // Drawn and not used, as the Python drew it.
                _ = g.between(min_y, min_y + height - 1)
                y = 64
            }
            let x = cx * 16 + g.below(16)
            let z = cz * 16 + g.below(16)
            c.place(cx, cz, x, y, z, g.long())
        }
        cases.push(c.build())
    }
}

/// Monster rooms tried hundreds of times a chunk, so that some are built: their walls, chests
/// turned to a wall with their loot tables, and spawners with their mobs.
fn dungeons(g: mut Gen, cases: mut List<Json>) {
    for i in 0i64..8 {
        let settings = if i % 2 == 1 { "caves" } else { "overworld" }
        let placement = list(#"[{"type":"minecraft:count","count":4096},{"type":"minecraft:in_square"},{"type":"minecraft:height_range","height":{"type":"minecraft:uniform","min_inclusive":{"absolute":-58},"max_inclusive":{"absolute":100}}}]"#)
        var c = start("dungeons-{i}", g.seed(), settings, preset("overworld"), some(feature_with(s("minecraft:monster_room"), placement)))
        for _ in 0..2 {
            let (cx, cz) = g.chunk(2000)
            c.place(cx, cz, cx * 16, 0, cz * 16, g.long())
        }
        cases.push(c.build())
    }
}

fn stone(placement: own List<Json>) -> Json {
    return feature_with(j(#"{"type":"minecraft:simple_block","to_place":{"id":"minecraft:stone"}}"#), placement)
}

/// Simple blocks under each placement modifier on its own and in mixes.
fn modifiers(g: mut Gen, cases: mut List<Json>) {
    let on = surface("MOTION_BLOCKING", 1)
    let tries: List<(str, List<Json>)> = [
        ("count", list(#"[{"type":"minecraft:count","count":{"type":"minecraft:uniform","min_inclusive":0,"max_inclusive":6}},{"type":"minecraft:in_square"},{"type":"minecraft:heightmap","heightmap":"WORLD_SURFACE_WG"}]"#)),
        ("rarity", list(#"[{"type":"minecraft:count","count":40},{"type":"minecraft:rarity_filter","chance":3},{"type":"minecraft:in_square"},{"type":"minecraft:heightmap","heightmap":"OCEAN_FLOOR"}]"#)),
        ("random-chance", plus(list(#"[{"type":"minecraft:count","count":40},{"type":"minecraft:random_chance","chance":0.3}]"#), rest(on))),
        ("offset", plus(on, list(#"[{"type":"minecraft:offset","x":{"type":"minecraft:uniform","min_inclusive":-16,"max_inclusive":16},"y":3,"z":-2}]"#))),
        ("cuboid", plus(on, list(#"[{"type":"minecraft:cuboid","xz_size":3,"y_size":{"type":"minecraft:uniform","min_inclusive":1,"max_inclusive":4}}]"#))),
        ("cuboid-shell", plus(on, list(#"[{"type":"minecraft:cuboid","xz_size":4,"y_size":3,"include_interior":false}]"#))),
        ("cuboid-edges", plus(on, list(#"[{"type":"minecraft:cuboid","xz_size":4,"y_size":4,"include_edges":false}]"#))),
        ("scan-down", plus(through_height(6), list(#"[{"type":"minecraft:environment_scan","direction_of_search":"down","max_steps":12,"target_condition":{"type":"minecraft:solid"},"allowed_search_condition":{"type":"minecraft:matching_blocks","blocks":["minecraft:air","minecraft:cave_air"]}}]"#))),
        ("scan-up", plus(through_height(6), list(#"[{"type":"minecraft:environment_scan","direction_of_search":"up","max_steps":32,"target_condition":{"type":"minecraft:not","predicate":{"type":"minecraft:replaceable"}}}]"#))),
        ("fixed", list(#"[{"type":"minecraft:fixed_placement","positions":[[0,100,0],[5,90,7],[16,80,0],[-1,80,-1]]}]"#)),
        ("noise-based", plus(list(#"[{"type":"minecraft:noise_based_count","noise_to_count_ratio":12,"noise_factor":80.0,"noise_offset":0.5}]"#), rest(on))),
        ("noise-threshold", plus(list(#"[{"type":"minecraft:noise_threshold_count","noise_level":-0.3,"below_noise":1,"above_noise":6}]"#), rest(on))),
        ("randomly-selected", list(#"[{"type":"minecraft:count","count":6},{"type":"minecraft:randomly_selected","placements":[{"type":"minecraft:in_square"},{"type":"minecraft:offset","x":3,"y":0,"z":3}]},{"type":"minecraft:heightmap","heightmap":"MOTION_BLOCKING"}]"#)),
        ("surface-relative", plus(through_height(30), list(#"[{"type":"minecraft:surface_relative_threshold_filter","heightmap":"OCEAN_FLOOR_WG","min_inclusive":-12,"max_inclusive":4}]"#))),
        ("water-depth", list(#"[{"type":"minecraft:count","count":6},{"type":"minecraft:in_square"},{"type":"minecraft:surface_water_depth_filter","max_water_depth":2},{"type":"minecraft:heightmap","heightmap":"OCEAN_FLOOR"}]"#)),
        ("every-layer", list(#"[{"type":"minecraft:count_on_every_layer","count":{"type":"minecraft:uniform","min_inclusive":1,"max_inclusive":3}}]"#)),
        ("height-trapezoid", list(#"[{"type":"minecraft:count","count":20},{"type":"minecraft:in_square"},{"type":"minecraft:height_range","height":{"type":"minecraft:trapezoid","min_inclusive":{"absolute":-40},"max_inclusive":{"absolute":120},"plateau":20}}]"#)),
        ("biome-nested", list(#"[{"type":"minecraft:biome"}]"#)),
    ]
    for (name, placement) in tries {
        for biome in ["plains", "ocean", "dripstone_caves"] {
            var c = start("modifier-{name}-{biome}", g.seed(), "overworld", fixed(String(biome)), some(stone(placement.copy())))
            for _ in 0..2 {
                let (cx, cz) = g.chunk(100)
                let y = g.between(-64, 200)
                c.place(cx, cz, cx * 16, y, cz * 16, g.long())
            }
            cases.push(c.build())
        }
    }
}

/// Simple blocks behind each block predicate, on the surface and through the height.
fn predicates(g: mut Gen, cases: mut List<Json>) {
    let preds: List<(str, str)> = [
        ("matching-blocks", #"{"type":"minecraft:matching_blocks","offset":[0,-1,0],"blocks":["minecraft:grass_block","minecraft:sand"]}"#),
        ("matching-tag", #"{"type":"minecraft:matching_block_tag","offset":[0,-1,0],"tag":"minecraft:dirt"}"#),
        ("matching-fluids", #"{"type":"minecraft:matching_fluids","fluids":["minecraft:water","minecraft:flowing_water"]}"#),
        ("replaceable", #"{"type":"minecraft:replaceable"}"#),
        ("solid", #"{"type":"minecraft:solid","offset":[1,-1,0]}"#),
        ("sturdy", #"{"type":"minecraft:has_sturdy_face","offset":[0,-1,0],"direction":"up"}"#),
        ("would-survive", #"{"type":"minecraft:would_survive","state":{"id":"minecraft:poppy"}}"#),
        ("would-survive-cactus", #"{"type":"minecraft:would_survive","state":{"id":"minecraft:cactus","properties":{"age":"0"}}}"#),
        ("inside-world", #"{"type":"minecraft:inside_world_bounds","offset":[0,16,0]}"#),
        ("not-air", #"{"type":"minecraft:not","predicate":{"type":"minecraft:matching_blocks","blocks":"minecraft:air"}}"#),
        ("any-of", #"{"type":"minecraft:any_of","predicates":[{"type":"minecraft:solid"},{"type":"minecraft:matching_fluids","fluids":"minecraft:lava"}]}"#),
        ("all-of", #"{"type":"minecraft:all_of","predicates":[{"type":"minecraft:replaceable"},{"type":"minecraft:solid","offset":[0,-1,0]}]}"#),
        ("true", #"{"type":"minecraft:true"}"#),
        ("unobstructed", #"{"type":"minecraft:unobstructed"}"#),
        ("height-range", #"{"type":"minecraft:height_range","min_inclusive":{"absolute":0},"max_inclusive":{"below_top":100}}"#),
        ("volume", #"{"type":"minecraft:volume_match","min":[-1,-1,-1],"max":[1,0,1],"match":{"type":"minecraft:solid"}}"#),
    ]
    for (name, pred) in preds {
        let placement = plus(through_height(24), [obj([(String("type"), s("minecraft:block_predicate_filter")), (String("predicate"), j(String(pred)))])])
        let seed = g.seed()
        let biome = g.pick(["plains", "lush_caves", "beach", "warm_ocean"])
        var c = start("predicate-{name}", seed, "overworld", fixed(String(biome)), some(stone(placement)))
        let (cx, cz) = g.chunk(100)
        c.place(cx, cz, cx * 16, 0, cz * 16, g.long())
        cases.push(c.build())
    }
}

const NOISE: str = #"{"base_octave":-3,"octave_count":2}"#
const STATES: str = #""minecraft:stone","minecraft:andesite","minecraft:granite",{"id":"minecraft:oak_log","properties":{"axis":"x"}}"#
const LOW_STATES: str = #""minecraft:stone","minecraft:andesite""#
const HIGH_STATES: str = #""minecraft:granite",{"id":"minecraft:oak_log","properties":{"axis":"x"}}"#

/// Simple blocks from each block state provider.
fn providers(g: mut Gen, cases: mut List<Json>) {
    let provs: List<(str, String)> = [
        ("state", #"{"id":"minecraft:glass"}"#),
        ("simple", #"{"type":"minecraft:simple","state":{"id":"minecraft:glass"}}"#),
        ("weighted", #"{"type":"minecraft:weighted","entries":[{"data":{"id":"minecraft:dirt"},"weight":3},{"data":{"id":"minecraft:stone"},"weight":1}]}"#),
        ("randomized-int", #"{"type":"minecraft:randomized_int","source":{"id":"minecraft:candle"},"property":"candles","values":{"type":"minecraft:uniform","min_inclusive":1,"max_inclusive":4}}"#),
        ("rotated", #"{"type":"minecraft:rotated","state":{"id":"minecraft:oak_log"}}"#),
        ("noise", #"{"type":"minecraft:noise","seed":2345,"noise":#{NOISE},"scale":0.02,"states":[#{STATES}]}"#),
        ("noise-threshold", #"{"type":"minecraft:noise_threshold","seed":7,"noise":#{NOISE},"scale":0.05,"threshold":0.1,"high_chance":0.4,"default_state":{"id":"minecraft:moss_block"},"low_states":[#{LOW_STATES}],"high_states":[#{HIGH_STATES}]}"#),
        ("dual-noise", #"{"type":"minecraft:dual_noise","seed":9,"noise":#{NOISE},"scale":0.03,"states":[#{STATES}],"variety":[2,4],"slow_noise":#{NOISE},"slow_scale":0.7}"#),
        ("random-block", ##"{"type":"minecraft:random_block","blocks":"#minecraft:flowers"}"##),
        ("copy-properties", #"{"type":"minecraft:copy_properties","source":{"id":"minecraft:mossy_cobblestone_slab"}}"#),
        ("rule-based", #"{"type":"minecraft:rule_based","fallback":{"id":"minecraft:dirt"},"rules":[{"if_true":{"type":"minecraft:matching_blocks","offset":[0,-1,0],"blocks":"minecraft:sand"},"then":{"id":"minecraft:cactus"}}]}"#),
    ]
    for (name, prov) in provs {
        let to_place = obj([(String("type"), s("minecraft:simple_block")), (String("to_place"), j(prov.copy()))])
        let feature = feature_with(to_place, surface("WORLD_SURFACE", 12))
        let seed = g.seed()
        let biome = g.pick(["plains", "desert", "swamp"])
        var c = start("provider-{name}", seed, "overworld", fixed(String(biome)), some(feature))
        let (cx, cz) = g.chunk(100)
        c.place(cx, cz, cx * 16, 0, cz * 16, g.long())
        cases.push(c.build())
    }
}

/// Features and placements vanilla doesn't read.
fn unread(g: mut Gen, cases: mut List<Json>) {
    let bad: List<(str, Json)> = [
        ("unknown-type", feature_with(j(#"{"type":"minecraft:no_such_feature"}"#), [])),
        ("unknown-placed", s("minecraft:no_such_placed_feature")),
        ("unknown-feature", feature_with(s("minecraft:no_such_feature"), [])),
        ("unknown-modifier", stone(list(#"[{"type":"minecraft:no_such_modifier"}]"#))),
        ("ore-too-big", feature_with(j(#"{"type":"minecraft:ore","size":65,"discard_chance_on_air_exposure":0.0,"targets":[]}"#), [])),
        ("count-too-big", stone(list(#"[{"type":"minecraft:count","count":4097}]"#))),
        ("rarity-zero", stone(list(#"[{"type":"minecraft:rarity_filter","chance":0}]"#))),
        ("scan-sideways", stone(list(#"[{"type":"minecraft:environment_scan","direction_of_search":"north","max_steps":4,"target_condition":{"type":"minecraft:solid"}}]"#))),
        ("weighted-empty", feature_with(j(#"{"type":"minecraft:simple_block","to_place":{"type":"minecraft:weighted","entries":[]}}"#), [])),
        ("sequence-empty", feature_with(j(#"{"type":"minecraft:sequence","features":[]}"#), [])),
        ("missing-tag", feature_with(j(##"{"type":"minecraft:simple_block","to_place":{"type":"minecraft:random_block","blocks":"#minecraft:no_such_tag"}}"##), [])),
    ]
    for (name, feature) in bad {
        var c = start("unread-{name}", g.seed(), "overworld", fixed(String("plains")), some(feature.copy()))
        c.place(0, 0, 0, 64, 0, String("0"))
        cases.push(c.build())
    }
    var c = start(String("decorate-without-feature"), String("0"), "overworld", fixed(String("plains")), none)
    c.decorate(0, 0)
    cases.push(c.build())
}

/// The End's ten spikes, each placed from its own chunk, so that each is built with its cage and
/// its end crystal, an entity; and spikes of a config's own, with a beam target and crystals that
/// can't be hurt.
fn end_spikes(g: mut Gen, cases: mut List<Json>) {
    for i in 0..3 {
        var c = start("end-spikes-{i}", g.seed(), "end", fixed(String("the_end")), some(feature_with(s("minecraft:end_spike"), [])))
        for k in 0i64..10 {
            // `EndSpikeFeature.getSpikesForLevel`: centers on a ring of 42 about the origin.
            let angle = 2.0 * (-PI + PI / 10.0 * f64.nearest(k))
            let x = i64.saturate((42.0 * cos(angle)).floor())
            let z = i64.saturate((42.0 * sin(angle)).floor())
            c.place(x >> 4, z >> 4, x, 64, z, g.long())
        }
        cases.push(c.build())
    }
    let feature = j(#"{"feature":{"type":"minecraft:end_spike","crystal_invulnerable":true,"crystal_beam_target":[0,128,0],"spikes":[{"centerX":3,"centerZ":5,"radius":3,"height":80,"guarded":true},{"centerX":-20,"centerZ":9,"radius":2,"height":70}]},"placement":[]}"#)
    var c = start(String("end-spikes-config"), g.seed(), "end", fixed(String("the_end")), some(feature))
    for (x, z) in [(3i64, 5i64), (-20, 9)] {
        c.place(x >> 4, z >> 4, x, 64, z, g.long())
    }
    cases.push(c.build())
}

pub fn main() {
    var g = Gen { r: splitmix64(SEED) }
    let jar = vanilla()
    var biomes: List<(String, List<String>)> = []
    for (id, v) in json_files(jar, "data/minecraft/worldgen/biome/") {
        biomes.push((id.copy(), biome_features(v)))
    }
    biomes.sort_by(|a, b| a.0.cmp(b.0))
    var placed: List<Placed> = []
    for (id, v) in json_files(jar, "data/minecraft/worldgen/placed_feature/") {
        placed.push(placed_of(id.copy(), v))
    }
    placed.sort_by(|a, b| a.id.cmp(b.id))
    var features: List<String> = []
    for (id, _) in json_files(jar, "data/minecraft/worldgen/feature/") {
        features.push(id.copy())
    }
    var cases: List<Json> = []
    decorations(mut g, mut cases, biomes)
    each_feature(mut g, mut cases, biomes, placed, features)
    dungeons(mut g, mut cases)
    modifiers(mut g, mut cases)
    predicates(mut g, mut cases)
    providers(mut g, mut cases)
    unread(mut g, mut cases)
    end_spikes(mut g, mut cases)
    write_file(file("features", "generated.json"), String("features"), "cases/features/gen.calx, seed {SEED}", cases, 4)
}
