module cases.features.grid

// Writes cases/features/grid.json: the seed grid of Phase 5's gate (G5.1), whole chunks of each
// of the three dimensions made by every stage, compared with vanilla's.
//
//     calx cases/features/grid.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the
// same file.
//
// For each seed of the grid and each dimension, with the source its world preset gives it, the
// 3×3 chunks about the origin and the 3×3 about a chunk far out are made in one shared world,
// each with `structured`: their structures' starts within 9, their biomes, their terrain bearded
// by what they reference, filled, given materials and carved, then decorated with their
// structures' pieces placed before each step's features. They're decorated in the order the
// server decorates them, by the rank of each chunk's color (D214), each into what the ones before
// it left. The far chunk is up to 1,875 chunks out, where the End's outer islands are.

import std.json.{Json}
import cases.kit.{arr, b, case, file, ints, n, obj, s}
import rig.runner.cases.{splitmix64, write_file}

const SEED: u64 = 20261102
// The seeds of the grid: the edge cases every worldgen case file draws on, the seed the
// generation bench uses, and three drawn here.
const LONG_SEEDS: [str; 7] = ["0", "1", "-1", "9223372036854775807", "-9223372036854775808", "12345", "20261101"]
const DRAWN: i64 = 3
const FAR: i64 = 1875
// Each color's rank, by `x mod 3 + 3 * (z mod 3)`, as `worldgen.generator.rank_of` has them.
const RANKS: [i64; 9] = [0, 7, 8, 1, 6, 5, 2, 3, 4]

/// Each dimension's noise settings, its world as (min_y, height), and the source its preset gives.
fn dimensions() -> List<(str, i64, i64, Json)> {
    return [
        ("overworld", -64, 384, obj([(String("type"), s("minecraft:multi_noise")), (String("preset"), s("minecraft:overworld"))])),
        ("nether", 0, 256, obj([(String("type"), s("minecraft:multi_noise")), (String("preset"), s("minecraft:nether"))])),
        ("end", 0, 256, obj([(String("type"), s("minecraft:the_end"))])),
    ]
}

fn rank_of(c: (i64, i64)) -> i64 {
    return RANKS[usize.wrap(c.0.floor_mod(3) + 3 * c.1.floor_mod(3))]
}

pub fn main() {
    var r = splitmix64(SEED)
    var seeds: List<String> = []
    for seed in LONG_SEEDS {
        seeds.push(String(seed))
    }
    for _ in 0..DRAWN {
        seeds.push("{i64.wrap(r.next())}")
    }
    let span = u64.wrap(2 * FAR + 1)
    var cases: List<Json> = []
    for seed in seeds {
        for (name, min_y, height, source) in dimensions() {
            let far_x = i64.wrap(r.next() % span) - FAR
            let far_z = i64.wrap(r.next() % span) - FAR
            for (area, cx, cz) in [("origin", 0i64, 0i64), ("far", far_x, far_z)] {
                var chunks: List<(i64, i64)> = []
                for dz in -1i64..2 {
                    for dx in -1i64..2 {
                        chunks.push((cx + dx, cz + dz))
                    }
                }
                chunks.sort_by(|a, c| rank_of(a).cmp(rank_of(c)))
                var ops: List<Json> = []
                for (x, z) in chunks {
                    ops.push(arr([s("structured"), n(x), n(z)]))
                }
                cases.push(case("grid-{name}-{seed}-{area}", obj([
                    (String("seed"), s(seed.copy())),
                    (String("settings"), s("minecraft:{name}")),
                    (String("level"), ints([min_y, height])),
                    (String("source"), source.copy()),
                    (String("shared"), b(true)),
                    (String("ops"), arr(ops)),
                ])))
            }
        }
    }
    write_file(file("features", "grid.json"), String("features"), "cases/features/grid.calx, seed {SEED}", cases, 4)
}
