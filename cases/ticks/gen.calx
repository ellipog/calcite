module cases.ticks.gen

// Writes cases/ticks/generated.json: a level's scheduled ticks, through random game ticks.
//
//     calx cases/ticks/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the same
// file.
//
// Each case is a level of a pool of chunks, few or many, near the origin, in a far corner or
// spread over the world, each added with ticks it was saved with or none, then a run of game
// ticks: chunks start ticking and schedule what they were saved with, ticks are scheduled, a few
// at the same blocks, chunks unload and come back, and each tick runs what's due from the chunks
// that tick, sometimes with a small limit. The `random` cases do a bit of everything; the `ties`
// cases give many chunks one to three saved ticks, all due together, so the chunks' first ticks
// tie and the table of when each is due, which fastutil's iterator goes over as it takes chunks
// out, decides their order; the `crowded` cases put a hundred or more chunks in, so the table's
// runs are long and wrap past its end.
//
// The draws are in the order the Python generator made them: a list's items before the pick
// among them, a conditional's test before its branch, and `and`'s right side only when its left
// holds.

import std.json.{Json}
import cases.kit.{arr, case, file, ints, n, obj, s}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}

const SEED: u64 = 20261104
const MAX: i64 = 65536

struct Rng {
    r: SplitMix64
}

impl Rng {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn chance(mut self, p: f64) -> bool {
        return self.below(1i64 << 20) < i64.saturate(p * 1048576.0)
    }

    fn pick(mut self, items: List<i64>) -> i64 {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    fn chunk(mut self, chunks: List<(i64, i64)>) -> (i64, i64) {
        return chunks[usize.wrap(self.below(i64.wrap(chunks.len())))]
    }
}

/// `size` chunks: near the origin, in a far corner, or spread over the world.
fn pool(rng: mut Rng, size: i64) -> List<(i64, i64)> {
    let style = rng.below(3)
    var out: List<(i64, i64)> = []
    while i64.wrap(out.len()) < size {
        var x = 0i64
        var z = 0i64
        if style == 0 {
            x = rng.below(41) - 20
            z = rng.below(41) - 20
        } else if style == 1 {
            x = 1874999 - rng.below(40)
            z = -1874999 + rng.below(40)
        } else {
            x = rng.below(3749999) - 1874999
            z = rng.below(3749999) - 1874999
        }
        if not out.any(|c| c.0 == x and c.1 == z) {
            out.push((x, z))
        }
    }
    return out
}

fn priority(rng: mut Rng) -> i64 {
    if rng.chance(0.75) {
        return 0
    }
    return rng.below(7) - 3
}

/// A block in `chunk`, among `spread` columns and three heights, so some ticks share one.
fn block(rng: mut Rng, chunk: (i64, i64), spread: i64) -> List<i64> {
    let x = chunk.0 * 16 + rng.below(spread)
    let y = rng.below(3) - 1
    let z = chunk.1 * 16 + rng.below(spread)
    return [x, y, z]
}

fn saved(rng: mut Rng, chunk: (i64, i64), count: i64, delays: List<i64>) -> Json {
    var out: List<Json> = []
    for _ in 0..count {
        var tick: List<i64> = [rng.below(6)]
        tick.extend(block(mut rng, chunk, 4))
        tick.push(rng.pick(delays.copy()))
        tick.push(priority(mut rng))
        out.push(ints(tick))
    }
    return arr(out)
}

fn has(chunks: List<(i64, i64)>, c: (i64, i64)) -> bool {
    return chunks.any(|d| d.0 == c.0 and d.1 == c.1)
}

fn without(chunks: List<(i64, i64)>, c: (i64, i64)) -> List<(i64, i64)> {
    var out: List<(i64, i64)> = []
    var dropped = false
    for d in chunks {
        if not dropped and d.0 == c.0 and d.1 == c.1 {
            dropped = true
        } else {
            out.push(d)
        }
    }
    return out
}

fn chunk_list(chunks: List<(i64, i64)>) -> Json {
    var out: List<Json> = []
    for c in chunks {
        out.push(ints([c.0, c.1]))
    }
    return arr(out)
}

struct Level {
    time: i64,
    sub: i64,
    present: List<(i64, i64)>,
    started: List<(i64, i64)>,
    ops: List<Json>,
}

impl Level {
    fn add(mut self, chunk: (i64, i64), ticks: own Json) {
        self.ops.push(arr([s("add"), n(chunk.0), n(chunk.1), ticks]))
        self.present.push(chunk)
        self.started = without(self.started, chunk)
    }

    fn remove(mut self, chunk: (i64, i64)) {
        self.ops.push(arr([s("remove"), n(chunk.0), n(chunk.1)]))
        self.present = without(self.present, chunk)
        self.started = without(self.started, chunk)
    }

    fn at(mut self, name: str, chunk: (i64, i64)) {
        self.ops.push(arr([s(String(name)), n(chunk.0), n(chunk.1), s("{self.time}")]))
    }

    fn schedule(mut self, rng: mut Rng, chunk: (i64, i64), delay: i64) {
        let kind = rng.below(6)
        let pos = block(mut rng, chunk, 3)
        let p = priority(mut rng)
        self.ops.push(arr([s("schedule"), n(kind), n(pos[0]), n(pos[1]), n(pos[2]), s("{self.time + delay}"), n(p), s("{self.sub}")]))
        self.sub += 1
    }

    fn tick(mut self, ticking: List<(i64, i64)>, limit: i64) {
        self.ops.push(arr([s("tick"), s("{self.time}"), n(limit), chunk_list(ticking)]))
        self.time += 1
    }

    fn op(mut self, name: str) {
        self.ops.push(arr([s(String(name))]))
    }
}

fn level(time: i64) -> Level {
    return Level { time: time, sub: 0, present: [], started: [], ops: [] }
}

/// The chunks a chance of `p` keeps, each drawn in order.
fn kept(rng: mut Rng, chunks: List<(i64, i64)>, p: f64) -> List<(i64, i64)> {
    var out: List<(i64, i64)> = []
    for c in chunks {
        if rng.chance(p) {
            out.push(c)
        }
    }
    return out
}

fn random_case(rng: mut Rng) -> List<Json> {
    let size = rng.pick([1, 2, 3, 6, 12, 30])
    let chunks = pool(mut rng, size)
    let early = rng.below(24000)
    let late = (1i64 << 40) + rng.below(1000)
    var l = level(rng.pick([0, early, late]))
    for c in chunks {
        if rng.chance(0.5) {
            let count = rng.below(7)
            l.add(c, saved(mut rng, c, count, [0, 1, 2, 3, 5, 8, 20, -1]))
        } else {
            l.add(c, Json.Null)
        }
    }
    let steps = 20 + rng.below(80)
    for _ in 0..steps {
        let roll = rng.below(100)
        if roll < 8 and l.present.len() > 0 {
            let gone = rng.chunk(l.present)
            if rng.chance(0.5) {
                l.at("pack", gone)
            }
            l.remove(gone)
        } else if roll < 14 {
            var back: List<(i64, i64)> = []
            for c in chunks {
                if not has(l.present, c) {
                    back.push(c)
                }
            }
            if back.len() > 0 {
                let c = rng.chunk(back)
                if rng.chance(0.7) {
                    let count = rng.below(5)
                    l.add(c, saved(mut rng, c, count, [0, 1, 4, 10]))
                } else {
                    l.add(c, Json.Null)
                }
            }
        }
        for c in l.present.copy() {
            if not has(l.started, c) and rng.chance(0.4) {
                l.at("unpack", c)
                l.started.push(c)
            }
        }
        let schedules = rng.below(9)
        for _ in 0..schedules {
            // Into a chunk with ticks, mostly, or one without, which drops it.
            var present = false
            if l.present.len() > 0 {
                present = rng.chance(0.9)
            }
            let c = if present { rng.chunk(l.present) } else { rng.chunk(chunks) }
            let delay = rng.pick([0, 1, 1, 2, 3, 5, 10, 30])
            l.schedule(mut rng, c, delay)
        }
        if rng.chance(0.1) and l.present.len() > 0 {
            let c = rng.chunk(l.present)
            var parts: List<i64> = [rng.below(6)]
            parts.extend(block(mut rng, c, 3))
            var op: List<Json> = [s("has")]
            for v in parts {
                op.push(n(v))
            }
            l.ops.push(arr(op))
        }
        if rng.chance(0.08) {
            l.op("count")
        }
        if rng.chance(0.06) and l.present.len() > 0 {
            let c = rng.chunk(l.present)
            l.at("pack", c)
        }
        let ticking = kept(mut rng, chunks, 0.85)
        let limit = if rng.chance(0.8) { MAX } else { 1 + rng.below(6) }
        l.tick(ticking, limit)
        if rng.chance(0.1) {
            l.op("dump")
        }
    }
    l.op("count")
    l.op("dump")
    return l.ops
}

fn ties_case(rng: mut Rng) -> List<Json> {
    let size = rng.pick([8, 20, 50, 120])
    let chunks = pool(mut rng, size)
    var l = level(rng.below(100000))
    for c in chunks {
        let count = 1 + rng.below(3)
        l.add(c, saved(mut rng, c, count, [0, 1]))
    }
    for c in chunks {
        l.at("unpack", c)
    }
    l.op("dump")
    let rounds = 3 + rng.below(4)
    for _ in 0..rounds {
        let schedules = rng.below(4)
        for _ in 0..schedules {
            let c = rng.chunk(chunks)
            let delay = rng.below(2)
            l.schedule(mut rng, c, delay)
        }
        let ticking = kept(mut rng, chunks, 0.9)
        let limit = if rng.chance(0.6) { MAX } else { 1 + rng.below(40) }
        l.tick(ticking, limit)
        l.op("dump")
    }
    return l.ops
}

fn crowded_case(rng: mut Rng) -> List<Json> {
    let size = rng.pick([120, 250])
    let chunks = pool(mut rng, size)
    var l = level(rng.below(100000))
    for c in chunks {
        if rng.chance(0.6) {
            let count = rng.below(3)
            l.add(c, saved(mut rng, c, count, [0, 1, 2]))
        } else {
            l.add(c, Json.Null)
        }
    }
    for c in chunks {
        if rng.chance(0.8) {
            l.at("unpack", c)
            l.started.push(c)
        }
    }
    let rounds = 4 + rng.below(6)
    for _ in 0..rounds {
        let schedules = rng.below(60)
        for _ in 0..schedules {
            let c = rng.chunk(chunks)
            let delay = rng.below(3)
            l.schedule(mut rng, c, delay)
        }
        for c in l.present.copy() {
            if rng.chance(0.03) {
                l.remove(c)
            }
        }
        let ticking = kept(mut rng, chunks, 0.8)
        let limit = if rng.chance(0.7) { MAX } else { 1 + rng.below(200) }
        l.tick(ticking, limit)
    }
    l.op("dump")
    return l.ops
}

fn ops_case(id: own String, ops: own List<Json>) -> Json {
    return case(id, obj([(String("ops"), arr(ops))]))
}

pub fn main() {
    var rng = Rng { r: splitmix64(SEED) }
    var cases: List<Json> = []
    for i in 0..120 {
        cases.push(ops_case("random-{i}", random_case(mut rng)))
    }
    for i in 0..60 {
        cases.push(ops_case("ties-{i}", ties_case(mut rng)))
    }
    for i in 0..10 {
        cases.push(ops_case("crowded-{i}", crowded_case(mut rng)))
    }
    write_file(file("ticks", "generated.json"), String("ticks"), "cases/ticks/gen.calx, seed {SEED}", cases, 1)
}
