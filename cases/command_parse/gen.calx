module cases.command_parse.gen

// Writes cases/command_parse/generated.json: commands read as a dedicated server reads them, with
// the error they fail with (CAL-367). The commands are every one the rig's sessions run, each cut
// short after every word and with a character of it changed, and every path of literals in the
// tree three deep, with and without a space after; the tree's first words at each level too. The
// tree is vanilla's `commands.json` report, generated/26.3/datagen/reports/, or the one given.
//
//     calx cases/command_parse/gen.calx [commands.json]

import std.fs.{read_text}
import std.env.{args}
import std.json.{Json, parse}
import std.regex.{Regex}
import cases.kit.{case, file, n, obj, s}
import rig.runner.cases.{write_file}
import tools.repo.{under}

/// What a changed character becomes, by turns.
fn swaps() -> List<str> {
    return ["x", " ", "\"", "~", "@", "[", "\{", "1", ":", "-", ".", "^", "!", "#"]
}

/// `id` as a case's ID may be, lowercase letters, digits, `.`, `_` and `-` past the first: each
/// other character `_`.
fn clean(id: String) -> String {
    var out = List<u8>()
    for i in 0..id.len() {
        let b = id.byte_at(i)
        let plain = (b >= 97 and b <= 122) or (b >= 48 and b <= 57)
        if plain or (i > 0 and (b == 46 or b == 95 or b == 45)) {
            out.push(b)
        } else {
            out.push(95)
        }
    }
    return String.from_utf8(out) ?? String("_")
}

fn add(cases: mut List<Json>, seen: mut Map<String, bool>, given: own String, text: String, level: i64) {
    let key = "{level} {text}"
    if seen.contains(key) {
        return
    }
    seen.insert(key.copy(), true)
    let id = clean(given)
    // A step's name may be another session's too.
    var unique = id.copy()
    var k = 2
    while seen.contains(unique) {
        unique = "{id}-{k}"
        k += 1
    }
    seen.insert(unique.copy(), true)
    cases.push(case(unique, obj([(String("input"), s(text.copy())), (String("level"), n(level))])))
}

/// The commands of the sessions' steps: each `("command", "name")` of src/rig/session.calx that
/// isn't one of the rig's own (`#`) and has nothing put in it as it runs (`{`), without the `/`
/// of one typed in chat.
fn steps() -> List<(String, String)> {
    let text = read_text(under("src/rig/session.calx"))! ?? String("")
    var step = Regex.new(#"\("((?:[^"\\]|\\.)*)", "([a-z0-9-]+)"\)"#)!
    var out: List<(String, String)> = []
    for c in step.captures_all(text) {
        let raw = c.get(1) ?? String("")
        let name = c.get(2) ?? String("")
        if raw.starts_with("#") or raw.is_empty() {
            continue
        }
        if let command = unescaped(raw) {
            out.push((command.trim_prefix("/"), name))
        }
    }
    return out
}

// A Calx string's text: `\"`, `\\`, `\{` and `\}` as what they escape, or none for one with a
// `{` that puts something in.
fn unescaped(raw: String) -> String? {
    let bytes = raw.to_bytes()
    var out = List<u8>()
    var i: usize = 0
    while i < bytes.len() {
        let b = bytes[i]
        if b == 92 and i + 1 < bytes.len() {
            out.push(bytes[i + 1])
            i += 2
            continue
        }
        if b == 123 {
            return none
        }
        out.push(b)
        i += 1
    }
    return String.from_utf8(out)
}

// The text of `bytes` up to `end`, if that's where a rune starts.
fn cut(bytes: List<u8>, end: usize) -> String? {
    var out = List<u8>()
    for i in 0..end {
        out.push(bytes[i])
    }
    return String.from_utf8(out)
}

// `bytes` with the one at `at` as `with`, if that's still text.
fn swapped(bytes: List<u8>, at: usize, with: str) -> String? {
    var out = List<u8>()
    for i in 0..bytes.len() {
        if i == at {
            for b in with.to_bytes() {
                out.push(b)
            }
        } else {
            out.push(bytes[i])
        }
    }
    return String.from_utf8(out)
}

// Each path of literals under `node`, `depth` more deep, with its words.
fn literals(node: Json, words: List<String>, depth: usize, out: mut List<List<String>>) {
    if depth == 0 {
        return
    }
    let Json.Object(children) = node.get("children") ?? Json.Null else return
    for (name, child) in children {
        if child.get("type") != some(Json.Str(String("literal"))) {
            continue
        }
        var path = words.copy()
        path.push(name.copy())
        out.push(path.copy())
        literals(child.copy(), path, depth - 1, mut out)
    }
}

pub fn main() {
    var cases = List<Json>()
    var seen = Map<String, bool>()
    let given = args()
    let report = if given.is_empty() { under("generated/26.3/datagen/reports/commands.json") } else { given[0].copy() }
    let tree = parse(read_text(report.copy())! ?? String(""))!
    var roots = List<String>()
    if let Json.Object(children) = tree.get("children") ?? Json.Null {
        for (name, _) in children {
            roots.push(name.copy())
        }
    }

    // The tree's first words at each level, alone and with a space after.
    for level in [0i64, 1, 2, 3, 4] {
        for name in roots {
            add(mut cases, mut seen, "root-{name}-{level}", name.copy(), level)
            add(mut cases, mut seen, "root-{name}-space-{level}", "{name} ", level)
        }
    }

    // Every path of literals three deep.
    var paths = List<List<String>>()
    literals(tree, [], 3, mut paths)
    for path in paths {
        let text = path.join(" ")
        let id = path.join("-")
        add(mut cases, mut seen, "tree-{id}", text.copy(), 4)
        add(mut cases, mut seen, "tree-{id}-space", "{text} ", 4)
    }

    // The sessions' commands, whole, cut after each word, and changed a character at a time.
    var state: u64 = 367
    let changes = swaps()
    for (command, name) in steps() {
        add(mut cases, mut seen, "step-{name}", command.copy(), 4)
        let bytes = command.to_bytes()
        var word: usize = 0
        for i in 0..bytes.len() {
            if bytes[i] == 32 {
                word += 1
                if let before = cut(bytes, i) {
                    add(mut cases, mut seen, "step-{name}-cut-{word}", before, 4)
                }
                if let after = cut(bytes, i + 1) {
                    add(mut cases, mut seen, "step-{name}-cut-{word}-space", after, 4)
                }
            }
        }
        for k in 0..2 {
            state = state * 6364136223846793005 + 1442695040888963407
            let at = usize.wrap((state >> 33) % u64(bytes.len()))
            let with = changes[usize.wrap((state >> 17) % u64(changes.len()))]
            if let changed = swapped(bytes, at, with) {
                add(mut cases, mut seen, "step-{name}-swap-{k}", changed, 4)
            }
        }
    }
    write_file(file("command_parse", "generated.json"), String("command_parse"), String("cases/command_parse/gen.calx"), cases, 1)
    println("{cases.len()} cases")
}
