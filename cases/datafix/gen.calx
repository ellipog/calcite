pub fn main() {
    var cases: List<Json> = []
    palettes(mut cases)
    jigsaws(mut cases)
    beds(mut cases)
    signs(mut cases)
    lenient(mut cases)
    banners(mut cases)
    items(mut cases)
    more_block_entities(mut cases)
    entities(mut cases)
    write_file(file("datafix", "generated.json"), String("datafix"), String("cases/datafix/gen.calx"), cases, 1)
}
