    let stand: String = cat([#"{id:"minecraft:armor_stand",ArmorItems:["#, item("minecraft:iron_boots", "1b", some(#"{Damage:0}"#), none), #",{},{id:"minecraft:air",Count:0b},{}],HandItems:[{},{}],Attributes:[{Base:0.7d,Name:"minecraft:generic.movement_speed"}],Pose:{},Tags:["in.checked"]}"#])
    for v in [3578i64, 4301] {
