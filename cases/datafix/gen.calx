module cases.datafix.gen

// Writes cases/datafix/generated.json: structure templates as older games saved them, which
// vanilla's data fixer upgrades to 26.3's as they load (CAL-102). Each is our own small template,
// written to reach one fix or a few, at data versions on both sides of each.
//
//     calx cases/datafix/gen.calx

import std.json.{Json}
import cases.kit.{case, file, obj, s}
import rig.runner.cases.{write_file}
import tools.rawjson.{write_string}

/// A string as SNBT, in double quotes.
fn q(text: String) -> String {
    var out = String()
    write_string(mut out, text)
    return out
}

fn cat(parts: List<String>) -> String {
    return parts.join("")
}

/// A palette of stone, as a template's is unless it says otherwise.
fn stone() -> String {
    return String(#"[{Name:"minecraft:stone"}]"#)
}

/// One block, of the palette's first state.
fn one() -> String {
    return String("[\{pos:[0,0,0],state:0\}]")
}

/// No entities.
fn empty() -> String {
    return String("[]")
}

fn template(version: i64?, palette: String, blocks: String, mobs: String, extra: String) -> String {
    var out = String("\{")
    if let v = version {
        out.push_str("DataVersion:{v},")
    }
    out.push_str("size:[1,1,1],palette:{palette},blocks:{blocks},entities:{mobs}{extra}\}")
    return out
}

fn block(nbt: String) -> String {
    return "\{pos:[0,0,0],state:0,nbt:{nbt}\}"
}

fn entity(nbt: String) -> String {
    return "[\{pos:[0.5d,0.0d,0.5d],blockPos:[0,0,0],nbt:{nbt}\}]"
}

/// A case: the template, and the data version it's read as when it says none.
fn add(cases: mut List<Json>, id: own String, snbt: own String, version: i64?) {
    var input: List<(String, Json)> = [(String("type"), s("structure")), (String("snbt"), s(snbt))]
    if let v = version {
        input.push((String("version"), s("{v}")))
    }
    cases.push(case(id, obj(input)))
}

fn palettes(cases: mut List<Json>) {
    let names: List<String> = [
        #"{Name:"minecraft:grass"}"#,
        #"{Name:"grass"}"#,
        #"{Name:"minecraft:chain",Properties:{axis:"y",waterlogged:"false"}}"#,
        #"{Name:"minecraft:cave_vines_head",Properties:{age:"3",berries:"true"}}"#,
        #"{Name:"minecraft:cave_vines_body"}"#,
        #"{Name:"minecraft:azalea_leaves_flowers"}"#,
        #"{Name:"minecraft:creaking_heart",Properties:{active:"true",axis:"y"}}"#,
        #"{Name:"minecraft:creaking_heart",Properties:{active:"false"}}"#,
        #"{Name:"minecraft:test_block",Properties:{test_block_mode:"start"}}"#,
        #"{Name:"minecraft:stone"}"#,
        #"{Name:"Stone"}"#,
        "\{Name:1\}",
        #"{Properties:{a:"b"}}"#,
    ]
    let states = "[{names.join(",")}]"
    var placed: List<String> = []
    for i in 0..13 {
        placed.push("\{pos:[{i},0,0],state:{i}\}")
    }
    let blocks = "[{placed.join(",")}]"
    for v in [2700i64, 2730, 2865, 3691, 3692, 4293, 4294, 4304, 4305, 4540, 4541, 5005, 5006, 5022] {
        add(mut cases, "palette-{v}", template(some(v), states, blocks, empty(), ""), none)
    }
    add(mut cases, "palettes-2730", template(some(2730), "[]", #"[{pos:[0,0,0],state:0}]"#, empty(), #",palettes:[[{Name:"minecraft:grass"}],[{Name:"minecraft:chain"}]]"#), none)
    add(mut cases, "palette-no-version", template(none, stone(), one(), empty(), ""), some(2730))
    add(mut cases, "palette-version-given", template(some(2730), #"[{Name:"minecraft:grass"}]"#, one(), empty(), ""), some(3692))
    add(mut cases, "palette-current", template(some(5023), #"[{Name:"minecraft:grass"}]"#, one(), empty(), ""), none)
}

fn jigsaws(cases: mut List<Json>) {
    let states: List<String> = ["minecraft:grass", "minecraft:chain[axis=x]", "grass", #"minecraft:grass{a:1}"#, "[x]minecraft:grass", "minecraft:air"]
    for v in [2730i64, 3692, 4541] {
        for (i, state) in states.enumerate() {
            let nbt = cat([#"{id:"minecraft:jigsaw",final_state:"#, q(state), #",joint:"rollable",name:"minecraft:a",pool:"minecraft:empty",target:"minecraft:empty"}"#])
            add(mut cases, "jigsaw-{v}-{i}", template(some(v), #"[{Name:"minecraft:jigsaw",Properties:{orientation:"up_north"}}]"#, "[{block(nbt)}]", empty(), ""), none)
        }
    }
}

fn beds(cases: mut List<Json>) {
    let bed: String = cat(["[", block(#"{id:"minecraft:bed"}"#), "]"])
    for v in [2730i64, 4884, 4885] {
        add(mut cases, "bed-{v}", template(some(v), #"[{Name:"minecraft:red_bed",Properties:{facing:"north",occupied:"false",part:"head"}}]"#, bed, empty(), ""), none)
    }
    let short: String = cat(["[", block(#"{id:"bed"}"#), "]"])
    add(mut cases, "bed-short-id-2730", template(some(2730), #"[{Name:"minecraft:red_bed"}]"#, short, empty(), ""), none)
}

fn signs(cases: mut List<Json>) {
    let old: String = #"{id:"minecraft:sign",Text1:'{"text":"Hello"}',Text2:'"plain"',Text3:'{"extra":[{"text":"a","bold":true}],"text":""}',Text4:'{"text":""}',Color:"red",GlowingText:1b}"#
    for v in [2730i64, 3096, 3097, 3438, 3439, 3563, 3564, 4289, 4290, 4291, 4292, 5001, 5002] {
        add(mut cases, "sign-old-{v}", template(some(v), #"[{Name:"minecraft:oak_sign"}]"#, "[{block(old)}]", empty(), ""), none)
    }
    let filtered: String = #"{id:"minecraft:sign",Text1:'{"text":"a"}',FilteredText1:'{"text":"b"}',FilteredText3:'{"text":""}'}"#
    add(mut cases, "sign-filtered-2730", template(some(2730), #"[{Name:"minecraft:oak_sign"}]"#, "[{block(filtered)}]", empty(), ""), none)
    add(mut cases, "sign-filtered-3200", template(some(3200), #"[{Name:"minecraft:oak_sign"}]"#, "[{block(filtered)}]", empty(), ""), none)
    let two_sided: String = #"{id:"minecraft:sign",is_waxed:0b,front_text:{messages:['{"text":"x"}','{"text":""}','{"text":""}','{"text":""}'],filtered_messages:['{"text":""}','{"text":""}','{"text":"y"}','{"text":""}'],color:"black",has_glowing_text:0b},back_text:{messages:['""','""','""','""'],color:"blue",has_glowing_text:1b}}"#
    for v in [3465i64, 3578, 4189] {
        add(mut cases, "sign-two-sided-{v}", template(some(v), #"[{Name:"minecraft:oak_sign"}]"#, "[{block(two_sided)}]", empty(), ""), none)
    }
    let hanging: String = #"{id:"minecraft:hanging_sign",front_text:{messages:['{"text":"h"}','""','""','""'],color:"black",has_glowing_text:0b},back_text:{messages:['""','""','""','""'],color:"black",has_glowing_text:0b}}"#
    add(mut cases, "hanging-sign-3465", template(some(3465), #"[{Name:"minecraft:oak_hanging_sign"}]"#, "[{block(hanging)}]", empty(), ""), none)
    let events: String = #"{id:"minecraft:sign",front_text:{messages:['{"text":"a","clickEvent":{"action":"run_command","value":"/say hi"},"bold":"true","italic":"no"}','{"text":"b","clickEvent":{"action":"open_url","value":"https://example.com"},"hoverEvent":{"action":"show_text","contents":{"text":"tip","underlined":"TRUE"}}}','{"text":"c","clickEvent":{"action":"open_url","value":"file:///x"}}','{"text":"d","clickEvent":{"action":"change_page","value":"3"},"extra":[{"text":"e","clickEvent":{"action":"suggest_command","value":"x\\u00a7y"}}]}'],color:"black",has_glowing_text:0b},back_text:{messages:['{"translate":"t","with":[{"text":"w","bold":"true"}]}','[{"text":"l"},"m"]','{"text":"n","x":1.5,"y":100000,"z":1e3,"w":0.1,"v":3000000000,"u":1.0}','not json'],color:"black",has_glowing_text:0b}}"#
    for v in [4189i64, 4290, 4291, 4292] {
        add(mut cases, "sign-events-{v}", template(some(v), #"[{Name:"minecraft:oak_sign"}]"#, "[{block(events)}]", empty(), ""), none)
    }
    let hover_entity: String = #"{id:"minecraft:sign",front_text:{messages:['{"text":"s","hoverEvent":{"action":"show_entity","contents":{"type":"minecraft:pig","id":[I;1,2,3,4],"name":{"text":"P","bold":"true"}}}}','""','""','""'],color:"black",has_glowing_text:0b}}"#
    add(mut cases, "sign-hover-entity-4189", template(some(4189), #"[{Name:"minecraft:oak_sign"}]"#, "[{block(hover_entity)}]", empty(), ""), none)
}

/// Old signs' lines, each as a sign's first line.
fn lenient_lines() -> List<String> {
    return [
            #"{text:'single',bold:TRUE}"#,
            #"{"text":"a"/*c*/}"#,
            "# comment\n\"x\"",
            #"{"text"="eq";"color"=>"red"}"#,
            #"["a",,"b"]"#,
            #"["a",]"#,
            ")]\}'\n\{\"text\":\"p\"\}",
            "123",
            "null",
            "",
            "trUe",
            #"{"text":"x"} // trailing"#,
            #"{"text":"x"}   "#,
            #"'it\'s'"#,
            "\{text:\"multi\\\nline\"\}",
            "[1;2]",
            #"{"text":NaN}"#,
            #"{"text":01}"#,
            #"{"text":1e}"#,
            #"{"text":-}"#,
            "\{\"text\":\"tab\there\"\}",
            "null and more",
            "plain",
            "two words",
            #"{'translate':'k',with:[a,b]}"#,
            #"{"text":"x",}"#,
            #"{,}"#,
            "[,]",
            #"{"text":"a"}#"#,
            #""unterminated"#,
            "/",
            #"{"extra":[{"text":"e",bold:"true"}],text:''}"#,
            // What DataFixerUpper reads of a text in part: a list loses what isn't a text, and a
            // part that doesn't read whole isn't typed, so the later fixes don't reach into it.
            #"["a",1,"b"]"#,
            "[1]",
            "5",
            "true",
            #"{"text":"","extra":[{"text":"e","bold":"true"},5]}"#,
            #"{"text":"","extra":[[{"text":"x","bold":"true"}]]}"#,
            #"{"text":"s","separator":5,"bold":"true"}"#,
            #"{"text":"s","separator":{"text":",","bold":"true"}}"#,
            #"[{"text":"a","bold":"true"},[1,{"text":"b","bold":"true"}]]"#,
            #"{"text":"h","hoverEvent":{"action":"show_text","contents":[1,{"text":"x","bold":"true"}]},"bold":"true"}"#,
            #"{"text":"h","hoverEvent":{"action":"show_text","contents":{"text":"x","bold":"true"}}}"#,
            #"{"text":"h","hoverEvent":{"action":"show_entity","contents":{"type":"minecraft:pig","id":[1,2,3,4],"name":[1,"n"]}}}"#,
            #"{"text":"h","hoverEvent":{"action":"show_item","contents":{"id":"minecraft:stone","count":2}}}"#,
            #"{"text":"h","hoverEvent":{"action":"show_item","contents":"minecraft:stone"}}"#,
            #"{"text":"h","hoverEvent":{"action":"nope","contents":"x"},"clickEvent":{"action":"copy_to_clipboard","value":"c"}}"#,
            #"{"text":"s","hoverEvent":{"action":"show_entity","contents":{"type":"minecraft:pig","id":[1,2,3,4],"name":{"text":"P","bold":"true"}}}}"#,
            #"{"text":"s","hoverEvent":{"action":"show_entity","contents":{"type":"minecraft:pig","name":{"text":"P","bold":"true"}}}}"#,
            #"{"text":"s","hoverEvent":{"action":"show_entity","contents":{"type":"minecraft:pig","id":"00000001-0002-0003-0004-000000000005","name":{"text":"P","bold":"true"}}}}"#,
            #"{"text":"s","hoverEvent":{"action":"show_entity","contents":{"type":"minecraft:pig","id":["I",1,2,3,4],"name":{"text":"P","bold":"true"}}}}"#,
            #"{"text":"h","hoverEvent":{"action":"show_item","contents":{"id":"minecraft:stone"}}}"#,
            #"{"text":"h","hoverEvent":{"action":"show_item","contents":{"id":"minecraft:stone","count":5,"x":1}}}"#,
            #"{"text":"a","x":null}"#,
            #"{"text":"a","extra":["b",null]}"#,
            #"{"text":"s","hoverEvent":{"action":"show_entity","contents":{"type":"minecraft:pig","name":{"text":"P","clickEvent":{"action":"run_command","value":"/x"}}}}}"#,
            #"{"text":"h","hoverEvent":{"action":"show_item","contents":{"id":"minecraft:stone","count":1,"components":{"minecraft:custom_name":{"text":"N","bold":"true"}}}}}"#,
            #"{"text":"h","hoverEvent":{"action":"show_text","contents":{"text":"x","extra":[{"text":"y","bold":"true"}]}}}"#,
            #"{"text":"h","hoverEvent":{"action":"show_text","contents":{"text":"x","hoverEvent":{"action":"show_text","contents":{"text":"z","bold":"true"}}}}}"#,
            #"{"text":"s","hoverEvent":{"action":"show_entity","contents":{"name":{"text":"P","bold":"true"}}}}"#,
            #"{"text":"s","hoverEvent":{"action":"show_entity","contents":{"type":"pig","id":[1,2,3,4]}}}"#,
            #"{"text":"h","hoverEvent":{"action":"show_item","contents":{"id":"stone","count":2}}}"#,
            #"{"text":"h","hoverEvent":{"action":"show_item","contents":"chain"}}"#,
            #"{"text":"h","extra":[{"text":"e","hoverEvent":{"action":"show_item","contents":{"id":"minecraft:chain","components":{"minecraft:lore":[{"text":"l","italic":"true"}]}}}}]}"#,
    ]
}

fn sign_with(first: String) -> String {
    return cat([#"{id:"minecraft:sign",front_text:{messages:["#, first.copy(), #","","",""],color:"black",has_glowing_text:0b}}"#])
}

fn lenient(cases: mut List<Json>) {
    // Old signs' lines, unflattened at 4290 by `LenientJsonParser`, each in a sign of its own,
    // since where vanilla throws on one the whole template doesn't load.
    for (i, line) in lenient_lines().enumerate() {
        let messages = [q(line), q("\"\""), q("\"\""), q("\"\"")].join(",")
        let sign = cat([#"{id:"minecraft:sign",front_text:{messages:["#, messages, #"],color:"black",has_glowing_text:0b}}"#])
        add(mut cases, "sign-lenient-{i}-4289", template(some(4289), #"[{Name:"minecraft:oak_sign"}]"#, "[{block(sign)}]", empty(), ""), none)
    }
    // Hover events already NBT, before and after their fix.
    let nbt_hovers: List<String> = [#"{text:"h",hoverEvent:{action:"show_item",contents:{id:"minecraft:stone",count:2}}}"#, #"{text:"h",hoverEvent:{action:"show_entity",contents:{type:"minecraft:pig",id:[I;1,2,3,4],name:{text:"P",bold:"true"}}}}"#, #"{text:"h",hoverEvent:{action:"show_item",contents:"minecraft:stone"}}"#, #"{text:"h",hoverEvent:{action:"show_item",contents:"stone"}}"#, #"{text:"h",hoverEvent:{action:"show_item",contents:5}}"#]
    let after: List<String> = [#"{text:"h",hover_event:{action:"show_item",id:"minecraft:chain",count:1}}"#, #"{text:"h",hover_event:{action:"show_text",value:{text:"v",hover_event:{action:"show_item",id:"chain"}}}}"#]
    for (i, h) in after.enumerate() {
        let sign = sign_with(h)
        add(mut cases, "sign-hover-item-{i}-4292", template(some(4292), #"[{Name:"minecraft:oak_sign"}]"#, "[{block(sign)}]", empty(), ""), none)
    }
    for (i, h) in nbt_hovers.enumerate() {
        for v in [4290i64, 4291] {
            let sign = sign_with(h)
            add(mut cases, "sign-nbt-hover-{i}-{v}", template(some(v), #"[{Name:"minecraft:oak_sign"}]"#, "[{block(sign)}]", empty(), ""), none)
        }
    }
    // `translate` read leniently from an ominous banner's old name.
    let banner: String = cat([#"{id:"minecraft:banner",CustomName:"#, q(#"{translate:'block.minecraft.ominous_banner'}"#), #"}"#])
    add(mut cases, "banner-lenient-ominous-3824", template(some(3824), #"[{Name:"minecraft:white_banner"}]"#, "[{block(banner)}]", empty(), ""), none)
}

fn banners(cases: mut List<Json>) {
    let patterns: String = #"{id:"minecraft:banner",Patterns:[{Pattern:"bs",Color:14},{Pattern:"mc",Color:0},{Pattern:"xyz",Color:20},{Color:3}]}"#
    for v in [2730i64, 3818, 3819] {
        add(mut cases, "banner-patterns-{v}", template(some(v), #"[{Name:"minecraft:white_banner"}]"#, "[{block(patterns)}]", empty(), ""), none)
    }
    let ominous: String = #"{id:"minecraft:banner",CustomName:'{"color":"gold","translate":"block.minecraft.ominous_banner"}',Patterns:[{Pattern:"mr",Color:9}]}"#
    for v in [2730i64, 3824, 3825, 4053, 4054, 4300, 4306, 4307] {
        add(mut cases, "banner-ominous-{v}", template(some(v), #"[{Name:"minecraft:white_banner"}]"#, "[{block(ominous)}]", empty(), ""), none)
    }
    let named: String = #"{id:"minecraft:banner",CustomName:'{"text":"Flag"}'}"#
    add(mut cases, "banner-named-2730", template(some(2730), #"[{Name:"minecraft:white_banner"}]"#, "[{block(named)}]", empty(), ""), none)
}

/// An item stack as 1.20's NBT had it, in its slot if it has one.
fn item(id: str, count: str, tag: String?, slot: i64?) -> String {
    var parts: List<String> = ["id:{q(String(id))}", "Count:{count}"]
    if let n = slot {
        parts.insert(0, "Slot:{n}b")
    }
    if let t = tag {
        parts.push("tag:{t}")
    }
    return "\{{parts.join(",")}\}"
}

fn items(cases: mut List<Json>) {
    let stacks: List<String> = [item("minecraft:charcoal", "2b", none, some(0)), item("minecraft:stone_shovel", "1b", some(#"{Damage:0}"#), some(1)), item("minecraft:iron_sword", "1b", some(#"{Damage:5,RepairCost:2,Enchantments:[{id:"minecraft:sweeping",lvl:2s},{id:"minecraft:sharpness",lvl:0s},{id:"minecraft:unbreaking",lvl:300}],HideFlags:7,Unbreakable:1b}"#), some(2)), item("minecraft:enchanted_book", "1b", some(#"{StoredEnchantments:[{id:"minecraft:frost_walker",lvl:2}]}"#), some(3)), item("minecraft:potion", "1b", some(#"{Potion:"minecraft:swiftness",CustomPotionColor:3}"#), some(4)), item("minecraft:potion", "1b", some(#"{Potion:"minecraft:empty"}"#), some(5)), item("minecraft:leather_helmet", "1b", some(#"{display:{Name:'{"text":"Hat"}',Lore:['{"text":"one"}','bad json',"\"two\""],color:255},HideFlags:64}"#), some(6)), item("minecraft:diamond_helmet", "1b", some(#"{Damage:0,Enchantments:[{id:"minecraft:protection",lvl:3},{id:"minecraft:binding_curse",lvl:1}],Trim:{material:"minecraft:netherite",pattern:"minecraft:silence"},AttributeModifiers:[{Amount:3.0d,Name:"",Operation:0,UUID:[I;110525277,279138076,-2106776415,-641135084],AttributeName:"minecraft:generic.armor",Slot:"head"},{Amount:0.1d,Name:"x",Operation:2,UUID:[I;1,2,3,4],AttributeName:"minecraft:horse.jump_strength",Slot:"head"}],HideFlags:130}"#), some(7)), item("minecraft:written_book", "1b", some(#"{pages:['{"text":"p1"}','"p2"'],filtered_pages:{"1":'"f2"'},title:"T",author:"A",resolved:1b,generation:1}"#), some(8)), item("minecraft:writable_book", "1b", some(#"{pages:["raw text"],filtered_title:"x"}"#), some(9)), item("minecraft:grass", "64b", none, some(10)), item("minecraft:scute", "1b", none, some(11)), item("minecraft:chain", "1b", none, some(12)), item("minecraft:pottery_shard_archer", "1b", none, some(13)), item("minecraft:white_banner", "1b", some(#"{display:{Name:'{"translate":"block.minecraft.ominous_banner","color":"gold"}'},HideFlags:32,BlockEntityTag:{id:"minecraft:banner",Patterns:[{Pattern:"mr",Color:9}]}}"#), some(14)), item("minecraft:shulker_box", "1b", some(cat([#"{BlockEntityTag:{id:"minecraft:shulker_box",Items:["#, item("minecraft:grass", "3b", none, some(4)), #"],Lock:"key"}}"#])), some(15)), item("minecraft:player_head", "1b", some(#"{SkullOwner:{Name:"Steve",Id:[I;1,2,3,4],Properties:{textures:[{Value:"abc",Signature:"sig"}]}}}"#), some(16)), item("minecraft:compass", "1b", some(#"{LodestonePos:{X:1,Y:2,Z:3},LodestoneDimension:"minecraft:overworld",LodestoneTracked:0b}"#), some(17)), item("minecraft:crossbow", "1b", some(cat([#"{Charged:1b,ChargedProjectiles:["#, item("minecraft:arrow", "1b", none, none), #"]}"#])), some(18)), item("minecraft:stone", "1b", some(#"{CustomModelData:3,CanDestroy:["minecraft:stone","minecraft:grass_block[snowy=false]{x:1}"],display:{LocName:"item.x"}}"#), some(19)), #"{}"#, #"{id:"minecraft:stick"}"#]
    let chest = cat([#"{id:"minecraft:chest",Items:["#, stacks.join(","), #"],CustomName:'{"text":"Box","bold":"true"}',Lock:"key \"q\" \\b"}"#])
    for v in [2730i64, 3818, 3819, 3825, 4060, 4068, 4290, 4292, 4306, 4307] {
        add(mut cases, "chest-items-{v}", template(some(v), #"[{Name:"minecraft:chest"}]"#, "[{block(chest)}]", empty(), ""), none)
    }
    let loot: String = #"{id:"minecraft:chest",LootTable:"minecraft:chests/village/village_plains_house",LootTableSeed:0L,Lock:""}"#
    add(mut cases, "chest-loot-2730", template(some(2730), #"[{Name:"minecraft:chest"}]"#, "[{block(loot)}]", empty(), ""), none)
    let barrel: String = #"{id:"minecraft:barrel",LootTable:"minecraft:chests/simple_dungeon",components:{"minecraft:lock":"k","minecraft:custom_name":'"Barrel"'}}"#
    for v in [3839i64, 4067, 4068, 4176, 4290] {
        add(mut cases, "barrel-components-{v}", template(some(v), #"[{Name:"minecraft:barrel"}]"#, "[{block(barrel)}]", empty(), ""), none)
    }
    let broken: String = #"{id:"minecraft:barrel",lock:{components:{"minecraft:custom_name":'""'}}}"#
    add(mut cases, "barrel-broken-lock-4175", template(some(4175), #"[{Name:"minecraft:barrel"}]"#, "[{block(broken)}]", empty(), ""), none)
    let furnace: String = cat([#"{id:"minecraft:furnace",BurnTime:10s,CookTime:5s,CookTimeTotal:200s,Items:["#, item("minecraft:charcoal", "2b", none, some(1)), #"],RecipesUsed:{}}"#])
    for v in [2865i64, 4180, 4181] {
        add(mut cases, "furnace-{v}", template(some(v), #"[{Name:"minecraft:furnace"}]"#, "[{block(furnace)}]", empty(), ""), none)
    }
    add(mut cases, "smoker-2865", template(some(2865), #"[{Name:"minecraft:smoker"}]"#, "[{block(furnace.replace("minecraft:furnace", "minecraft:smoker"))}]", empty(), ""), none)
    let campfire: String = cat([#"{id:"minecraft:campfire",Items:["#, item("minecraft:porkchop", "1b", none, some(0)), #"],CookingTimes:[I;1,0,0,0],CookingTotalTimes:[I;600,0,0,0]}"#])
    add(mut cases, "campfire-2973", template(some(2973), #"[{Name:"minecraft:campfire"}]"#, "[{block(campfire)}]", empty(), ""), none)
    let lectern: String = cat([#"{id:"minecraft:lectern",Book:"#, item("minecraft:written_book", "1b", some(#"{pages:['{"text":"hi"}'],title:"B",author:"me"}"#), none), #",Page:0}"#])
    add(mut cases, "lectern-3700", template(some(3700), #"[{Name:"minecraft:lectern"}]"#, "[{block(lectern)}]", empty(), ""), none)
    let lectern_new: String = #"{id:"minecraft:lectern",Book:{id:"minecraft:written_book",count:1,components:{"minecraft:written_book_content":{title:{raw:"B"},author:"me",pages:[{raw:'{"text":"hi","bold":"true"}'}]}}},Page:0}"#
    add(mut cases, "lectern-3839", template(some(3839), #"[{Name:"minecraft:lectern"}]"#, "[{block(lectern_new)}]", empty(), ""), none)
    let brewing: String = cat([#"{id:"minecraft:brewing_stand",BrewTime:0s,Fuel:0b,Items:["#, item("minecraft:potion", "1b", some(#"{Potion:"minecraft:swiftness"}"#), some(0)), #"]}"#])
    add(mut cases, "brewing-3578", template(some(3578), #"[{Name:"minecraft:brewing_stand"}]"#, "[{block(brewing)}]", empty(), ""), none)
    let jukebox: String = cat([#"{id:"minecraft:jukebox",RecordItem:"#, item("minecraft:music_disc_cat", "1b", none, none), #",IsPlaying:1b,TickCount:500L,RecordStartTick:100L}"#])
    add(mut cases, "jukebox-3700", template(some(3700), #"[{Name:"minecraft:jukebox"}]"#, "[{block(jukebox)}]", empty(), ""), none)
    let dispenser: String = cat([#"{id:"minecraft:dispenser",Items:["#, item("minecraft:water_bucket", "1b", none, some(0)), #"]}"#])
    add(mut cases, "dispenser-2865", template(some(2865), #"[{Name:"minecraft:dispenser"}]"#, "[{block(dispenser)}]", empty(), ""), none)
}

fn more_block_entities(cases: mut List<Json>) {
    let skulls: List<String> = [#"{id:"minecraft:skull",SkullOwner:"Notch"}"#, #"{id:"minecraft:skull",SkullOwner:"bad name with spaces"}"#, #"{id:"minecraft:skull",SkullOwner:{Name:"Alex",Id:[I;5,6,7,8],Properties:{textures:[{Value:"v"}]}}}"#, #"{id:"minecraft:skull",ExtraType:"Herobrine"}"#, #"{id:"minecraft:skull"}"#]
    for (i, skull) in skulls.enumerate() {
        for v in [2865i64, 3820] {
            add(mut cases, "skull-{i}-{v}", template(some(v), #"[{Name:"minecraft:player_head"}]"#, "[{block(skull)}]", empty(), ""), none)
        }
    }
    let hive: String = #"{id:"minecraft:beehive",FlowerPos:{X:1,Y:2,Z:3},Bees:[{MinOccupationTicks:600,TicksInHive:20,EntityData:{id:"minecraft:bee",HivePos:{X:0,Y:64,Z:0},FlowerPos:{X:1,Y:2,Z:3},Attributes:[{Name:"minecraft:generic.follow_range",Base:48.0d},{Name:"minecraft:generic.movement_speed",Base:0.3d}],FallDistance:0.5f,ArmorItems:[{},{},{},{}],HandItems:[{},{}],ArmorDropChances:[0.085f,0.085f,0.085f,0.085f],HandDropChances:[0.085f,0.085f],Health:10.0f}}]}"#
    for v in [2865i64, 3812, 3813, 3818, 3819] {
        add(mut cases, "beehive-{v}", template(some(v), #"[{Name:"minecraft:beehive"}]"#, "[{block(hive)}]", empty(), ""), none)
    }
    let spawner_old: String = #"{id:"minecraft:mob_spawner",Delay:20s,SpawnData:{id:"minecraft:zombie"},SpawnPotentials:[{Weight:3,Entity:{id:"minecraft:skeleton"},extra:1b}],SpawnCount:4s}"#
    add(mut cases, "spawner-2730", template(some(2730), #"[{Name:"minecraft:spawner"}]"#, "[{block(spawner_old)}]", empty(), ""), none)
    let spawner_new: String = #"{id:"minecraft:mob_spawner",Delay:20s,SpawnData:{entity:{id:"minecraft:cave_spider"}},SpawnPotentials:[],MaxNearbyEntities:6s}"#
    add(mut cases, "spawner-3465", template(some(3465), #"[{Name:"minecraft:spawner"}]"#, "[{block(spawner_new)}]", empty(), ""), none)
    let sand: String = #"{id:"minecraft:suspicious_sand",loot_table:"minecraft:archaeology/desert_pyramid",loot_table_seed:5L}"#
    add(mut cases, "suspicious-sand-3337", template(some(3337), #"[{Name:"minecraft:suspicious_sand"}]"#, "[{block(sand)}]", empty(), ""), none)
    let brushable: String = #"{id:"minecraft:brushable_block",LootTable:"minecraft:archaeology/desert_well",item:{id:"minecraft:air",count:1}}"#
    add(mut cases, "brushable-3832", template(some(3832), #"[{Name:"minecraft:suspicious_sand"}]"#, "[{block(brushable)}]", empty(), ""), none)
    let pots: List<String> = [#"{id:"minecraft:decorated_pot",shards:["minecraft:brick","minecraft:pottery_shard_archer"]}"#, cat([#"{id:"minecraft:decorated_pot",sherds:["minecraft:brick","minecraft:archer_pottery_sherd","minecraft:brick","minecraft:brick"],item:"#, item("minecraft:cod", "1b", none, none), #"}"#]), #"{id:"minecraft:decorated_pot"}"#, #"{id:"minecraft:decorated_pot",sherds:["minecraft:brick",""],LootTable:"minecraft:pots/trial_chambers/corridor"}"#]
    for (i, pot) in pots.enumerate() {
        for v in [3337i64, 3700, 4325] {
            add(mut cases, "pot-{i}-{v}", template(some(v), #"[{Name:"minecraft:decorated_pot"}]"#, "[{block(pot)}]", empty(), ""), none)
        }
    }
    let gateway: String = #"{id:"minecraft:end_gateway",ExitPortal:{X:10,Y:60,Z:-4},Age:5L}"#
    add(mut cases, "end-gateway-2730", template(some(2730), #"[{Name:"minecraft:end_gateway"}]"#, "[{block(gateway)}]", empty(), ""), none)
    let simple: List<String> = ["bell", "comparator", "daylight_detector", "enchanting_table", "ender_chest", "conduit"]
    for name in simple {
        let nbt = cat(["\{id:", q("minecraft:{name}"), "\}"])
        add(mut cases, "simple-{name}-2730", template(some(2730), "[\{Name:\"minecraft:{name}\"\}]", "[{block(nbt)}]", empty(), ""), none)
    }
}

fn entities(cases: mut List<Json>) {
    let villager: String = cat([#"{id:"minecraft:villager",Attributes:[{Name:"minecraft:generic.movement_speed",Base:0.5d},{Name:"minecraft:generic.follow_range",Base:48.0d,Modifiers:[{Amount:0.02d,Operation:1,UUID:[I;-1,-2,-3,-4],Name:"Random spawn bonus"},{Amount:0.03d,Operation:1,UUID:[I;5,6,7,8],Name:"Random spawn bonus"},{Amount:1.0d,Operation:0,UUID:[I;1835885058,-1095021588,-1586315027,-1131838612],Name:"x"}]}],Offers:{Recipes:[{rewardExp:1b,maxUses:16,buy:{id:"minecraft:emerald",Count:5b},buyB:{id:"minecraft:air",Count:1b},sell:{id:"minecraft:enchanted_book",Count:1b,tag:{StoredEnchantments:[{id:"minecraft:frost_walker",lvl:2}]}}},{buy:{id:"minecraft:paper",Count:24b},buyB:{id:"minecraft:book",Count:1b},sell:{id:"minecraft:emerald",Count:1b}}]},VillagerData:{type:"minecraft:plains",level:1,profession:"minecraft:librarian"},Inventory:["#, item("minecraft:bread", "3b", none, none), #"],ArmorItems:[{},{},{},{}],HandItems:[{},{}],ArmorDropChances:[0.085f,0.085f,0.085f,0.085f],HandDropChances:[0.085f,0.085f],FallDistance:0.0f,Brain:{memories:{"minecraft:job_site":{value:{pos:[I;1,2,3],dimension:"minecraft:overworld"}}}},Pos:[1.0d,2.0d,3.0d],Rotation:[90.0f,0.0f],CustomName:'{"text":"Bob"}',Leash:{X:1,Y:2,Z:3},UUID:[I;1,2,3,4]}"#])
    for v in [2865i64, 3813, 3818, 3828, 3945, 4055, 4187, 4290, 4293, 4301, 4303, 4763] {
        add(mut cases, "villager-{v}", template(some(v), stone(), one(), entity(villager), ""), none)
    }
    let pillager: String = cat([#"{id:"minecraft:pillager",PatrolTarget:{X:5,Y:6,Z:7},HandItems:["#, item("minecraft:crossbow", "1b", some(#"{Charged:0b}"#), none), #",{}],ArmorItems:[{},{},{},{id:"minecraft:white_banner",Count:1b,tag:{display:{Name:'{"translate":"block.minecraft.ominous_banner"}'}}}],ArmorDropChances:[0.085f,0.085f,0.085f,2.0f],HandDropChances:[0.5f,0.085f],Attributes:[{Base:0.35d,Name:"minecraft:generic.movement_speed"}],SleepingX:1,SleepingY:2,SleepingZ:3}"#])
    for v in [3578i64, 4300, 4310] {
