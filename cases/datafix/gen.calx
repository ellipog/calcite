    }
    let dropped: String = cat([#"{id:"minecraft:item",Item:"#, item("minecraft:moss_carpet", "1b", none, none), #",Age:2229s,PickupDelay:0s}"#])
    add(mut cases, "item-entity-3465", template(some(3465), stone(), one(), entity(dropped), ""), none)
    let frame: String = cat([#"{id:"minecraft:item_frame",TileX:1,TileY:2,TileZ:3,Item:"#, item("minecraft:map", "1b", none, none), #",Facing:1b}"#])
    add(mut cases, "item-frame-4000", template(some(4000), stone(), one(), entity(frame), ""), none)
    let horse: String = cat([#"{id:"minecraft:horse",ArmorItem:"#, item("minecraft:iron_horse_armor", "1b", none, none), ",SaddleItem:", item("minecraft:saddle", "1b", none, none), #",ArmorItems:[{},{},{},{}],ArmorDropChances:[0.085f,0.085f,0.085f,0.085f]}"#])
    add(mut cases, "horse-3700", template(some(3700), stone(), one(), entity(horse), ""), none)
    let pig: String = #"{id:"minecraft:pig",Saddle:1b,HandDropChances:[0.085f,0.085f],ArmorDropChances:[0.085f,0.085f,0.085f,0.085f]}"#
