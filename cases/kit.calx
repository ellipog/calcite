module cases.kit

// What the case generators share (CAL-253): JSON values built as the Python generators' dicts
// and lists were, in the order they were written, and where each probe's files go.

import std.json.{Json}
import std.path
import tools.repo.{under}

/// A string.
pub fn s(text: own String) -> Json {
    return Json.Str(text)
}

/// An integer.
pub fn n(v: i64) -> Json {
    return Json.Int(v)
}

/// A bool.
pub fn b(v: bool) -> Json {
    return Json.Bool(v)
}

/// A list.
pub fn arr(xs: own List<Json>) -> Json {
    return Json.Array(xs)
}

/// A list of integers.
pub fn ints(xs: List<i64>) -> Json {
    var out: List<Json> = []
    for x in xs {
        out.push(Json.Int(x))
    }
    return Json.Array(out)
}

/// A list of strings.
pub fn strs(xs: List<String>) -> Json {
    var out: List<Json> = []
    for x in xs {
        out.push(Json.Str(x.copy()))
    }
    return Json.Array(out)
}

/// An object, its members in the order given, as a Python dict keeps them.
pub fn obj(pairs: own List<(String, Json)>) -> Json {
    // Taken off the end in reverse, so each value moves in rather than being copied.
    var rest = pairs
    rest.reverse()
    var m = LinkedMap<String, Json>()
    while let (k, v) = rest.pop() {
        m.insert(k, v)
    }
    return Json.Object(m)
}

/// A case: `{"id": id, "input": input}`.
pub fn case(id: own String, input: own Json) -> Json {
    return obj([(String("id"), Json.Str(id)), (String("input"), input)])
}

/// A case with blobs: `{"id": id, "input": input, "blobs": blobs}`.
pub fn case_with(id: own String, input: own Json, blobs: own List<Json>) -> Json {
    return obj([(String("id"), Json.Str(id)), (String("input"), input), (String("blobs"), Json.Array(blobs))])
}

/// A member added to an object, or replaced, as `d[key] = value` does.
pub fn with(v: own Json, key: str, value: own Json) -> Json {
    if let Json.Object(m) = v {
        var members = m
        members.insert(String(key), value)
        return Json.Object(members)
    }
    return v
}

/// A blob of one hex part: `{"hex": [text]}`.
pub fn hex_blob(text: own String) -> Json {
    return obj([(String("hex"), Json.Array([Json.Str(text)]))])
}

/// A file of a probe's: cases/<probe>/<name>.
pub fn file(probe: str, name: str) -> String {
    return path.join(under("cases/{probe}"), name)
}
