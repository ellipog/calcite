module cases.biomes.gen

// Writes cases/biomes/generated.json: biome sources read as a dimension writes them, and asked.
//
//     calx cases/biomes/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, and the vanilla ids from the
// pinned server jar in oracle/jars/, so rerunning it gives the same file.
//
// The cases name vanilla's material by id and never copy it. Each of vanilla's presets runs with
// the noise settings the world presets give it, and with the others, asked for biomes where worlds
// have them: near the origin, across a world, at the ends of `int`, and over whole chunks, and for
// the climate there; the presets' lists are dumped entry by entry. The fixed, checkerboard and End
// sources run the same way, the checkerboard at every scale, with tags, single biomes and lists
// that repeat. Then lists written out at random, from one entry to past the tree's second level,
// with points that tie, are searched at climate targets near and far, where the squared distances
// wrap; and sources that don't read, which are compared only as that.
//
// The climate values are JSON values, integers or floats as the Python's were, since the cases
// write some of each.

import std.json
import std.json.{Json}
import std.zip.{Zip}
import cases.jar.{names, vanilla}
import cases.kit.{arr, b, case_with, file, ints, n, obj, s, strs, with}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}
import tools.repo.{die}

const SEED: u64 = 20261103
const LONG_SEEDS: [str; 6] = ["0", "1", "-1", "9223372036854775807", "-9223372036854775808", "12345"]
const INT_MAX: i64 = 2147483647
const INT_MIN: i64 = -2147483648
// Quarts at the edges: of `int`, of a world, and of the shifts to blocks and chunks.
const EDGE_QUARTS: [i64; 34] = [0, -1, 1, 2, -2, 3, 4, -4, -5, 15, 16, -16, -17, 63, 64, -64, -65, 255, 256, -256, -257, 7499999, -7500000, 7500000, 536870911, -536870912, 536870912, -536870913, 2147483647, -2147483648, 2147483646, -2147483647, 1073741824, -1073741824]
// Climate values at the edges of a parameter and of quantizing.
const EDGE_TARGETS: [i64; 20] = [0, -1, 1, 10000, -10000, 20000, -20000, 9999, -9999, 30000, -30000, 1500000000, 2147483647, -2147483648, 2147483646, -2147483647, 1073741824, -1073741824, 46341, -46341]
const FIELDS: [str; 6] = ["temperature", "humidity", "continentalness", "erosion", "depth", "weirdness"]

/// The noise settings each preset is used with in a world, then the rest.
fn world_presets() -> List<(str, List<str>)> {
    return [("overworld", ["overworld", "large_biomes", "amplified"]), ("nether", ["nether"])]
}

/// (min_y, height) of each kind of world, and of others.
fn level_of(settings: String) -> (i64, i64) {
    for (name, min_y, height) in [("overworld", -64i64, 384i64), ("large_biomes", -64, 384), ("amplified", -64, 384), ("caves", -64, 192), ("floating_islands", 0, 256), ("nether", 0, 128), ("end", 0, 128)] {
        if name == settings {
            return (min_y, height)
        }
    }
    die("no settings {settings}")
}

struct Gen {
    r: SplitMix64
}

impl Gen {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn between(mut self, lo: i64, hi: i64) -> i64 {
        return lo + self.below(hi - lo + 1)
    }

    fn unit(mut self) -> f64 {
        return f64.nearest(i64.wrap(self.r.next() >> 11)) / 9007199254740992.0
    }

    fn chance(mut self, bound: i64) -> bool {
        return self.below(bound) == 0
    }

    fn pick(mut self, items: List<String>) -> String {
        return items[usize.wrap(self.below(i64.wrap(items.len())))].copy()
    }

    fn pick_value(mut self, items: List<Json>) -> Json {
        return items[usize.wrap(self.below(i64.wrap(items.len())))].copy()
    }

    fn pick_int(mut self, items: List<i64>) -> i64 {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    fn long(mut self) -> String {
        return "{i64.wrap(self.r.next())}"
    }

    fn seed(mut self) -> String {
        if self.chance(3) {
            return String(LONG_SEEDS[usize.wrap(self.below(6))])
        }
        return self.long()
    }

    fn blob_seed(mut self) -> String {
        return "{self.r.next() >> 1}"
    }

    /// A float in [lo, hi], rounded to 4 places as Python's `round` rounds, so the JSON stays
    /// short.
    fn real(mut self, lo: f64, hi: f64) -> Json {
        let x = lo + (hi - lo) * self.unit()
        return Json.Float(f64.parse("{x:.4}") ?? x)
    }
}

/// JSON written out, as the Python wrote its dicts and lists.
fn j(text: String) -> Json {
    return match json.parse(text.copy()) {
        ok(v) => v,
        err(e) => die("{text}: {e}"),
    }
}

fn list(text: String) -> List<Json> {
    if let Json.Array(xs) = j(text.copy()) {
        return xs
    }
    die("not a list: {text}")
}

/// A number's value, an integer's or a float's.
fn value(v: Json) -> f64 {
    return match v {
        Json.Int(i) => f64.nearest(i),
        Json.Float(f) => f,
        _ => die("not a number: {v}"),
    }
}

/// One case: a source, the ops that ask it in order, and the ints those ops read.
struct Case {
    id: String,
    seed: String,
    settings: String,
    source: Json,
    cached: bool,
    ops: List<Json>,
    parts: List<Json>,
}

fn start(id: own String, seed: own String, settings: String, source: own Json, cached: bool) -> Case {
    return Case { id: id, seed: seed, settings: settings.copy(), source: source, cached: cached, ops: [], parts: [] }
}

impl Case {
    fn op(mut self, name: str, values: List<i64>) {
        var parts: List<Json> = [s(String(name))]
        for v in values {
            parts.push(n(v))
        }
        self.ops.push(arr(parts))
    }

    fn read(mut self, kind: str, part: own Json, count: i64) {
        self.op(kind, [count])
        if count != 0 {
            self.parts.push(part)
        }
    }

    fn build(self) -> Json {
        let blob = if self.parts.is_empty() { obj([(String("i32"), arr([]))]) } else { arr(self.parts.copy()) }
        let input = obj([(String("seed"), s(self.seed.copy())), (String("settings"), s("minecraft:{self.settings}")), (String("source"), self.source.copy()), (String("cached"), b(self.cached)), (String("ops"), arr(self.ops.copy()))])
        return case_with(self.id.copy(), input, [blob])
    }
}

fn ranged(g: mut Gen, count: i64, ranges: List<(String, String)>) -> Json {
    let seed = g.blob_seed()
    var spans: List<Json> = []
    for (lo, hi) in ranges {
        spans.push(strs([lo.copy(), hi.copy()]))
    }
    return obj([(String("gen"), s("i32_range")), (String("seed"), s(seed)), (String("count"), n(count)), (String("ranges"), arr(spans))])
}

fn near(g: mut Gen, count: i64) -> Json {
    return ranged(mut g, count, [(String("-400"), String("400")), (String("-20"), String("90")), (String("-400"), String("400"))])
}

fn far(g: mut Gen, count: i64) -> Json {
    return ranged(mut g, count, [(String("-7500000"), String("7500000")), (String("-20"), String("90")), (String("-7500000"), String("7500000"))])
}

fn anywhere(g: mut Gen, count: i64) -> Json {
    let all = ("{INT_MIN}", "{INT_MAX}")
    return ranged(mut g, count, [all.copy(), all.copy(), all])
}

fn edges(g: mut Gen, count: i64) -> Json {
    var out: List<i64> = []
    for _ in 0..count * 3 {
        out.push(g.pick_int(EDGE_QUARTS.to_list()))
    }
    return obj([(String("i32"), ints(out))])
}

fn targets(g: mut Gen, count: i64, spread: i64) -> Json {
    var ranges: List<(String, String)> = []
    for _ in 0..6 {
        ranges.push(("{-spread}", "{spread}"))
    }
    return ranged(mut g, count, ranges)
}

fn edge_targets(g: mut Gen, count: i64) -> Json {
    var out: List<i64> = []
    for _ in 0..count * 6 {
        out.push(g.pick_int(EDGE_TARGETS.to_list()))
    }
    return obj([(String("i32"), ints(out))])
}

/// Climate and biomes near and far, at the edges, and over chunks.
fn asked(g: mut Gen, c: mut Case, settings: String, chunks: i64, heavy: bool) {
    let more = if heavy { 1i64 } else { 0 }
    c.read("climate", near(mut g, 24), 24)
    c.read("points", near(mut g, 120 + 80 * more), 120 + 80 * more)
    c.read("climate", far(mut g, 8), 8)
    c.read("points", far(mut g, 40), 40)
    c.read("points", edges(mut g, 12), 12)
    c.read("points", anywhere(mut g, 6), 6)
    let (min_y, height) = level_of(settings)
    for _ in 0..chunks {
        var cx = 0i64
        var cz = 0i64
        if g.chance(4) {
            cx = g.between(-1875000, 1875000)
            cz = g.between(-1875000, 1875000)
        } else {
            cx = g.between(-40, 40)
            cz = g.between(-40, 40)
        }
        c.op("chunk", [cx, cz, min_y, height])
    }
}

fn preset(name: str) -> Json {
    return obj([(String("type"), s("minecraft:multi_noise")), (String("preset"), s("minecraft:{name}"))])
}

/// A value written as JSON writes it: some ints, some floats.
fn number(g: mut Gen, v: Json) -> Json {
    if let Json.Float(f) = v {
        if f == f.floor() and g.chance(2) {
            return Json.Int(i64.saturate(f))
        }
        return v.copy()
    }
    // An int is its own `int`, drawn for all the same.
    _ = g.chance(2)
    return v.copy()
}

/// A climate parameter, written as one of its three forms.
fn parameter(g: mut Gen, grid: List<Json>?) -> Json {
    var first = Json.Null
    var second = Json.Null
    if let points = grid {
        first = g.pick_value(points)
        second = g.pick_value(points)
        if value(second) < value(first) {
            let swap = second.copy()
            second = first.copy()
            first = swap
        }
    } else {
        first = g.real(-2.0, 2.0)
        second = g.real(-2.0, 2.0)
        if value(second) < value(first) {
            let swap = second.copy()
            second = first.copy()
            first = swap
        }
        if g.chance(4) {
            second = first.copy()
        }
    }
    let form = g.below(3)
    let same = value(first) == value(second)
    if same and form == 0 {
        return number(mut g, first)
    }
    let low = number(mut g, first)
    let high = number(mut g, second)
    if form == 1 or same {
        return arr([low, high])
    }
    return obj([(String("min"), low), (String("max"), high)])
}

fn entry(g: mut Gen, biomes: List<String>, grid: List<Json>?) -> Json {
    var params: List<(String, Json)> = []
    for f in FIELDS {
        params.push((String(f), parameter(mut g, grid.copy())))
    }
    var offset = Json.Null
    let gridded = if let points = grid { not points.is_empty() } else { false }
    if gridded {
        let r = g.real(0.0, 1.0)
        let picked = g.pick_value([Json.Int(0), Json.Int(0), Json.Float(0.375), Json.Int(1), Json.Float(0.5), r])
        offset = number(mut g, picked)
    } else {
        let r = g.real(0.0, 1.0)
        offset = number(mut g, r)
    }
    params.push((String("offset"), offset))
    let biome = g.pick(biomes)
    return obj([(String("biome"), s(biome)), (String("parameters"), obj(params))])
}

fn entries(g: mut Gen, biomes: List<String>, count: i64, grid: List<Json>?) -> List<Json> {
    var out: List<Json> = []
    for _ in 0..count {
        out.push(entry(mut g, biomes, grid.copy()))
    }
    return out
}

fn written(g: mut Gen, biomes: List<String>, count: i64, grid: List<Json>?) -> Json {
    return obj([(String("type"), s("minecraft:multi_noise")), (String("biomes"), arr(entries(mut g, biomes, count, grid)))])
}

/// A point of every field at 0, with some changed, and its offset if `offset`.
fn point_with(changes: List<(str, str)>, offset: bool) -> String {
    var parts: List<String> = []
    var fields: List<str> = FIELDS.to_list()
    if offset {
        fields.push("offset")
    }
    for f in fields {
        var v = String("0")
        for (k, changed) in changes {
            if k == f {
                v = String(changed)
            }
        }
        parts.push("\"{f}\":{v}")
    }
    return "\{{parts.join(",")}\}"
}

const POINT: str = #"{"temperature":0,"humidity":0,"continentalness":0,"erosion":0,"depth":0,"weirdness":0,"offset":0}"#

/// A list of plains alone at a point of every field at 0 but those changed.
fn with_point(field: str, changed: str) -> String {
    return #"{"type":"minecraft:multi_noise","biomes":[{"biome":"minecraft:plains","parameters":#{point_with([(field, changed)], true)}}]}"#
}

/// Sources vanilla doesn't read, each for a different reason.
fn invalid_sources() -> List<(str, Json)> {
    return [
        ("no-type", j(#"{"biome":"minecraft:plains"}"#)),
        ("unknown-type", j(#"{"type":"minecraft:mystery","biome":"minecraft:plains"}"#)),
        ("not-an-object", s("minecraft:plains")),
        ("fixed-no-biome", j(#"{"type":"minecraft:fixed"}"#)),
        ("fixed-unknown-biome", j(#"{"type":"minecraft:fixed","biome":"minecraft:nowhere"}"#)),
        ("fixed-bad-id", j(#"{"type":"minecraft:fixed","biome":"Not An Id"}"#)),
        ("fixed-tag", j(##"{"type":"minecraft:fixed","biome":"#minecraft:is_ocean"}"##)),
        ("fixed-number", j(#"{"type":"minecraft:fixed","biome":3}"#)),
        ("checkerboard-no-biomes", j(#"{"type":"minecraft:checkerboard"}"#)),
        ("checkerboard-scale-63", j(#"{"type":"minecraft:checkerboard","biomes":["minecraft:plains"],"scale":63}"#)),
        ("checkerboard-scale-negative", j(#"{"type":"minecraft:checkerboard","biomes":["minecraft:plains"],"scale":-1}"#)),
        ("checkerboard-missing-tag", j(##"{"type":"minecraft:checkerboard","biomes":"#minecraft:is_nowhere"}"##)),
        ("checkerboard-unknown-biome", j(#"{"type":"minecraft:checkerboard","biomes":["minecraft:plains","minecraft:nowhere"]}"#)),
        ("checkerboard-tag-in-list", j(##"{"type":"minecraft:checkerboard","biomes":["#minecraft:is_ocean"]}"##)),
        ("multi-nothing", j(#"{"type":"minecraft:multi_noise"}"#)),
        ("multi-empty", j(#"{"type":"minecraft:multi_noise","biomes":[]}"#)),
        ("multi-unknown-preset", preset("mystery")),
        ("multi-preset-number", j(#"{"type":"minecraft:multi_noise","preset":1}"#)),
        ("multi-preset-inline-unknown", j(#"{"type":"minecraft:multi_noise","preset":{"preset":"minecraft:end"}}"#)),
        ("multi-no-parameters", j(#"{"type":"minecraft:multi_noise","biomes":[{"biome":"minecraft:plains"}]}"#)),
        ("multi-no-biome", j(#"{"type":"minecraft:multi_noise","biomes":[{"parameters":#{POINT}}]}"#)),
        ("multi-unknown-biome", j(#"{"type":"minecraft:multi_noise","biomes":[{"biome":"minecraft:nowhere","parameters":#{POINT}}]}"#)),
        ("multi-no-offset", j(#"{"type":"minecraft:multi_noise","biomes":[{"biome":"minecraft:plains","parameters":#{point_with([], false)}}]}"#)),
        ("multi-above-2", j(with_point("temperature", "2.5"))),
        ("multi-below-minus-2", j(with_point("erosion", "-2.0001"))),
        ("multi-backwards", j(with_point("humidity", "[0.5,-0.5]"))),
        ("multi-backwards-object", j(with_point("depth", #"{"min":1,"max":0}"#))),
        ("multi-backwards-zeros", j(with_point("weirdness", "[0.0,-0.0]"))),
        ("multi-three", j(with_point("continentalness", "[0,0.5,1]"))),
        ("multi-one", j(with_point("continentalness", "[0]"))),
        ("multi-no-max", j(with_point("continentalness", #"{"min":0}"#))),
        ("multi-string", j(with_point("temperature", #""0.5""#))),
        ("multi-offset-above-1", j(with_point("offset", "1.5"))),
        ("multi-offset-negative", j(with_point("offset", "-0.25"))),
        ("multi-offset-negative-zero", j(with_point("offset", "-0.0"))),
        ("multi-infinite", j(with_point("temperature", "1e40"))),
        ("multi-bad-entry", j(#"{"type":"minecraft:multi_noise","biomes":[{"biome":"minecraft:plains","parameters":#{POINT}},7]}"#)),
        ("multi-not-a-list", j(#"{"type":"minecraft:multi_noise","biomes":{"biome":"minecraft:plains","parameters":#{POINT}}}"#)),
    ]
}

/// The ids of vanilla's files under `kind`, in name order.
fn ids(jar: Zip, prefix: str) -> List<String> {
    var out: List<String> = []
    for name in names(jar, prefix, ".json") {
        out.push("minecraft:{name[prefix.len()..name.len() - 5]}")
    }
    return out
}

pub fn main() {
    var g = Gen { r: splitmix64(SEED) }
    let jar = vanilla()
    let biomes = ids(jar, "data/minecraft/worldgen/biome/")
    let tags = ids(jar, "data/minecraft/tags/worldgen/biome/")
    var settings_names: List<String> = []
    for id in ids(jar, "data/minecraft/worldgen/noise_settings/") {
        settings_names.push(id[10..id.len()])
    }
    var cases: List<Json> = []

    // Vanilla's presets, with the settings worlds give them, then with every other settings.
    for (name, worlds) in world_presets() {
        let first = String(worlds[0])
        var listed = start("preset-{name}-list", g.seed(), first, preset(name), false)
        listed.op("list", [])
        asked(mut g, mut listed, first, 1, false)
        cases.push(listed.build())
        for settings in worlds {
            for i in 0..5 {
                var c = start("preset-{name}-{settings}-{i}", g.seed(), String(settings), preset(name), i % 2 == 1)
                asked(mut g, mut c, String(settings), 3, true)
                cases.push(c.build())
            }
        }
        for settings in settings_names {
            if not worlds.any(|w| w == settings) {
                let seed = g.seed()
                var c = start("preset-{name}-with-{settings}", seed, settings, preset(name), g.chance(2))
                asked(mut g, mut c, settings, 2, true)
                cases.push(c.build())
            }
        }
        // The preset written out as its file is.
        let inline = obj([(String("type"), s("multi_noise")), (String("preset"), obj([(String("preset"), s(String(name)))]))])
        var c = start("preset-{name}-inline", g.seed(), first, inline, false)
        c.op("list", [])
        asked(mut g, mut c, first, 1, false)
        cases.push(c.build())
    }

    // Searching the presets directly: near their entries, far from all of them, and where the
    // squared distances wrap.
    for (name, worlds) in world_presets() {
        for i in 0..3 {
            var c = start("preset-{name}-search-{i}", g.seed(), String(worlds[0]), preset(name), false)
            c.read("search", targets(mut g, 300, 12000), 300)
            c.read("search", targets(mut g, 60, 40000), 60)
            c.read("search", targets(mut g, 20, INT_MAX), 20)
            c.read("search", edge_targets(mut g, 40), 40)
            c.read("points", near(mut g, 40), 40)
            cases.push(c.build())
        }
    }

    // The End: the central island, then the outer islands, with the End's settings and others.
    for settings in ["end", "end", "end", "end", "end", "end", "overworld", "nether", "floating_islands"] {
        let seed = g.seed()
        var c = start("end-{settings}-{cases.len()}", seed, String(settings), obj([(String("type"), s("minecraft:the_end"))]), g.chance(2))
        c.read("points", near(mut g, 80), 80)
        c.read("points", ranged(mut g, 200, [(String("-20000"), String("20000")), (String("-16"), String("80")), (String("-20000"), String("20000"))]), 200)
        c.read("points", far(mut g, 40), 40)
        c.read("points", edges(mut g, 12), 12)
        c.read("climate", near(mut g, 8), 8)
        let (min_y, height) = level_of(String(settings))
        var chunks: List<(i64, i64)> = [(0, 0), (64, 0), (65, 0), (-46, 46)]
        for _ in 0..2 {
            let cx = g.between(-1000, 1000)
            let cz = g.between(-1000, 1000)
            chunks.push((cx, cz))
        }
        for (cx, cz) in chunks {
            c.op("chunk", [cx, cz, min_y, height])
        }
        cases.push(c.build())
    }

    // Fixed: one biome everywhere, for a handful of biomes and settings.
    for i in 0..10 {
        let biome = g.pick(biomes)
        let written_type = g.pick([String("minecraft:fixed"), String("fixed")])
        let settings = g.pick(settings_names)
        var c = start("fixed-{i}", g.seed(), settings.copy(), obj([(String("type"), s(written_type)), (String("biome"), s(biome))]), false)
        c.read("points", near(mut g, 20), 20)
        c.read("points", edges(mut g, 5), 5)
        let (min_y, height) = level_of(settings)
        let cx = g.between(-100, 100)
        let cz = g.between(-100, 100)
        c.op("chunk", [cx, cz, min_y, height])
        cases.push(c.build())
    }

    // The checkerboard at every scale, its shift past 31 as Java masks it, with each way of naming
    // its biomes.
    for k in 0i64..64 {
        let scale: i64? = if k < 63 { some(k) } else { none }
        let form = g.below(4)
        var listed = Json.Null
        if form == 0 {
            listed = s("#{g.pick(tags)}")
        } else if form == 1 {
            listed = s(g.pick(biomes))
        } else {
            let count = g.between(1, 9)
            var picked: List<String> = []
            for _ in 0..count {
                picked.push(g.pick(biomes))
            }
            if picked.len() > 2 and g.chance(2) {
                picked[1] = picked[0].copy()
            }
            listed = strs(picked)
        }
        var source: List<(String, Json)> = [(String("type"), s("minecraft:checkerboard")), (String("biomes"), listed)]
        if let v = scale {
            source.push((String("scale"), n(v)))
        }
        let settings = g.pick(settings_names)
        let label = if let v = scale { "{v}" } else { String("default") }
        var c = start("checkerboard-{label}", g.seed(), settings.copy(), obj(source), false)
        c.read("points", near(mut g, 40), 40)
        c.read("points", far(mut g, 20), 20)
        c.read("points", edges(mut g, 10), 10)
        c.read("points", anywhere(mut g, 10), 10)
        let (min_y, height) = level_of(settings)
        let cx = g.between(-100, 100)
        let cz = g.between(-100, 100)
        c.op("chunk", [cx, cz, min_y, height])
        cases.push(c.build())
    }
    // No biomes at all: reads, then throws at the first biome asked for.
    let empty = j(#"{"type":"minecraft:checkerboard","biomes":[]}"#)
    var none_asked = start(String("checkerboard-empty"), g.seed(), String("overworld"), empty.copy(), false)
    none_asked.read("points", near(mut g, 3), 3)
    cases.push(none_asked.build())
    var chunked = start(String("checkerboard-empty-chunk"), g.seed(), String("overworld"), empty.copy(), false)
    chunked.op("chunk", [0, 0, -64, 384])
    cases.push(chunked.build())
    let unasked = start(String("checkerboard-empty-unasked"), g.seed(), String("overworld"), empty, false)
    cases.push(unasked.build())

    // Lists written out: sizes either side of a node's 19 children and of the tree's levels,
    // points from a coarse grid so many tie, and from anywhere.
    let sizes: List<i64> = [1, 2, 3, 5, 18, 19, 20, 21, 37, 38, 40, 100, 360, 361, 362, 363, 400, 722, 723, 1500]
    let grids: List<List<Json>?> = [none, some(list("[-1,0,1]")), some(list("[-2,-1,-0.5,0,0.5,1,2]")), some(list("[0]")), some(list("[-0.25,0.25]"))]
    var all_sizes = sizes.copy()
    for size in sizes {
        if size <= 400 {
            all_sizes.push(size)
        }
    }
    for (i, size) in all_sizes.enumerate() {
        let grid = grids[i % grids.len()].copy()
        let settings = g.pick([String("overworld"), String("overworld"), String("nether"), String("large_biomes"), String("end")])
        let seed = g.seed()
        let keep = g.between(2, i64.wrap(biomes.len()))
        let some_biomes = biomes[0..usize.wrap(keep)]
        let source = written(mut g, some_biomes, size, grid)
        var c = start("written-{size}-{i}", seed, settings.copy(), source, g.chance(2))
        c.op("list", [])
        c.read("search", targets(mut g, 200, 22000), 200)
        c.read("search", targets(mut g, 30, INT_MAX), 30)
        c.read("search", edge_targets(mut g, 20), 20)
        c.read("points", near(mut g, 60), 60)
        c.read("search", targets(mut g, 50, 3), 50)
        if size <= 400 {
            let (min_y, height) = level_of(settings)
            let cx = g.between(-60, 60)
            let cz = g.between(-60, 60)
            c.op("chunk", [cx, cz, min_y, height])
        }
        cases.push(c.build())
    }
    // Quantizing: values a ten-thousandth apart, and halves of one, either side of 0.
    let fine = list("[-0.0001,-0.00005,-0.00004,0,0.00004,0.00005,0.0001,0.00015,-0.00015,1.99995,-1.99995,2,-2]")
    for i in 0..6 {
        let seed = g.seed()
        var c = start("written-quantized-{i}", seed, String("overworld"), written(mut g, biomes, 40, some(fine.copy())), false)
        c.op("list", [])
        c.read("search", targets(mut g, 100, 3), 100)
        c.read("search", edge_targets(mut g, 20), 20)
        cases.push(c.build())
    }
    // Booleans, which `JsonOps` doesn't read as numbers.
    var booleans = start(String("invalid-booleans"), g.seed(), String("overworld"), j(#"{"type":"minecraft:multi_noise","biomes":[{"biome":"minecraft:plains","parameters":#{point_with([("temperature", "true"), ("offset", "false")], true)}},{"biome":"minecraft:desert","parameters":#{point_with([("humidity", "[false,true]"), ("offset", "true")], true)}}]}"#), false)
    booleans.op("list", [])
    booleans.read("search", targets(mut g, 40, 15000), 40)
    cases.push(booleans.build())
    // Both a list and a preset: the list wins when it reads, and the preset when it doesn't.
    let seed = g.seed()
    var both = start(String("written-and-preset"), seed, String("nether"), with(written(mut g, biomes, 5, none), "preset", s("minecraft:nether")), false)
    both.op("list", [])
    cases.push(both.build())
    var bad = entries(mut g, biomes, 3, none)
    bad[1] = with(bad[1].copy(), "biome", s("minecraft:nowhere"))
    let bad_source = obj([(String("type"), s("minecraft:multi_noise")), (String("biomes"), arr(bad)), (String("preset"), s("minecraft:nether"))])
    var bad_case = start(String("written-bad-then-preset"), g.seed(), String("nether"), bad_source, false)
    bad_case.op("list", [])
    cases.push(bad_case.build())

    for (name, source) in invalid_sources() {
        var c = start("invalid-{name}", g.seed(), String("overworld"), source.copy(), false)
        c.read("points", near(mut g, 2), 2)
        cases.push(c.build())
    }

    write_file(file("biomes", "generated.json"), String("biomes"), "cases/biomes/gen.calx, seed {SEED}", cases, 1)
}
