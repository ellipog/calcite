module cases.registries.gen

// Writes cases/registries/configuration.json: the server's known packs, the synchronized
// registries' entries, the tags of every registry the server sends tags for, and each synchronized
// registry's entries with their contents, as a client that knows none of the server's packs is
// sent them.
//
//     calx cases/registries/gen.calx
//
// The registries are the ones Calcite names in src/registry/registries.calx (`synced_names`) and
// src/registry/builtin.calx (`builtin_names`, written from the data generator's report), so each
// has a case, including those with no tags, whose result is an empty list.

import std.fs.{read_text}
import std.json.{Json}
import std.process.{exit}
import std.regex.{Regex}
import cases.kit.{b, case, file, obj, s, with}
import rig.runner.cases.{write_file}
import tools.repo.{under}

// The registries whose contents have maps vanilla fills in an order that changes from run to run,
// `Map.copyOf` over attributes hashed by identity: a timeline's tracks, and a dimension type's and
// a biome's attributes. Their compounds are compared sorted by key (D192).
const UNORDERED: [str; 3] = ["timeline", "dimension_type", "worldgen/biome"]

/// The string list `function` in the Calx module at `rel` returns.
fn names(rel: str, function: str) -> List<String> {
    let text = read_text(under(String(rel)))! ?? String("")
    var body = Regex.new("pub fn {function}\\(\\) -> List<String> \\\{\\s*return \\[((?s:.*?))\\]")!
    let found = body.captures(text) else {
        eprintln("no {function} in {rel}")
        exit(1)
    }
    let inside = found.get(1) ?? String("")
    var quoted = Regex.new(#""([^"]+)""#)!
    var out: List<String> = []
    for c in quoted.captures_all(inside) {
        out.push(c.get(1) ?? String(""))
    }
    return out
}

fn input(op: str, registry: String?) -> Json {
    if let r = registry {
        return obj([(String("op"), s(String(op))), (String("registry"), s("minecraft:{r}"))])
    }
    return obj([(String("op"), s(String(op)))])
}

pub fn main() {
    var cases: List<Json> = [case(String("known-packs"), input("known_packs", none)), case(String("synced"), input("synced", none))]
    let synced = names("src/registry/registries.calx", "synced_names")
    var registries = synced.copy()
    registries.extend(names("src/registry/builtin.calx", "builtin_names"))
    for name in registries {
        cases.push(case("tags-{name.replace("/", ".")}", input("tags", some(name.copy()))))
    }
    for name in synced {
        var c = case("contents-{name.replace("/", ".")}", input("contents", some(name.copy())))
        if UNORDERED.any(|u| u == name) {
            c = with(c, "unordered", b(true))
        }
        cases.push(c)
    }
    write_file(file("registries", "configuration.json"), String("registries"), String("cases/registries/gen.calx"), cases, 2)
}
