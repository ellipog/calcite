module cases.stats.gen

// Writes cases/stats/generated.json: players' statistics as vanilla's `ServerStatsCounter` keeps
// them (CAL-164). Each case is a player's file read as they join, through `STATS_CODEC`, with the
// errors it logs for what doesn't read, then stats awarded, sent and saved, so the order each
// `HashMap` and `Object2IntOpenHashMap` puts them in shows. The files say 26.3's `DataVersion`,
// 5023, since vanilla upgrades an older one, which Calcite doesn't.
//
//     calx cases/stats/gen.calx

import std.json.{Json}
import cases.kit.{arr, case, file, n, obj, s}
import rig.runner.cases.{write_file}
import tools.pyjson.{spaced}

const VERSION: i64 = 5023

/// The custom stats, `Stats`' in its order.
fn custom() -> List<str> {
    return ["leave_game", "play_time", "total_world_time", "time_since_death", "time_since_rest", "sneak_time", "walk_one_cm", "crouch_one_cm", "sprint_one_cm", "walk_on_water_one_cm", "fall_one_cm", "climb_one_cm", "fly_one_cm", "walk_under_water_one_cm", "minecart_one_cm", "boat_one_cm", "pig_one_cm", "happy_ghast_one_cm", "horse_one_cm", "aviate_one_cm", "swim_one_cm", "strider_one_cm", "nautilus_one_cm", "jump", "drop", "damage_dealt", "damage_dealt_absorbed", "damage_dealt_resisted", "damage_taken", "damage_blocked_by_shield", "damage_absorbed", "damage_resisted", "deaths", "mob_kills", "animals_bred", "player_kills", "fish_caught", "talked_to_villager", "traded_with_villager", "eat_cake_slice", "fill_cauldron", "use_cauldron", "clean_armor", "clean_banner", "clean_shulker_box", "interact_with_brewingstand", "interact_with_beacon", "inspect_dropper", "inspect_hopper", "inspect_dispenser", "play_noteblock", "tune_noteblock", "pot_flower", "trigger_trapped_chest", "open_enderchest", "enchant_item", "play_record", "interact_with_furnace", "interact_with_crafting_table", "open_chest", "sleep_in_bed", "sleep_in_straw_bed", "open_shulker_box", "open_barrel", "interact_with_blast_furnace", "interact_with_smoker", "interact_with_lectern", "interact_with_campfire", "interact_with_cartography_table", "interact_with_loom", "interact_with_stonecutter", "bell_ring", "raid_trigger", "raid_win", "interact_with_anvil", "interact_with_grindstone", "target_hit", "interact_with_smithing_table"]
}

/// Each custom stat with its place.
fn numbered() -> List<(usize, str)> {
    var out: List<(usize, str)> = []
    for (i, name) in custom().enumerate() {
        out.push((i, name))
    }
    return out
}

/// A stats file's text: the raw JSON of its `stats`, then the version.
fn raw_file(body: String) -> String {
    return "\{\"stats\":{body},\"DataVersion\":{VERSION}\}"
}

/// A stats file's text, its `stats` as Python's `json.dumps` writes them.
fn stats_file(stats: Json) -> String {
    return raw_file(spaced(stats))
}

/// `{type: {value: count, ...}, ...}`, in the order given.
fn table(types: List<(str, List<(str, i64)>)>) -> Json {
    var members: List<(String, Json)> = []
    for (kind, counts) in types {
        var inner: List<(String, Json)> = []
        for (value, count) in counts {
            inner.push((String(value), n(count)))
        }
        members.push((String(kind), obj(inner)))
    }
    return obj(members)
}

/// Each custom stat in `names`, `minecraft:`-prefixed, counted `count(i)` for its place `i`.
fn customs(names: List<(usize, str)>, count: fn(usize) -> i64) -> Json {
    var inner: List<(String, Json)> = []
    for (i, name) in names {
        inner.push(("minecraft:{name}", n(count(i))))
    }
    return obj([(String("minecraft:custom"), obj(inner))])
}

fn act(name: str) -> Json {
    return arr([s(String(name))])
}

fn award(kind: str, value: own String, count: i64) -> Json {
    return arr([s("award"), s(String(kind)), s(value), n(count)])
}

fn add(cases: mut List<Json>, id: str, text: String?, ops: List<Json>?) {
    var input: List<(String, Json)> = []
    if let t = text {
        input.push((String("json"), s(t.copy())))
    }
    if let o = ops {
        input.push((String("ops"), arr(o.copy())))
    } else {
        input.push((String("ops"), arr([act("mark_all_dirty"), act("send"), act("save")])))
    }
    cases.push(case(String(id), obj(input)))
}

fn reads(cases: mut List<Json>) {
    add(mut cases, "no-file", none, some([act("save"), act("send")]))
    add(mut cases, "empty", some(stats_file(obj([]))), none)
    add(mut cases, "no-stats", some(String("\{\"DataVersion\":5023\}")), none)
    add(mut cases, "one", some(stats_file(table([("minecraft:custom", [("minecraft:jump", 3)])]))), none)
    add(mut cases, "every-type", some(stats_file(table([
        ("minecraft:mined", [("minecraft:stone", 12), ("minecraft:dirt", 3), ("minecraft:oak_log", 7)]),
        ("minecraft:crafted", [("minecraft:oak_planks", 16), ("minecraft:stick", 8)]),
        ("minecraft:used", [("minecraft:stone_axe", 5), ("minecraft:bread", 2), ("minecraft:dirt", 30)]),
        ("minecraft:broken", [("minecraft:golden_pickaxe", 1)]),
        ("minecraft:picked_up", [("minecraft:dirt", 10), ("minecraft:oak_log", 5), ("minecraft:mutton", 1)]),
        ("minecraft:dropped", [("minecraft:stone", 64), ("minecraft:iron_sword", 1)]),
        ("minecraft:killed", [("minecraft:zombie", 1), ("minecraft:skeleton", 2), ("minecraft:cow", 3)]),
        ("minecraft:killed_by", [("minecraft:creeper", 1), ("minecraft:player", 2)]),
        ("minecraft:custom", [("minecraft:play_time", 400), ("minecraft:jump", 9), ("minecraft:leave_game", 2)]),
    ]))), none)
    // Every custom stat, so the tables grow past their first size.
    let forward = numbered()
    var backward = forward.copy()
    backward.reverse()
    add(mut cases, "every-custom", some(stats_file(customs(forward, |i| i64.wrap(i) + 1))), none)
    add(mut cases, "every-custom-reversed", some(stats_file(customs(backward, |i| i64.wrap(i) + 1))), none)
    add(mut cases, "short-ids", some(stats_file(table([("custom", [("jump", 4), ("minecraft:drop", 2)]), ("mined", [("stone", 1)])]))), none)
    // Counts as Gson's numbers give them as ints, `Number.intValue`, and a boolean as 1 or 0.
    add(mut cases, "counts", some(raw_file(#"{"minecraft:custom":{"minecraft:jump":-7,"minecraft:drop":0,"minecraft:deaths":1.9,"minecraft:mob_kills":1e3,"minecraft:player_kills":2147483648,"minecraft:fish_caught":-2147483649,"minecraft:play_time":99999999999999999999,"minecraft:bell_ring":true,"minecraft:raid_win":false}}"#)), none)
    add(mut cases, "repeated-key", some(raw_file(#"{"minecraft:custom":{"minecraft:jump":1,"minecraft:drop":2,"minecraft:jump":5}}"#)), none)
    add(mut cases, "repeated-type", some(raw_file(#"{"minecraft:custom":{"minecraft:jump":1},"minecraft:mined":{"minecraft:stone":1},"minecraft:custom":{"minecraft:drop":2}}"#)), none)
}

fn errors(cases: mut List<Json>) {
    add(mut cases, "stats-not-object", some(raw_file("3")), none)
    add(mut cases, "stats-array", some(raw_file("[1,2]")), none)
    add(mut cases, "type-not-object", some(raw_file(#"{"minecraft:custom":5,"minecraft:mined":{"minecraft:stone":1}}"#)), none)
    add(mut cases, "unknown-type", some(stats_file(table([("minecraft:nope", [("minecraft:stone", 1)]), ("minecraft:custom", [("minecraft:jump", 2)])]))), none)
    add(mut cases, "bad-type-id", some(stats_file(table([("Bad Type", [("minecraft:stone", 1)]), ("minecraft:custom", [("minecraft:jump", 2)])]))), none)
    add(mut cases, "unknown-value", some(stats_file(table([("minecraft:mined", [("minecraft:nope", 3), ("minecraft:stone", 2)])]))), none)
    add(mut cases, "bad-value-id", some(stats_file(table([("minecraft:mined", [("A:b", 3), ("minecraft:stone", 2)])]))), none)
    add(mut cases, "value-of-another-registry", some(stats_file(table([("minecraft:mined", [("minecraft:iron_sword", 3)]), ("minecraft:killed", [("minecraft:stone", 1)])]))), none)
    add(mut cases, "not-a-number", some(raw_file(#"{"minecraft:custom":{"minecraft:jump":"5","minecraft:drop":2}}"#)), none)
    add(mut cases, "null-count", some(raw_file(#"{"minecraft:custom":{"minecraft:jump":null,"minecraft:drop":2}}"#)), none)
    add(mut cases, "object-count", some(raw_file(#"{"minecraft:custom":{"minecraft:jump":{"a":1},"minecraft:drop":[2]}}"#)), none)
    add(mut cases, "bad-key-and-count", some(raw_file(#"{"minecraft:custom":{"minecraft:nope":"x","minecraft:drop":2}}"#)), none)
    add(mut cases, "many-errors", some(raw_file(#"{"minecraft:custom":{"minecraft:nope":1,"minecraft:jump":2,"minecraft:drop":"x","Bad":3},"minecraft:what":{},"minecraft:mined":{"minecraft:stone":1,"minecraft:air":"y","minecraft:missing":4},"minecraft:killed":7}"#)), none)
    add(mut cases, "all-bad", some(raw_file(#"{"minecraft:what":{"minecraft:jump":1},"minecraft:custom":[]}"#)), none)
}

fn awards(cases: mut List<Json>) {
    let custom_stat = "minecraft:custom"
    add(mut cases, "award-new", none, some([
        award(custom_stat, String("minecraft:play_time"), 1),
        award(custom_stat, String("minecraft:total_world_time"), 1),
        award(custom_stat, String("minecraft:time_since_death"), 1),
        award(custom_stat, String("minecraft:time_since_rest"), 1),
        award(custom_stat, String("minecraft:leave_game"), 1),
        act("send"), act("send"), act("save"),
    ]))
    add(mut cases, "award-saturates", some(stats_file(table([("minecraft:custom", [("minecraft:jump", 2147483600)])]))), some([
        award(custom_stat, String("minecraft:jump"), 100),
        award(custom_stat, String("minecraft:drop"), 2147483647),
        award(custom_stat, String("minecraft:drop"), 1),
        act("send"), act("save"),
    ]))
    add(mut cases, "award-negative", some(stats_file(table([("minecraft:custom", [("minecraft:jump", 3)])]))), some([
        award(custom_stat, String("minecraft:jump"), -5),
        award(custom_stat, String("minecraft:deaths"), -2147483648),
        award(custom_stat, String("minecraft:deaths"), -1),
        act("send"), act("save"),
    ]))
    var every: List<Json> = []
    for (i, name) in custom().enumerate() {
        every.push(award(custom_stat, "minecraft:{name}", i64.wrap(i) + 1))
    }
    every.extend([act("send"), act("save")])
    add(mut cases, "award-every-custom", none, some(every))
    add(mut cases, "award-mixed", some(stats_file(table([("minecraft:custom", [("minecraft:jump", 3), ("minecraft:play_time", 10)])]))), some([
        award("minecraft:killed", String("minecraft:cow"), 1),
        award("minecraft:killed", String("minecraft:sheep"), 1),
        award("minecraft:killed", String("minecraft:cow"), 1),
        award(custom_stat, String("minecraft:mob_kills"), 3),
        award("minecraft:used", String("minecraft:stone_axe"), 5),
        award("minecraft:mined", String("minecraft:grass_block"), 1),
        award("minecraft:mined", String("minecraft:tripwire"), 1),
        award("minecraft:picked_up", String("minecraft:mutton"), 1),
        award("minecraft:dropped", String("minecraft:stone"), 64),
        award("minecraft:broken", String("minecraft:golden_pickaxe"), 1),
        award("minecraft:crafted", String("minecraft:stick"), 4),
        award("minecraft:killed_by", String("minecraft:zombie"), 1),
        act("send"), act("mark_all_dirty"), act("send"), act("save"),
    ]))
    var first = numbered()
    first.truncate(20)
    add(mut cases, "join-then-award", some(stats_file(customs(first, |_| 2))), some([
        act("mark_all_dirty"),
        award(custom_stat, String("minecraft:jump"), 1),
        act("send"),
        award(custom_stat, String("minecraft:jump"), 1),
        award(custom_stat, String("minecraft:drop"), 1),
        act("send"), act("save"),
    ]))
}

pub fn main() {
    var cases: List<Json> = []
    reads(mut cases)
    errors(mut cases)
    awards(mut cases)
    write_file(file("stats", "generated.json"), String("stats"), String("cases/stats/gen.calx"), cases, 1)
}
