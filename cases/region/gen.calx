module cases.region.gen

// Writes cases/region/generated.json: region files written, read, cleared and opened again as
// vanilla's RegionFile does them, chunks big enough for files of their own, every compression,
// broken streams, and files whose headers point where no chunk can be.
//
//     calx cases/region/gen.calx
//
// Deterministic: noise comes from SplitMix64, seeded here, and text from a fixed rule, so rerunning
// it gives the same file.
//
// A chunk's bytes come from the case, compressed already: its compression's byte, then the stream,
// which both adapters write as they are, so the files compare byte for byte. The streams are made
// here. zlib and gzip are compressed by rig/runner/deflate.calx, which writes the same bytes on
// every machine. lz4 is framed as lz4-java's LZ4BlockOutputStream frames it, in blocks compressed
// by a greedy LZ4 compressor here, or stored. Chunks of a megabyte are stored zlib blocks around
// the runner's generated noise, so the case file holds only their framing.

import std.bytes
import std.bytes.{base64, hex}
import std.json.{Json}
import std.zlib.{adler32}
import cases.kit.{arr, case_with, file, n, obj, s}
import rig.runner.cases.{splitmix64, write_file}
import rig.runner.deflate.{gzip_stream, zlib_stream}

const SEED: u64 = 20261029
const GZIP: u8 = 1
const DEFLATE: u8 = 2
const STORED: u8 = 3
const LZ4: u8 = 4
const CUSTOM: u8 = 127
const SECTOR: usize = 4096
const WORDS: [str; 7] = ["stone ", "dirt ", "grass_block ", "oak_log ", "water ", "air ", "bedrock "]

fn b64(data: List<u8>) -> Json {
    return s(base64(data.copy()))
}

fn hex_part(data: List<u8>) -> Json {
    return obj([(String("hex"), arr([s(hex(data.copy()))]))])
}

fn cat(parts: List<List<u8>>) -> List<u8> {
    var out: List<u8> = []
    for p in parts {
        out.extend(p.copy())
    }
    return out
}

fn bytes_of(literal: str) -> List<u8> {
    return String(literal).to_bytes()
}

/// Bytes that compress well: words from a short list, picked by a fixed rule.
fn text(count: usize, salt: usize) -> List<u8> {
    var out: List<u8> = []
    var i = salt
    while out.len() < count {
        out.extend(bytes_of(WORDS[(i * 7 + i / 3) % WORDS.len()]))
        i += 1
    }
    return out[0..count]
}

/// Incompressible bytes, as the runner's `f64_bits` generator expands them, with their parts.
struct Noise {
    seed: u64
}

impl Noise {
    /// `count` bytes: whole 8-byte draws from the next seed, then zeros for the rest.
    fn make(mut self, count: usize) -> (List<u8>, List<Json>) {
        self.seed += 1
        var rand = splitmix64(self.seed)
        var data: List<u8> = []
        for _ in 0..count / 8 {
            bytes.put_u64_be(mut data, rand.next())
        }
        for _ in 0..count % 8 {
            data.push(0)
        }
        var parts: List<Json> = [obj([(String("gen"), s("f64_bits")), (String("seed"), s("{self.seed}")), (String("count"), n(i64.wrap(count / 8)))])]
        if count % 8 > 0 {
            parts.push(obj([(String("hex"), arr([s("00".repeat(count % 8))]))]))
        }
        return (data, parts)
    }
}

/// A chunk stored as it is: compression 3 and `count` bytes of noise.
fn stored_chunk(noise: mut Noise, count: usize) -> Json {
    let (_, parts) = noise.make(count)
    var out: List<Json> = [hex_part([STORED])]
    out.extend(parts)
    return arr(out)
}

/// A zlib chunk, compression 2, of exactly `length` bytes with its compression's byte: noise in
/// stored deflate blocks, which every inflater reads.
fn zlib_noise_chunk(noise: mut Noise, length: usize) -> Json {
    let body = length - 1 - 2 - 4
    let blocks = (body + 65535 + 5 - 1) / (65535 + 5)
    let data_len = body - 5 * blocks
    let q = data_len / blocks
    let r = data_len % blocks
    var parts: List<Json> = [obj([(String("hex"), arr([s("02 7801")]))])]
    var data: List<u8> = []
    for k in 0..blocks {
        let size = if k < r { q + 1 } else { q }
        if size > 65535 {
            panic("a stored block of {size} bytes")
        }
        let (chunk, chunk_parts) = noise.make(size)
        var head: List<u8> = [if k == blocks - 1 { 1 } else { 0 }]
        bytes.put_u16_le(mut head, u16.wrap(size))
        bytes.put_u16_le(mut head, u16.wrap(size ^ 0xFFFF))
        parts.push(hex_part(head))
        parts.extend(chunk_parts)
        data.extend(chunk)
    }
    var sum: List<u8> = []
    bytes.put_u32_be(mut sum, adler32(data))
    parts.push(hex_part(sum))
    return arr(parts)
}

// XXH32, as lz4-java's checksums use it.
const P1: u64 = 2654435761
const P2: u64 = 2246822519
const P3: u64 = 3266489917
const P4: u64 = 668265263
const P5: u64 = 374761393
const M32: u64 = 0xFFFFFFFF

fn rotl(x: u64, r: u64) -> u64 {
    return ((x << r) | (x >> (32 - r))) & M32
}

fn lane(data: List<u8>, at: usize) -> u64 {
    return u64(data[at]) | (u64(data[at + 1]) << 8) | (u64(data[at + 2]) << 16) | (u64(data[at + 3]) << 24)
}

fn xxh32(data: List<u8>, seed: u64) -> u64 {
    let total = data.len()
    var i = 0usize
    var h = 0u64
    if total >= 16 {
        var v: List<u64> = [(seed + P1 + P2) & M32, (seed + P2) & M32, seed & M32, (seed + (1u64 << 32) - P1) & M32]
        while i + 16 <= total {
            for k in 0usize..4 {
                let x = lane(data, i + 4 * k)
                v[k] = (rotl((v[k] + ((x * P2) & M32)) & M32, 13) * P1) & M32
            }
            i += 16
        }
        h = (rotl(v[0], 1) + rotl(v[1], 7) + rotl(v[2], 12) + rotl(v[3], 18)) & M32
    } else {
        h = (seed + P5) & M32
    }
    h = (h + u64(total)) & M32
    while i + 4 <= total {
        h = (h + ((lane(data, i) * P3) & M32)) & M32
        h = (rotl(h, 17) * P4) & M32
        i += 4
    }
    while i < total {
        h = (h + u64(data[i]) * P5) & M32
        h = (rotl(h, 11) * P1) & M32
        i += 1
    }
    h ^= h >> 15
    h = (h * P2) & M32
    h ^= h >> 13
    h = (h * P3) & M32
    h ^= h >> 16
    return h
}

fn lz4_length(out: mut List<u8>, value: usize) {
    var v = value
    while v >= 255 {
        out.push(255)
        v -= 255
    }
    out.push(u8.wrap(v))
}

/// One sequence: literals, then a match of `length` bytes `offset` back, if `offset` isn't 0.
fn sequence(out: mut List<u8>, literals: List<u8>, offset: usize, length: usize) {
    let lit = literals.len()
    let high = if lit < 15 { lit } else { 15 }
    var low = 0usize
    if offset > 0 {
        low = if length - 4 < 15 { length - 4 } else { 15 }
    }
    out.push(u8.wrap((high << 4) | low))
    if lit >= 15 {
        lz4_length(mut out, lit - 15)
    }
    out.extend(literals.copy())
    if offset > 0 {
        bytes.put_u16_le(mut out, u16.wrap(offset))
        if length - 4 >= 15 {
            lz4_length(mut out, length - 4 - 15)
        }
    }
}

/// One LZ4 block, greedy, with the format's rules for its end: the last match starts 12 or more
/// bytes before it, and the last 5 bytes are literals.
fn lz4_block(src: List<u8>) -> List<u8> {
    let total = src.len()
    var out: List<u8> = []
    var seen = Map<u32, usize>()
    var anchor = 0usize
    var i = 0usize
    while i + 12 < total {
        let key = u32.wrap(lane(src, i))
        let before = seen.get(key) ?? total
        seen.insert(key, i)
        if before < total and i - before <= 65535 {
            var m = 4usize
            while i + m < total - 5 and src[before + m] == src[i + m] {
                m += 1
            }
            sequence(mut out, src[anchor..i], i - before, m)
            i += m
            anchor = i
        } else {
            i += 1
        }
    }
    sequence(mut out, src[anchor..total], 0, 0)
    return out
}

fn lz4_head(method: u8, packed: usize, size: usize, check: u64) -> List<u8> {
    var out = bytes_of("LZ4Block")
    out.push(method)
    bytes.put_u32_le(mut out, u32.wrap(packed))
    bytes.put_u32_le(mut out, u32.wrap(size))
    bytes.put_u32_le(mut out, u32.wrap(check & 0xFFFFFFF))
    return out
}

/// An LZ4Block stream, as LZ4BlockOutputStream writes one: blocks that don't get smaller are
/// stored, and an empty block ends it.
fn lz4(data: List<u8>, block: usize, store: bool) -> List<u8> {
    var bits = 0usize
    while (1usize << bits) <= block {
        bits += 1
    }
    let level = u8.wrap(bits - 1 - 10)
    var out: List<u8> = []
    var k = 0usize
    while k < data.len() {
        let end = if k + block < data.len() { k + block } else { data.len() }
        let part = data[k..end]
        let packed = lz4_block(part)
        let check = xxh32(part, 0x9747B28C)
        if store or packed.len() >= part.len() {
            out.extend(lz4_head(0x10 | level, part.len(), part.len(), check))
            out.extend(part)
        } else {
            out.extend(lz4_head(0x20 | level, packed.len(), part.len(), check))
            out.extend(packed)
        }
        k += block
    }
    out.extend(lz4_head(0x10 | level, 0, 0, 0))
    return out
}

/// An LZ4Block stream of `count` bytes of noise, its blocks stored, as parts: the noise from the
/// runner's generator, the blocks' headers here.
fn lz4_noise(noise: mut Noise, count: usize) -> List<Json> {
    var parts: List<Json> = []
    var k = 0usize
    while k < count {
        let size: usize = if 65536 < count - k { 65536 } else { count - k }
        let (data, data_parts) = noise.make(size)
        parts.push(hex_part(lz4_head(0x10 | 6, size, size, xxh32(data, 0x9747B28C))))
        parts.extend(data_parts)
        k += 65536
    }
    var end = bytes_of("LZ4Block")
    end.push(0x16)
    for _ in 0..12 {
        end.push(0)
    }
    parts.push(hex_part(end))
    return parts
}

fn utf(text_bytes: List<u8>) -> List<u8> {
    var out: List<u8> = []
    bytes.put_u16_be(mut out, u16.wrap(text_bytes.len()))
    out.extend(text_bytes.copy())
    return out
}

fn op(name: str, args: List<usize>) -> Json {
    var out: List<Json> = [s(String(name))]
    for a in args {
        out.push(n(i64.wrap(a)))
    }
    return arr(out)
}

fn region_case(name: str, ops: own List<Json>, blobs: own List<Json>) -> Json {
    return case_with(String(name), obj([(String("ops"), arr(ops))]), blobs)
}

fn with_byte(first: u8, rest: List<u8>) -> List<u8> {
    var out: List<u8> = [first]
    out.extend(rest.copy())
    return out
}

/// Chunks written into the first free sectors that fit, grown past the end, moved into what others
/// left, cleared, and read again after the file is opened again.
fn layout(noise: mut Noise) -> Json {
    let first = stored_chunk(mut noise, 3000)
    let second = stored_chunk(mut noise, 10000)
    let words = b64(with_byte(DEFLATE, zlib_stream(text(20000, 0), 6)))
    let fourth = stored_chunk(mut noise, 14000)
    let fifth = stored_chunk(mut noise, 5000)
    let sixth = stored_chunk(mut noise, 100)
    // Exactly a sector, with its 4 bytes of length.
    let sector = stored_chunk(mut noise, SECTOR - 5)
    let blobs: List<Json> = [first, second, words, fourth, fifth, sixth, sector]
    let ops: List<Json> = [
        op("open", []),
        op("write", [0, 0, 0]), op("write", [1, 0, 1]), op("write", [31, 31, 2]),
        op("has", [0, 0]), op("has", [5, 5]),
        op("read", [0, 0]), op("read", [1, 0]), op("read", [31, 31]),
        op("write", [1, 0, 3]), op("write", [0, 0, 4]), op("clear", [31, 31]), op("clear", [9, 9]),
        op("read", [31, 31]), op("has", [31, 31]),
        op("close", []),
        op("open", []),
        op("read", [1, 0]), op("read", [0, 0]),
        op("write", [2, 0, 5]), op("write", [31, 0, 0]), op("write", [7, 7, 6]), op("write", [7, 7, 6]),
        op("read", [7, 7]),
        op("close", []),
    ]
    return region_case("layout", ops, blobs)
}

/// A chunk of 256 sectors or more goes in its own file, replaced when it's written again and
/// removed when it fits again. One of 255 stays in the region file.
fn external(noise: mut Noise) -> Json {
    let big = zlib_noise_chunk(mut noise, 256 * SECTOR - 4 + 1000)
    let bigger = zlib_noise_chunk(mut noise, 300 * SECTOR)
    // With their 4 bytes of length, 255 sectors exactly, and a byte more.
    let exactly = zlib_noise_chunk(mut noise, 255 * SECTOR - 4)
    let edge = zlib_noise_chunk(mut noise, 255 * SECTOR - 3)
    let blobs: List<Json> = [big, b64(with_byte(DEFLATE, zlib_stream(text(3000, 0), 6))), bigger, exactly, edge]
    let ops: List<Json> = [
        op("open", []),
        op("write", [3, 4, 0]), op("read", [3, 4]), op("close", []),
        op("open", []), op("read", [3, 4]), op("has", [3, 4]),
        op("write", [3, 4, 2]), op("read", [3, 4]), op("close", []),
        op("open", []), op("write", [3, 4, 1]), op("read", [3, 4]), op("close", []),
        op("open", []), op("write", [5, 5, 3]), op("read", [5, 5]), op("write", [6, 6, 4]), op("read", [6, 6]),
        op("clear", [6, 6]), op("read", [6, 6]), op("close", []),
    ]
    return region_case("external", ops, blobs)
}

/// Each compression vanilla reads, made as Java makes it, and edges of each format.
fn compressions(noise: mut Noise) -> Json {
    let words = text(150000, 3)
    let small = text(5000, 1)
    let two_members = cat([gzip_stream(small[0..2000]), gzip_stream(small[2000..small.len()])])
    let streams = [
        with_byte(GZIP, gzip_stream(small)),
        with_byte(GZIP, gzip_stream(small, 1)),
        with_byte(GZIP, gzip_stream([])),
        with_byte(GZIP, two_members),
        with_byte(DEFLATE, zlib_stream(small, 1)),
        with_byte(DEFLATE, zlib_stream(small, 6)),
        with_byte(DEFLATE, zlib_stream(words, 9)),
        with_byte(DEFLATE, zlib_stream([], 6)),
        // What follows a zlib stream's end isn't read.
        with_byte(DEFLATE, cat([zlib_stream(small, 6), bytes_of("after the end")])),
        [STORED],
        with_byte(STORED, small),
        with_byte(LZ4, lz4(small, 65536, false)),
        with_byte(LZ4, lz4(words[0..70000], 65536, false)),
        with_byte(LZ4, lz4(small, 65536, true)),
        with_byte(LZ4, lz4([], 65536, false)),
        // Blocks of 1 KiB, as a stream from another block size, and what follows its end.
        with_byte(LZ4, cat([lz4(words[0..5000], 1024, false), bytes_of("after")])),
    ]
    var blobs: List<Json> = []
    for stream in streams {
        blobs.push(b64(stream))
    }
    // Noise in two blocks that are stored, as LZ4BlockOutputStream stores what doesn't shrink.
    var noisy: List<Json> = [hex_part([LZ4])]
    noisy.extend(lz4_noise(mut noise, 70000))
    blobs.push(arr(noisy))
    var ops: List<Json> = [op("open", [])]
    for i in 0..blobs.len() {
        ops.push(op("write", [i, 0, i]))
    }
    for i in 0..blobs.len() {
        ops.push(op("read", [i, 0]))
    }
    ops.push(op("close", []))
    return region_case("compressions", ops, blobs)
}

/// Streams vanilla's readers refuse, chunks of custom and unknown compressions, and chunks that
/// say their bytes are in a file of their own.
fn broken() -> Json {
    let small = text(5000, 2)
    let z = zlib_stream(small, 6)
    let g = gzip_stream(small)
    let l4 = lz4(small, 65536, false)
    var bad_adler = z.copy()
    let last = bad_adler.len() - 1
    bad_adler[last] ^= 1
    var bad_crc = g.copy()
    let crc_at = bad_crc.len() - 5
    bad_crc[crc_at] ^= 1
    var bad_check = l4.copy()
    bad_check[17] ^= 1
    let zstd = utf(bytes_of("minecraft:zstd"))
    let streams = [
        with_byte(DEFLATE, z[0..z.len() / 2]),
        with_byte(DEFLATE, bad_adler),
        with_byte(DEFLATE, cat([[0x78, 0x00], z[2..z.len()]])),
        // A zlib header that asks for a preset dictionary.
        with_byte(DEFLATE, cat([[0x78, 0xBB, 0x00, 0x00, 0x00, 0x01], z[2..z.len()]])),
        with_byte(DEFLATE, [0x78, 0x9C, 0xFF, 0xFF, 0xFF]),
        with_byte(GZIP, cat([[0x1F, 0x8C], g[2..g.len()]])),
        with_byte(GZIP, g[0..g.len() / 2]),
        with_byte(GZIP, bad_crc),
        with_byte(GZIP, g[0..5]),
        with_byte(LZ4, l4[0..l4.len() / 2]),
        with_byte(LZ4, bad_check),
        with_byte(LZ4, cat([bytes_of("LZ4Blocc"), l4[8..l4.len()]])),
        with_byte(LZ4, l4[0..l4.len() - 21]),
        with_byte(CUSTOM, cat([zstd.copy(), bytes_of("data")])),
        with_byte(CUSTOM, utf(bytes_of("zstd"))),
        with_byte(CUSTOM, utf(bytes_of("Bad Name"))),
        with_byte(CUSTOM, utf(bytes_of("a:b:c"))),
        with_byte(CUSTOM, utf(bytes_of(":path"))),
        with_byte(CUSTOM, utf([])),
        with_byte(CUSTOM, utf([0xC0, 0x80])),
        with_byte(CUSTOM, utf([0xFF, 0xFE])),
        [CUSTOM, 0x00],
        cat([[CUSTOM, 0x00, 0x0A], bytes_of("abc")]),
        with_byte(0, small),
        with_byte(5, small),
        with_byte(126, small),
        // External, with bytes inside too, and with no file of its own yet.
        with_byte(DEFLATE | 128, z),
        [5 | 128],
        [DEFLATE | 128],
        [CUSTOM | 128],
    ]
    let count = streams.len()
    var blobs: List<Json> = []
    for stream in streams {
        blobs.push(b64(stream))
    }
    let ext = count - 4
    blobs.push(b64(z))
    blobs.push(b64(zstd))
    var ops: List<Json> = [op("open", [])]
    for i in 0..count {
        ops.push(op("write", [i, 1, i]))
    }
    for i in 0..count {
        ops.push(op("read", [i, 1]))
    }
    // Their files come after the writes, which remove a chunk's file when it fits inside.
    ops.extend([
        op("put_external", [ext, 1, count]),
        op("put_external", [ext + 1, 1, count]),
        op("put_external", [ext + 2, 1, count]),
        op("put_external", [ext + 3, 1, count + 1]),
        op("read", [ext, 1]), op("read", [ext + 1, 1]), op("read", [ext + 2, 1]), op("read", [ext + 3, 1]),
        op("close", []),
    ])
    return region_case("broken", ops, blobs)
}

/// `data` written over `out` from `at`, which grows to hold it, as a bytearray's slice is
/// assigned.
fn put_at(out: mut List<u8>, at: usize, data: List<u8>) {
    for (k, v) in data.enumerate() {
        if at + k < out.len() {
            out[at + k] = v
        } else {
            out.push(v)
        }
    }
}

fn u32_be(v: u32) -> List<u8> {
    var out: List<u8> = []
    bytes.put_u32_be(mut out, v)
    return out
}

/// A region file of `size` bytes, its offsets as given by chunk index, its times all 1.
fn header(offsets: List<(usize, u32, u32)>, size: usize) -> List<u8> {
    var out: List<u8> = []
    for _ in 0..size {
        out.push(0)
    }
    for (i, sector, count) in offsets {
        if i * 4 + 4 > out.len() {
            panic("an offset past the file")
        }
        put_at(mut out, i * 4, u32_be((sector << 8) | count))
        if 4096 + i * 4 + 4 <= out.len() {
            put_at(mut out, 4096 + i * 4, u32_be(1))
        }
    }
    return out
}

/// Headers whose places can't be right, which vanilla drops as it opens them, and chunks whose
/// own headers are wrong, which it logs as it reads them.
fn damaged(noise: mut Noise) -> Json {
    let small = text(3000, 5)
    let z = with_byte(DEFLATE, zlib_stream(small, 6))
    // 0 and 1 overlap the header, 2 has no sectors and 3 is past the end, so all four are dropped.
    // 4 is a good chunk. 5 is allocated, with no stream. 6 says it's longer than its sector, and 7
    // that its length is negative. 8 is in a sector nothing was written to. 10 is at 7 and 8, and
    // 9 and 11 at 8, which the file ends 3 bytes into.
    var f = header([(0, 1, 1), (1, 0, 1), (2, 5, 0), (3, 9, 1), (4, 2, 1), (5, 3, 1), (6, 4, 1), (7, 5, 2), (8, 6, 1), (9, 8, 1), (10, 7, 2), (11, 8, 1)], 8 * SECTOR + 3)
    put_at(mut f, 2 * SECTOR, u32_be(u32.wrap(z.len())))
    put_at(mut f, 2 * SECTOR + 4, z)
    put_at(mut f, 4 * SECTOR, cat([u32_be(5000), [DEFLATE]]))
    put_at(mut f, 5 * SECTOR, cat([u32_be(u32.wrap(-5i64)), [DEFLATE]]))
    put_at(mut f, 7 * SECTOR, cat([u32_be(4), [STORED]]))
    put_at(mut f, 7 * SECTOR + 5, bytes_of("abc"))
    // A chunk at sector 3 of a file 3 sectors long: in bounds, as vanilla checks, with no bytes.
    var at_end = header([(0, 2, 1), (1, 3, 1)], 3 * SECTOR)
    put_at(mut at_end, 2 * SECTOR, u32_be(u32.wrap(z.len())))
    put_at(mut at_end, 2 * SECTOR + 4, z)
    let blobs: List<Json> = [
        b64(f),
        b64(header([(0, 2, 1), (1, 0, 0)], 8)),
        b64(header([(0, 2, 1)], 5000)),
        b64([]),
        stored_chunk(mut noise, 6000),
        b64(at_end),
    ]
    var ops: List<Json> = [op("put", [0]), op("open", [])]
    for i in 0usize..12 {
        ops.push(op("has", [i, 0]))
    }
    for i in 0usize..12 {
        ops.push(op("read", [i, 0]))
    }
    ops.extend([
        // Each write goes in the first free sectors, among those of the chunks dropped and moved,
        // and the last over 9's and 11's, which 10's move freed.
        op("write", [4, 0, 4]), op("write", [10, 0, 4]), op("write", [20, 0, 4]),
        op("read", [9, 0]), op("read", [20, 0]),
        op("close", []),
        op("put", [1]), op("open", []), op("has", [0, 0]), op("close", []),
        op("put", [2]), op("open", []), op("has", [0, 0]), op("write", [0, 0, 4]), op("close", []),
        op("put", [3]), op("open", []), op("read", [0, 0]), op("close", []),
        op("put", [3]), op("open", []), op("write", [1, 1, 4]), op("close", []),
        op("put", [5]), op("open", []), op("read", [0, 0]), op("read", [1, 0]), op("write", [2, 2, 4]), op("read", [1, 0]), op("close", []),
    ])
    return region_case("damaged", ops, blobs)
}

pub fn main() {
    var noise = Noise { seed: SEED }
    let made: List<Json> = [layout(mut noise), external(mut noise), compressions(mut noise), broken(), damaged(mut noise)]
    write_file(file("region", "generated.json"), String("region"), "cases/region/gen.calx, seed {SEED}", made, 1)
}
