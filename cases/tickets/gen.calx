module cases.tickets.gen

// Writes cases/tickets/generated.json: random operations on a dimension's chunk tickets, and saved
// `chunk_tickets` read, both those vanilla writes and broken ones.
//
//     calx cases/tickets/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the same
// file.
//
// The `random` cases add and take out tickets of every type at a pool of chunks, few or many, so
// the table grows, shrinks and has keys taken out of it as stale tickets run out, which is where
// vanilla's loop goes out of the table's order. The `stale` cases add mostly tickets that run out,
// then purge them, many at a time, with some chunks' holders busy. The `saved` cases read
// `chunk_tickets` as vanilla saves it, then activate and run the tickets, and the `broken` cases
// read files with each field wrong in each way.

import std.json.{Json}
import cases.kit.{arr, b, case, file, n, obj, s, strs}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}

const SEED: u64 = 20261031
const TYPES: [str; 9] = ["player_spawn", "spawn_search", "dragon", "player_loading", "player_simulation", "forced", "portal", "ender_pearl", "unknown"]
const TIMED: [str; 5] = ["player_spawn", "spawn_search", "portal", "ender_pearl", "unknown"]

/// A chunk's position as one long, as `ChunkPos.asLong` packs it, as a string.
fn pack(c: (i64, i64)) -> String {
    return "{i64.wrap((u64.wrap(c.0) & 0xFFFFFFFF) | ((u64.wrap(c.1) & 0xFFFFFFFF) << 32))}"
}

struct Rng {
    r: SplitMix64
}

impl Rng {
    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    fn chance(mut self, p: f64) -> bool {
        return self.below(1i64 << 20) < i64.saturate(p * 1048576.0)
    }

    fn pick(mut self, items: List<i64>) -> i64 {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    fn name(mut self, items: List<str>) -> str {
        return items[usize.wrap(self.below(i64.wrap(items.len())))]
    }

    fn chunk(mut self, chunks: List<(i64, i64)>) -> (i64, i64) {
        return chunks[usize.wrap(self.below(i64.wrap(chunks.len())))]
    }
}

fn types() -> List<str> {
    var out: List<str> = []
    for t in TYPES {
        out.push(t)
    }
    return out
}

fn timed() -> List<str> {
    var out: List<str> = []
    for t in TIMED {
        out.push(t)
    }
    return out
}

/// `size` chunks: near the origin, in a far corner, or spread over the world.
fn pool(rng: mut Rng, size: i64) -> List<(i64, i64)> {
    let style = rng.below(3)
    var out: List<(i64, i64)> = []
    while i64.wrap(out.len()) < size {
        var x = 0i64
        var z = 0i64
        if style == 0 {
            x = rng.below(21) - 10
            z = rng.below(21) - 10
        } else if style == 1 {
            x = 1874999 - rng.below(30)
            z = -1874999 + rng.below(30)
        } else {
            x = rng.below(3749999) - 1874999
            z = rng.below(3749999) - 1874999
        }
        if not out.any(|c| c.0 == x and c.1 == z) {
            out.push((x, z))
        }
    }
    return out
}

fn level(rng: mut Rng) -> i64 {
    let roll = rng.below(100)
    if roll < 80 {
        return 22 + rng.below(23)
    }
    if roll < 90 {
        return 45 + rng.below(6)
    }
    // Never below 0: the codec won't save one, and vanilla never makes one.
    return rng.below(22)
}

fn act(name: str) -> Json {
    return arr([s(String(name))])
}

/// The chunks a chance of `p` picks, each drawn in order, packed.
fn busy(rng: mut Rng, chunks: List<(i64, i64)>, p: f64) -> Json {
    var out: List<String> = []
    for c in chunks {
        if rng.chance(p) {
            out.push(pack(c))
        }
    }
    return strs(out)
}

fn ops_for(rng: mut Rng, chunks: List<(i64, i64)>, count: i64, timed_bias: f64) -> List<Json> {
    var ops: List<Json> = []
    for _ in 0..count {
        let at = rng.chunk(chunks)
        let c = pack(at)
        let kind = if rng.chance(timed_bias) { rng.name(timed()) } else { rng.name(types()) }
        let roll = rng.below(1000)
        if roll < 380 {
            ops.push(arr([s("add"), s(c), s(String(kind)), n(level(mut rng))]))
        } else if roll < 530 {
            ops.push(arr([s("remove"), s(c), s(String(kind)), n(level(mut rng))]))
        } else if roll < 570 {
            ops.push(arr([s("add_radius"), s(String(kind)), n(at.0), n(at.1), n(rng.below(12) - 1)]))
        } else if roll < 590 {
            ops.push(arr([s("remove_radius"), s(String(kind)), n(at.0), n(at.1), n(rng.below(12) - 1)]))
        } else if roll < 640 {
            ops.push(arr([s("forced"), n(at.0), n(at.1), b(rng.chance(0.6))]))
        } else if roll < 655 {
            let l = level(mut rng)
            ops.push(arr([s("replace_level"), n(l), s(String(kind))]))
        } else if roll < 840 {
            ops.push(arr([s("purge"), busy(mut rng, chunks, 0.25)]))
        } else if roll < 880 {
            ops.push(arr([s("level"), s(c), b(rng.chance(0.5))]))
        } else if roll < 900 {
            ops.push(arr([s("debug"), s(c), b(rng.chance(0.5))]))
        } else if roll < 960 {
            ops.push(act("dump"))
        } else if roll < 975 {
            ops.push(act("save"))
        } else {
            ops.push(act("deactivate"))
            if rng.chance(0.5) {
                ops.push(act("dump"))
            }
            ops.push(act("save"))
            ops.push(act("activate"))
        }
    }
    ops.push(act("dump"))
    ops.push(act("save"))
    return ops
}

fn snbt_ticket(c: (i64, i64), kind: str, l: i64, left: i64) -> String {
    var fields: List<String> = ["chunk_pos:[I;{c.0},{c.1}]", "type:\"minecraft:{kind}\"", "level:{l}"]
    if left != 0 {
        fields.push("ticks_left:{left}L")
    }
    return "\{{fields.join(",")}\}"
}

fn saved(rng: mut Rng, chunks: List<(i64, i64)>, count: i64) -> String {
    var tickets: List<String> = []
    for _ in 0..count {
        let c = rng.chunk(chunks)
        let kind = if rng.chance(0.8) { rng.name(["forced", "portal"]) } else { rng.name(types()) }
        var left = if kind == "portal" { rng.below(301) } else { 0 }
        if rng.chance(0.05) {
            left = rng.pick([-1, -5, 1i64 << 40, i64.wrap(1u64 << 63)])
        }
        tickets.push(snbt_ticket(c, kind, level(mut rng), left))
    }
    return "\{data:\{tickets:[{tickets.join(",")}]\},DataVersion:5023\}"
}

// Saved files broken in each way: `data` and `tickets` that aren't what they should be, and each
// field of a ticket missing or of each wrong kind, beside tickets that can be read.
const GOOD: str = #"{chunk_pos:[I;1,2],type:"minecraft:portal",level:30,ticks_left:7L}"#

fn broken() -> List<String> {
    return [
        "\{DataVersion:5023\}",
        "\{data:5,DataVersion:5023\}",
        "\{data:[1,2],DataVersion:5023\}",
        "\{data:\{\},DataVersion:5023\}",
        "\{data:\{tickets:5\}\}",
        #"{data:{tickets:"x"}}"#,
        "\{data:\{tickets:\{a:1\}\}\}",
        "\{data:\{tickets:[]\}\}",
        "\{data:\{tickets:[I;1,2]\}\}",
        "\{data:\{tickets:[B;1b]\}\}",
        "\{data:\{tickets:[L;1L,2L]\}\}",
        "\{data:\{tickets:[1,2,{GOOD}]\}\}",
        "\{data:\{tickets:[\"a\",{GOOD}]\}\}",
        "\{data:\{tickets:[\{\}]\}\}",
        "\{data:\{tickets:[\{chunk_pos:[I;1,2]\}]\}\}",
        #"{data:{tickets:[{type:"minecraft:forced",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1],type:"minecraft:forced",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2,3],type:"minecraft:forced",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2,3],type:"minecraft:nope",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2,3,4],type:"minecraft:forced"}]}}"#,
        #"{data:{tickets:[{chunk_pos:[1,2],type:"minecraft:forced",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[1b,2s],type:"minecraft:forced",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[L;1L,2L],type:"minecraft:forced",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[B;1b,2b],type:"minecraft:forced",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:["a",2],type:"minecraft:forced",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:"1,2",type:"minecraft:forced",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:{x:1,z:2},type:"minecraft:forced",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:7,type:"minecraft:forced",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"forced",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:nope",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"Bad:Name",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"a b",level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:5,level:31}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:forced"}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:forced",level:-1}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:forced",level:31b}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:forced",level:31L}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:forced",level:4294967327L}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:forced",level:31.9d}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:forced",level:-0.5f}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:forced",level:"31"}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:forced",level:[31]}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:portal",level:30,ticks_left:5}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:portal",level:30,ticks_left:5.7d}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:portal",level:30,ticks_left:1e30d}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:portal",level:30,ticks_left:"5"}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:portal",level:30,ticks_left:0L}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:portal",level:30,ticks_left:-3L}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:nope",level:-1,ticks_left:"x"}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2,3],type:5,level:"x"}]}}"#,
        #"{data:{tickets:[{chunk_pos:[I;1],type:5,level:"x"}]}}"#,
        #"{data:{tickets:[{type:5},{chunk_pos:[I;1,2,3],type:"minecraft:forced",level:31},5,#{GOOD},{level:-2}]}}"#,
        #"{data:{tickets:[#{GOOD},#{GOOD},{chunk_pos:[I;1,2],type:"minecraft:portal",level:30}]},DataVersion:4000}"#,
        #"{data:{tickets:[{chunk_pos:[I;1,2],type:"minecraft:portal",level:30,extra:1b}],other:5}}"#,
    ]
}

fn ops_case(id: own String, ops: own List<Json>) -> Json {
    return case(id, obj([(String("ops"), arr(ops))]))
}

pub fn main() {
    var rng = Rng { r: splitmix64(SEED) }
    var cases: List<Json> = []
    for i in 0..120 {
        let size = rng.pick([2, 4, 8, 16, 40, 90])
        let chunks = pool(mut rng, size)
        let count = 40 + rng.below(160)
        cases.push(ops_case("random-{i}", ops_for(mut rng, chunks, count, 0.2)))
    }
    var stale_kinds = timed()
    stale_kinds.extend(["forced", "player_loading"])
    for i in 0..60 {
        let size = rng.pick([6, 12, 30, 70])
        let chunks = pool(mut rng, size)
        var ops: List<Json> = []
        for _ in 0..chunks.len() * 2 {
            let c = rng.chunk(chunks)
            let kind = rng.name(stale_kinds)
            ops.push(arr([s("add"), s(pack(c)), s(String(kind)), n(level(mut rng))]))
        }
        ops.push(act("dump"))
        let purges = 8 + rng.below(30)
        for _ in 0..purges {
            ops.push(arr([s("purge"), busy(mut rng, chunks, 0.15)]))
            if rng.chance(0.3) {
                ops.push(act("dump"))
            }
        }
        let count = 20 + rng.below(40)
        ops.extend(ops_for(mut rng, chunks, count, 0.7))
        cases.push(ops_case("stale-{i}", ops))
    }
    for i in 0..40 {
        let size = rng.pick([3, 10, 25, 60])
        let chunks = pool(mut rng, size)
        let tickets = rng.below(i64.wrap(chunks.len()) * 3 + 1)
        var ops: List<Json> = [arr([s("load"), s(saved(mut rng, chunks, tickets))]), act("dump"), act("activate"), act("dump")]
        let count = 10 + rng.below(60)
        ops.extend(ops_for(mut rng, chunks, count, 0.3))
        cases.push(ops_case("saved-{i}", ops))
    }
    for (i, snbt) in broken().enumerate() {
        cases.push(ops_case("broken-{i}", [arr([s("load"), s(snbt.copy())]), act("dump"), act("activate"), act("dump"), act("save")]))
    }
    write_file(file("tickets", "generated.json"), String("tickets"), "cases/tickets/gen.calx, seed {SEED}", cases, 1)
}
