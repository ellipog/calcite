module cases.palette.gen

// Writes cases/palette/generated.json: vanilla's paletted containers grown through every kind of
// palette, sent, saved and loaded, and the bit storage under them.
//
//     calx cases/palette/gen.calx
//
// Deterministic: everything comes from SplitMix64 seeded with SEED, so rerunning it gives the same
// file.
//
// The containers start with the flat world's bottom section and with values set one at a time
// past each size where the palette changes kind, for block states and biomes, over registries from
// 1 value to 26.3's 35,723 block states. Others overwrite one value until most entries are unused,
// so the next resize drops them. The unpack cases give palettes and longs as a region file holds
// them, with random bits above the values in each long, which vanilla keeps for a palette and
// drops when it turns indices into IDs, and data that's missing or the wrong length. The rest are
// random sets over spans of values that grow, with what's sent and saved looked at between them.
// A palette is never empty and its data never indexes past its end, where vanilla doesn't fail
// but Calcite does (std.palette, D163).

import std.json.{Json}
import cases.kit.{arr, case, file, ints, n, obj, s, strs}
import rig.runner.cases.{SplitMix64, splitmix64, write_file}

const SEED: u64 = 20261029
const BLOCK_STATES: i64 = 35723
const BIOMES: i64 = 65
const INT_MAX: i64 = 2147483647

/// How many values a container of `strategy` holds.
fn size_of(strategy: str) -> i64 {
    return if strategy == "block_states" { 4096 } else { 64 }
}

/// Where a palette of each strategy moves to the next kind or size, as a count of entries.
fn steps(strategy: str) -> List<i64> {
    if strategy == "block_states" {
        return [1, 2, 16, 17, 32, 33, 64, 65, 128, 129, 256, 257, 300]
    }
    return [1, 2, 3, 4, 5, 8, 9, 12]
}

fn ceil_log2(count: i64) -> i64 {
    var bits = 0i64
    while (1i64 << bits) < count {
        bits += 1
    }
    return bits
}

struct Gen {
    r: SplitMix64
}

impl Gen {
    fn u64(mut self) -> u64 {
        return self.r.next()
    }

    fn below(mut self, bound: i64) -> i64 {
        return i64.wrap(self.r.next() % u64.wrap(bound))
    }

    /// A seed for the probe's random sets: a draw shifted to 63 bits, as a string.
    fn seed(mut self) -> Json {
        return s("{self.r.next() >> 1}")
    }

    fn belows(mut self, bound: i64, count: i64) -> List<i64> {
        var out: List<i64> = []
        for _ in 0..count {
            out.push(self.below(bound))
        }
        return out
    }
}

/// The longs SimpleBitStorage packs `values` in, with random bits wherever no value is when `g`
/// is given.
fn pack(values: List<i64>, bits: i64, g: mut Gen, garbage: bool) -> Json {
    let per = 64 / bits
    let count = i64.wrap(values.len())
    var longs: List<String> = []
    for c in 0..(count + per - 1) / per {
        var x = 0u64
        var used = 0i64
        for k in 0..per {
            let i = c * per + k
            if i < count {
                x |= u64.wrap(values[usize.wrap(i)]) << u64.wrap(k * bits)
                used = (k + 1) * bits
            }
        }
        if garbage and used < 64 {
            x |= (g.u64() >> u64.wrap(used)) << u64.wrap(used)
        }
        longs.push("{i64.wrap(x)}")
    }
    return strs(longs)
}

fn op(name: str, values: List<i64>) -> Json {
    var parts: List<Json> = [s(String(name))]
    for v in values {
        parts.push(n(v))
    }
    return arr(parts)
}

fn look() -> List<Json> {
    return [op("bits", []), op("write", []), op("pack", [])]
}

/// `ops`, then `look()`.
fn looked(ops: own List<Json>) -> List<Json> {
    var out = ops
    out.extend(look())
    return out
}

fn container(name: own String, strategy: str, registry: i64, value: i64, ops: own List<Json>) -> Json {
    return case(name, obj([(String("of"), s("container")), (String("strategy"), s(String(strategy))), (String("registry"), n(registry)), (String("value"), n(value)), (String("ops"), arr(ops))]))
}

fn flat_section() -> Json {
    var ops: List<Json> = []
    for (y, v) in [88i64, 10, 10, 9].enumerate() {
        for i in 0..256i64 {
            ops.push(op("set", [i64.wrap(y) * 256 + i, v]))
        }
    }
    ops.extend(look())
    ops.extend([op("counts", []), op("repack", [])])
    ops.extend(look())
    return container(String("flat-bottom-section"), "block_states", BLOCK_STATES, 0, ops)
}

/// Index i set to i + 1, so after it the container holds i + 2 values, past each step.
fn growth(strategy: str, registry: i64) -> Json {
    let at = steps(strategy)
    let last = at[at.len() - 1]
    let count = if last < registry - 1 { last } else { registry - 1 }
    var ops: List<Json> = []
    for i in 0..count {
        ops.push(op("set", [i, i + 1]))
        if at.any(|v| v == i + 2) or at.any(|v| v == i + 1) {
            ops.extend(look())
        }
    }
    ops.extend([op("counts", []), op("get", [0]), op("get", [size_of(strategy) - 1]), op("get_and_set", [0, 0]), op("repack", [])])
    ops.extend(look())
    return container("{strategy.replace("_", "-")}-growth-{registry}", strategy, registry, 0, ops)
}

/// One value overwritten again and again: each one leaves an entry nothing refers to, until the
/// palette is full and the resize keeps only what's there.
fn dropped(strategy: str, registry: i64, rounds: i64) -> Json {
    var ops: List<Json> = []
    for v in 1..rounds + 1 {
        ops.push(op("set", [5, v]))
        ops.push(op("bits", []))
    }
    ops.extend(look())
    ops.push(op("counts", []))
    return container("{strategy.replace("_", "-")}-dropped-{rounds}", strategy, registry, 0, ops)
}

fn get_and_set(g: mut Gen) -> Json {
    var ops: List<Json> = []
    for _ in 0..200 {
        let index = g.below(4096)
        let value = g.below(40)
        ops.push(op("get_and_set", [index, value]))
    }
    return container(String("block-states-get-and-set"), "block_states", BLOCK_STATES, 7, looked(ops))
}

fn unpack_of(palette: List<i64>, data: own Json) -> Json {
    return arr([s("unpack"), ints(palette), data])
}

fn zeros(count: i64) -> Json {
    var out: List<String> = []
    for _ in 0..count {
        out.push(String("0"))
    }
    return strs(out)
}

fn range_of(from: i64, until: i64) -> List<i64> {
    var out: List<i64> = []
    for v in from..until {
        out.push(v)
    }
    return out
}

fn unpack_case(cases: mut List<Json>, name: String, strategy: str, registry: i64, ops: own List<Json>) {
    cases.push(container("unpack-{name}", strategy, registry, 0, ops))
}

fn unpacks(g: mut Gen) -> List<Json> {
    var cases: List<Json> = []
    let b = "block_states"
    let total = 4096i64
    var single = looked([unpack_of([5], Json.Null)])
    single.push(op("set", [0, 6]))
    unpack_case(mut cases, "single", b, BLOCK_STATES, looked(single))
    unpack_case(mut cases, "single-with-data", b, BLOCK_STATES, looked([unpack_of([5], strs([String("1"), String("2")]))]))
    unpack_case(mut cases, "missing-data", b, BLOCK_STATES, looked([op("set", [0, 3]), unpack_of([1, 2], Json.Null)]))
    unpack_case(mut cases, "short-data", b, BLOCK_STATES, looked([unpack_of([1, 2], zeros(3))]))
    unpack_case(mut cases, "long-data", b, BLOCK_STATES, looked([unpack_of([1, 2, 3], zeros(257))]))
    let linear = g.belows(3, total)
    var linear_ops = looked([unpack_of([40, 41, 42], pack(linear, 4, mut g, true))])
    linear_ops.extend([op("get", [9]), op("set", [0, 43]), op("set", [1, 41])])
    linear_ops = looked(linear_ops)
    linear_ops.push(op("counts", []))
    unpack_case(mut cases, "linear", b, BLOCK_STATES, linear_ops)
    var unused: List<i64> = []
    for _ in 0..total {
        unused.push(g.below(2) * 3)
    }
    var unused_ops = looked([unpack_of([40, 41, 42, 43, 44], pack(unused, 4, mut g, true))])
    unused_ops.push(op("counts", []))
    unpack_case(mut cases, "linear-unused", b, BLOCK_STATES, unused_ops)
    let duplicates = g.belows(3, total)
    unpack_case(mut cases, "linear-duplicates", b, BLOCK_STATES, looked([unpack_of([7, 7, 8], pack(duplicates, 4, mut g, true)), op("set", [0, 7]), op("get", [1])]))
    let full = g.belows(16, total)
    unpack_case(mut cases, "linear-full", b, BLOCK_STATES, looked([unpack_of(range_of(100, 116), pack(full, 4, mut g, true)), op("set", [3, 116])]))
    for count in [17i64, 33, 100, 256] {
        let bits = ceil_log2(count)
        let values = g.belows(count, total)
        var palette: List<i64> = []
        for state in g.belows(BLOCK_STATES, count) {
            if not palette.any(|p| p == state) {
                palette.push(state)
            }
        }
        while i64.wrap(palette.len()) < count {
            palette.push(i64.wrap(palette.len()) + 1000)
        }
        let data = pack(values, bits, mut g, true)
        var ops = looked([unpack_of(palette, data)])
        ops.push(arr([s("random_sets"), g.seed(), n(50), n(0), n(300)]))
        ops = looked(ops)
        ops.push(op("counts", []))
        unpack_case(mut cases, "hash-{count}", b, BLOCK_STATES, ops)
    }
    for count in [257i64, 300, 1000, 4096] {
        let bits = ceil_log2(count)
        let values = g.belows(count, total)
        var drawn = g.belows(BLOCK_STATES, count * 2)
        drawn.sort()
        var palette: List<i64> = []
        for state in drawn {
            if i64.wrap(palette.len()) < count and (palette.len() == 0 or palette[palette.len() - 1] != state) {
                palette.push(state)
            }
        }
        var ops = looked([unpack_of(palette, pack(values, bits, mut g, true))])
        ops.extend([op("counts", []), op("get_and_set", [17, 3])])
        unpack_case(mut cases, "global-{count}", b, BLOCK_STATES, looked(ops))
    }
    unpack_case(mut cases, "global-short-data", b, BLOCK_STATES, looked([unpack_of(range_of(0, 300), zeros(10))]))
    for (count, bits) in [(2i64, 1i64), (3, 2), (4, 2), (5, 3), (8, 3)] {
        let values = g.belows(count, 64)
        var ops = looked([unpack_of(range_of(20, 20 + count), pack(values, bits, mut g, true))])
        ops.push(op("set", [0, 60]))
        unpack_case(mut cases, "biomes-{count}", "biomes", BIOMES, looked(ops))
    }
    for count in [9i64, 20, 64] {
        let values = g.belows(count, 64)
        var ops = looked([unpack_of(range_of(0, count), pack(values, ceil_log2(count), mut g, true))])
        ops.push(op("counts", []))
        unpack_case(mut cases, "biomes-global-{count}", "biomes", BIOMES, ops)
    }
    unpack_case(mut cases, "biomes-short-data", "biomes", BIOMES, looked([unpack_of([1, 2], arr([]))]))
    return cases
}

fn spans(strategy: str) -> List<i64> {
    if strategy == "block_states" {
        return [4, 16, 17, 40, 256, 300, 3000]
    }
    return [2, 3, 8, 9, 40]
}

fn randoms(g: mut Gen) -> List<Json> {
    var cases: List<Json> = []
    let table: List<(str, List<i64>)> = [("block_states", [BLOCK_STATES, 300, 70000, 1i64 << 20]), ("biomes", [BIOMES, 9, 17, 300])]
    for (strategy, registries) in table {
        let size = size_of(strategy)
        for registry in registries {
            for k in 0..3 {
                var ops: List<Json> = []
                let low = g.below(if registry - 3000 > 1 { registry - 3000 } else { 1 })
                for span in spans(strategy) {
                    let high = if registry < low + span { registry } else { low + span }
                    let seed = g.seed()
                    let count = g.below(size * 2) + 1
                    ops.push(arr([s("random_sets"), seed, n(count), n(low), n(high)]))
                    ops.extend(look())
                    if g.below(2) != 0 {
                        ops.extend([op("counts", []), op("repack", []), op("write", [])])
                    }
                    ops.push(op("get", [g.below(size)]))
                }
                let value = g.below(registry)
                cases.push(container("{strategy.replace("_", "-")}-random-{registry}-{k}", strategy, registry, value, ops))
            }
        }
    }
    return cases
}

fn storages(g: mut Gen) -> List<Json> {
    var cases: List<Json> = []
    for bits in 1..33i64 {
        let top = if bits < 31 { (1i64 << bits) - 1 } else { INT_MAX }
        // Containers use up to 4,096 values of up to 20 bits, and heightmaps 256 of 9.
        var sizes: List<i64> = if bits == 1 or bits == 5 or bits == 9 or bits == 32 { [0, 1, 64, 256] } else { [256] }
        if bits <= 16 {
            sizes.push(4096)
        }
        for size in sizes {
            var ops: List<Json> = [op("longs", [])]
            if size != 0 {
                let seed = g.seed()
                let bound = if top < INT_MAX { top + 1 } else { top }
                ops.push(arr([s("random_sets"), seed, n(size), n(0), n(bound)]))
                ops.extend([op("values", []), op("longs", [])])
                ops.push(op("get", [g.below(size)]))
                ops.push(op("get_and_set", [size - 1, g.below(top + 1)]))
                ops.push(op("get", [size - 1]))
            }
            ops.push(op("fill", [g.below(top + 1)]))
            ops.extend([op("longs", []), op("fill", [top]), op("longs", []), op("values", [])])
            if size <= 256 {
                let per = 64 / bits
                let need = (size + per - 1) / per
                var more: List<String> = []
                for _ in 0..need + 1 {
                    more.push("{i64.wrap(g.u64())}")
                }
                var exact: List<String> = []
                for _ in 0..need {
                    exact.push("{i64.wrap(g.u64())}")
                }
                ops.extend([arr([s("load"), strs(more)]), op("longs", []), arr([s("load"), strs(exact)]), op("longs", []), op("values", [])])
            }
            cases.push(case("storage-{bits}-{size}", obj([(String("of"), s("storage")), (String("bits"), n(bits)), (String("size"), n(size)), (String("ops"), arr(ops))])))
        }
    }
    return cases
}

pub fn main() {
    var g = Gen { r: splitmix64(SEED) }
    var cases: List<Json> = [flat_section()]
    let growths: List<(str, List<i64>)> = [("block_states", [BLOCK_STATES, 1, 2, 17, 300]), ("biomes", [BIOMES, 1, 2, 4, 5, 8, 9, 16, 17])]
    for (strategy, registries) in growths {
        for registry in registries {
            cases.push(growth(strategy, registry))
        }
    }
    cases.extend([dropped("block_states", BLOCK_STATES, 40), dropped("biomes", BIOMES, 12), get_and_set(mut g)])
    cases.extend(unpacks(mut g))
    cases.extend(randoms(mut g))
    cases.extend(storages(mut g))
    write_file(file("palette", "generated.json"), String("palette"), "cases/palette/gen.calx, seed {SEED}", cases, 1)
}
