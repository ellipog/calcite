module bench.packs

// The worldgen benchmark's datapacks and seed, C2ME's, which bench/terralith.py runs with and
// rig/runner/terragen.calx checks Calcite's worldgen against vanilla's with (CAL-92, CAL-253). The
// packs are Stardust Labs', so they aren't committed: they're fetched from Modrinth into
// build/bench/packs/ and checked against their SHA-512s.

import std.bytes.{hex}
import std.fs.{is_file, make_dir_all, read, write}
import std.hash.{sha512}
import std.http.{Header, get}
import std.path
import tools.repo.{die, under}

/// The seed C2ME's benchmark generates from.
pub const SEED: str = "114862964781274189"

/// A pack C2ME's benchmark names, at the version made for 26.3.
pub struct Pin {
    pub name: str
    pub version: str
    pub file: str
    pub url: str
    pub sha512: str
}

/// The packs, Terralith and Terratonic.
pub fn pins() -> List<Pin> {
    return [
        Pin {
            name: "Terralith",
            version: "2.6.5+26.3",
            file: "Terralith_v2.6.5+26.3.zip",
            url: "https://cdn.modrinth.com/data/8oi3bsk5/versions/fqnsIp6d/Terralith_v2.6.5%2B26.3.zip",
            sha512: "edc75fb0be5d009590d16d0d96ef73fc2e87c3edd3c5b4d80589070a636beeaf4ea202ee3cffaa06ad68a615bbb03e924cd3e173cbd649fb47b5ec6fc74c2482",
        },
        Pin {
            name: "Terratonic",
            version: "3.0.31",
            file: "terratonic-datapack-3.0.31.zip",
            url: "https://cdn.modrinth.com/data/3L2L6sWL/versions/RUBbKGx8/terratonic-datapack-3.0.31.zip",
            sha512: "82deeee38afead548bc86cc6eed5d536b164194c442abbc4f0e21092a234430484e57989fdd7750e13c3bcc47b87f7365859b899a210f97b6fe55213e6fd6912",
        },
    ]
}

/// Where the fetched packs are kept.
pub fn packs_dir() -> String {
    return under("build/bench/packs")
}

/// Whether the file holds the bytes the pin names.
fn matches(file: String, pin: Pin) -> bool {
    if not is_file(file.copy()) {
        return false
    }
    let data = match read(file) {
        ok(d) => d,
        err(_) => return false,
    }
    return hex(sha512(data)) == pin.sha512
}

/// The packs' paths, each fetched where it's missing or isn't the pin's, and checked against its
/// SHA-512.
pub fn fetch() -> List<String> {
    match make_dir_all(packs_dir()) {
        ok => {},
        err(e) => die("terralith: {packs_dir()}: {e}"),
    }
    var paths: List<String> = []
    for pin in pins() {
        let file = path.join(packs_dir(), pin.file)
        if not matches(file.copy(), pin) {
            println("terralith: fetching {pin.name} {pin.version}")
            let agent = Header { name: "User-Agent", value: "calcite-bench (github.com/ellipog/calcite)" }
            var r = get(String(pin.url), [agent], 120000, 268435456)
            let resp = match r.wait() {
                ok(x) => x,
                err(e) => die("terralith: fetching {pin.file}: {e}"),
            }
            if resp.status != 200 {
                die("terralith: fetching {pin.file}: HTTP {resp.status}")
            }
            if hex(sha512(resp.body.copy())) != pin.sha512 {
                die("terralith: {pin.file} doesn't match its SHA-512")
            }
            match write(file.copy(), resp.body) {
                ok => {},
                err(e) => die("terralith: {file}: {e}"),
            }
        }
        paths.push(file)
    }
    return paths
}
