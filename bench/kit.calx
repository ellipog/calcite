module bench.kit

// What the benchmarks record beside their numbers (D34): the commit, the calx they were built
// with, and the machine. bench/run.py's `commit`, `output` and `machine`, for the benchmarks in
// Calx (CAL-253). The machine has no `python` now, which run.py recorded as the interpreter that
// ran it.

import std.env.{os}
import std.fs.{read_text}
import std.json.{Json}
import std.process.{Command}
import tools.repo.{die, platform}

/// What a command prints, trimmed, or none if it fails.
pub fn output(argv: List<String>, dir: String?) -> String? {
    var command = Command.new(argv[0].copy()).args(argv[1..])
    if let d = dir {
        command = command.dir(d)
    }
    let out = match command.output() {
        ok(o) => o,
        err(_) => return none,
    }
    if out.status.code != some(0) {
        return none
    }
    let text = String.from_utf8(out.stdout) ?? String("")
    return some(text.trim())
}

/// The commit checked out in `dir`, or none where it isn't a checkout.
pub fn commit(dir: String) -> Json {
    if let c = output([String("git"), String("rev-parse"), String("HEAD")], some(dir.copy())) {
        return Json.Str(c)
    }
    return Json.Null
}

/// The calx a benchmark was built with: its version, and the commit of its checkout, which is
/// four folders up from build/compiler/<os>/calx.
pub fn calx_info(calx: String) -> Json {
    var m = LinkedMap<String, Json>()
    m.insert(String("version"), if let v = output([calx.copy(), String("version")], none) { Json.Str(v) } else { Json.Null })
    var tree = calx.replace("\\", "/")
    for _ in 0..4 {
        if let at = tree.find_last("/") {
            tree = tree[..at]
        }
    }
    m.insert(String("commit"), commit(tree))
    return Json.Object(m)
}

fn gib(bytes: f64) -> Json {
    return Json.Float(f64.parse("{bytes / 1073741824.0:.1}") ?? 0.0)
}

/// The machine: the system, the processor, its cores and threads, and the memory.
pub fn machine() -> Json {
    var m = LinkedMap<String, Json>()
    m.insert(String("platform"), Json.Str(platform()))
    if os() == "windows" {
        let ver = output([String("cmd"), String("/c"), String("ver")], none) ?? String("")
        m.insert(String("os"), Json.Str(ver))
        let ps = "$c = Get-CimInstance Win32_Processor; $m = Get-CimInstance Win32_ComputerSystem; \"$($c.Name)|$(($c | Measure-Object NumberOfCores -Sum).Sum)|$(($c | Measure-Object NumberOfLogicalProcessors -Sum).Sum)|$($m.TotalPhysicalMemory)\""
        let got = output([String("powershell"), String("-NoProfile"), String("-Command"), String(ps)], none) ?? die("bench: reading the machine with PowerShell failed")
        let parts = got.split("|")
        if parts.len() != 4 {
            die("bench: PowerShell said {got} of the machine")
        }
        m.insert(String("cpu"), Json.Str(parts[0].trim()))
        m.insert(String("cores"), Json.Int(i64.parse(parts[1].trim()) ?? 0))
        m.insert(String("threads"), Json.Int(i64.parse(parts[2].trim()) ?? 0))
        m.insert(String("memory_gib"), gib(f64.nearest(i64.parse(parts[3].trim()) ?? 0)))
    } else {
        let cpuinfo = file_text("/proc/cpuinfo")
        var name = String("")
        var threads = 0i64
        for line in cpuinfo.lines() {
            if line.starts_with("model name") and name.is_empty() {
                if let at = line.find(":") {
                    name = line[at + 1..].trim()
                }
            }
            if line.starts_with("processor") {
                threads += 1
            }
        }
        var kib = 0i64
        for line in file_text("/proc/meminfo").lines() {
            if line.starts_with("MemTotal") {
                let parts = line.split_whitespace()
                if parts.len() > 1 {
                    kib = i64.parse(parts[1].copy()) ?? 0
                }
            }
        }
        m.insert(String("os"), Json.Str(output([String("uname"), String("-sr")], none) ?? String("")))
        m.insert(String("cpu"), Json.Str(name))
        m.insert(String("threads"), Json.Int(threads))
        m.insert(String("memory_gib"), gib(f64.nearest(kib) * 1024.0))
        m.insert(String("kernel"), Json.Str(output([String("uname"), String("-r")], none) ?? String("")))
    }
    return Json.Object(m)
}

fn file_text(file: str) -> String {
    return match read_text(String(file)) {
        ok(t) => t ?? String(""),
        err(_) => String(""),
    }
}
