module bench.client

// Runs Mojang's own client against Calcite for the numbers of chunks a real client is sent
// (CAL-94): a new world's view-32 join, the server's memory, and a flight at each speed, each on
// a fresh server and world, through rig/runner/realclient.calx --fly. It was bench/client.py
// (CAL-253).
//
//     calx bench/client.calx [--speeds 25,100] [--seconds 30] [--record]
//
// The server is the release build, built with calx into build/bench/<platform>/client/. Each run
// joins at render and view distance 32 on a new world with C2ME's seed, then flies forward at the
// speed for --seconds, and realclient.calx's flight.json is kept: the join's chunks and times, the
// server's memory before the join, with the player still and at the most, its ticks during the
// flight, and how much of the view the client had as it flew. --record writes
// bench/results/client-<platform>.json with the machine, the toolchain and the commit (D34). It
// needs a desktop, a launcher's 26.3 files and Windows for the keys, as realclient.calx does, and
// takes the client's window to the front while it flies.

import std.cli.{cli}
import std.fs.{is_file, make_dir_all, read_text, remove_file, write_text}
import std.io.{flush}
import std.json
import std.json.{Json}
import std.path
import std.process.{Command, Stdio}
import std.time.{Timestamp}
import bench.kit.{calx_info, commit, machine}
import bench.packs.{SEED}
import tools.pyjson
import tools.pyjson.{indented_ascii}
import tools.repo.{die, exe, find_calx, platform, root, under}

fn flight_file() -> String {
    return under("build/rig/realclient/flight.json")
}

fn member(v: Json, key: str) -> Json {
    return v.get(String(key)) ?? Json.Null
}

/// A value as Python's f-string wrote it.
fn shown(v: Json) -> String {
    return match v {
        Json.Null => String("None"),
        _ => pyjson.py_repr(v),
    }
}

@cli(name: "client")
struct Args {
    /// The flying speeds, times vanilla's, comma-separated.
    speeds: String = "25,100"
    /// How long each flight goes forward.
    seconds: i64 = 30
    /// Write bench/results/client-<platform>.json.
    record: bool
}

pub fn main() {
    let args = Args.parse()
    if args.record and (args.speeds != "25,100" or args.seconds != 30) {
        die("client: only 25 and 100 for 30 seconds are recorded")
    }
    let calx = find_calx()
    let build_dir = under("build/bench/{platform()}/client")
    match make_dir_all(build_dir.copy()) {
        ok => {},
        err(e) => die("client: {build_dir}: {e}"),
    }
    let server = path.join(build_dir, "calcite{exe()}")
    match Command.new(calx.copy()).args([String("build"), String("--release"), String("src/calcite.calx"), String("-o"), server.copy()]).dir(root()).run() {
        ok => {},
        err(e) => die("client: building Calcite: {e}"),
    }
    var runs: List<Json> = []
    for speed in args.speeds.split(",") {
        if is_file(flight_file()) {
            match remove_file(flight_file()) {
                ok => {},
                err(e) => die("client: {flight_file()}: {e}"),
            }
        }
        println("client: flying at {speed} times vanilla's")
        flush()
        let got = match Command.new(calx.copy()).args([String("rig/runner/realclient.calx"), String("--server"), server.copy(), String("--fly"), speed.copy(),
            String("--fly-seconds"), "{args.seconds}", String("--seed"), String(SEED)]).dir(root()).stdout(Stdio.Pipe).stderr(Stdio.Pipe).output() {
            ok(o) => o,
            err(e) => die("client: running realclient.calx: {e}"),
        }
        let stdout = String.from_utf8(got.stdout.copy()) ?? String("")
        for line in stdout.lines() {
            for start in ["memory:", "flight:", "watch: flight", "watch: after", "watch: join", "FAIL", "keys:"] {
                if line.starts_with(start) {
                    println("  {line}")
                    break
                }
            }
        }
        flush()
        if got.status.code != some(0) or not is_file(flight_file()) {
            let err_text = String.from_utf8(got.stderr) ?? String("")
            let tail = if stdout.len() > 3000 { stdout[stdout.len() - 3000..] } else { stdout.copy() }
            let err_tail = if err_text.len() > 2000 { err_text[err_text.len() - 2000..] } else { err_text.copy() }
            die("client: the flight at {speed} failed:\n{tail}{err_tail}")
        }
        let text = match read_text(flight_file()) {
            ok(t) => t ?? String(""),
            err(e) => die("client: {flight_file()}: {e}"),
        }
        runs.push(match json.parse(text) {
            ok(v) => v,
            err(e) => die("client: {flight_file()}: {e}"),
        })
    }

    for r in runs {
        let f = member(r.copy(), "flight")
        let m = member(r.copy(), "memory_mib")
        let t = member(r.copy(), "ticks")
        let had = member(f.copy(), "had_of_view")
        println("{shown(member(r.copy(), "speed"))}x: {shown(member(f.copy(), "blocks_a_second"))} blocks a second, {shown(member(f.copy(), "chunks_a_second"))} chunks a second sent, the view {shown(had.at(0) ?? Json.Null)}% there on average and {shown(had.at(1) ?? Json.Null)}% at the least, MSPT {shown(member(t.copy(), "mspt_mean"))} mean, {shown(member(t.copy(), "mspt_max"))} most; memory {shown(member(m.copy(), "idle"))} MiB idle, {shown(member(m.copy(), "joined"))} MiB with the player still, {shown(member(m.copy(), "peak"))} MiB at the most")
    }

    if args.record {
        var result = LinkedMap<String, Json>()
        result.insert(String("recorded"), Json.Str(unsafe { Timestamp.now() }.format("%Y-%m-%dT%H:%M:%SZ", 0)))
        result.insert(String("commit"), commit(root()))
        result.insert(String("calx"), calx_info(calx))
        result.insert(String("machine"), machine())
        result.insert(String("seed"), Json.Str(String(SEED)))
        result.insert(String("view"), Json.Int(32))
        result.insert(String("flight_seconds"), Json.Int(args.seconds))
        result.insert(String("runs"), Json.Array(runs))
        let out = under("bench/results/client-{platform()}.json")
        match write_text(out.copy(), "{indented_ascii(Json.Object(result))}\n") {
            ok => {},
            err(e) => die("client: {out}: {e}"),
        }
        println("\nclient: wrote {out}")
    }
}
