// Sample addon 4 of 5: teleport requests.
// Stresses messages between region instances, and handing a player from one region to another.
// /tpa <player> asks to teleport to someone. They can /tpaccept or /tpdeny, and the request expires.
// The two players are usually in different regions, so every step is a message.
// Imagined Calx syntax from Phase 0. Nothing here compiles yet. ../README.md explains the conventions.

@plugin(id: "tpa", name: "Teleport requests", version: "0.1.0", api: 1)
module tpa

import calcite.{Player, PlayerRef, Task, Text, Permission, Ticks, TeleportError, everyone}

@config
struct Config {
    expire_after: Ticks = Ticks.seconds(60)
}

@permission("tpa.use", default: everyone)
const USE: Permission

// Messages hold plain values only: no views, no closures. A PlayerRef is a handle (D24), so it can go in one.
@message
struct Request {
    from: PlayerRef
}

@message
struct Accepted {
    by: PlayerRef
}

@message
struct Refused {
    by_name: String
    reason: Reason
}

enum Reason {
    Denied
    Expired
}

// Requests waiting for this player's answer, oldest first, each with the task that expires it.
@session(per: Player)
struct Incoming {
    requests: LinkedMap<PlayerRef, Task> = {}
}

region {
    // A PlayerRef argument completes from online players in every region, using the player directory
    // the host snapshots at the start of each tick. Any region can read the directory.
    @command("tpa", permission: USE)
    fn tpa(p: Player, target: PlayerRef) ! Text {
        if target == p.ref() {
            fail t"<red>You can't send a request to yourself."
        }
        if not target.online() {
            fail t"<red>{target.name()} isn't online."
        }
        // Delivered in the message exchange at the end of this tick and handled in target's region next
        // tick. If target logs out first, it's dropped.
        send target Request { from: p.ref() }
        p.send(t"<green>Request sent to <white>{target.name()}</white>.")
    }

    // Messages to a player run in the player's region, with a view of them.
    @receive
    fn request(p: Player, m: Request) {
        let incoming = p.data(Incoming)
        if let old = incoming.requests.remove(m.from) {
            old.cancel()
        }
        let from = m.from
        let expiry = p.after(ticks: config.expire_after) |p| {
            if p.data(Incoming).requests.remove(from) != none {
                send from Refused { by_name: p.name(), reason: Reason.Expired }
            }
        }
        incoming.requests.put(from, expiry)
        let accept = t"<green>[Accept]".on_click(run: "/tpaccept " + from.name())
        let deny = t"<red>[Deny]".on_click(run: "/tpdeny " + from.name())
        p.send(t"<white>{from.name()}</white> <gray>wants to teleport to you. " + accept + t" " + deny)
    }

    // With no name, answers the newest request.
    @command("tpaccept", permission: USE)
    fn tpaccept(p: Player, from: PlayerRef? = none) ! Text {
        let who = take_request(p, from) else fail t"<red>No request to accept."
        send who Accepted { by: p.ref() }
        p.send(t"<green>Accepted. <white>{who.name()}</white> is on the way.")
    }

    @command("tpdeny", permission: USE)
    fn tpdeny(p: Player, from: PlayerRef? = none) ! Text {
        let who = take_request(p, from) else fail t"<red>No request to deny."
        send who Refused { by_name: p.name(), reason: Reason.Denied }
        p.send(t"<gray>Denied.")
    }

    @receive
    fn accepted(p: Player, m: Accepted) {
        // The host works out where m.by is at the tick barrier, so p lands on their position at that
        // moment, not where they were when they accepted. If m.by is in another region or dimension,
        // p is handed over there, chunks loading first. If it can't happen, on_fail runs in p's region.
        p.teleport_to(m.by, on_fail: |p, why| {
            match why {
                TeleportError.TargetOffline => p.send(t"<red>{m.by.name()} logged out."),
                _ => p.send(t"<red>The teleport didn't work."),
            }
        })
        p.send(t"<green>Teleporting to <white>{m.by.name()}</white>.")
    }

    @receive
    fn refused(p: Player, m: Refused) {
        match m.reason {
            Reason.Denied => p.send(t"<red>{m.by_name} denied your request."),
            Reason.Expired => p.send(t"<gray>Your request to {m.by_name} expired."),
        }
    }
}

// Removes a waiting request and cancels its expiry. With no name, takes the newest.
fn take_request(p: Player, from: PlayerRef?) -> PlayerRef? {
    let incoming = p.data(Incoming)
    let who = from ?? incoming.requests.last_key() else return none
    let expiry = incoming.requests.remove(who) else return none
    expiry.cancel()
    return who
}
