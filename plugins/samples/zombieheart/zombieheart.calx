// Sample addon 3 of 5: zombie heart.
// Stresses entity and loot events, and making an item.
// Zombies killed by a player sometimes drop a zombie heart, and eating one heals.
// Imagined Calx syntax from Phase 0. Nothing here compiles yet. ../README.md explains the conventions.

@plugin(id: "zombieheart", name: "Zombie heart", version: "0.1.0", api: 1)
module zombieheart

import calcite.{EntityDeath, ItemConsumed, CustomItem, Component, EntityKind, Item, Enchantment, Particle, Rarity, Sound}

@config
struct Config {
    chance: f64 = 0.05
    looting_bonus: f64 = 0.02     // added per level of Looting
    heal: f32 = 6.0               // health points, so three hearts
}

// A custom item that needs no client mod and no resource pack: a vanilla item with data components.
// The host also puts {"calcite:item": "zombieheart:heart"} in the stack's custom_data, which is how
// is(HEART) recognises it. That's vanilla's own component, so it survives a trip through vanilla (D36).
@item("heart")
const HEART = CustomItem {
    base: Item.red_dye,
    components: [
        Component.item_name(t"<red>Zombie heart"),
        Component.lore([t"<gray>Still beating. Eat it to heal."]),
        Component.rarity(Rarity.uncommon),
        Component.enchantment_glint_override(true),
        Component.max_stack_size(16),
        // These two make the client play the eating animation and sound, with no plugin code.
        Component.consumable(seconds: 1.6, sound: Sound.entity_generic_eat),
        Component.food(nutrition: 2, saturation: 0.4, can_always_eat: true),
    ],
}

region {
    // Fires in the dying entity's region before its drops spawn. e.drops can be changed.
    @on(EntityDeath)
    fn died(e: EntityDeath) {
        if e.entity.kind != EntityKind.zombie {
            return
        }
        // Set when a player hurt the entity in the last 100 ticks, the rule vanilla uses for rare drops.
        // It's a PlayerRef, not a view, because an arrow can kill from another region.
        if e.player_kill == none {
            return
        }
        // So the event carries a snapshot of the weapon instead of making the handler look across regions.
        let looting = e.weapon.map(|w| w.enchantment_level(Enchantment.looting)).or(0)
        let chance = config.chance + config.looting_bonus * f64(looting)
        // This plugin's own random stream in this region. Plugins never draw from vanilla's streams, so
        // installing one doesn't change what vanilla rolls next (D44).
        if region.random().next_f64() >= chance {
            return
        }
        e.drops.push(HEART.stack(count: 1))
    }

    // Fires after the client finishes eating and vanilla applies the food, in the player's region.
    @on(ItemConsumed)
    fn eaten(e: ItemConsumed) {
        if not e.item.is(HEART) {
            return
        }
        let p = e.player
        p.heal(config.heal)
        region.world.particles(Particle.heart, at: p.eye_position(), count: 5, spread: 0.4)
    }
}
