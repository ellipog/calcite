// Sample addon 2 of 5: chat filter.
// Stresses events that can cancel or change what happens, and string handling.
// Imagined Calx syntax from Phase 0. Nothing here compiles yet. ../README.md explains the conventions.

@plugin(id: "chatfilter", name: "Chat filter", version: "0.1.0", api: 1)
module chatfilter

import calcite.{Player, PlayerRef, Sender, PlayerChat, Text, Permission, Instant, Duration, op}
import std.text.{Matcher, MatchOptions}

enum Action {
    Mask      // Hide the matched words. The message still goes out and its signature stays valid
    Block     // Don't send the message
    Strike    // Don't send it, and count a strike. Enough strikes and the player is muted
}

@config
struct Config {
    words: List<String> = []
    action: Action = Action.Mask
    strikes_to_mute: i32 = 3
    mute_for: Duration = Duration.minutes(10)

    // Computed from the fields above each time the config loads, then shared read-only by every region.
    // Regions hold no state of their own, so there's nothing to rebuild when they split or merge (D42).
    @derived
    matcher: Matcher = Matcher.build(words, MatchOptions { ignore_case: true, fold_accents: true, leet: true })
}

@permission("chatfilter.moderate", default: op)
const MODERATE: Permission

// Staff who see what was filtered.
@permission("chatfilter.notify", default: op)
const NOTIFY: Permission

// Saved, so logging out doesn't end a mute.
@save(per: Player)
struct Mute {
    until: Instant? = none
}

// Reset when the player logs out.
@session(per: Player)
struct Strikes {
    count: i32 = 0
}

// Sent to a player's region to change their mute. A player who is offline gets it when they next join.
@message
struct SetMute {
    until: Instant?
    by: String
}

region {
    // Early, so plugins that run later never see a message this one cancels.
    @on(PlayerChat, priority: early)
    fn chat(e: PlayerChat) {
        let p = e.player
        if still_muted(p) {
            e.cancel()
            return
        }
        // Byte ranges into e.message, which is UTF-8 (D28). The host converts them to the UTF-16
        // positions that vanilla's filter mask uses.
        let hits = config.matcher.find_all(e.message)
        if hits.is_empty() {
            return
        }
        server.broadcast(t"<gray>[filter] {p.name()}: {e.message}", permission: NOTIFY)
        match config.action {
            Action.Mask => {
                // Changing the text would break the chat signature, so filtered words are masked the way
                // vanilla's own filter does it: the client shows them as #### (D45).
                for r in hits {
                    e.mask(r)
                }
            }
            Action.Block => {
                e.cancel()
                p.send(t"<red>That message wasn't sent.")
            }
            Action.Strike => {
                e.cancel()
                let strikes = p.data(Strikes)
                strikes.count += 1
                if strikes.count < config.strikes_to_mute {
                    p.send(t"<yellow>Watch your language ({strikes.count}/{config.strikes_to_mute}).")
                    return
                }
                strikes.count = 0
                p.data(Mute).until = server.now() + config.mute_for
                p.send(t"<red>You've been muted for {config.mute_for}.")
            }
        }
    }

    // Runs in the target's region with a view of the target, the tick after it was sent.
    @receive
    fn set_mute(p: Player, m: SetMute) {
        p.data(Mute).until = m.until
        match m.until {
            none => p.send(t"<green>You were unmuted by {m.by}."),
            some(until) => p.send(t"<red>You were muted by {m.by} for {until - server.now()}."),
        }
    }
}

// Moderator commands. They're outside region { } and global { } because the console can run them too:
// a player's command runs in the player's region and the console's runs in the global instance, so the
// body may use only what works in both, like server, send and the sender.
// The literal path "chatfilter mute" becomes nested Brigadier literals. A PlayerRef argument completes
// from every player the server has seen, online or not, the way vanilla's /ban does, because the target
// may be offline or in another region.
@command("chatfilter mute", permission: MODERATE)
fn mute(sender: Sender, target: PlayerRef, length: Duration = Duration.minutes(10)) {
    send target SetMute { until: server.now() + length, by: sender.name() }, offline: keep
    sender.send(t"<green>Muted <white>{target.name()}</white> for {length}.")
}

@command("chatfilter unmute", permission: MODERATE)
fn unmute(sender: Sender, target: PlayerRef) {
    send target SetMute { until: none, by: sender.name() }, offline: keep
    sender.send(t"<green>Unmuted <white>{target.name()}</white>.")
}

// Tells a muted player how long is left, and clears a mute that has run out.
fn still_muted(p: Player) -> bool {
    let mute = p.data(Mute)
    let until = mute.until else return false
    // The wall-clock time captured at the start of this tick and recorded in the input log, so a replay
    // sees the same value (D44). Every handler in the tick sees the same instant.
    let now = server.now()
    if now >= until {
        mute.until = none
        return false
    }
    p.send(t"<red>You're muted for another {until - now}.")
    return true
}
