// Sample addon 1 of 5: homes.
// Stresses commands, persistent per-player data and teleporting.
// Imagined Calx syntax from Phase 0. Nothing here compiles yet. ../README.md explains the conventions.

@plugin(id: "homes", name: "Homes", version: "0.1.0", api: 1)
module homes

import calcite.{Player, Location, Task, Text, Argument, Brigadier, Suggest, Permission, PlayerMoveBlock, MoveCause, everyone, op}

// Loaded from plugins/homes/config.toml. On reload, the new values are swapped in at the tick barrier,
// so every region sees the same config during a tick.
@config
struct Config {
    max_homes: i32 = 3
    warmup_ticks: i32 = 60        // 0 teleports at once
    cancel_on_move: bool = true
}

@permission("homes.use", default: everyone)
const USE: Permission

// Lifts the max_homes limit.
@permission("homes.unlimited", default: op)
const UNLIMITED: Permission

// Saved per player, keyed by UUID, in Calcite's own files beside the world (D36).
// It travels with the player between regions, so whichever region they're in can read it.
// New fields take their default when older data loads.
@save(per: Player)
struct Homes {
    homes: SortedMap<HomeName, Location> = {}
}

// Per player, never saved, dropped when they log out. It travels with the player too.
@session(per: Player)
struct Pending {
    warmup: Task? = none
}

// A home's name. Making it an argument type gives the command tree its client-side parser,
// its validation and its tab completion, and every command that takes one gets all three.
struct HomeName(String)

impl Argument for HomeName {
    const parser = Brigadier.word

    fn parse(raw: String) -> HomeName ! Text {
        if raw.len() > 16 or not raw.all(|c| c.is_ascii_alphanumeric() or c == '_' or c == '-') {
            fail t"<red>Home names are up to 16 letters, digits, _ or -."
        }
        return HomeName(raw.to_lower())
    }

    // Runs in the sender's region, where their saved data is.
    fn suggest(s: Suggest, sender: Player) {
        for name in sender.data(Homes).homes.keys() {
            s.add(name.0)
        }
    }
}

region {
    // The signature is the command tree: /sethome [name], where name is a HomeName defaulting to "home".
    // Failing with a Text sends it to the sender in place of a success message.
    @command("sethome", permission: USE)
    fn sethome(p: Player, name: HomeName = HomeName("home")) ! Text {
        // A view of the player's data: writes go straight to it, and it can't outlive this handler.
        let data = p.data(Homes)
        let full = data.homes.len() >= config.max_homes
        if full and not data.homes.has(name) and not p.has(UNLIMITED) {
            fail t"<red>You already have {config.max_homes} homes. Delete one with /delhome."
        }
        data.homes.put(name, p.location())
        p.send(t"<green>Home <white>{name.0}</white> set.")
    }

    @command("home", permission: USE)
    fn home(p: Player, name: HomeName = HomeName("home")) ! Text {
        let to = p.data(Homes).homes.get(name) else fail t"<red>No home called <white>{name.0}</white>."
        let pending = p.data(Pending)
        if let old = pending.warmup {
            old.cancel()
        }
        if config.warmup_ticks == 0 {
            p.teleport(to)
            return
        }
        p.send(t"<gray>Teleporting in {config.warmup_ticks / 20} seconds. Don't move.")
        // A task on a player runs in whichever region the player is in when it fires, and is dropped if
        // they log out first. It may capture only values that can cross regions (to is a plain
        // Location), and it gets the player back as a fresh view.
        pending.warmup = p.after(ticks: config.warmup_ticks) |p| {
            p.data(Pending).warmup = none
            // Teleporting is a request. If the home is in another region or dimension, the player is
            // handed over at the tick barrier, and the host loads the destination chunk first.
            p.teleport(to)
            p.send(t"<green>Welcome home.")
        }
    }

    @command("delhome", permission: USE)
    fn delhome(p: Player, name: HomeName) ! Text {
        if p.data(Homes).homes.remove(name) == none {
            fail t"<red>No home called <white>{name.0}</white>."
        }
        p.send(t"<green>Deleted home <white>{name.0}</white>.")
    }

    @command("homes", permission: USE)
    fn homes(p: Player) {
        let homes = p.data(Homes).homes
        if homes.is_empty() {
            p.send(t"<gray>No homes yet. Set one with /sethome.")
            return
        }
        // Clicking a name runs /home <name>.
        let names = homes.keys().map(|n| t"<white>{n.0}".on_click(run: "/home " + n.0).on_hover(t"Teleport"))
        p.send(t"<green>Homes ({homes.len()}): " + Text.join(t"<gray>, ", names))
    }

    // Fires only when a player enters a different block, not for every small step or turn of the head,
    // so a handler like this costs almost nothing on a busy server.
    @on(PlayerMoveBlock)
    fn moved(e: PlayerMoveBlock) {
        if not config.cancel_on_move or e.cause != MoveCause.Walk {
            return
        }
        let pending = e.player.data(Pending)
        let task = pending.warmup else return
        task.cancel()
        pending.warmup = none
        e.player.send(t"<red>Teleport cancelled because you moved.")
    }
}
