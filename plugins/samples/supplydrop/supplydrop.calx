// Sample addon 5 of 5: supply drops.
// Stresses the scheduler, the global instance and broadcasting to every region.
// Every so often a chest of loot lands near a random player, and everyone is told where.
// It goes away after a while if nobody opens it.
// Imagined Calx syntax from Phase 0. Nothing here compiles yet. ../README.md explains the conventions.

@plugin(id: "supplydrop", name: "Supply drops", version: "0.1.0", api: 1)
module supplydrop

import calcite.{Chunk, BlockPos, WorldKey, Tick, Ticks, LootTableKey, Block, Chest, Heightmap, Sound, ContainerOpen}

@config
struct Config {
    every: Ticks = Ticks.minutes(30)
    min_players: i32 = 2
    radius: i32 = 300                // how far from the chosen player it can land
    lifetime: Ticks = Ticks.minutes(10)
    // The plugin ships this loot table in its own data pack, plugins/supplydrop/data/.
    loot: LootTableKey = LootTableKey("supplydrop:crate")
}

// What the global instance knows about a crate.
struct Crate {
    id: i64
    world: WorldKey
    at: BlockPos
    expires: Tick
}

@message
struct Place {
    id: i64
    world: WorldKey
    near: BlockPos
}

@message
struct Placed {
    id: i64
    world: WorldKey
    at: BlockPos
}

@message
struct Remove {
    id: i64
    at: BlockPos
}

@message
struct Looted {
    id: i64
    by_name: String
}

// Saved with the chunk, so the marker loads and unloads with the chest it marks.
@save(per: Chunk)
struct Markers {
    crates: Map<BlockPos, i64> = {}
}

// There is one global instance per plugin. It's the only place a plugin keeps world-wide state, and
// its fields with @save are written beside the world when the server saves (D36, D42).
global {
    @save var active: List<Crate> = []
    @save var next_id: i64 = 1

    // Runs in the global phase. The interval is read again after each run, so a config reload takes
    // effect from the next drop.
    @every(ticks: config.every)
    fn drop() {
        // The player directory as it was at the start of this tick, in a fixed order.
        let players = server.players()
        if players.len() < config.min_players {
            return
        }
        let rng = global.random()
        let who = players[rng.next_int(players.len())]
        let r = config.radius
        let near = who.block_position() + BlockPos(rng.range(-r, r), 0, rng.range(-r, r))
        let id = next_id
        next_id += 1
        // region_at routes by chunk when the message is delivered, so it reaches whichever region owns
        // that chunk then. load: true asks the host to load the chunk and deliver once it's in. A
        // finished chunk load is in the input log (D21), so the delivery tick replays the same.
        send region_at(who.world, near, load: true) Place { id, world: who.world, near }
    }

    @receive
    fn placed(m: Placed) {
        active.push(Crate { id: m.id, world: m.world, at: m.at, expires: server.tick() + config.lifetime })
        // Fans out to every region in the message exchange, so every player sees it on the same tick.
        server.broadcast(t"<gold>A supply drop landed near <white>{m.at.x}, {m.at.z}</white>!")
        server.broadcast_sound(Sound.ui_toast_challenge_complete)
    }

    @receive
    fn looted(m: Looted) {
        if active.remove_where(|c| c.id == m.id) == 0 {
            return
        }
        server.broadcast(t"<gold>{m.by_name}</gold> <yellow>found the supply drop.")
    }

    @every(ticks: 200)
    fn sweep() {
        let now = server.tick()
        for c in active.drain_where(|c| c.expires <= now) {
            // No point loading a chunk just to take a chest out of it. With load: false the host keeps
            // the message with the chunk's saved data and delivers it the next time the chunk loads.
            send region_at(c.world, c.at, load: false) Remove { id: c.id, at: c.at }
        }
    }
}

region {
    @receive
    fn place(m: Place) {
        let world = region.world
        // The same heightmap vanilla uses to decide where falling things land.
        let y = world.top_y(m.near.x, m.near.z, Heightmap.motion_blocking_no_leaves)
        let at = BlockPos(m.near.x, y, m.near.z)
        world.set_block(at, Block.chest)
        // A block entity is a handle. Asking for one as a type gives none if it isn't that type.
        let chest = world.block_entity(at, Chest) else return
        // Vanilla rolls the loot the first time someone opens the chest, as it does for dungeon chests.
        chest.set_loot_table(config.loot, seed: region.random().next_i64())
        world.chunk_at(at).data(Markers).crates.put(at, m.id)
        world.play_sound(Sound.block_beacon_activate, at: at, volume: 4.0)
        send global Placed { id: m.id, world: m.world, at }
    }

    @receive
    fn remove(m: Remove) {
        let world = region.world
        let markers = world.chunk_at(m.at).data(Markers)
        // Gone already if it was opened, or replaced by another crate in the same spot.
        if markers.crates.get(m.at) != m.id {
            return
        }
        markers.crates.remove(m.at)
        if world.block(m.at).is(Block.chest) {
            world.set_block(m.at, Block.air, drops: false)
        }
    }

    @on(ContainerOpen)
    fn opened(e: ContainerOpen) {
        // Minecarts and other entity containers have no block position.
        let at = e.block_position else return
        let id = region.world.chunk_at(at).data(Markers).crates.remove(at) else return
        // Once opened, it's an ordinary chest and stays.
        send global Looted { id, by_name: e.player.name() }
    }
}
