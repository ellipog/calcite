module oracle.datagen.calx_tables

// Writes the compiled-in tables Calcite's Calx code needs from the converted tables (D61, D126).
//
//     calx oracle/datagen/calx_tables.calx            # write them from generated/<version>/tables
//     calx oracle/datagen/calx_tables.calx --check    # fail if what's committed is out of date
//
// The modules are committed, so Calcite builds without the jar. They hold only the identifiers and
// IDs the protocol needs, which every compatible server encodes:
//
// - `protocol.ids`: the protocol version, and each state's packets in ID order.
// - `registry.builtin`: the built-in registries and their entries in ID order.
// - `pack.pin`: where the pinned server jar comes from, and its size and SHA-1, from versions.json.
// - `world.blocks`: each block's first state ID and default state, in block ID order.
// - `world.block_flags`: what each block state is, as vanilla's state cache holds it, from
//   block_flags.json, which oracle/datagen/block_flags.calx writes beside the tables (D164).
// - `world.block_facts`: what features ask of each state and block, from the same file (CAL-84).
// - `world.light_faces`: the faces light sees of each block state, and which two faces light
//   can't pass between, from the same file (CAL-66).
// - `world.collision_shapes`: each block state's collision shape, as the spawn finder sees it, and
//   the boxes of each, from the same file (CAL-75).
// - `world.fluid_faces`: the faces a fluid sees of each block state, which two cover a face between
//   them, and the boxes of the states vanilla offsets by their position, from the same file (D327).
// - `world.movement_shapes`: each block state's collision shape as an entity moves against it, the
//   boxes of each, the blocks' friction, speed, jump and bounce, and vanilla's own collide cases,
//   from the same file (CAL-148).
// - `world.outline_shapes`: each state's outline shape, from the same file (CAL-159).
// - `world.entity_facts`: what natural spawning asks of each entity type and block state, from
//   entity_facts.json, which oracle/datagen/entity_facts.calx writes beside the tables (D317).
// - `world.item_defaults`: each item's default components, from items.json (D362).
// - `command.tree`: vanilla's command tree, as a dedicated server registers it, each node's
//   permission level and its argument's properties, from command_tree.json, which
//   oracle/datagen/command_tree.calx writes beside the tables (CAL-165).

import std.bytes.{from_hex}
import std.cli.{cli}
import std.fs.{exists, is_file, make_dir_all, read_text, write_text}
import std.json.{Json, parse, sort_keys}
import std.path
import std.process.{exit}
import std.text.python.{repr_float}
import oracle.datagen.block_tables.{block_facts_module, block_flags_module, collision_module, fluid_faces_module, light_faces_module, movement_module, outline_module}
import oracle.datagen.tablekit.{TOOL, add, at, bad, calx_double, calx_float, encoded_table, has, int, ints, items, members, num, numbers, rows_of, shown, strings, text, texts, truthy}
import tools.repo.{under}

fn states() -> List<String> {
    return ["handshake", "status", "login", "configuration", "play"]
}

fn bounds() -> List<String> {
    return ["serverbound", "clientbound"]
}

fn calx_name(state: String) -> String {
    return "{state[..1].to_upper_root()}{state[1..]}"
}

/// The text of src/protocol/ids.calx.
pub fn ids_module(index: Json, packets: Json) -> String {
    let gv = text(at(index, "game_version"))
    let lists = members(packets)
    var unknown: List<String> = []
    for (state, _) in lists {
        if not states().contains(state) {
            unknown.push(state.copy())
        }
    }
    unknown.sort()
    if not unknown.is_empty() {
        bad("packets.json has states this script doesn't know: {unknown}")
    }
    let pack = at(index, "pack_version")
    var lines: List<String> = [
        "/// Vanilla {gv}'s protocol version, and the packets of each protocol state in ID order, so a",
        "/// packet's ID is its place in its list. Written by {TOOL} from",
        "/// packets.json (D126): don't edit it.",
        "module protocol.ids",
        "",
        "import protocol.state.\{State, Bound\}",
        "",
        "/// The protocol version a {gv} client sends in its handshake.",
        "pub const PROTOCOL_VERSION: i32 = {int(at(index, "protocol_version"))}",
        "",
        "/// The data version {gv} writes in its saves as `DataVersion`, which says which version wrote",
        "/// them.",
        "pub const DATA_VERSION: i32 = {int(at(index, "world_version"))}",
        "",
        "/// The data pack format {gv} reads, `major.minor`, as `pack.mcmeta`'s `min_format` and",
        "/// `max_format` give it.",
        "pub const DATA_PACK_MAJOR: i32 = {int(at(pack, "data_major"))}",
        "pub const DATA_PACK_MINOR: i32 = {int(at(pack, "data_minor"))}",
        "",
        "/// The game version, as the server list shows it.",
        "pub fn game_version() -> String \{",
        "    return \"{gv}\"",
        #"}"#,
        "",
        "/// The packets in `state` that go `bound`, by their names without `minecraft:`, in ID order.",
        "pub fn packet_names(state: State, bound: Bound) -> List<String> \{",
        "    match state \{",
    ]
    for state in states() {
        let sides = if let found = lists.find(state) { members(found) } else { LinkedMap<String, Json>() }
        var extra: List<String> = []
        for (side, _) in sides {
            if not bounds().contains(side) {
                extra.push(side.copy())
            }
        }
        extra.sort()
        if not extra.is_empty() {
            bad("packets.json's {state} has directions this script doesn't know: {extra}")
        }
        lines.push("        State.{calx_name(state)} => \{")
        for bound in bounds() {
            var names: List<String> = []
            if let found = sides.find(bound) {
                for name in texts(found) {
                    if not name.starts_with("minecraft:") {
                        bad("packet {name} isn't in the minecraft namespace")
                    }
                    names.push(name.trim_prefix("minecraft:").copy())
                }
            }
            let body = strings(names)
            if bound == bounds()[0] {
                lines.push("            if bound == Bound.{calx_name(bound)} \{")
                lines.push("                return [{body}]")
                lines.push(#"            }"#)
            } else {
                lines.push("            return [{body}]")
            }
        }
        lines.push(#"        }"#)
    }
    add(mut lines, [#"    }"#, #"}"#, ""])
    return lines.join("\n")
}

/// An identifier as the modules write it: without `minecraft:`, or whole in another namespace.
fn short(name: String) -> String {
    if not name.contains(":") {
        bad("{name} has no namespace")
    }
    if name.contains("\"") or name.contains("\\") or name.contains("\{") {
        bad("{name} can't be written in a Calx string")
    }
    return name.trim_prefix("minecraft:").copy()
}

/// The text of src/registry/builtin.calx.
pub fn builtin_module(index: Json, registries: Json) -> String {
    let gv = text(at(index, "game_version"))
    var by_id: List<(i64, String, Json)> = []
    for (name, reg) in members(registries) {
        by_id.push((int(at(reg, "id")), name.copy(), reg.copy()))
    }
    by_id.sort_by(|a, b| a.0.cmp(b.0))
    for (i, (id, _, _)) in by_id.enumerate() {
        if id != i64.wrap(i) {
            bad("registries.json's registry IDs don't run from 0 without gaps")
        }
    }
    var names: List<String> = []
    for (_, name, _) in by_id {
        names.push(short(name))
    }
    var lines: List<String> = [
        "/// Vanilla {gv}'s built-in registries, the ones it defines in code, and their entries in ID",
        "/// order, so an entry's ID is its place in its list. Written by {TOOL}",
        "/// from registries.json (D61): don't edit it.",
        "module registry.builtin",
        "",
        "/// The built-in registries, in the order of their own IDs, by name without `minecraft:`.",
        "pub fn builtin_names() -> List<String> \{",
        "    return [{strings(names)}]",
        #"}"#,
        "",
        "/// The entries of the registry at `index` in `builtin_names`, in ID order, by name without",
        "/// `minecraft:` where they're in it. None for an index past the last.",
        "pub fn builtin_entries(index: usize) -> List<String> \{",
        "    return match index \{",
    ]
    for (id, _, reg) in by_id {
        var entries: List<String> = []
        for e in texts(at(reg, "entries")) {
            entries.push(short(e))
        }
        lines.push("        {id} => [{strings(entries)}],")
    }
    add(mut lines, ["        _ => [],", #"    }"#, #"}"#, ""])
    return lines.join("\n")
}

/// The text of src/world/blocks.calx.
pub fn blocks_module(index: Json, blocks: Json) -> String {
    let gv = text(at(index, "game_version"))
    let entries = items(at(blocks, "blocks"))
    for (i, b) in entries.enumerate() {
        if int(at(b, "id")) != i64.wrap(i) {
            bad("blocks.json's block IDs don't run from 0 without gaps")
        }
    }
    var first = 0i64
    for b in entries {
        let name = text(at(b, "name"))
        let start = int(at(b, "first_state"))
        let count = int(at(b, "state_count"))
        let default = int(at(b, "default_state"))
        if start != first {
            bad("{name}'s states don't follow the block before's")
        }
        if not (start <= default and default < start + count) {
            bad("{name}'s default state isn't one of its states")
        }
        first += count
    }
    if first != int(at(blocks, "state_count")) {
        bad("blocks.json's blocks have {first} states, not the {int(at(blocks, "state_count"))} it says")
    }
    let properties = items(at(blocks, "properties"))
    var firsts: List<i64> = []
    var defaults: List<i64> = []
    var starts: List<i64> = [0]
    var listed: List<i64> = []
    for b in entries {
        let name = text(at(b, "name"))
        firsts.push(int(at(b, "first_state")))
        defaults.push(int(at(b, "default_state")) - int(at(b, "first_state")))
        let props = ints(at(b, "properties"))
        var names: List<String> = []
        var count = 1i64
        for i in props {
            let p = properties[usize.wrap(i)].copy()
            names.push(text(at(p, "name")))
            count *= i64.wrap(items(at(p, "values")).len())
            listed.push(i)
        }
        var sorted_names = names.copy()
        sorted_names.sort()
        var twice = false
        for k in 1..sorted_names.len() {
            if sorted_names[k] == sorted_names[k - 1] {
                twice = true
            }
        }
        if names != sorted_names or twice {
            bad("{name}'s properties aren't in name order")
        }
        if count != int(at(b, "state_count")) {
            bad("{name}'s properties make {count} states, not {int(at(b, "state_count"))}")
        }
        starts.push(starts[starts.len() - 1] + i64.wrap(props.len()))
    }
    var prop_names: List<String> = []
    var values: List<String> = []
    for p in properties {
        let pname = text(at(p, "name"))
        let pvalues = texts(at(p, "values"))
        var checked = pvalues.copy()
        checked.push(pname.copy())
        for v in checked {
            if v.contains("\"") or v.contains("\\") or v.contains("\{") {
                bad("{v} can't be written in a Calx string")
            }
        }
        prop_names.push(pname)
        values.push("[{strings(pvalues)}]")
    }
    let lines: List<String> = [
        "/// Vanilla {gv}'s block state IDs: a block's states are numbered on from the last",
        "/// state of the block before it, in block ID order, which is the order of `registry.builtin`'s",
        "/// `block` registry. Written by {TOOL} from blocks.json (D126): don't edit",
        "/// it.",
        "module world.blocks",
        "",
        "/// How many block states there are.",
        "pub const STATE_COUNT: u32 = {int(at(blocks, "state_count"))}",
        "",
        "/// The ID of each block's first state, in block ID order.",
        "pub fn first_states() -> List<u32> \{",
        "    return [{shown(firsts).join(", ")}]",
        #"}"#,
        "",
        "/// Where each block's default state is among its states, in block ID order.",
        "pub fn default_offsets() -> List<u32> \{",
        "    return [{shown(defaults).join(", ")}]",
        #"}"#,
        "",
        "/// The properties of blocks' states, by name. Several share a name, such as `age`, with other",
        "/// values.",
        "pub fn property_names() -> List<String> \{",
        "    return [{strings(prop_names)}]",
        #"}"#,
        "",
        "/// Each property's values, in vanilla's order, which is the order of the states: `true` before",
        "/// `false`, and an integer's from the least.",
        "pub fn property_values() -> List<List<String>> \{",
        "    return [{values.join(", ")}]",
        #"}"#,
        "",
        "/// Where each block's properties start in `block_properties`, in block ID order, and where the",
        "/// last one's end.",
        "pub fn property_starts() -> List<u32> \{",
        "    return [{shown(starts).join(", ")}]",
        #"}"#,
        "",
        "/// Each block's properties, by their index in `property_names`, in name order. A state's ID is",
        "/// its block's first state's plus, for each property, its value's index times the states the",
        "/// properties after it make, so the last one's changes fastest.",
        "pub fn block_properties() -> List<u32> \{",
        "    return [{shown(listed).join(", ")}]",
        #"}"#,
        "",
    ]
    return lines.join("\n")
}

fn is_hex(s: String, n: usize) -> bool {
    if s.len() != n {
        return false
    }
    for b in s.to_bytes() {
        if not ((b >= 0x30 and b <= 0x39) or (b >= 0x61 and b <= 0x66)) {
            return false
        }
    }
    return true
}

fn holdable_url(url: String) -> bool {
    return url.starts_with("https://") and not url.contains("\"") and not url.contains("\{") and not url.contains("\\")
}

/// The text of src/pack/pin.calx.
pub fn pin_module(version: String, pin: Json) -> String {
    let url = text(at(pin, "url"))
    let sha1 = text(at(pin, "sha1"))
    let size = int(at(pin, "size"))
    if not holdable_url(url) {
        bad("the pinned URL {url} isn't an https URL Calx can hold")
    }
    if not is_hex(sha1, 40) {
        bad("the pinned SHA-1 {sha1} isn't 40 lowercase hex digits")
    }
    let client = at(pin, "client")
    let data = at(client, "data")
    let client_url = text(at(client, "url"))
    let data_sha256 = text(at(data, "sha256"))
    if not holdable_url(client_url) {
        bad("the pinned client URL {client_url} isn't an https URL Calx can hold")
    }
    if not is_hex(data_sha256, 64) {
        bad("the pinned data SHA-256 {data_sha256} isn't 64 lowercase hex digits")
    }
    let lines: List<String> = [
        "/// Where Mojang's {version} server jar comes from, and its size and SHA-1, and where the vanilla",
        "/// data is in the client jar, as oracle/versions.json pins them (D62, D140). Written by",
        "/// {TOOL}: don't edit it.",
        "module pack.pin",
        "",
        "/// The game version the jar is.",
        "pub fn jar_version() -> String \{",
        "    return \"{version}\"",
        #"}"#,
        "",
        "/// Mojang's URL for the jar.",
        "pub fn jar_url() -> String \{",
        "    return \"{url}\"",
        #"}"#,
        "",
        "/// The jar's SHA-1, in lowercase hex.",
        "pub fn jar_sha1() -> String \{",
        "    return \"{sha1}\"",
        #"}"#,
        "",
        "/// The jar's size in bytes.",
        "pub const JAR_SIZE: usize = {size}",
        "",
        "/// Mojang's URL for the client jar, which holds the vanilla data as the server jar does, but",
        "/// with each file compressed on its own, so a stretch of it can be read alone.",
        "pub fn client_url() -> String \{",
        "    return \"{client_url}\"",
        #"}"#,
        "",
        "/// The client jar's size in bytes.",
        "pub const CLIENT_SIZE: u64 = {int(at(client, "size"))}",
        "",
        "/// Where in the client jar the vanilla data is: from the local header of the first file",
        "/// Calcite reads, data/ and the two language files, to the end of the last.",
        "pub const DATA_OFFSET: u64 = {int(at(data, "offset"))}",
        "pub const DATA_LENGTH: usize = {int(at(data, "length"))}",
        "",
        "/// The SHA-256 of that stretch, in lowercase hex.",
        "pub fn data_sha256() -> String \{",
        "    return \"{data_sha256}\"",
        #"}"#,
        "",
    ]
    return lines.join("\n")
}

// What entity_facts.json gives each type, as calcite.rig.vanilla.EntityFacts sets them, a bit each.
fn type_flags() -> List<(String, String, String)> {
    return [
        ("SUMMON", "summon", "`canSummon`"),
        ("FIRE_IMMUNE", "fire_immune", "`fireImmune`"),
        ("FAR", "far", "`canSpawnFarFromPlayer`: it spawns however far it is from players"),
        ("PEACEFUL", "peaceful", "`isAllowedInPeaceful`"),
    ]
}

// Vanilla's spawn placement types, as entity_facts.json names them.
fn placements() -> List<String> {
    return ["no_restrictions", "in_water", "in_lava", "on_ground"]
}

// `Heightmap.Types`, in its order, which world.chunk's kinds are in.
fn heightmaps() -> List<String> {
    return ["WORLD_SURFACE_WG", "WORLD_SURFACE", "OCEAN_FLOOR_WG", "OCEAN_FLOOR", "MOTION_BLOCKING", "MOTION_BLOCKING_NO_LEAVES"]
}

fn place_in(list: List<String>, s: String) -> usize {
    for (i, x) in list.enumerate() {
        if x == s {
            return i
        }
    }
    bad("{s} isn't one of {list}")
}

fn doubles(values: List<f64>) -> String {
    var parts: List<String> = []
    for v in values {
        parts.push(calx_double(v))
    }
    return parts.join(", ")
}

fn quoted(names: List<String>) -> String {
    var parts: List<String> = []
    for n in names {
        parts.push("\"{n}\"")
    }
    return parts.join(", ")
}

/// world.entity_facts' attributes: each one's default, range and whether it's synced, in ID order,
/// and the player's, with their bases (CAL-137); and every living type's (CAL-155).
fn attribute_lines(facts: Json) -> List<String> {
    let attributes = items(at(facts, "attributes"))
    var ids = Map<String, usize>()
    for (i, a) in attributes.enumerate() {
        ids.insert(text(at(a, "id")), i)
    }
    let player = items(at(facts, "player_attributes"))
    for a in player {
        let id = text(at(a, "id"))
        if not ids.contains(id) {
            bad("the player has {id}, which isn't an attribute")
        }
    }
    let living = items(at(facts, "type_attributes"))
    var starts: List<i64> = [0]
    for t in living {
        starts.push(starts[starts.len() - 1] + i64.wrap(items(at(t, "attributes")).len()))
    }
    var names: List<String> = []
    var defaults: List<f64> = []
    var mins: List<f64> = []
    var maxes: List<f64> = []
    var synced: List<String> = []
    for (i, a) in attributes.enumerate() {
        names.push(text(at(a, "id")).trim_prefix("minecraft:").copy())
        defaults.push(num(at(a, "default")))
        mins.push(num(at(a, "min")))
        maxes.push(num(at(a, "max")))
        if truthy(at(a, "synced")) {
            synced.push("{i}")
        }
    }
    var had: List<String> = []
    var bases: List<f64> = []
    for a in player {
        had.push("{ids[text(at(a, "id"))]}")
        bases.push(num(at(a, "base")))
    }
    var types: List<String> = []
    var living_had: List<String> = []
    var living_bases: List<f64> = []
    for t in living {
        types.push("{int(at(t, "type"))}")
        for pair in items(at(t, "attributes")) {
            let parts = items(pair)
            living_had.push("{int(parts[0])}")
            living_bases.push(num(parts[1]))
        }
    }
    return [
        "/// The attributes' names, without their namespace, in attribute ID order.",
        "pub fn attribute_names() -> List<String> \{",
        "    return [{quoted(names)}]",
        #"}"#,
        "",
        "/// Each attribute's default, `getDefaultValue`, in attribute ID order.",
        "pub fn attribute_defaults() -> List<f64> \{",
        "    return [{doubles(defaults)}]",
        #"}"#,
        "",
        "/// The least each attribute's value is, as `RangedAttribute.sanitizeValue` keeps it, in ID order.",
        "pub fn attribute_mins() -> List<f64> \{",
        "    return [{doubles(mins)}]",
        #"}"#,
        "",
        "/// The most each attribute's value is, as `sanitizeValue` keeps it, in ID order.",
        "pub fn attribute_maxes() -> List<f64> \{",
        "    return [{doubles(maxes)}]",
        #"}"#,
        "",
        "/// The attributes sent to clients, `isClientSyncable`, by ID.",
        "pub fn synced_attributes() -> List<u32> \{",
        "    let synced: List<u32> = [{synced.join(", ")}]",
        "    return synced",
        #"}"#,
        "",
        "/// The attributes a player has, as `DefaultAttributes` gives them for `EntityTypes.PLAYER`, by ID,",
        "/// in ID order.",
        "pub fn player_attributes() -> List<u32> \{",
        "    let had: List<u32> = [{had.join(", ")}]",
        "    return had",
        #"}"#,
        "",
        "/// The bases of `player_attributes`, in the same order.",
        "pub fn player_attribute_bases() -> List<f64> \{",
        "    return [{doubles(bases)}]",
        #"}"#,
        "",
        "/// The living types, `DefaultAttributes`' with a supplier, by type ID, in ID order.",
        "pub fn living_types() -> List<u32> \{",
        "    let living: List<u32> = [{types.join(", ")}]",
        "    return living",
        #"}"#,
        "",
        "/// Where each of `living_types`' attributes start in `living_attributes`, and where the last's",
        "/// end.",
        "pub fn living_attribute_starts() -> List<u32> \{",
        "    let starts: List<u32> = [{shown(starts).join(", ")}]",
        "    return starts",
        #"}"#,
        "",
        "/// Each living type's attributes, by ID, in ID order, as `DefaultAttributes` supplies them.",
        "pub fn living_attributes() -> List<u32> \{",
        "    let had: List<u32> = [{living_had.join(", ")}]",
        "    return had",
        #"}"#,
        "",
        "/// The bases of `living_attributes`, in the same order.",
        "pub fn living_attribute_bases() -> List<f64> \{",
        "    return [{doubles(living_bases)}]",
        #"}"#,
    ]
}

// What a state's path facts say `isPathfindable` gives, as calcite.rig.vanilla.PathFacts writes
// them, and the classes they say it is (CAL-157).
fn pathfindable() -> List<(String, String)> {
    return [
        ("NEVER", "never"),
        ("ALWAYS", "always"),
        ("IN_WATER", "where its fluid is in `#water`"),
        ("NOT_IN_LAVA", "where its fluid isn't in `#lava`"),
    ]
}

fn path_kinds() -> List<(String, String)> {
    return [
        ("OTHER", "none of the others"),
        ("DOOR_OPEN", "a door, open"),
        ("DOOR_BY_HAND", "a door, shut, of a kind opened by hand"),
        ("DOOR_SHUT", "a door, shut, of a kind that isn't"),
        ("RAIL", "a `BaseRailBlock`"),
        ("LEAVES", "a `LeavesBlock`"),
        ("GATE_SHUT", "a fence gate, shut"),
    ]
}

/// world.entity_facts' path facts (CAL-157): `PathType`'s constants and maluses, each state's path
/// facts, and for the test what `getPathTypeFromState` gives each state with vanilla's tags, and
/// those tags.
fn path_lines(facts: Json) -> List<String> {
    let names = texts(at(facts, "path_type_names"))
    let maluses = items(at(facts, "path_maluses"))
    if names.len() != maluses.len() {
        bad("a malus for each path type")
    }
    let paths = ints(at(facts, "paths"))
    for (state, v) in paths.enumerate() {
        if v >> 6 >= i64.wrap(path_kinds().len()) {
            bad("state {state}'s path facts {v:#x} have a class this script doesn't know")
        }
    }
    let state_count = items(at(facts, "states")).len()
    let types = ints(at(facts, "path_types"))
    if paths.len() != state_count or types.len() != state_count {
        bad("path facts and types for each state")
    }
    var lines: List<String> = [
        "",
        "/// `PathType`, in its order, what pathfinding makes of a block (CAL-157).",
    ]
    for (i, name) in names.enumerate() {
        lines.push("pub const PATH_{name}: u8 = {i}")
    }
    var malus_text: List<String> = []
    for m in maluses {
        malus_text.push(calx_float(num(m)))
    }
    add(mut lines, [
        "/// How many path types there are.",
        "pub const PATH_TYPE_COUNT: usize = {names.len()}",
        "",
        "/// The path types' names, in their order.",
        "pub fn path_type_names() -> List<String> \{",
        "    return [{quoted(names)}]",
        #"}"#,
        "",
        "/// Each path type's malus, `getMalus`, what a mob's `getPathfindingMalus` gives where it has",
        "/// none of its own, in their order.",
        "pub fn path_maluses() -> List<f32> \{",
        "    return [{malus_text.join(", ")}]",
        #"}"#,
        "",
        "/// What a state's path facts say `isPathfindable` gives for each `PathComputationType`, two bits",
        "/// each from bit `2 * COMPUTATION_LAND`, `2 * COMPUTATION_WATER` and `2 * COMPUTATION_AIR`.",
    ])
    for (i, (name, what)) in pathfindable().enumerate() {
        lines.push("/// It's pathfindable {what}.")
        lines.push("pub const PATHFINDABLE_{name}: u32 = {i}")
    }
    add(mut lines, [
        "pub const COMPUTATION_LAND: u32 = 0",
        "pub const COMPUTATION_WATER: u32 = 1",
        "pub const COMPUTATION_AIR: u32 = 2",
        "/// Where the class a state is, of those `getPathTypeFromState` asks about, is in its path facts,",
        "/// and the classes.",
        "pub const PATH_KIND_SHIFT: u32 = 6",
    ])
    for (i, (name, what)) in path_kinds().enumerate() {
        lines.push("/// It's {what}.")
        lines.push("pub const PATH_KIND_{name}: u32 = {i}")
    }
    add(mut lines, ["", "/// Each state's path facts, in state ID order."])
    add(mut lines, encoded_table("state_path_facts", "facts", paths))
    add(mut lines, [
        "/// What `getPathTypeFromState` gives each state with vanilla's tags, in state ID order, for",
        "/// test/paths.calx.",
    ])
    add(mut lines, encoded_table("vanilla_path_types", "paths", types))
    let block_tags = members(at(facts, "path_block_tags"))
    let fluid_tags = members(at(facts, "path_fluid_tags"))
    var block_names: List<String> = []
    for (n, _) in block_tags {
        block_names.push(n.copy())
    }
    var fluid_names: List<String> = []
    for (n, _) in fluid_tags {
        fluid_names.push(n.copy())
    }
    add(mut lines, [
        "/// The block tags `getPathTypeFromState` reads, and vanilla's blocks in each, by ID, for",
        "/// test/paths.calx.",
        "pub fn path_block_tag_names() -> List<String> \{",
        "    return [{quoted(block_names)}]",
        #"}"#,
        "",
        "pub fn path_block_tag_blocks() -> List<List<i32>> \{",
        "    let tags: List<List<i32>> = [",
    ])
    for (_, v) in block_tags {
        lines.push("        [{shown(ints(v)).join(", ")}],")
    }
    add(mut lines, [
        "    ]",
        "    return tags",
        #"}"#,
        "",
        "/// The fluid tags it reads, and vanilla's fluids in each, by ID, for test/paths.calx.",
        "pub fn path_fluid_tag_names() -> List<String> \{",
        "    return [{quoted(fluid_names)}]",
        #"}"#,
        "",
        "pub fn path_fluid_tag_fluids() -> List<List<i32>> \{",
        "    let tags: List<List<i32>> = [",
    ])
    for (_, v) in fluid_tags {
        lines.push("        [{shown(ints(v)).join(", ")}],")
    }
    add(mut lines, ["    ]", "    return tags", #"}"#])
    return lines
}

/// The text of src/world/entity_facts.calx.
fn entity_facts_module(index: Json, facts: Json) -> String {
    let gv = text(at(index, "game_version"))
    let made = text(at(facts, "game_version"))
    if made != gv {
        bad("entity_facts.json is {made}, the tables {gv}")
    }
    let groups = int(at(facts, "spawn_groups"))
    for (state, v) in ints(at(facts, "states")).enumerate() {
        if v >> (1 + groups) != 0 {
            bad("state {state}'s spawn facts {v:#x} have bits this script doesn't know")
        }
    }
    let categories = texts(at(facts, "categories"))
    let types = items(at(facts, "types"))
    var rule_set = Set<String>()
    var immune: List<String> = []
    for t in types {
        if has(t, "rule") {
            rule_set.insert(text(at(t, "rule")))
        }
        let i = text(at(t, "immune_to"))
        if not immune.contains(i) {
            immune.push(i)
        }
    }
    var rules: List<String> = []
    for r in rule_set {
        rules.push(r.copy())
    }
    rules.sort()
    var lowered: List<String> = []
    for c in categories {
        lowered.push(c.to_lower_root())
    }
    var lines: List<String> = [
        "/// What vanilla {gv}'s natural spawning asks of each entity type, in type ID order, and of each",
        "/// block state, in state ID order, and each attribute and the player's (D375), and what",
        "/// pathfinding reads of each state (D409). Written by {TOOL} from",
        "/// entity_facts.json (D317): don't edit it.",
        "module world.entity_facts",
        "",
        "/// The mob categories, in `MobCategory` order, which a type's `category` is a place in.",
        "pub fn categories() -> List<String> \{",
        "    return [{quoted(categories)}]",
        #"}"#,
        "",
        "/// The categories' serialized names, as codecs read and write them, in the same order.",
        "pub fn category_names() -> List<String> \{",
        "    return [{quoted(lowered)}]",
        #"}"#,
        "",
    ]
    for (i, c) in categories.enumerate() {
        lines.push("pub const {c}: i32 = {i}")
    }
    lines.push("")
    for (i, (name, _, what)) in type_flags().enumerate() {
        lines.push("/// {what}.")
        lines.push("pub const {name}: u32 = {1u32 << u32.wrap(i)}")
    }
    lines.push("")
    for (i, p) in placements().enumerate() {
        lines.push("/// `SpawnPlacementTypes.{p.to_upper_root()}`.")
        lines.push("pub const {p.to_upper_root()}: i32 = {i}")
    }
    add(mut lines, [
        "",
        "/// A state is a signal source, in its spawn facts.",
        "pub const SIGNAL_SOURCE: u32 = 1",
        "/// Where the spawn groups' bits are in a state's spawn facts: `isValidSpawn` holds on the state",
        "/// for the types of group `g` where bit `VALID_SPAWN_SHIFT + g` is set.",
        "pub const VALID_SPAWN_SHIFT: u32 = 1",
        "/// How many spawn groups there are.",
        "pub const SPAWN_GROUPS: i32 = {groups}",
        "",
        "/// The methods the types' spawn rules call, as `Owner.method`, which a type's `rule` is a place",
        "/// in.",
        "pub fn rules() -> List<String> \{",
        "    return [",
    ])
    for r in rules {
        lines.push("        \"{r}\",")
    }
    add(mut lines, [
        "    ]",
        #"}"#,
        "",
        "/// The block tags the types are immune to, as `isBlockDangerous` reads them, in the order the",
        "/// types first name them, which a type's `immune_to` is a place in.",
        "pub fn immune_tags() -> List<String> \{",
        "    return [",
    ])
    for name in immune {
        lines.push("        \"{name}\",")
    }
    add(mut lines, [
        "    ]",
        #"}"#,
        "",
        "/// What natural spawning asks of an entity type.",
        "pub struct TypeFacts \{",
        "    /// Its place in `categories`.",
        "    pub category: i32",
        "    /// Its flags, from those above.",
        "    pub flags: u32",
        "    /// The block tag it's immune to, as its place in `immune_tags`.",
        "    pub immune_to: i32",
        "    /// Half its spawn box's width, and its height, as `getSpawnAABB` works them out.",
        "    pub half_width: f32",
        "    pub height: f32",
        "    /// Its spawn group: which states `isValidSpawn` holds on for it.",
        "    pub spawn_group: i32",
        "    /// Where `SpawnPlacements` registers it, its placement type and its place in `rules`, or",
        "    /// none where it isn't; and its heightmap, of world.chunk's kinds.",
        "    pub placement: i32?",
        "    pub heightmap: i32",
        "    pub rule: i32?",
        #"}"#,
        "",
        "/// Each type's facts, in type ID order.",
        "pub fn types() -> List<TypeFacts> \{",
        "    return [",
    ])
    for t in types {
        var flags = 0u32
        for (i, (_, key, _)) in type_flags().enumerate() {
            if truthy(at(t, key)) {
                flags |= 1u32 << u32.wrap(i)
            }
        }
        let placed = has(t, "rule")
        let placement = if placed { "some({place_in(placements(), text(at(t, "placement")))})" } else { String("none") }
        let heightmap = if placed { place_in(heightmaps(), text(at(t, "heightmap"))) } else { place_in(heightmaps(), "MOTION_BLOCKING_NO_LEAVES") }
        let rule = if placed { "some({place_in(rules, text(at(t, "rule")))})" } else { String("none") }
        lines.push("        // {text(at(t, "id"))}")
        lines.push("        TypeFacts \{ category: {place_in(categories, text(at(t, "category")))}, flags: {flags}, immune_to: {place_in(immune, text(at(t, "immune_to")))}, half_width: {calx_float(num(at(t, "half_width")))}, height: {calx_float(num(at(t, "height")))}, spawn_group: {int(at(t, "spawn_group"))}, placement: {placement}, heightmap: {heightmap}, rule: {rule} \},")
    }
    add(mut lines, [
        "    ]",
        #"}"#,
        "",
        "/// Each state's spawn facts, in state ID order.",
    ])
    add(mut lines, encoded_table("state_spawn_facts", "facts", ints(at(facts, "states"))))
    add(mut lines, attribute_lines(facts))
    add(mut lines, path_lines(facts))
    return lines.join("\n")
}

/// A string as Python's `json.dumps` writes it with `ensure_ascii`: in quotes, with `"`, `\` and
/// the control characters escaped, and everything outside printable ASCII as `\uXXXX`, in two for
/// a rune past U+FFFF.
fn py_string(out: mut String, s: String) {
    out.push_str("\"")
    for r in s.runes() {
        let c = u32(r)
        if c == 0x22 {
            out.push_str("\\\"")
        } else if c == 0x5C {
            out.push_str("\\\\")
        } else if c == 0x0A {
            out.push_str("\\n")
        } else if c == 0x0D {
            out.push_str("\\r")
        } else if c == 0x09 {
            out.push_str("\\t")
        } else if c == 0x08 {
            out.push_str("\\b")
        } else if c == 0x0C {
            out.push_str("\\f")
        } else if c >= 0x20 and c < 0x7F {
            out.push(r)
        } else if c > 0xFFFF {
            let v = c - 0x10000
            out.push_str("\\u{0xD800 + (v >> 10):04x}\\u{0xDC00 + (v & 0x3FF):04x}")
        } else {
            out.push_str("\\u{c:04x}")
        }
    }
    out.push_str("\"")
}

/// JSON as Python's `json.dumps(v, separators=(",", ":"), ensure_ascii=True)` writes it.
fn py_json(out: mut String, v: Json) {
    match v {
        Json.Null => out.push_str("null"),
        Json.Bool(b) => out.push_str(if b { "true" } else { "false" }),
        Json.Int(n) => out.push_str("{n}"),
        Json.UInt(n) => out.push_str("{n}"),
        Json.Big(digits) => out.push_str(digits),
        Json.Float(f) => out.push_str(repr_float(f)),
        Json.Str(s) => py_string(mut out, s),
        Json.Array(xs) => {
            out.push_str("[")
            for (i, x) in xs.enumerate() {
                if i > 0 {
                    out.push_str(",")
                }
                py_json(mut out, x)
            }
            out.push_str("]")
        }
        Json.Object(m) => {
            out.push_str("\{")
            var first = true
            for (k, x) in m {
                if not first {
                    out.push_str(",")
                }
                first = false
                py_string(mut out, k)
                out.push_str(":")
                py_json(mut out, x)
            }
            out.push_str("\}")
        }
    }
}

fn dumped(v: Json) -> String {
    var out = String()
    py_json(mut out, v)
    return out
}

/// JSON text as a Calx string literal holds it, ASCII only, with its quotes, backslashes and
/// braces escaped.
fn calx_json(v: Json) -> String {
    let t = dumped(v).replace("\\", "\\\\").replace("\"", "\\\"").replace("\{", "\\\{").replace("\}", "\\\}")
    return "\"{t}\""
}

fn translation(key: String) -> Json {
    var m = LinkedMap<String, Json>()
    m.insert("translate", Json.Str(key.copy()))
    return Json.Object(m)
}

/// The text of src/world/item_defaults.calx: each item's default components, as items.json has
/// them, vanilla's JSON. The components more than half the items have with one value are written
/// once; each item's model is its name, and its name is the translation of `item.minecraft.<name>`
/// or, for those `block_named_items` lists, `block.minecraft.<name>`; the rest of each item's are a
/// patch of those, with `!` before a shared one it hasn't.
fn item_defaults_module(items_table: Json) -> String {
    let all = items(items_table)
    for (i, item) in all.enumerate() {
        if int(at(item, "id")) != i64.wrap(i) {
            bad("items.json's item IDs don't run from 0 without gaps")
        }
    }
    // Each component and value, as Python's `json.dumps(v, sort_keys=True)` tells them apart, in
    // the order they're first seen, with how many items have it.
    var counts = LinkedMap<String, u64>()
    var seen = Map<String, (String, Json)>()
    for item in all {
        for (k, v) in members(at(item, "components")) {
            let key = "{k}\n{dumped(sort_keys(v))}"
            if counts.contains(key) {
                counts[key] += 1
            } else {
                counts.insert(key.copy(), 1)
                seen.insert(key, (k.copy(), sort_keys(v)))
            }
        }
    }
    var shared = LinkedMap<String, Json>()
    for (key, n) in counts {
        if n * 2 > u64(all.len()) {
            let (k, v) = seen[key].copy()
            if shared.contains(k) {
                bad("{k} is shared with two values")
            }
            shared.insert(k, v)
        }
    }
    for k in ["minecraft:item_model", "minecraft:item_name"] {
        if shared.contains(k) {
            bad("{k} is shared")
        }
    }
    var block_named: List<String> = []
    var patches: List<Json> = []
    for item in all {
        let name = text(at(item, "name"))
        if not name.starts_with("minecraft:") {
            bad("{name} isn't vanilla's")
        }
        let short_name = name.trim_prefix("minecraft:").copy()
        let held = at(item, "components")
        let components = members(held)
        if held.get("minecraft:item_model") != some(Json.Str(name.copy())) {
            bad("{name}'s model isn't its name")
        }
        let item_name = held.get("minecraft:item_name") ?? Json.Null
        if item_name == translation("block.minecraft.{short_name}") {
            block_named.push("{int(at(item, "id"))}")
        } else if item_name != translation("item.minecraft.{short_name}") {
            bad("{name}'s name isn't its translation")
        }
        var patch = LinkedMap<String, Json>()
        for (k, v) in components {
            if k == "minecraft:item_model" or k == "minecraft:item_name" {
                continue
            }
            if let s = shared.find(k) {
                if dumped(sort_keys(v)) == dumped(sort_keys(s)) {
                    continue
                }
            }
            patch.insert(k.copy(), v.copy())
        }
        for (k, _) in shared {
            if not components.contains(k) {
                patch.insert("!{k}", Json.Object(LinkedMap<String, Json>()))
            }
        }
        patches.push(Json.Object(patch))
    }
    var lines: List<String> = [
        "/// Each item's default components, as vanilla's item report gives them in JSON (D362): the",
        "/// ones more than half the items have with one value, once, in `shared_components`, and each",
        "/// item's others in `item_patches`, as a patch of those, with `!` before a shared one the item",
        "/// hasn't. An item's model is its name, and its name the translation of `item.minecraft.` and",
        "/// its name, or of `block.minecraft.` for `block_named_items`. Written by",
        "/// {TOOL} from items.json (D126): don't edit it.",
        "module world.item_defaults",
        "",
        "/// The components more than half the items have, with their value, as a JSON object.",
        "pub fn shared_components() -> str \{",
        "    return {calx_json(Json.Object(shared))}",
        #"}"#,
        "",
        "/// The items named as blocks are, `block.minecraft.<name>`, by ID.",
        "pub fn block_named_items() -> List<u32> \{",
        "    let items: List<u32> = [",
    ]
    add(mut lines, rows_of(block_named, 24))
    add(mut lines, [
        "    ]",
        "    return items",
        #"}"#,
        "",
        "/// Each item's default components besides the shared ones and its model and name, as a patch",
        "/// of the shared ones in JSON, in item ID order.",
        "pub fn item_patches() -> List<str> \{",
        "    return [",
    ])
    for p in patches {
        lines.push("        {calx_json(p)},")
    }
    add(mut lines, ["    ]", #"}"#, ""])
    return lines.join("\n")
}

// The custom suggestions vanilla's arguments ask for, as command_tree.json names them; a node's
// place among them, plus one, is in its facts.
fn suggestions() -> List<String> {
    return ["minecraft:ask_server", "minecraft:available_sounds", "minecraft:summonable_entities", "minecraft:post_effects"]
}

/// The text of src/command/tree.calx: vanilla's command tree, as a dedicated server registers it,
/// from command_tree.json (CAL-165). Each node's parent, so its children are those after it whose
/// parent it is, in order; its facts; its name; its argument type's properties; and the nodes that
/// redirect, and where to.
fn command_tree_module(index: Json, tree: Json) -> String {
    let gv = text(at(index, "game_version"))
    let made = text(at(tree, "game_version"))
    if made != gv {
        bad("command_tree.json is {made}, the tables {gv}")
    }
    let nodes = items(at(tree, "nodes"))
    if text(at(nodes[0], "kind")) != "root" {
        bad("command_tree.json doesn't start at the root")
    }
    var parents: List<i64> = []
    for _ in 0..nodes.len() {
        parents.push(-1)
    }
    for (i, n) in nodes.enumerate() {
        let children = ints(at(n, "children"))
        for c in children {
            let at_c = usize.wrap(c)
            if parents[at_c] != -1 or c <= i64.wrap(i) {
                bad("node {c} isn't a tree's, in the order its walk comes to it")
            }
            parents[at_c] = i64.wrap(i)
        }
        var sorted_children = children.copy()
        sorted_children.sort()
        if sorted_children != children {
            bad("node {i}'s children aren't in the order the walk comes to them")
        }
    }
    for p in parents[1..] {
        if p == -1 {
            bad("a node other than the root has no parent")
        }
    }
    var facts: List<String> = []
    var names: List<String> = []
    var properties: List<String> = []
    var redirects: List<String> = []
    for (i, n) in nodes.enumerate() {
        let kind_name = text(at(n, "kind"))
        let kind: i64 = if kind_name == "root" { 0 } else if kind_name == "literal" { 1 } else if kind_name == "argument" { 2 } else { bad("node {i} is a {kind_name}") }
        let level = int(at(n, "level"))
        if level < 0 or level > 4 {
            bad("node {i} is for no permission level")
        }
        var f = kind | (if truthy(at(n, "executable")) { 4i64 } else { 0i64 }) | (level << 3)
        let name = if has(n, "name") { text(at(n, "name")) } else { String() }
        if name.contains("\"") or name.contains("\\") or name.contains("\{") {
            bad("{name} can't be written in a Calx string")
        }
        names.push(name)
        if kind == 2 {
            let props = from_hex(text(at(n, "properties"))) ?? bad("node {i}'s properties aren't hex")
            let parser = int(at(n, "parser"))
            if props.len() > 127 or parser > 255 {
                bad("node {i}'s argument doesn't fit its facts")
            }
            if has(n, "suggestions") {
                f |= i64.wrap(place_in(suggestions(), text(at(n, "suggestions"))) + 1) << 6
            }
            f |= (i64.wrap(props.len()) << 9) | (parser << 16)
            for b in props {
                properties.push("{b}")
            }
        }
        facts.push("{f}")
        let redirect = int(at(n, "redirect"))
        if redirect >= 0 {
            if not ints(at(n, "children")).is_empty() {
                bad("node {i} redirects and has children")
            }
            redirects.push("{i}")
            redirects.push("{redirect}")
        }
    }
    var lines: List<String> = [
        "/// Vanilla's command tree, as a dedicated server registers it (CAL-165): each node in the",
        "/// order a walk from the root comes to it, a node and then its children's, as",
        "/// `fillUsableCommands` copies them. Written by {TOOL} from",
        "/// command_tree.json, which oracle/datagen/command_tree.calx writes beside the tables: don't",
        "/// edit it.",
        "module command.tree",
        "",
        "/// How many nodes there are, the root first.",
        "pub const NODES: usize = {nodes.len()}",
        "",
        "/// The custom suggestions an argument may ask for, as the packet names them.",
        "pub fn suggestion_names() -> List<str> \{",
        "    return [{strings(suggestions())}]",
        #"}"#,
        "",
        "/// Each node's parent, the root's -1. A node's children are those whose parent it is, in",
        "/// order, as vanilla added them.",
        "pub fn node_parents() -> List<i32> \{",
        "    let values: List<i32> = [",
        "{numbers(shown(parents), 24)},",
        "    ]",
        "    return values",
        #"}"#,
        "",
        "/// Each node's facts: its kind, 0 the root, 1 a literal and 2 an argument; 4 where a",
        "/// command may end there; the lowest permission level that may use it, shifted by 3; for",
        "/// an argument, its custom suggestions' place in `suggestion_names` plus one, or 0 for",
        "/// none, shifted by 6, how many bytes its properties take, shifted by 9, and its type's ID",
        "/// in `command_argument_type`, shifted by 16.",
        "pub fn node_facts() -> List<u32> \{",
        "    let values: List<u32> = [",
        "{numbers(facts, 12)},",
        "    ]",
        "    return values",
        #"}"#,
        "",
        "/// Each node's name, the root's empty: a literal's word or an argument's name.",
        "pub fn node_names() -> List<str> \{",
        "    return [",
    ]
    var k = 0usize
    while k < names.len() {
        let end = (k + 8).min(names.len())
        lines.push("        {strings(names[k..end].copy())},")
        k = end
    }
    add(mut lines, [
        "    ]",
        #"}"#,
        "",
        "/// The arguments' properties, as `ArgumentTypeInfo.serializeToNetwork` writes them, one",
        "/// after another in node order.",
        "pub fn node_properties() -> List<u8> \{",
        "    let values: List<u8> = [",
        "{numbers(properties, 24)},",
        "    ]",
        "    return values",
        #"}"#,
        "",
        "/// Each node that redirects, then the node it redirects to.",
        "pub fn node_redirects() -> List<i32> \{",
        "    let values: List<i32> = [",
        "{numbers(redirects, 24)},",
        "    ]",
        "    return values",
        #"}"#,
        "",
    ])
    return lines.join("\n")
}

fn load(file: String) -> Json {
    let t = match read_text(file) {
        ok(t) => t ?? bad("{file} isn't UTF-8"),
        err(e) => bad("reading {file}: {e}"),
    }
    return match parse(t) {
        ok(j) => j,
        err(e) => bad("{file}: {e}"),
    }
}

/// Each module's path from the repository's root, and its text.
pub fn outputs(tables: String, version: String) -> List<(String, String)> {
    let beside = path.parent_dir(tables) ?? String(".")
    let index = load(path.join(tables, "index.json"))
    let packets = load(path.join(tables, "packets.json"))
    let registries = load(path.join(tables, "registries.json"))
    let blocks = load(path.join(tables, "blocks.json"))
    let pins = load(under("oracle/versions.json"))
    let flags = load(path.join(beside, "block_flags.json"))
    let entities = load(path.join(beside, "entity_facts.json"))
    let items_table = load(path.join(tables, "items.json"))
    let commands = load(path.join(beside, "command_tree.json"))
    let gv = text(at(index, "game_version"))
    return [
        ("src/protocol/ids.calx", ids_module(index, packets)),
        ("src/registry/builtin.calx", builtin_module(index, registries)),
        ("src/pack/pin.calx", pin_module(version, at(pins, version))),
        ("src/world/blocks.calx", blocks_module(index, blocks)),
        ("src/world/block_flags.calx", block_flags_module(gv.copy(), flags)),
        ("src/world/block_facts.calx", block_facts_module(gv.copy(), flags)),
        ("src/world/light_faces.calx", light_faces_module(gv.copy(), flags)),
        ("src/world/collision_shapes.calx", collision_module(gv.copy(), flags)),
        ("src/world/fluid_faces.calx", fluid_faces_module(gv.copy(), flags)),
        ("src/world/movement_shapes.calx", movement_module(gv.copy(), flags)),
        ("src/world/outline_shapes.calx", outline_module(gv.copy(), flags)),
        ("src/world/entity_facts.calx", entity_facts_module(index, entities)),
        ("src/world/item_defaults.calx", item_defaults_module(items_table)),
        ("src/command/tree.calx", command_tree_module(index, commands)),
    ]
}

/// Writes the compiled-in tables Calcite's Calx code needs from the converted tables.
@cli(name: "calx_tables")
struct Args {
    /// Fail if a committed module is out of date.
    check: bool
    /// The game version whose tables to read.
    version: String = "26.3"
    /// The tables folder, instead of generated/<version>/tables.
    tables: String?
}

pub fn main() {
    let args = Args.parse()
    let tables = args.tables ?? under("generated/{args.version}/tables")
    let beside = path.parent_dir(tables) ?? String(".")
    if not exists(path.join(tables, "index.json")) {
        eprintln("no tables at {tables}: run calx oracle/datagen/datagen.calx first")
        exit(2)
    }
    for (file, tool) in [("block_flags.json", "block_flags"), ("entity_facts.json", "entity_facts"), ("command_tree.json", "command_tree")] {
        if not exists(path.join(beside, file)) {
            eprintln("no {file} beside {tables}: run calx oracle/datagen/{tool}.calx first")
            exit(2)
        }
    }
    var stale: List<String> = []
    for (rel, t) in outputs(tables, args.version) {
        let file = under(rel)
        let old: String? = if is_file(file) { match read_text(file) { ok(o) => o, err(_) => none } } else { none }
        if old == some(t.copy()) {
            continue
        }
        if args.check {
            stale.push(rel.copy())
        } else {
            if let folder = path.parent_dir(file) {
                if let err(e) = make_dir_all(folder) {
                    bad("making {folder}: {e}")
                }
            }
            if let err(e) = write_text(file, t.copy()) {
                bad("writing {rel}: {e}")
            }
            println("wrote {rel}")
        }
    }
    for rel in stale {
        eprintln("{rel} is out of date: run calx oracle/datagen/calx_tables.calx")
    }
    if not stale.is_empty() {
        exit(1)
    }
}
