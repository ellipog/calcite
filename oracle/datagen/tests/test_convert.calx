module oracle.datagen.tests.test_convert

// Tests for the converter, oracle/datagen/convert.calx, and the jar fetch step, oracle/fetch.calx.
// No vanilla jar needed:
//
//     calx test oracle/datagen/tests/test_convert.calx
//
// The fetch step stops when a jar doesn't match its pin, so its tests run it in a process of its
// own: a copy of it, with tools/repo.calx, in a folder with a versions.json of its own, which is
// then the repository it works in.

import std.bytes.{hex}
import std.fs.{copy, make_dir_all, read, remove_dir_all, temp_dir, write, write_text}
import std.hash.{sha1}
import std.json.{Json}
import std.path
import std.process.{Command, Output}
import std.regex.{Regex}
import oracle.datagen.convert.{blocks_of, by_id, load, property_kind, registries_of}
import oracle.fetch.{pins}
import tools.rawjson.{Raw, canonical, elements, field, int_of, num, object, parse, strs, text_of}
import tools.repo.{find_calx, under}

fn js(t: String) -> Raw {
    return match parse(t) {
        ok(v) => v,
        err(e) => panic("{t}: {e}"),
    }
}

fn holds(text: String, part: String) {
    assert(text.contains(part), "no {part} in {text}")
}

@test
fn number_text_is_kept() {
    let dir = temp_dir()!
    let file = path.join(dir, "n.json")
    write_text(file, #"{"f": 1.8000001, "d": 0.10000000149011612, "e": 1e-7, "i": 12, "z": -0.0}"#)!
    let value = match load(file) {
        ok(v) => v,
        err(e) => panic(e),
    }
    remove_dir_all(dir)!
    assert(canonical(value) == "\{\n  \"d\": 0.10000000149011612,\n  \"e\": 1e-7,\n  \"f\": 1.8000001,\n  \"i\": 12,\n  \"z\": -0.0\n\}")
}

@test
fn duplicate_keys_are_refused() {
    match parse(#"{"a": 1, "a": 2}"#) {
        ok(_) => panic("a key given twice wasn't refused"),
        err(e) => holds(e, "duplicate key 'a'"),
    }
}

@test
fn the_layout_is_canonical() {
    let value = js(#"{"b": [1, "x", null, true], "a": {"z": [], "y": {}}, "c": [{"k": 1}]}"#)
    assert(canonical(value) == "\{\n  \"a\": \{\n    \"y\": \{\},\n    \"z\": []\n  \},\n  \"b\": [1, \"x\", null, true],\n  \"c\": [\n    \{\n      \"k\": 1\n    \}\n  ]\n\}")
}

// The Python converter refused a float it was handed, `{"x": 0.5}`. A `Raw` has no floats, so a
// number only ever comes in as text.

@test
fn non_ascii_is_written_as_itself() {
    assert(canonical(strs(["é"])) == "[\"é\"]")
}

@test
fn control_characters_are_escaped() {
    assert(canonical(Raw.Str("a\"b\\c\n\t\u{1}")) == "\"a\\\"b\\\\c\\n\\t\\u0001\"")
}

@test
fn a_gap_in_the_ids_is_refused() {
    match by_id(js(#"{"a": {"protocol_id": 0}, "b": {"protocol_id": 2}}"#), "test") {
        ok(_) => panic("a gap wasn't refused"),
        err(e) => holds(e, "test: protocol IDs aren't 0..1"),
    }
}

@test
fn names_are_ordered_by_id() {
    let names = match by_id(js(#"{"b": {"protocol_id": 1}, "a": {"protocol_id": 0}}"#), "test") {
        ok(n) => n,
        err(e) => panic(e),
    }
    assert(names == ["a", "b"])
}

/// A block shaped like a stair: three properties, listed out of name order on purpose. `swap`
/// swaps the first two states' properties, and `two_defaults` makes the first state a default too.
fn stairs_report(swap: bool, two_defaults: bool) -> Raw {
    let props = js(#"{"waterlogged": ["true", "false"], "facing": ["north", "south"], "half": ["top", "bottom"]}"#)
    // Each state's facing, half and waterlogged, in ID order.
    var values: List<List<String>> = []
    for f in ["north", "south"] {
        for h in ["top", "bottom"] {
            for w in ["true", "false"] {
                values.push([String(f), String(h), String(w)])
            }
        }
    }
    if swap {
        let first = values[0].copy()
        values[0] = values[1].copy()
        values[1] = first
    }
    var states: List<Raw> = []
    for (i, v) in values.enumerate() {
        var m = LinkedMap<String, Raw>()
        m.insert("id", num(1 + i64.wrap(i)))
        m.insert("properties", object([("facing", Raw.Str(v[0].copy())), ("half", Raw.Str(v[1].copy())), ("waterlogged", Raw.Str(v[2].copy()))]))
        if (v[0] == "north" and v[1] == "bottom" and v[2] == "false") or (two_defaults and i == 0) {
            m.insert("default", Raw.Bool(true))
        }
        states.push(Raw.Object(m))
    }
    return object([("minecraft:air", js(#"{"states": [{"id": 0, "default": true}]}"#)), ("minecraft:stair", object([("properties", props), ("states", Raw.Array(states))]))])
}

fn registry(names: List<String>) -> Raw {
    var entries = LinkedMap<String, Raw>()
    for (i, n) in names.enumerate() {
        entries.insert(n.copy(), object([("protocol_id", num(i64.wrap(i)))]))
    }
    return object([("minecraft:block", object([("protocol_id", num(0)), ("default", Raw.Str(names[0].copy())), ("entries", Raw.Object(entries))]))])
}

fn converted(report: Raw, names: List<String>) -> Raw ! String {
    return try blocks_of(report, try registries_of(registry(names)))
}

fn stair_names() -> List<String> {
    return ["minecraft:air", "minecraft:stair"]
}

fn int_field(v: Raw, key: String) -> i64 {
    return match field(v, key) {
        ok(x) => match int_of(x) {
            ok(n) => n,
            err(e) => panic(e),
        },
        err(e) => panic(e),
    }
}

fn list_field(v: Raw, key: String) -> List<Raw> {
    return match field(v, key) {
        ok(x) => match elements(x) {
            ok(xs) => xs,
            err(e) => panic(e),
        },
        err(e) => panic(e),
    }
}

@test
fn states_follow_the_mixed_radix_rule() {
    let table = match converted(stairs_report(false, false), stair_names()) {
        ok(t) => t,
        err(e) => panic(e),
    }
    assert(int_field(table, "state_count") == 9)
    let stair = list_field(table, "blocks")[1].copy()
    assert(int_field(stair, "first_state") == 1)
    assert(int_field(stair, "state_count") == 8)
    assert(int_field(stair, "default_state") == 4)
    let properties = list_field(table, "properties")
    var names: List<String> = []
    var refs: List<usize> = []
    for r in list_field(stair, "properties") {
        let at = usize.wrap(int_of(r)!)
        refs.push(at)
        names.push(text_of(field(properties[at], "name")!)!)
    }
    assert(names == ["facing", "half", "waterlogged"], "{names}")
    let want = object([("name", Raw.Str("waterlogged")), ("values", strs(["true", "false"])), ("kind", Raw.Str("bool"))])
    assert(canonical(properties[refs[2]]) == canonical(want))
}

@test
fn a_state_out_of_order_is_refused() {
    match converted(stairs_report(true, false), stair_names()) {
        ok(_) => panic("states out of order weren't refused"),
        err(e) => holds(e, "breaks the mixed-radix rule"),
    }
}

@test
fn a_registry_that_lists_other_blocks_is_refused() {
    match converted(stairs_report(false, false), ["minecraft:air", "minecraft:other"]) {
        ok(_) => panic("another registry wasn't refused"),
        err(e) => holds(e, "list different blocks"),
    }
}

@test
fn two_defaults_are_refused() {
    match converted(stairs_report(false, true), stair_names()) {
        ok(_) => panic("two defaults weren't refused"),
        err(e) => holds(e, "two default states"),
    }
}

fn kind_of(values: List<String>) -> String {
    return match property_kind(values) {
        ok(m) => canonical(Raw.Object(m)),
        err(e) => panic(e),
    }
}

@test
fn property_kinds() {
    assert(kind_of(["0", "1", "2"]) == canonical(object([("kind", Raw.Str("int")), ("min", num(0)), ("max", num(2))])))
    assert(kind_of(["1", "2"]) == canonical(object([("kind", Raw.Str("int")), ("min", num(1)), ("max", num(2))])))
    assert(kind_of(["north", "south"]) == canonical(object([("kind", Raw.Str("enum"))])))
    assert(kind_of(["true", "false"]) == canonical(object([("kind", Raw.Str("bool"))])))
    match property_kind(["0", "2"]) {
        ok(_) => panic("a gap in the values wasn't refused"),
        err(e) => holds(e, "int property values ['0', '2'] aren't consecutive"),
    }
}

fn run_fetch(calx: String, fetch: String, args: List<String>) -> Output {
    var all: List<String> = [fetch.copy()]
    for a in args {
        all.push(a.copy())
    }
    return match Command.new(calx.copy()).args(all).output() {
        ok(o) => o,
        err(e) => panic("starting {calx}: {e}"),
    }
}

@test
fn the_fetch_step_checks_the_pin_offline() {
    let dir = temp_dir()!
    make_dir_all(path.join(dir, "oracle/jars"))!
    make_dir_all(path.join(dir, "tools"))!
    copy(under("oracle/fetch.calx"), path.join(dir, "oracle/fetch.calx"))!
    copy(under("tools/repo.calx"), path.join(dir, "tools/repo.calx"))!
    let data = "not really a jar".to_bytes()
    write_text(path.join(dir, "oracle/versions.json"), "\{\"9.9\": \{\"sha1\": \"{hex(sha1(data.copy()))}\", \"size\": {data.len()}, \"url\": \"http://invalid/\"\}\}")!
    let calx = find_calx()
    let fetch = path.join(dir, "oracle/fetch.calx")
    let jar = path.join(dir, "oracle/jars/server-9.9.jar")

    // A pinned jar that's there is checked without the network.
    write(jar, data.copy())!
    let good = run_fetch(calx, fetch, ["--version", "9.9", "--check"])
    assert(good.status.success(), "the pinned jar was refused: {good.text()}{good.error_text()}")
    holds(good.text(), "matches the pinned SHA-1")

    // One that isn't the pinned jar is refused.
    write(jar, "something else".to_bytes())!
    let wrong = run_fetch(calx, fetch, ["--version", "9.9", "--check"])
    assert(not wrong.status.success(), "a wrong jar was taken")
    holds(wrong.error_text(), "doesn't match the pinned SHA-1")

    // A local jar is installed if it's the pinned one, and refused if not.
    let source = path.join(dir, "mine.jar")
    write(source, data.copy())!
    let installed = run_fetch(calx, fetch, ["--version", "9.9", "--jar", source.copy()])
    assert(installed.status.success(), "the local jar wasn't installed: {installed.error_text()}")
    assert(read(jar)! == data)
    write(source, "something else".to_bytes())!
    let other = run_fetch(calx, fetch, ["--version", "9.9", "--jar", source.copy()])
    assert(not other.status.success(), "a different local jar was installed")
    holds(other.error_text(), "it's a different jar")

    // A version that isn't pinned is refused.
    let unpinned = run_fetch(calx, fetch, ["--version", "1.0", "--check"])
    assert(not unpinned.status.success(), "an unpinned version was taken")
    holds(unpinned.error_text(), "isn't pinned")
    remove_dir_all(dir)!
}

fn text_at(v: Json, pointer: String) -> String {
    if let found = v.pointer(pointer) {
        if let s = found.as_str() {
            return s
        }
    }
    panic("no {pointer}")
}

fn number_at(v: Json, pointer: String) -> i64 {
    if let found = v.pointer(pointer) {
        if let n = found.as_i64() {
            return n
        }
    }
    panic("no {pointer}")
}

@test
fn the_repository_pins_are_well_formed() {
    var sha1_hex = Regex.python("[0-9a-f]\{40\}")!
    var sha256_hex = Regex.python("[0-9a-f]\{64\}")!
    for (version, pin) in pins() {
        let sha = text_at(pin, "/sha1")
        assert(sha1_hex.full_match(sha) != none, "{version}'s SHA-1 {sha}")
        holds(text_at(pin, "/url"), sha)
        assert(number_at(pin, "/size") > 0, "{version}'s size")
        holds(text_at(pin, "/client/url"), text_at(pin, "/client/sha1"))
        let data_sha = text_at(pin, "/client/data/sha256")
        assert(sha256_hex.full_match(data_sha) != none, "{version}'s data SHA-256 {data_sha}")
        assert(number_at(pin, "/client/data/offset") + number_at(pin, "/client/data/length") < number_at(pin, "/client/size"), "{version}'s data stretch")
    }
}
