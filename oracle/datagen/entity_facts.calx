module oracle.datagen.entity_facts

// Writes generated/<version>/entity_facts.json: what natural spawning asks of each entity type and
// block state, from vanilla's own types and states, which the data generator's reports don't hold
// (D317).
//
//     calx oracle/datagen/entity_facts.calx
//
// It runs EntityFacts from the vanilla adapter, which oracle/adapter.calx builds, so the adapter
// has to be built first. The file is beside tables/, not in it, since the converter replaces
// tables/ whole. calx_tables reads it for src/world/entity_facts.calx.

import std.cli.{cli}
import std.json.{Json}
import oracle.adapter.{generate}

/// Writes generated/<version>/entity_facts.json from vanilla's entity types and states.
@cli(name: "entity_facts")
struct Args {
    /// The game version.
    version: String = "26.3"
}

pub fn main() {
    let args = Args.parse()
    let g = generate("entity_facts", "EntityFacts", "entity_facts.json", args.version)
    let types = g.doc.get("types") ?? Json.Null
    let states = g.doc.get("states") ?? Json.Null
    println("wrote {g.rel}: {types.len()} entity types, {states.len()} states")
}
