module oracle.datagen.datagen

// Regenerates every table from Mojang's server jar in one command (P2.1, gate G2.1).
//
//     calx oracle/datagen/datagen.calx [--version 26.3] [--java-home PATH]
//     calx oracle/datagen/datagen.calx --check    regenerate in a scratch folder and compare (G2.2)
//
// Fetches and verifies the jar (oracle/fetch.calx), runs Mojang's data generator with JDK 25 into
// generated/<version>/datagen/, deletes the generator's .cache/ folder (it holds timestamps and is
// the only output that changes between runs), then converts the reports into
// generated/<version>/tables/ (convert.calx). generated/ is gitignored (D30).
//
// --check leaves generated/<version>/ alone: it regenerates into build/datagen/check/ and reports
// any file whose bytes differ, so a regeneration that isn't repeatable is caught.

import std.cli.{cli}
import std.fs.{Kind, exists, is_file, make_dir_all, read, remove_dir_all, walk, write}
import std.path
import std.process.{Command, Stdio, exit}
import std.time.{Instant}
import oracle.datagen.convert.{convert, table_count}
import oracle.fetch.{ensure}
import oracle.jdk.{find_java_home, java}
import tools.repo.{die, under}

// The rig's reference configuration (D60). The reports are data, but this keeps every vanilla run
// Calcite compares against on the same floating-point behavior.
fn jvm_flags() -> List<String> {
    return ["-XX:+UnlockDiagnosticVMOptions", "-XX:-UseLibmIntrinsic"]
}

fn make(folder: String) {
    if let err(e) = make_dir_all(folder) {
        die("datagen: making {folder}: {e}")
    }
}

/// Runs the data generator and the converter into `base`: generated/<version>/ or a scratch copy.
fn generate(version: String, java_home: String, base: String) {
    let jar = ensure(version.copy(), true)
    let datagen = path.join(base, "datagen")
    if exists(datagen) {
        if let err(e) = remove_dir_all(datagen) {
            die("datagen: removing {datagen}: {e}")
        }
    }
    make(base)
    let log = under("build/datagen/{version}.log")
    make(path.parent_dir(log) ?? String("."))
    // The bundler unpacks its libraries relative to the working directory, so it runs in
    // oracle/work/.
    let work = under("oracle/work")
    make(work)
    let start = unsafe { Instant.now() }
    let r = match Command.new(java(java_home)).args(jvm_flags()).args(["-DbundlerMainClass=net.minecraft.data.Main", "-jar", jar, "--all", "--output", datagen.copy()]).dir(work).stderr(Stdio.Stdout).output() {
        ok(o) => o,
        err(e) => die("datagen: starting the data generator: {e}"),
    }
    if let err(e) = write(log, r.stdout.copy()) {
        die("datagen: writing {log}: {e}")
    }
    if not r.status.success() {
        let code = if let c = r.status.code { "{c}" } else { "{r.status}" }
        die("datagen: the data generator failed with exit code {code}; see {log}")
    }
    let cache = path.join(datagen, ".cache")
    if exists(cache) {
        if let err(_) = remove_dir_all(cache) {
            eprintln("datagen: couldn't remove {cache}")
        }
    }
    let seconds = unsafe { Instant.now() }.secs_since(start)
    println("datagen: generated {files(datagen).len():,} files in {seconds:.1}s (log: {log})")
    let tables = path.join(base, "tables")
    match convert(version, path.join(datagen, "reports"), tables) {
        ok(index) => println("datagen: wrote {table_count(index)} tables to {tables}"),
        err(e) => die("datagen: convert: {e}"),
    }
}

/// The files under `folder`, by their paths from it written with `/`, sorted.
fn files(folder: String) -> List<String> {
    let entries = match walk(folder) {
        ok(list) => list,
        err(e) => die("datagen: listing {folder}: {e}"),
    }
    let prefix = path.normalize(folder)
    var out: List<String> = []
    for entry in entries {
        if entry.kind != Kind.File {
            continue
        }
        let full = path.normalize(entry.path)
        out.push(full.trim_prefix(prefix).trim_prefix("/").copy())
    }
    out.sort()
    return out
}

fn bytes_of(file: String) -> List<u8> {
    return match read(file) {
        ok(b) => b,
        err(e) => die("datagen: reading {file}: {e}"),
    }
}

/// The paths from `a` and `b` that are missing from one of them or differ in bytes: the missing
/// ones first, then the different, each sorted.
fn compare(a: String, b: String) -> List<String> {
    let fa = files(a)
    let fb = files(b)
    var in_a = Set<String>()
    for p in fa {
        in_a.insert(p.copy())
    }
    var in_b = Set<String>()
    for p in fb {
        in_b.insert(p.copy())
    }
    var missing: List<String> = []
    var different: List<String> = []
    for p in fa {
        if not in_b.contains(p) {
            missing.push(p.copy())
        } else if bytes_of(path.join(a, p)) != bytes_of(path.join(b, p)) {
            different.push(p.copy())
        }
    }
    for p in fb {
        if not in_a.contains(p) {
            missing.push(p.copy())
        }
    }
    missing.sort()
    for p in different {
        missing.push(p.copy())
    }
    return missing
}

/// Regenerate every table from the server jar.
@cli(name: "datagen")
struct Args {
    /// The game version.
    version: String = "26.3"
    /// The JDK 25 to run the data generator with.
    java_home: String?
    /// Regenerate into a scratch folder and compare with generated/<version>/.
    check: bool
}

pub fn main() {
    let args = Args.parse()
    let java_home = find_java_home(args.java_home)
    let base = under("generated/{args.version}")
    if not args.check {
        generate(args.version, java_home, base)
        return
    }
    if not is_file(path.join(base, "tables/index.json")) {
        die("datagen: nothing to compare against; run datagen.calx first")
    }
    let scratch = under("build/datagen/check")
    generate(args.version, java_home, scratch)
    // Only what this writes: generated/<version>/ also holds what the vanilla adapter's tools write
    // beside the tables, such as block_flags.json.
    var diffs: List<String> = []
    var count = 0usize
    for part in ["datagen", "tables"] {
        for p in compare(path.join(base, part), path.join(scratch, part)) {
            diffs.push("{part}/{p}")
        }
        count += files(path.join(base, part)).len()
    }
    if not diffs.is_empty() {
        println("datagen: {diffs.len()} files differ between {base} and {scratch}:")
        for p in diffs[..diffs.len().min(50)] {
            println("  {p}")
        }
        exit(1)
    }
    if let err(e) = remove_dir_all(scratch) {
        die("datagen: removing {scratch}: {e}")
    }
    println("datagen: the regeneration matches generated/{args.version}/datagen and tables byte for byte ({count:,} files)")
}
