module oracle.datagen.block_tables

// calx_tables' modules from block_flags.json: world.block_flags, world.block_facts,
// world.light_faces, world.fluid_faces, world.collision_shapes, world.outline_shapes and
// world.movement_shapes.

import std.json.{Json}
import std.text.python.{repr_float}
import oracle.datagen.tablekit.{LINE, TOOL, add, alphabet, at, bad, calx_float, chunked, encoded_table, int, ints, items, joined, joined_u64, maybe_text, members, num, number_list, numbers, palette, places, rows_of, shown, single, text, texts}

/// The lists of integers of the array `v`.
fn int_rows(v: Json) -> List<List<i64>> {
    var out: List<List<i64>> = []
    for x in items(v) {
        out.push(ints(x))
    }
    return out
}

/// Each state's count, checked against `states`.
fn states_of(flags: Json) -> usize {
    return usize.wrap(int(at(flags, "states")))
}

// The flags block_flags.json gives each state, as calcite.rig.vanilla.BlockFlags sets them.
fn flag_list() -> List<(String, i64, String)> {
    return [
        ("AIR", 1, "`isAir`: air, cave air and void air"),
        ("RANDOMLY_TICKING", 1 << 1, "`isRandomlyTicking`: the state takes random ticks"),
        ("FLUID", 1 << 2, "The state's fluid isn't empty: water, lava, or a waterlogged block"),
        ("FLUID_RANDOMLY_TICKING", 1 << 3, "The state's fluid takes random ticks: lava"),
        ("PROPAGATES_SKYLIGHT_DOWN", 1 << 4, "`propagatesSkylightDown`: skylight goes down through it undimmed"),
        ("SHAPE_FOR_LIGHT_OCCLUSION", 1 << 5, "`useShapeForLightOcclusion`: light is stopped by its faces, not the whole block"),
        ("CAN_OCCLUDE", 1 << 6, "`canOcclude`"),
        ("SOLID_RENDER", 1 << 7, "`isSolidRender`: a full, opaque cube"),
        ("BLOCK_ENTITY", 1 << 8, "`hasBlockEntity`"),
        ("COLLISION_TOP_FULL", 1 << 9, "`Block.isFaceFull` of its collision shape on `UP`: something can stand on all of its top"),
        ("LARGE_COLLISION", 1 << 10, "`hasLargeCollisionShape`: its collision shape reaches out of its block, or changes with where it is"),
        ("OFFSET", 1 << 11, "`hasOffsetFunction`: its shapes are moved in its block by where it is, as bamboo's"),
    ]
}

const LOW_MASK: i64 = (1 << 12) - 1
const LIGHT_EMISSION_SHIFT: i64 = 12
const LIGHT_DAMPENING_SHIFT: i64 = 16

/// The text of src/world/block_flags.calx.
pub fn block_flags_module(gv: String, flags: Json) -> String {
    let values = ints(at(flags, "flags"))
    let made = text(at(flags, "game_version"))
    if made != gv {
        bad("block_flags.json is {made}, the tables {gv}")
    }
    if values.len() != states_of(flags) {
        bad("block_flags.json has {values.len()} flags for {states_of(flags)} states")
    }
    var known = 0i64
    for (_, bit, _) in flag_list() {
        known += bit
    }
    for (state, v) in values.enumerate() {
        if v & LOW_MASK & ~known != 0 or v >> 20 != 0 {
            bad("state {state}'s flags {v:#x} have bits this script doesn't know")
        }
    }
    var lines: List<String> = [
        "/// What each of vanilla {gv}'s block states is, as the game's state cache holds it, in state ID",
        "/// order. Written by {TOOL} from block_flags.json (D164): don't edit it.",
        "module world.block_flags",
        "",
    ]
    for (name, bit, what) in flag_list() {
        lines.push("/// {what}.")
        lines.push("pub const {name}: u32 = {bit}")
    }
    add(mut lines, [
        "",
        "/// Where a state's light emission, 0 to 15, is in its flags.",
        "pub const LIGHT_EMISSION_SHIFT: u32 = {LIGHT_EMISSION_SHIFT}",
        "/// Where a state's light dampening, 0 to 15, is in its flags: how much light it takes away.",
        "pub const LIGHT_DAMPENING_SHIFT: u32 = {LIGHT_DAMPENING_SHIFT}",
        "",
        "/// Each state's flags, in state ID order.",
    ])
    add(mut lines, encoded_table("state_flags", "flags", values))
    return lines.join("\n")
}

// The facts block_flags.json gives each state for features, as calcite.rig.vanilla.BlockFlags
// sets them.
fn fact_list() -> List<(String, i64, String)> {
    return [
        ("SOLID", 1, "`isSolid`: the legacy solidity, from its collision shape's size"),
        ("REPLACEABLE", 1 << 1, "`canBeReplaced()`: a block placed on it replaces it"),
        ("COLLISION_EMPTY", 1 << 2, "Its collision shape at the origin of an empty world is empty"),
        ("COLLISION_FULL_BLOCK", 1 << 3, "`isCollisionShapeFullBlock` at the origin of an empty world"),
        ("LIQUID", 1 << 4, "`liquid`: the block is water or lava itself"),
        ("IGNITED_BY_LAVA", 1 << 5, "`ignitedByLava`"),
        ("REDSTONE_CONDUCTOR", 1 << 6, "`isRedstoneConductor` at the origin of an empty world"),
    ]
}

const STURDY_FULL_SHIFT: i64 = 7
const STURDY_CENTER_SHIFT: i64 = 13
const STURDY_RIGID_SHIFT: i64 = 19
const COLLISION_FACE_SHIFT: i64 = 25
const COLLISION_TOP_ANY: i64 = 1 << 31
const FLUID_TYPE_SHIFT: i64 = 32
const FLUID_AMOUNT_SHIFT: i64 = 36
const OCCLUSION_FACE_SHIFT: i64 = 40

/// Python's `str.capitalize` of an ASCII word.
fn capitalized(word: String) -> String {
    if word.is_empty() {
        return String()
    }
    return "{word[..1].to_upper_root()}{word[1..].to_lower_root()}"
}

/// The text of src/world/block_facts.calx.
pub fn block_facts_module(gv: String, flags: Json) -> String {
    let values = ints(at(flags, "facts"))
    let classes = texts(at(flags, "classes"))
    if values.len() != states_of(flags) {
        bad("block_flags.json has {values.len()} facts for {states_of(flags)} states")
    }
    var known = 0i64
    for (_, bit, _) in fact_list() {
        known += bit
    }
    for (state, v) in values.enumerate() {
        if v & ((1 << STURDY_FULL_SHIFT) - 1) & ~known != 0 {
            bad("state {state}'s facts {v:#x} have bits this script doesn't know")
        }
    }
    let parents = members(at(flags, "class_parents"))
    var name_set = Set<String>()
    for c in classes {
        name_set.insert(c.copy())
    }
    for (child, parent) in parents {
        name_set.insert(child.copy())
        if let p = maybe_text(parent) {
            name_set.insert(p)
        }
    }
    var names: List<String> = []
    for n in name_set {
        names.push(n.copy())
    }
    names.sort()
    var where = Map<String, i64>()
    for (i, c) in names.enumerate() {
        where.insert(c.copy(), i64.wrap(i))
    }
    let none_at = i64.wrap(names.len())
    var lines: List<String> = [
        "/// What vanilla {gv}'s features ask of each block state and block, in state and block ID order.",
        "/// Written by {TOOL} from block_flags.json (CAL-84): don't edit it.",
        "module world.block_facts",
        "",
    ]
    for (name, bit, what) in fact_list() {
        lines.push("/// {what}.")
        lines.push("pub const {name}: u32 = {bit}")
    }
    add(mut lines, [
        "",
        "/// Where the faces that are sturdy for `SupportType.FULL` are in a state's facts, a bit each, in",
        "/// `Direction` order: down, up, north, south, west, east.",
        "pub const STURDY_FULL_SHIFT: u32 = {STURDY_FULL_SHIFT}",
        "/// Where the faces sturdy for `SupportType.CENTER` are.",
        "pub const STURDY_CENTER_SHIFT: u32 = {STURDY_CENTER_SHIFT}",
        "/// Where the faces sturdy for `SupportType.RIGID` are.",
        "pub const STURDY_RIGID_SHIFT: u32 = {STURDY_RIGID_SHIFT}",
        "/// Where the faces its collision shape covers whole are: `Block.isFaceFull` of it.",
        "pub const COLLISION_FACE_SHIFT: u32 = {COLLISION_FACE_SHIFT}",
        "/// Its collision shape touches the top of its block anywhere.",
        "pub const COLLISION_TOP_ANY: u32 = {COLLISION_TOP_ANY}",
        "",
        "/// Each state's facts, in state ID order.",
    ])
    var low: List<i64> = []
    var fluids: List<i64> = []
    var occlusion: List<i64> = []
    for v in values {
        low.push(v & 0xFFFFFFFFi64)
        fluids.push((((v >> FLUID_TYPE_SHIFT) & 7) << 4) | ((v >> FLUID_AMOUNT_SHIFT) & 15))
        occlusion.push((v >> OCCLUSION_FACE_SHIFT) & 63)
    }
    add(mut lines, encoded_table("state_facts", "facts", low))
    add(mut lines, [
        "/// Each state's fluid, in state ID order: its amount, 0 to 8, in the low 4 bits, and above them",
        "/// its fluid's ID in the fluid registry.",
    ])
    add(mut lines, encoded_table("state_fluids", "fluids", fluids))
    add(mut lines, [
        "/// Which of each state's faces its occlusion shape covers whole, in state ID order:",
        "/// `Block.isShapeFullBlock` of `getFaceOcclusionShape`, a bit for each face in `Direction` order.",
    ])
    add(mut lines, encoded_table("state_occlusion", "occlusion", occlusion))
    // `BlockState.rotate` and `mirror`, each as how far the state it makes is from the state, so
    // that most are 0 and the rest few. Turning 180 and counterclockwise is turning clockwise twice
    // and three times, for every state, so only the clockwise turn is written.
    var turned = Map<i64, List<i64>>()
    for t in int_rows(at(flags, "turns")) {
        turned.insert(t[0], t.copy())
    }
    var cw: List<i64> = []
    for s in 0..values.len() {
        let state = i64.wrap(s)
        cw.push(if let t = turned.find(state) { t[1] } else { state })
    }
    for (s, t) in turned {
        let once = usize.wrap(cw[usize.wrap(s)])
        if cw[once] != t[2] or cw[usize.wrap(cw[once])] != t[3] {
            bad("state {s}'s turns aren't one clockwise turn made two and three times")
        }
    }
    let turn_kinds: List<(String, String, String)> = [
        ("state_turns", "turns", "turned clockwise a quarter: `rotate(Rotation.CLOCKWISE_90)`"),
        ("state_mirrors_left_right", "mirrors", "mirrored left to right: `mirror(Mirror.LEFT_RIGHT)`"),
        ("state_mirrors_front_back", "mirrors", "mirrored front to back: `mirror(Mirror.FRONT_BACK)`"),
    ]
    for (i, (fn_name, what, doc)) in turn_kinds.enumerate() {
        let column = if i == 0 { 1usize } else { i + 3 }
        var made: List<i64> = []
        for s in 0..values.len() {
            let state = i64.wrap(s)
            made.push(if let t = turned.find(state) { t[column] } else { state })
        }
        // src/worldgen/facts.calx keeps them as i16s.
        for (s, m) in made.enumerate() {
            let d = m - i64.wrap(s)
            if d > 32767 or d < -32767 {
                bad("a state is further than an i16 from what it is {doc}")
            }
        }
        lines.push("/// How far each state is from what it is {doc}, in state ID order, as a u32 that wraps.")
        var wrapped: List<i64> = []
        for (s, m) in made.enumerate() {
            wrapped.push((m - i64.wrap(s)) & 0xFFFFFFFFi64)
        }
        add(mut lines, encoded_table(fn_name, what, wrapped))
    }
    add(mut lines, [
        "/// The names of the classes vanilla's blocks are and the classes they extend, sorted: an",
        "/// anonymous class by the class it extends.",
        "pub fn class_names() -> List<String> \{",
        "    let names: List<String> = [",
    ])
    for n in names {
        lines.push("        \"{n}\",")
    }
    add(mut lines, [
        "    ]",
        "    return names",
        #"}"#,
        "",
        "/// Each block's class, as an index into `class_names`, in block ID order.",
    ])
    var block_classes: List<i64> = []
    for c in classes {
        block_classes.push(where[c])
    }
    add(mut lines, number_list("block_classes", "classes", block_classes, []))
    var class_parents: List<i64> = []
    for n in names {
        var p = none_at
        if let found = parents.find(n) {
            if let parent = maybe_text(found) {
                p = where[parent]
            }
        }
        class_parents.push(p)
    }
    add(mut lines, number_list("class_parents", "parents", class_parents, ["/// Each class's superclass, by its index in `class_names`, in their order: {none_at} for none."]))
    add(mut lines, number_list("survive_classes", "classes", class_column(flags, where, none_at, "survive_classes"), ["/// The class whose `canSurvive` each block runs, by its index in `class_names`, in block ID order."]))
    add(mut lines, number_list("place_on_classes", "classes", class_column(flags, where, none_at, "place_on_classes"), ["/// The class whose `mayPlaceOn` each block runs, {none_at} for none, in block ID order."]))
    add(mut lines, number_list("shape_classes", "classes", class_column(flags, where, none_at, "shape_classes"), ["/// The class whose `updateShape` each block runs, by its index in `class_names`, in block ID order."]))
    for (fn_name, method) in [("neighbour_classes", "neighborChanged"), ("place_classes", "onPlace"), ("removal_classes", "affectNeighborsAfterRemoval"), ("tick_classes", "tick")] {
        add(mut lines, number_list(fn_name, "classes", class_column(flags, where, none_at, fn_name), ["/// The class whose `{method}` each block runs, by its index in `class_names`, in block ID order (D325)."]))
    }
    add(mut lines, number_list("random_tick_classes", "classes", class_column(flags, where, none_at, "random_tick_classes"), ["/// The class whose `randomTick` each block runs, by its index in `class_names`, in block ID order (D338)."]))
    add(mut lines, number_list("precipitation_classes", "classes", class_column(flags, where, none_at, "precipitation_classes"), ["/// The class whose `handlePrecipitation` each block runs, by its index in `class_names`, in block ID order", "/// (D340)."]))
    for (fn_name, method) in [("signal_classes", "getSignal"), ("direct_signal_classes", "getDirectSignal"), ("own_signal_classes", "ownSignal"), ("signal_source_classes", "isSignalSource")] {
        add(mut lines, number_list(fn_name, "classes", class_column(flags, where, none_at, fn_name), ["/// The class whose `{method}` each block runs, by its index in `class_names`, in block ID order", "/// (CAL-116)."]))
    }
    for (fn_name, method) in [("has_analog_classes", "hasAnalogOutputSignal"), ("analog_classes", "getAnalogOutputSignal")] {
        add(mut lines, number_list(fn_name, "classes", class_column(flags, where, none_at, fn_name), ["/// The class whose `{method}` each block runs, by its index in `class_names`, in block ID order", "/// (CAL-123)."]))
    }
    for (fn_name, method) in [("placement_classes", "getStateForPlacement"), ("replace_classes", "canBeReplaced(BlockPlaceContext)"), ("placed_by_classes", "setPlacedBy"), ("use_item_classes", "useItemOn"), ("use_classes", "useWithoutItem")] {
        add(mut lines, number_list(fn_name, "classes", class_column(flags, where, none_at, fn_name), ["/// The class whose `{method}` each block runs, by its index in `class_names`, in block ID order", "/// (CAL-139)."]))
    }
    let block_items = items(at(flags, "block_items"))
    var kind_set = Set<String>()
    for b in block_items {
        kind_set.insert(text(items(b)[2]))
    }
    var kinds: List<String> = []
    for k in kind_set {
        kinds.push(k.copy())
    }
    kinds.sort()
    add(mut lines, [
        "/// The classes block items are, by name, sorted (CAL-139).",
        "pub fn block_item_kind_names() -> List<str> \{",
        "    return [",
    ])
    for k in kinds {
        lines.push("        \"{k}\",")
    }
    add(mut lines, ["    ]", #"}"#, ""])
    var item_triples: List<i64> = []
    var walls: List<i64> = []
    for b in block_items {
        let parts = items(b)
        let kind = text(parts[2])
        var place = 0i64
        for (i, k) in kinds.enumerate() {
            if k == kind {
                place = i64.wrap(i)
            }
        }
        item_triples.push(int(parts[0]))
        item_triples.push(int(parts[1]))
        item_triples.push(place)
        if int(parts[3]) >= 0 {
            walls.push(int(parts[0]))
            walls.push(int(parts[3]))
            walls.push(int(parts[4]))
        }
    }
    add(mut lines, number_list("block_items", "items", item_triples, ["/// Each block item, `BlockItem`, by its ID in the item registry, followed by its block's ID and its", "/// class's index in `block_item_kind_names`: three numbers an item, in item ID order (CAL-139)."]))
    add(mut lines, number_list("wall_block_items", "items", walls, ["/// Each `StandingAndWallBlockItem`, by item ID, followed by its wall block's ID and the 3D data", "/// value of its `attachmentDirection`: three numbers an item (CAL-139)."]))
    add(mut lines, number_list("items_of_blocks", "items", ints(at(flags, "items_of_blocks")), ["/// Each block's item, `asItem`, by its ID in the item registry, air's 0 for none, in block ID", "/// order (CAL-139)."]))
    let sounds = items(at(flags, "place_sounds"))
    add(mut lines, [
        "/// The sound types of blocks, by the sound event each is placed with, its name, each with its",
        "/// volume and pitch in `place_sound_volumes` and `place_sound_pitches` (CAL-139), and its step and",
        "/// fall sounds in `step_sound_names` and `fall_sound_names` (CAL-155).",
        "pub fn place_sound_names() -> List<str> \{",
        "    return [",
    ])
    for v in sounds {
        lines.push("        \"{text(items(v)[0])}\",")
    }
    add(mut lines, ["    ]", #"}"#, ""])
    for (fn_name, place, what) in [("step_sound_names", 3usize, "step"), ("fall_sound_names", 4usize, "fall")] {
        add(mut lines, [
            "/// Each of `place_sound_names`' sound type's {what} sound, `SoundType.get{capitalized(String(what))}Sound`, by",
            "/// the sound event's name (CAL-155).",
            "pub fn {fn_name}() -> List<str> \{",
            "    return [",
        ])
        for v in sounds {
            lines.push("        \"{text(items(v)[place])}\",")
        }
        add(mut lines, ["    ]", #"}"#, ""])
    }
    for (fn_name, place, what) in [("place_sound_volumes", 1usize, "volume"), ("place_sound_pitches", 2usize, "pitch")] {
        var floats: List<String> = []
        for v in sounds {
            floats.push(calx_float(num(items(v)[place])))
        }
        add(mut lines, [
            "/// Each of `place_sound_names`' sound type's {what}, `SoundType.get{capitalized(String(what))}` (CAL-139).",
            "pub fn {fn_name}() -> List<f32> \{",
            "    let values: List<f32> = [",
        ])
        add(mut lines, rows_of(floats, 16))
        add(mut lines, ["    ]", "    return values", #"}"#, ""])
    }
    let state_sounds = ints(at(flags, "state_place_sounds"))
    if state_sounds.len() != states_of(flags) {
        bad("block_flags.json hasn't a place sound for each state")
    }
    lines.push("/// Each state's sound type, by its index in `place_sound_names`, in state ID order (CAL-139).")
    add(mut lines, encoded_table("state_place_sounds", "sounds", state_sounds))
    let stacks = items(at(flags, "item_stack_sizes"))
    add(mut lines, [
        "/// The items whose default `max_stack_size` isn't 64, by name, in item ID order (CAL-123).",
        "pub fn small_stack_items() -> List<str> \{",
        "    return [",
    ])
    var sizes: List<i64> = []
    for s in stacks {
        let parts = items(s)
        lines.push("        \"{text(parts[0])}\",")
        sizes.push(int(parts[1]))
    }
    add(mut lines, ["    ]", #"}"#, ""])
    add(mut lines, number_list("small_stack_sizes", "sizes", sizes, ["/// Each of `small_stack_items`' default `max_stack_size`, in their order."]))
    add(mut lines, number_list("push_reactions", "reactions", ints(at(flags, "push_reactions")), ["/// Each block's `getPistonPushReaction`, by `PushReaction`'s ordinal, in block ID order (CAL-125)."]))
    add(mut lines, number_list("unbreakable_blocks", "blocks", ints(at(flags, "unbreakable_blocks")), ["/// The blocks whose destroy speed is -1, which a piston can't move, by ID (CAL-125)."]))
    var speeds: List<String> = []
    for v in items(at(flags, "destroy_speeds")) {
        speeds.push(calx_float(num(v)))
    }
    add(mut lines, [
        "/// Each block's destroy speed, `getDestroySpeed`, in block ID order, -1 for one that can't be",
        "/// broken (D376).",
        "pub fn destroy_speeds() -> List<f32> \{",
        "    let speeds: List<f32> = [",
    ])
    add(mut lines, rows_of(speeds, 16))
    add(mut lines, ["    ]", "    return speeds", #"}"#, ""])
    add(mut lines, number_list("needs_tool_blocks", "blocks", ints(at(flags, "needs_tool_blocks")), ["/// The blocks that drop nothing unless dug with the right tool, `requiresCorrectToolForDrops`,", "/// by ID (D376)."]))
    let tables = items(at(flags, "loot_tables"))
    var table_blocks: List<i64> = []
    for t in tables {
        table_blocks.push(int(items(t)[0]))
    }
    add(mut lines, number_list("loot_table_blocks", "blocks", table_blocks, ["/// The blocks whose loot table, `getLootTable`, isn't `blocks/` and their name, by ID, whose", "/// `loot_table_names` give theirs in their order (CAL-153)."]))
    add(mut lines, [
        "/// For each of `loot_table_blocks` in their order, its loot table, empty for none (CAL-153).",
        "pub fn loot_table_names() -> List<str> \{",
        "    return [",
    ])
    for t in tables {
        lines.push("        \"{maybe_text(items(t)[1]) ?? String()}\",")
    }
    add(mut lines, ["    ]", #"}"#, ""])
    let ranges = items(at(flags, "xp_ranges"))
    var range_blocks: List<i64> = []
    var uniform: List<i64> = []
    var least: List<i64> = []
    var most: List<i64> = []
    for r in ranges {
        let parts = items(r)
        range_blocks.push(int(parts[0]))
        uniform.push(if text(parts[1]) == "uniform" { 1 } else { 0 })
        least.push(int(parts[2]))
        most.push(int(parts[3]))
    }
    add(mut lines, number_list("xp_range_blocks", "blocks", range_blocks, ["/// The blocks that drop experience from their own `xpRange`, a `DropExperienceBlock`'s or a", "/// `SculkCatalystBlock`'s, by ID, whose `xp_range_uniform`, `xp_range_least` and", "/// `xp_range_most` give theirs in their order (CAL-154)."]))
    add(mut lines, number_list("xp_range_uniform", "uniform", uniform, ["/// For each of `xp_range_blocks` in their order, 1 where its range is a `UniformInt`, which", "/// draws, 0 where it's a `ConstantInt`, which doesn't (CAL-154)."]))
    add(mut lines, number_list("xp_range_least", "least", least, ["/// For each of `xp_range_blocks` in their order, the least experience it drops (CAL-154)."]))
    add(mut lines, number_list("xp_range_most", "most", most, ["/// For each of `xp_range_blocks` in their order, the most experience it drops (CAL-154)."]))
    let toggles = items(at(flags, "toggle_sounds"))
    var toggle_blocks: List<i64> = []
    for t in toggles {
        toggle_blocks.push(int(items(t)[0]))
    }
    add(mut lines, number_list("toggle_sound_blocks", "blocks", toggle_blocks, ["/// The doors, trapdoors, fence gates, buttons and pressure plates, by ID, whose sounds", "/// `toggle_sounds_on` and `toggle_sounds_off` give in their order (CAL-124)."]))
    for (fn_name, place, what) in [("toggle_sounds_on", 1usize, "opening or pressed"), ("toggle_sounds_off", 2usize, "closing or let go")] {
        add(mut lines, [
            "/// The sound each of `toggle_sound_blocks` plays {what}, by the sound event's name (CAL-124).",
            "pub fn {fn_name}() -> List<str> \{",
            "    return [",
        ])
        for t in toggles {
            lines.push("        \"{text(items(t)[place])}\",")
        }
        add(mut lines, ["    ]", #"}"#, ""])
    }
    for (key, blocks_fn, values_fn, what) in [("button_ticks", "button_tick_blocks", "button_ticks", "how many ticks each stays pressed, `ticksToStayPressed`"), ("plate_weights", "plate_weight_blocks", "plate_weights", "how many entities each weighs at most, `maxWeight`")] {
        let pairs = int_rows(at(flags, key))
        let kind = if key == "button_ticks" { "buttons" } else { "weighted pressure plates" }
        var bs: List<i64> = []
        var vs: List<i64> = []
        for p in pairs {
            bs.push(p[0])
            vs.push(p[1])
        }
        add(mut lines, number_list(blocks_fn, "blocks", bs, ["/// The {kind}, by ID, whose `{values_fn}` give {what} (CAL-128)."]))
        add(mut lines, number_list(values_fn, "values", vs, ["/// For each of `{blocks_fn}` in their order, {what} (CAL-128)."]))
    }
    add(mut lines, number_list("flammable_blocks", "blocks", ints(at(flags, "flammable_blocks")), ["/// The blocks fire can burn, by ID: those `FireBlock`'s ignite odds are above 0 for."]))
    var odds: List<i64> = []
    for each in int_rows(at(flags, "fire_odds")) {
        for v in each {
            odds.push(v)
        }
    }
    add(mut lines, number_list("fire_odds", "odds", odds, ["/// Each block either of `FireBlock`'s odds is above 0 for, by ID, then its ignite odds and its", "/// burn odds: three numbers a block (D339)."]))
    add(mut lines, number_list("waterloggable_blocks", "blocks", ints(at(flags, "waterloggable_blocks")), ["/// The blocks that are `SimpleWaterloggedBlock`s, by ID."]))
    add(mut lines, number_list("liquid_containers", "blocks", ints(at(flags, "liquid_containers")), ["/// The other blocks that are `LiquidBlockContainer`s, by ID."]))
    add(mut lines, number_list("dynamic_shape_blocks", "blocks", ints(at(flags, "dynamic_shape_blocks")), ["/// The blocks whose shape can change where they stand, by ID: `Block.hasDynamicShape`."]))
    add(mut lines, number_list("outline_differs", "states", ints(at(flags, "outline_differs")), ["/// The states whose shape is a full block when their collision shape isn't, or the", "/// other way round, by ID: `Block.isShapeFullBlock(getShape)` against", "/// `isCollisionShapeFullBlock`."]))
    add(mut lines, pair_list(flags, "wall_cover", "wall_cover", [
        "/// The states whose collision shape's bottom covers `WallBlock`'s test shapes otherwise than",
        "/// its face being full says, all or none, each followed by which it covers: a bit for the",
        "/// post's, then the north, east, south and west wall's. `WallBlock.isCovered`.",
    ]))
    add(mut lines, pair_list(flags, "own_suffocation", "own_suffocation", [
        "/// The states whose suffocation isn't the default, `causes_suffocation` with a full collision",
        "/// shape, but their block's own, `Properties.isSuffocating`, each followed by 1 where they",
        "/// suffocate and 0 where they don't: a shulker box's as it is with no block entity (D425).",
    ]))
    add(mut lines, [
        "/// The instruments a note block plays, by name, in `NoteBlockInstrument`'s order.",
        "pub fn instrument_names() -> List<str> \{",
        "    return [",
    ])
    for n in texts(at(flags, "instrument_names")) {
        lines.push("        \"{n}\",")
    }
    add(mut lines, ["    ]", #"}"#, ""])
    add(mut lines, number_list("block_instruments", "instruments", ints(at(flags, "instruments")), ["/// The instrument a note block plays over each block, by its index in `instrument_names`, in", "/// block ID order: `BlockState.instrument()`, which each of a block's states has."]))
    add(mut lines, number_list("instruments_above", "instruments", ints(at(flags, "instruments_above")), ["/// The instruments that play from above a note block, the heads', by index in", "/// `instrument_names`: `worksAboveNoteBlock`."]))
    add(mut lines, pair_list(flags, "poi", "poi_states", [
        "/// The states that are points of interest, each followed by its type's ID in the",
        "/// `point_of_interest_type` registry: `PoiTypes.forState`.",
    ]))
    let entities = items(at(flags, "block_entities"))
    var type_set = Set<String>()
    for e in entities {
        type_set.insert(text(items(e)[1]))
    }
    var types: List<String> = []
    for t in type_set {
        types.push(t.copy())
    }
    types.sort()
    add(mut lines, [
        "/// The block entity types blocks have, by name, sorted.",
        "pub fn block_entity_names() -> List<str> \{",
        "    return [",
    ])
    for t in types {
        lines.push("        \"{t}\",")
    }
    add(mut lines, ["    ]", #"}"#, ""])
    var entity_pairs: List<String> = []
    for e in entities {
        let parts = items(e)
        let t = text(parts[1])
        var place = 0usize
        for (i, name) in types.enumerate() {
            if name == t {
                place = i
            }
        }
        entity_pairs.push("{int(parts[0])}")
        entity_pairs.push("{place}")
    }
    add(mut lines, [
        "/// Each block with a block entity, by ID, followed by its type's index in",
        "/// `block_entity_names`: the type `BlockEntityType.isValid` holds for.",
        "pub fn block_entity_blocks() -> List<u32> \{",
        "    let pairs: List<u32> = [",
    ])
    add(mut lines, rows_of(entity_pairs, 24))
    add(mut lines, ["    ]", "    return pairs", #"}"#, ""])
    return lines.join("\n")
}

/// Each block's class from `flags[key]`, by its place in `where`, `none_at` for none.
fn class_column(flags: Json, where: Map<String, i64>, none_at: i64, key: String) -> List<i64> {
    var out: List<i64> = []
    for c in items(at(flags, key)) {
        out.push(if let name = maybe_text(c) { where[name] } else { none_at })
    }
    return out
}

/// A function `name` giving the pairs of `flags[key]`, flattened, 24 numbers a row, after `doc`.
fn pair_list(flags: Json, key: String, name: String, doc: List<String>) -> List<String> {
    var values: List<String> = []
    for pair in int_rows(at(flags, key)) {
        for v in pair {
            values.push("{v}")
        }
    }
    var out = doc.copy()
    out.push("pub fn {name}() -> List<u32> \{")
    out.push("    let pairs: List<u32> = [")
    add(mut out, rows_of(values, 24))
    add(mut out, ["    ]", "    return pairs", #"}"#, ""])
    return out
}

// The directions, in vanilla's `Direction` order, which a state's faces are in.
const DIRECTIONS: usize = 6
const FACE_BITS: i64 = 6

/// The text of src/world/light_faces.calx.
pub fn light_faces_module(gv: String, flags: Json) -> String {
    let faces = int_rows(at(flags, "light_faces"))
    let occludes = int_rows(at(flags, "face_occludes"))
    let shapes = items(at(flags, "face_boxes")).len()
    if faces.len() != states_of(flags) {
        bad("block_flags.json has {faces.len()} states' faces for {states_of(flags)} states")
    }
    var square = occludes.len() == shapes
    for row in occludes {
        if row.len() != shapes {
            square = false
        }
    }
    if shapes > (1usize << 6) or not square {
        bad("{shapes} face shapes don't fit {FACE_BITS} bits, or the table of which occlude isn't square")
    }
    for i in 0..shapes {
        for j in 0..shapes {
            if occludes[i][j] != occludes[j][i] {
                bad("faceShapeOccludes isn't the same both ways round")
            }
        }
    }
    for f in faces {
        if f.len() != DIRECTIONS or f.any(|s| s < 0 or s >= i64.wrap(shapes)) {
            bad("a state's faces aren't six shapes of the table")
        }
    }
    // Each state's six faces packed into one number, and the different ones, the commonest first.
    var packed: List<i64> = []
    for f in faces {
        var v = 0i64
        for (d, s) in f.enumerate() {
            v += s << (FACE_BITS * i64.wrap(d))
        }
        packed.push(v)
    }
    let pal = palette(packed)
    if pal[0] != 0 {
        bad("most states' faces aren't all empty")
    }
    if pal.len() > single() {
        bad("{pal.len()} different sets of faces are more than a character each holds")
    }
    let abc = alphabet()
    let where = places(pal)
    var all_text = String()
    for v in packed {
        let i = where[v]
        all_text.push_str(abc[i..i + 1])
    }
    var chunks: List<String> = []
    var c = 0usize
    while c < all_text.len() {
        let end = (c + LINE).min(all_text.len())
        chunks.push(all_text[c..end].copy())
        c = end
    }
    var rows: List<u64> = []
    for i in 0..shapes {
        var r = 0u64
        for j in 0..shapes {
            if occludes[i][j] != 0 {
                r |= 1u64 << u64(j)
            }
        }
        rows.push(r)
    }
    var lines: List<String> = [
        "/// The faces light sees of each of vanilla {gv}'s block states, as `LightEngine.getOcclusionShape`",
        "/// gives them, and which two faces light can't pass between, as `Shapes.faceShapeOccludes` says.",
        "/// Written by {TOOL} from block_flags.json (D164, CAL-66): don't edit it.",
        "///",
        "/// The faces are numbered shapes, 0 the empty one and 1 the whole face. A state that isn't",
        "/// `canOcclude` or doesn't use its shape for light has every face empty.",
        "module world.light_faces",
        "",
        "/// How many bits each face's shape takes in a state's faces, packed down, up, north, south,",
        "/// west, east from the lowest.",
        "pub const FACE_BITS: u32 = {FACE_BITS}",
        "/// How many different shapes the faces have.",
        "pub const FACE_SHAPES: u32 = {shapes}",
        "",
        "/// The different sets of faces, packed, and for each state, in state ID order, which it has.",
        "pub fn state_faces() -> (List<u64>, List<u8>) \{",
        "    let palette: List<u64> = [{joined(pal)}]",
        "    let lines: List<String> = [",
    ]
    for chunk in chunks {
        lines.push("        \"{chunk}\",")
    }
    add(mut lines, [
        "    ]",
        "    let alphabet = \"{abc}\"",
        "    var digit: List<u8> = []",
        #"    for _ in 0..128 {"#,
        "        digit.push(0)",
        #"    }"#,
        #"    for i in 0..alphabet.len() {"#,
        "        digit[usize(alphabet.byte_at(i))] = u8.wrap(i)",
        #"    }"#,
        "    var states: List<u8> = []",
        "    states.reserve({packed.len()})",
        #"    for line in lines {"#,
        #"        for i in 0..line.len() {"#,
        "            states.push(digit[usize(line.byte_at(i))])",
        #"        }"#,
        #"    }"#,
        "    return (palette, states)",
        #"}"#,
        "",
        "/// For each shape, the shapes it and light can't pass between, bit `j` for shape `j`.",
        "pub fn face_occludes() -> List<u64> \{",
        "    return [{joined_u64(rows)}]",
        #"}"#,
        "",
    ])
    return lines.join("\n")
}

// How a collision shape's boxes are stored: each coordinate in 32nds of a block, which every one
// of vanilla's is, from BOX_FLOOR up, so they fit a byte.
const BOX_UNIT: i64 = 32
const BOX_FLOOR: i64 = -16

/// A coordinate as BOX_UNITs above BOX_FLOOR, which must be whole and fit a byte.
fn box_units(c: f64) -> i64 {
    if let u = grid_units(c) {
        return u
    }
    bad("the coordinate {repr_float(c)} isn't a 32nd of a block from -0.5 to 7.46875")
}

/// `box_units`, or none where the coordinate isn't on the grid.
fn grid_units(c: f64) -> i64? {
    let v = c * 32.0
    let whole = i64.saturate(v)
    if f64.nearest(whole) != v {
        return none
    }
    let units = whole - BOX_FLOOR
    if units < 0 or units >= 256 {
        return none
    }
    return some(units)
}

// How many bits each of a state's six fluid faces takes, packed down, up, north, south, west,
// east.
const FLUID_FACE_BITS: i64 = 8

/// Each box of a shape, six numbers.
fn boxes_of(v: Json) -> List<List<f64>> {
    var out: List<List<f64>> = []
    for b in items(v) {
        out.push(nums_of(b))
    }
    return out
}

fn nums_of(v: Json) -> List<f64> {
    var out: List<f64> = []
    for x in items(v) {
        out.push(num(x))
    }
    return out
}

/// Whether a shape is no boxes, or the one whole box.
fn is_empty_shape(shape: List<List<f64>>) -> bool {
    return shape.is_empty()
}

fn is_whole_shape(shape: List<List<f64>>) -> bool {
    return shape.len() == 1 and shape[0] == [0.0, 0.0, 0.0, 1.0, 1.0, 1.0]
}

/// Characters for each value's place in a palette: one for the commonest, a pair whose first is
/// one of the last `pairs` for the rest. Gives the pieces, how many take one, and `pairs`.
fn paired(values: List<i64>, pal: List<i64>) -> (List<String>, usize, usize) {
    let abc = alphabet()
    let n = abc.len()
    var pairs = 1usize
    while n - pairs + pairs * n < pal.len() {
        pairs += 1
    }
    let one = n - pairs
    let where = places(pal)
    var pieces: List<String> = []
    for v in values {
        let i = where[v]
        if i < one {
            pieces.push(abc[i..i + 1].copy())
        } else {
            let rest = i - one
            let first = one + rest / n
            let second = rest % n
            pieces.push("{abc[first..first + 1]}{abc[second..second + 1]}")
        }
    }
    return (pieces, one, pairs)
}

/// The text of src/world/fluid_faces.calx.
pub fn fluid_faces_module(gv: String, flags: Json) -> String {
    let faces = int_rows(at(flags, "fluid_faces"))
    var boxes: List<List<List<f64>>> = []
    for f in items(at(flags, "fluid_face_boxes")) {
        boxes.push(boxes_of(f))
    }
    let covers = int_rows(at(flags, "fluid_covers"))
    let count = boxes.len()
    if faces.len() != states_of(flags) {
        bad("block_flags.json has {faces.len()} states' fluid faces for {states_of(flags)} states")
    }
    var square = covers.len() == count
    for row in covers {
        if row.len() != count {
            square = false
        }
    }
    if count > (1usize << 8) or not square {
        bad("{count} fluid faces don't fit {FLUID_FACE_BITS} bits, or the table of which cover isn't square")
    }
    for i in 0..count {
        for j in 0..count {
            if covers[i][j] != covers[j][i] {
                bad("mergedFaceOccludes isn't the same both ways round")
            }
        }
    }
    if not is_empty_shape(boxes[0]) or not is_whole_shape(boxes[1]) {
        bad("fluid face 0 isn't empty, or 1 isn't the whole face")
    }
    for f in faces {
        if f.len() != DIRECTIONS or f.any(|s| s < 0 or s >= i64.wrap(count)) {
            bad("a state's fluid faces aren't six of the table's")
        }
    }
    // Each face's rectangles: its boxes, one block deep along z, as u, v from and to.
    var starts: List<String> = []
    var rects: List<String> = []
    for face in boxes {
        starts.push("{rects.len() / 4}")
        for b in face {
            if b.len() != 6 or b[2] != 0.0 or b[5] != 1.0 {
                bad("a fluid face's box isn't one block deep along z")
            }
            for k in [0usize, 1, 3, 4] {
                rects.push("{box_units(b[k])}")
            }
        }
    }
    starts.push("{rects.len() / 4}")
    let words = (count + 63) / 64
    var rows: List<String> = []
    for i in 0..count {
        for w in 0..words {
            var r = 0u64
            for j in 64 * w..count.min(64 * w + 64) {
                if covers[i][j] != 0 {
                    r |= 1u64 << u64(j - 64 * w)
                }
            }
            rows.push("{r}")
        }
    }
    // Each state's six faces packed, the different sets the commonest first, and an index into
    // them for each state, a character each or, for the rarest, a pair.
    var packed: List<i64> = []
    for f in faces {
        var v = 0i64
        for (d, s) in f.enumerate() {
            v += s << (FLUID_FACE_BITS * i64.wrap(d))
        }
        packed.push(v)
    }
    let pal = palette(packed)
    let (pieces, one, pairs) = paired(packed, pal)
    let chunks = chunked(pieces)
    let abc = alphabet()
    // The states that move: each one's grid's ends, then its boxes.
    var moving_states: List<i64> = []
    var grids: List<String> = []
    var box_starts: List<String> = []
    var moving_boxes: List<String> = []
    for m in items(at(flags, "fluid_moving")) {
        let parts = items(m)
        let state = int(parts[0])
        let grid = nums_of(parts[1])
        if grid.len() != 6 {
            bad("state {state}'s grid has {grid.len()} ends")
        }
        moving_states.push(state)
        for c in grid {
            grids.push("{box_units(c)}")
        }
        box_starts.push("{moving_boxes.len() / 6}")
        for b in boxes_of(parts[2]) {
            if b.len() != 6 {
                bad("a box of {b.len()} numbers")
            }
            for c in b {
                moving_boxes.push("{box_units(c)}")
            }
        }
    }
    box_starts.push("{moving_boxes.len() / 6}")
    var sorted_states = moving_states.copy()
    sorted_states.sort()
    if sorted_states != moving_states {
        bad("the states that move aren't in ID order")
    }
    var offsets: List<String> = []
    for o in int_rows(at(flags, "offsets")) {
        for v in o {
            offsets.push("{v}")
        }
    }
    var cases: List<String> = []
    for c in int_rows(at(flags, "fluid_cases")) {
        if c.len() != 7 {
            bad("a fluid case of {c.len()} numbers")
        }
        for v in c {
            cases.push("{v}")
        }
    }
    var offset_cases: List<String> = []
    for c in int_rows(at(flags, "offset_cases")) {
        if c.len() != 6 {
            bad("an offset case of {c.len()} numbers")
        }
        for v in c {
            offset_cases.push("{v}")
        }
    }
    let rare = if pal.len() > one { pal.len() - one } else { 0 }
    var lines: List<String> = [
        "/// The faces a fluid sees of each of vanilla {gv}'s block states, as `FlowingFluid.canPassThroughWall`",
        "/// asks them, and which two cover a face of a block between them, as `Shapes.mergedFaceOccludes`",
        "/// says. Written by {TOOL} from block_flags.json (D327, CAL-91): don't",
        "/// edit it.",
        "///",
        "/// A face is a state's collision shape's slice toward a side, laid flat on that side's other two",
        "/// axes, x before y before z: 0 is the empty face and 1 the whole one. A state vanilla offsets by",
        "/// its position whose collision shape isn't empty, as pointed dripstone, moves: its faces here",
        "/// are its shape's before it's offset, and it has its boxes and where its shape's grid starts and",
        "/// ends, which `mergedFaceOccludes` slices at, so its faces where it is can be worked out.",
        "/// Vanilla's own `canPassThroughWall` agreed with these for every two shapes, and for each state",
        "/// that moves at 24 places, as they were written.",
        "module world.fluid_faces",
        "",
        "/// How many bits each face takes in a state's faces, packed down, up, north, south, west, east",
        "/// from the lowest.",
        "pub const FLUID_FACE_BITS: u32 = {FLUID_FACE_BITS}",
        "/// How many different faces there are, and how many words each face's row of `fluid_covers`",
        "/// takes.",
        "pub const FLUID_FACES: u32 = {count}",
        "pub const COVER_WORDS: u32 = {words}",
        "/// How many 32nds of a block a coordinate is from, and above, `FACE_FLOOR`.",
        "pub const FACE_UNIT: i32 = {BOX_UNIT}",
        "pub const FACE_FLOOR: i32 = {BOX_FLOOR}",
        "",
        "/// The different sets of six faces, packed, and for each state, in state ID order, which it has.",
        "pub fn state_fluid_faces() -> (List<u64>, List<u16>) \{",
        "    // The sets, the commonest first, and an index into them for each state, a character",
        "    // each, from `alphabet`, or for the {rare} rarest a pair, whose first is one of its last {pairs}.",
        "    let palette: List<u64> = [{joined(pal)}]",
        "    let lines: List<String> = [",
    ]
    for chunk in chunks {
        lines.push("        \"{chunk}\",")
    }
    add(mut lines, [
        "    ]",
        "    let alphabet = \"{abc}\"",
        "    var digit: List<u32> = []",
        #"    for _ in 0..128 {"#,
        "        digit.push(0)",
        #"    }"#,
        #"    for i in 0..alphabet.len() {"#,
        "        digit[usize(alphabet.byte_at(i))] = u32.wrap(i)",
        #"    }"#,
        "    var states: List<u16> = []",
        "    states.reserve({packed.len()})",
        #"    for line in lines {"#,
        "        var i: usize = 0",
        #"        while i < line.len() {"#,
        "            let d = digit[usize(line.byte_at(i))]",
        "            if d >= {one} \{",
        "                states.push(u16.wrap({one} + (d - {one}) * {abc.len()} + digit[usize(line.byte_at(i + 1))]))",
        "                i += 2",
        #"            } else {"#,
        "                states.push(u16.wrap(d))",
        "                i += 1",
        #"            }"#,
        #"        }"#,
        #"    }"#,
        "    return (palette, states)",
        #"}"#,
        "",
        "/// For each face, `COVER_WORDS` words of the faces it and a fluid can't pass between, bit `j`",
        "/// of a row's words for face `j`.",
        "pub fn fluid_covers() -> List<u64> \{",
        "    return [",
        numbers(rows, 6),
        "    ]",
        #"}"#,
        "",
        "/// Where each face's rectangles start in `face_rects`, counted in rectangles, and where the last",
        "/// ends.",
        "pub fn face_starts() -> List<u16> \{",
        "    return [",
        numbers(starts, 24),
        "    ]",
        #"}"#,
        "",
        "/// Every face's rectangles, four coordinates each, from u, v to u, v, in `FACE_UNIT`s above",
        "/// `FACE_FLOOR`.",
        "pub fn face_rects() -> List<u8> \{",
        "    return [",
        numbers(rects, 24),
        "    ]",
        #"}"#,
        "",
        "/// The states that move, in state ID order.",
        "pub fn moving_states() -> List<u32> \{",
        "    return [",
        numbers(shown(moving_states), 12),
        "    ]",
        #"}"#,
        "",
        "/// Where each state that moves has its shape's grid start, on x, y, z, then end, in `FACE_UNIT`s",
        "/// above `FACE_FLOOR`.",
        "pub fn moving_grids() -> List<u8> \{",
        "    return [",
        numbers(grids, 24),
        "    ]",
        #"}"#,
        "",
        "/// Where each state that moves has its boxes start in `moving_boxes`, counted in boxes, and",
        "/// where the last ends.",
        "pub fn moving_starts() -> List<u16> \{",
        "    return [",
        numbers(box_starts, 24),
        "    ]",
        #"}"#,
        "",
        "/// The boxes of the states that move, before they're offset, six coordinates each, min x, y, z",
        "/// then max x, y, z, in `FACE_UNIT`s above `FACE_FLOOR`.",
        "pub fn moving_boxes() -> List<u8> \{",
        "    return [",
        numbers(moving_boxes, 24),
        "    ]",
        #"}"#,
        "",
        "/// Each block vanilla offsets by its position, four numbers each: the block, 1 if it's offset up",
        "/// and down too, and the bits of the `f32`s it's offset at most across and up and down,",
        "/// `getMaxHorizontalOffset` and `getMaxVerticalOffset`.",
        "pub fn offset_blocks() -> List<u32> \{",
        "    return [",
        numbers(offsets, 8),
        "    ]",
        #"}"#,
        "",
        "/// What vanilla's `canPassThroughWall` said where a state that moves meets another, seven numbers",
        "/// each: x, y, z of the first, the direction toward the second, the two states, and 1 if a",
        "/// fluid passes. Most are where moving changes the answer. For Calcite's tests.",
        "pub fn wall_cases() -> List<i32> \{",
        "    return [",
        numbers(cases, 7),
        "    ]",
        #"}"#,
        "",
        "/// Where vanilla offsets a state that moves, six numbers each: the state, x, z, and the bits of",
        "/// the offset's x, y and z. For Calcite's tests.",
        "pub fn offset_cases() -> List<i64> \{",
        "    return [",
        numbers(offset_cases, 6),
        "    ]",
        #"}"#,
        "",
    ])
    return lines.join("\n")
}

/// A table of shapes from block_flags.json, as the modules' `state_shapes`, `shape_starts` and
/// `shape_boxes` are made of.
struct ShapeTable {
    shapes: List<i64>
    palette: List<i64>
    single: usize
    pairs: usize
    chunks: List<String>
    starts: List<String>
    coords: List<String>
}

/// Each state's shape by `key` and each shape's boxes, checked, as a `ShapeTable`.
fn shape_table(flags: Json, key: String, boxes: List<List<List<f64>>>) -> ShapeTable {
    let shapes = ints(at(flags, key))
    if shapes.len() != states_of(flags) {
        bad("block_flags.json has {shapes.len()} states' {key} shapes for {states_of(flags)} states")
    }
    if shapes.any(|s| s < 0 or s >= i64.wrap(boxes.len())) {
        bad("a state's {key} shape isn't one of the table's")
    }
    if not is_empty_shape(boxes[0]) or not is_whole_shape(boxes[1]) {
        bad("{key} shape 0 isn't empty, or 1 isn't the whole block")
    }
    var coords: List<String> = []
    var starts: List<String> = []
    for shape in boxes {
        starts.push("{coords.len() / 6}")
        for b in shape {
            if b.len() != 6 {
                bad("a box of {b.len()} numbers")
            }
            for c in b {
                coords.push("{box_units(c)}")
            }
        }
    }
    starts.push("{coords.len() / 6}")
    // Each state's shape as a character of `alphabet`, the commonest shapes first, or a pair for
    // the rest, from the last `pairs` characters.
    let pal = palette(shapes)
    let (pieces, one, pairs) = paired(shapes, pal)
    return ShapeTable { shapes: shapes, palette: pal, single: one, pairs: pairs, chunks: chunked(pieces), starts: starts, coords: coords }
}

/// The lines of a shapes module's `state_shapes`, `shape_starts` and `shape_boxes`.
fn shape_lines(t: ShapeTable) -> List<String> {
    let abc = alphabet()
    var lines: List<String> = [
        "/// Each state's shape, in state ID order.",
        "pub fn state_shapes() -> List<u16> \{",
        "    // The shapes, the commonest first, and an index into them for each state, a character",
        "    // each, from `alphabet`, or for the {t.palette.len() - t.single} rarest a pair, whose first is one of its last {t.pairs}.",
        "    let values: List<u16> = [{joined(t.palette)}]",
        "    let lines: List<String> = [",
    ]
    for c in t.chunks {
        lines.push("        \"{c}\",")
    }
    add(mut lines, [
        "    ]",
        "    let alphabet = \"{abc}\"",
        "    var digit: List<u32> = []",
        #"    for _ in 0..128 {"#,
        "        digit.push(0)",
        #"    }"#,
        #"    for i in 0..alphabet.len() {"#,
        "        digit[usize(alphabet.byte_at(i))] = u32.wrap(i)",
        #"    }"#,
        "    var shapes: List<u16> = []",
        "    shapes.reserve({t.shapes.len()})",
        #"    for line in lines {"#,
        "        var i: usize = 0",
        #"        while i < line.len() {"#,
        "            let d = digit[usize(line.byte_at(i))]",
        "            if d >= {t.single} \{",
        "                shapes.push(values[usize({t.single} + (d - {t.single}) * {abc.len()} + digit[usize(line.byte_at(i + 1))])])",
        "                i += 2",
        #"            } else {"#,
        "                shapes.push(values[usize(d)])",
        "                i += 1",
        #"            }"#,
        #"        }"#,
        #"    }"#,
        "    return shapes",
        #"}"#,
        "",
        "/// Where each shape's boxes start in `shape_boxes`, counted in boxes, and where the last ends.",
        "pub fn shape_starts() -> List<u16> \{",
        "    return [",
        numbers(t.starts, 24),
        "    ]",
        #"}"#,
        "",
        "/// Every shape's boxes, six coordinates each, min x, y, z then max x, y, z, in `BOX_UNIT`s",
        "/// above `BOX_FLOOR`.",
        "pub fn shape_boxes() -> List<u8> \{",
        "    return [",
        numbers(t.coords, 24),
        "    ]",
        #"}"#,
        "",
    ])
    return lines
}

fn shape_boxes(flags: Json, key: String) -> List<List<List<f64>>> {
    var out: List<List<List<f64>>> = []
    for s in items(at(flags, key)) {
        out.push(boxes_of(s))
    }
    return out
}

/// The text of src/world/collision_shapes.calx.
pub fn collision_module(gv: String, flags: Json) -> String {
    let boxes = shape_boxes(flags, "collision_boxes")
    let t = shape_table(flags, "collision", boxes)
    var lines: List<String> = [
        "/// Each of vanilla {gv}'s block states' collision shapes, as the spawn finder sees them:",
        "/// `getCollisionShape` with an empty context that collides with fluids, so a liquid is a whole",
        "/// block. A state vanilla offsets by its position, as bamboo, has the shape it has before it's",
        "/// offset. Written by {TOOL} from block_flags.json (CAL-75): don't",
        "/// edit it.",
        "///",
        "/// The shapes are numbered, 0 the empty one and 1 the whole block, and each is a list of boxes,",
        "/// as `toAabbs` gives them.",
        "module world.collision_shapes",
        "",
        "/// How many 32nds of a block a box's coordinate is from, and above, `BOX_FLOOR`.",
        "pub const BOX_UNIT: i32 = {BOX_UNIT}",
        "pub const BOX_FLOOR: i32 = {BOX_FLOOR}",
        "/// How many different shapes there are.",
        "pub const SHAPES: u32 = {boxes.len()}",
        "",
    ]
    add(mut lines, shape_lines(t))
    return lines.join("\n")
}

/// The text of src/world/outline_shapes.calx (CAL-159).
pub fn outline_module(gv: String, flags: Json) -> String {
    let boxes = shape_boxes(flags, "outline_boxes")
    let moved = ints(at(flags, "outline_moved"))
    // The shapes whose coordinates aren't 32nds of a block, as a lectern's thirds, kept whole.
    var exact: List<i64> = []
    var grid: List<List<List<f64>>> = []
    for (i, shape) in boxes.enumerate() {
        var on_grid = true
        for b in shape {
            for c in b {
                if grid_units(c) == none {
                    on_grid = false
                }
            }
        }
        if on_grid {
            grid.push(shape.copy())
        } else {
            exact.push(i64.wrap(i))
            grid.push([])
        }
    }
    let t = shape_table(flags, "outline", grid)
    var sorted_moved = moved.copy()
    sorted_moved.sort()
    if moved.any(|s| s < 0 or s >= i64.wrap(states_of(flags))) or sorted_moved != moved {
        bad("outline_moved isn't states in ID order")
    }
    var exact_starts: List<String> = []
    var texts_out: List<String> = []
    for i in exact {
        exact_starts.push("{texts_out.len() / 6}")
        for b in boxes[usize.wrap(i)] {
            for c in b {
                texts_out.push(repr_float(c))
            }
        }
    }
    exact_starts.push("{texts_out.len() / 6}")
    for tx in texts_out {
        if tx.contains("e") or tx.contains("n") {
            bad("an outline coordinate Calx can't read as written: {tx}")
        }
    }
    var lines: List<String> = [
        "/// Each of vanilla {gv}'s block states' outline shapes: `getShape` with an empty context,",
        "/// as `ClipContext.Block.OUTLINE` reads it. Of the states vanilla offsets by their position,",
        "/// those whose shape moves by it, as a flower's, which a short grass's doesn't, have the shape",
        "/// they have before it's offset, and are `moved_states`. A shape that goes by its block entity,",
        "/// as a shulker box's, is the empty world's. Written by {TOOL} from",
        "/// block_flags.json (CAL-159): don't edit it.",
        "///",
        "/// The shapes are numbered, 0 the empty one and 1 the whole block, and each is a list of boxes,",
        "/// as `toAabbs` gives them, in `world.collision_shapes`' units; those whose coordinates aren't",
        "/// 32nds of a block, as a lectern's thirds, are `exact_shapes`, their boxes in `exact_boxes`.",
        "module world.outline_shapes",
        "",
        "/// How many different shapes there are.",
        "pub const SHAPES: u32 = {boxes.len()}",
        "",
    ]
    add(mut lines, shape_lines(t))
    add(mut lines, [
        "/// The shapes whose coordinates aren't 32nds of a block, in order, which `shape_boxes` has as",
        "/// empty.",
        "pub fn exact_shapes() -> List<u32> \{",
        "    return [",
        numbers(shown(exact), 24),
        "    ]",
        #"}"#,
        "",
        "/// Where each of `exact_shapes`' boxes start in `exact_boxes`, and where the last ends.",
        "pub fn exact_starts() -> List<u32> \{",
        "    return [",
        numbers(exact_starts, 24),
        "    ]",
        #"}"#,
        "",
        "/// `exact_shapes`' boxes, six coordinates each, as vanilla has them.",
        "pub fn exact_boxes() -> List<f64> \{",
        "    return [",
        numbers(texts_out, 6),
        "    ]",
        #"}"#,
        "",
        "/// The states whose outline moves by their offset, in ID order.",
        "pub fn moved_states() -> List<u32> \{",
        "    return [",
        numbers(shown(moved), 24),
        "    ]",
        #"}"#,
        "",
    ])
    return lines.join("\n")
}

/// The text of src/world/movement_shapes.calx.
pub fn movement_module(gv: String, flags: Json) -> String {
    let boxes = shape_boxes(flags, "movement_boxes")
    let t = shape_table(flags, "movement", boxes)
    let factors = int_rows(at(flags, "movement_factors"))
    // Every case vanilla stopped short, and one in eight of the others, to keep the module small.
    var cases: List<List<i64>> = []
    var others = 0
    for c in int_rows(at(flags, "movement_cases")) {
        if c[8] != c[9] {
            cases.push(c.copy())
        } else {
            if others % 8 == 0 {
                cases.push(c.copy())
            }
            others += 1
        }
    }
    for f in factors {
        if f.len() != 6 {
            bad("a block's movement factors are {f.len()} numbers")
        }
    }
    for c in cases {
        if c.len() != 10 or c[0] < 0 or c[0] >= i64.wrap(boxes.len()) or c[1] < 0 or c[1] >= 3 {
            bad("a collide case isn't a shape, an axis and eight doubles")
        }
    }
    var factor_blocks: List<i64> = []
    var factor_bits: List<String> = []
    for f in factors {
        factor_blocks.push(f[0])
        for k in 1..f.len() {
            factor_bits.push("{f[k] & 0xFFFFFFFFi64}")
        }
    }
    var case_values: List<String> = []
    for c in cases {
        for v in c {
            case_values.push("{v}")
        }
    }
    var lines: List<String> = [
        "/// Each of vanilla {gv}'s block states' collision shapes as an entity moves against them:",
        "/// `getCollisionShape` with an empty context, so a liquid has none, and a state vanilla offsets",
        "/// by its position, as bamboo, has the shape it has before it's offset. Scaffolding's and powder",
        "/// snow's shapes, which go by the entity, and a moving piston's and a shulker box's, which go by",
        "/// their block entities, are the empty context's here. Then each block whose friction, speed",
        "/// factor, jump factor or bounce isn't the default, and cases of vanilla's own",
        "/// `VoxelShape.collide`. Written by {TOOL} from block_flags.json",
        "/// (CAL-148): don't edit it.",
        "///",
        "/// The shapes are numbered, 0 the empty one and 1 the whole block, and each is a list of boxes,",
        "/// as `toAabbs` gives them, in `world.collision_shapes`' units.",
        "module world.movement_shapes",
        "",
        "/// How many different shapes there are.",
        "pub const SHAPES: u32 = {boxes.len()}",
        "",
    ]
    add(mut lines, shape_lines(t))
    add(mut lines, [
        "/// Each block whose friction, speed factor, jump factor, bounce or fall distance reduction isn't",
        "/// the default, 0.6, 1, 1, 0 and 0, in block ID order.",
        "pub fn factor_blocks() -> List<u32> \{",
        "    return [",
        numbers(shown(factor_blocks), 24),
        "    ]",
        #"}"#,
        "",
        "/// Each of `factor_blocks`' friction, speed factor, jump factor, bounce and fall distance",
        "/// reduction, five `f32`s' bits each, `getFriction`, `getSpeedFactor`, `getJumpFactor`,",
        "/// `getBounceRestitution` and `getFallDistanceReduction` (CAL-155).",
        "pub fn factors() -> List<u32> \{",
        "    return [",
        numbers(factor_bits, 8),
        "    ]",
        #"}"#,
        "",
        "/// What vanilla's `VoxelShape.collide` gave boxes near each shape that don't overlap it, ten",
        "/// numbers each: the shape, the axis, x 0, y 1 and z 2, then the bits of the `f64`s of the",
        "/// box, min x, y, z then max x, y, z, the distance asked and the distance given. Every case",
        "/// it stopped short, and one in eight of those it didn't. For Calcite's tests.",
        "pub fn collide_cases() -> List<i64> \{",
        "    return [",
        numbers(case_values, 10),
        "    ]",
        #"}"#,
        "",
    ])
    return lines.join("\n")
}
