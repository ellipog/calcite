module oracle.datagen.tablekit

// What calx_tables' modules share: reading the converted tables' JSON, writing numbers as Calx
// literals, and the encoded tables that hold a number for each block state in a few characters.

import std.json.{Json}
import std.text.python.{repr_float}
import tools.repo.{die}

/// The tool that writes the modules, as their headers name it.
pub const TOOL: str = "oracle/datagen/calx_tables.calx"

/// Stops with what's wrong with the tables.
pub fn bad(message: String) -> never {
    die("calx_tables: {message}")
}

/// Member `key` of the object `v`.
pub fn at(v: Json, key: String) -> Json {
    if let found = v.get(key.copy()) {
        return found
    }
    bad("no {key} in the tables")
}

/// Whether the object `v` has member `key`.
pub fn has(v: Json, key: String) -> bool {
    return v.get(key.copy()) != none
}

/// The elements of the array `v`.
pub fn items(v: Json) -> List<Json> {
    if let Json.Array(xs) = v {
        return xs.copy()
    }
    bad("{v.kind()} where an array was wanted")
}

/// The members of the object `v`, in order.
pub fn members(v: Json) -> LinkedMap<String, Json> {
    if let Json.Object(m) = v {
        return m.copy()
    }
    bad("{v.kind()} where an object was wanted")
}

/// The integer `v`.
pub fn int(v: Json) -> i64 {
    if let n = v.as_i64() {
        return n
    }
    bad("{v} isn't an integer")
}

/// The number `v`, as a double, as Python's `float` reads it.
pub fn num(v: Json) -> f64 {
    if let n = v.as_f64() {
        return n
    }
    bad("{v} isn't a number")
}

/// The string `v`.
pub fn text(v: Json) -> String {
    if let s = v.as_str() {
        return s
    }
    bad("{v} isn't a string")
}

/// The string `v`, or none for `null` or an empty one, as Python's `if c` reads it.
pub fn maybe_text(v: Json) -> String? {
    if let s = v.as_str() {
        if not s.is_empty() {
            return some(s)
        }
    }
    return none
}

/// Whether `v` is true, as Python reads a JSON value in an `if`.
pub fn truthy(v: Json) -> bool {
    return match v {
        Json.Null => false,
        Json.Bool(b) => b,
        Json.Int(n) => n != 0,
        Json.UInt(n) => n != 0,
        Json.Float(f) => f != 0.0,
        Json.Str(s) => not s.is_empty(),
        Json.Array(xs) => not xs.is_empty(),
        Json.Object(m) => m.len() > 0,
        Json.Big(_) => true,
    }
}

/// The integers of the array `v`.
pub fn ints(v: Json) -> List<i64> {
    var out: List<i64> = []
    for x in items(v) {
        out.push(int(x))
    }
    return out
}

/// The numbers of the array `v`.
pub fn nums(v: Json) -> List<f64> {
    var out: List<f64> = []
    for x in items(v) {
        out.push(num(x))
    }
    return out
}

/// The strings of the array `v`.
pub fn texts(v: Json) -> List<String> {
    var out: List<String> = []
    for x in items(v) {
        out.push(text(x))
    }
    return out
}

/// Each number as Python's `str` writes it, joined with `, `.
pub fn joined(values: List<i64>) -> String {
    var parts: List<String> = []
    for v in values {
        parts.push("{v}")
    }
    return parts.join(", ")
}

/// Each number of the unsigned list, joined with `, `.
pub fn joined_u64(values: List<u64>) -> String {
    var parts: List<String> = []
    for v in values {
        parts.push("{v}")
    }
    return parts.join(", ")
}

/// Strings as a Calx list's elements: each quoted, joined with `, `.
pub fn strings(names: List<String>) -> String {
    var parts: List<String> = []
    for n in names {
        parts.push("\"{n}\"")
    }
    return parts.join(", ")
}

/// Numbers as rows of a Calx list literal, `per` a row, the rows joined by `,` and a line break.
pub fn numbers(values: List<String>, per: usize) -> String {
    var rows: List<String> = []
    var i = 0usize
    while i < values.len() {
        let end = (i + per).min(values.len())
        rows.push("        {values[i..end].join(", ")}")
        i = end
    }
    return rows.join(",\n")
}

/// Integers as Python's `str` writes them.
pub fn shown(values: List<i64>) -> List<String> {
    var out: List<String> = []
    for v in values {
        out.push("{v}")
    }
    return out
}

/// Numbers as rows of a list, `per` a row, each row ending with `,`.
pub fn rows_of(values: List<String>, per: usize) -> List<String> {
    var out: List<String> = []
    var i = 0usize
    while i < values.len() {
        let end = (i + per).min(values.len())
        out.push("        {values[i..end].join(", ")},")
        i = end
    }
    return out
}

/// A float as a Calx f32 literal that reads back as the same float.
pub fn calx_float(v: f64) -> String {
    var t = repr_float(v)
    if not t.contains("e") and not t.contains(".") {
        t.push_str(".0")
    }
    t.push_str("f32")
    return t
}

/// A double as a Calx f64 literal that reads back as the same double.
pub fn calx_double(v: f64) -> String {
    let t = repr_float(v)
    let (mantissa, exponent) = t.split_once("e") ?? (t.copy(), String())
    var out = mantissa.copy()
    if not out.contains(".") {
        out.push_str(".0")
    }
    if not exponent.is_empty() {
        let e = i64.parse(exponent.trim_prefix("+")) ?? bad("the exponent of {t}")
        out.push_str("e{e}")
    }
    return out
}

/// The characters the encoded tables are written in: printable ASCII but for a space and the four
/// a Calx string treats specially. The last starts a pair, for the rarest values.
pub fn alphabet() -> String {
    var s = String()
    for c in 0x21u32..0x7F {
        if c == 0x22 or c == 0x5C or c == 0x7B or c == 0x7D {
            continue
        }
        s.push(rune.try_from(c) ?? bad("the alphabet"))
    }
    return s
}

/// How many values take one character in an encoded table.
pub fn single() -> usize {
    return alphabet().len() - 1
}

/// How many characters a line of an encoded table holds at most.
pub const LINE: usize = 96

/// The different values, the commonest first, ties by value, as Python's
/// `sorted(counts, key=lambda v: (-counts[v], v))` gives them.
pub fn palette(values: List<i64>) -> List<i64> {
    var counts = Map<i64, u64>()
    for v in values {
        if counts.contains(v) {
            counts[v] += 1
        } else {
            counts.insert(v, 1)
        }
    }
    var order: List<i64> = []
    for (v, _) in counts {
        order.push(v)
    }
    order.sort()
    order.sort_by(|a, b| counts[b].cmp(counts[a]))
    return order
}

/// Each value's place in `palette`.
pub fn places(order: List<i64>) -> Map<i64, usize> {
    var where = Map<i64, usize>()
    for (i, v) in order.enumerate() {
        where.insert(v, i)
    }
    return where
}

/// Pieces of text in lines of up to `LINE` characters, no piece split between two.
pub fn chunked(pieces: List<String>) -> List<String> {
    var chunks: List<String> = [String()]
    for t in pieces {
        let last = chunks.len() - 1
        if chunks[last].len() + t.len() > LINE {
            chunks.push(String())
        }
        let end = chunks.len() - 1
        chunks[end].push_str(t)
    }
    return chunks
}

/// A Calx function `name` giving `values`, u32s, compactly: each an index into the different
/// values, the commonest first, as a character or two.
pub fn encoded_table(name: String, what: String, values: List<i64>) -> List<String> {
    let abc = alphabet()
    let one = single()
    let pal = palette(values)
    if pal.len() > one + abc.len() {
        bad("{pal.len()} different flags are more than the encoding holds")
    }
    let where = places(pal)
    var pieces: List<String> = []
    for v in values {
        let i = where[v]
        if i < one {
            pieces.push(abc[i..i + 1].copy())
        } else {
            pieces.push("{abc[one..one + 1]}{abc[i - one..i - one + 1]}")
        }
    }
    let chunks = chunked(pieces)
    let rare = if pal.len() > one { pal.len() - one } else { 0 }
    var lines: List<String> = [
        "pub fn {name}() -> List<u32> \{",
        "    // The different {what}, the commonest first, and an index into them for each, a",
        "    // character each, from `alphabet`. Its last character starts a pair, for the {rare} rarest.",
        "    let values: List<u32> = [{joined(pal)}]",
        "    let lines: List<String> = [",
    ]
    for c in chunks {
        lines.push("        \"{c}\",")
    }
    lines.push("    ]")
    lines.push("    let alphabet = \"{abc}\"")
    lines.push("    var digit: List<u32> = []")
    lines.push(#"    for _ in 0..128 {"#)
    lines.push("        digit.push(0)")
    lines.push(#"    }"#)
    lines.push(#"    for i in 0..alphabet.len() {"#)
    lines.push("        digit[usize(alphabet.byte_at(i))] = u32.wrap(i)")
    lines.push(#"    }"#)
    lines.push("    let pair = alphabet.byte_at({one})")
    lines.push("    var {what}: List<u32> = []")
    lines.push("    {what}.reserve({values.len()})")
    lines.push(#"    for line in lines {"#)
    lines.push("        var i: usize = 0")
    lines.push(#"        while i < line.len() {"#)
    lines.push("            let b = line.byte_at(i)")
    lines.push(#"            if b == pair {"#)
    lines.push("                {what}.push(values[usize({one} + digit[usize(line.byte_at(i + 1))])])")
    lines.push("                i += 2")
    lines.push(#"            } else {"#)
    lines.push("                {what}.push(values[usize(digit[usize(b)])])")
    lines.push("                i += 1")
    lines.push(#"            }"#)
    lines.push(#"        }"#)
    lines.push(#"    }"#)
    lines.push("    return {what}")
    lines.push(#"}"#)
    lines.push("")
    return lines
}

/// A Calx function `name` giving `values` as u32s, rows of 24, after the lines of `doc`.
pub fn number_list(name: String, var_name: String, values: List<i64>, doc: List<String>) -> List<String> {
    var out = doc.copy()
    out.push("pub fn {name}() -> List<u32> \{")
    out.push("    let {var_name}: List<u32> = [")
    for row in rows_of(shown(values), 24) {
        out.push(row.copy())
    }
    out.push("    ]")
    out.push("    return {var_name}")
    out.push(#"}"#)
    out.push("")
    return out
}

/// Adds every line of `more` to `lines`.
pub fn add(lines: mut List<String>, more: List<String>) {
    for l in more {
        lines.push(l.copy())
    }
}
