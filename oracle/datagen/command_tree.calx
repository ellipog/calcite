module oracle.datagen.command_tree

// Writes generated/<version>/command_tree.json: the dedicated server's command tree in the order
// vanilla registers it, with each node's permission level and its argument's properties as the
// commands packet sends them, which the data generator's commands.json doesn't hold (CAL-165).
//
//     calx oracle/datagen/command_tree.calx
//
// It runs CommandTree from the vanilla adapter, which oracle/adapter.calx builds, so the adapter
// has to be built first. The file is beside tables/, not in it, since the converter replaces
// tables/ whole. calx_tables reads it for src/command/tree.calx.

import std.cli.{cli}
import std.json.{Json}
import oracle.adapter.{generate}

/// Writes generated/<version>/command_tree.json from vanilla's own Commands.
@cli(name: "command_tree")
struct Args {
    /// The game version.
    version: String = "26.3"
}

pub fn main() {
    let args = Args.parse()
    let g = generate("command_tree", "CommandTree", "command_tree.json", args.version)
    let nodes = g.doc.get("nodes") ?? Json.Null
    let first = nodes.at(0) ?? Json.Null
    let children = first.get("children") ?? Json.Null
    println("wrote {g.rel}: {nodes.len()} nodes, {children.len()} commands")
}
