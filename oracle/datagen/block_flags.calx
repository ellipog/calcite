module oracle.datagen.block_flags

// Writes generated/<version>/block_flags.json: what each block state is, from vanilla's own state
// cache, which the data generator's reports don't hold (D164).
//
//     calx oracle/datagen/block_flags.calx
//
// It runs BlockFlags from the vanilla adapter, which oracle/adapter.calx builds, so the adapter has
// to be built first. The file is beside tables/, not in it, since the converter replaces tables/
// whole. calx_tables reads it for src/world/block_facts.calx.

import std.cli.{cli}
import std.json.{Json}
import oracle.adapter.{generate}

/// Writes generated/<version>/block_flags.json from vanilla's state cache.
@cli(name: "block_flags")
struct Args {
    /// The game version.
    version: String = "26.3"
}

pub fn main() {
    let args = Args.parse()
    let g = generate("block_flags", "BlockFlags", "block_flags.json", args.version)
    // What BlockFlags says it wrote and checked, from among vanilla's logging, which takes its
    // standard error over.
    for line in "{g.out.text()}{g.out.error_text()}".lines() {
        if let at = line.find("BlockFlags: ") {
            println(line[at..])
        }
    }
    let states = g.doc.get("states") ?? Json.Null
    println("wrote {g.rel}: {states.as_u64() ?? 0} states")
}
