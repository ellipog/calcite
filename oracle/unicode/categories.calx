module oracle.unicode.categories

// Writes src/java/categories.calx, the Unicode categories Java's regular expressions ask about,
// from JDK 25.
//
//     calx oracle/unicode/categories.calx            # run Categories.java on JDK 25 and write it
//     calx oracle/unicode/categories.calx --check    # fail if what's committed is out of date
//
// Java's `\b` and `\B` take a non-spacing mark as a word character when a letter or digit comes
// before it, past any other non-spacing marks. Categories.java prints the code points
// `Character.getType` puts in NON_SPACING_MARK and the UTF-16 units `Character.isLetterOrDigit`
// takes, as runs, by calling the JDK's public API only, and this turns them into a module of
// sorted run tables. The categories are Unicode's, under the Unicode License V3, whose notice the
// module keeps.

import std.cli.{cli}
import oracle.jdk.{find_java_home}
import oracle.unicode.names.{notice_lines, put, run_java}
import tools.repo.{die, under}

/// The runs Categories.java prints: the non-spacing marks', and the letters' and digits'.
struct Runs {
    marks: List<(u32, u32)>
    letters: List<(u32, u32)>
}

fn dump(home: String) -> Runs {
    var runs = Runs { marks: [], letters: [] }
    for line in run_java(home, under("oracle/unicode/Categories.java")).lines() {
        let (kind, span) = line.split_once(" ") ?? die("Categories.java printed {line}")
        let (first, last) = span.split_once(";") ?? die("Categories.java printed {line}")
        let run = (u32.parse_radix(first, 16) ?? die("Categories.java printed {line}"), u32.parse_radix(last, 16) ?? die("Categories.java printed {line}"))
        if kind == "mn" {
            runs.marks.push(run)
        } else if kind == "ld" {
            runs.letters.push(run)
        } else {
            die("Categories.java printed {line}")
        }
    }
    return runs
}

/// A constant array of the values, eight to a line.
fn table(name: String, kind: String, values: List<u32>) -> List<String> {
    var lines: List<String> = ["const {name}: [{kind}; {values.len()}] = ["]
    var i = 0usize
    while i < values.len() {
        let end = (i + 8).min(values.len())
        var parts: List<String> = []
        for v in values[i..end] {
            parts.push("0x{v:X},")
        }
        lines.push("    {parts.join(" ")}")
        i = end
    }
    lines.push("]")
    return lines
}

/// A binary search for the run `c` would be in, the last whose first is at most `c`, in the tables
/// named `name`, after `guard`, which rules out code points none of the runs hold.
fn search(name: String, guard: String, runs: List<(u32, u32)>) -> List<String> {
    return [
        "    if {guard} \{",
        "        return false",
        #"    }"#,
        "    var lo: usize = 0",
        "    var hi: usize = {runs.len()}",
        #"    while lo < hi {"#,
        "        let mid = lo + (hi - lo) / 2",
        "        if {name}_FIRST[mid] <= c \{",
        "            lo = mid + 1",
        #"        } else {"#,
        "            hi = mid",
        #"        }"#,
        #"    }"#,
        "    return lo > 0 and c <= {name}_LAST[lo - 1]",
    ]
}

fn firsts(runs: List<(u32, u32)>) -> List<u32> {
    var out: List<u32> = []
    for (f, _) in runs {
        out.push(f)
    }
    return out
}

fn lasts(runs: List<(u32, u32)>) -> List<u32> {
    var out: List<u32> = []
    for (_, l) in runs {
        out.push(l)
    }
    return out
}

fn add(out: mut List<String>, more: List<String>) {
    for l in more {
        out.push(l.copy())
    }
}

/// The text of src/java/categories.calx.
fn module_text(runs: Runs) -> String {
    let marks = runs.marks.copy()
    let letters = runs.letters.copy()
    if marks.is_empty() or letters.is_empty() {
        die("Categories.java printed no runs")
    }
    var out: List<String> = [
        "/// The Unicode categories Java's regular expressions ask about, as JDK 25 gives them, which",
        "/// has Unicode 16.0's. Written by oracle/unicode/categories.calx from what the JDK's public API",
        "/// gives: don't edit it.",
        "///",
        "/// The categories are the Unicode Character Database's, under this notice:",
        "///",
    ]
    add(mut out, notice_lines())
    add(mut out, [
        "module java.categories",
        "",
        "/// Whether Java's `Character.getType` puts the code point in `NON_SPACING_MARK`, Unicode's Mn.",
        "pub fn is_non_spacing_mark(c: u32) -> bool \{",
    ])
    add(mut out, search("MARK", "c < 0x{marks[0].0:X}", marks))
    add(mut out, [
        #"}"#,
        "",
        "/// Whether Java's `Character.isLetterOrDigit` takes the UTF-16 unit: a letter, of any of",
        "/// Unicode's L categories, or a decimal digit, Nd. A surrogate never is.",
        "pub fn is_letter_or_digit(c: u32) -> bool \{",
        #"    if c < 0x80 {"#,
        "        return (c >= 0x30 and c <= 0x39) or ((c | 0x20) >= 0x61 and (c | 0x20) <= 0x7A)",
        #"    }"#,
    ])
    add(mut out, search("LETTER", "c > 0xFFFF", letters))
    add(mut out, [#"}"#, "", "// The {marks.len()} runs of non-spacing marks: where each starts, and where it ends."])
    add(mut out, table("MARK_FIRST", "u32", firsts(marks)))
    add(mut out, table("MARK_LAST", "u32", lasts(marks)))
    add(mut out, ["", "// The {letters.len()} runs of units that are letters or digits."])
    add(mut out, table("LETTER_FIRST", "u32", firsts(letters)))
    add(mut out, table("LETTER_LAST", "u32", lasts(letters)))
    return "{out.join("\n")}\n"
}

/// Write src/java/categories.calx from JDK 25's Unicode categories.
@cli(name: "categories")
struct Args {
    /// Fail if the committed module is out of date.
    check: bool
    /// The JDK 25 to ask.
    java_home: String?
}

pub fn main() {
    let args = Args.parse()
    let text = module_text(dump(find_java_home(args.java_home)))
    put("src/java/categories.calx", text, args.check, "calx oracle/unicode/categories.calx")
}
