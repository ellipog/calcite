module oracle.unicode.names

// Writes src/java/names.calx, the character names Java's Character.codePointOf reads, from JDK 25.
//
//     calx oracle/unicode/names.calx            # run Names.java on JDK 25 and write the module
//     calx oracle/unicode/names.calx --check    # fail if what's committed is out of date
//
// Vanilla's SNBT reads `\N{SNOWMAN}` as the character Java's `Character.codePointOf` names, which
// takes back exactly the names `Character.getName` gives. Names.java prints those for every code
// point, by calling the JDK's public API only, and this turns them into a module: the names of
// their own, sorted and front-coded, and the runs of code points Java names by their block and
// number instead, such as `CJK UNIFIED IDEOGRAPHS 4E00`. The names are Unicode's, under the
// Unicode License V3, whose notice the module keeps.

import std.cli.{cli}
import std.fs.{is_file, read_text, write_text}
import std.process.{Command, exit}
import oracle.jdk.{find_java_home, java}
import tools.repo.{die, under}

/// The Unicode License V3's notice, which the modules made from Unicode's data keep.
pub fn notice() -> String {
    let text = #"
UNICODE LICENSE V3

COPYRIGHT AND PERMISSION NOTICE

Copyright © 1991-2024 Unicode, Inc.

NOTICE TO USER: Carefully read the following legal agreement. BY
DOWNLOADING, INSTALLING, COPYING OR OTHERWISE USING DATA FILES, AND/OR
SOFTWARE, YOU UNEQUIVOCALLY ACCEPT, AND AGREE TO BE BOUND BY, ALL OF THE
TERMS AND CONDITIONS OF THIS AGREEMENT. IF YOU DO NOT AGREE, DO NOT
DOWNLOAD, INSTALL, COPY, DISTRIBUTE OR USE THE DATA FILES OR SOFTWARE.

Permission is hereby granted, free of charge, to any person obtaining a
copy of data files and any associated documentation (the "Data Files") or
software and any associated documentation (the "Software") to deal in the
Data Files or Software without restriction, including without limitation
the rights to use, copy, modify, merge, publish, distribute, and/or sell
copies of the Data Files or Software, and to permit persons to whom the
Data Files or Software are furnished to do so, provided that either (a)
this copyright and permission notice appear with all copies of the Data
Files or Software, or (b) this copyright and permission notice appear in
associated Documentation.

THE DATA FILES AND SOFTWARE ARE PROVIDED "AS IS", WITHOUT WARRANTY OF ANY
KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT OF
THIRD PARTY RIGHTS.

IN NO EVENT SHALL THE COPYRIGHT HOLDER OR HOLDERS INCLUDED IN THIS NOTICE
BE LIABLE FOR ANY CLAIM, OR ANY SPECIAL INDIRECT OR CONSEQUENTIAL DAMAGES,
OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS,
WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION,
ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THE DATA
FILES OR SOFTWARE.

Except as contained in this notice, the name of a copyright holder shall
not be used in advertising or otherwise to promote the sale, use or other
dealings in these Data Files or Software without prior written
authorization of the copyright holder.
"#
    return String(text.trim_end())
}

/// The notice as a module's doc comment lines.
pub fn notice_lines() -> List<String> {
    var out: List<String> = []
    for line in notice().split("\n") {
        out.push(if line.is_empty() { String("///") } else { "/// {line}" })
    }
    return out
}

/// What the Java program `file` prints on JDK 25, run from its source.
pub fn run_java(home: String, file: String) -> String {
    let r = match Command.new(java(home)).args([file.copy()]).output() {
        ok(o) => o,
        err(e) => die("starting java on {file}: {e}"),
    }
    if not r.status.success() {
        die("{file} failed: {r.error_text()}")
    }
    return r.text()
}

/// Writes `text` to the module at `rel`, or with `check`, fails if it isn't what's there, naming
/// the tool that writes it.
pub fn put(rel: String, text: String, check: bool, tool: String) {
    let file = under(rel)
    let old: String? = if is_file(file) {
        match read_text(file) {
            ok(t) => t,
            err(_) => none,
        }
    } else {
        none
    }
    if old == some(text.copy()) {
        return
    }
    if check {
        eprintln("{rel} is out of date: run {tool}")
        exit(1)
    }
    if let err(e) = write_text(file, text.copy()) {
        die("writing {rel}: {e}")
    }
    println("wrote {rel}")
}

// The first character of a line says how much of the line before's name it shares: `0` for
// none, and one more for each character.
const SHARED_BASE: u32 = 0x30

struct Run {
    name: String
    first: u32
    last: u32
}

fn is_ascii(s: String) -> bool {
    for i in 0..s.len() {
        if s.byte_at(i) >= 0x80 {
            return false
        }
    }
    return true
}

/// Every code point and the name `Character.getName` gives it, in code point order.
fn dump(home: String) -> List<(u32, String)> {
    var pairs: List<(u32, String)> = []
    for line in run_java(home, under("oracle/unicode/Names.java")).lines() {
        let (hex_cp, name) = line.split_once(";") ?? die("Names.java printed {line}")
        let cp = u32.parse_radix(hex_cp, 16) ?? die("Names.java printed {line}")
        pairs.push((cp, name.copy()))
    }
    return pairs
}

/// The text of src/java/names.calx.
fn module_text(pairs: List<(u32, String)>) -> String {
    var named: List<(String, u32)> = []
    var blocks: List<Run> = []
    for (cp, name) in pairs {
        let suffix = " {cp:X}"
        if name.ends_with(suffix) {
            let block = name[..name.len() - suffix.len()].copy()
            let n = blocks.len()
            if n > 0 and blocks[n - 1].name == block and blocks[n - 1].last + 1 == cp {
                blocks[n - 1].last = cp
            } else {
                blocks.push(Run { name: block, first: cp, last: cp })
            }
        } else {
            named.push((name.copy(), cp))
        }
    }
    // In order of name, then code point, as Python sorts the pairs: the names are ASCII, so their
    // bytes sort as their characters do.
    named.sort_by(|a, b| "{a.0}\u{0}{a.1:08X}".cmp("{b.0}\u{0}{b.1:08X}"))
    for (name, _) in named {
        if name.contains("\"#") or name.contains("#\{") or name.contains(";") or name != name.trim() or not is_ascii(name) {
            die("a name the table can't hold: '{name}'")
        }
    }
    var lines: List<String> = []
    var previous = String()
    for (name, cp) in named {
        var shared: usize = 0
        while shared < name.len().min(previous.len()) and name.byte_at(shared) == previous.byte_at(shared) {
            shared += 1
        }
        if SHARED_BASE + u32.wrap(shared) >= 0x7B {
            die("{name} shares too much with the name before it")
        }
        let lead = rune.try_from(SHARED_BASE + u32.wrap(shared)) ?? die("a shared count")
        lines.push("{lead}{name[shared..]};{cp:X}")
        previous = name.copy()
    }
    var out: List<String> = [
        "/// The names Java's `Character.getName` gives code points, which `Character.codePointOf`",
        "/// takes back, from JDK 25, which has Unicode 16.0's. Written by oracle/unicode/names.calx",
        "/// from what the JDK's public API gives: don't edit it.",
        "///",
        "/// The names are the Unicode Character Database's, under this notice:",
        "///",
    ]
    for l in notice_lines() {
        out.push(l.copy())
    }
    for l in [
        "module java.names",
        "",
        "/// A run of code points with no name of their own, which Java names by their block and",
        "/// their number in uppercase hex, as `CJK UNIFIED IDEOGRAPHS 4E00`.",
        "pub struct Block \{",
        "    pub name: String",
        "    pub first: u32",
        "    pub last: u32",
        #"}"#,
        "",
    ] {
        out.push(String(l))
    }
    out.push("/// The {blocks.len()} runs, in code point order.")
    out.push("pub fn blocks() -> List<Block> \{")
    out.push("    return [")
    for b in blocks {
        out.push("        Block \{ name: \"{b.name}\", first: 0x{b.first:X}, last: 0x{b.last:X} \},")
    }
    out.push("    ]")
    out.push(#"}"#)
    out.push("")
    out.push("/// The {named.len()} names of their own, sorted, a line each: a character saying how many of")
    out.push("/// the line before's first characters the name shares, `0` for none and one more for each,")
    out.push("/// then the rest of the name, then `;` and the code point in uppercase hex.")
    out.push("pub fn named() -> String \{")
    out.push("    return #\"")
    for l in lines {
        out.push(l.copy())
    }
    out.push("\"#")
    out.push(#"}"#)
    return "{out.join("\n")}\n"
}

/// Write src/java/names.calx from JDK 25's character names.
@cli(name: "names")
struct Args {
    /// Fail if the committed module is out of date.
    check: bool
    /// The JDK 25 to ask.
    java_home: String?
}

pub fn main() {
    let args = Args.parse()
    let text = module_text(dump(find_java_home(args.java_home)))
    put("src/java/names.calx", text, args.check, "calx oracle/unicode/names.calx")
}
