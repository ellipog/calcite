module oracle.check_packets

// Reads the packets Calcite's tests were sent with vanilla's own codecs (D145).
//
//     calx oracle/check_packets.calx
//
// src/test/play.calx and src/test/configuration.calx write every packet their clients are sent to
// build/packets/. This runs PacketCheck, from the adapter oracle/adapter.calx builds, on those
// files: each packet must decode, leave nothing over and encode back to the same bytes. Then
// ChatCheck reads the signed chat test's clients' chat, in build/packets/chat/, as a 26.3 client
// takes it in: each chat session must check out against the key standing in for Mojang's, and each
// message against its sender's key, in its chain, with its last-seen list unpacked from the
// client's cache. It exits with 1 if any packet fails, and with 2 if the adapter isn't built or
// there's nothing to check.

import std.fs.{glob, is_file}
import std.process.{Output, exit}
import oracle.adapter.{Adapter, load, run_class, tail}
import tools.repo.{under}

/// Runs one of the adapter's checks, prints what it says, and its log if the check itself broke.
fn check(a: Adapter, main_class: String, args: List<String>, done: String) -> Output {
    let r = run_class(a, main_class, args)
    let said = r.text()
    print(said)
    // Vanilla's log goes to stderr, and matters only if the check itself broke.
    if not r.status.success() and not said.contains(done) {
        print(tail(r.error_text(), 4000))
    }
    return r
}

fn last_line(text: String) -> String? {
    let lines = text.trim().lines()
    if lines.is_empty() {
        return none
    }
    return some(lines[lines.len() - 1].copy())
}

fn code(r: Output) -> u8 {
    return if r.status.success() { 0u8 } else { 1u8 }
}

pub fn main() {
    let a = load() ?? {
        println("check_packets: the vanilla adapter isn't built; run calx oracle/adapter.calx")
        exit(2)
    }
    let files = match glob(under("build/packets/*.bin")) {
        ok(f) => f,
        err(_) => [],
    }
    if files.is_empty() {
        println("check_packets: no packets in build/packets; run the tests first")
        exit(2)
    }
    let packets = check(a, "PacketCheck", files, "kinds failed")
    let chat_dir = under("build/packets/chat")
    if not is_file("{chat_dir}/services.der") {
        exit(code(packets))
    }
    let chat = check(a, "ChatCheck", [chat_dir.copy()], "refused")
    // The last line sums up both, for the test runner.
    var last: List<String> = []
    if let l = last_line(packets.text()) {
        last.push(l)
    }
    if let l = last_line(chat.text()) {
        last.push(l)
    }
    println(last.join("; "))
    exit(if code(packets) != 0 { code(packets) } else { code(chat) })
}
