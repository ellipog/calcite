module oracle.jdk

// Finds a JDK of the version the game targets, for the vanilla adapter and the data generator.

import std.env.{variable}
import std.fs.{glob, is_file, real_path}
import std.path
import std.process.{Command, which}
import tools.repo.{die, exe}

pub const REQUIRED_JAVA: i32 = 25

/// The first JDK of the required major version: `explicit`, CALCITE_JAVA_HOME, JAVA_HOME, javac on
/// PATH, then common install locations, newest first.
pub fn find_java_home(explicit: String?) -> String {
    var candidates: List<String> = []
    if let given = explicit {
        candidates.push(given.copy())
    }
    for name in ["CALCITE_JAVA_HOME", "JAVA_HOME"] {
        if let home = variable(name) {
            candidates.push(home)
        }
    }
    if let on_path = which("javac") {
        if let ok(real) = real_path(on_path) {
            if let bin = path.parent_dir(real) {
                if let home = path.parent_dir(bin) {
                    candidates.push(home)
                }
            }
        }
    }
    let user = variable("USERPROFILE") ?? (variable("HOME") ?? String(""))
    var patterns: List<String> = []
    if not user.is_empty() {
        patterns.push(path.join(user, "tools/jdk-{REQUIRED_JAVA}*"))
    }
    patterns.push("C:/Program Files/Eclipse Adoptium/jdk-{REQUIRED_JAVA}*")
    patterns.push("C:/Program Files/Java/jdk-{REQUIRED_JAVA}*")
    patterns.push("/usr/lib/jvm/*{REQUIRED_JAVA}*")
    patterns.push("/opt/jdk-{REQUIRED_JAVA}*")
    for pattern in patterns {
        let ok(matched) = glob(pattern) else {
            continue
        }
        var found = matched
        found.reverse()
        for home in found {
            candidates.push(home.copy())
        }
    }
    for home in candidates {
        if home.is_empty() or not is_file(java(home)) {
            continue
        }
        // The first line reads like: openjdk version "25.0.5" 2025-10-21 LTS
        let out = match Command.new(java(home)).arg("-version").output() {
            ok(o) => o.error_text(),
            err(_) => continue,
        }
        let quoted = out.split("\"")
        if quoted.len() < 2 {
            continue
        }
        let numbers = quoted[1].split(".")
        if i32.parse(numbers[0]) == some(REQUIRED_JAVA) {
            return path.normalize(home.copy())
        }
    }
    die("no JDK {REQUIRED_JAVA} found. Pass --java-home or set CALCITE_JAVA_HOME.")
}

/// The JDK's `java`.
pub fn java(home: String) -> String {
    return path.join(home, "bin/java{exe()}")
}

/// The JDK's `javac`.
pub fn javac(home: String) -> String {
    return path.join(home, "bin/javac{exe()}")
}
