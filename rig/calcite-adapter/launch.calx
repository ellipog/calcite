// Builds Calcite's rig adapter with calx, then runs it (P3.8).
//
// The adapter is Calcite's own code, in src/rig/adapter.calx. This only builds it and hands it
// the runner's standard input and output. A release build takes under half a second, and calx
// reuses it when nothing changed, so it builds on every start and is never stale.
//
// calx is found from the CALX environment variable, then PATH, then a calx checkout beside this
// repository (../calx), as the workspace has it. CALCITE_DEBUG=1 builds without --release, so the
// adapter checks that it frees everything it allocates. It imports only std, so it runs from this
// folder, whose name has a hyphen.

import std.env.{os, script, variable}
import std.fs.{is_file}
import std.path
import std.process.{Command, exit, which}

fn calcite() -> String {
    let here = path.parent_dir(script() ?? String(".")) ?? String(".")
    return path.normalize(path.join(here, "../.."))
}

fn exe() -> String {
    return if os() == "windows" { String(".exe") } else { String("") }
}

fn find_calx() -> String {
    if let given = variable("CALX") {
        if not given.is_empty() {
            return given
        }
    }
    if let found = which("calx") {
        return found
    }
    let parent = path.parent_dir(calcite()) ?? String("..")
    let beside = path.join(parent, "calx/build/compiler/{os()}/calx{exe()}")
    if is_file(beside) {
        return beside
    }
    eprintln("calcite-adapter: no calx. Set CALX, put calx on PATH, or build ../calx")
    exit(1)
}

fn main() {
    let debug = variable("CALCITE_DEBUG") == some(String("1"))
    let root = calcite()
    let binary = path.join(root, "build/rig/{os()}/calcite-adapter{if debug { "-debug" } else { "" }}{exe()}")
    var build: List<String> = [String("build")]
    if not debug {
        build.push("--release")
    }
    build.push("src/rig/adapter.calx")
    build.push("-o")
    build.push(binary.copy())
    // Standard output carries only frames, so the build's output goes to standard error.
    let built = match Command.new(find_calx()).args(build).dir(root.copy()).output() {
        ok(o) => o,
        err(e) => {
            eprintln("calcite-adapter: the build didn't start: {e}")
            exit(1)
        }
    }
    eprint(built.text())
    eprint(built.error_text())
    if not built.status.success() {
        eprintln("calcite-adapter: the build failed with status {built.status.code ?? -1}")
        exit(1)
    }
    // It runs from the repository's root, where probes find what they read, such as the jar in
    // oracle/jars/.
    let ran = match Command.new(binary).dir(root).status() {
        ok(s) => s,
        err(e) => {
            eprintln("calcite-adapter: the adapter didn't start: {e}")
            exit(1)
        }
    }
    exit(u8.wrap(ran.code ?? 1))
}
