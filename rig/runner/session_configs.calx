module rig.runner.session_configs

// The protocol suites' configurations (rig/runner/sessions.calx), each a set of server.properties,
// the bot's scenarios and what both servers are given, in the order sessions.py ran them
// (CAL-253). Each one's comment says what it's for, as sessions.py's did.

import std.nbt.{Tag}
import rig.runner.session_data
import rig.runner.session_data.{Rule, dig_rules, dig_drop_rules, no_spawning, quiet, quiet_respawn, rule, use_items_rules}

/// The view both servers have, unless a configuration says otherwise.
pub const VIEW: i64 = 4
/// The scenarios a configuration runs, unless it says otherwise.
pub const SCENARIOS: [str; 5] = ["status", "outdated", "bad-name", "stranger", "join"]
/// The world the round trip has vanilla make and save (rig/runner/roundtrip.calx), from the seed
/// `calcite` with real terrain, its chunks full from -6 to 5 around the origin.
pub const SAVED_WORLD: str = "build/rig/roundtrip/vanilla/world"
/// The same seed's world with the same chunks loaded and saved, and nothing put in it, which the
/// round trip's `make_plain` has vanilla make the first time a configuration loads it (D599).
pub const PLAIN_WORLD: str = "build/rig/roundtrip/plain/world"

/// A configuration: what it adds to the properties, the view, its scenarios, and the world both
/// servers are given a copy of, or none for the flat world each makes. Paths are the repository's.
pub struct Config {
    pub props: List<(String, String)>
    pub view: i64
    pub scenarios: List<String>
    pub world: String?
    /// Typed into vanilla's console after its own commands, with what it answers.
    pub commands: List<(String, String)>
    /// Where the copy of `world` has its spawn, both servers' level.dat's, if it's moved.
    pub spawn: List<i32>?
    /// Whether the copy keeps the world's entities, each dimension's `entities` folder.
    pub entities: bool
    /// Game rules set in the copy's game_rules.dat, which both servers read, by their names.
    pub rules: List<Rule>
    /// The fixture `world` is, which is built from its commands if it isn't, or none.
    pub fixture: String?
    /// The bot's saved data, which both servers read as it joins, or none for a player new to the
    /// world.
    pub player: Tag?
    /// The names of the players in ops.json, at level 4, none of them the bot (D376).
    pub ops: List<String>
    /// Whether it's taped whether or not --tape says so, its levels' randoms seeded again at
    /// RESEED, as what it compares lines up only from there, natural spawning's mobs (CAL-156).
    pub tape: bool
    /// What else of the bot's saved data is compared, past PLAYER_KEYS (D418).
    pub keys: List<String>
    /// The second player's saved data, Mate's, whom the whitelist lets in with the bot, or none
    /// where there's none (CAL-162).
    pub mate: Tag?
    /// Data packs put in the world's datapacks folder, which both servers find and load as they
    /// start: each pack's folder name and its files, by their paths in it, with what's in them
    /// (CAL-164).
    pub datapacks: List<(String, List<(String, String)>)>
    /// Saved data put in the world's data/minecraft folder, which both servers read as they
    /// start: each file's root by its name, such as `scoreboard` (CAL-164).
    pub saved: List<(String, Tag)>
    /// Saved data put in a dimension's data/minecraft folder: each file's root by the dimension's
    /// folder under `dimensions` and its name, such as `minecraft/the_end/ender_dragon_fight`
    /// (D586).
    pub dim_saved: List<(String, Tag)>
    /// The End's chunks compared as both servers saved them, each `(x0, z0, x1, z1)` inclusive
    /// (D625, D627).
    pub end_chunks: List<(i64, i64, i64, i64)>
}

fn strings(xs: List<str>) -> List<String> {
    var out: List<String> = []
    for x in xs {
        out.push(String(x))
    }
    return out
}

fn pairs(xs: List<(str, str)>) -> List<(String, String)> {
    var out: List<(String, String)> = []
    for (k, v) in xs {
        out.push((String(k), String(v)))
    }
    return out
}

/// A configuration with these properties and the rest as they are unless it says otherwise.
pub fn base(props: List<(str, str)>) -> Config {
    return Config {
        props: pairs(props), view: VIEW, scenarios: strings(SCENARIOS.to_list()), world: none, commands: [], spawn: none,
        entities: true, rules: [], fixture: none, player: none, ops: [], tape: false, keys: [], mate: none,
        datapacks: [], saved: [], dim_saved: [], end_chunks: [],
    }
}

/// A configuration on fixture `name`'s world, at a view of 3, running `scenarios`.
pub fn fx(props: List<(str, str)>, scenarios: List<str>, name: str, rules: own List<Rule>, player: own Tag?) -> Config {
    var c = base(props)
    c.view = 3
    c.scenarios = strings(scenarios)
    c.world = some("build/rig/fixtures/{name}/world")
    c.fixture = some(String(name))
    c.rules = rules
    c.player = player
    return c
}

impl Config {
    pub fn comparing(own self, keys: List<str>) -> Config {
        var c = self
        c.keys = strings(keys)
        return c
    }

    pub fn comparing_keys(own self, keys: own List<String>) -> Config {
        var c = self
        c.keys = keys
        return c
    }

    pub fn taped(own self) -> Config {
        var c = self
        c.tape = true
        return c
    }

    pub fn with_ops(own self, ops: List<str>) -> Config {
        var c = self
        c.ops = strings(ops)
        return c
    }

    pub fn with_mate(own self, mate: own Tag) -> Config {
        var c = self
        c.mate = some(mate)
        return c
    }

    pub fn running(own self, scenarios: List<str>) -> Config {
        var c = self
        c.scenarios = strings(scenarios)
        return c
    }

    pub fn seen(own self, view: i64) -> Config {
        var c = self
        c.view = view
        return c
    }
}

const NORMAL: [(str, str); 1] = [("difficulty", "normal")]

fn normal() -> List<(str, str)> {
    return NORMAL.to_list()
}

/// Each configuration by its name, in the order they run.
pub fn configs() -> LinkedMap<String, Config> {
    var out = LinkedMap<String, Config>()
    out.insert(String("compressed"), base([]))
    // The bot joins with a saved inventory, which each server sends with the inventory menu's
    // slots, then joins again and sets creative slots; what each saves of it is compared (CAL-135).
    var inventory = base([]).running(["join", "creative"])
    inventory.player = some(session_data.inventory())
    out.insert(String("inventory"), inventory)
    // The bot, in survival with the same inventory, clicks in its inventory menu; what each server
    // sends back, and what each saves of it, is compared (CAL-136). Taped, as the mobs natural
    // spawning puts by it are drawn from the levels' randoms (CAL-222).
    var clicks = base([]).running(["clicks"]).taped()
    clicks.player = some(session_data.clicks())
    out.insert(String("clicks"), clicks)
    // The bot joins with its inventory full but for a slot, and a data pack's advancement gives it
    // experience and loot on its first tick: what fits added with a sound, the rest dropped for it
    // alone to pick up at once (CAL-164).
    var rewards = base([]).running(["join"])
    rewards.player = some(session_data.rewards())
    rewards.datapacks = [(String("rewards"), session_data.rewards_pack())]
    out.insert(String("rewards"), rewards)
    var scores = base([]).running(["join"])
    scores.saved = [(String("scoreboard"), session_data.scoreboard())]
    out.insert(String("scores"), scores)
    out.insert(String("uncompressed"), base([("network-compression-threshold", "-1")]))
    // A saved world, whose chunks both servers read and light (CAL-76). A view of 3 sends the
    // chunks from -4 to 4, which vanilla lights with their neighbours, all of them full in the
    // save. Its spawn is moved to the origin, so the player is in chunk (0, 0), on the ground
    // there, as each server finds it (CAL-75).
    var saved = base([]).seen(3).running(["join"])
    saved.world = some(String(SAVED_WORLD))
    saved.spawn = some([0i32, 100, 0].to_list())
    out.insert(String("saved"), saved.copy())
    // The same world without its entities, so its blocks' random ticks show on the tape past the
    // mobs, whose brains draw first, and the End's crystals, which come with entities (CAL-106);
    // and without natural spawning, `spawn_mobs` off, whose first mob's `finalizeSpawn` drew
    // where Calcite has no mob to draw for, so the tape goes on past it (D338).
    var terrain = saved.copy()
    terrain.entities = false
    terrain.rules = no_spawning()
    out.insert(String("terrain"), terrain)
    // Redstone that runs by itself, built in vanilla with its ticks waiting in the save, by the
    // spawn, in the player's chunk (CAL-116), without natural spawning, as `terrain`; its clocks
    // never stop, so the bot watches it a fixed time.
    out.insert(String("redstone"), fx([], ["watch"], "redstone", no_spawning(), none))
    // Block entities saved by the spawn, sent with their chunks, and two heads a clock powers,
    // each sent with its update packet as it changes (CAL-115); watched, as `redstone`.
    out.insert(String("block_entities"), fx([], ["watch"], "block_entities", no_spawning(), none))
    // Comparators by the spawn reading containers and other blocks, whose ticks wait in the save,
    // and two whose sides a clock powers, subtracting and comparing (CAL-123); watched, as
    // `redstone`.
    out.insert(String("comparators"), fx([], ["watch"], "comparators", no_spawning(), none))
    // Pistons by the spawn, driven by observer clocks and by repeaters whose ticks wait in the
    // save: pushing, pulling, slime and blocks they can't move (CAL-125); watched, as `redstone`.
    out.insert(String("pistons"), fx([], ["watch"], "pistons", no_spawning(), none))
    // The blocks a signal changes by the spawn, each pulsed by an observer clock: doors,
    // trapdoors, a fence gate, a copper bulb, a hopper, an empty dispenser, dropper and crafter, a
    // note block, a bell, a big dripleaf, a command block, rails and shelves (CAL-124); watched,
    // as `redstone`.
    out.insert(String("receivers"), fx([], ["watch"], "receivers", no_spawning(), none))
    // The blocks that make a signal of their own by the spawn, set as a command sets them, each
    // beside a lamp an observer clock pulses: buttons, a lever, pressure plates, a lectern, a
    // detector rail, a lightning rod let go as it ticks, a target, a trapped chest, a jukebox and
    // a tripped tripwire line detaching (CAL-128); watched, as `redstone`.
    out.insert(String("sources"), fx([], ["watch"], "sources", no_spawning(), none))
    // Sponges and frosted ice by the spawn: a lake a sponge took up as the world was built flowing
    // into the hole, water flowing up a channel to a dry sponge, and frosted ice aging and melting
    // (CAL-127); watched, as `redstone`.
    out.insert(String("water_blocks"), fx([], ["watch"], "water_blocks", no_spawning(), none))
    // Block entities' tickers at dusk: daylight detectors putting out the sky's light as it
    // darkens and the sun goes down, plain, inverted, under leaves and stone, lighting lamps; a
    // crafter done crafting, a brewing stand showing its bottles, a hopper's cooldown, and tickers
    // with nothing to do (CAL-130); watched, as `redstone`.
    out.insert(String("tickers"), fx([], ["watch"], "tickers", no_spawning(), none))
    // The bot, in survival mode, digs the dig fixture's ground: under spawn protection, which an
    // op who isn't it has a block around the spawn under; through, let go too soon so it's dug the
    // rest of the way; stopped, switched, aborted elsewhere, out of reach; a tripwire cut with
    // shears; a pickaxe broken; and its hands swapped (D376).
    out.insert(String("dig"), fx([("spawn-protection", "1")], ["dig"], "dig", dig_rules(), some(session_data.dig())).with_ops(["Op"]))
    // The same with drops on (CAL-153): what each block the bot breaks drops, from its loot table
    // and random sequence, popped as items, which it picks up as it comes by them.
    out.insert(String("dig_drops"), fx([("spawn-protection", "1")], ["dig"], "dig", dig_drop_rules(), some(session_data.dig())).with_ops(["Op"]))
    // The bot, in creative mode, breaks the dig fixture's blocks: the ground, a bed's foot, a
    // door's and tall grass's tops, a command block it may not, and the ground with a sword
    // (D376).
    out.insert(String("dig_creative"), fx([], ["dig-creative"], "dig", dig_rules(), some(session_data.dig_creative())))
    // The bot, in survival mode, places blocks by the place fixture's: on the ground, where it
    // stands, in short grass, from its offhand, on a lectern that takes the use; stairs, slabs, a
    // log, a door, a bed, torches, fences and a furnace, each as it looks; out of reach and hit
    // far from the block (D378).
    out.insert(String("place"), fx([], ["place"], "place", dig_rules(), some(session_data.place())))
    // The bot, in creative mode, places blocks given it: turned as it looks, joined to their
    // neighbours, on a side or falling to the floor, powered, and with block entities (D378).
    out.insert(String("place_creative"), fx([], ["place-creative"], "place", dig_rules(), some(session_data.place_creative())))
    // The bot, in survival mode with empty hands, uses the use fixture's blocks: doors, a
    // trapdoor, a fence gate, a lever and a button lighting lamps, a repeater, a comparator, a note
    // block, a bell, a daylight detector and redstone dust (D379).
    out.insert(String("use"), fx([], ["use"], "use", dig_rules(), some(session_data.use_hands())))
    // The bot, in survival mode and hungry, uses items on the use_items fixture's blocks: seeds
    // and a cake in a composter, a sapling in a flower pot and back, a candle put out, a candle on
    // a cake, which it eats, and cauldrons with buckets, bottles, a dyed helmet and banners
    // (CAL-142).
    out.insert(String("use_items"), fx([], ["use-items"], "use_items", use_items_rules(), some(session_data.use_items())))
    // The bot, in survival mode, puts a book on the use_items fixture's lectern, books in its
    // chiseled bookshelf and takes one back, and stone in its decorated pot (CAL-142); then plays a
    // record in its jukebox and swaps stacks on its shelves (CAL-143).
    out.insert(String("use_books"), fx([], ["use-books"], "use_items", use_items_rules(), some(session_data.use_books())))
    // The bot, in survival mode, opens the containers fixture's chest, large chest, trapped
    // chest, barrel, ender chest, shulker box, dispenser and hopper, each in a step of its own,
    // clicks stacks in and out of them and closes them; opens a chest with the hopper open; and
    // finds a chest under stone won't open (CAL-144).
    out.insert(String("use_containers"), fx([], ["use-containers"], "containers", dig_rules(), some(session_data.use_containers())))
    // The bot, in survival mode, crafts in its inventory menu's grid: planks, a button, sticks
    // shift-clicked, a rocket swapped out with a hotbar key and a honey block, its bottles left;
    // then at the crafting fixture's table: a pickaxe shift-clicked out, cobblestone dragged across
    // for slabs shift-clicked out twice over, and logs shift-clicked into the grid, which closing
    // puts back. What each server sends back, and what each saves of it, is compared (CAL-147).
    // The crafting fixture's world, as the dig one's rules have it, has no mobs to tell of.
    out.insert(String("crafts"), fx([], ["crafts"], "crafting", dig_rules(), some(session_data.crafts())))
    // The bot, in survival mode, drops stacks it holds and throws them out of its inventory menu
    // and with the throw key, onto the items fixture's grass, ice and water, where they fall,
    // slide, float and merge, then walks over them and picks them up (CAL-148). Each item's
    // packets are compared in the order it was sent them, apart from the steps, whose ends fall
    // between an item's moves as the clock has it.
    out.insert(String("items"), fx([], ["items"], "items", dig_rules(), some(session_data.item_player())))
    // The bot, in survival mode, joins a world with items saved in it, which both servers load,
    // and walks over them, picking up those it may; each server saves the rest again (CAL-148).
    out.insert(String("items_saved"), fx([], ["items-saved"], "items_saved", dig_rules(), some(session_data.item_player())))
    // The bot, in survival mode with drops on, breaks the orbs fixture's sculk and sculk catalyst
    // with a diamond hoe with mending; their experience orbs, split as `award` splits it, follow it
    // and are picked up one a touch, mending the hoe first, the rest the bot's (CAL-154).
    out.insert(String("orbs"), fx([], ["orbs"], "orbs", dig_drop_rules(), some(session_data.orbs())))
    // The bot, in survival mode, feeds the feed fixture's penned cows, calf and sheep wheat by the
    // server's clock (D415), and waits as the cows and the sheep breed, their orbs come to it and
    // their babies grow; no natural spawning, and no advancement messages (CAL-158).
    out.insert(String("feed"), fx([], ["feed"], "feed", quiet(), some(session_data.feed())))
    // The bot, in survival mode, hits the attack fixture's cows and sheep, each penned in a cell
    // of its own, by the server's clock (D415): with its fist, then a stone axe, charged and not,
    // its second hit in a tick shrugged off, till each dies, dropping its loot and orbs, the calf
    // none; then hits an item, for which the server disconnects it (CAL-162, D416).
    out.insert(String("attack"), fx([], ["attack"], "attack", quiet(), some(session_data.attack())))
    // The bot, in survival mode with an iron sword, hits the sweep fixture's cows and sheep,
    // penned side by side, by the server's clock: its sweeps hurt and knock back the others, a hit
    // as it sprints doesn't sweep and stops its sprint, till all are dead (D417).
    out.insert(String("sweep"), fx([], ["sweep"], "sweep", quiet(), some(session_data.sweep())))
    // The bot, in survival mode with enchanted swords, hits the enchant fixture's cow, zombie and
    // sheep by the server's clock, on normal, which keeps the zombie (D438): smite on the cow and
    // the sheep its sweep reaches, which adds nothing; sharpness and knockback on the zombie; fire
    // aspect on the sheep and the cow its sweep reaches, which burn to death, their meat cooked;
    // and smite on the zombie, which kills it.
    out.insert(String("enchant"), fx(normal(), ["enchant"], "enchant", quiet(), some(session_data.enchant())))
    // The bot, in survival mode with an iron sword, falls onto the fall fixture's honey, into its
    // water, and from its basin to the ground, hitting the cow there as it falls, by the server's
    // clock: each fall's damage, its dust and the cow's critical hit (D418).
    out.insert(String("fall"), fx([], ["fall"], "fall", quiet(), some(session_data.fall())).comparing_keys(session_data.fall_keys()))
    // `fall` in enchanted armor, feather falling and protection taking their shares of each fall
    // (D439).
    out.insert(String("fall-armored"), fx([], ["fall"], "fall", quiet(), some(session_data.fall_armored())).comparing_keys(session_data.fall_keys()))
    // The bot, in survival mode with an iron sword, hits the protect fixture's zombies by the
    // server's clock, on normal, which keeps them (D439): one in a diamond chestplate with
    // protection IV, which takes its share of each hit; and one in diamond boots with frost walker
    // II and one in a leather helmet with fire protection IV, which give nothing against a hit.
    // Taped, as what its hits do draws from the level's random, which holds what loading drew till
    // it's seeded again (CAL-223).
    out.insert(String("protect"), fx(normal(), ["protect"], "protect", quiet(), some(session_data.sweep())).taped())
    // The bot, in survival mode with `enchant`'s swords, hits the stand_hits fixture's armor
    // stands by the server's clock (D441): Bob, named, shaken by a hit, again 30 ticks on, then
    // broken by one 3 ticks after that, dropping his helmet and himself, named, the first sweep
    // reaching the stand beside him and knocking it back; the stand to the north lit by fire
    // aspect, which burns it to its breaking, its chestplate dropped; the invisible stand and the
    // marker, which no hit hurts; while a stand in soul fire and one on a campfire burn to their
    // breaking.
    out.insert(String("stand-hits"), fx([], ["stand-hits"], "stand_hits", quiet(), some(session_data.enchant())))
    // The bot, in survival mode with its hands empty, hits the thorns fixture's zombie by the
    // server's clock, on normal, which keeps him (D442): his thorns hurt it back, knocking it back
    // and bringing it into combat, which ends 300 of its ticks after; then they kill it, the
    // message naming him and the sword with a custom name he holds (D448), and it leaves dead.
    // Taped, as thorns' chance and damage are drawn from the level's random, which drew what
    // loading drew till it's seeded again (CAL-223).
    out.insert(String("thorns"), fx(normal(), ["thorns"], "thorns", quiet_respawn(), some(session_data.thorns())).taped())
    // The bot, in survival with an iron sword, hits a second player, Mate, by the server's clock
    // on the duel fixture's world, on normal, a sheep by Mate (CAL-162): a punch, a sword's hit
    // whose sweep reaches the sheep, a hit on the sheep whose sweep reaches Mate, a sprint's
    // knockback attack, then hits till Mate dies and one once it's respawned, and Mate leaves
    // before the bot.
    out.insert(String("duel"), fx(normal(), ["duel"], "duel", quiet_respawn(), some(session_data.duel())).with_mate(session_data.duel_mate()))
    // The bot, in survival mode with its hands empty, stands at the spawn under the zombie
    // fixture's roof, on normal, while Rot, the zombie six blocks east with his AI, takes it up as
    // his target, comes for it and hits it (CAL-159); it hits him back once, then he hits it till
    // it dies, the message naming him, and it leaves dead.
    out.insert(String("zombie"), fx(normal(), ["zombie"], "zombie", quiet_respawn(), some(session_data.thorns())))
    // `zombie`'s, with Rot on fire (CAL-159): his hits set the bot on fire now and then, by the
    // local difficulty, and it burns. The bot's in `slime`'s iron armor, so it lives till it
    // leaves: a death and respawn has vanilla reload the level's entities, which Calcite doesn't
    // yet (CAL-193).
    out.insert(String("zombie-fire"), fx(normal(), ["zombie"], "zombie-fire", quiet_respawn(), some(session_data.slime())))
    // `zombie`'s steps on hard at midnight, with natural spawning on, as `isSpawningMonsters`
    // wants it (CAL-159): the bot, in `slime`'s iron armor, hits Rot, whose chance of calling
    // reinforcements is 1, so he calls one, which comes where it may and goes for the bot.
    out.insert(String("reinforcements"), fx([("difficulty", "hard")], ["zombie"], "reinforcements", [rule("minecraft:show_advancement_messages", Tag.Byte(0)), rule("minecraft:respawn_radius", Tag.Int(0))], some(session_data.slime())))
    // `creeper`'s steps on the zombie-loot fixture's world, the bot on its pillar at midnight,
    // while Grab, the zombie who picks up loot, comes to the pillar's foot, taking up a sword, a
    // better one for it and a helmet on his way, and leaving what he doesn't want (CAL-159).
    out.insert(String("zombie-loot"), fx(normal(), ["creeper"], "zombie-loot", quiet_respawn(), some(session_data.spider())))
    // `zombie`'s, the bot in `slime`'s iron armor with thorns III on its chestplate (CAL-159):
    // Rot's hits on it are now and then thorns' on him, which hurt him from where it is and wear
    // the chestplate, and it lives till it leaves. Taped, as `thorns` is (CAL-223).
    out.insert(String("zombie-thorns"), fx(normal(), ["zombie"], "zombie", quiet_respawn(), some(session_data.thorny())).taped())
    // `zombie`'s, Rot with an iron sword with sharpness II, knockback I and fire aspect I, the bot
    // in diamond armor with protection IV (CAL-159): his hits deal more, knock it back and set it
    // on fire, and it lives till it leaves.
    out.insert(String("zombie-sword"), fx(normal(), ["zombie"], "zombie-sword", quiet_respawn(), some(session_data.knight())))
    // `zombie`'s steps on the zombie-fall fixture (CAL-159): Rot, on a pillar beside the bot,
    // which hides it from him, is knocked off it by the bot's hit and hurt by his fall.
    out.insert(String("zombie-fall"), fx(normal(), ["zombie"], "zombie-fall", quiet_respawn(), some(session_data.knight())))
    // `zombie`'s steps on the zombie-mace fixture (CAL-159): Rot, with a mace, drops off a pillar
    // beside the bot, in `zombie-sword`'s armor, and smashes it as he falls.
    out.insert(String("zombie-mace"), fx(normal(), ["zombie"], "zombie-mace", quiet_respawn(), some(session_data.knight())))
    // `skeleton`'s steps on the zombie-spear fixture (CAL-159): the bot, in `zombie-sword`'s
    // armor, stands while Rot, with an iron spear, comes to within 10 blocks, lowers it and
    // charges, his spear's hits hurting and knocking it back, then gets away and charges again.
    out.insert(String("zombie-spear"), fx(normal(), ["skeleton"], "zombie-spear", quiet_respawn(), some(session_data.knight())))
    // The bot, in survival mode with nothing, stands at the arrows fixture's spawn, on normal at
    // midnight, while arrows fly as the world loads (CAL-159): into a wall, into a zombie without
    // AI and an armor stand, which breaks, onto its head, and onto the grass by it, where it picks
    // up the one anyone may. Taped, as the stand's drop is drawn from the level's random
    // (CAL-222).
    out.insert(String("arrows"), fx(normal(), ["arrows"], "arrows", quiet_respawn(), some(session_data.arrows())).taped())
    // The bot, in survival mode with nothing, stands at the arrow-border fixture's spawn, on
    // normal at midnight, as arrows fly into the world border, set to chunk (0, 0)'s edges, as the
    // world loads (CAL-159): east, north and to the north-west corner, each bounced back off it a
    // tenth as fast, turned half round and a draw more, and fallen to the grass inside it.
    out.insert(String("arrow-border"), fx(normal(), ["arrows"], "arrow-border", quiet_respawn(), some(session_data.arrows())))
    // The bot, in survival mode with nothing, stands at the arrow-blocks fixture's spawn, on
    // normal at midnight, while arrows shot up as the world loads fall back onto blocks that act
    // as they're hit (CAL-159): amethyst chimes, burning arrows light a campfire and a candle, and
    // a chorus flower and a decorated pot break, the pot cracked, its sherds dropped.
    out.insert(String("arrow-blocks"), fx(normal(), ["arrows"], "arrow-blocks", quiet_respawn(), some(session_data.arrows())))
    // The bot, in survival mode with nothing, stands at the arrow-targets fixture's spawn, on
    // normal at midnight, while arrows from as the world loads hit a target block, a big dripleaf
    // and a bell (CAL-159): the target gives its signal, the leaf tilts down and the bell rings.
    out.insert(String("arrow-targets"), fx(normal(), ["arrows"], "arrow-targets", quiet_respawn(), some(session_data.arrows())))
    // The bot, in survival mode with nothing, stands at the arrow-buttons fixture's spawn, on
    // normal at midnight, while arrows shot up as the world loads fall into buttons (CAL-159): an
    // oak one, which they press and hold, lighting a lamp, and a stone one, which they don't.
    out.insert(String("arrow-buttons"), fx(normal(), ["arrows"], "arrow-buttons", quiet_respawn(), some(session_data.arrows())))
    // The bot, in survival mode with nothing, stands at the arbalistic fixture's spawn, on normal
    // at midnight, while its piercing arrow from a crossbow, shot as the world loads, kills a
    // zombie, a skeleton, a creeper, a cow and a pig without AI in a row (CAL-164), each kill its
    // `player_killed_entity` and each hit its `killed_by_arrow`, the fifth `adventure/arbalistic`,
    // and their orbs come to it.
    out.insert(String("arbalistic"), fx(normal(), ["arrows"], "arbalistic", quiet_respawn(), some(session_data.arrows())))
    // The bot, in survival mode with nothing, stands at the bullseye fixture's spawn, on normal at
    // midnight, while its arrow, shot from beside it as the world loads, strikes the middle of a
    // target block 31.5 blocks east (CAL-164), whose signal of 15 is its `target_hit`,
    // `adventure/bullseye`.
    out.insert(String("bullseye"), fx(normal(), ["arrows"], "bullseye", quiet_respawn(), some(session_data.arrows())))
    // The bot, in survival mode with nothing, stands at the tipped fixture's spawn, on normal at
    // midnight, while tipped arrows from as the world loads hit a cow, a zombie and a pig without
    // AI (D513), which take their potions' effects, and one sticks in a wall, where its potion
    // wears off 600 ticks later; it leaves at 700.
    out.insert(String("tipped"), fx(normal(), ["tipped"], "tipped", quiet_respawn(), some(session_data.arrows())))
    // The bot, in survival mode with nothing and the effects its data's saved with, stands at the
    // dosed fixture's spawn, on normal at midnight, while a tipped arrow of swiftness shot up falls
    // back onto its head (D514): its effects tick, heal it, hurt it and end, told it as they do,
    // and the arrow's swiftness is added, its speed's modifier sent; it leaves at 400.
    out.insert(String("dosed"), fx(normal(), ["dosed"], "dosed", quiet_respawn(), some(session_data.dosed())).comparing(["active_effects", "Health", "AbsorptionAmount", "foodLevel", "foodSaturationLevel", "foodExhaustionLevel"]))
    // The bot, in survival mode with nothing but jump boost II and slow falling, stands at the
    // lifted fixture's spawn, on normal, by mobs shut in glass with their AI and effects (D515):
    // Lift levitating up its tube and falling as it ends, Feather falling slowly down hers, Glide
    // sliding through water with dolphin's grace and Hop hopping with jump boost; at 150 it jumps,
    // and falls back slowly as the server moves it, on the ground again at 210; it leaves at 400.
    out.insert(String("lifted"), fx(normal(), ["lifted"], "lifted", quiet_respawn(), some(session_data.lifted())).comparing(["active_effects", "Health", "Motion", "fall_distance", "foodExhaustionLevel"]))
    // The bot, in survival mode at 1 health with a totem in its off hand and effects saved on it,
    // stands at the undying fixture's spawn, on normal at midnight, while a plain arrow shot up
    // falls back onto it and its totem saves it, its effects cleared and the totem's given; it hits
    // Undying, a zombie without AI at 1 health with a totem, at 120, at 200, which would kill it
    // but for its totem, and at 280, which its absorption takes (D518); it leaves at 400.
    out.insert(String("undying"), fx(normal(), ["undying"], "undying", quiet_respawn(), some(session_data.undying())).comparing(["active_effects", "Health", "AbsorptionAmount", "equipment", "foodLevel"]))
    // The bot, in survival mode at 12 health, 2 food and poisoned, stands at the eaten fixture's
    // spawn, on normal at noon, and eats and drinks what it carries, each to its end: an apple, a
    // honey bottle, which takes its poison off and leaves a bottle in its inventory, a potion of
    // swiftness, and milk, which takes it off again; it starts on another apple and lets go of it,
    // eats the bread in its off hand, then a golden apple and a suspicious stew, full, drinks a
    // potion of healing, and can't eat another apple (D519); it leaves at 540.
    out.insert(String("eaten"), fx(normal(), ["eaten"], "eaten", quiet_respawn(), some(session_data.eaten())).comparing(["active_effects", "Health", "AbsorptionAmount", "foodLevel", "foodSaturationLevel"]))
    // Splash potions thrown (D527): the bot, in survival mode at the splash fixture's spawn, on
    // normal at midnight, throws splash potions at Moo, the cow, and Rot, the zombie, both without
    // AI: poison at the cow, which poisons it and the bot; healing at the zombie, which hurts it;
    // regeneration at its own feet; water at nothing; and harming at the cow, which hurts it and
    // the bot; and it leaves at 420. Taped, as the throws' pitches are drawn from the level's
    // random, which holds what loading drew till it's seeded again (CAL-223).
    out.insert(String("splash"), fx(normal(), ["splash"], "splash", quiet_respawn(), some(session_data.splash())).comparing(["active_effects", "Health", "AbsorptionAmount"]).taped())
    // Lingering potions thrown (D529): the bot, as in `splash`, throws lingering potions, each of
    // which leaves a cloud where it lands that doses what's in it each second, shrinking as it
    // does: poison at Moo, the cow; healing at Rot, the zombie, which hurts him; regeneration and
    // then harming at its own feet; and slowness away to the north, whose cloud is still there as
    // it leaves at 480, saved with the chunks. Its levels' randoms are seeded again at 101, as
    // `splash`'s are, as each throw's sound draws its pitch from one (CAL-245).
    out.insert(String("linger"), fx(normal(), ["linger"], "splash", quiet_respawn(), some(session_data.linger())).comparing(["active_effects", "Health", "AbsorptionAmount"]).taped())
    // The bot, in creative mode with stone in its hand, stands at the beacons fixture's spawn, on
    // normal at noon, among beacons that pulse their effects onto it every 80 ticks (D520): speed,
    // jump boost but not its regeneration, two levels short, resistance through bedrock, strength
    // and regeneration, and haste II; at 300 it breaks a corner of the speed beacon's base, which
    // goes off, and at 400 puts stone on the glass over the jump boost beacon, which cuts its
    // beam; it leaves at 560.
    out.insert(String("beacons"), fx(normal(), ["beacons"], "beacons", quiet_respawn(), some(session_data.beacons())).comparing(["active_effects", "Health"]))
    // The bot, in survival mode with an iron ingot, a gold ingot and four emeralds, stands at the
    // beacons fixture's spawn, on normal at noon, and uses the beacon of jump boost, which opens
    // its menu: it pays with the iron ingot and picks speed, which the beacon gives from then on,
    // puts the gold ingot in and closes the menu, which drops it, then opens it again and
    // shift-clicks the emeralds, which don't go in, more than one (D521); it leaves at 480.
    out.insert(String("beacon_menu"), fx(normal(), ["beacon-menu"], "beacons", quiet_respawn(), some(session_data.beacon_menu())).comparing(["active_effects", "Inventory"]))
    // The bot, in survival mode with nothing, stands at the spawn, on normal at midnight, while an
    // arrow shot up falls back onto each of two endermen without AI (CAL-159): Ender dodges his,
    // unhurt, teleporting away, `repeatedlyTryToTeleport`, and it flies on; Flare's is on fire,
    // which sets him burning though he dodges it, so the fire's hurts teleport him.
    out.insert(String("ender-arrows"), fx(normal(), ["arrows"], "ender-arrows", quiet_respawn(), some(session_data.arrows())))
    // The bot, in survival mode with its hands empty, stands at the spawn, on normal at midnight,
    // while Bones, the skeleton ten blocks east with his AI and a bow, takes it up as his target,
    // draws, shoots it and strafes about it (CAL-159).
    out.insert(String("skeleton"), fx(normal(), ["skeleton"], "skeleton", quiet_respawn(), some(session_data.thorns())))
    // `skeleton`'s, on the skeleton-bow fixture's world, the bot in `zombie-sword`'s armor, with
    // protection IV, so it lives: Bones's bow has power III, punch II and flame, so his arrows burn
    // as they're shot, hit harder, knock the bot back and set it on fire (CAL-159). Not thorns,
    // whose chance is drawn from the level's random, as Bones shoots before the levels are seeded
    // again.
    out.insert(String("skeleton-bow"), fx(normal(), ["skeleton"], "skeleton-bow", quiet_respawn(), some(session_data.knight())))
    // The bot, in survival mode with its hands empty, stands on the spider fixture's pillar at the
    // spawn, on normal at midnight, while Webs, the spider eight blocks east with its AI, takes it
    // up, goes for it, climbs the pillar's side, which its path can't, and bites it (CAL-159).
    out.insert(String("spider"), fx(normal(), ["spider"], "spider", quiet_respawn(), some(session_data.spider())))
    // The bot, in survival mode with its hands empty, stands on the creeper fixture's pillar at
    // the spawn, on normal at midnight, while Boom, the creeper eight blocks east with its AI,
    // takes it up and comes to the pillar's foot, from where it's too far up for Boom to swell
    // (CAL-159).
    out.insert(String("creeper"), fx(normal(), ["creeper"], "creeper", quiet_respawn(), some(session_data.spider())))
    // The bot, in survival mode with its hands empty, stands on the enderman fixture's pillar at
    // the spawn, on normal at midnight, and turns to stare at Ender, the enderman two blocks east
    // with its AI, who takes it up, teleports away as it's stared at so near, and comes back for
    // it, angry (CAL-159). With mob griefing on, Ender's take and leave goals draw, and it takes
    // what it may hold and reach.
    out.insert(String("enderman"), fx(normal(), ["enderman"], "enderman", quiet_respawn(), some(session_data.spider())))
    // The bot, in survival mode with nothing, at the spawn on normal at midnight, by Ender, the
    // enderman with his AI two blocks east (CAL-159): it hits him once, so he takes it up, angry at
    // it, and hits it till it dies, and it leaves dead; with `forgive_dead_players` on, as it is by
    // default, he forgives it as it dies, `tellNeutralMobsThatIDied`, so he's saved angry at no
    // one; in `ender-grudge`, with it off, he's saved angry at it still.
    out.insert(String("ender-forgive"), fx(normal(), ["ender"], "ender-ground", quiet_respawn(), some(session_data.thorns())))
    var grudge = quiet_respawn()
    grudge.push(rule("minecraft:forgive_dead_players", Tag.Byte(0)))
    out.insert(String("ender-grudge"), fx(normal(), ["ender"], "ender-ground", grudge, some(session_data.thorns())))
    // The bot, on the `enderman` fixture's pillar, hits Ender below it once, with
    // `universal_anger` on (CAL-159): he doesn't take it up for its hit, `HurtByTargetGoal`, but
    // angry at all players, `ResetUniversalAngerTargetGoal`, his look for players does a few ticks
    // on, and he comes for it, too far up to hit.
    var anger = quiet_respawn()
    anger.push(rule("minecraft:universal_anger", Tag.Byte(1)))
    out.insert(String("ender-hit"), fx(normal(), ["ender"], "enderman", anger, some(session_data.spider())))
    // The bot, in creative mode with nothing, which no monster takes up, stands at the spawn, on
    // normal at noon, while Sunny, the skeleton out in the sun with his AI, burns and runs for the
    // shade under the stone roof by him, his paths kept out of the sun once he's in it (CAL-159).
    out.insert(String("skeleton-sun"), fx(normal(), ["skeleton"], "skeleton-sun", quiet_respawn(), some(session_data.place_creative())))
    // The bot, in survival mode in iron armor with its hands empty, stands at the spawn, on normal
    // at midnight, while Gloop, the slime of size 2 five blocks east with its AI, takes it up, hops
    // to it and hurts it as it touches it, wearing its armor (CAL-159).
    out.insert(String("slime"), fx(normal(), ["skeleton"], "slime", quiet_respawn(), some(session_data.slime())))
    // The bot, in creative mode with nothing, which no monster takes up, stands at the spawn, on
    // normal at midnight, while Rot, the zombie villager six blocks east with its AI, and Shamble,
    // the zombie six blocks south, stroll and look about and at it, Rot's random seeded before its
    // profession's drawn (CAL-194).
    out.insert(String("zombie-villager"), fx(normal(), ["skeleton"], "zombie-villager", quiet_respawn(), some(session_data.place_creative())))
    // `zombie-villager`'s, the bot in a zombie's head, which hides it from zombies to half as far
    // (CAL-159): Shamble, six blocks off, looks at it only within 4, so never, and Rot as before.
    out.insert(String("zombie-head"), fx(normal(), ["skeleton"], "zombie-villager", quiet_respawn(), some(session_data.zombie_head())))
    // The bot, in creative mode with nothing, which no monster takes up, stands at the spawn, on
    // normal at midnight, while Hex, the witch six blocks east with her AI, strolls and looks about
    // and at it, with no one to throw at and nothing to drink (CAL-159).
    out.insert(String("witch"), fx(normal(), ["skeleton"], "witch", quiet_respawn(), some(session_data.place_creative())))
    // `witch` with the bot in survival with nothing, which Hex takes up (D528): she comes within
    // ten blocks, stops where she sees it, and throws splash potions at it every three seconds,
    // poison first, then harming, each flying and splashing it; it leaves at 300.
    out.insert(String("witch-throw"), fx(normal(), ["skeleton"], "witch", quiet_respawn(), some(session_data.use_hands())).comparing(["active_effects", "Health", "AbsorptionAmount"]))
    // `thorns` with the bot holding an iron sword with unbreaking III: the hit whose thorns kill it
    // drops the sword, which the attack then wears, as vanilla's `postHurtEnemy` wears the stack
    // the drop holds, unbreaking drawing from the level's random (D450). Taped, as `thorns` is
    // (CAL-223).
    out.insert(String("thorns-sword"), fx(normal(), ["thorns"], "thorns", quiet_respawn(), some(session_data.thorns_sword())).taped())
    // The bot, in survival mode with a mace, falls onto the mace fixture's column and from it to
    // the ground by the server's clock, on normal, which keeps the zombie, smashing as it falls
    // (D443): a heavy smash on him from seven blocks, which pushes the cow and the stand by him; a
    // light one on the cow from two and five eighths, in the air; and a hit on him from the
    // ground, which isn't a smash.
    out.insert(String("mace"), fx(normal(), ["mace"], "mace", quiet(), some(session_data.mace())).comparing_keys(session_data.mace_keys()))
    // `mace`'s, with wind burst III on the mace (CAL-182): each smash bursts about the bot,
    // pushing it, the zombie, the cow and the stand away; the hit from the ground doesn't.
    out.insert(String("mace-wind"), fx(normal(), ["mace-wind"], "mace", quiet(), some(session_data.mace_wind())).comparing_keys(session_data.mace_keys()))
    // The bot, in survival mode, sprints on the swim fixture's grass by the server's clock, its
    // sprint's particles drawing from its random, which a loaf it drops shows; into the pool, where
    // it swims, stops sprinting and swims again; and out onto the grass beyond (D444).
    out.insert(String("swim"), fx([], ["swim"], "swim", quiet(), some(session_data.swim())).comparing_keys(session_data.hurt_keys()))
    // The bot, in survival mode at the frost fixture's spawn in boots with frost walker II, by the
    // server's clock from game time 200, walks east across its pool on what it freezes, three
    // blocks a second, onto the grass beyond, and stays as the frosted ice melts; it leaves at 900
    // (D524).
    out.insert(String("frost"), fx([], ["frost"], "frost", quiet(), some(session_data.frost())).comparing_keys(session_data.fall_keys()))
    // The bot, in survival mode on the soul fixture's soul sand in boots with soul speed III, by
    // the server's clock from game time 200, walks back and forth on it, three blocks a second, its
    // boots speeding it, wearing as it goes and giving off souls; it leaves at 760 (D525).
    out.insert(String("soul"), fx([], ["soul"], "soul", quiet(), some(session_data.soul())).comparing_keys(session_data.fall_keys()))
    // The bot, in survival mode by the checks fixture's wall, by the server's clock: a move too
    // quick, one through the wall and one into it, each of which the server sends it back from,
    // then a float it's kicked for (D420).
    out.insert(String("checks"), fx([], ["checks"], "checks", quiet(), some(session_data.checks())).comparing_keys(session_data.fall_keys()))
    // Armor stands by the spawn, which both servers load and tick (CAL-155): falling onto stone,
    // hay, honey and slime, sliding on ice, down a ladder and into water, and standing, small, a
    // marker, without gravity, posed and invisible; watched, as `redstone`.
    out.insert(String("stands"), fx([], ["watch"], "stands", no_spawning(), none))
    // Mooshrooms (CAL-156): with natural spawning on, creatures spawn every 400 ticks in the
    // mooshrooms fixture's mushroom fields, chunks -2 to 2, which a view of 2 has their entities
    // tick, as mooshrooms both servers make; and two without AI stand and moo; watched, and taped,
    // as their places are drawn from the levels' randoms, which line up once seeded again.
    out.insert(String("mooshrooms"), fx([], ["watch"], "mooshrooms", [], none).seen(2).taped())
    more_configs(mut out)
    return out
}

/// No natural spawning and no random ticks, which would change the world's blocks on a tick that
/// falls in another step on each server.
fn still() -> List<Rule> {
    return [rule("minecraft:spawn_mobs", Tag.Byte(0)), rule("minecraft:random_tick_speed", Tag.Int(0))]
}

/// `still`'s, and a respawn at the spawn itself.
fn still_respawn() -> List<Rule> {
    var out = still()
    out.push(rule("minecraft:respawn_radius", Tag.Int(0)))
    return out
}

/// A configuration watched at a view of 2 on fixture `name`'s world.
fn watched(props: List<(str, str)>, scenario: str, name: str, rules: own List<Rule>, player: own Tag?) -> Config {
    return fx(props, [scenario], name, rules, player).seen(2)
}

/// The End's dragon fight, as vanilla saves it.
fn fight(data: str) -> Tag {
    return session_data.snbt("\{data: \{{data}\}, DataVersion: 5023\}")
}

const FIGHT_FILE: str = "minecraft/the_end/ender_dragon_fight"

fn more_configs(out: mut LinkedMap<String, Config>) {
    // Armadillos with their brains (CAL-160): the bot, in survival mode with its hand empty,
    // stands at the armadillo fixture's spawn, penned with Dilly, by the server's clock from once
    // it's loaded, while she and Rolly idle, strolling, looking about and at it; at 200 it sprints,
    // which scares Dilly, who rolls up and peeks while it does, Rolly too far to see it; at 260 it
    // stops, and as the danger she saw runs out she unrolls; at 420 it hits her, which rolls her
    // up, and at 440 hits her again rolled up, which hurts her less; it leaves at 600.
    out.insert(String("armadillo"), fx([], ["armadillo"], "armadillo", quiet(), some(session_data.thorns())))
    // Brushing armadillos (CAL-160): as `armadillo`, but with a brush in the bot's main hand, which
    // it uses on Dilly four times, each brushing a scute off her, the fourth breaking it, then once
    // with its hand empty, which does nothing.
    out.insert(String("brush"), fx([], ["brush"], "armadillo", quiet(), some(session_data.brusher())))
    // Armadillos breeding (CAL-160): the bot standing as in `villagers` by Dilly and Rolly, in love
    // and penned together, who find each other and have a baby, `AnimalMakeLove`.
    out.insert(String("armadillo-love"), fx([], ["villagers"], "armadillo-love", quiet(), some(session_data.thorns())))
    // A spider without AI (D512): the bot, in survival mode holding a sword with bane of
    // arthropods I, stands at the bane fixture's spawn by Webs and hits it at 200 and 300, each hit
    // slowing it, slowness IV for a second and a half, its particles shown and its speed sent, and
    // leaves at 400.
    out.insert(String("bane"), fx(normal(), ["bane"], "bane", quiet_respawn(), some(session_data.bane())))
    // Villagers without AI (CAL-160): the bot, in survival mode with its hand empty and pumpkins in
    // its hotbar, stands at the villager fixture's spawn by Ada, grown with no profession, Bo, a
    // baby, and Fen, a desert farmer; it uses Ada, who has no trades, and Bo, which makes each
    // unhappy, then hits Fen and Ada, each of whom then gossips of it; then it trades its pumpkins
    // with Fen for emeralds, and leaves at 600.
    out.insert(String("villager"), fx([], ["villager"], "villager", quiet(), some(session_data.trader())))
    // Enchanted trades (D522): the bot, in survival mode with its hand empty, stands at the
    // enchanted fixture's spawn among eight villagers without AI and with no offers, librarians, a
    // weaponsmith, a fletcher, a fisherman and a toolsmith, and uses each in turn, its offers made
    // from its level's trade set as it does, enchanted books, weapons and tools among them with the
    // cost their enchanting adds, and closes each one's trades; it leaves at 460.
    out.insert(String("enchanted"), fx([], ["traders"], "enchanted", quiet(), some(session_data.enchanted_villagers())))
    // Dyed trades (D523): as `enchanted`, on the dyed fixture's world, among leatherworkers at the
    // first five levels, a farmer at the fourth and two fletchers at the fifth, whose offers are
    // made as the bot uses them, leather armor dyed at random, suspicious stew of a random effect
    // and tipped arrows of a random potion among them.
    out.insert(String("dyed"), fx([], ["traders"], "dyed", quiet(), some(session_data.enchanted_villagers())))
    // Villagers with their brains (CAL-160): the bot, in survival mode with its hand empty, stands
    // at the villagers fixture's spawn by the server's clock from once it's loaded, in the morning,
    // while Ada, grown with no profession, five blocks east by a bed, and Bo, a baby, farther by
    // another, idle: strolling, looking about and at it, claiming the beds, Bo jumping on his, and
    // Ada showing it her trades and trading with Bo; it leaves at 600.
    out.insert(String("villagers"), fx([], ["villagers"], "villagers", quiet(), some(session_data.thorns())))
    // A zombie going through a village at night (D605): as `villagers`, on normal, on the
    // village-zombie fixture's world, where Rot, a zombie, finds the bed Vi claims in her box above
    // the grass, a village's point of interest that's taken, `MoveThroughVillageGoal`, and walks
    // toward it as near as he gets, under her box, then not again, as he's been; the bot, in
    // creative mode with nothing, isn't his target.
    out.insert(String("village-zombie"), fx(normal(), ["villagers"], "village-zombie", quiet(), some(session_data.place_creative())))
    // Professions (CAL-160): as `villagers`, on the professions fixture's world, where Di, a
    // farmer with no job site, loses her profession and takes a fletching table; Fa, holding Ed's
    // composter with less experience, forgets it and loses her profession, takes it and loses it
    // again, then takes the composter by Cy as a farmer for good; and Cy is left with none.
    out.insert(String("professions"), fx([], ["villagers"], "professions", quiet(), some(session_data.thorns())))
    // Doors (CAL-160): as `villagers`, on the doors fixture's world, where Cy and Di, shut in a
    // hut, walk out through its door to the job sites outside, opening it and shutting it behind
    // them.
    out.insert(String("doors"), fx([], ["villagers"], "doors", quiet(), some(session_data.thorns())))
    // Work (CAL-160): as `villagers`, on the work fixture's world, where Gi, a librarian, works at
    // her lectern and restocks her used offer; Ha, a cleric, works at his brewing stand on a new
    // day, his offers made then, their demand caught up; Fa, a farmer, works at her composter, too
    // soon for another restock; and Ib, a mason, walks back to his stonecutter.
    out.insert(String("work"), fx([], ["villagers"], "work", quiet(), some(session_data.thorns())))
    // Pickup (CAL-160): as `villagers`, on the pickup fixture's world, where Jo, a farmer, sees
    // wheat seeds and bread near her, walks to them and picks them up, but not a diamond she
    // doesn't want, nor bone meal too far to walk to; and Ko, a nitwit with a full inventory,
    // leaves carrots he has no room for, which Jo picks up as she strolls by.
    out.insert(String("pickup"), fx([], ["villagers"], "pickup", quiet(), some(session_data.thorns())))
    // Harvest (CAL-160): as `villagers`, on the harvest fixture's world, where Hal, a farmer,
    // breaks ripe crops, plants seeds on bare farmland and grows young wheat with bone meal, and
    // Cy, a cleric, grows beetroots with hers.
    out.insert(String("harvest"), fx([], ["villagers"], "harvest", quiet(), some(session_data.thorns())))
    // Compost (CAL-160): as `villagers`, on the compost fixture's world, where the bot takes a full
    // composter's bone meal at 450, and Hal, a farmer, bakes bread of his wheat, which he has no
    // room for and drops, takes his full composter's bone meal and composts his seeds.
    out.insert(String("compost"), fx([], ["compost"], "compost", quiet(), some(session_data.thorns())))
    // Throws (CAL-160): as `villagers`, on the throws fixture's world, where Ada, a nitwit, and
    // Bo, a farmer, trade and throw each other what they have too much of.
    out.insert(String("throws"), fx([], ["villagers"], "throws", quiet(), some(session_data.thorns())))
    // Sleep (CAL-160): as `villagers`, on the sleep fixture's world, where Ada lies down in her
    // bed, Bo walks to his and lies down, Cy, saved asleep, is put on his as he's loaded, and all
    // get up as the day comes; and `asleep`, the same but left while they sleep, so they're saved
    // asleep.
    out.insert(String("sleep"), fx([], ["villagers"], "sleep", quiet(), some(session_data.thorns())))
    out.insert(String("asleep"), fx([], ["asleep"], "sleep", quiet(), some(session_data.thorns())))
    // Breed (CAL-160): as `villagers` but till 1000, on the breed fixture's world, where Ada and
    // Bo, grown, each with bread, claim beds and have a baby, who takes the third.
    out.insert(String("breed"), fx([], ["breed"], "breed", quiet(), some(session_data.thorns())))
    // Hearsay (CAL-160): as `villagers` but till 1500, on the hearsay fixture's world, where Ada
    // and Bo, grown and penned together, talk, and once the game time's 1200 one passes on or hears
    // what Ada's heard of two others.
    out.insert(String("hearsay"), fx([], ["hearsay"], "hearsay", quiet(), some(session_data.thorns())))
    // Bell (CAL-160): as `villagers` but till 700, on the bell fixture's world, where the bot
    // rings the bell by it at 200 and Ada and Bo, grown and penned with two beds, hear it and hide
    // by a bed for 300 ticks.
    out.insert(String("bell"), fx([], ["bell"], "bell", quiet(), some(session_data.thorns())))
    // Shows (CAL-160): as `villagers`, on the shows fixture's world, where the bot holds emeralds
    // and Fen and Gil, farmers penned with it, hold up what the emeralds buy of their trades, Gil's
    // offers made as he first looks.
    out.insert(String("shows"), fx([], ["villagers"], "shows", quiet(), some(session_data.shows())))
    // Tag (CAL-160): as `villagers`, on the tag fixture's world, where Ada and Bo, babies, play
    // tag in the morning by the bell Cy claims.
    out.insert(String("tag"), fx([], ["villagers"], "tag", quiet(), some(session_data.thorns())))
    // Homeless (CAL-160): as `villagers`, on the homeless fixture's world, where Ada, Bo and Cy,
    // with no homes at night, walk to a bed, step about under a roof and head for a village.
    out.insert(String("homeless"), fx([], ["villagers"], "homeless", quiet(), some(session_data.thorns())))
    // Meet (CAL-160): as `villagers`, on the meet fixture's world, where Ada, Bo and Cy meet at
    // their bell, strolling around it and walking to each other to talk.
    out.insert(String("meet"), fx([], ["villagers"], "meet", quiet(), some(session_data.thorns())))
    // Crops (CAL-160): as `villagers`, on the crops fixture's world, with random ticks at 16 a
    // section, where wheat, carrots, potatoes, beetroots and torchflower crops grow, farmland by
    // water wets and farmland away from it dries, back to dirt where nothing's on it; and items,
    // an orb, a chicken and a cow land on farmland, each drawing as it lands.
    var crops_rules = quiet()
    crops_rules.push(rule("minecraft:random_tick_speed", Tag.Int(16)))
    out.insert(String("crops"), fx([], ["villagers"], "crops", crops_rules, some(session_data.thorns())))
    // The farm animals (CAL-156): as `mooshrooms`, in the farm fixture's birch forest and badlands
    // on grass, sheep, pigs, chickens and cows of their biomes' variants; and five without AI, two
    // chickens laying their eggs.
    out.insert(String("farm"), watched([], "watch", "farm", [], none).taped())
    // Plains (CAL-156): as `farm`, on the plains fixture's grass, where horses and donkeys spawn
    // with the farm animals; and three without AI that graze.
    out.insert(String("plains"), fx([], ["watch"], "plains", [], none).taped())
    // Monsters (CAL-156): as `farm`, from dusk on the night fixture's plains, on normal, where
    // monsters spawn every tick, zombie horses among them, finalized by the difficulty where each
    // stands; the bot in creative, which they don't make for; and four without AI, a zombie, a
    // skeleton with its bow, a creeper and a spider. With mob griefing, so an enderman takes
    // blocks of the grass and leaves them, and one carrying a block stays, off the monsters' cap
    // (CAL-159).
    out.insert(String("night"), watched(normal(), "watch", "night", [], some(session_data.night())).taped())
    // Monsters on hard (D522): as `night`, on the night-hard fixture's, sixty days on and on hard,
    // so the monsters that spawn wear armor more and are enchanted from `mob_spawn_equipment`.
    out.insert(String("night_hard"), watched([("difficulty", "hard")], "watch", "night-hard", [], some(session_data.night())).taped())
    // A cow without AI sealed in a stone tank of water, its air nearly gone, which drowns, hurt in
    // its own tick till it dies, and its loot (D424); watched, as `stands`.
    out.insert(String("drown"), watched([], "watch", "drown", no_spawning(), none))
    // Two such cows, one saved with a death loot seed of its own and one with a chicken's death
    // loot table and a seed, each rolling its loot from a random of its seed as it drowns (D429).
    out.insert(String("seeded"), watched([], "watch", "seeded", no_spawning(), none))
    // A slime of size 2 without AI suffocating in stone, which splits as it's taken out dying into
    // 2 to 4 of size 1 with what it was made of, which suffocate in turn (D430).
    out.insert(String("split"), watched([("difficulty", "easy")], "watch", "split", still(), none))
    // The bot burning on magma in armor, which each burn wears but for the netherite chestplate,
    // its boots breaking at the third, on hard (D431). It watches late, `watch-late`, so its burns
    // start at the same game time on both servers, after its levels' randoms are seeded again,
    // taped, and the draws for its armor's unbreaking fall among the chunks' shuffles each tick as
    // they do.
    out.insert(String("magma"), watched(hard(), "watch-late", "magma", still(), some(session_data.magma())).comparing_keys(session_data.buried_keys()).taped())
    // `magma` in frost walker boots, immune to the burn, and in fire protection boots, which take
    // their share of each (D439).
    out.insert(String("magma-frost"), watched(hard(), "watch-late", "magma", still(), some(session_data.magma_frost())).comparing_keys(session_data.buried_keys()).taped())
    out.insert(String("magma-fireproof"), watched(hard(), "watch-late", "magma", still(), some(session_data.magma_fireproof())).comparing_keys(session_data.buried_keys()).taped())
    // Penned by the spawn, a cow burning on magma till it dies, a pig lighting redstone ore, the
    // ore's particles drawn from the level's random, and a sheep slowed by slime blocks (D431),
    // taped; without random ticks, which would put the ore out.
    out.insert(String("stepped"), watched([], "watch", "stepped", still(), some(session_data.use_hands())).taped())
    // Penned by the spawn, a cow in soul fire, a pig in lava, a chicken on a lit campfire, and a
    // sheep already alight that panics to water, which puts it out (D434), their drops burnt away
    // (D435) and cooked (D436), taped; without random ticks, which would have the lava light what's
    // by it.
    out.insert(String("burning"), watched([], "watch", "burning", still(), some(session_data.use_hands())).taped())
    // Zombies without AI at noon, on normal, which keeps them: one lit by the sun, one whose
    // leather helmet's worn instead, one whose helmet breaks, one in water and one under stone,
    // which don't burn (D437); taped, without natural spawning.
    out.insert(String("daylight"), watched(normal(), "watch", "daylight", no_spawning(), none).taped())
    // Four cows without AI with their eyes in stone, glass and farmland, inside its shape and above
    // it, the stone and the farmland's inside suffocating theirs till they die (D425); watched, as
    // `stands`, without random ticks, which would turn the farmland to dirt.
    out.insert(String("walls"), watched([], "watch", "walls", still(), none))
    // The bot at the bottom of water out of air, drowning, and starving, on hard, which starves to
    // the end (D426); watched, without natural spawning.
    out.insert(String("choke"), watched(hard(), "watch", "choke", no_spawning(), some(session_data.choke())).comparing_keys(session_data.hurt_keys()))
    // The bot with its eyes in stone, hurt in a wall and healing from its food, on hard, whose
    // healing goes from its first hurt, not from when its client loaded, as peaceful's would
    // (D426); watched, without natural spawning or random ticks, whose places part as vanilla's
    // chunks come in later (D315) and would turn the grass under the stone to dirt on one server
    // only.
    out.insert(String("buried"), watched(hard(), "watch", "buried", still(), some(session_data.buried())).comparing_keys(session_data.buried_keys()))
    // The same bot dying in the wall, its death told, what it carries and its experience dropped
    // around it, but what's cursed with vanishing, and taken out of its level 20 ticks after
    // (D427); then respawning, as it asks once it's out, on top of the stone at the spawn, where a
    // respawn radius of 0 has both servers' search look, the chunks around forced, so what it
    // dropped is loaded all along (D428).
    out.insert(String("death"), watched(hard(), "watch", "death", still_respawn(), some(session_data.death())).comparing_keys(session_data.death_keys()))
    // The same on peaceful, watching late, so its hurts start at the same game time on both
    // servers: peaceful heals it and fills its saturation every 20 of the player's own ticks, which
    // its respawn counts from 0 again, `Entity.tickCount`, apart from its connection's (D433).
    out.insert(String("death_peaceful"), watched([("difficulty", "peaceful")], "watch-late", "death", still_respawn(), some(session_data.death())).comparing_keys(session_data.death_keys()))
    // `duel` with the bot and Mate in one team, which allows no friendly fire and no collisions
    // (CAL-164): no hit hurts Mate, the sheep's sweep passes it by, and the step into it pushes
    // neither.
    let duel = out[String("duel")].copy()
    var teammates = duel.copy()
    teammates.saved = [(String("scoreboard"), session_data.teammates())]
    out.insert(String("teammates"), teammates)
    // `duel` with the bot in red and Mate in blue (CAL-164): Mate's death counts for each criteria
    // of kills and deaths, its message seen by no one else, and the step into it pushes both, as
    // red's players push only each other but the other team's may push them.
    var rivals = duel.copy()
    rivals.saved = [(String("scoreboard"), session_data.rivals())]
    out.insert(String("rivals"), rivals)
    // The bot on the duel fixture's world with Mate, in one team, typing the commands every
    // player may use (CAL-165): `list`, `help`, `me`, `msg`, `tell`, `teammsg`, `trigger` and
    // `random`, with their failures, and two it may not.
    var talk = duel.copy().running(["talk"])
    talk.saved = [(String("scoreboard"), session_data.talk())]
    out.insert(String("talk"), talk.copy())
    // `talk` with the bot an operator, which types selectors with options in `say`, `gamemode` and
    // `msg` (CAL-165), and runs the functions of the functions pack (D567). Taped, as weather's
    // lengths, blocks' drops and summoned mobs are drawn from the levels' randoms, which line up
    // only once seeded again (D316). Where the bot respawns, which its bed sets, and its sleep's
    // ticks are compared too (D574), and its portal's cooldown and where it went into the Nether
    // (D577), and the ender pearl still flying as it leaves, saved with it (D580).
    var select = talk.copy().running(["select"]).with_ops(["Bot"]).taped().comparing(["respawn", "SleepTimer", "PortalCooldown", "entered_nether_pos", "ender_pearls"])
    select.datapacks = [(String("funcs"), session_data.funcs_pack())]
    out.insert(String("select"), select)
    // `talk` with the bot an operator, making and changing boss bars with `bossbar`, with Mate
    // there, on a world whose saved boss bars are `saved_bars` (D606). Taped, as a bar's UUID is
    // drawn from the level's random, as `bossbar add` makes it.
    var bossbars = talk.copy().running(["bossbars"]).with_ops(["Bot"]).taped()
    bossbars.saved = [(String("scoreboard"), session_data.talk()), (String("custom_boss_events"), session_data.saved_bars())]
    out.insert(String("bossbars"), bossbars)
    // `night`, where monsters spawn, with the bot an operator, in creative mode, throwing thirty
    // ender pearls straight down, some of which make endermites where it stands (D583), which then
    // go about.
    let mites = out[String("night")].copy().running(["mites"]).with_ops(["Bot"])
    out.insert(String("mites"), mites)
    end_configs(mut out)
}

fn hard() -> List<(str, str)> {
    return [("difficulty", "hard")]
}

fn end_configs(out: mut LinkedMap<String, Config>) {
    // The bot, an operator, through end portals on the end fixture's world, the End's dragon fight
    // over, with no mobs spawning (D586): into the End, out of it to the credits the first time,
    // after which it respawns keeping all it has, and to where its spawn's set the second. Four
    // chunks about it, so the crystal on the spike at 42, 0 is in its sight, those on the two
    // others in chunks at x = 2 too far off (D589). Taped, as the platform's drops are drawn from
    // the End's random; where it's seen the credits is compared, and where its spawn's set, its
    // health, food and effects.
    var end = fx(normal(), ["end"], "end", quiet_respawn(), some(session_data.end_player())).seen(4).with_ops(["Bot"]).taped().comparing(["seenCredits", "respawn", "Health", "foodLevel", "active_effects"])
    // The End's dragon fight over, as vanilla saves it once its dragon's killed: its state known,
    // so its arena isn't scanned, its dragon killed, as it has been before (D586).
    end.dim_saved = [(String(FIGHT_FILE), fight("needs_state_scanning: 0b, dragon_killed: 1b, previously_killed: 1b"))]
    out.insert(String("end"), end.copy())
    // `end` with the fight not over (D624): its state known, its dragon, killed before, not
    // killed, of a UUID no dragon has, so its boss bar's shown to the players about its arena, and
    // it looks for its dragon again only once its arena's been loaded for 1200 ticks, more than a
    // session is there; its boss bar shown to the bot as it comes onto the platform and taken from
    // it once it's gone, each time.
    var bar = end.copy()
    bar.dim_saved = [(String(FIGHT_FILE), fight("needs_state_scanning: 0b, dragon_killed: 0b, previously_killed: 1b, dragon_uuid: [I; 1, 2, 3, 4]"))]
    out.insert(String("fight-bar"), bar)
    // `end`'s world with the End's dragon fight new (D625): the bot forces the End's chunks about
    // the arena, then goes in, and the fight scans its arena, finds no exit portal and makes it,
    // inactive, in the End's chunks about 0, 0, which are compared as saved.
    var new_fight = end.copy().running(["fight"])
    new_fight.dim_saved = []
    new_fight.end_chunks = [(-1i64, -1i64, 0i64, 0i64)]
    out.insert(String("fight"), new_fight)
    // The End's dragon fight new but for its dragon (D627): of a UUID no dragon has, none killed in
    // it before, and two gateways left, the last the second, at 91, 75, 29, by the platform. Once
    // its arena's scanned and the exit portal made, the bot summons its dragon dead above the
    // podium, and the fight hears it's killed once it's died; the podium's chunks, the two east of
    // them its light reaches the edge of, and the gateway's are compared as saved.
    var kill = end.copy().running(["fight-kill"])
    kill.dim_saved = [(String(FIGHT_FILE), fight("dragon_killed: 0b, previously_killed: 0b, dragon_uuid: [I; 1, 2, 3, 4], gateways: [I; 5, 1]"))]
    kill.end_chunks = [(-1i64, -1i64, 0i64, 0i64), (5i64, 1i64, 5i64, 1i64), (1i64, -1i64, 1i64, 0i64)]
    out.insert(String("fight-kill"), kill)
    // `end`'s world with the bot hitting an end crystal it summons in water in the Overworld
    // (D590): in survival mode, invulnerable, which the hit doesn't hurt; then in creative mode
    // with an iron sword, which breaks it, sweeping, and it explodes (D658); the water keeps the
    // blocks about it, and creative mode the bot. Then an arrow and an ender pearl falling onto
    // another each, which they break, and a splash potion onto another (D591); then a crystal on
    // the grass an arrow breaks, whose explosion breaks the ground about it (D658).
    out.insert(String("crystals"), end.copy().running(["crystals"]))
    // `end`'s world with the bot setting TNT east of its spawn and priming it with a redstone
    // block, which explodes 80 ticks on; two TNT, the second primed by the first's explosion on a
    // short fuse; TNT summoned with a fuse of 30; and TNT a burning arrow primes (D659).
    out.insert(String("tnt"), end.copy().running(["tnt"]))
    // `end`'s world with the bot in creative mode charging a respawn anchor and using it, which
    // explodes it; then using a charged one beside water, whose explosion breaks nothing (D660).
    out.insert(String("blasts"), end.copy().running(["blasts"]))
    // `end`'s world with an end gateway the bot sets by its spawn, 2380 ticks old, its age read as
    // it ticks, and its cooldown begun at 2400, its block event sent (D592); then the bot through
    // one, its exit exact, again, its exit found above the tallest block about it, and through one
    // with another on it, whose block event is sent twice (D593); then an item, a pig and an arrow
    // through one (D594); then, in the End, an item and the bot through gateways with no exit,
    // which make one (D595).
    out.insert(String("gateways"), end.copy().running(["gateways"]))
    // `end`'s world with the bot filling the last frame of an end portal's ring it sets, which
    // opens the portal, and again once it's set that frame without its eye (D596); then using an
    // eye in the air, looking at the frame and up, which starts its use, as the world has no
    // structures (D597); then summoning eyes of ender, which fly on till their life runs out
    // (D598).
    out.insert(String("eyes"), end.copy().running(["eyes"]))
    // `end`'s world with the bot using compasses on a lodestone it sets, which track it, and
    // lodestone compasses in its inventory losing their targets as they tick, where the
    // lodestone's broken, out of the world and far off, or keeping them, in another dimension or
    // not tracking (D603).
    out.insert(String("compass"), end.copy().running(["compass"]))
    // `end`'s world with the bot hitting ender dragons it summons without AI (D608): one hovering,
    // which takes off and then would die, left dying; one in its holding pattern, which an end
    // crystal heals; and one with 1 health, which dies as it sits, rising for 200 ticks, its
    // experience given.
    out.insert(String("dragon"), end.copy().running(["dragon"]))
    // `end`'s world with mob griefing off, the bot in creative watching an ender dragon with AI fly
    // its holding pattern, land and take off again (D613).
    var no_griefing = end.rules.copy()
    no_griefing.push(rule("minecraft:mob_griefing", Tag.Byte(0)))
    var flight = end.copy().running(["dragon-flight"])
    flight.rules = no_griefing.copy()
    out.insert(String("dragon-flight"), flight)
    // `dragon-flight`'s scenario with mob griefing on: the dragon breaks the ground it lands on
    // (D614).
    out.insert(String("dragon-griefing"), end.copy().running(["dragon-flight"]))
    // `end`'s world with mob griefing off, the bot in survival with resistance IV for ever on a
    // pillar an ender dragon with AI lands by and then charges, its wings and head striking it
    // (D615).
    var charge = end.copy().running(["dragon-charge"])
    charge.rules = no_griefing
    let resistant = session_data.effect("resistance", -1, 3, [("ambient", false), ("show_particles", false), ("show_icon", false)])
    let charged = session_data.with(session_data.end_player(), "\{active_effects: [{resistant}]\}")
    charge.player = some(charged.copy())
    out.insert(String("dragon-charge"), charge.copy())
    // `end`'s world with mob griefing off, the bot in survival with resistance IV for ever and full
    // health on the ground by the egg's place, where an ender dragon with AI lands, sees it, roars
    // and breathes at it twice, its breath's clouds hurting it (D617).
    let breathed = session_data.with(charged, String("\{Health: 20.0f\}"))
    var breath = charge.copy().running(["dragon-breath"])
    breath.player = some(breathed.copy())
    out.insert(String("dragon-breath"), breath.copy())
    // `dragon-breath`'s world and bot, at the spawn, summoning dragon fireballs that fall onto the
    // ground, fly at an armor stand and at it, each leaving its cloud of dragon's breath, and one
    // that stays still (D618).
    out.insert(String("dragon-fireball"), breath.copy().running(["dragon-fireball"]))
    // `dragon-breath`'s world and bot, but with 1000 health, as the clouds of the fireballs it's
    // shot at last 600 ticks where it stands, at the spawn by the egg's place, where an ender
    // dragon with AI in its holding pattern strafes it, shooting fireballs at it (D619).
    let strafed = session_data.with(breathed, String(#"{Health: 1000.0f, attributes: [{id: "minecraft:max_health", base: 1000.0d}]}"#))
    var strafe = breath.copy().running(["dragon-strafe"])
    strafe.player = some(strafed.copy())
    out.insert(String("dragon-strafe"), strafe.copy())
    // `dragon-strafe`'s world and bot, but 20 east of the spawn, where it hits an ender dragon with
    // 1 health it summons landing over it, which then dies on its way to the egg's place (D620).
    var death = strafe.copy().running(["dragon-death"])
    death.player = some(session_data.with(strafed, String("\{Pos: [20.5d, -60.0d, 0.5d]\}")))
    out.insert(String("dragon-death"), death)
    // `end`'s world with the bot, an operator, forcing chunks and letting them go with
    // `forceload`, asking which are, and forcing one in the Nether, which keeps the Nether ticking
    // (D622).
    out.insert(String("forceload"), end.copy().running(["forceload"]))
    // The plain world, which generates structures, as `terrain` has it, without its entities and
    // with no mobs spawning, its spawn at the origin, with the bot, an operator, throwing eyes of
    // ender there (D599): each finds the nearest stronghold, `findNearestMapStructure` over the
    // rings, and flies toward it till its life runs out, dropped as an item where it survives; the
    // last in survival leaves its hand empty, still in use till it lets go; then one in creative
    // mode. The plain world, not the round trip's, as its sand falls as an entity, which Calcite's
    // doesn't yet, and every entity after has another ID. Taped, as each launch's pitch is drawn
    // from the level's random.
    var throws = out[String("terrain")].copy().running(["throws"]).with_ops(["Bot"]).taped()
    throws.world = some(String(PLAIN_WORLD))
    out.insert(String("eye-throws"), throws.copy())
    // The plain world, with the bot, an operator, at its spawn, having `locate structure` find
    // structures of each kind of placement, far and near, one the Overworld doesn't place and two
    // there are none of (D600): Calcite's search finds the nearest anywhere, vanilla's the nearest
    // of the first square of sectors with any, out to 100.
    var locate = throws.running(["locate"])
    locate.tape = false
    out.insert(String("locate"), locate)
}
