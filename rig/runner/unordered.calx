module rig.runner.unordered

// Results compared without the order of their compounds' entries (PROTOCOL.md, "Case files").
//
// Some registries' contents come from maps vanilla makes with `Map.copyOf` over keys hashed by
// identity, such as a timeline's tracks or a dimension type's and a biome's attributes, so the
// order their entries go into a compound, and so the order a `HashMap` gives those that share a
// bucket, changes from one run of vanilla to the next. A case that says `"unordered": true` has
// each compound in its blobs sorted by key before it's hashed, for vanilla and Calcite alike.

import std.bytes

struct Reader {
    data: List<u8>
    at: usize
}

fn take(r: mut Reader, n: usize) -> List<u8> ! String {
    if r.at + n > r.data.len() {
        fail "the blob ends at {r.data.len()}, inside a value at {r.at}"
    }
    let v = r.data[r.at..r.at + n]
    r.at += n
    return v
}

fn u8_of(r: mut Reader) -> u8 ! String {
    let b = try take(mut r, 1)
    return b[0]
}

fn i32_of(r: mut Reader) -> i32 ! String {
    let b = try take(mut r, 4)
    return bytes.i32_be(b, 0)
}

fn u16_of(r: mut Reader) -> u16 ! String {
    let b = try take(mut r, 2)
    return bytes.u16_be(b, 0)
}

/// The size of a tag of fixed size: byte, short, int, long, float and double; 0 for the others.
fn fixed(kind: u8) -> usize {
    return match kind {
        1 => 1,
        2 => 2,
        3 => 4,
        4 => 8,
        5 => 4,
        6 => 8,
        _ => 0,
    }
}

/// The element size of an array: bytes, ints and longs; 0 for the others.
fn element(kind: u8) -> usize {
    return match kind {
        7 => 1,
        11 => 4,
        12 => 8,
        _ => 0,
    }
}

/// The payload of a tag of type `kind`, with each compound in it sorted by key.
fn payload(r: mut Reader, kind: u8) -> List<u8> ! String {
    if fixed(kind) > 0 {
        return try take(mut r, fixed(kind))
    }
    if element(kind) > 0 {
        let n = try i32_of(mut r)
        var out = List<u8>()
        bytes.put_i32_be(mut out, n)
        let count = if n > 0 { usize.wrap(n) } else { 0 }
        out.extend(try take(mut r, count * element(kind)))
        return out
    }
    if kind == 8 {
        let n = try u16_of(mut r)
        var out = List<u8>()
        bytes.put_u16_be(mut out, n)
        out.extend(try take(mut r, usize(n)))
        return out
    }
    if kind == 9 {
        let inner = try u8_of(mut r)
        let n = try i32_of(mut r)
        var out: List<u8> = [inner]
        bytes.put_i32_be(mut out, n)
        if n > 0 {
            for _ in 0..n {
                out.extend(try payload(mut r, inner))
            }
        }
        return out
    }
    if kind == 10 {
        var entries: List<(List<u8>, List<u8>)> = []
        loop {
            let t = try u8_of(mut r)
            if t == 0 {
                break
            }
            let n = try u16_of(mut r)
            let name = try take(mut r, usize(n))
            var whole: List<u8> = [t]
            bytes.put_u16_be(mut whole, n)
            whole.extend(name)
            whole.extend(try payload(mut r, t))
            entries.push((name, whole))
        }
        entries.sort_by(|a, b| a.0.cmp(b.0))
        var out = List<u8>()
        for (_, whole) in entries {
            out.extend(whole)
        }
        out.push(0)
        return out
    }
    if kind == 0 {
        return []
    }
    fail "tag type {kind} at {r.at}"
}

/// A `registries` contents blob with every compound in each entry's contents sorted by key: an
/// `int` count, then each entry's ID as an `int` length and its UTF-8, its tag's type and its
/// payload.
pub fn sorted_contents(blob: List<u8>) -> List<u8> ! String {
    var r = Reader { data: blob.copy(), at: 0 }
    let count = try i32_of(mut r)
    var out = List<u8>()
    bytes.put_i32_be(mut out, count)
    if count > 0 {
        for _ in 0..count {
            let n = try i32_of(mut r)
            bytes.put_i32_be(mut out, n)
            out.extend(try take(mut r, if n > 0 { usize.wrap(n) } else { 0 }))
            let kind = try u8_of(mut r)
            out.push(kind)
            out.extend(try payload(mut r, kind))
        }
    }
    if r.at != blob.len() {
        fail "{blob.len() - r.at} bytes after the last entry"
    }
    return out
}
