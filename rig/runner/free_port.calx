module rig.runner.free_port

// Prints a port on 127.0.0.1 that nothing listens on, the one the system picks for port 0, as
// sessions.py's `free_port` bound one and let it go (CAL-253). It's a program of its own because
// a Net in std.net can't stop listening (CLX-354), so the port is free only once this one ends.
// The system picks only ports it lets a program take, past Windows' excluded ranges.
//
//     calx rig/runner/free_port.calx

import std.net.{Net}

fn main() {
    let net = Net.new()!
    let port = net.listen("127.0.0.1", 0)!
    println("{port}")
}
