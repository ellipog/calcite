module rig.runner.roundtrip

// The round trip through vanilla (G5.2, CAL-61): a world vanilla 26.3 made and saved, loaded and
// saved again by Calcite, then read by vanilla, which must find the same world.
//
//     calx rig/runner/roundtrip.calx [--reuse]
//
// It runs in build/rig/roundtrip/, with Mojang's EULA accepted in its scratch folders only:
//
// 1. `vanilla/`: vanilla's server makes a world from a fixed seed, with chunks loaded in all three
//    dimensions, and the rig's protocol bot joins it, so it has a player's data, advancements and
//    statistics. With its ticks frozen, so they're saved as they're set, the console then puts in
//    block entities, points of interest, entities, scheduled ticks, scoreboards, command storage,
//    a random sequence, a boss bar, the world border, the weather and the time. Then it's saved
//    and stopped.
// 2. `calcite/`: a copy, which src/rig/resave.calx loads and saves again, every file Calcite
//    keeps, with Calcite's readers and writers. A line it logs is a difference.
// 3. The vanilla adapter's WorldCheck reads both with vanilla's own readers and compares them file
//    by file and chunk by chunk: anything not the same, or that vanilla logs reading Calcite's
//    save, is a difference.
// 4. `back/` and `again/`: vanilla's server opens a copy of Calcite's save, and one of its own,
//    answers the same questions from its console about each, what's in the chests and the sign,
//    the portal, the bed, the scores, the storage, the border, the forced chunks, the teams, the
//    boss bar and the entities, then saves and stops. An answer that isn't the same for both, or
//    a warning or error it logs opening Calcite's that it doesn't log opening its own, is a
//    difference.
//
// It exits with 1 if there's a difference. --reuse skips step 1 and uses the last run's world.
//
// `make_plain` has vanilla make the plain world in `plain/`: from the same seed, with the same
// chunks loaded and saved, and nothing put in it, no player's data and nothing the console sets,
// which the `throws` session loads, as the sand and water step 1 puts in fall and flow at its
// start, where Calcite's sand doesn't fall yet (D599). rig/runner/sessions.calx has it made the
// first time that session runs. It was roundtrip.py (CAL-253).

import std.cli.{cli}
import std.fs.{copy_dir_all, exists, is_dir, make_dir_all, remove_dir_all}
import std.json.{Json}
import std.path
import std.process.{Command, exit}
import std.regex.{Regex}
import std.text.python.{repr_str}
import std.time.{Instant}
import rig.runner.servers.{BOT, Server, adapter, adapter_argv, adapter_cwd, build, free_port, players_json, properties, put, vanilla_argv}
import tools.pyjson.{indented_ascii}
import tools.repo.{die, native, root, under}

const VIEW: i64 = 4

/// The areas loaded in each dimension, from block to block, which vanilla generates and keeps.
const FORCED: [(str, i64, i64, i64, i64); 3] = [
    ("minecraft:overworld", -64, -64, 63, 63),
    ("minecraft:the_nether", -32, -32, 31, 31),
    ("minecraft:the_end", -32, -32, 31, 31),
]

const BOOK: str = #"{Slot:5b,id:"minecraft:written_book",count:1,components:{"minecraft:written_book_content":{title:"Calcite",author:"rig",pages:["one","two"]}}}"#

/// Typed once the ticks are frozen, each with what vanilla answers. Everything is in the air,
/// above y 190, where no terrain is, in the loaded chunks.
fn content() -> List<(String, String)> {
    let chest = #"setblock 0 200 0 minecraft:chest{Items:[{Slot:0b,id:"minecraft:diamond",count:3},#{BOOK}]}"#
    var out: List<(String, String)> = [(chest, String("Changed the block"))]
    for (text, reply) in [
        // Block entities.
        (#"setblock 2 200 0 minecraft:oak_sign{front_text:{messages:["a","b","",""]}}"#, "Changed the block"),
        (#"setblock 4 200 0 minecraft:furnace{Items:[{Slot:0b,id:"minecraft:iron_ore",count:5}]}"#, "Changed the block"),
        ("setblock 6 199 3 minecraft:stone", "Changed the block"),
        // Points of interest: a bed, a bell, job sites, a beehive and a nether portal.
        ("setblock 6 200 0 minecraft:red_bed[part=foot,facing=south]", "Changed the block"),
        ("setblock 6 200 1 minecraft:red_bed[part=head,facing=south]", "Changed the block"),
        ("setblock 8 200 0 minecraft:bell", "Changed the block"),
        ("setblock 10 200 0 minecraft:composter", "Changed the block"),
        ("setblock 12 200 0 minecraft:lectern", "Changed the block"),
        ("setblock 14 200 0 minecraft:beehive", "Changed the block"),
        ("setblock 40 200 40 minecraft:grindstone", "Changed the block"),
        ("fill 20 200 0 23 204 0 minecraft:obsidian", "Successfully filled"),
        ("fill 21 201 0 22 203 0 minecraft:nether_portal[axis=x]", "Successfully filled"),
        // Ticks that wait: sand over air falls on its tick, and water spreads on its.
        ("setblock 30 200 0 minecraft:sand", "Changed the block"),
        ("setblock 32 200 0 minecraft:water", "Changed the block"),
        ("setblock 34 200 0 minecraft:lava", "Changed the block"),
        // Entities.
        (#"summon minecraft:pig 0 201 5 {NoAI:1b,CustomName:"Wilbur"}"#, "Summoned new"),
        (#"summon minecraft:villager 4 201 5 {NoAI:1b,VillagerData:{profession:"minecraft:librarian",level:2,type:"minecraft:plains"}}"#, "Summoned new"),
        ("summon minecraft:armor_stand 8 201 5 \{ShowArms:1b,NoGravity:1b\}", "Summoned new"),
        (#"summon minecraft:item 10 201 5 {Item:{id:"minecraft:apple",count:2},PickupDelay:32767s,NoGravity:1b}"#, "Summoned new"),
        (#"summon minecraft:chest_minecart 12 201 5 {Items:[{Slot:0b,id:"minecraft:torch",count:16}],NoGravity:1b}"#, "Summoned new"),
        (#"summon minecraft:zombie 14 201 5 {NoAI:1b,PersistenceRequired:1b,Passengers:[{id:"minecraft:chicken",NoAI:1b}]}"#, "Summoned new"),
        ("summon minecraft:pig -40 201 -40 \{NoAI:1b\}", "Summoned new"),
        // The other dimensions.
        (#"execute in minecraft:the_nether run setblock 0 120 0 minecraft:chest{Items:[{Slot:1b,id:"minecraft:gold_ingot",count:7}]}"#, "Changed the block"),
        ("execute in minecraft:the_nether run summon minecraft:strider 3 121 3 \{NoAI:1b\}", "Summoned new"),
        ("execute in minecraft:the_end run setblock 0 120 0 minecraft:ender_chest", "Changed the block"),
        ("execute in minecraft:the_end run summon minecraft:end_crystal 3 121 3 \{ShowBottom:0b\}", "Summoned new"),
        // Saved data and level.dat.
        ("scoreboard objectives add rig dummy", "Created new objective"),
        ("scoreboard players set alice rig 5", "for alice to 5"),
        ("team add red", "Created team"),
        (#"data modify storage calcite:rig value set value {a:1,b:[I;1,2,3],c:"x"}"#, "Modified storage"),
        ("random value 1..6 calcite:dice", "Randomized value"),
        (#"bossbar add calcite:bar "Rig""#, "Created custom bossbar"),
        ("worldborder set 1000", "Set the world border"),
        ("weather rain 6000", "Set the weather"),
        ("time set 1234", "1234"),
    ] {
        out.push((String(text), String(reply)))
    }
    return out
}

/// Asked of vanilla once it has opened a world, whose answers must be the same for Calcite's save
/// as for vanilla's own: what the world holds, read back from the files.
const QUERIES: [str; 14] = [
    "data get block 0 200 0 Items",
    "data get block 2 200 0 front_text",
    "data get block 4 200 0 Items",
    "execute in minecraft:the_nether run data get block 0 120 0 Items",
    "execute if block 21 201 0 minecraft:nether_portal",
    "execute if block 6 200 1 minecraft:red_bed[part=head]",
    "scoreboard players get alice rig",
    "data get storage calcite:rig value",
    "worldborder get",
    "forceload query",
    "execute in minecraft:the_nether run forceload query",
    "execute in minecraft:the_end run forceload query",
    "team list",
    "bossbar list",
]
/// The same for entities, which load a little after their chunks, so each is asked until it's
/// found, for a while.
const ENTITIES: [str; 8] = [
    "execute if entity @e[type=minecraft:pig,name=Wilbur]",
    "data get entity @e[type=minecraft:villager,x=4,y=201,z=5,distance=..1,limit=1] VillagerData",
    "data get entity @e[type=minecraft:chest_minecart,x=12,y=201,z=5,distance=..1,limit=1] Items",
    "data get entity @e[type=minecraft:item,x=10,y=201,z=5,distance=..1,limit=1] Item",
    "execute if entity @e[type=minecraft:zombie,x=14,y=201,z=5,distance=..2]",
    "execute if entity @e[type=minecraft:chicken,x=14,y=201,z=5,distance=..4]",
    "execute in minecraft:the_nether if entity @e[type=minecraft:strider]",
    "execute in minecraft:the_end if entity @e[type=minecraft:end_crystal,x=3,y=121,z=3,distance=..2]",
]
const MARK: str = "rig-mark"

/// A console line's level and message.
const LINE: str = #"^\[[^\]]*\] \[[^\]]*/(INFO|WARN|ERROR)\]: (.*)$"#

fn folder_of(name: str) -> String {
    return under("build/rig/roundtrip/{name}")
}

fn remove(dir: String) {
    if exists(dir.copy()) {
        match remove_dir_all(dir.copy()) {
            ok => {},
            err(e) => die("roundtrip: {dir}: {e}"),
        }
    }
}

fn copy_tree(from: String, to: String) {
    match copy_dir_all(from.copy(), to.copy()) {
        ok => {},
        err(e) => die("roundtrip: copying {from} to {to}: {e}"),
    }
}

/// A server's folder, with a copy of `world` as its world if one's given.
fn prepare(folder: String, port: i64, world: String?) {
    remove(folder.copy())
    match make_dir_all(folder.copy()) {
        ok => {},
        err(e) => die("roundtrip: {folder}: {e}"),
    }
    var props: List<(String, String)> = []
    for (k, v) in [("online-mode", "false"), ("server-ip", "127.0.0.1"), ("level-seed", "calcite"), ("view-distance", "4"),
        ("simulation-distance", "4"), ("spawn-protection", "0")] {
        props.push((String(k), String(v)))
    }
    props.push((String("server-port"), "{port}"))
    put(path.join(folder.copy(), "server.properties"), properties(props))
    put(path.join(folder.copy(), "whitelist.json"), players_json([String(BOT)], false))
    // Elliot accepted Mojang's EULA for the rig's own scratch servers (CAL-42).
    put(path.join(folder.copy(), "eula.txt"), String("eula=true\n"))
    if let w = world {
        copy_tree(w, path.join(folder, "world"))
    }
}

fn command(server: mut Server, text: String, reply: String, at: usize) -> usize {
    server.send(text)
    return server.wait_for(reply, at, 60)
}

/// Waits until the block at `x`, `z` in `dim` is loaded, asking the console.
fn loaded(server: mut Server, dim: str, x: i64, z: i64, after: usize) -> usize {
    let began = unsafe { Instant.now() }
    var at = after
    loop {
        server.send("execute in {dim} if loaded {x} 0 {z}")
        at = server.wait_for(String("Test "), at, 60)
        if server.lines[at - 1].contains("Test passed") {
            return at
        }
        if unsafe { Instant.now() }.secs_since(began) > 300.0 {
            server.abort("roundtrip: {dim} never loaded {x}, {z}")
        }
        _ = server.pump(500)
    }
}

/// Forces `FORCED` in each dimension and waits until each area's corners are loaded.
fn force(server: mut Server, after: usize) -> usize {
    var at = after
    for (dim, x0, z0, x1, z1) in FORCED {
        at = command(mut server, "execute in {dim} run forceload add {x0} {z0} {x1} {z1}", String("to be force loaded"), at)
    }
    for (dim, x0, z0, x1, z1) in FORCED {
        for (x, z) in [(x0, z0), (x1, z1), (x0, z1), (x1, z0)] {
            at = loaded(mut server, dim, x, z, at)
        }
    }
    return at
}

/// The plain world: vanilla's from the seed, with `FORCED` loaded and saved, nothing put in it
/// (D599).
pub fn make_plain() {
    let folder = folder_of("plain")
    prepare(folder.copy(), free_port(), none)
    let began = unsafe { Instant.now() }
    var server = Server.start(vanilla_argv(adapter(), false, false), folder, String("vanilla"))
    var at = server.wait_for(String("Done ("), 0, 180)
    at = force(mut server, at)
    _ = command(mut server, String("save-all flush"), String("Saved the game"), at)
    server.stop()
    println("  vanilla made the plain world in {unsafe { Instant.now() }.secs_since(began):.1}s")
}

/// Step 1: vanilla's world.
fn make(bot: String) {
    let folder = folder_of("vanilla")
    let port = free_port()
    prepare(folder.copy(), port, none)
    let began = unsafe { Instant.now() }
    var server = Server.start(vanilla_argv(adapter(), false, false), folder.copy(), String("vanilla"))
    var at = server.wait_for(String("Done ("), 0, 180)
    at = force(mut server, at)
    let got = server.beside([bot.copy(), "{port}", "{VIEW}", String("join"), path.join(folder, "join.bin")], 120)
    if got.code != some(0i32) {
        server.abort("roundtrip: the bot couldn't join vanilla:\n{got.stdout}{got.stderr}")
    }
    at = server.wait_for("{BOT} left the game", at, 180)
    at = command(mut server, String("tick freeze"), String("The game is frozen"), at)
    for (text, reply) in content() {
        at = command(mut server, text.copy(), reply.copy(), at)
    }
    _ = command(mut server, String("save-all flush"), String("Saved the game"), at)
    server.stop()
    println("  vanilla made its world in {unsafe { Instant.now() }.secs_since(began):.1}s")
}

/// The last `n` characters of `s`, as Python's `s[-n:]` gives them.
fn last_chars(s: String, n: usize) -> String {
    var runes: List<String> = []
    for r in s.chars() {
        runes.push("{r}")
    }
    let from = if runes.len() > n { runes.len() - n } else { 0 }
    return runes[from..].join(String(""))
}

/// Step 2: Calcite loads and saves a copy.
fn resave(tool: String) -> List<String> {
    let folder = folder_of("calcite")
    remove(folder.copy())
    copy_tree(path.join(folder_of("vanilla"), "world"), path.join(folder.copy(), "world"))
    let began = unsafe { Instant.now() }
    let got = match Command.new(tool).args([path.join(folder, "world")]).dir(root()).timeout(600000).output() {
        ok(o) => o,
        err(e) => die("roundtrip: running resave: {e}"),
    }
    let out = got.text()
    var differences: List<String> = []
    for line in out.lines() {
        if line.starts_with("WARN ") or line.starts_with("ERROR ") {
            differences.push("Calcite logged {line}")
        } else if line.starts_with("INFO saved") {
            println("  calcite {line[5..]} in {unsafe { Instant.now() }.secs_since(began):.1}s")
        }
    }
    if not got.status.success() {
        differences.push("resave exited with {got.status.code ?? -1}:\n{out}{got.error_text()}")
    }
    return differences
}

/// Step 3: vanilla reads both and compares them.
fn check(a: Json) -> List<String> {
    let argv = adapter_argv(a.copy())
    var args = argv[1..argv.len() - 1]
    args.push(String("calcite.rig.vanilla.WorldCheck"))
    args.push(native(path.join(folder_of("vanilla"), "world")))
    args.push(native(path.join(folder_of("calcite"), "world")))
    let got = match Command.new(argv[0].copy()).args(args).dir(adapter_cwd(a)).timeout(600000).output() {
        ok(o) => o,
        err(e) => die("roundtrip: running WorldCheck: {e}"),
    }
    let out = got.text()
    let lines = out.lines()
    let code = got.status.code ?? -1
    if (code != 0 and code != 1) or lines.is_empty() or not lines[lines.len() - 1].starts_with("checked ") {
        return ["WorldCheck failed:\n{out}{last_chars(got.error_text(), 4000)}"]
    }
    println("  vanilla {lines[lines.len() - 1]}")
    return lines[..lines.len() - 1]
}

/// What vanilla answers `text`: what it tells the console, up to a mark said after it. Other
/// lines, such as the save vanilla makes once it's up, are left out.
fn ask(server: mut Server, line: mut Regex, text: String, at: usize) -> (String, usize) {
    server.send(text)
    server.send("say {MARK}")
    let end = server.wait_for(String(MARK), at, 60)
    var said: List<String> = []
    for i in at..end - 1 {
        if let c = line.captures(server.lines[i].copy()) {
            let message = c.get(2) ?? String("")
            if message.starts_with("System chat: ") {
                said.push(message["System chat: ".len()..])
            }
        }
    }
    return (said.join(String(" | ")), end)
}

/// Step 4: what vanilla warns of opening `world`, with numbers taken out, and what it answers
/// the queries.
fn reopen(name: str, world: String) -> (Set<String>, Map<String, String>) {
    let folder = folder_of(name)
    prepare(folder.copy(), free_port(), some(world.copy()))
    var server = Server.start(vanilla_argv(adapter(), false, false), folder, String(name))
    var line = Regex.new(String(LINE))!
    var answers = Map<String, String>()
    var at = server.wait_for(String("Done ("), 0, 180)
    for q in QUERIES {
        let (said, end) = ask(mut server, mut line, String(q), at)
        answers.insert(String(q), said)
        at = end
    }
    for q in ENTITIES {
        let began = unsafe { Instant.now() }
        loop {
            let (said, end) = ask(mut server, mut line, String(q), at)
            at = end
            let done = said.contains("Test passed") or said.contains("has the following") or unsafe { Instant.now() }.secs_since(began) > 30.0
            answers.insert(String(q), said)
            if done {
                break
            }
            _ = server.pump(500)
        }
    }
    _ = command(mut server, String("save-all flush"), String("Saved the game"), at)
    server.stop()
    var digits = Regex.new(String("[0-9]+"))!
    var found = Set<String>()
    for l in server.lines {
        if let c = line.captures(l.copy()) {
            let level = c.get(1) ?? String("")
            if level != "INFO" {
                found.insert("{level} {digits.replace_all(c.get(2) ?? String(""), String("#"))}")
            }
        }
    }
    return (found, answers)
}

/// The round trip through vanilla (G5.2, CAL-61): a world vanilla 26.3 made and saved, loaded and
/// saved again by Calcite, then read by vanilla, which must find the same world.
@cli(name: "roundtrip")
struct Args {
    /// Use the last run's vanilla world.
    reuse: bool
}

pub fn main() {
    let args = Args.parse()
    let a = adapter()
    let bot = build("src/rig/session.calx", "session")
    let tool = build("src/rig/resave.calx", "resave")
    if not args.reuse or not is_dir(path.join(folder_of("vanilla"), "world")) {
        make(bot)
    }
    var differences = resave(tool)
    let back = folder_of("back-world")
    remove(back.copy())
    copy_tree(path.join(folder_of("calcite"), "world"), back.copy())
    differences.extend(check(a))
    let (ours, own_answers) = reopen("again", path.join(folder_of("vanilla"), "world"))
    let (theirs, their_answers) = reopen("back", back)
    var logged: List<String> = []
    for w in theirs {
        if not ours.contains(w.copy()) {
            logged.push(w.copy())
        }
    }
    logged.sort()
    for w in logged {
        differences.push("vanilla opening Calcite's save logged {w}")
    }
    var all: List<String> = []
    for q in QUERIES {
        all.push(String(q))
    }
    for q in ENTITIES {
        all.push(String(q))
    }
    var answers = LinkedMap<String, Json>()
    for q in all {
        var both = LinkedMap<String, Json>()
        both.insert(String("vanilla"), Json.Str(own_answers[q.copy()].copy()))
        both.insert(String("calcite"), Json.Str(their_answers[q.copy()].copy()))
        answers.insert(q.copy(), Json.Object(both))
    }
    put(folder_of("answers.json"), "{indented_ascii(Json.Object(answers))}\n")
    for q in all {
        let mine = own_answers[q.copy()].copy()
        let yours = their_answers[q.copy()].copy()
        if mine != yours {
            differences.push("vanilla answers {repr_str(q.copy())} with {repr_str(yours.copy())} in Calcite's save and {repr_str(mine.copy())} in its own")
        }
        if mine.contains("Test failed") or mine.contains("No entity") or mine.contains("Found no") {
            differences.push("vanilla's own world doesn't answer {repr_str(q.copy())}: {repr_str(mine.copy())}")
        }
    }
    println("  vanilla opened Calcite's save with {logged.len()} lines it doesn't log opening its own, and answered {all.len()} questions about it as about its own")
    for d in differences {
        println(d)
    }
    if differences.is_empty() {
        println("G5.2: passed")
    } else {
        println("G5.2: {differences.len()} differences")
        exit(1)
    }
}
