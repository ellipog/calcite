module rig.runner.tapediff

// Lines up two RNG tapes, vanilla's from the rig's agent and Calcite's, level by level (D312).
//
//     calx rig/runner/tapediff.calx VANILLA_TAPE CALCITE_TAPE [--show N] [--since TIME]
//
// A tape is a line for each value a level's random drew: the level, its game time, the bits
// drawn, the value, and on vanilla's, where it was drawn. Each ends with a `# end LEVEL TIME` line
// for each level, the game time it had when the server stopped. For each level, the draws are
// compared in order over the game times both servers ran, and the first that differs is shown
// with where vanilla drew it, with the few after it, since that's where the two servers' ticks
// part. With --since, the time both seeded their levels' randoms again (D316), the draws from then
// on are lined up too, so what each drew while the player's chunks loaded doesn't hide the rest.
// It exits with 1 if any level's draws differ. It's the Calx port of tapediff.py (CAL-253).

import std.cli.{cli}
import std.fs.{read_text}
import std.process.{exit}
import tools.repo.{die}

/// One draw: the game time, the bits drawn, the value, and where it was drawn, if the tape says.
pub struct Draw {
    pub time: i64
    pub bits: i64
    pub value: i64
    pub site: String
}

/// A level's draws, and the game time it had when the server stopped, if the tape says.
pub struct Level {
    pub draws: List<Draw>
    pub end: i64?
}

fn level() -> Level {
    return Level { draws: List<Draw>(), end: none }
}

fn number(text: String, file: String) -> i64 {
    return i64.parse(text.copy()) ?? die("tapediff: {file}: {text} isn't a number")
}

/// Each level's draws on the tape at `file`.
pub fn read(file: String) -> LinkedMap<String, Level> {
    let text = match read_text(file.copy()) {
        ok(t) => t ?? die("tapediff: {file} isn't UTF-8"),
        err(e) => die("tapediff: {file}: {e}"),
    }
    var levels = LinkedMap<String, Level>()
    for line in text.lines() {
        let parts = line.split_whitespace()
        if parts.is_empty() {
            continue
        }
        if parts[0] == "#" {
            if parts.len() == 4 and parts[1] == "end" {
                let end = number(parts[3].copy(), file.copy())
                if let l = mut levels.find(parts[2].copy()) {
                    l.end = some(end)
                } else {
                    var l = level()
                    l.end = some(end)
                    levels.insert(parts[2].copy(), l)
                }
            }
            continue
        }
        if parts.len() < 4 {
            die("tapediff: {file}: a draw without its time, bits and value: {line}")
        }
        let draw = Draw { time: number(parts[1].copy(), file.copy()), bits: number(parts[2].copy(), file.copy()), value: number(parts[3].copy(), file.copy()), site: parts[4..parts.len()].join(" ") }
        if let l = mut levels.find(parts[0].copy()) {
            l.draws.push(draw)
        } else {
            var l = level()
            l.draws.push(draw)
            levels.insert(parts[0].copy(), l)
        }
    }
    return levels
}

fn shown(draws: List<Draw>, i: usize) -> String {
    if i >= draws.len() {
        return String("nothing")
    }
    let d = draws[i].copy()
    let at = "at {d.time}, {d.bits} bits, {d.value}"
    if d.site.is_empty() {
        return at
    }
    return "{at}, {d.site}"
}

fn same_draw(a: Draw, b: Draw) -> bool {
    return a.time == b.time and a.bits == b.bits and a.value == b.value
}

/// Prints how far two lists of draws are the same, and the first that differs, with `show` after
/// it; true if they differ.
fn line_up(label: String, vd: List<Draw>, cd: List<Draw>, until: i64, show: usize) -> bool {
    var same = 0usize
    while same < vd.len() and same < cd.len() and same_draw(vd[same], cd[same]) {
        same += 1
    }
    if same == vd.len() and same == cd.len() {
        println("{label}: the same, {same} draws before game time {until}")
        return false
    }
    println("{label}: {same} draws the same, then they differ (before game time {until}; vanilla {vd.len()}, Calcite {cd.len()})")
    for i in same..same + show {
        if i >= vd.len() and i >= cd.len() {
            break
        }
        println("  vanilla {shown(vd, i)}")
        println("  calcite {shown(cd, i)}")
    }
    return true
}

fn before(draws: List<Draw>, until: i64, since: i64?) -> List<Draw> {
    var out: List<Draw> = []
    for d in draws {
        if d.time < until and (since == none or d.time >= (since ?? 0)) {
            out.push(d.copy())
        }
    }
    return out
}

/// Prints how each level's draws line up, and says whether any differ.
pub fn compare(vanilla: LinkedMap<String, Level>, calcite: LinkedMap<String, Level>, show: usize, since: i64?) -> bool {
    var differ = false
    var names: List<String> = []
    for (name, _) in vanilla {
        names.push(name.copy())
    }
    for (name, _) in calcite {
        if not vanilla.contains(name.copy()) {
            names.push(name.copy())
        }
    }
    names.sort()
    let nothing = level()
    for name in names {
        let v = if let l = vanilla.find(name.copy()) { l.copy() } else { nothing.copy() }
        let c = if let l = calcite.find(name.copy()) { l.copy() } else { nothing.copy() }
        var ends: List<i64> = []
        for e in [v.end, c.end] {
            if let x = e {
                ends.push(x)
            }
        }
        if ends.is_empty() {
            println("{name}: no end on either tape, so it's left out")
            continue
        }
        // Draws at the last time either ran may be from a tick the other didn't finish.
        let until = if ends.len() == 2 and ends[1] < ends[0] { ends[1] } else { ends[0] }
        let vd = before(v.draws, until, none)
        let cd = before(c.draws, until, none)
        if line_up(name.copy(), vd.copy(), cd.copy(), until, show) {
            differ = true
        }
        if let s = since {
            if s < until {
                if line_up("{name} from game time {s}, seeded again", before(vd, until, some(s)), before(cd, until, some(s)), until, show) {
                    differ = true
                }
            }
        }
    }
    return differ
}

/// Lines up two RNG tapes, vanilla's and Calcite's, level by level.
@cli(name: "tapediff")
struct Args {
    /// Vanilla's tape.
    @positional
    vanilla: String
    /// Calcite's tape.
    @positional
    calcite: String
    /// The draws shown from the first that differs.
    show: i64 = 3
    /// The game time both seeded their levels' randoms again, from which the draws are lined up
    /// too.
    since: i64?
}

pub fn main() {
    let args = Args.parse()
    let show = if args.show < 0 { 0usize } else { usize.wrap(args.show) }
    if compare(read(args.vanilla.copy()), read(args.calcite.copy()), show, args.since) {
        exit(1)
    }
}
