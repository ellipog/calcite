module rig.runner.traces

// Lines up the entity traces of a rig session (CAL-159): what the rig's agent wrote of vanilla's
// living entities to entities.txt, with `trace`, and what Calcite wrote with `--entity-trace`, a
// line each time an entity's tick is done:
//
//     TIME ID x y z dx dy dz yRot xRot yHeadRot yBodyRot zza xxa speed onGround
//
//     calx rig/runner/traces.calx FOLDER [ID] [--after N] [--by-place]
//
// FOLDER is a configuration's session folder, such as build/rig/sessions/zombie, holding vanilla/
// and calcite/. For each entity, or only ID, it finds the first tick where the two differ in any
// value, read as numbers, so Java's 1.0E-4 and Calcite's 0.0001 are the same, and prints the tick
// before it, it, and the N after (default 4) on both sides, each value that differs marked. Its
// vanilla trace holds the players too, which Calcite's doesn't, so an ID only one side has is said
// once and passed over. With --by-place, each of vanilla's entities is lined up with Calcite's that
// was first traced at the same game time and place, whatever its ID, for a session whose servers
// loaded its entities' chunks in another order and so gave them other IDs (CAL-188); ID is
// vanilla's.

import std.cli.{cli}
import std.fs.{read_text}
import std.json.{Json}
import std.path
import tools.pyjson.{compact}
import tools.repo.{die}

const FIELDS: [str; 14] = ["x", "y", "z", "dx", "dy", "dz", "yRot", "xRot", "yHeadRot", "yBodyRot", "zza", "xxa", "speed", "onGround"]

/// One tick of an entity's: the game time, its numbers, and whether it was on the ground.
struct Tick {
    time: i64
    values: List<f64>
    on_ground: bool
}

fn same(a: Tick, b: Tick) -> bool {
    return a.time == b.time and a.values == b.values and a.on_ground == b.on_ground
}

fn number(text: String) -> f64 {
    return f64.parse(text.copy()) ?? die("traces: {text} isn't a number")
}

fn whole(text: String) -> i64 {
    return i64.parse(text.copy()) ?? die("traces: {text} isn't an integer")
}

/// Each entity's ticks in order, by its ID, the IDs in the order they first come.
fn read(file: String) -> LinkedMap<i64, List<Tick>> {
    let text = match read_text(file.copy()) {
        ok(t) => t ?? die("traces: {file} isn't UTF-8"),
        err(e) => die("traces: {file}: {e}"),
    }
    var out = LinkedMap<i64, List<Tick>>()
    for line in text.lines() {
        let parts = line.split_whitespace()
        if parts.len() != 2 + FIELDS.len() {
            continue
        }
        var values: List<f64> = []
        for k in 2..parts.len() - 1 {
            values.push(number(parts[k].copy()))
        }
        let tick = Tick { time: whole(parts[0].copy()), values: values, on_ground: parts[parts.len() - 1] == "true" }
        let id = whole(parts[1].copy())
        if let ticks = mut out.find(id) {
            ticks.push(tick)
        } else {
            out.insert(id, [tick])
        }
    }
    return out
}

/// A value as Python's `repr` writes it.
fn repr(v: f64) -> String {
    return compact(Json.Float(v))
}

fn show(side: str, tick: Tick, other: Tick?) {
    var marked: List<String> = []
    for k in 0..FIELDS.len() {
        var text = String("")
        var differs = false
        if k < tick.values.len() {
            text = repr(tick.values[k])
            if let o = other {
                differs = o.values[k] != tick.values[k]
            }
        } else {
            text = String(if tick.on_ground { "True" } else { "False" })
            if let o = other {
                differs = o.on_ground != tick.on_ground
            }
        }
        if differs {
            text = "*{text}*"
        }
        marked.push("{FIELDS[k]}={text}")
    }
    println("  {side:<8} t{tick.time} {marked.join(" ")}")
}

fn compare(id: i64, a: List<Tick>, b: List<Tick>, after: i64) {
    let both = if a.len() < b.len() { a.len() } else { b.len() }
    for i in 0..both {
        if not same(a[i], b[i]) {
            println("entity {id}: parts at its tick {i}, game time {a[i].time} vs {b[i].time}")
            let from = if i > 0 { i - 1 } else { 0 }
            let reach = i64.wrap(i) + after + 1
            let to = if reach < i64.wrap(both) { reach } else { i64.wrap(both) }
            var k = from
            while i64.wrap(k) < to {
                show("vanilla", a[k], some(b[k].copy()))
                show("calcite", b[k], some(a[k].copy()))
                k += 1
            }
            return
        }
    }
    println("entity {id}: the same for {both} ticks ({a.len()} vs {b.len()})")
}

/// Where and when an entity was first traced, as the Python's tuple keyed it: -0.0 as 0.0.
fn place(tick: Tick) -> String {
    return "{tick.time} {(tick.values[0] + 0.0).to_bits()} {(tick.values[1] + 0.0).to_bits()} {(tick.values[2] + 0.0).to_bits()}"
}

/// Lines up the entity traces of a rig session, vanilla's and Calcite's.
@cli(name: "traces")
struct Args {
    /// The configuration's session folder, holding vanilla/ and calcite/.
    @positional
    folder: String
    /// Only this entity.
    @positional
    id: i64?
    /// How many ticks to show after the first that differs.
    after: i64 = 4
    /// Pair entities by where they were first traced.
    by_place: bool
}

pub fn main() {
    let args = Args.parse()
    let va = read(path.join(path.join(args.folder.copy(), "vanilla"), "entities.txt"))
    var ca = read(path.join(path.join(args.folder.copy(), "calcite"), "entities.txt"))
    if args.by_place {
        var firsts = Map<String, i64>()
        for (id, ticks) in ca {
            firsts.insert(place(ticks[0]), id)
        }
        var paired = LinkedMap<i64, List<Tick>>()
        for (id, ticks) in va {
            if let other = firsts.get(place(ticks[0])) {
                paired.insert(id, ca[other].copy())
                if other != id {
                    println("entity {id}: Calcite's {other}")
                }
            }
        }
        ca = paired
    }
    var ids: List<i64> = []
    if let only = args.id {
        ids.push(only)
    } else {
        var all = Set<i64>()
        for (id, _) in va {
            all.insert(id)
        }
        for (id, _) in ca {
            all.insert(id)
        }
        for id in all {
            ids.push(id)
        }
        ids.sort()
    }
    for id in ids {
        if not va.contains(id) or not ca.contains(id) {
            println("entity {id}: only {if va.contains(id) { "vanilla" } else { "Calcite" }} traced it")
            continue
        }
        compare(id, va[id], ca[id], args.after)
    }
}
