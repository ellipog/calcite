module rig.runner.session_data

// What the protocol suites give both servers (rig/runner/sessions.calx): the bot's saved data in
// each configuration, the data packs and the saved scoreboards and boss bars, as sessions.py had
// them (CAL-253). Each tag is written as SNBT, its kinds as vanilla's `TagParser` reads them, and
// one made from another as Python's `dict(base, key=value)` made it, `with`: a key that's there
// keeps its place, and a new one goes at the end.

import std.nbt.{Tag, parse_snbt}
import tools.repo.{die}

/// The tag in `text`, SNBT.
pub fn snbt(text: String) -> Tag {
    return match parse_snbt(text.copy()) {
        ok(t) => t,
        err(e) => die("sessions: {e} in {text}"),
    }
}

/// `base` with the members of the SNBT compound `members` put in, as `dict(base, **members)`.
pub fn with(base: Tag, members: String) -> Tag {
    var out = base.copy()
    if let Tag.Compound(m) = snbt(members) {
        for (k, v) in m {
            _ = out.insert(k.copy(), v.copy())
        }
    }
    return out
}

/// A stack as `ItemStack.CODEC` writes it, as SNBT, with `components` if they aren't empty.
pub fn stack(item: str, count: i64, components: String) -> String {
    if components.is_empty() {
        return "\{id: \"minecraft:{item}\", count: {count}\}"
    }
    return "\{id: \"minecraft:{item}\", count: {count}, components: {components}\}"
}

/// A stack in an inventory's slot.
pub fn slotted(slot: i64, item: str, count: i64, components: String) -> String {
    if components.is_empty() {
        return "\{Slot: {slot}b, id: \"minecraft:{item}\", count: {count}\}"
    }
    return "\{Slot: {slot}b, id: \"minecraft:{item}\", count: {count}, components: {components}\}"
}

/// An effect as a living entity saves it, with each flag given as a byte.
pub fn effect(name: str, duration: i64, amplifier: i64, flags: List<(str, bool)>) -> String {
    var out = "\{id: \"minecraft:{name}\", amplifier: {amplifier}b, duration: {duration}"
    for (k, v) in flags {
        out = "{out}, {k}: {if v { 1 } else { 0 }}b"
    }
    return "{out}\}"
}

fn enchanted(name: str, level: i64) -> String {
    return #"{"minecraft:enchantments": {"minecraft:#{name}": #{level}}}"#
}

fn potion(name: str) -> String {
    return #"{"minecraft:potion_contents": {potion: "minecraft:#{name}"}}"#
}

const STANDING: str = #"DataVersion: 5023, Pos: [0.5d, -60.0d, 0.5d], Rotation: [0.0f, 0.0f], Dimension: "minecraft:overworld""#

/// The bot's data in `inventory`: in creative mode, on the flat world's ground at the spawn,
/// holding the hotbar's second slot, with stacks in the hotbar, the inventory's own slots and the
/// offhand, armor, and components of the kinds the stream codecs send: a number, enchantments, a
/// name, a potion, a color, and one taken away (CAL-135).
pub fn inventory() -> Tag {
    let items = [
        slotted(0, "stone", 64, ""),
        slotted(1, "diamond_sword", 1, #"{"minecraft:damage": 5, "minecraft:enchantments": {"minecraft:sharpness": 3}}"#),
        slotted(2, "potion", 1, potion("swiftness")),
        slotted(8, "bread", 7, #"{"!minecraft:food": {}}"#),
        slotted(9, "oak_log", 10, #"{"minecraft:custom_name": "Logs"}"#),
        slotted(35, "shield", 1, ""),
    ].join(", ")
    let equipment = "head: {stack("diamond_helmet", 1, "")}, chest: {stack("elytra", 1, #"{"minecraft:damage": 10}"#)}, feet: {stack("leather_boots", 1, #"{"minecraft:dyed_color": 3368652}"#)}, offhand: {stack("torch", 32, "")}"
    return snbt(#"{#{STANDING}, playerGameType: 1, SelectedItemSlot: 1, Inventory: [#{items}], equipment: {#{equipment}}}"#)
}

/// The bot's data in `clicks`: `inventory`'s, in survival mode, where clicks are the inventory's
/// own, rather than the creative menu's (CAL-136).
pub fn clicks() -> Tag {
    return with(inventory(), String("\{playerGameType: 0\}"))
}

/// The bot's data in `crafts`: in survival mode, holding nothing, with three oak logs in the
/// inventory's first slot, four honey bottles in its fourth, paper in its fifth, gunpowder in its
/// sixth, iron ingots in its seventh, sticks in its eighth and cobblestone in its ninth, which it
/// crafts with in its inventory's grid and at the fixture's crafting table (CAL-147).
pub fn crafts() -> Tag {
    let items = [
        slotted(9, "oak_log", 3, ""),
        slotted(12, "honey_bottle", 4, ""),
        slotted(13, "paper", 1, ""),
        slotted(14, "gunpowder", 1, ""),
        slotted(15, "iron_ingot", 3, ""),
        slotted(16, "stick", 2, ""),
        slotted(17, "cobblestone", 8, ""),
    ].join(", ")
    return snbt(#"{#{STANDING}, playerGameType: 0, SelectedItemSlot: 0, Inventory: [#{items}]}"#)
}

/// The bot's data in `rewards`: in survival mode, its inventory full of wooden swords but for 30
/// cobblestone in its last slot, so what an advancement's loot gives mostly doesn't fit (CAL-164).
pub fn rewards() -> Tag {
    var items: List<String> = []
    for n in 0i64..35 {
        items.push(slotted(n, "wooden_sword", 1, ""))
    }
    items.push(slotted(35, "cobblestone", 30, ""))
    return with(crafts(), "\{Inventory: [{items.join(", ")}]\}")
}

/// A loot table of an advancement's rewards with a pool for each item and count in `pools`, an
/// entry's `modifier` setting its count, its random sequence its own ID, `name`, so both servers
/// draw the same, as `json.dumps` wrote it.
fn reward_table(name: str, pools: List<(str, str)>) -> String {
    var written: List<String> = []
    for (item, count) in pools {
        written.push(#"{"rolls": 1, "entries": [{"type": "minecraft:item", "name": "#{item}", "modifier": {"type": "minecraft:set_count", "count": #{count}}}]}"#)
    }
    return #"{"type": "minecraft:advancement_reward", "random_sequence": "#{name}", "pools": [#{written.join(", ")}]}"#
}

/// The `rewards` data pack: an advancement done on the player's first tick, which gives 5
/// experience and two loot tables, 4 cobblestone, which fit, then 40 cobblestone, of which 30 fit
/// and 10 are dropped, 2 diamonds, 1 to 3 arrows and 70 ender pearls, all dropped, the pearls in
/// stacks of 16 (CAL-164). Each file by its path in the pack.
pub fn rewards_pack() -> List<(String, String)> {
    return [
        (String("pack.mcmeta"), String(#"{"pack": {"description": "The rig's rewards", "min_format": 121, "max_format": 121}}"#)),
        (String("data/rig/advancement/given.json"), String(#"{"criteria": {"ticked": {"trigger": "minecraft:tick"}}, "rewards": {"experience": 5, "loot": ["rig:fits", "rig:given"]}}"#)),
        (String("data/rig/loot_table/fits.json"), reward_table("rig:fits", [("minecraft:cobblestone", "4")])),
        (String("data/rig/loot_table/given.json"), reward_table("rig:given", [("minecraft:cobblestone", "40"), ("minecraft:diamond", "2"), ("minecraft:arrow", #"{"type": "minecraft:uniform", "min": 1, "max": 3}"#), ("minecraft:ender_pearl", "70")])),
    ]
}

/// The functions `select` types `function` with (D567): `rig:load`, which `#minecraft:load` runs
/// once, making the objective `fn`; `rig:tick`, which `#minecraft:tick` runs each tick, counting
/// them and moving a player's `fn` of 50 on to 51; `rig:hello`, which says so; `rig:ret`, which
/// returns 7 before it says all it would; `rig:retfail`, which fails; `rig:retrun`, which returns
/// what a command gives; `rig:add` and `rig:double`, `#rig:both`, which give 2 and 3; `rig:count`,
/// which calls itself till it's counted to 10; `rig:deep`, which calls itself till the command
/// quota stops it; `rig:macro`, which says its argument, which `#minecraft:tick` skips, as it has
/// none; `rig:macro2`, a command then a macro line naming one variable twice; `rig:macrotp`, whose
/// line may not read once made; `rig:macroret`, which returns its argument; `#rig:macros`, a macro
/// function and a plain one; `rig:bad`, which can't be read for its `/`; and `#rig:broken`, which
/// can't be built for a function there isn't (D567, D568).
pub fn funcs_pack() -> List<(String, String)> {
    return [
        (String("pack.mcmeta"), String(#"{"pack": {"description": "The rig's functions", "min_format": 121, "max_format": 121}}"#)),
        (String("data/minecraft/tags/function/load.json"), String(#"{"values": ["rig:load"]}"#)),
        (String("data/minecraft/tags/function/tick.json"), String(#"{"values": ["rig:tick", "rig:macro"]}"#)),
        (String("data/rig/tags/function/macros.json"), String(#"{"values": ["rig:macro", "rig:hello"]}"#)),
        (String("data/rig/tags/function/both.json"), String(#"{"values": ["rig:add", "rig:double"]}"#)),
        (String("data/rig/tags/function/broken.json"), String(#"{"values": ["rig:hello", "rig:nope"]}"#)),
        (String("data/rig/function/load.mcfunction"), String("scoreboard objectives add fn dummy\nscoreboard players set #loaded fn 1\n")),
        (String("data/rig/function/tick.mcfunction"), String("# Each tick.\nscoreboard players add #ticks fn 1\nexecute as @a[scores=\{fn=50\}] run scoreboard players set @s fn 51\n")),
        (String("data/rig/function/hello.mcfunction"), String("say hello from a function\n")),
        (String("data/rig/function/ret.mcfunction"), String("say before\nreturn 7\nsay after\n")),
        (String("data/rig/function/retfail.mcfunction"), String("return fail\n")),
        (String("data/rig/function/retrun.mcfunction"), String("return run scoreboard players get #loaded fn\n")),
        (String("data/rig/function/add.mcfunction"), String("return 2\n")),
        (String("data/rig/function/double.mcfunction"), String("return 3\n")),
        (String("data/rig/function/count.mcfunction"), String("scoreboard players add #n fn 1\nexecute if score #n fn matches ..9 run \\\n    function rig:count\n")),
        (String("data/rig/function/deep.mcfunction"), String("scoreboard players add #deep fn 1\nfunction rig:deep\n")),
        (String("data/rig/function/macro.mcfunction"), String("$say $(x)\n")),
        (String("data/rig/function/macro2.mcfunction"), String("say plain\n$say $(a) and $(b) and $(a)\n")),
        (String("data/rig/function/macrotp.mcfunction"), String("$tp @s $(x) ~ ~\n")),
        (String("data/rig/function/macroret.mcfunction"), String("$return $(v)\n")),
        (String("data/rig/function/bad.mcfunction"), String("/say hi\n")),
        (String("data/rig/function/pred.mcfunction"), String("execute store result score #pred fn if predicate rig:player\nexecute store result score #always fn if predicate rig:always\n")),
        (String("data/rig/predicate/always.json"), String(#"{"type": "minecraft:random_chance", "chance": 1.0}"#)),
        (String("data/rig/predicate/never.json"), String(#"{"type": "minecraft:inverted", "term": "rig:always"}"#)),
        (String("data/rig/predicate/coin.json"), String(#"{"type": "minecraft:random_chance", "chance": 0.5}"#)),
        (String("data/rig/predicate/player.json"), String(#"{"type": "minecraft:entity_properties", "entity": "this", "predicate": {"minecraft:entity_type": "minecraft:player"}}"#)),
        (String("data/rig/predicate/overworld.json"), String(#"{"type": "minecraft:location_check", "predicate": {"dimension": "minecraft:overworld"}}"#)),
        (String("data/rig/slot_source/hands.json"), String(#"{"type": "minecraft:slot_range", "slots": "weapon.*"}"#)),
        (String("data/rig/slot_source/firsts.json"), String(#"{"type": "minecraft:group", "terms": [{"type": "minecraft:slot_range", "slots": "hotbar.0"}, {"type": "minecraft:slot_range", "slots": "inventory.0"}]}"#)),
        (String("data/rig/item_modifier/five.json"), String(#"{"type": "minecraft:set_count", "count": 5}"#)),
        (String("data/rig/item_modifier/some.json"), String(#"{"type": "minecraft:set_count", "count": {"type": "minecraft:uniform", "min": 1, "max": 9}}"#)),
    ]
}

/// The scoreboard in `scores` (CAL-164): objectives of the leave stat, health, shown as hearts in
/// the list, food, which follows its holders' display names and has a styled number format, in
/// the sidebar, air, with a fixed one, armor, experience, with a blank one, its level, deaths,
/// below names, and a dummy, in the red team's sidebar; scores of the dummy, one with a display
/// and a format of its own, of deaths for the bot, and one of an objective there isn't, which both
/// servers leave out; and three teams: red, with a color, a prefix and a suffix, its own rules,
/// the bot and alice, blue, with carol, and an empty one.
pub fn scoreboard() -> Tag {
    let objectives = [
        #"{Name: "left", CriteriaName: "minecraft.custom:minecraft.leave_game", DisplayName: "Left"}"#,
        #"{Name: "hp", CriteriaName: "health", DisplayName: {text: "Health", color: "red"}, RenderType: "hearts"}"#,
        #"{Name: "food", CriteriaName: "food", DisplayName: "Food", display_auto_update: 1b, format: {type: "minecraft:styled", color: "gold", bold: 1b}}"#,
        #"{Name: "air", CriteriaName: "air", DisplayName: "Air", format: {type: "minecraft:fixed", value: "lots"}}"#,
        #"{Name: "armor", CriteriaName: "armor", DisplayName: "Armor"}"#,
        #"{Name: "xp", CriteriaName: "xp", DisplayName: "XP", format: {type: "minecraft:blank"}}"#,
        #"{Name: "level", CriteriaName: "level", DisplayName: "Level"}"#,
        #"{Name: "deaths", CriteriaName: "deathCount", DisplayName: "Deaths"}"#,
        #"{Name: "plain", DisplayName: "Plain"}"#,
    ].join(", ")
    let scores = [
        #"{Name: "alice", Objective: "plain", Score: 5, Locked: 1b}"#,
        ##"{Name: "#fake", Objective: "plain", Score: -3, display: "Fake", format: {type: "minecraft:fixed", value: "?"}}"##,
        #"{Name: "Bot", Objective: "deaths", Score: 2}"#,
        #"{Name: "carol", Objective: "ghost", Score: 1}"#,
    ].join(", ")
    let slots = #"{list: "hp", sidebar: "food", below_name: "deaths", "sidebar.team.red": "plain"}"#
    let teams = [
        #"{Name: "red", DisplayName: "Red", TeamColor: "red", AllowFriendlyFire: 0b, MemberNamePrefix: "[R] ", MemberNameSuffix: {text: " *", color: "gray"}, NameTagVisibility: "hideForOtherTeams", CollisionRule: "pushOwnTeam", Players: ["Bot", "alice"]}"#,
        #"{Name: "blue", DisplayName: "Blue", SeeFriendlyInvisibles: 0b, DeathMessageVisibility: "never", Players: ["carol"]}"#,
        #"{Name: "empty", DisplayName: "Empty"}"#,
    ].join(", ")
    return snbt(#"{data: {Objectives: [#{objectives}], PlayerScores: [#{scores}], DisplaySlots: #{slots}, Teams: [#{teams}]}, DataVersion: 5023}"#)
}

/// The scoreboard in `teammates` (CAL-164): the bot and Mate in one team, which allows no friendly
/// fire and no collisions.
pub fn teammates() -> Tag {
    return snbt(String(#"{data: {Teams: [{Name: "pals", DisplayName: "Pals", AllowFriendlyFire: 0b, CollisionRule: "never", Players: ["Bot", "Mate"]}]}, DataVersion: 5023}"#))
}

/// The scoreboard in `rivals` (CAL-164): the bot in red, whose players push only each other, and
/// Mate in blue, whose death messages only its own players see; objectives of kills, player
/// kills, deaths, kills of blue and deaths by red, each shown.
pub fn rivals() -> Tag {
    let objectives = [
        #"{Name: "kills", CriteriaName: "totalKillCount", DisplayName: "Kills"}"#,
        #"{Name: "pk", CriteriaName: "playerKillCount", DisplayName: "Player kills"}"#,
        #"{Name: "deaths", CriteriaName: "deathCount", DisplayName: "Deaths"}"#,
        #"{Name: "tk", CriteriaName: "teamkill.blue", DisplayName: "Blues killed"}"#,
        #"{Name: "kbt", CriteriaName: "killedByTeam.red", DisplayName: "Killed by red"}"#,
    ].join(", ")
    let slots = #"{sidebar: "kills", list: "pk", below_name: "deaths", "sidebar.team.red": "tk", "sidebar.team.blue": "kbt"}"#
    let teams = [
        #"{Name: "red", DisplayName: "Red", TeamColor: "red", CollisionRule: "pushOwnTeam", Players: ["Bot"]}"#,
        #"{Name: "blue", DisplayName: "Blue", TeamColor: "blue", DeathMessageVisibility: "hideForOtherTeams", Players: ["Mate"]}"#,
    ].join(", ")
    return snbt(#"{data: {Objectives: [#{objectives}], DisplaySlots: #{slots}, Teams: [#{teams}]}, DataVersion: 5023}"#)
}

/// The scoreboard in `talk` (CAL-165): the bot and Mate in aqua's team; trigger objectives,
/// `door`, shown in the sidebar, whose score the bot may use, and `bell`, whose it may not; and
/// `kills`, which isn't one.
pub fn talk() -> Tag {
    let objectives = [
        #"{Name: "door", CriteriaName: "trigger", DisplayName: "Door"}"#,
        #"{Name: "bell", CriteriaName: "trigger", DisplayName: {text: "Bell", color: "gold"}}"#,
        #"{Name: "kills", CriteriaName: "totalKillCount", DisplayName: "Kills"}"#,
    ].join(", ")
    let scores = [
        #"{Name: "Bot", Objective: "door", Score: 3, Locked: 0b}"#,
        #"{Name: "Bot", Objective: "bell", Score: 0, Locked: 1b}"#,
    ].join(", ")
    return snbt(#"{data: {Objectives: [#{objectives}], PlayerScores: [#{scores}], DisplaySlots: {sidebar: "door"}, Teams: [{Name: "pals", DisplayName: "Pals", TeamColor: "aqua", Players: ["Bot", "Mate"]}]}, DataVersion: 5023}"#)
}

/// The bot's and Mate's UUIDs, `offline_uuid`'s, as `UUIDUtil.CODEC` saves them.
pub const BOT_INTS: str = "[I; -1155928273, 798308776, -1951547997, -315148217]"
pub const MATE_INTS: str = "[I; 105469737, -1056885334, -1415735622, -1521856055]"

/// The boss bars `bossbars` starts with (D606): `calcite:saved`, shown, red with 10 notches, its
/// value 30 of 60, darkening the screen, whose players the bot is among, so it's shown it as it
/// joins; `calcite:hidden`, unseen, playing boss music and making fog, with Mate among its players
/// and someone who isn't there; and `calcite:plain`, with only its name, so unseen.
pub fn saved_bars() -> Tag {
    let saved = #"{Name: {text: "Saved", color: "gold"}, Visible: 1b, Value: 30, Max: 60, Color: "red", Overlay: "notched_10", DarkenScreen: 1b, Players: [#{BOT_INTS}]}"#
    let hidden = #"{Name: "Hidden", PlayBossMusic: 1b, CreateWorldFog: 1b, Players: [#{MATE_INTS}, [I; 1, 2, 3, 4]]}"#
    return snbt(#"{data: {"calcite:saved": #{saved}, "calcite:hidden": #{hidden}, "calcite:plain": {Name: "Plain"}}, DataVersion: 5023}"#)
}

/// The bot's data in `dig`: in survival mode, by the spawn, holding a wooden shovel, with shears,
/// a golden pickaxe one use from breaking and a diamond sword in the hotbar, and torches in its
/// offhand (D376).
pub fn dig() -> Tag {
    let items = [
        slotted(0, "wooden_shovel", 1, ""),
        slotted(1, "shears", 1, ""),
        slotted(2, "golden_pickaxe", 1, #"{"minecraft:damage": 31}"#),
        slotted(3, "diamond_sword", 1, ""),
    ].join(", ")
    return snbt(#"{#{STANDING}, playerGameType: 0, SelectedItemSlot: 0, Inventory: [#{items}], equipment: {offhand: #{stack("torch", 32, "")}}}"#)
}

/// The same, in creative mode, in `dig_creative`.
pub fn dig_creative() -> Tag {
    return with(dig(), String("\{playerGameType: 1\}"))
}

/// A game rule, by its name, with its value.
pub struct Rule {
    pub name: String
    pub value: Tag
}

pub fn rule(name: str, value: own Tag) -> Rule {
    return Rule { name: String(name), value: value }
}

/// The rules the dig and place configurations' worlds are run with: no drops, which come with
/// item entities, and no natural spawning, as `terrain` (D376); and no random ticks, since grass
/// by a block placed or broken turns to dirt, or dirt to grass, on a tick that falls in a
/// different step on each server (D378).
pub fn dig_rules() -> List<Rule> {
    return [rule("minecraft:block_drops", Tag.Byte(0)), rule("minecraft:spawn_mobs", Tag.Byte(0)), rule("minecraft:random_tick_speed", Tag.Int(0))]
}

/// The same with drops on, in `dig_drops` (CAL-153).
pub fn dig_drop_rules() -> List<Rule> {
    return dig_rules()[1..3]
}

/// The use_items rules: the dig configurations', and no natural regeneration, so the bot's food
/// stays where the cake it eats puts it (CAL-142).
pub fn use_items_rules() -> List<Rule> {
    var out = dig_rules()
    out.push(rule("minecraft:natural_health_regeneration", Tag.Byte(0)))
    return out
}

/// No natural spawning, as `terrain` has it (D338).
pub fn no_spawning() -> List<Rule> {
    return [rule("minecraft:spawn_mobs", Tag.Byte(0))]
}

/// No natural spawning and no advancement messages (CAL-158).
pub fn quiet() -> List<Rule> {
    return [rule("minecraft:spawn_mobs", Tag.Byte(0)), rule("minecraft:show_advancement_messages", Tag.Byte(0))]
}

/// `quiet`'s, and a respawn at the spawn itself.
pub fn quiet_respawn() -> List<Rule> {
    var out = quiet()
    out.push(rule("minecraft:respawn_radius", Tag.Int(0)))
    return out
}

/// The bot's data in `place`: in survival mode at the spawn, facing south, holding the first of
/// the hotbar's stone, oak stairs, slabs, logs, doors, a red bed, torches, oak fences and a
/// furnace, with cobblestone in its offhand (D378).
pub fn place() -> Tag {
    let items = [
        slotted(0, "stone", 64, ""),
        slotted(1, "oak_stairs", 8, ""),
        slotted(2, "oak_slab", 8, ""),
        slotted(3, "oak_log", 8, ""),
        slotted(4, "oak_door", 4, ""),
        slotted(5, "red_bed", 1, ""),
        slotted(6, "torch", 8, ""),
        slotted(7, "oak_fence", 8, ""),
        slotted(8, "furnace", 1, ""),
    ].join(", ")
    return snbt(#"{#{STANDING}, playerGameType: 0, SelectedItemSlot: 0, Inventory: [#{items}], equipment: {offhand: #{stack("cobblestone", 16, "")}}}"#)
}

/// `place`'s with these members.
fn placed(members: String) -> Tag {
    return with(place(), members)
}

const EAST: str = "Rotation: [-90.0f, 0.0f]"

/// In `place_creative`: in creative mode, with nothing, given each block's item as it goes.
pub fn place_creative() -> Tag {
    return placed(String("\{playerGameType: 1, Inventory: [], equipment: \{\}\}"))
}

/// In `zombie-head`: `place_creative`'s, wearing a zombie's head, which hides it from zombies to
/// half as far, `MOB_VISIBILITY` (CAL-159).
pub fn zombie_head() -> Tag {
    return with(place_creative(), "\{equipment: \{head: {stack("zombie_head", 1, "")}\}\}")
}

/// In `use`: in survival mode, with nothing in its hands (D379).
pub fn use_hands() -> Tag {
    return placed(String("\{Inventory: [], equipment: \{\}\}"))
}

/// In `use_items`: in survival mode, hungry, at 10 food, holding seeds, a cake, saplings, candles,
/// a water bucket, bottles, a dyed helmet, banners with two patterns and buckets (CAL-142).
pub fn use_items() -> Tag {
    let items = [
        slotted(0, "wheat_seeds", 4, ""),
        slotted(1, "cake", 1, ""),
        slotted(2, "oak_sapling", 2, ""),
        slotted(3, "red_candle", 2, ""),
        slotted(4, "water_bucket", 1, ""),
        slotted(5, "glass_bottle", 3, ""),
        slotted(6, "leather_helmet", 1, #"{"minecraft:dyed_color": 3368652}"#),
        slotted(7, "white_banner", 2, #"{"minecraft:banner_patterns": [{pattern: "minecraft:stripe_top", color: "red"}, {pattern: "minecraft:cross", color: "blue"}]}"#),
        slotted(8, "bucket", 2, ""),
    ].join(", ")
    return placed("\{Inventory: [{items}], equipment: \{\}, foodLevel: 10\}")
}

/// In `use_books`: in survival mode, holding a book and quill, two books, an enchanted book, stone
/// and dirt, with its sixth slot empty (CAL-142), and cat's record in the seventh, the last two
/// empty (CAL-143).
pub fn use_books() -> Tag {
    let items = [
        slotted(0, "writable_book", 1, ""),
        slotted(1, "book", 2, ""),
        slotted(2, "enchanted_book", 1, ""),
        slotted(3, "stone", 3, ""),
        slotted(4, "dirt", 1, ""),
        slotted(6, "music_disc_cat", 1, ""),
    ].join(", ")
    return placed("\{Inventory: [{items}], equipment: \{\}\}")
}

/// In `use_containers`: in survival mode, holding stone, with dirt in its hotbar's second slot
/// (CAL-144).
pub fn use_containers() -> Tag {
    return placed("\{Inventory: [{slotted(0, "stone", 10, "")}, {slotted(1, "dirt", 2, "")}], equipment: \{\}\}")
}

/// In `items`: in survival mode, holding stone, with dirt and an iron sword in the hotbar and oak
/// logs in the inventory's first slot, which it drops and throws, then picks up (CAL-148).
pub fn item_player() -> Tag {
    let held = [slotted(0, "stone", 64, ""), slotted(1, "dirt", 10, ""), slotted(2, "iron_sword", 1, ""), slotted(9, "oak_log", 5, "")].join(", ")
    return placed("\{Inventory: [{held}], equipment: \{\}\}")
}

/// `place`'s facing east, holding `held`, with nothing else on.
fn facing_east(held: String) -> Tag {
    return placed("\{{EAST}, Inventory: [{held}], equipment: \{\}\}")
}

