/// The bot's data in `arrows`: at the arrows fixture's spawn, the middle of chunk (0, 0), facing
/// east, in survival with nothing, so the arrow it picks up goes into its first slot (CAL-159).
pub fn arrows() -> Tag {
    return placed("\{Pos: [8.5d, -60.0d, 8.5d], {EAST}, Inventory: [], equipment: \{\}\}")
}

/// The bot's data in `dosed`: `arrows`', at half health, with effects saved on it (D514):
/// regeneration I for 120 ticks, which heals it at 100 and 50; poison I for 49, which hurts it at
/// 25, its 25th tick, after its client's loaded on both servers, which spare it till then;
/// resistance I for 300, which takes a fifth of the arrow's hurt; hunger II for 200; glowing for
/// 80; and night vision for ever, ambient, its particles hidden.
pub fn dosed() -> Tag {
    let effects = [
        effect("regeneration", 120, 0, []),
        effect("poison", 49, 0, []),
        effect("resistance", 300, 0, []),
        effect("hunger", 200, 1, []),
        effect("glowing", 80, 0, []),
        effect("night_vision", -1, 0, [("ambient", true), ("show_particles", false)]),
    ].join(", ")
    return with(arrows(), "\{Health: 10.0f, active_effects: [{effects}]\}")
}

/// The bot's data in `lifted`: `arrows`', with jump boost II and slow falling saved on it for 400
/// ticks (D515), so its jump's a fifth higher and it falls back slowly as the server moves it.
pub fn lifted() -> Tag {
    return with(arrows(), "\{active_effects: [{effect("jump_boost", 400, 1, [])}, {effect("slow_falling", 400, 0, [])}]\}")
}

/// The bot's data in `beacons`: `place`'s, at the beacons fixture's spawn, in creative mode with
/// nothing but stone in its first hotbar slot (D520).
pub fn beacons() -> Tag {
    return placed("\{Pos: [5.5d, -60.0d, 5.5d], playerGameType: 1, Inventory: [{slotted(0, "stone", 64, "")}], equipment: \{\}\}")
}

fn potions(item: str, names: List<str>) -> String {
    var out: List<String> = []
    for (i, name) in names.enumerate() {
        out.push(slotted(i64.wrap(i), item, 1, potion(name)))
    }
    return out.join(", ")
}

/// The bot's data in `splash`: `arrows`', in survival mode facing east, with splash potions of
/// poison, healing, regeneration, water and harming in its first five hotbar slots (D527).
pub fn splash() -> Tag {
    return with(arrows(), "\{Inventory: [{potions("splash_potion", ["poison", "healing", "regeneration", "water", "harming"])}]\}")
}

/// The bot's data in `linger`: `arrows`', in survival mode facing east, with lingering potions of
/// poison, healing, regeneration, harming and slowness in its first five hotbar slots (D529).
pub fn linger() -> Tag {
    return with(arrows(), "\{Inventory: [{potions("lingering_potion", ["poison", "healing", "regeneration", "harming", "slowness"])}]\}")
}

/// The bot's data in `beacon_menu`: `beacons`', in survival mode with an iron ingot, a gold ingot
/// and four emeralds in its first three hotbar slots (D521).
pub fn beacon_menu() -> Tag {
    return with(beacons(), "\{playerGameType: 0, Inventory: [{slotted(0, "iron_ingot", 1, "")}, {slotted(1, "gold_ingot", 1, "")}, {slotted(2, "emerald", 4, "")}]\}")
}

/// The bot's data in `eaten`: `arrows`', at 12 health, 2 food and no saturation, poisoned for 300
/// ticks, carrying apples, honey bottles, a potion of swiftness, milk, a golden apple, a
/// suspicious stew of night vision and a potion of healing in its hotbar, and bread in its off
/// hand (D519).
pub fn eaten() -> Tag {
    let items = [
        slotted(0, "apple", 3, ""),
        slotted(1, "honey_bottle", 2, ""),
        slotted(2, "potion", 1, potion("swiftness")),
        slotted(3, "milk_bucket", 1, ""),
        slotted(4, "golden_apple", 1, ""),
        slotted(5, "suspicious_stew", 1, #"{"minecraft:suspicious_stew_effects": [{id: "minecraft:night_vision", duration: 100}]}"#),
        slotted(6, "potion", 1, potion("healing")),
    ].join(", ")
    return with(arrows(), "\{Health: 12.0f, foodLevel: 2, foodSaturationLevel: 0.0f, Inventory: [{items}], equipment: \{offhand: {stack("bread", 1, "")}\}, active_effects: [{effect("poison", 300, 0, [])}]\}")
}

/// The bot's data in `undying`: `arrows`', at 1 health with a totem of undying in its off hand,
/// and swiftness and night vision saved on it, which the totem clears as it saves it (D518); 17
/// food and no saturation, so it doesn't heal before the arrow falls on it.
pub fn undying() -> Tag {
    let effects = "{effect("speed", 300, 0, [])}, {effect("night_vision", -1, 0, [("ambient", true), ("show_particles", false)])}"
    return with(arrows(), "\{Health: 1.0f, foodLevel: 17, foodSaturationLevel: 0.0f, equipment: \{offhand: {stack("totem_of_undying", 1, "")}\}, active_effects: [{effects}]\}")
}

