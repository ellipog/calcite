    return with(thorns(), "\{equipment: \{head: {stack("diamond_helmet", 1, p)}, chest: {stack("diamond_chestplate", 1, p)}, legs: {stack("diamond_leggings", 1, p)}, feet: {stack("diamond_boots", 1, p)}\}\}")
}

/// The bot's data in `zombie-thorns`: `slime`'s, its chestplate with thorns III, which hurts a mob
/// that hits it now and then and wears as it does (CAL-159).
pub fn thorny() -> Tag {
    return with(thorns(), "\{equipment: \{head: {stack("iron_helmet", 1, "")}, chest: {stack("iron_chestplate", 1, enchanted("thorns", 3))}, legs: {stack("iron_leggings", 1, "")}, feet: {stack("iron_boots", 1, "")}\}\}")
}

/// The bot's data in `bane`: `thorns`', holding an iron sword with bane of arthropods I (D512).
pub fn bane() -> Tag {
    return with(thorns(), "\{Inventory: [{slotted(0, "iron_sword", 1, enchanted("bane_of_arthropods", 1))}]\}")
}

