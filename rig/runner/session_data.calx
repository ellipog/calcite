    return with(thorns(), "\{equipment: \{head: {stack("iron_helmet", 1, "")}, chest: {stack("iron_chestplate", 1, "")}, legs: {stack("iron_leggings", 1, "")}, feet: {stack("iron_boots", 1, "")}\}\}")
}

/// The bot's data in `zombie-sword`: `thorns`', in diamond armor with protection IV on each piece,
/// so Rot's sword, its sharpness and its fire leave it alive till it leaves (CAL-159).
pub fn knight() -> Tag {
