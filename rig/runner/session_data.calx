pub fn thorns_sword() -> Tag {
    return with(thorns(), "\{Health: 10.0f, Inventory: [{slotted(0, "iron_sword", 1, enchanted("unbreaking", 3))}, {slotted(1, "bread", 3, "")}]\}")
}

/// The bot's data in `duel`: in survival mode at the spawn, facing east, an iron sword in its
/// first slot and nothing in its second (CAL-162).
pub fn duel() -> Tag {
    return facing_east(slotted(0, "iron_sword", 1, ""))
}

/// Mate's in `duel`: two blocks east of the bot, facing west, with nothing, at 17 food, so it
/// doesn't heal as it's hit (CAL-162).
pub fn duel_mate() -> Tag {
    return placed(String("\{Pos: [2.5d, -60.0d, 0.5d], Rotation: [90.0f, 0.0f], Inventory: [], equipment: \{\}, foodLevel: 17\}"))
}

/// The bot's data in `enchant`: in survival mode at the spawn, facing east, holding an iron sword
/// with smite V, with a wooden sword with sharpness I and knockback II in the second slot and one
/// with fire aspect II in the third (D438).
pub fn enchant() -> Tag {
    let held = [
        slotted(0, "iron_sword", 1, enchanted("smite", 5)),
        slotted(1, "wooden_sword", 1, #"{"minecraft:enchantments": {"minecraft:sharpness": 1, "minecraft:knockback": 2}}"#),
        slotted(2, "wooden_sword", 1, enchanted("fire_aspect", 2)),
    ].join(", ")
    return facing_east(held)
}

/// The bot's data in `fall`: in survival mode on the fall fixture's pillar, facing east, holding
/// an iron sword (D418).
pub fn fall() -> Tag {
    return placed("\{Pos: [0.5d, -30.0d, 0.5d], {EAST}, Inventory: [{slotted(0, "iron_sword", 1, "")}], equipment: \{\}\}")
}

/// The bot's data in `fall-armored`: `fall`'s, in diamond boots with feather falling IV and an
/// iron chestplate with protection IV, which take their shares of its falls (D439).
pub fn fall_armored() -> Tag {
    return with(fall(), "\{equipment: \{feet: {stack("diamond_boots", 1, enchanted("feather_falling", 4))}, chest: {stack("iron_chestplate", 1, enchanted("protection", 4))}\}\}")
}

/// What `fall` compares of the bot's saved data besides: its health and absorption, its food, its
/// motion and its fall (D418).
pub fn fall_keys() -> List<String> {
    return [String("Health"), String("AbsorptionAmount"), String("foodLevel"), String("foodSaturationLevel"), String("foodExhaustionLevel"), String("foodTickTimer"), String("Motion"), String("fall_distance")]
}

/// The bot's data in `mace`: in survival mode on the mace fixture's pillar, facing east, holding a
/// mace with density III and breach IV (D443).
pub fn mace() -> Tag {
    let held = slotted(0, "mace", 1, #"{"minecraft:enchantments": {"minecraft:density": 3, "minecraft:breach": 4}}"#)
    return placed("\{Pos: [0.5d, -48.0d, 0.5d], {EAST}, Inventory: [{held}], equipment: \{\}\}")
}

/// The bot's data in `mace-wind`: `mace`'s, the mace with wind burst III instead (CAL-182).
pub fn mace_wind() -> Tag {
    let held = slotted(0, "mace", 1, #"{"minecraft:enchantments": {"minecraft:wind_burst": 3}}"#)
    return placed("\{Pos: [0.5d, -48.0d, 0.5d], {EAST}, Inventory: [{held}], equipment: \{\}\}")
}

/// What `mace` compares of the bot's saved data besides `fall`'s: its impulse, its grace and where
/// it was given, and whether its next landing throws up a smash's dust (D443).
pub fn mace_keys() -> List<String> {
    var out = fall_keys()
    out.extend([String("current_impulse_context_reset_grace_time"), String("current_explosion_impact_pos"), String("spawn_extra_particles_on_fall")])
    return out
}

/// The bot's data in `swim`: in survival mode at the spawn, facing east and a little down, holding
/// eight loaves of bread (D444).
pub fn swim() -> Tag {
    return placed("\{Rotation: [-90.0f, 20.0f], Inventory: [{slotted(0, "bread", 8, "")}], equipment: \{\}\}")
}

/// The bot's data in `checks`: in survival mode at the spawn, facing east, its hands empty (D420).
pub fn checks() -> Tag {
    return placed("\{{EAST}, Inventory: [], equipment: \{\}\}")
}

/// The bot's data in `frost`: `checks`', in diamond boots with frost walker II (D524).
pub fn frost() -> Tag {
    return with(checks(), "\{equipment: \{feet: {stack("diamond_boots", 1, enchanted("frost_walker", 2))}\}\}")
}

/// The bot's data in `soul`: on the soul fixture's soul sand, facing east, in diamond boots with
/// soul speed III (D525).
pub fn soul() -> Tag {
    return with(checks(), "\{Pos: [3.5d, -60.125d, 0.5d], equipment: \{feet: {stack("diamond_boots", 1, enchanted("soul_speed", 3))}\}\}")
}

/// The bot's data in `night`: in creative mode at the spawn, so the monsters that spawn don't make
/// for it (CAL-156).
pub fn night() -> Tag {
    return snbt(String(#"{DataVersion: 5023, Pos: [0.5d, -63.0d, 0.5d], Rotation: [0.0f, 0.0f], Dimension: "minecraft:overworld", playerGameType: 1}"#))
}

/// The bot's data in `end` (D586): in survival mode at the spawn, hurt and hungry, fast for a
/// while, holding a stone, all of which the respawn after the End's credits keeps.
pub fn end_player() -> Tag {
    let speed = #"{id: "minecraft:speed", amplifier: 0b, duration: 4000, ambient: 0b, show_particles: 1b, show_icon: 1b}"#
    return snbt(#"{#{STANDING}, playerGameType: 0, Health: 15.0f, foodLevel: 15, Inventory: [{Slot: 0b, id: "minecraft:stone", count: 5}], active_effects: [#{speed}]}"#)
}

/// The bot's data in `choke`: in survival mode at the bottom of the choke fixture's water, out of
/// air, starving, its food's timer at 30, with 100 health, which it has room for (D426).
pub fn choke() -> Tag {
    return snbt(String(#"{DataVersion: 5023, Pos: [4.5d, -60.0d, 4.5d], Rotation: [0.0f, 0.0f], Dimension: "minecraft:overworld", playerGameType: 0, Air: 0s, foodLevel: 0, foodSaturationLevel: 0.0f, foodTickTimer: 30, Health: 100.0f, attributes: [{id: "minecraft:max_health", base: 100.0d}]}"#))
}

/// The same at the spawn, its eyes in the buried fixture's stone, its air and food full (D426).
pub fn buried() -> Tag {
    return with(choke(), String("\{Pos: [0.5d, -60.0d, 0.5d], Air: 300s, foodLevel: 20, foodTickTimer: 0\}"))
}

/// What `choke` compares of the bot's saved data besides: `fall`'s, and its air (D426).
pub fn hurt_keys() -> List<String> {
    var out = fall_keys()
    out.push(String("Air"))
    return out
}

/// What `buried` does: the same but its health. Its hurts start as its client says it's loaded,
/// once the bot has its chunks, which Calcite sends sooner, so its last hurt can fall either side
/// of the bot's leave, as its first's tick does (D426).
pub fn buried_keys() -> List<String> {
    var out: List<String> = []
    for k in hurt_keys() {
        if k != "Health" {
            out.push(k.copy())
        }
    }
    return out
}

/// The bot's data in `death`: `buried`'s with 2 health, so the wall's second hurt kills it, stacks
/// in the hotbar, the inventory's own slots and the offhand, armor, a stack in the inventory and
/// the helmet cursed with vanishing, and 3 levels (D427).
pub fn death() -> Tag {
    let vanishing = enchanted("vanishing_curse", 1)
    let items = [
        slotted(0, "stone", 64, ""),
        slotted(4, "diamond_sword", 1, enchanted("sharpness", 3)),
        slotted(9, "bread", 7, ""),
        slotted(20, "golden_apple", 2, vanishing.copy()),
        slotted(35, "oak_log", 10, ""),
    ].join(", ")
    let equipment = "head: {stack("iron_helmet", 1, vanishing)}, chest: {stack("leather_chestplate", 1, "")}, feet: {stack("leather_boots", 1, "")}, offhand: {stack("torch", 32, "")}"
    return with(buried(), "\{Health: 2.0f, XpLevel: 3, SelectedItemSlot: 4, Inventory: [{items}], equipment: \{{equipment}\}\}")
}

/// What `death` compares: `buried`'s, its health, full once it's respawned, its levels, which it
/// loses as it respawns, where it died, and how long it's been dead, none once it's back (D427,
/// D428).
pub fn death_keys() -> List<String> {
    var out = buried_keys()
    out.extend([String("Health"), String("XpLevel"), String("LastDeathLocation"), String("DeathTime")])
    return out
}

/// The bot's data in `magma`: in survival mode on the magma at the spawn, its hands empty, in iron
/// boots three wears from breaking, leather leggings with unbreaking, a netherite chestplate,
/// which fire doesn't wear, and a golden helmet (D431); with `feet` for its boots, if it isn't
/// empty, as `magma-frost` and `magma-fireproof` give it.
fn magma_with(feet: String) -> Tag {
    let boots = if feet.is_empty() { stack("iron_boots", 1, #"{"minecraft:damage": 192}"#) } else { feet.copy() }
    return placed("\{Inventory: [], equipment: \{feet: {boots}, legs: {stack("leather_leggings", 1, enchanted("unbreaking", 3))}, chest: {stack("netherite_chestplate", 1, "")}, head: {stack("golden_helmet", 1, "")}\}\}")
}

pub fn magma() -> Tag {
    return magma_with(String(""))
}

/// The bot's data in `magma-frost`: `magma`'s, its boots diamond with frost walker II, which make
/// it immune to the magma's burn (D439).
pub fn magma_frost() -> Tag {
    return magma_with(stack("diamond_boots", 1, enchanted("frost_walker", 2)))
}

/// And in `magma-fireproof`, leather with fire protection IV, which take their share of each burn
/// (D439).
pub fn magma_fireproof() -> Tag {
    return magma_with(stack("leather_boots", 1, enchanted("fire_protection", 4)))
}
