module rig.runner.savediff

// What two servers saved of the same chunks, compared (CAL-145): each block's state, each block
// entity, the block and fluid ticks waiting, the heightmaps and the light, as vanilla's
// `SerializableChunkData` writes them, read back from the worlds' region files.
//
//     calx rig/runner/savediff.calx VANILLA_WORLD CALCITE_WORLD [X0 Z0 X1 Z1]
//
// A section's palette and the bits it packs its states in depend on the order its blocks were set
// in, so states are compared block by block, not as bytes; a block entity is compared by its
// position, as a compound, and the ticks as sets, since each server keeps them in its own order,
// each by the game time it's due. What each saves of when it saved, `LastUpdate`, and how long
// players were near, `InhabitedTime`, aren't compared: the bot's steps land on different game
// times on the two servers.
//
// The entity chunks, in `entities/`, are compared too (CAL-148): each chunk's entities in the
// order it saved them, by their UUIDs, and each entity's tags, but those that tell when the server
// stopped, `ENTITY_TIMING`: an item's or an ageable mob's age, and its motion, which a still item
// gathers as it falls 0.04 a tick between the moves it makes every 4 ticks; and a chicken's ticks
// until it lays, which count down a tick at a time (CAL-156). A living entity's attributes are
// compared in any order, `UNORDERED`, as vanilla's order changes from run to run.
//
// So are the POI chunks, in `poi/` (CAL-160): which chunks each saved, each chunk's sections in the
// order it saved them, and each section's `Valid` and its records, in order, each record's place,
// type and tickets free.
//
// Tags compare as the first version of this, savediff.py, compared what rig/runner/nbt.py read
// them as, and its messages quote them as Python's `repr` did (tools/pynbt.calx). std.nbt reads
// a list of several kinds unwrapped, as vanilla does, where nbt.py kept each element's `{"": ...}`.

import std.env.{args}
import std.fs.{glob, read}
import std.nbt.{NbtFile, Tag}
import std.path
import tools.pynbt.{cut, elements, py_repr, py_repr_or_none, py_str, py_str_or_none, repr_strings, same, same_or_none}
import tools.repo.{die}

// The chunk keys left out: what isn't here, and isn't compared on its own below, is compared as
// it is.
const LEFT_OUT: [str; 10] = ["LastUpdate", "InhabitedTime", "xPos", "zPos", "yPos", "DataVersion", "sections", "block_entities", "block_ticks", "fluid_ticks"]
// An entity's tags that tell when the server stopped (CAL-148).
const ENTITY_TIMING: [str; 3] = ["Age", "Motion", "EggLayTime"]
// An entity's lists in an order no server keeps (CAL-156): a living entity's attributes, which
// vanilla saves as its `AttributeMap`'s hash map of holders gives them, by identity hashes that
// differ from run to run, and its effects, as its `activeEffects`' hash map of holders gives them
// (D513); compared as sets.
const UNORDERED: [str; 2] = ["attributes", "active_effects"]

fn among<const N: usize>(name: String, names: [str; N]) -> bool {
    for k in names {
        if name == k {
            return true
        }
    }
    return false
}

/// Member `key` of a compound, or none.
fn member(t: Tag, key: str) -> Tag? {
    return t.get(String(key))
}

/// A compound's member that's a list, its elements, or none if it has none.
fn listed(t: Tag, key: str) -> List<Tag> {
    if let x = member(t, key) {
        return elements(x) ?? die("savediff: `{key}` isn't a list")
    }
    return []
}

fn whole(t: Tag) -> i64 {
    if let i = t.as_int() {
        return i
    }
    if let f = t.as_float() {
        return i64.saturate(f)
    }
    if let s = t.as_str() {
        return i64.parse(s.trim()) ?? die("savediff: invalid literal for int(): {py_repr(t)}")
    }
    return die("savediff: int() can't convert {py_repr(t)}")
}

/// Each chunk the world's region files of `dimension` hold, by its position, as a compound: its
/// blocks', or, with `folder` "entities", its entities', or with "poi", its points of interest.
pub fn chunks(world: String, dimension: String, folder: String) -> Map<(i64, i64), Tag> {
    var out = Map<(i64, i64), Tag>()
    let dir = path.join(path.join(path.join(world, "dimensions"), dimension), folder)
    let found = match glob(path.join(dir, "r.*.*.mca")) {
        ok(fs) => fs,
        err(e) => die("savediff: {e}"),
    }
    for region in found {
        let data = match read(region.copy()) {
            ok(d) => d,
            err(e) => die("savediff: {region}: {e}"),
        }
        if data.len() < 8192 {
            continue
        }
        let name = path.file_name(region.copy()) ?? region.copy()
        let parts = name.split(".")
        if parts.len() != 4 {
            continue
        }
        let rx = i64.parse(parts[1].copy()) ?? die("savediff: {name} isn't a region file's name")
        let rz = i64.parse(parts[2].copy()) ?? die("savediff: {name} isn't a region file's name")
        for i in 0..1024usize {
            let sector = (usize(data[i * 4]) << 16) | (usize(data[i * 4 + 1]) << 8) | usize(data[i * 4 + 2])
            if sector == 0 {
                continue
            }
            let at = sector * 4096
            let length = (usize(data[at]) << 24) | (usize(data[at + 1]) << 16) | (usize(data[at + 2]) << 8) | usize(data[at + 3])
            let kind = data[at + 4]
            if kind != 2 {
                die("savediff: {name} keeps chunk {i} compressed as {kind}, not zlib")
            }
            let file = match NbtFile.decode(data[at + 5..at + 4 + length]) {
                ok(f) => f,
                err(e) => die("savediff: {name}, chunk {i}: {e}"),
            }
            out.insert((rx * 32 + i64.wrap(i % 32), rz * 32 + i64.wrap(i / 32)), file.root)
        }
    }
    return out
}

/// A palette entry as `name[key=value,...]`, its properties in their names' order. 26.3 writes a
/// state with no properties as its name alone, and one with them as `id` and `properties`.
fn state_name(entry: Tag) -> String {
    if let Tag.Compound(m) = entry {
        if let x = m.find(String("")) {
            return py_str(x)
        }
        let name = py_str_or_none(member(entry, "id") ?? member(entry, "Name"))
        let props = member(entry, "properties") ?? member(entry, "Properties") ?? Tag.Compound(LinkedMap<String, Tag>())
        var keys = props.keys()
        if keys.is_empty() {
            return name
        }
        keys.sort()
        var parts: List<String> = []
        for k in keys {
            parts.push("{k}={py_str_or_none(props.get(k.copy()))}")
        }
        return "{name}[{parts.join(",")}]"
    }
    return py_str(entry)
}

/// A paletted container's `size` entries, each its palette entry's index, as `SimpleBitStorage`
/// packs them: as few bits as the palette needs, at least `least`, none across two longs.
fn indices(data: List<i64>, palette_len: usize, size: usize, least: u32) -> List<usize> {
    var needed = 0u32
    var n = if palette_len > 0 { palette_len - 1 } else { 1 }
    while n > 0 {
        needed += 1
        n >>= 1
    }
    let bits = if needed > least { needed } else { least }
    let per = usize(64 / bits)
    let mask = (1u64 << u64(bits)) - 1
    var out: List<usize> = []
    for i in 0..size {
        let word = u64.wrap(data[i / per])
        out.push(usize.wrap((word >> u64((i % per) * usize(bits))) & mask))
    }
    return out
}

/// A section's 4096 states, as names, by `y * 256 + z * 16 + x`.
fn section_states(section: Tag) -> List<String> {
    let container = member(section, "block_states") ?? air_states()
    let palette = listed(container, "palette")
    var names: List<String> = []
    for p in palette {
        names.push(state_name(p))
    }
    var data: List<i64> = []
    if let d = member(container, "data") {
        for x in elements(d) ?? List<Tag>() {
            data.push(x.as_int() ?? die("savediff: a section's data isn't numbers"))
        }
    }
    var out: List<String> = []
    if data.is_empty() {
        let first = if names.is_empty() { die("savediff: a section with an empty palette and no data") } else { names[0].copy() }
        for _ in 0..4096 {
            out.push(first.copy())
        }
        return out
    }
    for i in indices(data, palette.len(), 4096, 4) {
        out.push(names[i].copy())
    }
    return out
}

/// A chunk's block entities by position, each without its position.
fn block_entities(chunk: Tag) -> Map<(i64, i64, i64), Tag> {
    var out = Map<(i64, i64, i64), Tag>()
    for be in listed(chunk, "block_entities") {
        let x = whole(member(be, "x") ?? die("savediff: a block entity without x"))
        let y = whole(member(be, "y") ?? die("savediff: a block entity without y"))
        let z = whole(member(be, "z") ?? die("savediff: a block entity without z"))
        var rest = LinkedMap<String, Tag>()
        if let Tag.Compound(m) = be {
            for (k, v) in m {
                if k != "x" and k != "y" and k != "z" {
                    rest.insert(k.copy(), v.copy())
                }
            }
        }
        out.insert((x, y, z), Tag.Compound(rest))
    }
    return out
}

/// One tick, as its keys and values written as Python's `str`, sorted by key, and a key it's
/// known by in a set.
struct Tick {
    pairs: List<(String, String)>
    key: String
}

/// Whether tick `a` sorts before `b`, as Python sorts their tuples.
fn tick_before(a: Tick, b: Tick) -> bool {
    let n = if a.pairs.len() < b.pairs.len() { a.pairs.len() } else { b.pairs.len() }
    for i in 0..n {
        if a.pairs[i].0 != b.pairs[i].0 {
            return a.pairs[i].0 < b.pairs[i].0
        }
        if a.pairs[i].1 != b.pairs[i].1 {
            return a.pairs[i].1 < b.pairs[i].1
        }
    }
    return a.pairs.len() < b.pairs.len()
}

/// A chunk's ticks of `key`, as a set: each one's delay, `t`, as the game time it's due, from when
/// the chunk was saved, `LastUpdate`, as the two servers may stop and save a tick apart, the same
/// tick due 17 ticks after one's save and 18 after the other's (CAL-164).
fn ticks(chunk: Tag, key: str) -> List<Tick> {
    let saved = if let s = member(chunk, "LastUpdate") { whole(s) } else { 0 }
    var out: List<Tick> = []
    var seen = Set<String>()
    for tick in listed(chunk, key) {
        var pairs: List<(String, String)> = []
        if let Tag.Compound(m) = tick {
            for (k, v) in m {
                if k == "t" {
                    pairs.push((k.copy(), "{whole(v) + saved}"))
                } else {
                    pairs.push((k.copy(), py_str(v)))
                }
            }
        }
        for i in 1..pairs.len() {
            var at = i
            while at > 0 and pairs[at - 1].0 > pairs[at].0 {
                pairs.swap(at - 1, at)
                at -= 1
            }
        }
        var key_text = String()
        for (k, v) in pairs {
            key_text.push_str("{k.len()}:{k}{v.len()}:{v};")
        }
        if not seen.contains(key_text.copy()) {
            seen.insert(key_text.copy())
            out.push(Tick { pairs: pairs, key: key_text })
        }
    }
    return out
}

/// The ticks of `a` that `b` hasn't, sorted.
fn only(a: List<Tick>, b: List<Tick>) -> List<Tick> {
    var theirs = Set<String>()
    for t in b {
        theirs.insert(t.key.copy())
    }
    var out: List<Tick> = []
    for t in a {
        if not theirs.contains(t.key.copy()) {
            out.push(t.copy())
        }
    }
    for i in 1..out.len() {
        var at = i
        while at > 0 and tick_before(out[at], out[at - 1]) {
            out.swap(at - 1, at)
            at -= 1
        }
    }
    return out
}

/// A layer's place: its section and its name.
struct Layer {
    y: i64
    name: String
}

/// A chunk's light by section and layer. The sky layer of 2048 bytes of 0 of the section below
/// the world, `bottom`, is left out, as none: vanilla's light gives it to the first chunk it sets
/// up in a batch, `repeatFirstLayer`, and none to the rest, by which of its workers finishes first
/// (rig/README.md, "The sky under the world").
fn light(chunk: Tag, bottom: i64?) -> LinkedMap<String, (Layer, Tag)> {
    var out = LinkedMap<String, (Layer, Tag)>()
    for s in listed(chunk, "sections") {
        for layer in ["BlockLight", "SkyLight"] {
            let values = member(s, layer) else {
                continue
            }
            let y = whole(member(s, "Y") ?? die("savediff: a section without Y"))
            if layer == "SkyLight" and bottom == some(y) and not any(values) {
                continue
            }
            out.insert("{y} {layer}", (Layer { y: y, name: String(layer) }, values))
        }
    }
    return out
}

/// Whether any of a layer's values isn't 0, as Python's `any`.
fn any(values: Tag) -> bool {
    if let Tag.ByteArray(xs) = values {
        for x in xs {
            if x != 0 {
                return true
            }
        }
        return false
    }
    for x in elements(values) ?? List<Tag>() {
        if let i = x.as_int() {
            if i != 0 {
                return true
            }
        } else if let f = x.as_float() {
            if f != 0.0 {
                return true
            }
        } else {
            return true
        }
    }
    return false
}

/// The differences between the chunks in `area`, `(x0, z0, x1, z1)` inclusive, as each world saved
/// them, as lines: none if they're the same.
pub fn compare(vanilla_world: String, calcite_world: String, area: (i64, i64, i64, i64), show: usize) -> List<String> {
    let v = chunks(vanilla_world.copy(), String("minecraft/overworld"), String("region"))
    let c = chunks(calcite_world.copy(), String("minecraft/overworld"), String("region"))
    var lines: List<String> = []
    let (x0, z0, x1, z1) = area
    for cx in x0..=x1 {
        for cz in z0..=z1 {
            let a = chunk_at(v, (cx, cz))
            let b = chunk_at(c, (cx, cz))
            if let x = a {
                if let y = b {
                    for d in chunk_differences(cx, cz, x, y, show) {
                        lines.push("chunk {cx}, {cz}: {d}")
                    }
                } else {
                    lines.push("chunk {cx}, {cz}: only vanilla saved it")
                }
            } else if b != none {
                lines.push("chunk {cx}, {cz}: only Calcite saved it")
            }
        }
    }
    lines.extend(entity_differences(vanilla_world.copy(), calcite_world.copy(), area))
    lines.extend(poi_differences(vanilla_world, calcite_world, area))
    return lines
}

/// An entity's UUID, its four ints.
fn uuid_of(entity: Tag) -> List<i64> {
    var out: List<i64> = []
    for x in listed(entity, "UUID") {
        out.push(x.as_int() ?? die("savediff: a UUID that isn't numbers"))
    }
    return out
}

fn ids(entities: List<Tag>) -> String {
    var parts: List<String> = []
    for e in entities {
        if let id = member(e, "id") {
            parts.push(py_repr(id))
        } else {
            parts.push(String("None"))
        }
    }
    return "[{parts.join(", ")}]"
}

/// The `repr` of each of a value's elements, sorted, as `sorted(map(repr, value))`.
fn reprs(value: Tag?) -> List<String> {
    var out: List<String> = []
    if let v = value {
        if let Tag.Compound(m) = v {
            for (k, _) in m {
                out.push(py_repr(Tag.String(k.copy())))
            }
        } else {
            for x in elements(v) ?? die("savediff: {py_repr(v)} isn't a list") {
                out.push(py_repr(x))
            }
        }
    }
    out.sort()
    return out
}

/// The entities a chunk of `chunks` holds, or none.
fn entities_at(saved: Map<(i64, i64), Tag>, at: (i64, i64)) -> List<Tag> {
    if let c = saved.find(at) {
        return listed(c, "Entities")
    }
    return []
}

/// The differences between the entity chunks in `area` as each world saved them (CAL-148).
fn entity_differences(vanilla_world: String, calcite_world: String, area: (i64, i64, i64, i64)) -> List<String> {
    let v = chunks(vanilla_world, String("minecraft/overworld"), String("entities"))
    let c = chunks(calcite_world, String("minecraft/overworld"), String("entities"))
    var lines: List<String> = []
    let (x0, z0, x1, z1) = area
    for cx in x0..=x1 {
        for cz in z0..=z1 {
            let a = entities_at(v, (cx, cz))
            let b = entities_at(c, (cx, cz))
            var ua: List<List<i64>> = []
            for e in a {
                ua.push(uuid_of(e))
            }
            var ub: List<List<i64>> = []
            for e in b {
                ub.push(uuid_of(e))
            }
            if ua != ub {
                lines.push("entities {cx}, {cz}: {a.len()} of vanilla's, {ids(a)}, vs {b.len()} of Calcite's, {ids(b)}")
                continue
            }
            for k in 0..a.len() {
                let ea = a[k].copy()
                let eb = b[k].copy()
                let id = py_str_or_none(member(ea, "id"))
                var keys: List<String> = []
                for key in ea.keys() {
                    if not among(key.copy(), ENTITY_TIMING) {
                        keys.push(key.copy())
                    }
                }
                for key in eb.keys() {
                    if not among(key.copy(), ENTITY_TIMING) and not keys.contains(key.copy()) {
                        keys.push(key.copy())
                    }
                }
                keys.sort()
                for key in keys {
                    let x = ea.get(key.copy())
                    let y = eb.get(key.copy())
                    let differs = if among(key.copy(), UNORDERED) { reprs(x.copy()) != reprs(y.copy()) } else { not same_or_none(x.copy(), y.copy()) }
                    if differs {
                        lines.push("entities {cx}, {cz}: {id} {key}: {cut(py_repr_or_none(x), 200)} vs {cut(py_repr_or_none(y), 200)}")
                    }
                }
                if ea.keys() != eb.keys() {
                    lines.push("entities {cx}, {cz}: {id}'s tags in another order: {repr_strings(ea.keys())} vs {repr_strings(eb.keys())}")
                }
            }
        }
    }
    return lines
}

/// The differences between the POI chunks in `area` as each world saved them (CAL-160).
fn poi_differences(vanilla_world: String, calcite_world: String, area: (i64, i64, i64, i64)) -> List<String> {
    let v = chunks(vanilla_world, String("minecraft/overworld"), String("poi"))
    let c = chunks(calcite_world, String("minecraft/overworld"), String("poi"))
    var lines: List<String> = []
    let (x0, z0, x1, z1) = area
    for cx in x0..=x1 {
        for cz in z0..=z1 {
            let a = chunk_at(v, (cx, cz))
            let b = chunk_at(c, (cx, cz))
            let x = a else {
                if b != none {
                    lines.push("poi {cx}, {cz}: only Calcite saved it")
                }
                continue
            }
            let y = b else {
                lines.push("poi {cx}, {cz}: only vanilla saved it")
                continue
            }
            let sa = member(x, "Sections") ?? Tag.Compound(LinkedMap<String, Tag>())
            let sb = member(y, "Sections") ?? Tag.Compound(LinkedMap<String, Tag>())
            if sa.keys() != sb.keys() {
                lines.push("poi {cx}, {cz}: sections {repr_strings(sa.keys())} vs {repr_strings(sb.keys())}")
                continue
            }
            for key in sa.keys() {
                let p = sa.get(key.copy()) ?? Tag.End
                let q = sb.get(key.copy()) ?? Tag.End
                if not same(p, q) {
                    lines.push("poi {cx}, {cz}: section {key}: {cut(py_repr(p), 300)} vs {cut(py_repr(q), 300)}")
                } else if p.keys() != q.keys() {
                    lines.push("poi {cx}, {cz}: section {key}'s tags in another order: {repr_strings(p.keys())} vs {repr_strings(q.keys())}")
                }
            }
        }
    }
    return lines
}

/// A chunk's sections by their Y, the last of a Y where two share one.
fn sections_by_y(chunk: Tag) -> Map<i64, Tag> {
    var out = Map<i64, Tag>()
    for s in listed(chunk, "sections") {
        out.insert(whole(member(s, "Y") ?? die("savediff: a section without Y")), s.copy())
    }
    return out
}

fn union_sorted<K: Order + Copy>(a: List<K>, b: List<K>) -> List<K> {
    var out: List<K> = a.copy()
    for k in b {
        if not out.contains(k) {
            out.push(k)
        }
    }
    out.sort()
    return out
}

/// What differs between chunk `cx`, `cz` as vanilla saved it, `a`, and as Calcite did, `b`, with
/// `show` of the blocks that differ named.
pub fn chunk_differences(cx: i64, cz: i64, a: Tag, b: Tag, show: usize) -> List<String> {
    var out: List<String> = []
    let sa = sections_by_y(a)
    let sb = sections_by_y(b)
    var ys_a: List<i64> = []
    for (y, _) in sa {
        ys_a.push(y)
    }
    var ys_b: List<i64> = []
    for (y, _) in sb {
        ys_b.push(y)
    }
    let empty = Tag.Compound(LinkedMap<String, Tag>())
    var blocks = 0usize
    for y in union_sorted(ys_a.copy(), ys_b.copy()) {
        let na = section_states(section_at(sa, y) ?? empty.copy())
        let nb = section_states(section_at(sb, y) ?? empty.copy())
        for i in 0..4096usize {
            if na[i] != nb[i] {
                blocks += 1
                if blocks <= show {
                    let x = cx * 16 + i64.wrap(i % 16)
                    let yy = y * 16 + i64.wrap(i / 256)
                    let z = cz * 16 + i64.wrap((i / 16) % 16)
                    out.push("block {x}, {yy}, {z}: {na[i]} vs {nb[i]}")
                }
            }
        }
    }
    if blocks > show {
        out.push("{blocks - show} more blocks differ")
    }
    let ea = block_entities(a)
    let eb = block_entities(b)
    var places_a: List<(i64, i64, i64)> = []
    for (p, _) in ea {
        places_a.push(p)
    }
    var places_b: List<(i64, i64, i64)> = []
    for (p, _) in eb {
        places_b.push(p)
    }
    for pos in union_sorted(places_a, places_b) {
        let x = entity_at(ea, pos)
        let y = entity_at(eb, pos)
        if not same_or_none(x.copy(), y.copy()) {
            out.push("block entity {pos.0}, {pos.1}, {pos.2}: {cut(py_repr_or_none(x), 300)} vs {cut(py_repr_or_none(y), 300)}")
        }
    }
    for key in ["block_ticks", "fluid_ticks"] {
        let ta = ticks(a, key)
        let tb = ticks(b, key)
        let only_a = only(ta, tb)
        let only_b = only(tb, ta)
        if not only_a.is_empty() or not only_b.is_empty() {
            out.push("{key}: {only_a.len()} only vanilla's, {only_b.len()} only Calcite's")
            for (side, ts) in [(String("vanilla's"), only_a), (String("Calcite's"), only_b)] {
                for k in 0..ts.len() {
                    if k < 3 {
                        var parts: List<String> = []
                        for (name, v) in ts[k].pairs {
                            parts.push("{name} {v}")
                        }
                        out.push("  only {side}: {parts.join(", ")}")
                    }
                }
            }
        }
    }
    var keys: List<String> = []
    for k in a.keys() {
        if not among(k.copy(), LEFT_OUT) {
            keys.push(k.copy())
        }
    }
    for k in b.keys() {
        if not among(k.copy(), LEFT_OUT) and not keys.contains(k.copy()) {
            keys.push(k.copy())
        }
    }
    keys.sort()
    for key in keys {
        let x = a.get(key.copy())
        let y = b.get(key.copy())
        if not same_or_none(x.copy(), y.copy()) {
            out.push("{key}: {cut(py_repr_or_none(x), 200)} vs {cut(py_repr_or_none(y), 200)}")
        }
    }
    var bottom: i64? = none
    for y in union_sorted(ys_a, ys_b) {
        if bottom == none {
            bottom = some(y)
        }
    }
    let la = light(a, bottom)
    let lb = light(b, bottom)
    var lit: List<Layer> = []
    var names: List<String> = []
    for (k, _) in la {
        names.push(k.copy())
    }
    for (k, _) in lb {
        if not la.contains(k.copy()) {
            names.push(k.copy())
        }
    }
    for k in names {
        if let p = la.find(k.copy()) {
            if let q = lb.find(k.copy()) {
                if not same(p.1, q.1) {
                    lit.push(p.0.copy())
                }
            } else {
                lit.push(p.0.copy())
            }
        } else {
            lit.push(lb[k].0.copy())
        }
    }
    if not lit.is_empty() {
        var first = lit[0].copy()
        for l in lit {
            if l.y < first.y or (l.y == first.y and l.name < first.name) {
                first = l.copy()
            }
        }
        out.push("light differs in {lit.len()} layers, the first section {first.y}'s {first.name}")
    }
    return out
}

const USAGE: str = "usage: calx rig/runner/savediff.calx VANILLA_WORLD CALCITE_WORLD [X0 Z0 X1 Z1]"

pub fn main() {
    let given = args()
    if given.len() != 2 and given.len() != 6 {
        die(String(USAGE))
    }
    var area = (-1i64, -1i64, 0i64, 0i64)
    if given.len() == 6 {
        var n: List<i64> = []
        for k in 2usize..6 {
            n.push(i64.parse(given[k].copy()) ?? die("savediff: {given[k]} isn't a number"))
        }
        area = (n[0], n[1], n[2], n[3])
    }
    let lines = compare(given[0].copy(), given[1].copy(), area, 20)
    for line in lines {
        println(line)
    }
    if lines.is_empty() {
        println("the same")
    } else {
        println("{lines.len()} differences")
    }
}

fn chunk_at(saved: Map<(i64, i64), Tag>, at: (i64, i64)) -> Tag? {
    if let t = saved.find(at) {
        return some(t.copy())
    }
    return none
}

fn section_at(sections: Map<i64, Tag>, y: i64) -> Tag? {
    if let t = sections.find(y) {
        return some(t.copy())
    }
    return none
}

fn entity_at(entities: Map<(i64, i64, i64), Tag>, at: (i64, i64, i64)) -> Tag? {
    if let t = entities.find(at) {
        return some(t.copy())
    }
    return none
}

/// A section's states as vanilla's reader takes them where there are none: all air.
fn air_states() -> Tag {
    var air = Tag.Compound(LinkedMap<String, Tag>())
    _ = air.insert(String("Name"), Tag.String(String("minecraft:air")))
    var states = Tag.Compound(LinkedMap<String, Tag>())
    _ = states.insert(String("palette"), Tag.List([air]))
    return states
}
