module rig.runner.realclient

// A real client's join: Mojang's own 26.3 client joins Calcite, walks, jumps and chats, or flies.
// It was rig/runner/realclient.py, and does what it did (CAL-253).
//
//     calx rig/runner/realclient.calx [--online NAME] [--server PATH] [--world PATH] [--seed N]
//         [--view N] [--message TEXT] [--dimension ID] [--watch [--mbit N] [--ms N] [--dump FILE]]
//         [--fly SPEED [--fly-seconds N]] [--set KEY=VALUE]... [--command TEXT]...
//         [--keep-open SECONDS]
//
// The protocol suites and the tests play the client's side with Calcite's own code, so this is
// the one check where the other end is the game itself. Calcite runs from its release build,
// build/server/calcite.exe, in a fresh folder under build/rig/realclient/. The client runs from
// the files of a launcher that has run 26.3 once: the official launcher's .minecraft, the Modrinth
// App or Prism Launcher, each checked against the SHA-1 in 26.3's version file, with JDK 25, in a
// game folder of its own beside the server's, with its sound off and the first-run screens
// skipped. It joins with --quickPlayMultiplayer. Nothing of Mojang's is copied: the client runs
// from the launcher's files.
//
// The client's render distance and the server's view distance are both 32, or --view N, so what's
// measured is what a player who sees as far as the client lets them gets.
//
// With --world PATH, the server's world is a copy of the world folder at PATH, such as one vanilla
// saved in the rig's scratch folders, so the client is sent the chunks it saved, read from its
// region files. Without it, the world is new, and the server generates its chunks as they're
// asked for.
//
// --set KEY=VALUE gives the server a calcite.properties setting, such as chunk-send-multiplier=2,
// and can be given any number of times.
//
// --command TEXT is typed into the server's console once it's ready, before the client starts,
// such as `pregen start` to have the client join while the server pregenerates (CAL-71). It can be
// given any number of times, and they're typed in order.
//
// Without --online, the server is offline and the client is player RealClient, with no account.
// With --online NAME, the server is in online mode, and the client plays as the Modrinth App's
// account NAME, which must be the player's own: its session is renewed from the launcher's
// Microsoft refresh token, as the launcher renews it, and kept in memory. No token is printed or
// written, and nothing is written back to the launcher. The client then signs its chat, and the
// message must come through signed, without [Not Secure], on both sides.
//
// On Windows, realclient_keys.ps1 then sends the client's window its keys: F3 for the debug
// screen, F2 for a screenshot, W held for 2.5 seconds and Space, F2, then T, the message and
// Enter, and F2. It sends a key only while the client's window is in front, and stops if it isn't,
// so nothing is typed anywhere else. The three screenshots, in the game folder's screenshots/,
// show the coordinates before and after the walk, and the message in the client's chat.
//
// With --dimension ID, such as the_nether, the server's console then runs `calcite dimension ID`
// for the player, which takes them to that dimension where they are, as vanilla's respawn packet
// takes a player to another (CAL-69), and, once its chunks have had 8 seconds to come, the keys
// take a last screenshot with the debug screen on, which names the dimension.
//
// With --watch, the client joins through chunkwatch.calx's relay, run as a process of its own,
// which reads the frames each way and times the chunks: for the join, and for each dimension it
// goes to, how many it was sent, their bytes, and when the client had them all, by its
// `chunk_batch_received` after the last (CAL-99). --mbit N caps what the server sends at N
// megabits a second, and --ms N makes each way N milliseconds late, as a home link would. --dump
// FILE writes each chunk packet the client was sent to FILE, as it was before it was compressed.
// The relay reads frames only in offline mode; online, they're encrypted, and it only passes them
// on.
//
// With --fly SPEED, the client flies instead of walking and chatting, to see whether the chunks
// keep up with a player who outruns them (CAL-94). It joins through the relay, as with --watch, as
// an op from ops.json, and once its join's chunks have stopped coming for 3 seconds, and the
// server's memory has been read 15 seconds later, the keys type `/calcite flyspeed SPEED` in its
// chat, SPEED times vanilla's flying speed, double-jump to fly, climb, and hold W for
// --fly-seconds, 30 unless given. Then they let go, and the chunks have up to 60 seconds to catch
// up. The relay follows the player as the phases `flight` and `after`, and reports how fast they
// went, how many chunks a second they were sent, how much of the circle of their view about them
// the client had, and how far the nearest chunk it didn't was. The server's ticks during the
// flight come from its `--tick-times` file. --seed N gives a new world that seed, so flights over
// it can be compared.
//
// The server's memory, its working set on Windows and resident set on Linux, is read as it runs,
// and reported as it was before the client joined (with --fly, 15 seconds after the server was
// ready), as a still player's, 15 seconds after the join's chunks stopped coming (with --watch or
// --fly; without, once the keys are done), and the most it had. With --fly, the flight's numbers
// are also written to flight.json beside the logs.
//
// It passes if the server logged the join and the message, with --dimension that it moved the
// player and the screenshot was taken, the client logged the message as it came back, nobody was
// disconnected before the client was stopped, and the client logged no error but the ones on its
// download threads, which, with no account, Mojang's services and Realms always give
// (rig/README.md, "A real client").

import std.bytes.{hex}
import std.cli.{cli}
import std.env.{native_arch, os, variable}
import std.fs.{append_text, copy_dir_all, exists, glob, is_dir, is_file, make_dir_all, metadata, read, read_text, remove_dir_all, remove_file, write_text}
import std.hash.{sha1}
import std.http.{Header, get, post}
import std.io.{flush}
import std.json
import std.json.{Json}
import std.path
import std.process.{Child, Command, Stdio, exit}
import std.sqlite.{Database, Value}
import std.time.{Instant}
import std.url.{form_encode}
import oracle.jdk.{find_java_home, java}
import rig.runner.chunkwatch.{round_to}
import rig.runner.servers.{build, offline_uuid}
import tools.pyfmt.{g}
import tools.pyjson
import tools.pyjson.{indented_one_ascii}
import tools.repo.{die, exe, native, under}

const VERSION: str = "26.3"
const PORT: i64 = 25600
// How long after the join's chunks stop the server's memory is read, as a still player's: past
// the 5 seconds after which the server lets go of what making them kept (D226, D228, D254).
const STILL_WAIT: f64 = 15.0

/// Prints a line at once, so a run's progress shows as it goes, written to a file or not.
fn say(text: String) {
    println(text)
    flush()
}

fn out_dir() -> String {
    return under("build/rig/realclient")
}

/// The system as a version file's rules name it.
fn os_name() -> String {
    let o = os()
    return if o == "windows" { String("windows") } else if o == "macos" { String("osx") } else { String("linux") }
}

fn home() -> String {
    return variable(String("USERPROFILE")) ?? variable(String("HOME")) ?? String(".")
}

/// A launcher's folders: where it keeps version files, libraries and assets.
struct Launcher {
    label: str
    versions: String?
    libraries: String
    assets: String
}

/// Each launcher's folders.
fn launcher_roots() -> List<Launcher> {
    let windows = os() == "windows"
    let appdata = variable(String("APPDATA")) ?? path.join(home(), ".config")
    let mc = if windows { path.join(appdata.copy(), ".minecraft") } else { path.join(home(), ".minecraft") }
    let modrinth = if windows { path.join(appdata.copy(), "ModrinthApp/meta") } else { path.join(home(), ".local/share/ModrinthApp/meta") }
    let prism = if windows { path.join(appdata.copy(), "PrismLauncher") } else { path.join(home(), ".local/share/PrismLauncher") }
    return [
        Launcher { label: "the official launcher", versions: some(path.join(mc.copy(), "versions")), libraries: path.join(mc.copy(), "libraries"), assets: path.join(mc.copy(), "assets") },
        Launcher { label: "the Modrinth App", versions: some(path.join(modrinth.copy(), "versions")), libraries: path.join(modrinth.copy(), "libraries"), assets: path.join(modrinth.copy(), "assets") },
        Launcher { label: "Prism Launcher", versions: none, libraries: path.join(prism.copy(), "libraries"), assets: path.join(prism.copy(), "assets") },
    ]
}

/// What a pattern matches, or nothing where it can't be listed.
fn globbed(pattern: String) -> List<String> {
    return match glob(pattern) {
        ok(found) => found,
        err(_) => [],
    }
}

fn sha1_of(file: String) -> String {
    let data = match read(file.copy()) {
        ok(d) => d,
        err(_) => return String(""),
    }
    return hex(sha1(data))
}

fn size_of(file: String) -> u64 {
    return match metadata(file) {
        ok(m) => m.size,
        err(_) => 0,
    }
}

fn parse_file(file: String) -> Json {
    let text = match read_text(file.copy()) {
        ok(t) => t ?? String(""),
        err(e) => die("realclient: {file}: {e}"),
    }
    return match json.parse(text) {
        ok(v) => v,
        err(e) => die("realclient: {file}: {e}"),
    }
}

fn member(v: Json, key: str) -> Json {
    return v.get(String(key)) ?? Json.Null
}

fn text_of(v: Json, key: str) -> String {
    return member(v, key).as_str() ?? String("")
}

fn version_file() -> Json {
    for l in launcher_roots() {
        if let versions = l.versions {
            let file = path.join(versions, "{VERSION}/{VERSION}.json")
            if is_file(file.copy()) {
                return parse_file(file)
            }
        }
    }
    return die("no {VERSION}.json: run {VERSION} once from the official launcher")
}

fn client_jar(spec: Json) -> (str, String) {
    let client = member(member(spec.copy(), "downloads"), "client")
    let want = text_of(client.copy(), "sha1")
    let size = member(client, "size").as_u64() ?? 0
    var places: List<(str, String)> = []
    for l in launcher_roots() {
        if let versions = l.versions {
            if is_dir(versions.copy()) {
                var dirs = globbed(path.join(versions.copy(), "{VERSION}*"))
                dirs.sort()
                for d in dirs {
                    for jar in globbed(path.join(d.copy(), "*.jar")) {
                        places.push((l.label, jar.copy()))
                    }
                }
            }
        }
        places.push((l.label, path.join(l.libraries.copy(), "com/mojang/minecraft/{VERSION}/minecraft-{VERSION}-client.jar")))
    }
    for (label, jar) in places {
        if is_file(jar.copy()) and size_of(jar.copy()) == size and sha1_of(jar.copy()) == want {
            return (label, jar.copy())
        }
    }
    return die("no {VERSION} client jar with SHA-1 {want}: run {VERSION} once from a launcher")
}

fn allowed(lib: Json) -> bool {
    var allow = true
    let rules = member(lib.copy(), "rules")
    for i in 0..rules.len() {
        let rule = rules.at(i) ?? Json.Null
        let action = text_of(rule.copy(), "action")
        let on = rule.get(String("os"))
        if on == none or text_of(on ?? Json.Null, "name") == os_name() {
            allow = action == "allow"
        } else if action == "allow" {
            allow = false
        }
    }
    // Natives for another processor, such as natives-windows-arm64, have no rule of their own.
    let name = text_of(lib, "name")
    let arch = native_arch()
    if name.ends_with("-arm64") and arch != "aarch64" {
        return false
    }
    if name.ends_with("-x86") and arch != "x86" {
        return false
    }
    return allow
}

fn libraries(spec: Json) -> List<String> {
    var found: List<String> = []
    var missing: List<String> = []
    let libs = member(spec, "libraries")
    for i in 0..libs.len() {
        let lib = libs.at(i) ?? Json.Null
        let art = member(member(lib.copy(), "downloads"), "artifact")
        if art == Json.Null or not allowed(lib) {
            continue
        }
        let rel_path = text_of(art.copy(), "path")
        var here: String? = none
        for l in launcher_roots() {
            let file = path.join(l.libraries.copy(), rel_path.copy())
            if is_file(file.copy()) and size_of(file.copy()) == (member(art.copy(), "size").as_u64() ?? 0) and sha1_of(file.copy()) == text_of(art.copy(), "sha1") {
                here = some(file)
                break
            }
        }
        if let f = here {
            found.push(f)
        } else {
            missing.push(rel_path)
        }
    }
    if not missing.is_empty() {
        die("{missing.len()} of {VERSION}'s libraries aren't in any launcher, such as {missing[0]}: run {VERSION} once from a launcher")
    }
    return found
}

fn assets(spec: Json) -> (String, String) {
    let index = text_of(member(spec, "assetIndex"), "id")
    for l in launcher_roots() {
        let file = path.join(l.assets.copy(), "indexes/{index}.json")
        if not is_file(file.copy()) {
            continue
        }
        let Json.Object(objects) = member(parse_file(file), "objects") else {
            continue
        }
        var all = true
        for (_, o) in objects {
            let h = text_of(o.copy(), "hash")
            if h.len() < 2 or not is_file(path.join(l.assets.copy(), "objects/{h[0..2]}/{h}")) {
                all = false
                break
            }
        }
        if all {
            return (l.assets.copy(), index)
        }
    }
    return die("no launcher has all of asset index {index}: run {VERSION} once from a launcher")
}

/// Who the client plays as. The token is never printed or written.
struct Player {
    name: String
    uuid: String
    token: String
}

fn offline_player() -> Player {
    return Player { name: String("RealClient"), uuid: offline_uuid(String("RealClient")).replace("-", ""), token: String("0") }
}

/// A POST's status and answer. An error's answer keeps only its error fields, to be shown.
struct Answer {
    status: u32
    body: Json
}

fn post_json(url: str, body: Json, form: List<(String, String)>?) -> Answer {
    let accept = Header { name: "Accept", value: "application/json" }
    var r = if let pairs = form {
        let kind = Header { name: "Content-Type", value: "application/x-www-form-urlencoded" }
        post(String(url), [kind, accept], form_encode(pairs).to_bytes(), 20000, 1 << 20)
    } else {
        let kind = Header { name: "Content-Type", value: "application/json" }
        post(String(url), [kind, accept], pyjson.spaced(body).to_bytes(), 20000, 1 << 20)
    }
    let resp = match r.wait() {
        ok(x) => x,
        err(e) => die("realclient: {url}: {e}"),
    }
    let answer = match json.parse(String.from_utf8(resp.body.copy()) ?? String("")) {
        ok(v) => v,
        err(_) => Json.Object(LinkedMap<String, Json>()),
    }
    if resp.status == 200 {
        return Answer { status: resp.status, body: answer }
    }
    var kept = LinkedMap<String, Json>()
    for key in ["error", "error_description", "XErr", "errorMessage"] {
        if let v = answer.get(String(key)) {
            kept.insert(String(key), v)
        }
    }
    return Answer { status: resp.status, body: Json.Object(kept) }
}

fn object(pairs: List<(String, Json)>) -> Json {
    var m = LinkedMap<String, Json>()
    for (k, v) in pairs {
        m.insert(k.copy(), v.copy())
    }
    return Json.Object(m)
}

fn s(text: own String) -> Json {
    return Json.Str(text)
}

/// The Modrinth App's account `name`, with a session renewed as the launcher renews one: its
/// Microsoft refresh token gives an Xbox Live token, that an XSTS token for Minecraft's services,
/// and that a Minecraft access token. Every token stays in memory.
fn online_player(name: String) -> Player {
    let base = variable(String("APPDATA")) ?? path.join(home(), ".local/share")
    let db_file = path.join(base, "ModrinthApp/app.db")
    if not is_file(db_file.copy()) {
        die("--online needs the Modrinth App, signed in to the account")
    }
    let db = match Database.open_read(db_file) {
        ok(d) => d,
        err(e) => die("realclient: the Modrinth App's database: {e}"),
    }
    let row = match db.query_one(String("select refresh_token from minecraft_users where username = ?"), [Value.Text(name.copy())]) {
        ok(r) => r,
        err(e) => die("realclient: the Modrinth App's database: {e}"),
    }
    let found = row else {
        die("the Modrinth App has no account {name}")
    }
    let Value.Text(refresh) = found[0].copy() else {
        die("the Modrinth App has no account {name}")
    }
    // The Minecraft launcher's Microsoft account client, which the Modrinth App signs in with.
    var step = post_json("https://login.live.com/oauth20_token.srf", Json.Null, some([
        (String("client_id"), String("00000000402b5328")), (String("grant_type"), String("refresh_token")),
        (String("refresh_token"), refresh), (String("redirect_uri"), String("https://login.live.com/oauth20_desktop.srf")),
        (String("scope"), String("service::user.auth.xboxlive.com::MBI_SSL")),
    ]))
    if step.status == 200 {
        let ticket = "t={text_of(step.body.copy(), "access_token")}"
        step = post_json("https://user.auth.xboxlive.com/user/authenticate", object([
            (String("Properties"), object([(String("AuthMethod"), s(String("RPS"))), (String("SiteName"), s(String("user.auth.xboxlive.com"))), (String("RpsTicket"), s(ticket))])),
            (String("RelyingParty"), s(String("http://auth.xboxlive.com"))), (String("TokenType"), s(String("JWT"))),
        ]), none)
    }
    if step.status == 200 {
        let user = text_of(step.body.copy(), "Token")
        step = post_json("https://xsts.auth.xboxlive.com/xsts/authorize", object([
            (String("Properties"), object([(String("SandboxId"), s(String("RETAIL"))), (String("UserTokens"), Json.Array([s(user)]))])),
            (String("RelyingParty"), s(String("rp://api.minecraftservices.com/"))), (String("TokenType"), s(String("JWT"))),
        ]), none)
    }
    if step.status == 200 {
        let xui = member(member(step.body.copy(), "DisplayClaims"), "xui").at(0) ?? Json.Null
        let identity = "XBL3.0 x={text_of(xui, "uhs")};{text_of(step.body.copy(), "Token")}"
        step = post_json("https://api.minecraftservices.com/authentication/login_with_xbox", object([(String("identityToken"), s(identity))]), none)
    }
    if step.status != 200 {
        die("couldn't renew {name}'s session: {step.status} {pyjson.py_repr(step.body.copy())}. Sign in again in the Modrinth App")
    }
    let token = text_of(step.body, "access_token")
    let bearer = Header { name: "Authorization", value: "Bearer {token}" }
    var r = get(String("https://api.minecraftservices.com/minecraft/profile"), [bearer], 20000, 1 << 20)
    let resp = match r.wait() {
        ok(x) => x,
        err(e) => die("realclient: the profile: {e}"),
    }
    if resp.status != 200 {
        die("realclient: the profile: HTTP {resp.status}")
    }
    let profile = match json.parse(String.from_utf8(resp.body) ?? String("")) {
        ok(v) => v,
        err(e) => die("realclient: the profile: {e}"),
    }
    return Player { name: text_of(profile.copy(), "name"), uuid: text_of(profile, "id"), token: token }
}

fn client_command(spec: Json, java_home: String, game: String, player: Player, port: i64) -> List<String> {
    let natives = path.join(out_dir(), "natives")
    let (jar_label, jar) = client_jar(spec.copy())
    let (asset_root, index) = assets(spec.copy())
    var classpath = libraries(spec.copy())
    classpath.push(jar)
    say("client: {VERSION}'s jar from {jar_label}, {classpath.len() - 1} libraries, assets from {native(asset_root.copy())}")
    let sep = if os() == "windows" { ";" } else { ":" }
    var argv: List<String> = [java(java_home), String("-Xmx2G"), String("-XX:StackShadowPages=32"), String("--enable-native-access=ALL-UNNAMED"),
        String("--add-exports"), String("java.base/jdk.internal.misc=ALL-UNNAMED"),
        "-Djava.library.path={native(path.join(natives.copy(), "java"))}", "-Djna.tmpdir={native(path.join(natives.copy(), "jna"))}",
        "-Dorg.lwjgl.system.SharedLibraryExtractPath={native(path.join(natives.copy(), "lwjgl"))}",
        "-Dio.netty.native.workdir={native(path.join(natives.copy(), "netty"))}",
        String("-Dminecraft.launcher.brand=calcite-rig"), String("-Dminecraft.launcher.version=1"),
        String("-cp"), classpath.join(String(sep)), text_of(spec, "mainClass")]
    let args: List<String> = [String("--username"), player.name.copy(), String("--version"), String(VERSION), String("--gameDir"), native(game),
        String("--assetsDir"), native(asset_root), String("--assetIndex"), index,
        String("--uuid"), player.uuid.copy(), String("--accessToken"), player.token.copy(), String("--clientId"), String("0"), String("--xuid"), String("0"),
        String("--versionType"), String("release"), String("--width"), String("854"), String("--height"), String("480"),
        String("--quickPlayMultiplayer"), "127.0.0.1:{port}"]
    argv.extend(args)
    return argv
}

/// A child whose output goes to a file and is kept, line by line, to wait on.
struct Proc {
    lines: List<String>
    log: String
    child: Child
}

fn start(argv: List<String>, cwd: String, log: own String) -> Proc {
    match write_text(log.copy(), String("")) {
        ok => {},
        err(e) => die("realclient: {log}: {e}"),
    }
    let child = match Command.new(argv[0].copy()).args(argv[1..]).dir(cwd).stdin(Stdio.Pipe).stdout(Stdio.Pipe).stderr(Stdio.Stdout).spawn() {
        ok(c) => c,
        err(e) => die("realclient: starting {argv[0]}: {e}"),
    }
    return Proc { lines: [], log: log, child: child }
}

impl Proc {
    /// Reads what it has written so far, waiting at most `ms` for the first line.
    fn pump(mut self, ms: u64) {
        // At least 1 ms, as a wait of 0 takes nothing new from the pipe (CLX-358).
        var wait = if ms == 0 { 1u64 } else { ms }
        var text = String("")
        var n = 0
        while let line = self.child.read_line(wait) {
            text.push_str(line.copy())
            text.push_str("\n")
            self.lines.push(line)
            wait = 0
            n += 1
            if n >= 10000 {
                break
            }
        }
        if not text.is_empty() {
            match append_text(self.log.copy(), text) {
                ok => {},
                err(_) => {},
            }
        }
    }

    fn find(self, text: String) -> String? {
        for line in self.lines {
            if line.contains(text.copy()) {
                return some(line.copy())
            }
        }
        return none
    }

    fn running(self) -> bool {
        return self.child.try_wait() == none
    }

    fn send(self, line: String) {
        match self.child.write_text("{line}\n") {
            ok => {},
            err(_) => {},
        }
    }
}

/// The server, the client once it's started, and the relay with --watch, read from as anything
/// waits, so none of them waits on a full pipe.
struct Run {
    server: Proc
    // The client, once it's started: none or one.
    client: List<Proc>
    relay: Child?
    began: Instant
}

impl Run {
    /// Seconds since the server started, by this program's clock.
    fn now(self) -> f64 {
        return unsafe { Instant.now() }.secs_since(self.began)
    }

    /// Reads what each has written, waiting at most `ms` for the server.
    fn pump(mut self, ms: u64) {
        self.server.pump(ms)
        for i in 0..self.client.len() {
            self.client[i].pump(0)
        }
    }

    fn sleep(mut self, seconds: f64) {
        let end = self.now() + seconds
        while self.now() < end {
            let left = end - self.now()
            self.pump(if left > 0.1 { 100 } else { 10 })
        }
    }

    fn server_wait_for(mut self, text: String, timeout: f64) -> String? {
        let end = self.now() + timeout
        while self.now() < end {
            if let line = self.server.find(text.copy()) {
                return some(line)
            }
            if not self.server.running() {
                self.pump(0)
                return self.server.find(text.copy())
            }
            self.pump(200)
        }
        return none
    }

    fn client_wait_for(mut self, text: String, timeout: f64) -> String? {
        let end = self.now() + timeout
        while self.now() < end {
            self.pump(200)
            if let line = self.client_find(text.copy()) {
                return some(line)
            }
            if not self.client_running() {
                return none
            }
        }
        return none
    }

    fn client_find(self, text: String) -> String? {
        for c in self.client {
            return c.find(text.copy())
        }
        return none
    }

    fn client_running(self) -> bool {
        for c in self.client {
            return c.running()
        }
        return false
    }

    fn client_id(self) -> u32 {
        for c in self.client {
            return c.child.id()
        }
        return 0
    }

    /// Asks the relay how long ago its last chunk was handed on.
    fn quiet(self) -> f64? {
        let relay = self.relay else {
            return none
        }
        let wrote = match relay.write_text(String("quiet\n")) {
            ok => true,
            err(_) => false,
        }
        if not wrote {
            return none
        }
        while let line = relay.read_line(5000) {
            if line.starts_with("quiet ") {
                return f64.parse(line[6..].trim())
            }
        }
        return none
    }

    fn mark(self, kind: str) {
        if let relay = self.relay {
            match relay.write_text("mark {kind}\n") {
                ok => {},
                err(_) => {},
            }
        }
    }

    /// Waits until no chunk has been sent for `quiet` seconds, for at most `timeout`; whether
    /// they stopped.
    fn settle(mut self, quiet: f64, timeout: f64) -> bool {
        let end = self.now() + timeout
        while self.now() < end {
            if let q = self.quiet() {
                if q > quiet {
                    return true
                }
            }
            self.sleep(0.25)
        }
        return false
    }

    /// Runs realclient_keys.ps1 with `more`, reading the others meanwhile, and gives its lines,
    /// whether it succeeded, and with `fly`, when it said `flying` and `stopped`, each of which
    /// starts a phase on the relay as it comes.
    fn keys(mut self, more: List<String>, fly: bool) -> (List<String>, bool, List<(String, f64)>) {
        if self.client.is_empty() {
            return ([], false, [])
        }
        var argv: List<String> = [String("-NoProfile"), String("-ExecutionPolicy"), String("Bypass"), String("-File"),
            native(under("rig/runner/realclient_keys.ps1")), String("-ProcessId"), "{self.client_id()}"]
        argv.extend(more)
        var keys = match Command.new(String("powershell")).args(argv).stdout(Stdio.Pipe).stderr(Stdio.Stdout).timeout(if fly { 600000 } else { 120000 }).spawn() {
            ok(k) => k,
            err(e) => die("realclient: the keys: {e}"),
        }
        var said: List<String> = []
        var times: List<(String, f64)> = []
        loop {
            // 1 ms, as a wait of 0 takes nothing new from the pipe (CLX-358).
            while let line = keys.read_line(1) {
                let t = line.trim()
                if t.is_empty() {
                    continue
                }
                if fly and (t == "flying" or t == "stopped") {
                    self.mark(if t == "flying" { "flight" } else { "after" })
                    times.push((t.copy(), self.now()))
                }
                said.push(t.copy())
            }
            if keys.ended() {
                break
            }
            self.pump(50)
        }
        let done = keys.wait()
        return (said, done.status.code == some(0), times)
    }

    fn send_keys(mut self, message: own String, shot: bool) -> bool {
        if os() != "windows" {
            say("keys: sent only on Windows, so the client just joins")
            return false
        }
        var more: List<String> = [String("-Message"), message]
        if shot {
            more.push(String("-Shot"))
        }
        let (said, passed, _) = self.keys(more, false)
        say("keys: {said.join(String("\n"))}")
        return passed
    }

    /// The keys' flight: the relay's phase `flight` starts as the player starts forward, and
    /// `after` as they let go. Whether it flew, and when it started and stopped.
    fn fly(mut self, speed: own String, seconds: i64) -> (bool, List<(String, f64)>) {
        let (said, passed, times) = self.keys([String("-Fly"), String("-Speed"), speed, String("-Seconds"), "{seconds}"], true)
        say("keys: {said.join(String("; "))}")
        var stopped = false
        for (k, _) in times {
            if k == "stopped" {
                stopped = true
            }
        }
        return (passed and stopped, times)
    }

    /// The server's memory now, and the most it had, as the system keeps it while it runs.
    fn memory(self) -> (u64, u64) {
        let u = unsafe { self.server.child.usage() }
        return (u.memory, u.peak_memory)
    }

    fn stop(mut self) {
        for i in 0..self.client.len() {
            self.client[i].child.kill()
            self.client[i].pump(0)
            _ = self.client[i].child.wait()
        }
        self.server.send(String("stop"))
        let end = self.now() + 30.0
        while self.server.running() and self.now() < end {
            self.server.pump(200)
        }
        if self.server.running() {
            self.server.child.kill()
        }
        self.server.pump(0)
        _ = self.server.child.wait()
    }
}

fn remove_tree(dir: String) {
    if exists(dir.copy()) {
        match remove_dir_all(dir.copy()) {
            ok => {},
            err(e) => die("realclient: removing {dir}: {e}"),
        }
    }
}

fn put(file: String, text: String) {
    match write_text(file.copy(), text) {
        ok => {},
        err(e) => die("realclient: {file}: {e}"),
    }
}

fn prepare(server_dir: String, game: String, online: bool, world: String?, view: i64, settings: List<String>, seed: i64?, op: Player?) {
    remove_tree(server_dir.copy())
    remove_tree(path.join(game.copy(), "screenshots"))
    match make_dir_all(server_dir.copy()) {
        ok => {},
        err(e) => die("realclient: {server_dir}: {e}"),
    }
    var props = "online-mode={online}\nserver-ip=127.0.0.1\nserver-port={PORT}\ngamemode=creative\nwhite-list=false\nview-distance={view}\nmotd=Calcite and a real client\n"
    if let n = seed {
        props.push_str("level-seed={n}\n")
    }
    put(path.join(server_dir.copy(), "server.properties"), props)
    if let p = op {
        // The player as an op, so they may use `calcite flyspeed`.
        let u = p.uuid.copy()
        let dashed = if u.len() == 32 { "{u[0..8]}-{u[8..12]}-{u[12..16]}-{u[16..20]}-{u[20..32]}" } else { u.copy() }
        let entry = object([(String("uuid"), s(dashed)), (String("name"), s(p.name.copy())), (String("level"), Json.Int(4)), (String("bypassesPlayerLimit"), Json.Bool(false))])
        put(path.join(server_dir.copy(), "ops.json"), pyjson.spaced_ascii(Json.Array([entry])))
    }
    var calcite = String("console-dashboard=off\n")
    for line in settings {
        calcite.push_str("{line}\n")
    }
    put(path.join(server_dir.copy(), "calcite.properties"), calcite)
    if let w = world {
        let target = path.join(server_dir.copy(), "world")
        match copy_dir_all(w.copy(), target.copy()) {
            ok => {},
            err(e) => die("realclient: copying {w}: {e}"),
        }
        let lock = path.join(target, "session.lock")
        if is_file(lock.copy()) {
            match remove_file(lock) {
                ok => {},
                err(_) => {},
            }
        }
    }
    match make_dir_all(game.copy()) {
        ok => {},
        err(e) => die("realclient: {game}: {e}"),
    }
    put(path.join(game, "options.txt"), "onboardAccessibility:false\njoinedFirstServer:true\nskipMultiplayerWarning:true\npauseOnLostFocus:false\ntutorialStep:none\nrenderDistance:{view}\nnarrator:0\nsoundCategory_master:0.0\n")
}

/// Bytes as MiB to one place, as Python's `round(n / 2**20, 1)` gave them, or None.
fn mib(n: u64) -> String {
    if n == 0 {
        return String("None")
    }
    return g(round_to(f64.nearest(n) / 1048576.0, 1))
}

fn mib_json(n: u64) -> Json {
    return if n == 0 { Json.Null } else { Json.Float(round_to(f64.nearest(n) / 1048576.0, 1)) }
}

/// The server's tick times between `start` and `end`, from its --tick-times file, whose times are
/// from the server's start, a moment after this program's clock began: the mean, the 99th
/// percentile and the most, in milliseconds.
fn ticks_between(file: String, from_s: f64, to_s: f64) -> Json {
    if not is_file(file.copy()) {
        return Json.Null
    }
    let text: String? = match read_text(file) {
        ok(t) => t,
        err(_) => none,
    }
    var busy: List<f64> = []
    for line in (text ?? String("")).lines() {
        let parts = line.split_whitespace()
        if parts.len() != 2 {
            continue
        }
        let at = f64.nearest(i64.parse(parts[0].copy()) ?? 0) / 1000000000.0
        let work = f64.nearest(i64.parse(parts[1].copy()) ?? 0) / 1000000.0
        if from_s <= at and at < to_s {
            busy.push(work)
        }
    }
    if busy.is_empty() {
        return Json.Null
    }
    busy.sort_by(|a, b| if a < b { Ordering.Less } else if a > b { Ordering.Greater } else { Ordering.Equal })
    var total = 0.0
    for b in busy {
        total += b
    }
    let n = busy.len()
    let p99 = if n * 99 / 100 < n - 1 { n * 99 / 100 } else { n - 1 }
    return object([
        (String("ticks"), Json.Int(i64.wrap(u64(n)))),
        (String("mspt_mean"), Json.Float(round_to(total / f64.nearest(i64.wrap(u64(n))), 3))),
        (String("mspt_p99"), Json.Float(round_to(busy[p99], 3))),
        (String("mspt_max"), Json.Float(round_to(busy[n - 1], 3))),
    ])
}

/// A line as a check shows it: after the log's `]: `.
fn shown(line: own String) -> String {
    if let at = line.find("]: ") {
        return line[at + 3..]
    }
    return line
}

/// A path under the repository's root as from it, as Python's `relative_to` wrote it. The root
/// and the path are compared with `/`, which `under` writes each with or not.
fn rel(file: String) -> String {
    let base = under("").replace("\\", "/")
    let whole = file.replace("\\", "/")
    if not whole.starts_with(base.copy()) {
        return native(file)
    }
    var p = whole[base.len()..]
    while p.starts_with("/") or p.starts_with("\\") {
        p = p[1..]
    }
    return native(p)
}

fn jfloat(v: Json) -> String {
    return match v {
        Json.Null => String("None"),
        _ => pyjson.py_repr(v),
    }
}

/// A report's member as Python's f-string wrote it.
fn field(p: Json, key: str) -> String {
    return jfloat(member(p, key))
}

/// The members `keys` of the phase named `name`, each None where it has none.
fn pick(phases: LinkedMap<String, Json>, name: str, keys: List<str>) -> Json {
    let p = if phases.contains(String(name)) { phases[String(name)].copy() } else { Json.Object(LinkedMap<String, Json>()) }
    var m = LinkedMap<String, Json>()
    for k in keys {
        m.insert(String(k), member(p.copy(), k))
    }
    return Json.Object(m)
}

@cli(name: "realclient")
struct Args {
    /// Play as the Modrinth App's account NAME, in online mode.
    online: String?
    /// The server's release build.
    server: String?
    /// A world folder to copy in as the server's world.
    world: String?
    /// The client's render distance and the server's view distance, 2 to 32.
    view: i64 = 32
    /// What the client says: small letters and spaces.
    message: String = "hello from a real client"
    /// A dimension to take the client to after it chats, such as the_nether.
    dimension: String?
    /// Join through chunkwatch.calx's relay and report the chunks it timed.
    watch: bool
    /// With --watch, the most the server sends, in megabits a second.
    mbit: f64?
    /// With --watch, milliseconds each way is late.
    ms: f64 = 0.0
    /// With --watch, a file each chunk packet's written to, as it was before it was compressed.
    dump: String?
    /// A calcite.properties setting for the server, such as chunk-send-multiplier=2.
    set: List<String>
    /// A console command typed once the server's ready, before the client starts.
    command: List<String>
    /// Seconds to leave the client in the game at the end.
    keep_open: f64 = 0.0
    /// Fly forward at SPEED times vanilla's flying speed instead of walking and chatting.
    fly: String?
    /// With --fly, how long the client flies forward.
    fly_seconds: i64 = 30
    /// The new world's seed.
    seed: i64?
}

pub fn main() {
    let args = Args.parse()
    let windows = os() == "windows"
    var dimension: String? = none
    if let d = args.dimension.copy() {
        dimension = some(if d.contains(":") { d } else { "minecraft:{d}" })
    }
    var letters = not args.message.trim().is_empty()
    for c in args.message.chars() {
        if not ((c >= 'a' and c <= 'z') or c == ' ') {
            letters = false
        }
    }
    if not letters {
        die("the message can only have small letters and spaces")
    }
    var watch = args.watch
    if let f = args.fly.copy() {
        let speed = f64.parse(f.copy()) ?? -1.0
        if not (speed > 0.0 and speed <= 1000.0) {
            die("--fly takes a speed from above 0 to 1000 times vanilla's")
        }
        if args.online != none or not windows or dimension != none {
            die("--fly flies with the keys, on Windows, offline, so the relay can follow the player, and without --dimension")
        }
        watch = true
    }
    let server_exe = args.server.copy() ?? under("build/server/calcite{exe()}")
    if not is_file(server_exe.copy()) {
        die("no {server_exe}: build Calcite's release build first (src/README.md)")
    }

    let spec = version_file()
    let java_home = find_java_home(none)
    let server_dir = path.join(out_dir(), "server")
    let game = path.join(out_dir(), "game")
    let player = if let name = args.online.copy() { online_player(name) } else { offline_player() }
    say("player: {player.name}, {if args.online != none { "online, with a renewed session" } else { "offline" }}")
    var relay_exe: String? = none
    if watch {
        relay_exe = some(build("rig/runner/chunkwatch.calx", "chunkwatch"))
        let link = if let m = args.mbit { "{g(m)} Mbit/s" } else { String("no cap") }
        say("watch: the client joins through a relay on {PORT + 1}, {link}, {g(args.ms)} ms each way")
    }
    let command = client_command(spec, java_home, game.copy(), player.copy(), if watch { PORT + 1 } else { PORT })
    if let w = args.world.copy() {
        if not is_file(path.join(w.copy(), "level.dat")) {
            die("no level.dat in {w}")
        }
    }
    if args.view < 2 or args.view > 32 {
        die("the view distance is from 2 to 32")
    }
    prepare(server_dir.copy(), game.copy(), args.online != none, args.world.copy(), args.view, args.set.copy(), args.seed,
        if args.fly != none { some(player.copy()) } else { none })
    let watch_file = path.join(out_dir(), "watch.json")
    var relay: Child? = none
    if let exe_path = relay_exe {
        var relay_args: List<String> = [String("--listen"), "{PORT + 1}", String("--server"), "127.0.0.1:{PORT}", String("--ms"), "{args.ms}",
            String("--view"), "{args.view}", String("--out"), watch_file.copy()]
        if let m = args.mbit {
            relay_args.extend([String("--mbit"), "{m}"])
        }
        if let d = args.dump.copy() {
            relay_args.extend([String("--dump"), d])
        }
        let r = match Command.new(exe_path).args(relay_args).stdin(Stdio.Pipe).stdout(Stdio.Pipe).stderr(Stdio.Stdout).spawn() {
            ok(c) => c,
            err(e) => die("realclient: starting the relay: {e}"),
        }
        // Its first line says it's listening.
        _ = r.read_line(10000)
        relay = some(r)
    }

    let ticks_file = path.join(server_dir.copy(), "tick-times.txt")
    var run = Run {
        server: start([server_exe, String("--tick-times"), native(ticks_file.copy())], server_dir.copy(), path.join(out_dir(), "server.log")),
        client: [], relay: relay, began: unsafe { Instant.now() },
    }
    let done = run.server_wait_for(String("Done ("), 60.0) else {
        run.stop()
        die("the server didn't start:\n{run.server.lines[if run.server.lines.len() > 20 { run.server.lines.len() - 20 } else { 0 }..].join(String("\n"))}")
    }
    say("server: {if let at = done.find(": ") { done[at + 2..] } else { done.copy() }}")
    for line in args.command {
        run.server.send(line.copy())
        say("console: {line}")
    }
    if args.fly != none {
        // Idle as a server with nobody on it is: past what finding the spawn kept.
        run.sleep(STILL_WAIT)
    }
    let (idle, _) = run.memory()
    run.client.push(start(command, game.copy(), path.join(out_dir(), "client.log")))
    var keyed = false
    var moved: String? = none
    var shot = false
    var still = 0u64
    var flew = false
    var flight_times: List<(String, f64)> = []
    let joined = run.server_wait_for("{player.name} joined the game", 180.0)
    if joined != none and args.fly != none {
        _ = run.settle(3.0, 120.0)
        run.sleep(STILL_WAIT)
        still = run.memory().0
        let (f, times) = run.fly(args.fly.copy() ?? String(""), args.fly_seconds)
        flew = f
        flight_times = times
        _ = run.settle(3.0, 60.0)
    } else if joined != none {
        run.sleep(4.0)
        keyed = run.send_keys(args.message.copy(), false)
        if keyed {
            _ = run.server_wait_for("<{player.name}> {args.message}", 10.0)
            _ = run.client_wait_for("[CHAT] <{player.name}> {args.message}", 5.0)
        }
        if let d = dimension.copy() {
            run.server.send("calcite dimension {d} {player.name}")
            moved = run.server_wait_for("Moved {player.name} to {d}", 10.0)
            run.sleep(8.0)
            shot = keyed and run.send_keys(args.message.copy(), true)
        }
        if watch {
            _ = run.settle(3.0, 60.0)
            run.sleep(STILL_WAIT)
        }
        still = run.memory().0
    }
    if joined != none {
        run.sleep(args.keep_open)
    }
    run.pump(0)
    let client_gone = not run.client.is_empty() and not run.client_running()
    let gone_early = run.server.find(String("lost connection")) != none or run.client_find(String("Disconnected")) != none or client_gone
    let (_, peak) = run.memory()
    run.stop()
    say("memory: {mib(idle)} MiB before the client joined, {mib(still)} MiB with it still, {if watch { 3 + 15 } else { 0 }} s after its last chunk, {mib(peak)} MiB at the most")

    // Each check: what it is, and the line that shows it, or none; "-" or "sent" for one that
    // has no line.
    var checks: List<(String, String?)> = [(String("the server logged the join"), run.server.find("{player.name}[/127.0.0.1:"))]
    if args.fly != none {
        checks.push((String("the client was told its flying speed"), run.client_find(String("Set own flying speed to"))))
        checks.push((String("the keys flew the client forward and let go"), if flew { some(String("-")) } else { none }))
    } else if windows {
        let said = run.server.find("<{player.name}> {args.message}")
        let back = run.client_find("[CHAT] <{player.name}> {args.message}")
        checks.push((String("the keys went to the client's window"), if keyed { some(String("sent")) } else { none }))
        checks.push((String("the server logged the message"), said.copy()))
        checks.push((String("the client got the message back"), back.copy()))
        if args.online != none {
            checks.push((String("the server took it as signed"), if let l = said.copy() { if l.contains("[Not Secure]") { none } else { some(l) } } else { none }))
            checks.push((String("the client took it as signed"), if let l = back.copy() { if l.contains("[Not Secure]") { none } else { some(l) } } else { none }))
        }
    }
    if let d = dimension.copy() {
        checks.push(("the server moved the player to {d}", moved.copy()))
        if windows {
            checks.push((String("the keys took a screenshot there"), if shot { some(String("sent")) } else { none }))
        }
    }
    checks.push((String("nobody was disconnected before the client was stopped"), if gone_early { none } else { some(String("-")) }))
    // With no account, the client's calls to Mojang's services and Realms fail on these threads.
    var errors: List<String> = []
    for c in run.client {
        for line in c.lines {
            if line.contains("/ERROR]") and not line.contains("[Download-") {
                errors.push(line.copy())
            }
        }
    }
    checks.push((String("the client logged no error but its download threads'"), if errors.is_empty() { some(String("-")) } else { none }))
    var passed = true
    for (what, line) in checks {
        if let l = line.copy() {
            let extra = if l == "sent" or l == "-" { String("") } else { ": {shown(l.copy())}" }
            say("ok   {what}{extra}")
        } else {
            passed = false
            say("FAIL {what}")
        }
    }
    for (i, line) in errors.enumerate() {
        if i >= 10 {
            break
        }
        say("     {line[..if line.len() > 300 { 300 } else { line.len() }]}")
    }
    var shots = globbed(path.join(game.copy(), "screenshots/*.png"))
    shots.sort()
    var shot_names: List<String> = []
    for p in shots {
        shot_names.push(rel(p.copy()))
    }
    say("screenshots: {if shot_names.is_empty() { String("none") } else { shot_names.join(String(", ")) }}")
    say("logs: {rel(path.join(out_dir(), "server.log"))}, {rel(path.join(out_dir(), "client.log"))}")
    if let r = run.relay {
        var relay_child = r
        match relay_child.write_text(String("stop\n")) {
            ok => {},
            err(_) => {},
        }
        while let line = relay_child.read_line(30000) {
            if line == "stopped" {
                break
            }
        }
        _ = relay_child.wait()
        let report = parse_file(watch_file.copy())
        for c in 0..report.len() {
            let connection = report.at(c) ?? Json.Null
            for i in 0..connection.len() {
                let p = connection.at(i) ?? Json.Null
                say("watch: {text_of(p.copy(), "phase")}: {field(p.copy(), "chunks")} chunks, {field(p.copy(), "chunk_kib")} KiB, {field(p.copy(), "bytes_a_chunk")} B a chunk, {field(p.copy(), "batches")} batches, last sent at {field(p.copy(), "last_chunk_s")} s, the client had half at {field(p.copy(), "client_had_half_s")} s, 90% at {field(p.copy(), "client_had_90_s")} s, 95% at {field(p.copy(), "client_had_95_s")} s, all at {field(p.copy(), "client_had_all_s")} s, asked {field(p.copy(), "asked_a_tick")} a tick, {field(p.copy(), "forgotten")} forgotten, waited for the link {field(p.copy(), "link_wait_ms")} ms")
                if p.get(String("had_of_view")) != none {
                    let had = member(p.copy(), "had_of_view")
                    say("watch: {text_of(p.copy(), "phase")}: {field(p.copy(), "seconds")} s at {field(p.copy(), "blocks_a_second")} blocks a second, sent {field(p.copy(), "chunks_a_second")} chunks a second; the client had {jfloat(had.at(0) ?? Json.Null)}% of the {field(p.copy(), "view_chunks")} chunks of its view on average, {jfloat(had.at(1) ?? Json.Null)}% at the least, all of them in {text_of(p.copy(), "whole_view_samples")} samples; the nearest it didn't was {field(p.copy(), "nearest_missing")} chunks away, the median and the least")
                }
            }
        }
        say("watch: {rel(watch_file.copy())}")
        if let speed = args.fly.copy() {
            var phases = LinkedMap<String, Json>()
            for c in 0..report.len() {
                let connection = report.at(c) ?? Json.Null
                for i in 0..connection.len() {
                    let p = connection.at(i) ?? Json.Null
                    phases.insert(text_of(p.copy(), "phase"), p)
                }
            }
            var flying: f64? = none
            var stopped: f64? = none
            for (k, t) in flight_times {
                if k == "flying" {
                    flying = some(t)
                } else if k == "stopped" {
                    stopped = some(t)
                }
            }
            var ticks = Json.Null
            if let a = flying {
                if let b = stopped {
                    ticks = ticks_between(ticks_file.copy(), a, b)
                }
            }
            say("flight: the server's ticks while the client flew: {pyjson.py_repr(ticks.copy())}")
            let keep: List<str> = ["seconds", "blocks_a_second", "chunks", "chunks_a_second", "had_of_view", "whole_view_samples",
                "nearest_missing", "client_had_all_s", "forgotten", "view_samples"]
            let flight = object([
                (String("speed"), Json.Float(f64.parse(speed) ?? 0.0)), (String("view"), Json.Int(args.view)),
                (String("seed"), if let n = args.seed { Json.Int(n) } else { Json.Null }), (String("flight_seconds"), Json.Int(args.fly_seconds)),
                (String("memory_mib"), object([(String("idle"), mib_json(idle)), (String("joined"), mib_json(still)), (String("peak"), mib_json(peak))])),
                (String("ticks"), ticks),
                (String("join"), pick(phases.copy(), "join", ["chunks", "client_had_95_s", "client_had_all_s"])),
                (String("flight"), pick(phases.copy(), "flight", keep.copy())),
                (String("after"), pick(phases.copy(), "after", keep)),
            ])
            let flight_file = path.join(out_dir(), "flight.json")
            put(flight_file.copy(), indented_one_ascii(flight))
            say("flight: {rel(flight_file)}")
        }
    }
    exit(if passed { 0 } else { 1 })
}
