module rig.runner.tests.test_deflate

// Tests for deflate.calx, the streams the case generators compress with.
//
//     calx test rig/runner/tests/test_deflate.calx

import std.bytes.{hex}
import std.zlib.{Format, decompress}
import rig.runner.cases.{splitmix64}
import rig.runner.deflate.{deflate, gzip_header, gzip_stream, gzip_with, zlib_stream}

fn noise(count: usize, seed: u64) -> List<u8> {
    var r = splitmix64(seed)
    var out: List<u8> = []
    for _ in 0..count {
        out.push(u8.wrap(r.next() & 0xFF))
    }
    return out
}

fn repeated(text: str, count: usize) -> List<u8> {
    var out: List<u8> = []
    let one = String(text).to_bytes()
    for _ in 0..count {
        out.extend(one.copy())
    }
    return out
}

fn joined(head: own List<u8>, tail: List<u8>) -> List<u8> {
    var out = head
    out.extend(tail.copy())
    return out
}

fn samples() -> List<(String, List<u8>)> {
    var high: List<u8> = []
    for _ in 0..9 {
        for v in 0usize..256 {
            high.push(u8.wrap(v))
        }
    }
    let window = noise(40000, 7)
    return [
        (String("empty"), []),
        (String("one"), repeated("x", 1)),
        (String("short"), repeated("abc", 4)),
        (String("text"), repeated("the quick brown fox jumps over the lazy dog ", 300)),
        // A run past the longest match, matches across the whole window, and bytes past 143,
        // which take 9-bit codes.
        (String("run"), repeated("a", 1000)),
        (String("window"), joined(window.copy(), window[0..30000])),
        (String("high"), high),
        (String("noise"), noise(5000, 1)),
        // More than a stored block holds.
        (String("big"), joined(noise(70000, 3), repeated("z", 70000))),
    ]
}

fn inflated(data: List<u8>, format: Format) -> List<u8> {
    return match decompress(data, format, 1 << 24) {
        ok(back) => back,
        err(e) => panic("{e}"),
    }
}

@test
fn inflates_back() {
    for (name, data) in samples() {
        for level in [0i64, 1, 2, 6, 9, -1] {
            assert(inflated(deflate(data, level), Format.Raw) == data, "{name} {level} raw")
            assert(inflated(zlib_stream(data, level), Format.Zlib) == data, "{name} {level} zlib")
            assert(inflated(gzip_stream(data, level), Format.Gzip) == data, "{name} {level} gzip")
        }
    }
}

@test
fn levels() {
    let data = repeated("the quick brown fox jumps over the lazy dog ", 300)
    let stored = deflate(data, 0)
    let literals = deflate(data, 1)
    let matched = deflate(data, 6)
    // One stored block, the last: its header, its length and the length's complement.
    let size = data.len()
    assert(stored[0..5] == [1u8, u8.wrap(size & 0xFF), u8.wrap(size >> 8), u8.wrap((size ^ 0xFFFF) & 0xFF), u8.wrap((size ^ 0xFFFF) >> 8)])
    assert(stored[5..stored.len()] == data)
    let big_data = joined(noise(70000, 3), repeated("z", 70000))
    let big = deflate(big_data, 0)
    // The first two of three aren't last.
    assert(big[0] == 0 and big[5 + 65535] == 0)
    assert(big.len() == big_data.len() + 3 * 5)
    assert(matched.len() < literals.len())
    assert(deflate(data, 9) == matched)
    assert(deflate([], 0) == [1u8, 0, 0, 0xFF, 0xFF])
    // An empty fixed block: its header and the end code, 10 bits.
    assert(deflate([]) == [3u8, 0])
}

@test
fn zlib_headers_mark_the_level_as_zlib_does() {
    let marks: List<(i64, u8)> = [(0, 0x01), (1, 0x01), (2, 0x5E), (5, 0x5E), (6, 0x9C), (-1, 0x9C), (7, 0xDA), (9, 0xDA)]
    for (level, mark) in marks {
        let stream = zlib_stream(repeated("abc", 1), level)
        assert(stream[0..2] == [0x78u8, mark], "{level}")
    }
}

@test
fn gzip_member() {
    let g = gzip_stream(repeated("level.dat", 1))
    assert(g[0..10] == gzip_header())
    assert(g[g.len() - 4..g.len()] == [9u8, 0, 0, 0])
    var named: List<u8> = [0x1F, 0x8B, 0x08, 0x08, 0, 0, 0, 0, 0, 0xFF]
    named.extend(repeated("name", 1))
    named.push(0)
    assert(inflated(gzip_with(repeated("x", 1), 6, named), Format.Gzip) == repeated("x", 1))
}

/// The case files hold these streams; a change here changes them, and vanilla's hashes.
@test
fn bytes_are_pinned() {
    // Three literals, then 9 bytes from 3 back.
    assert(hex(deflate(repeated("abc", 4))) == "4b4c4a862300")
    assert(hex(zlib_stream(repeated("hello hello hello", 1), 6)) == "789ccb48cdc9c9574022013a2e067d")
}
