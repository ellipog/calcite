module rig.runner.tests.test_savediff

// Tests for rig/runner/savediff.calx, which compares what two servers saved of the same chunks
// (CAL-145, CAL-253):
//
//     calx test rig/runner/tests/test_savediff.calx

import std.fs.{make_dir_all, remove_dir_all, temp_dir}
import std.nbt.{Tag, parse_snbt}
import std.nbt.region.{RegionFile}
import std.path
import rig.runner.savediff.{chunk_differences, chunks, compare}
import tools.pynbt.{py_repr, same}

fn s(text: str) -> Tag {
    return Tag.String(String(text))
}

fn compound(members: List<(str, Tag)>) -> Tag {
    var t = Tag.Compound(LinkedMap<String, Tag>())
    for (k, v) in members {
        _ = t.insert(String(k), v.copy())
    }
    return t
}

fn snbt(text: String) -> Tag {
    return match parse_snbt(text.copy()) {
        ok(t) => t,
        err(e) => panic("{text}: {e}"),
    }
}

/// `indices` packed as `SimpleBitStorage` packs them, none across two longs, as signed longs.
fn packed(indices: List<usize>, bits: u32) -> List<i64> {
    let per = usize(64 / bits)
    var longs: List<u64> = []
    for _ in 0..(indices.len() + per - 1) / per {
        longs.push(0)
    }
    for (i, v) in indices.enumerate() {
        longs[i / per] |= u64(v) << u64((i % per) * usize(bits))
    }
    var out: List<i64> = []
    for v in longs {
        out.push(i64.wrap(v))
    }
    return out
}

fn bits_for(palette: usize) -> u32 {
    var needed = 0u32
    var n = palette - 1
    while n > 0 {
        needed += 1
        n >>= 1
    }
    return if needed > 4 { needed } else { 4 }
}

fn section(y: i8, palette: List<Tag>, indices: List<usize>, light: List<(str, Tag)>) -> Tag {
    var states = compound([("palette", Tag.List(palette.copy()))])
    if not indices.is_empty() {
        _ = states.insert(String("data"), Tag.LongArray(packed(indices, bits_for(palette.len()))))
    }
    var out = compound([("Y", Tag.Byte(y)), ("block_states", states)])
    for (k, v) in light {
        _ = out.insert(String(k), v.copy())
    }
    return out
}

fn chunk(sections: List<Tag>, entities: List<Tag>, rest: List<(str, Tag)>) -> Tag {
    var out = compound([("sections", Tag.List(sections.copy())), ("block_entities", Tag.List(entities.copy())), ("Status", s("minecraft:full"))])
    for (k, v) in rest {
        _ = out.insert(String(k), v.copy())
    }
    return out
}

fn repeat(v: usize, n: usize) -> List<usize> {
    var out: List<usize> = []
    for _ in 0..n {
        out.push(v)
    }
    return out
}

fn joined(parts: List<List<usize>>) -> List<usize> {
    var out: List<usize> = []
    for p in parts {
        out.extend(p)
    }
    return out
}

@test
fn states_by_place_not_palette() {
    // The same blocks with their palettes in another order are the same.
    let stone_first = joined([[1usize].to_list(), repeat(0, 4095)])
    let a = chunk([section(0, [compound([("", s("minecraft:air"))]), compound([("", s("minecraft:stone"))])], stone_first, [])], [], [])
    let b = chunk([section(0, [compound([("", s("minecraft:stone"))]), s("minecraft:air")], joined([[0usize].to_list(), repeat(1, 4095)]), [])], [], [])
    assert(chunk_differences(0, 0, a, b, 5).is_empty())
}

@test
fn a_block_that_differs() {
    let a = chunk([section(-1, [s("minecraft:air")], [], [])], [], [])
    let oak = compound([("id", s("minecraft:oak_log")), ("properties", compound([("axis", s("x"))]))])
    let b = chunk([section(-1, [s("minecraft:air"), oak], joined([repeat(0, 17), [1usize].to_list(), repeat(0, 4078)]), [])], [], [])
    let got = chunk_differences(2, 3, a, b, 5)
    assert(got == ["block 33, -16, 49: minecraft:air vs minecraft:oak_log[axis=x]"], "{got}")
}

@test
fn blocks_past_the_ones_shown() {
    let a = chunk([section(0, [s("minecraft:air")], [], [])], [], [])
    let b = chunk([section(0, [s("minecraft:stone")], [], [])], [], [])
    let got = chunk_differences(0, 0, a, b, 2)
    assert(got == ["block 0, 0, 0: minecraft:air vs minecraft:stone", "block 1, 0, 0: minecraft:air vs minecraft:stone", "4094 more blocks differ"], "{got}")
}

@test
fn block_entities_and_ticks() {
    let chest = snbt(String(#"{id: "minecraft:chest", x: 1, y: 2, z: 3, Items: []}"#))
    var full = chest.copy()
    _ = full.insert(String("Items"), Tag.List([snbt(String(#"{id: "minecraft:stone", count: 1, Slot: 0}"#))]))
    let tick = snbt(String(#"{i: "minecraft:water", x: 1, y: 2, z: 3, t: 5, p: 0}"#))
    let a = chunk([], [chest], [("block_ticks", Tag.List([tick]))])
    let b = chunk([], [full], [("block_ticks", Tag.List(List<Tag>()))])
    let got = chunk_differences(0, 0, a, b, 5)
    assert(got.len() == 3, "{got}")
    assert(got[0] == #"block entity 1, 2, 3: {'id': 'minecraft:chest', 'Items': []} vs {'id': 'minecraft:chest', 'Items': [{'id': 'minecraft:stone', 'count': 1, 'Slot': 0}]}"#, got[0])
    assert(got[1] == "block_ticks: 1 only vanilla's, 0 only Calcite's", got[1])
    assert(got[2] == "  only vanilla's: i minecraft:water, p 0, t 5, x 1, y 2, z 3", got[2])
}

fn ticked(t: i32, saved: i64) -> Tag {
    let tick = snbt("\{i: \"minecraft:big_dripleaf\", x: 1, y: 2, z: 3, t: {t}, p: 0\}")
    return chunk([], [], [("block_ticks", Tag.List([tick])), ("LastUpdate", Tag.Long(saved))])
}

@test
fn ticks_by_when_due() {
    // The same tick, due at game time 223, saved 17 ticks off at 206 and 18 off at 205, is the
    // same (D541); one due at another time isn't.
    assert(chunk_differences(0, 0, ticked(17, 206), ticked(18, 205), 5).is_empty())
    let late = chunk_differences(0, 0, ticked(17, 206), ticked(19, 205), 5)
    assert(late == ["block_ticks: 1 only vanilla's, 1 only Calcite's", "  only vanilla's: i minecraft:big_dripleaf, p 0, t 223, x 1, y 2, z 3", "  only Calcite's: i minecraft:big_dripleaf, p 0, t 224, x 1, y 2, z 3"], "{late}")
}

@test
fn times_left_out() {
    let a = chunk([], [], [("LastUpdate", Tag.Long(254)), ("InhabitedTime", Tag.Long(40))])
    let b = chunk([], [], [("LastUpdate", Tag.Long(274)), ("InhabitedTime", Tag.Long(12))])
    assert(chunk_differences(0, 0, a, b, 5).is_empty())
}

@test
fn numbers_compare_as_python_compared_them() {
    // nbt.py read a byte and an int as Python's `int`, and an array and a list as a `list`, so
    // the same numbers in other kinds are the same.
    let a = chunk([], [], [("isLightOn", Tag.Byte(1)), ("Heightmaps", compound([("WORLD_SURFACE", Tag.LongArray([1i64, 2].to_list()))]))])
    let b = chunk([], [], [("isLightOn", Tag.Int(1)), ("Heightmaps", compound([("WORLD_SURFACE", Tag.List([Tag.Long(1), Tag.Long(2)]))]))])
    assert(chunk_differences(0, 0, a, b, 5).is_empty())
    let c = chunk([], [], [("isLightOn", Tag.Double(1.5)), ("Heightmaps", compound([("WORLD_SURFACE", Tag.LongArray([1i64, 2].to_list()))]))])
    let got = chunk_differences(0, 0, a, c, 5)
    assert(got == ["isLightOn: 1 vs 1.5"], "{got}")
    assert(same(Tag.Float(0.5), Tag.Double(0.5)) and not same(Tag.Float(0.1), Tag.Double(0.1)))
    assert(py_repr(Tag.Float(0.1)) == "0.10000000149011612")
    assert(py_repr(compound([("a", Tag.List([s("it's"), Tag.IntArray([1i32, -2].to_list())]))])) == #"{'a': ["it's", [1, -2]]}"#)
}

@test
fn the_sky_under_the_world() {
    // A sky layer of 0s under the world is as none, which vanilla gives some chunks and not
    // others; one elsewhere, or with light in it, isn't.
    var zeros: List<i8> = []
    var lit_layer: List<i8> = []
    for _ in 0..2048 {
        zeros.push(0)
        lit_layer.push(0x11)
    }
    let air: List<Tag> = [s("minecraft:air")]
    let a = chunk([section(-5, air.copy(), [], [("SkyLight", Tag.ByteArray(zeros.copy()))]), section(-4, air.copy(), [], [])], [], [])
    let b = chunk([section(-4, air.copy(), [], [])], [], [])
    assert(chunk_differences(0, 0, a, b.copy(), 5).is_empty())
    let lit = chunk([section(-5, air.copy(), [], [("SkyLight", Tag.ByteArray(lit_layer))]), section(-4, air.copy(), [], [])], [], [])
    let got = chunk_differences(0, 0, lit, b.copy(), 5)
    assert(got == ["light differs in 1 layers, the first section -5's SkyLight"], "{got}")
    let dark = chunk([section(-5, air.copy(), [], []), section(-4, air.copy(), [], [("SkyLight", Tag.ByteArray(zeros))])], [], [])
    assert(chunk_differences(0, 0, dark, b, 5).len() == 1)
}

fn world_with(root: String, side: str, chunk_root: Tag, entity: Tag) -> String {
    let world = path.join(root, side)
    let dimension = path.join(path.join(world.copy(), "dimensions"), "minecraft/overworld")
    for folder in ["region", "entities"] {
        make_dir_all(path.join(dimension.copy(), folder))!
    }
    var region = RegionFile.open(path.join(path.join(dimension.copy(), "region"), "r.-1.0.mca"))!
    region.write(-1, 0, chunk_root)!
    region.close()!
    var entities = RegionFile.open(path.join(path.join(dimension.copy(), "entities"), "r.-1.0.mca"))!
    entities.write(-1, 0, compound([("Entities", Tag.List([entity.copy()]))]))!
    entities.close()!
    return world
}

@test
fn worlds_read_from_their_region_files() {
    let root = temp_dir()!
    let pig = snbt(String(#"{id: "minecraft:pig", UUID: [I; 1, 2, 3, 4], Age: 5, Health: 10.0f, attributes: [{id: "a"}, {id: "b"}]}"#))
    var other = pig.copy()
    _ = other.insert(String("Age"), Tag.Int(9))
    _ = other.insert(String("attributes"), snbt(String(#"[{id: "b"}, {id: "a"}]"#)))
    _ = other.insert(String("Health"), Tag.Float(8.0))
    let air: List<Tag> = [s("minecraft:air")]
    let v = world_with(root.copy(), "vanilla", chunk([section(4, air.copy(), [], [])], [], []), pig)
    let c = world_with(root.copy(), "calcite", chunk([section(4, [s("minecraft:stone")], [], [])], [], []), other)
    let found = chunks(v.copy(), String("minecraft/overworld"), String("region"))
    assert(found.len() == 1 and found.contains((-1i64, 0i64)))
    let lines = compare(v, c, (-1, -1, 0, 0), 1)
    remove_dir_all(root)!
    // The age is when the server stopped, and the attributes in any order are the same.
    assert(lines == ["chunk -1, 0: block -16, 64, 0: minecraft:air vs minecraft:stone", "chunk -1, 0: 4095 more blocks differ", "entities -1, 0: minecraft:pig Health: 10.0 vs 8.0"], "{lines}")
}
