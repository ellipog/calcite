module rig.runner.tests.test_tapediff

// Tests for rig/runner/tapediff.calx, which lines up two RNG tapes level by level (D312, CAL-253):
//
//     calx test rig/runner/tests/test_tapediff.calx

import std.fs.{remove_dir_all, temp_dir, write_text}
import std.path
import rig.runner.tapediff.{compare, read}

const VANILLA: str = "# seed 1103\nminecraft:overworld 0 31 5 Weather.tick:1 Level.tick:2\nminecraft:overworld 1 31 6\nminecraft:overworld 1 24 7\nminecraft:overworld 9 31 8\n# end minecraft:overworld 9\n# end minecraft:the_end 4\n"
const CALCITE: str = "minecraft:overworld 0 31 5\nminecraft:overworld 1 31 6\nminecraft:overworld 1 24 7\nminecraft:overworld 10 31 9\n# end minecraft:overworld 10\n"
const PARTED: str = "minecraft:overworld 0 31 5\nminecraft:overworld 1 31 1\nminecraft:overworld 1 24 7\n# end minecraft:overworld 10\n"

@test
fn tapes_line_up_before_the_end() {
    let dir = temp_dir()!
    write_text(path.join(dir.copy(), "v.txt"), String(VANILLA))!
    write_text(path.join(dir.copy(), "c.txt"), String(CALCITE))!
    write_text(path.join(dir.copy(), "p.txt"), String(PARTED))!
    let v = read(path.join(dir.copy(), "v.txt"))
    let c = read(path.join(dir.copy(), "c.txt"))
    let p = read(path.join(dir.copy(), "p.txt"))
    remove_dir_all(dir)!
    let overworld = v[String("minecraft:overworld")].copy()
    assert(overworld.draws.len() == 4 and overworld.end == some(9i64))
    assert(overworld.draws[0].site == "Weather.tick:1 Level.tick:2" and overworld.draws[1].site.is_empty())
    // Only the draws before the earlier end count, and a level with no draws is the same.
    assert(not compare(v.copy(), c.copy(), 3, none))
    assert(compare(v.copy(), p.copy(), 3, none))
}
