// A ping-only adapter for the runner's own tests, so they never need Calcite's build.
//
// It speaks the rig protocol (rig/PROTOCOL.md) and implements only `ping`, so every other probe
// scores as unimplemented. It was Calcite's stub adapter until Calcite's own replaced it (D87).
// Written from PROTOCOL.md alone, sharing no code with the runner, to keep the contract honest.
// It imports only std, so it runs from this folder, whose name has a hyphen.

import std.bytes
import std.io.{flush, read_exact, write}
import std.json
import std.json.{Json}
import std.process.{exit}

const PROTOCOL: i64 = 1

/// The next frame on standard input, or none at its end.
fn read_frame() -> (Json, List<List<u8>>)? {
    var head = List<u8>()
    if not read_exact(mut head, 4) {
        return none
    }
    let length = usize(bytes.u32_be(head, 0))
    var text = List<u8>()
    if not read_exact(mut text, length) {
        return none
    }
    let header = match json.parse(String.from_utf8(text) ?? String("")) {
        ok(h) => h,
        err(_) => return none,
    }
    var blobs: List<List<u8>> = []
    if let Json.Array(lengths) = header.get("blobs") ?? Json.Null {
        for n in lengths {
            var blob = List<u8>()
            if not read_exact(mut blob, usize.wrap(n.as_u64() ?? 0)) {
                return none
            }
            blobs.push(blob)
        }
    }
    return some((header, blobs))
}

fn write_frame(header: LinkedMap<String, Json>, blobs: List<List<u8>>) {
    var h = header.copy()
    var lengths: List<Json> = []
    for b in blobs {
        lengths.push(Json.Int(i64.wrap(b.len())))
    }
    h.insert("blobs", Json.Array(lengths))
    let data = "{Json.Object(h)}".to_bytes()
    var out = List<u8>()
    bytes.put_u32_be(mut out, u32.wrap(data.len()))
    out.extend(data)
    for b in blobs {
        out.extend(b)
    }
    write(out)
    flush()
}

fn text_of(v: own Json?) -> String {
    if let Json.Str(s) = v ?? Json.Null {
        return s
    }
    return String("None")
}

fn main() {
    while let (header, blobs) = read_frame() {
        let kind = text_of(header.get("type"))
        var reply = LinkedMap<String, Json>()
        if kind == "hello" {
            var probes = LinkedMap<String, Json>()
            probes.insert("ping", Json.Int(1))
            var about = LinkedMap<String, Json>()
            about.insert("stage", Json.Str("stub"))
            reply.insert("type", Json.Str("hello"))
            reply.insert("protocol", Json.Int(PROTOCOL))
            reply.insert("adapter", Json.Str("ping-only"))
            reply.insert("game_version", Json.Str("26.3"))
            reply.insert("probes", Json.Object(probes))
            reply.insert("about", Json.Object(about))
            write_frame(reply, [])
        } else if kind == "run" {
            let probe = text_of(header.get("probe"))
            reply.insert("type", Json.Str("result"))
            reply.insert("id", header.get("id") ?? Json.Null)
            if probe == "ping" {
                var output = LinkedMap<String, Json>()
                let input = header.get("input") ?? Json.Object(LinkedMap<String, Json>())
                output.insert("echo", input.get("echo") ?? Json.Null)
                reply.insert("output", Json.Object(output))
                reply.insert("status", Json.Str("ok"))
                write_frame(reply, blobs)
            } else {
                reply.insert("output", Json.Object(LinkedMap<String, Json>()))
                reply.insert("status", Json.Str("unimplemented"))
                reply.insert("message", Json.Str("no `{probe}` probe here"))
                write_frame(reply, [])
            }
        } else if kind == "bye" {
            reply.insert("type", Json.Str("bye"))
            write_frame(reply, [])
            exit(0)
        } else {
            reply.insert("type", Json.Str("result"))
            reply.insert("id", header.get("id") ?? Json.Null)
            reply.insert("status", Json.Str("error"))
            reply.insert("output", Json.Object(LinkedMap<String, Json>()))
            reply.insert("message", Json.Str("unknown message type `{kind}`"))
            write_frame(reply, [])
        }
    }
    exit(1)
}
