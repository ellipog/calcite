module rig.runner.tests.test_generators

// Each case generator written in Calx, cases/*/gen.calx, must write its committed file again
// exactly, on every machine (D249). Those that read vanilla's IDs from the pinned jar are skipped
// where it hasn't been fetched. The generators still in Python are test_generators.py's.
//
//     calx test rig/runner/tests/test_generators.calx

import std.fs.{glob, is_file, read, read_text, remove_file, write}
import std.process.{Command}
import tools.repo.{find_calx, root, under}

/// Every JSON file under cases/ and its bytes.
fn snapshot() -> LinkedMap<String, List<u8>> {
    var out = LinkedMap<String, List<u8>>()
    for file in glob("{under("cases")}/**/*.json")! {
        out.insert(file.copy(), read(file)!)
    }
    return out
}

/// Puts cases/ back as `before` had it, and gives the files that weren't as it had them.
fn restore(before: LinkedMap<String, List<u8>>) -> List<String> {
    var changed: List<String> = []
    let after = snapshot()
    for (file, data) in after {
        if let was = before.find(file) {
            if was != data {
                changed.push(file.copy())
                write(file.copy(), was.copy())!
            }
        } else {
            changed.push(file.copy())
            remove_file(file.copy())!
        }
    }
    for (file, data) in before {
        if not after.contains(file) {
            changed.push(file.copy())
            write(file.copy(), data.copy())!
        }
    }
    return changed
}

@test
fn every_generator_writes_its_committed_file() {
    let jar = under("oracle/jars/server-26.3.jar")
    let calx = find_calx()
    var problems: List<String> = []
    for generator in glob("{under("cases")}/*/gen.calx")! {
        let text = read_text(generator.copy())! ?? String("")
        // cases/jar.calx reads the jar for those that import it.
        if not is_file(jar) and (text.contains("server-26.3.jar") or text.contains("cases.jar")) {
            println("skipped {generator}: no oracle/jars/server-26.3.jar; oracle/fetch.calx fetches it")
            continue
        }
        let before = snapshot()
        let ran = Command.new(calx.copy()).args([generator.copy()]).dir(root()).output()!
        let changed = restore(before)
        if not ran.status.success() {
            problems.push("{generator} ended with {ran.status}: {ran.error_text()}")
        } else if not changed.is_empty() {
            problems.push("{generator} doesn't match its committed output; rerun it: {changed}")
        }
    }
    assert(problems.is_empty(), problems.join("\n"))
}
