module rig.runner.tests.test_sessions

// Tests for the protocol suites' runner, rig/runner/sessions.calx, and its configurations
// (session_configs.calx, session_data.calx), offline: what a server's folder is given, and the
// comparisons' Python-shaped equality and messages (CAL-253):
//
//     calx test rig/runner/tests/test_sessions.calx

import std.fs.{is_file, read_text, remove_dir_all, temp_dir}
import std.json
import std.json.{Json}
import std.nbt.{NbtFile, Tag, parse_snbt}
import std.path
import rig.runner.servers.{BOT, MATE, offline_uuid}
import rig.runner.session_configs.{SCENARIOS, configs}
import rig.runner.sessions.{bytes_repr, json_same, kept, kept_repr, mate_scenario, other_scenarios, prepare, same_kind}
import tools.repo.{under}

fn text(file: String) -> String {
    return read_text(file)! ?? String("")
}

fn tag(snbt: str) -> Tag {
    return parse_snbt(String(snbt))!
}

fn parsed(source: str) -> Json {
    return json.parse(String(source))!
}

@test
fn offline_uuids_are_the_ones_python_gave() {
    // sessions.py's BOT_INTS and MATE_INTS, the UUIDs as four ints.
    assert(offline_uuid(String(BOT)) == "bb19ef2f-2f95-39a8-8bad-bda3ed373847")
    assert(offline_uuid(String(MATE)) == "06495729-c101-35aa-ab9d-96baa54a51c9")
}

@test
fn every_configuration_builds_from_known_parts() {
    let all = configs()
    assert(all.len() == 157)
    var known: List<String> = []
    for s in SCENARIOS {
        known.push(String(s))
    }
    known.extend(other_scenarios())
    for (name, c) in all {
        assert(not c.scenarios.is_empty())
        for s in c.scenarios {
            assert(known.contains(s.copy()))
        }
        if let f = c.fixture {
            // Each fixture's commands are in rig/fixtures/.
            assert(is_file(under("rig/fixtures/{f}.txt")))
            assert(c.world == some("build/rig/fixtures/{f}/world"))
        }
        if c.mate != none {
            var has = false
            for s in c.scenarios {
                if mate_scenario(s.copy()) != none {
                    has = true
                }
            }
            assert(has)
        }
        assert(name.len() > 0)
    }
}

@test
fn a_folder_has_the_files_python_wrote() {
    let dir = temp_dir()!
    let all = configs()
    var c = all[String("dig")].copy()
    c.world = none
    prepare(path.join(dir.copy(), "calcite"), c.copy(), 25565, false)
    prepare(path.join(dir.copy(), "vanilla"), c.copy(), 25566, true)
    let props = text(path.join(dir.copy(), "calcite/server.properties"))
    assert(props == "online-mode=false\nserver-ip=127.0.0.1\nlevel-type=minecraft\\:flat\ngenerate-structures=false\nlevel-seed=calcite\ndifficulty=peaceful\nview-distance=3\nsimulation-distance=3\npause-when-empty-seconds=2\nspawn-protection=1\nserver-port=25565\n")
    let whitelist = text(path.join(dir.copy(), "calcite/whitelist.json"))
    assert(whitelist == "[\n  \{\n    \"uuid\": \"bb19ef2f-2f95-39a8-8bad-bda3ed373847\",\n    \"name\": \"Bot\"\n  \}\n]\n")
    let ops = text(path.join(dir.copy(), "calcite/ops.json"))
    assert(ops.contains("    \"name\": \"Op\",\n    \"level\": 4,\n    \"bypassesPlayerLimit\": false\n"))
    assert(text(path.join(dir.copy(), "calcite/calcite.properties")) == "console-dashboard=off\nrecord-inputs=false\nlevel-random-seed=1103\n")
    assert(text(path.join(dir.copy(), "vanilla/eula.txt")) == "eula=true\n")
    assert(not is_file(path.join(dir.copy(), "vanilla/calcite.properties")))
    // Calcite's flat world is given its game rules, the respawn at the spawn; vanilla's is typed.
    let rules = NbtFile.open(path.join(dir.copy(), "calcite/world/data/minecraft/game_rules.dat"))!.root
    assert(same_kind(rules, tag(#"{data: {"minecraft:respawn_radius": 0}, DataVersion: 5023}"#), true))
    assert(not is_file(path.join(dir.copy(), "vanilla/world/data/minecraft/game_rules.dat")))
    // The bot's data, as the configuration has it.
    let player = NbtFile.open(path.join(dir.copy(), "calcite/world/players/data/bb19ef2f-2f95-39a8-8bad-bda3ed373847.dat"))!.root
    assert(same_kind(player, c.player ?? Tag.End, true))
    remove_dir_all(dir)!
}

@test
fn kinds_and_order_count_where_python_typed_them() {
    assert(not same_kind(tag(#"{a: 1b}"#), tag(#"{a: 1}"#), false))
    assert(same_kind(tag(#"{a: 1b, b: "x"}"#), tag(#"{b: "x", a: 1b}"#), false))
    assert(not same_kind(tag(#"{a: 1b, b: "x"}"#), tag(#"{b: "x", a: 1b}"#), true))
    assert(not same_kind(tag("[I; 1, 2]"), tag("[1, 2]"), false))
    assert(same_kind(tag(#"[{a: 1.5f}, {a: 2.0d}]"#), tag(#"[{a: 1.5f}, {a: 2.0d}]"#), true))
    assert(not same_kind(tag(#"[{a: 1.5f}]"#), tag(#"[{a: 1.5d}]"#), true))
}

@test
fn progress_is_kept_and_written_as_python_had_it() {
    let a = parsed(#"{"minecraft:story/root": {"criteria": {"crafting_table": "2026-11-12 10:30:01 +0100"}, "done": true}, "DataVersion": 5023}"#)
    let b = parsed(#"{"minecraft:story/root": {"criteria": {"crafting_table": "2026-11-12 10:31:59 +0100"}, "done": true}, "DataVersion": 5023}"#)
    // The times are only that each was obtained.
    assert(json_same(kept(a.copy(), false), kept(b.copy(), false)))
    let root = a.get(String("minecraft:story/root"))!
    assert(kept_repr(root, true) == "[('criteria', [('crafting_table', True)]), ('done', True)]")
    assert(kept_repr(a.get(String("DataVersion"))!, true) == "5023")
    // The members' order counts, as the pairs did.
    let c = parsed(#"{"DataVersion": 5023, "minecraft:story/root": {"criteria": {"crafting_table": "x"}, "done": true}}"#)
    assert(not json_same(kept(a, false), kept(c, false)))
}

@test
fn numbers_are_the_same_as_python_compared_them() {
    assert(json_same(parsed("5"), parsed("5.0")))
    assert(json_same(parsed("true"), parsed("1")))
    assert(json_same(parsed(#"{"a": 1, "b": 2}"#), parsed(#"{"b": 2, "a": 1}"#)))
    assert(not json_same(parsed("[1, 2]"), parsed("[2, 1]")))
    assert(not json_same(parsed("null"), parsed("0")))
}

@test
fn bytes_are_written_as_python_reprs_them() {
    assert(bytes_repr("\{\"pack\": 1\}\n".to_bytes()) == #"b'{"pack": 1}\n'"#)
    assert(bytes_repr("it's".to_bytes()) == "b\"it's\"")
    assert(bytes_repr("it's \"x\"".to_bytes()) == "b'it\\'s \"x\"'")
    assert(bytes_repr([0u8, 9u8, 13u8, 92u8, 127u8, 233u8]) == "b'\\x00\\t\\r\\\\\\x7f\\xe9'")
}
