module rig.runner.tests.test_sessiondiff

// Tests for the protocol suites' comparison, rig/runner/sessiondiff.calx, on sessions written by
// hand as SessionDump writes them (CAL-253):
//
//     calx test rig/runner/tests/test_sessiondiff.calx

import std.fs.{make_dir_all, remove_dir_all, temp_dir, write_text}
import std.json
import std.json.{Json}
import std.path
import rig.runner.sessiondiff.{Finding, Report, ZERO_LAYER, every, first_obtained, ordered_by_the_clock, run}
import tools.difflib.{opcodes}

fn packet(state: str, kind: str, value: String, sha: String) -> String {
    return #"{"state": "#{state}", "size": 1, "sha256": "#{sha}", "kind": "#{kind}", "value": #{value}}"#
}

fn play(kind: str, value: String, sha: String) -> String {
    return packet("play", kind, value, sha)
}

fn mark(m: String) -> String {
    return #"{"mark": "#{m}"}"#
}

fn step(name: str) -> String {
    return mark("step {name}")
}

fn write_side(root: String, config: str, side: str, scenario: str, lines: List<String>) {
    let folder = path.join(path.join(root.copy(), config), side)
    make_dir_all(folder.copy())!
    var text = String("")
    for l in lines {
        text.push_str(l)
        text.push_str("\n")
    }
    write_text(path.join(folder, "{scenario}.jsonl"), text)!
}

/// The comparison of a `join` scenario in configuration `c`, with `md` as a difference file if
/// it isn't empty.
fn compare(vanilla: List<String>, calcite: List<String>, md: str) -> Report {
    let root = temp_dir()!
    write_side(root.copy(), "c", "vanilla", "join", vanilla)
    write_side(root.copy(), "c", "calcite", "join", calcite)
    let differences = path.join(root.copy(), "differences")
    make_dir_all(differences.copy())!
    if not md.is_empty() {
        write_text(path.join(differences.copy(), "x.md"), String(md))!
    }
    let report = run(root.copy(), ["c"], every(["c"], ["join"]), differences, 3, true)
    remove_dir_all(root)!
    return report
}

/// Each finding as `key | what`, sorted.
fn found(r: Report) -> List<String> {
    var out: List<String> = []
    for f in r.findings {
        out.push("{f.key} | {f.what}")
    }
    out.sort()
    return out
}

/// Each finding as `key | what | detail`, in the order found.
fn found_in_order(r: Report) -> List<String> {
    var out: List<String> = []
    for f in r.findings {
        out.push("{f.key} | {f.what}")
    }
    return out
}

fn js(t: String) -> Json {
    return match json.parse(t.copy()) {
        ok(v) => v,
        err(e) => panic("{t}: {e}"),
    }
}

/// A progress file whose advancements were each first obtained at the second given.
fn progress(firsts: List<(str, str)>) -> Json {
    var parts: List<String> = []
    for (k, s) in firsts {
        parts.push(#""#{k}": {"criteria": {"c": "2026-11-10 09:14:#{s} +0000"}, "done": true}"#)
    }
    return js("\{{parts.join(", ")}\}")
}

@test
fn progress_ordered_by_the_clock() {
    // After a reload, advancements obtained within a second may swap places; others may not.
    let vanilla = first_obtained(progress([("a", "48"), ("b", "48"), ("c", "50")]))
    let calcite = first_obtained(progress([("a", "11"), ("b", "10"), ("c", "13")]))
    assert(ordered_by_the_clock(["a", "b", "c"], ["b", "a", "c"], vanilla.copy(), calcite.copy()))
    assert(not ordered_by_the_clock(["a", "b", "c"], ["c", "a", "b"], vanilla.copy(), calcite.copy()))
    assert(ordered_by_the_clock(["a", "b", "c"], ["a", "b", "c"], vanilla, calcite))
}

@test
fn first_obtained_reads_the_zone() {
    let times = first_obtained(js(#"{"a": {"criteria": {"x": "2026-11-10 09:14:48 +0100", "y": "2026-11-10 09:14:50 +0000"}}, "b": {"criteria": {}}, "c": 3}"#))
    assert(times.len() == 2)
    assert((times.get(String("a")) ?? none) == some(1794298488.0))
    assert((times.get(String("b")) ?? some(0.0)) == none)
}

@test
fn same_sessions_pass() {
    let session: List<String> = [step("configuration"), packet("configuration", "custom_payload", #"{"brand": "vanilla"}"#, "00"), step("join"), play("set_time", #"{"gameTime": 5}"#, "aa"), play("login", #"{"playerId": 1}"#, "00")]
    var later = session.copy()
    later[3] = play("set_time", #"{"gameTime": 9}"#, "bb")
    let report = compare(session, later, "")
    assert(report.passed)
    assert(report.findings.is_empty(), "{found(report)}")
}

@test
fn keep_alives_a_step_apart() {
    // A keep-alive goes by the wall clock, so one a step before or after the other server's is
    // the same; two steps apart, it isn't.
    let alive = play("keep_alive", #"{"id": 1}"#, "00")
    let vanilla: List<String> = [step("join"), alive.copy(), step("a"), step("b"), alive.copy(), step("c"), step("d")]
    let calcite: List<String> = [step("join"), step("a"), alive.copy(), step("b"), step("c"), step("d"), alive.copy()]
    let report = compare(vanilla, calcite, "")
    assert(found(report) == ["session:join/b/keep_alive | only vanilla sends it", "session:join/d/keep_alive | only Calcite sends it"], "{found(report)}")
}

fn lit_chunk(x: i64, sky: str, empty: str, updates: List<String>) -> String {
    var quoted: List<String> = []
    for u in updates {
        quoted.push("\"{u}\"")
    }
    let light = #"{"@": "ClientboundLightUpdatePacketData", "skyYMask": "#{sky}", "emptySkyYMask": "#{empty}", "skyUpdates": [#{quoted.join(", ")}]}"#
    return play("level_chunk_with_light", #"{"x": #{x}, "z": 0, "lightData": #{light}}"#, "c{x}")
}

@test
fn sky_under_the_world() {
    // A chunk whose sky layer under the world is 2048 bytes of 0 matches one whose layer there is
    // empty, as vanilla's light makes it either way from run to run (CAL-122); a layer there that
    // isn't all 0 still differs.
    let zero = String(ZERO_LAYER)
    let other = String("2048 bytes, sha256 1111111111111111")
    let done = play("chunk_batch_finished", #"{"batchSize": 3}"#, "00")
    let vanilla: List<String> = [step("join"), lit_chunk(0, #"{0, 1}"#, #"{}"#, [zero.copy(), other.copy()]), lit_chunk(1, #"{1}"#, #"{0}"#, [other.copy()]), lit_chunk(2, #"{0, 1}"#, #"{}"#, [other.copy(), other.copy()]), done.copy()]
    let calcite: List<String> = [step("join"), lit_chunk(0, #"{1}"#, #"{0}"#, [other.copy()]), lit_chunk(1, #"{0, 1}"#, #"{}"#, [zero.copy(), other.copy()]), lit_chunk(2, #"{1}"#, #"{0}"#, [other.copy()]), done.copy()]
    let report = compare(vanilla, calcite, "")
    assert(found_in_order(report) == ["session:join/join/level_chunk_with_light | chunk (2, 0) differs"], "{found_in_order(report)}")
}

fn motion(x: i64) -> String {
    return play("set_entity_motion", #"{"id": 2, "movement": {"x": #{x}}}"#, "m{x}")
}

@test
fn entities() {
    // An item's packets are lined up by its ID across the steps (CAL-148): its moves may fall in
    // another step, its data among its moves elsewhere, and one side may send it a few more moves
    // before it goes; but a move that differs, or data only one side sends, is found. The bot's
    // own data stays in its step.
    let add = play("add_entity", #"{"id": 2, "uuid": "u"}"#, "a")
    let data = play("set_entity_data", #"{"id": 2, "packedItems": [1]}"#, "d")
    let mine = play("set_entity_data", #"{"id": 1, "packedItems": [0]}"#, "e")
    let gone = play("remove_entities", #"{"entityIds": [2]}"#, "r")
    let login = play("login", #"{"playerId": 1}"#, "00")
    let vanilla: List<String> = [step("join"), login.copy(), mine.copy(), add.copy(), motion(1), data.copy(), motion(2), step("two"), motion(3), gone.copy()]
    let calcite: List<String> = [step("join"), login.copy(), mine.copy(), add.copy(), motion(1), motion(2), step("two"), data.copy(), motion(3), motion(4), motion(5), gone.copy()]
    let report = compare(vanilla.copy(), calcite.copy(), "")
    assert(report.findings.is_empty(), "{found(report)}")
    var wrong = calcite.copy()
    wrong[5] = motion(9)
    let keys_wrong = found(compare(vanilla.copy(), wrong, ""))
    assert(keys_wrong == ["session:join/<entity>/set_entity_motion | entity 2: differs"], "{keys_wrong}")
    var twice = calcite[0..8]
    twice.push(data.copy())
    twice.extend(calcite[8..calcite.len()])
    let keys_twice = found(compare(vanilla, twice, ""))
    assert(keys_twice == ["session:join/<entity>/set_entity_data | entity 2: only Calcite sends it, in two"], "{keys_twice}")
}

const BRAND: str = "---\ntitle: Brand\nkind: identity\ncases:\n  - session:*/configuration/custom_payload\n---\n"

@test
fn differences_and_masks() {
    let vanilla: List<String> = [
        step("login"),
        packet("login", "login_finished", #"{"sessionId": "a", "profile": "Bot"}"#, "11"),
        step("configuration"),
        packet("configuration", "custom_payload", #"{"brand": "vanilla"}"#, "00"),
        step("join"),
        play("level_chunk_with_light", #"{"x": 0, "z": 0, "data": 1}"#, "c1"),
        play("level_chunk_with_light", #"{"x": 1, "z": 0, "data": 1}"#, "c2"),
        play("chunk_batch_finished", #"{"batchSize": 2}"#, "00"),
        play("commands", #"{"entries": 3}"#, "00"),
        play("player_info_update", #"{"entries": [{"profileId": "p", "latency": 0}]}"#, "l0"),
    ]
    let calcite: List<String> = [
        step("login"),
        packet("login", "login_finished", #"{"sessionId": "b", "profile": "Bot"}"#, "22"),
        step("configuration"),
        packet("configuration", "custom_payload", #"{"brand": "calcite"}"#, "00"),
        step("join"),
        play("level_chunk_with_light", #"{"x": 1, "z": 0, "data": 1}"#, "c9"),
        play("level_chunk_with_light", #"{"x": 0, "z": 0, "data": 1}"#, "c8"),
        play("chunk_batch_finished", #"{"batchSize": 2}"#, "00"),
        play("player_info_update", #"{"entries": [{"profileId": "p", "latency": 1}]}"#, "l1"),
    ]
    let report = compare(vanilla.copy(), calcite.copy(), "")
    // The session ID and a player's latency are drawn, and chunks are a set whose bytes vanilla
    // doesn't fix.
    assert(found(report) == ["session:join/configuration/custom_payload | differs", "session:join/join/commands | only vanilla sends it"], "{found(report)}")
    assert(not report.passed)
    let covered = compare(vanilla, calcite, BRAND)
    assert(covered.passed)
    assert(covered.lines.contains("  [c] session:join/configuration/custom_payload: differs (deliberate: x)"), "{covered.lines}")
    assert(covered.lines.contains("      .brand: \"vanilla\" vs \"calcite\""), "{covered.lines}")
}

@test
fn stale_difference_is_noted() {
    let session: List<String> = [step("configuration"), packet("configuration", "custom_payload", #"{"brand": "x"}"#, "00")]
    let report = compare(session.copy(), session, BRAND)
    assert(report.passed)
    assert(report.lines.contains("note: x covers no session that differs, so it may be out of date"), "{report.lines}")
    assert(report.lines.contains("configuration  PASS    1 match, 0 deliberate, 0 differ"), "{report.lines}")
}

fn chunk(x: i64, light: str, inside: str) -> String {
    return play("level_chunk_with_light", #"{"x": #{x}, "z": 0, "chunkData": {"buffer": "b", "blockEntitiesData": [#{inside}]}, "lightData": {"skyUpdates": ["#{light}"]}}"#, "00")
}

@test
fn chunks_that_differ_are_grouped() {
    let done = play("chunk_batch_finished", #"{"batchSize": 5}"#, "00")
    let vanilla: List<String> = [step("join"), chunk(0, "a", ""), chunk(1, "a", "\"chest\""), chunk(2, "a", ""), chunk(3, "b", ""), chunk(4, "a", ""), done.copy()]
    let calcite: List<String> = [step("join"), chunk(0, "a", ""), chunk(1, "a", ""), chunk(2, "c", ""), chunk(3, "c", ""), chunk(4, "a", ""), done.copy()]
    let report = compare(vanilla, calcite, "")
    var whats: List<String> = []
    for f in report.findings {
        whats.push(f.what.copy())
    }
    assert(whats == ["chunk (1, 0) differs", "2 more chunks differ"], "{whats}")
    assert(report.findings[0].detail == [".chunkData.blockEntitiesData: 1 items vs 0"], "{report.findings[0].detail}")
    assert(report.findings[1].detail == [".lightData.skyUpdates: (2,0) (3,0)"], "{report.findings[1].detail}")
    // The two chunks that are the same still count.
    assert((report.counts.get(String("play")) ?? panic("no play suite")).matched == 2)
}

fn block(x: i64, state: str) -> String {
    return play("block_update", #"{"pos": {"@": "BlockPos", "x": #{x}, "y": 0, "z": 0}, "blockState": "#{state}"}"#, "00")
}

fn section(x: i64, changes: str) -> String {
    return play("section_blocks_update", #"{"sectionPos": {"@": "SectionPos", "x": #{x}, "y": 0, "z": 0}, "positions": #{changes}}"#, "00")
}

fn with_detail(f: Finding) -> String {
    return "{f.key} | {f.what} | {f.detail.join(" / ")}"
}

@test
fn block_changes_in_any_order() {
    let light = play("light_update", #"{"x": 5, "z": 5, "lightData": "l"}"#, "00")
    let commands = play("commands", #"{"entries": 3}"#, "00")
    let vanilla: List<String> = [step("join"), block(1, "stone"), section(2, "[1, 2]"), commands.copy(), block(3, "dirt"), block(4, "snow"), light.copy()]
    let calcite: List<String> = [step("join"), block(3, "dirt"), section(2, "[1, 2]"), commands.copy(), block(1, "stone"), block(4, "air"), block(6, "air")]
    let report = compare(vanilla, calcite, "")
    var got: List<String> = []
    for f in report.findings {
        got.push(with_detail(f))
    }
    got.sort()
    // Those in another order match; the one at x 4 differs; the light update and the block at 6
    // are each side's own.
    let want: List<String> = [
        #"session:join/join/block_update | differs | .blockState: "snow" vs "air""#,
        #"session:join/join/block_update | only Calcite sends it | at {"x": 6, "y": 0, "z": 0}"#,
        #"session:join/join/light_update | only vanilla sends it | at {"x": 5, "z": 5}"#,
    ]
    assert(got == want, "{got}")
    let play_tally = report.counts.get(String("play")) ?? panic("no play suite")
    assert(play_tally.matched == 4 and play_tally.differed == 3, "{play_tally.matched} {play_tally.differed}")
}

fn event(x: i64, b0: i64) -> String {
    return play("block_event", #"{"pos": {"@": "BlockPos", "x": #{x}, "y": 0, "z": 0}, "b0": #{b0}, "b1": 5}"#, "e{x}{b0}")
}

fn sound(x: i64, seed: i64) -> String {
    return play("sound", ##"{"sound": "#minecraft:block.piston.extend", "x": ##{x * 8 + 4}, "y": 4, "z": 4, "pitch": 0.7, "seed": ##{seed}}"##, "s{x}{seed}")
}

@test
fn block_events_line_up_by_place() {
    // Calcite has lost the first piston's first pair: lined up by kind alone, every pair after
    // would be the other piston's. The seeds are drawn, so they don't count.
    let vanilla: List<String> = [step("join"), sound(1, 7), event(1, 0), sound(2, 8), event(2, 0), sound(1, 9), event(1, 1), sound(2, 3), event(2, 1)]
    let calcite: List<String> = [step("join"), sound(2, 1), event(2, 0), sound(1, 2), event(1, 1), sound(2, 4), event(2, 1)]
    let report = compare(vanilla, calcite, "")
    assert(found(report) == ["session:join/join/block_event | only vanilla sends it", "session:join/join/sound | only vanilla sends it"], "{found(report)}")
    assert((report.counts.get(String("play")) ?? panic("no play suite")).matched == 6)
}

@test
fn scenarios_by_configuration() {
    let root = temp_dir()!
    let status = packet("status", "status_response", #"{"v": 1}"#, "00")
    for (config, scenario) in [("a", "join"), ("b", "status")] {
        for side in ["vanilla", "calcite"] {
            write_side(root.copy(), config, side, scenario, [status.copy()])
        }
    }
    let differences = path.join(root.copy(), "differences")
    make_dir_all(differences.copy())!
    var scenarios = LinkedMap<String, List<String>>()
    scenarios.insert(String("a"), [String("join")])
    scenarios.insert(String("b"), [String("status")])
    let report = run(root.copy(), ["a", "b"], scenarios, differences, 3, false)
    remove_dir_all(root)!
    assert(report.passed)
    assert((report.counts.get(String("status")) ?? panic("no status suite")).matched == 1)
}

fn letters(s: str) -> List<String> {
    var out: List<String> = []
    for i in 0..s.len() {
        out.push(String(s[i..i + 1]))
    }
    return out
}

@test
fn lined_up_as_difflib_does() {
    // The example in difflib's documentation of `get_opcodes`.
    var got: List<String> = []
    for op in opcodes(letters("qabxcd"), letters("abycdf")) {
        got.push("{op.tag} {op.i1} {op.i2} {op.j1} {op.j2}")
    }
    assert(got == ["delete 0 1 0 0", "equal 1 3 0 2", "replace 3 4 2 3", "equal 4 6 3 5", "insert 6 6 5 6"], "{got}")
    // The longest block first, `ab`, the earliest in `a` of the two as long, then the same on each
    // side of it, which needn't be the fewest changes: Myers' way keeps `c`, `b`, `a` and `b`.
    var runs: List<String> = []
    for op in opcodes(letters("abcabba"), letters("cbabac")) {
        runs.push("{op.tag} {op.i1} {op.i2} {op.j1} {op.j2}")
    }
    assert(runs == ["insert 0 0 0 2", "equal 0 2 2 4", "insert 2 2 4 5", "equal 2 3 5 6", "delete 3 7 6 6"], "{runs}")
    assert(opcodes(letters(""), letters("")).is_empty())
    var only_b: List<String> = []
    for op in opcodes(letters(""), letters("ab")) {
        only_b.push("{op.tag} {op.i1} {op.i2} {op.j1} {op.j2}")
    }
    assert(only_b == ["insert 0 0 0 2"], "{only_b}")
}
