module rig.runner.store

// What the rig keeps: expected hashes and quarantine (committed), goldens (gitignored).

import std.bytes
import std.fs.{is_file, make_dir_all, read_text, rename, write_text}
import std.json
import std.json.{Json}
import std.path
import rig.runner.protocol.{Result, text_member}
import tools.pyjson.{indented, spaced}
import tools.repo.{die}

pub const REFERENCE_CONFIG: str = "strict-math"

/// The files for one game version and one vanilla configuration (D60).
///
/// The reference configuration lives at expected/<version>/; any other in a subfolder named for
/// it, such as expected/<version>/intrinsics/. Quarantine is shared by all of them.
pub struct Store {
    pub root: String
    pub version: String
    pub config: String
    pub quarantine_path: String
    pub expected_dir: String
    pub golden_dir: String
}

pub fn store(root: String, version: String, config: String) -> Store {
    let sub = if config == REFERENCE_CONFIG { String("") } else { "/{config}" }
    return Store {
        root: root.copy(),
        version: version.copy(),
        config: config.copy(),
        quarantine_path: path.join(root, "expected/{version}/quarantine.json"),
        expected_dir: path.join(root, "expected/{version}{sub}"),
        golden_dir: path.join(root, "golden/{version}{sub}"),
    }
}

/// The JSON in a file, or none if there's no file. A file that isn't JSON ends the program.
fn load(file: String) -> Json? {
    if not is_file(file) {
        return none
    }
    let text = match read_text(file) {
        ok(some(t)) => t,
        ok(none) => die("rig: {file} isn't UTF-8"),
        err(e) => die("rig: reading {file}: {e}"),
    }
    return match json.parse(text) {
        ok(v) => some(v),
        err(e) => die("rig: {file}: {e}"),
    }
}

/// An object's member `key` as a map of text to text.
fn texts(v: Json, key: str, file: String) -> LinkedMap<String, String> {
    var out = LinkedMap<String, String>()
    let Json.Object(m) = v.get(String(key)) ?? Json.Null else {
        die("rig: {file} has no `{key}` object")
    }
    for (k, x) in m {
        if let Json.Str(s) = x {
            out.insert(k.copy(), s.copy())
        }
    }
    return out
}

/// Writes a file through a `.tmp` beside it, as `json.dumps(data, indent=2, ensure_ascii=False)`
/// and a line break.
fn write_json(file: String, data: Json) {
    if let dir = path.parent_dir(file) {
        if let err(e) = make_dir_all(dir) {
            die("rig: making {dir}: {e}")
        }
    }
    let tmp = "{file}.tmp"
    if let err(e) = write_text(tmp.copy(), "{indented(data, false)}\n") {
        die("rig: writing {tmp}: {e}")
    }
    if let err(e) = rename(tmp, file.copy()) {
        die("rig: writing {file}: {e}")
    }
}

/// A map of text to text, sorted by key, as an object.
fn sorted_object(m: LinkedMap<String, String>) -> Json {
    var keys: List<String> = []
    for (k, _) in m {
        keys.push(k.copy())
    }
    keys.sort()
    var out = LinkedMap<String, Json>()
    for k in keys {
        out.insert(k.copy(), Json.Str(m[k].copy()))
    }
    return Json.Object(out)
}

// Expected hashes: expected/<version>/<probe>.json

/// {case id: hash} for a probe, or {} if it was never recorded.
pub fn expected(s: Store, probe: String) -> LinkedMap<String, String> {
    let file = path.join(s.expected_dir, "{probe}.json")
    if let v = load(file.copy()) {
        return texts(v, "hashes", file)
    }
    return LinkedMap<String, String>()
}

pub fn save_expected(s: Store, probe: String, probe_version: i64, about: Json, hashes: LinkedMap<String, String>) {
    var data = LinkedMap<String, Json>()
    data.insert("probe", Json.Str(probe.copy()))
    data.insert("probe_version", Json.Int(probe_version))
    data.insert("game_version", Json.Str(s.version.copy()))
    data.insert("config", Json.Str(s.config.copy()))
    data.insert("recorded_with", about.copy())
    data.insert("hashes", sorted_object(hashes))
    write_json(path.join(s.expected_dir, "{probe}.json"), Json.Object(data))
}

// Quarantine: expected/<version>/quarantine.json, {"probe:case": reason}

pub fn quarantine(s: Store) -> LinkedMap<String, String> {
    if let v = load(s.quarantine_path.copy()) {
        return texts(v, "cases", s.quarantine_path.copy())
    }
    return LinkedMap<String, String>()
}

pub fn save_quarantine(s: Store, cases: LinkedMap<String, String>) {
    var data = LinkedMap<String, Json>()
    data.insert("about", Json.Str("Cases where vanilla itself isn't repeatable, found by the self-check. They aren't scored."))
    data.insert("cases", sorted_object(cases))
    write_json(s.quarantine_path.copy(), Json.Object(data))
}

// Goldens: golden/<version>/<probe>.jsonl, one full result per line

/// A golden: vanilla's full result for a case.
pub struct Golden {
    pub status: String
    pub hash: String
    pub output: Json
    pub blobs: List<List<u8>>
}

pub fn save_golden(s: Store, probe: String, records: List<(String, Result)>) {
    if let err(e) = make_dir_all(s.golden_dir.copy()) {
        die("rig: making {s.golden_dir}: {e}")
    }
    var text = String()
    for (case_id, result) in records {
        var blobs: List<Json> = []
        for b in result.blobs {
            blobs.push(Json.Str(bytes.base64(b)))
        }
        var line = LinkedMap<String, Json>()
        line.insert("id", Json.Str(case_id.copy()))
        line.insert("status", Json.Str(result.status.copy()))
        line.insert("hash", Json.Str(result.digest()))
        line.insert("output", result.output.copy())
        line.insert("blobs", Json.Array(blobs))
        text.push_str(spaced(Json.Object(line)))
        text.push_str("\n")
    }
    let file = path.join(s.golden_dir, "{probe}.jsonl")
    if let err(e) = write_text(file.copy(), text) {
        die("rig: writing {file}: {e}")
    }
}

pub fn golden(s: Store, probe: String, case_id: String) -> Golden? {
    let file = path.join(s.golden_dir, "{probe}.jsonl")
    if not is_file(file) {
        return none
    }
    let text = match read_text(file.copy()) {
        ok(some(t)) => t,
        _ => die("rig: reading {file}"),
    }
    for line in text.lines() {
        let record = match json.parse(line) {
            ok(v) => v,
            err(e) => die("rig: {file}: {e}"),
        }
        if record.get("id") != some(Json.Str(case_id.copy())) {
            continue
        }
        var blobs: List<List<u8>> = []
        if let Json.Array(xs) = record.get("blobs") ?? Json.Null {
            for x in xs {
                let decoded = bytes.from_base64(x.as_str() ?? String("")) else {
                    die("rig: {file}: a blob of `{case_id}` isn't base64")
                }
                blobs.push(decoded)
            }
        }
        let status = text_member(record, "status", "")
        let hash = text_member(record, "hash", "")
        return some(Golden { status: status, hash: hash, output: record.get("output") ?? Json.Null, blobs: blobs })
    }
    return none
}
