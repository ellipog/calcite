module rig.runner.differences

// The registry of deliberate differences (rig/differences/, P1.8).

import std.fs.{glob, read_text}
import std.path
import std.text.python.{repr_str}

const KINDS: [str; 6] = ["bug", "exploit", "feature", "identity", "performance", "platform"]

pub struct Difference {
    pub id: String
    pub title: String
    pub kind: String
    pub cases: List<String>
    pub path: String
}

impl Difference {
    /// Whether this difference covers a case key, `probe:case-id`. Patterns are globs, matched as
    /// Python's `fnmatch.fnmatchcase` matches them.
    pub fn covers(self, key: String) -> bool {
        return self.cases.any(|pattern| fnmatch(key, pattern))
    }
}

/// Whether `name` matches `pattern` as `fnmatch.fnmatchcase` has it: `*` is any run of
/// characters, `/` too, `?` any one, `[abc]`, `[a-z]` and `[!abc]` one of a set or not, and a `[`
/// with no `]` after it itself. It goes by bytes, which is the same for the ASCII keys are.
pub fn fnmatch(name: String, pattern: String) -> bool {
    let n = name.to_bytes()
    let p = pattern.to_bytes()
    var pi = 0usize
    var ni = 0usize
    // Where the last `*` was, and the name's place it has taken up to, to go back to when the
    // rest fails.
    var star: usize? = none
    var star_n = 0usize
    while ni < n.len() {
        if pi < p.len() {
            let c = p[pi]
            if c == 42 {
                star = some(pi)
                star_n = ni
                pi += 1
                continue
            }
            if c == 63 {
                pi += 1
                ni += 1
                continue
            }
            if c == 91 {
                if let (matched, after) = set_at(p, pi, n[ni]) {
                    if matched {
                        pi = after
                        ni += 1
                        continue
                    }
                } else if n[ni] == 91 {
                    pi += 1
                    ni += 1
                    continue
                }
            } else if c == n[ni] {
                pi += 1
                ni += 1
                continue
            }
        }
        let s = star else {
            return false
        }
        pi = s + 1
        star_n += 1
        ni = star_n
    }
    while pi < p.len() and p[pi] == 42 {
        pi += 1
    }
    return pi == p.len()
}

/// The set that starts at `p[at]`, a `[`: whether `b` is in it and where the pattern goes on
/// after it, or none if there's no `]` to close it, when the `[` is itself.
fn set_at(p: List<u8>, at: usize, b: u8) -> (bool, usize)? {
    var i = at + 1
    var negate = false
    if i < p.len() and p[i] == 33 {
        negate = true
        i += 1
    }
    // A `]` first is one of the set, not its end.
    let first = i
    var found = false
    while i < p.len() {
        if p[i] == 93 and i > first {
            return some((found != negate, i + 1))
        }
        if i + 2 < p.len() and p[i + 1] == 45 and p[i + 2] != 93 {
            if p[i] <= b and b <= p[i + 2] {
                found = true
            }
            i += 3
            continue
        }
        if p[i] == b {
            found = true
        }
        i += 1
    }
    return none
}

/// A front matter field: a value, or a list of `- item` lines.
enum Field {
    Text(String)
    Items(List<String>)
}

/// Python's `s.strip("\"'")`.
fn strip_quotes(s: String) -> String {
    var a = 0usize
    var b = s.len()
    while a < b and (s.byte_at(a) == 34 or s.byte_at(a) == 39) {
        a += 1
    }
    while b > a and (s.byte_at(b - 1) == 34 or s.byte_at(b - 1) == 39) {
        b -= 1
    }
    return s[a..b]
}

/// A copy of the list field `key`, or none if it's a value or isn't there.
fn items_of(fields: LinkedMap<String, Field>, key: String) -> List<String>? {
    if let found = fields.find(key) {
        if let Field.Items(xs) = found {
            return some(xs.copy())
        }
    }
    return none
}

/// The YAML subset the registry uses: `key: value` lines and `- item` lists.
fn front_matter(text: String, file: String) -> LinkedMap<String, Field> ! String {
    let lines = text.lines()
    if lines.is_empty() or lines[0].trim() != "---" {
        fail "{file}: no front matter"
    }
    var fields = LinkedMap<String, Field>()
    var key = String("")
    for line in lines[1..] {
        if line.trim() == "---" {
            return fields
        }
        let start = line.trim_start()
        if line.trim().is_empty() or start.starts_with("#") {
            continue
        }
        if start.starts_with("- ") {
            let item = strip_quotes(start[2..].trim())
            var items = items_of(fields, key) else {
                fail "{file}: list item outside a list: {repr_str(line)}"
            }
            items.push(item)
            fields.insert(key.copy(), Field.Items(items))
            continue
        }
        let colon = line.find(":") else {
            fail "{file}: can't read {repr_str(line)}"
        }
        key = line[..colon].trim()
        let value = line[colon + 1..].trim()
        if value.is_empty() {
            fields.insert(key.copy(), Field.Items([]))
        } else {
            fields.insert(key.copy(), Field.Text(strip_quotes(value)))
        }
    }
    fail "{file}: front matter isn't closed"
}

/// Every difference in the folder, by file name, but its README.
pub fn load(directory: String) -> List<Difference> ! String {
    var out: List<Difference> = []
    let files = match glob(path.join(directory, "*.md")) {
        ok(found) => found,
        err(e) => fail "{directory}: {e}",
    }
    for file in files {
        let name = path.file_name(file) ?? String("")
        if name.to_lower_root() == "readme.md" {
            continue
        }
        let text = match read_text(file.copy()) {
            ok(some(t)) => t,
            ok(none) => fail "{file}: isn't UTF-8",
            err(e) => fail "{file}: {e}",
        }
        let fields = try front_matter(text, file.copy())
        for required in ["title", "kind", "cases"] {
            if not fields.contains(String(required)) {
                fail "{file}: missing `{required}`"
            }
        }
        let kind = match fields["kind"] {
            Field.Text(k) => k.copy(),
            Field.Items(_) => String(""),
        }
        if not KINDS.any(|k| k == kind) {
            fail "{file}: kind must be one of {KINDS.join(", ")}"
        }
        let cases = match fields["cases"] {
            Field.Items(items) => items.copy(),
            Field.Text(_) => [],
        }
        if cases.is_empty() {
            fail "{file}: `cases` must be a non-empty list"
        }
        let title = match fields["title"] {
            Field.Text(t) => t.copy(),
            Field.Items(_) => String(""),
        }
        out.push(Difference { id: path.file_stem(file) ?? String(""), title: title, kind: kind, cases: cases, path: file.copy() })
    }
    return out
}
