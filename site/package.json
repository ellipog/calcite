		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.4",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.5",
		"tailwindcss": "4.3.4",
		"typescript": "5.9.3"
	}
}
