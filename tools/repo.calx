module tools.repo

// What Calcite's tools share: where the repository is, which system they run on, and how a tool
// stops with a message (CAL-253). The tools are Calx programs whose `module` lines start at the
// repository's root, so any of them can import any other's module.

import std.env.{os, script, variable}
import std.fs.{current_dir, is_file}
import std.path
import std.process.{exit, which}

/// The repository's root: the nearest folder above the running script that holds
/// oracle/versions.json, or the current folder if the script isn't in one.
pub fn root() -> String {
    let here = match current_dir() {
        ok(d) => d,
        err(_) => String("."),
    }
    var dir = script() ?? here.copy()
    while let up = path.parent_dir(dir) {
        if up == dir {
            break
        }
        if is_file(path.join(up, "oracle/versions.json")) {
            return up
        }
        dir = up
    }
    return here
}

/// A path under the repository's root, from parts written with `/`, made whole and written with
/// `/` on every system, which Windows' programs read too.
pub fn under(rel: String) -> String {
    return path.normalize(path.join(root(), rel))
}

/// The path with the system's own separator: `\` on Windows, for what reads a path by its own
/// rules, as log4j reads `C:/x` as a URL with the protocol `c:`, and `C:\x` as a file.
pub fn native(p: String) -> String {
    return if os() == "windows" { p.replace("/", "\\") } else { p.copy() }
}

/// The system, as the tools name their build folders: `windows`, `linux` or `macos`.
pub fn platform() -> String {
    return os()
}

/// What a program's file ends with on this system: `.exe` on Windows, nothing elsewhere.
pub fn exe() -> String {
    return if os() == "windows" { ".exe" } else { "" }
}

/// Prints `message` to standard error and ends the program with status 1, as Python's
/// `sys.exit(message)` does.
pub fn die(message: String) -> never {
    eprintln(message)
    exit(1)
}

/// The calx to build Calcite with: the CALX environment variable, then calx on PATH, then a calx
/// checkout beside the repository (../calx), as the workspace has it.
pub fn find_calx() -> String {
    if let given = variable("CALX") {
        if not given.is_empty() {
            return given
        }
    }
    if let found = which("calx") {
        return found
    }
    let parent = path.parent_dir(root()) ?? String("..")
    let beside = path.join(parent, "calx/build/compiler/{platform()}/calx{exe()}")
    if is_file(beside) {
        return beside
    }
    die("no calx. Set CALX, put calx on PATH, or build ../calx")
}
