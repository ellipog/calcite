module tools.difflib

// The runs that turn one list of strings into another as Python's
// `difflib.SequenceMatcher(a=a, b=b, autojunk=False).get_opcodes()` finds them (CAL-253): the
// Ratcliff and Obershelp way, the longest block the two have in common first, then the same on
// each side of it. `std.diff` finds the fewest changes, Myers' way, which isn't always these, and
// the rig's session comparison reports what lines up as difflib lined it up.

/// One run: `equal`, `replace`, `delete` or `insert`, of `a[i1..i2]` and `b[j1..j2]`.
pub struct Opcode {
    pub tag: String
    pub i1: usize
    pub i2: usize
    pub j1: usize
    pub j2: usize
}

/// A block the two have in common: `a[i..i + size]` is `b[j..j + size]`.
struct Block {
    i: usize
    j: usize
    size: usize
}

/// The longest block in `a[alo..ahi]` and `b[blo..bhi]`, the one that starts first in `a` of
/// those as long, then first in `b`.
fn longest(a: List<String>, b: List<String>, b2j: Map<String, List<usize>>, alo: usize, ahi: usize, blo: usize, bhi: usize) -> Block {
    var besti = alo
    var bestj = blo
    var bestsize = 0usize
    // How long the block ending at each `j` is, for the `i` before.
    var j2len = Map<usize, usize>()
    for i in alo..ahi {
        var next = Map<usize, usize>()
        if let js = b2j.find(a[i]) {
            for j in js {
                if j < blo {
                    continue
                }
                if j >= bhi {
                    break
                }
                let before = if j > 0 { j2len.get(j - 1) ?? 0 } else { 0 }
                let k = before + 1
                next.insert(j, k)
                if k > bestsize {
                    besti = i + 1 - k
                    bestj = j + 1 - k
                    bestsize = k
                }
            }
        }
        j2len = next
    }
    while besti > alo and bestj > blo and a[besti - 1] == b[bestj - 1] {
        besti -= 1
        bestj -= 1
        bestsize += 1
    }
    while besti + bestsize < ahi and bestj + bestsize < bhi and a[besti + bestsize] == b[bestj + bestsize] {
        bestsize += 1
    }
    return Block { i: besti, j: bestj, size: bestsize }
}

/// The blocks the two have in common, in order, those that touch joined, then an empty one at
/// both ends.
fn matching_blocks(a: List<String>, b: List<String>) -> List<Block> {
    var b2j = Map<String, List<usize>>()
    for (j, x) in b.enumerate() {
        if let js = mut b2j.find(x) {
            js.push(j)
        } else {
            b2j.insert(x.copy(), [j])
        }
    }
    var found: List<Block> = []
    var queue: List<(usize, usize, usize, usize)> = [(0, a.len(), 0, b.len())]
    while let (alo, ahi, blo, bhi) = queue.pop() {
        let m = longest(a, b, b2j, alo, ahi, blo, bhi)
        if m.size > 0 {
            if alo < m.i and blo < m.j {
                queue.push((alo, m.i, blo, m.j))
            }
            if m.i + m.size < ahi and m.j + m.size < bhi {
                queue.push((m.i + m.size, ahi, m.j + m.size, bhi))
            }
            found.push(m)
        }
    }
    // In order of where they start in `a`, which no two share.
    for k in 1..found.len() {
        var at = k
        while at > 0 and found[at - 1].i > found[at].i {
            found.swap(at - 1, at)
            at -= 1
        }
    }
    var out: List<Block> = []
    var i1 = 0usize
    var j1 = 0usize
    var k1 = 0usize
    for m in found {
        if i1 + k1 == m.i and j1 + k1 == m.j {
            k1 += m.size
        } else {
            if k1 > 0 {
                out.push(Block { i: i1, j: j1, size: k1 })
            }
            i1 = m.i
            j1 = m.j
            k1 = m.size
        }
    }
    if k1 > 0 {
        out.push(Block { i: i1, j: j1, size: k1 })
    }
    out.push(Block { i: a.len(), j: b.len(), size: 0 })
    return out
}

/// The runs that turn `a` into `b`, as `get_opcodes` gives them.
pub fn opcodes(a: List<String>, b: List<String>) -> List<Opcode> {
    var out: List<Opcode> = []
    var i = 0usize
    var j = 0usize
    for m in matching_blocks(a, b) {
        var tag = ""
        if i < m.i and j < m.j {
            tag = "replace"
        } else if i < m.i {
            tag = "delete"
        } else if j < m.j {
            tag = "insert"
        }
        if not tag.is_empty() {
            out.push(Opcode { tag: String(tag), i1: i, i2: m.i, j1: j, j2: m.j })
        }
        i = m.i + m.size
        j = m.j + m.size
        if m.size > 0 {
            out.push(Opcode { tag: String("equal"), i1: m.i, i2: i, j1: m.j, j2: j })
        }
    }
    return out
}
