module tools.pyjson

// std.json values written as Python's `json.dumps` writes them (CAL-253): a float as Python's
// `repr`, `1e-07` and `100.0`, where std.json writes the shortest digits its own way; a string with
// `ensure_ascii=False`; and the separators, key order and indent each tool's Python gave. The rig's
// result hashes are over this text, and the files the rig commits are written in it, so the Calx
// tools give the bytes the Python did.

import std.json.{Json}
import std.text.python.{repr_float_into, repr_str_into}
import tools.rawjson.{write_string}

/// How `json.dumps` was told to write: with `sort_keys`, an `indent` (none for one line), its
/// separators between items and after a key, and with `ensure_ascii` or not.
pub struct Style {
    sort: bool
    indent: usize?
    item: str
    key: str
    ascii: bool
}

/// `json.dumps(v, ensure_ascii=False, separators=(",", ":"))`.
pub fn compact(v: Json) -> String {
    return dumps(v, Style { sort: false, indent: none, item: ",", key: ":", ascii: false })
}

/// `json.dumps(v, ensure_ascii=False)`: `, ` and `: ` between.
pub fn spaced(v: Json) -> String {
    return dumps(v, Style { sort: false, indent: none, item: ", ", key: ": ", ascii: false })
}

/// `json.dumps(v)`, as it writes with no arguments: `, ` and `: ` between, and every character
/// past ASCII escaped, those past the BMP as their surrogate pair.
pub fn spaced_ascii(v: Json) -> String {
    return dumps(v, Style { sort: false, indent: none, item: ", ", key: ": ", ascii: true })
}

/// `json.dumps(v, sort_keys=True)`: as `spaced_ascii`, with each object's keys in order.
pub fn sorted_ascii(v: Json) -> String {
    return dumps(v, Style { sort: true, indent: none, item: ", ", key: ": ", ascii: true })
}

/// `json.dumps(v, indent=2, ensure_ascii=False)`, with `sort_keys` if `sort`.
pub fn indented(v: Json, sort: bool) -> String {
    return dumps(v, Style { sort: sort, indent: some(2), item: ",", key: ": ", ascii: false })
}

/// The rig's canonical JSON (rig/PROTOCOL.md, "Results and hashes"): `json.dumps(v,
/// sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False)`. Fails on a NaN or
/// an infinity, as `allow_nan=False` does.
pub fn canonical(v: Json) -> String ! String {
    if not finite(v) {
        fail "Out of range float values are not JSON compliant"
    }
    return dumps(v, Style { sort: true, indent: none, item: ",", key: ":", ascii: false })
}

/// Python's `repr` of what `json.loads` makes of `v`: `{'a': [1, None, True], 'b': 1.5}`, as
/// the tools' messages quote a value.
pub fn py_repr(v: Json) -> String {
    var out = String()
    write_repr(mut out, v)
    return out
}

/// Python's `str` of what `json.loads` makes of `v`, as an f-string writes it: a string as it is,
/// anything else as `py_repr` writes it.
pub fn py_str(v: Json) -> String {
    if let Json.Str(s) = v {
        return s.copy()
    }
    return py_repr(v)
}

fn write_repr(out: mut String, v: Json) {
    match v {
        Json.Null => out.push_str("None"),
        Json.Bool(b) => out.push_str(if b { "True" } else { "False" }),
        Json.Int(i) => out.push_str("{i}"),
        Json.UInt(u) => out.push_str("{u}"),
        Json.Big(digits) => out.push_str(digits),
        Json.Float(f) => repr_float_into(mut out, f),
        Json.Str(s) => repr_str_into(mut out, s),
        Json.Array(xs) => {
            out.push_str("[")
            for (i, x) in xs.enumerate() {
                if i > 0 {
                    out.push_str(", ")
                }
                write_repr(mut out, x)
            }
            out.push_str("]")
        }
        Json.Object(m) => {
            out.push_str("\{")
            var first = true
            for (k, x) in m {
                if not first {
                    out.push_str(", ")
                }
                first = false
                repr_str_into(mut out, k)
                out.push_str(": ")
                write_repr(mut out, x)
            }
            out.push_str("\}")
        }
    }
}

fn finite(v: Json) -> bool {
    return match v {
        Json.Float(f) => not f.is_nan() and not f.is_infinite(),
        Json.Array(xs) => xs.all(|x| finite(x)),
        Json.Object(m) => {
            for (_, x) in m {
                if not finite(x) {
                    return false
                }
            }
            true
        }
        _ => true,
    }
}

/// `v` as `json.dumps` writes it in `style`.
pub fn dumps(v: Json, style: Style) -> String {
    var out = String()
    write(mut out, v, style, 0)
    return out
}

/// A string as the style writes it.
fn text(out: mut String, s: String, style: Style) {
    if not style.ascii {
        write_string(mut out, s)
        return
    }
    // `ensure_ascii`: all but the printable ASCII escaped, as `py_encode_basestring_ascii` does.
    out.push_str("\"")
    for r in s.runes() {
        let c = u32(r)
        if c == 34 {
            out.push_str("\\\"")
        } else if c == 92 {
            out.push_str("\\\\")
        } else if c == 10 {
            out.push_str("\\n")
        } else if c == 13 {
            out.push_str("\\r")
        } else if c == 9 {
            out.push_str("\\t")
        } else if c == 8 {
            out.push_str("\\b")
        } else if c == 12 {
            out.push_str("\\f")
        } else if c >= 0x20 and c < 0x7F {
            out.push(r)
        } else if c < 0x10000 {
            out.push_str("\\u{c:04x}")
        } else {
            let v = c - 0x10000
            out.push_str("\\u{0xD800 + (v >> 10):04x}\\u{0xDC00 + (v & 0x3FF):04x}")
        }
    }
    out.push_str("\"")
}

fn newline(out: mut String, style: Style, level: usize) {
    if let n = style.indent {
        out.push_str("\n")
        for _ in 0..n * level {
            out.push_str(" ")
        }
    }
}

fn write(out: mut String, v: Json, style: Style, level: usize) {
    match v {
        Json.Null => out.push_str("null"),
        Json.Bool(b) => out.push_str(if b { "true" } else { "false" }),
        Json.Int(i) => out.push_str("{i}"),
        Json.UInt(u) => out.push_str("{u}"),
        Json.Big(digits) => out.push_str(digits),
        Json.Float(f) => {
            if f.is_nan() {
                out.push_str("NaN")
            } else if f.is_infinite() {
                out.push_str(if f > 0.0 { "Infinity" } else { "-Infinity" })
            } else {
                repr_float_into(mut out, f)
            }
        }
        Json.Str(s) => text(mut out, s, style),
        Json.Array(xs) => {
            if xs.is_empty() {
                out.push_str("[]")
                return
            }
            out.push_str("[")
            for (i, x) in xs.enumerate() {
                if i > 0 {
                    out.push_str(style.item)
                }
                newline(mut out, style, level + 1)
                write(mut out, x, style, level + 1)
            }
            newline(mut out, style, level)
            out.push_str("]")
        }
        Json.Object(m) => {
            if m.len() == 0 {
                out.push_str("\{\}")
                return
            }
            var keys: List<String> = []
            for (k, _) in m {
                keys.push(k.copy())
            }
            if style.sort {
                keys.sort()
            }
            out.push_str("\{")
            for (i, k) in keys.enumerate() {
                if i > 0 {
                    out.push_str(style.item)
                }
                newline(mut out, style, level + 1)
                text(mut out, k, style)
                out.push_str(style.key)
                if let x = m.find(k) {
                    write(mut out, x, style, level + 1)
                }
            }
            newline(mut out, style, level)
            out.push_str("\}")
        }
    }
}
