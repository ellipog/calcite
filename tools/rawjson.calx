module tools.rawjson

// JSON read with each number kept as the text it's written as and a key given twice in an object
// refused, as the data converter reads the data generator's reports, and written back in the
// converter's canonical layout (CAL-253). std.json reads a number into an `i64`, a `u64` or an
// `f64`, which loses the text of a float such as `1.8000001`, and keeps the last of a key given
// twice (CLX-328). The reports mix float and double text, and codegen reads each with the right
// precision, so the text must come through as it is.

/// A JSON value, its numbers as text.
pub enum Raw {
    Null
    Bool(bool)
    /// A number, as the text it's written as: `1.8000001`, `1e-7` and `-0.0` stay as they are.
    Num(String)
    Str(String)
    Array(List<Raw>)
    Object(LinkedMap<String, Raw>)
}

/// How deep arrays and objects may nest.
const MAX_DEPTH: usize = 512

// --- reading -------------------------------------------------------------------------------------

/// The JSON value in `text`, with nothing but white space around it, as RFC 8259 defines it: no
/// comments, no trailing commas, no `NaN`, and no key given twice in an object.
pub fn parse(text: String) -> Raw ! String {
    var at: usize = 0
    skip_space(text, mut at)
    let v = try parse_value(text, mut at, 0)
    skip_space(text, mut at)
    if at < text.len() {
        fail error_at(text, at, "{found(text, at)} after the value, where the text should end")
    }
    return v
}

// The error at byte `at` of `text`, with its line and column.
fn error_at(text: String, at: usize, message: String) -> String {
    var line: usize = 1
    var start: usize = 0
    for i in 0..at {
        if text.byte_at(i) == 10 {
            line += 1
            start = i + 1
        }
    }
    var column: usize = 1
    for i in start..at {
        if (text.byte_at(i) & 0xC0) != 0x80 {
            column += 1
        }
    }
    return "line {line}, column {column}: {message}"
}

// What's at byte `at`, for an error: the rune in backquotes, or the end.
fn found(text: String, at: usize) -> String {
    if at >= text.len() {
        return "the end"
    }
    let b = text.byte_at(at)
    let n: usize = if b < 0x80 { 1 } else if b < 0xE0 { 2 } else if b < 0xF0 { 3 } else { 4 }
    return "`{text[at..(at + n).min(text.len())]}`"
}

fn skip_space(text: String, at: mut usize) {
    while at < text.len() {
        let b = text.byte_at(at)
        if b != 32 and b != 10 and b != 13 and b != 9 {
            return
        }
        at += 1
    }
}

// Whether `w` is at byte `at`.
fn word(text: String, at: usize, w: String) -> bool {
    if at + w.len() > text.len() {
        return false
    }
    for i in 0..w.len() {
        if text.byte_at(at + i) != w.byte_at(i) {
            return false
        }
    }
    return true
}

fn parse_value(text: String, at: mut usize, depth: usize) -> Raw ! String {
    if at >= text.len() {
        fail error_at(text, at, "the end, where a value should be")
    }
    let b = text.byte_at(at)
    if b == 34 {
        return Raw.Str(try parse_string(text, mut at))
    }
    if b == 123 or b == 91 {
        if depth >= MAX_DEPTH {
            fail error_at(text, at, "arrays and objects nested more than {MAX_DEPTH} deep")
        }
        if b == 123 {
            return Raw.Object(try parse_object(text, mut at, depth + 1))
        }
        return Raw.Array(try parse_array(text, mut at, depth + 1))
    }
    if b == 45 or (b >= 48 and b <= 57) {
        return Raw.Num(try parse_number(text, mut at))
    }
    if word(text, at, "true") {
        at += 4
        return Raw.Bool(true)
    }
    if word(text, at, "false") {
        at += 5
        return Raw.Bool(false)
    }
    if word(text, at, "null") {
        at += 4
        return Raw.Null
    }
    fail error_at(text, at, "{found(text, at)} where a value should be")
}

fn parse_array(text: String, at: mut usize, depth: usize) -> List<Raw> ! String {
    at += 1
    var items = List<Raw>()
    skip_space(text, mut at)
    if at < text.len() and text.byte_at(at) == 93 {
        at += 1
        return items
    }
    loop {
        items.push(try parse_value(text, mut at, depth))
        skip_space(text, mut at)
        if at < text.len() {
            let b = text.byte_at(at)
            if b == 44 {
                at += 1
                skip_space(text, mut at)
                continue
            }
            if b == 93 {
                at += 1
                return items
            }
        }
        fail error_at(text, at, "{found(text, at)} in an array, where `,` or `]` should be")
    }
}

fn parse_object(text: String, at: mut usize, depth: usize) -> LinkedMap<String, Raw> ! String {
    at += 1
    var pairs = LinkedMap<String, Raw>()
    skip_space(text, mut at)
    if at < text.len() and text.byte_at(at) == 125 {
        at += 1
        return pairs
    }
    loop {
        if at >= text.len() or text.byte_at(at) != 34 {
            fail error_at(text, at, "{found(text, at)} in an object, where a key in double quotes should be")
        }
        let key_at = at
        let key = try parse_string(text, mut at)
        if pairs.contains(key) {
            fail error_at(text, key_at, "duplicate key {python_repr(key)}")
        }
        skip_space(text, mut at)
        if at >= text.len() or text.byte_at(at) != 58 {
            fail error_at(text, at, "{found(text, at)} after a key, where `:` should be")
        }
        at += 1
        skip_space(text, mut at)
        let v = try parse_value(text, mut at, depth)
        pairs.insert(key, v)
        skip_space(text, mut at)
        if at < text.len() {
            let b = text.byte_at(at)
            if b == 44 {
                at += 1
                skip_space(text, mut at)
                continue
            }
            if b == 125 {
                at += 1
                return pairs
            }
        }
        fail error_at(text, at, "{found(text, at)} in an object, where `,` or `\}` should be")
    }
}

// A string, from its opening quote at `at`, with its escapes decoded.
fn parse_string(text: String, at: mut usize) -> String ! String {
    let open = at
    at += 1
    var start = at
    var out = String()
    loop {
        if at >= text.len() {
            fail error_at(text, open, "a string that doesn't end")
        }
        let b = text.byte_at(at)
        if b == 34 {
            out.push_str(text[start..at])
            at += 1
            return out
        }
        if b == 92 {
            out.push_str(text[start..at])
            try parse_escape(text, mut at, mut out)
            start = at
            continue
        }
        if b < 0x20 {
            fail error_at(text, at, "a control character in a string, which JSON writes as an escape")
        }
        at += 1
    }
}

// The escape at `at`, its `\` first, added to `out`.
fn parse_escape(text: String, at: mut usize, out: mut String) ! String {
    let slash = at
    at += 1
    if at >= text.len() {
        fail error_at(text, slash, "a string that doesn't end")
    }
    let e = text.byte_at(at)
    at += 1
    if e == 34 or e == 92 or e == 47 {
        out.push(rune(e))
    } else if e == 110 {
        out.push('\n')
    } else if e == 116 {
        out.push('\t')
    } else if e == 114 {
        out.push('\r')
    } else if e == 98 {
        out.push('\u{8}')
    } else if e == 102 {
        out.push('\u{c}')
    } else if e == 117 {
        var cp = try hex4(text, mut at, slash)
        if cp >= 0xD800 and cp < 0xDC00 {
            if not word(text, at, "\\u") {
                fail error_at(text, slash, "half a surrogate pair without its other half")
            }
            at += 2
            let low = try hex4(text, mut at, slash)
            if low < 0xDC00 or low >= 0xE000 {
                fail error_at(text, slash, "half a surrogate pair without its other half")
            }
            cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00)
        } else if cp >= 0xDC00 and cp < 0xE000 {
            fail error_at(text, slash, "half a surrogate pair without its other half")
        }
        out.push(rune.try_from(cp) ?? '\u{FFFD}')
    } else {
        fail error_at(text, slash, "{found(text, slash + 1)} after `\\` in a string, which isn't an escape")
    }
}

fn hex4(text: String, at: mut usize, slash: usize) -> u32 ! String {
    if at + 4 > text.len() {
        fail error_at(text, slash, "`\\u` without four hex digits after it")
    }
    var v: u32 = 0
    for i in 0..4usize {
        let b = u32(text.byte_at(at + i))
        let d = if b >= 48 and b <= 57 {
            b - 48
        } else if b >= 97 and b <= 102 {
            b - 87
        } else if b >= 65 and b <= 70 {
            b - 55
        } else {
            fail error_at(text, slash, "`\\u` without four hex digits after it")
        }
        v = v * 16 + d
    }
    at += 4
    return v
}

// A number's text, checked against JSON's grammar: `-`, digits without a leading zero, then a
// fraction and an exponent if there are.
fn parse_number(text: String, at: mut usize) -> String ! String {
    let start = at
    if text.byte_at(at) == 45 {
        at += 1
    }
    let digits = at
    skip_digits(text, mut at)
    if at == digits {
        fail error_at(text, start, "a number with no digits after its `-`")
    }
    if at - digits > 1 and text.byte_at(digits) == 48 {
        fail error_at(text, digits, "a number that starts with `0` and goes on, which JSON doesn't allow")
    }
    if at < text.len() and text.byte_at(at) == 46 {
        at += 1
        let frac = at
        skip_digits(text, mut at)
        if at == frac {
            fail error_at(text, start, "a number with no digits after its `.`")
        }
    }
    if at < text.len() and (text.byte_at(at) == 101 or text.byte_at(at) == 69) {
        at += 1
        if at < text.len() and (text.byte_at(at) == 43 or text.byte_at(at) == 45) {
            at += 1
        }
        let exp = at
        skip_digits(text, mut at)
        if at == exp {
            fail error_at(text, start, "a number with no digits in its exponent")
        }
    }
    return text[start..at].copy()
}

fn skip_digits(text: String, at: mut usize) {
    while at < text.len() and text.byte_at(at) >= 48 and text.byte_at(at) <= 57 {
        at += 1
    }
}

/// A string as Python's `repr` writes one without quotes or backslashes in it: in single quotes,
/// as the converter's messages name keys.
pub fn python_repr(s: String) -> String {
    return "'{s}'"
}

// --- reading values ------------------------------------------------------------------------------

/// What kind of value `v` is, for a message.
pub fn kind(v: Raw) -> String {
    return match v {
        Raw.Null => "null",
        Raw.Bool(_) => "a boolean",
        Raw.Num(_) => "a number",
        Raw.Str(_) => "a string",
        Raw.Array(_) => "an array",
        Raw.Object(_) => "an object",
    }
}

/// Member `key` of the object `v`, or none where it has none or isn't an object.
pub fn member(v: Raw, key: String) -> Raw? {
    if let Raw.Object(m) = v {
        if let hit = m.find(key) {
            return some(hit.copy())
        }
    }
    return none
}

/// Member `key` of the object `v`.
pub fn field(v: Raw, key: String) -> Raw ! String {
    if let hit = member(v, key) {
        return hit
    }
    fail "no {python_repr(key)} in {kind(v)}"
}

/// The members of the object `v`, in order.
pub fn members(v: Raw) -> LinkedMap<String, Raw> ! String {
    if let Raw.Object(m) = v {
        return m.copy()
    }
    fail "{kind(v)} where an object should be"
}

/// The elements of the array `v`.
pub fn elements(v: Raw) -> List<Raw> ! String {
    if let Raw.Array(xs) = v {
        return xs.copy()
    }
    fail "{kind(v)} where an array should be"
}

/// The string `v`.
pub fn text_of(v: Raw) -> String ! String {
    if let Raw.Str(s) = v {
        return s.copy()
    }
    fail "{kind(v)} where a string should be"
}

/// The strings of the array `v`.
pub fn texts_of(v: Raw) -> List<String> ! String {
    var out: List<String> = []
    for x in try elements(v) {
        out.push(try text_of(x))
    }
    return out
}

/// The integer `v`, as Python's `int` reads a number's text: one with a fraction or an exponent
/// isn't one.
pub fn int_of(v: Raw) -> i64 ! String {
    if let Raw.Num(t) = v {
        if let n = i64.parse(t) {
            return n
        }
        fail "{t} isn't an integer"
    }
    fail "{kind(v)} where an integer should be"
}

/// Whether `v` is true, as Python reads the value the converter read it as: a number is its text,
/// so any number is.
pub fn truthy(v: Raw) -> bool {
    return match v {
        Raw.Null => false,
        Raw.Bool(b) => b,
        Raw.Num(t) => not t.is_empty(),
        Raw.Str(s) => not s.is_empty(),
        Raw.Array(xs) => not xs.is_empty(),
        Raw.Object(m) => m.len() > 0,
    }
}

/// The integer `n` as a JSON number.
pub fn num(n: i64) -> Raw {
    return Raw.Num("{n}")
}

/// The strings as a JSON array.
pub fn strs(list: List<String>) -> Raw {
    var out: List<Raw> = []
    for s in list {
        out.push(Raw.Str(s.copy()))
    }
    return Raw.Array(out)
}

/// An object of the members, in the order given.
pub fn object(pairs: List<(String, Raw)>) -> Raw {
    var m = LinkedMap<String, Raw>()
    for (k, v) in pairs {
        m.insert(k.copy(), v.copy())
    }
    return Raw.Object(m)
}

// --- writing -------------------------------------------------------------------------------------

/// `v` in the converter's canonical layout, as its Python `dumps` wrote it: an object's keys
/// sorted, an array of scalars on one line, everything else indented two spaces a level, a string
/// as `json.dumps(s, ensure_ascii=False)` writes it, and a number as its text.
pub fn canonical(v: Raw) -> String {
    var out = String()
    write_canonical(mut out, v, 0)
    return out
}

fn pad(out: mut String, indent: usize) {
    for _ in 0..indent {
        out.push_str("  ")
    }
}

fn is_nested(v: Raw) -> bool {
    return match v {
        Raw.Array(_) => true,
        Raw.Object(_) => true,
        _ => false,
    }
}

fn write_canonical(out: mut String, v: Raw, indent: usize) {
    match v {
        Raw.Object(m) => {
            if m.len() == 0 {
                out.push_str("\{\}")
                return
            }
            var keys: List<String> = []
            for (k, _) in m {
                keys.push(k.copy())
            }
            keys.sort()
            out.push_str("\{\n")
            for (i, k) in keys.enumerate() {
                if i > 0 {
                    out.push_str(",\n")
                }
                pad(mut out, indent + 1)
                write_string(mut out, k)
                out.push_str(": ")
                if let x = m.find(k) {
                    write_canonical(mut out, x, indent + 1)
                }
            }
            out.push_str("\n")
            pad(mut out, indent)
            out.push_str("\}")
        }
        Raw.Array(xs) => {
            if xs.is_empty() {
                out.push_str("[]")
                return
            }
            if not xs.any(|x| is_nested(x)) {
                out.push_str("[")
                for (i, x) in xs.enumerate() {
                    if i > 0 {
                        out.push_str(", ")
                    }
                    write_canonical(mut out, x, indent + 1)
                }
                out.push_str("]")
                return
            }
            out.push_str("[\n")
            for (i, x) in xs.enumerate() {
                if i > 0 {
                    out.push_str(",\n")
                }
                pad(mut out, indent + 1)
                write_canonical(mut out, x, indent + 1)
            }
            out.push_str("\n")
            pad(mut out, indent)
            out.push_str("]")
        }
        Raw.Null => out.push_str("null"),
        Raw.Bool(b) => out.push_str(if b { "true" } else { "false" }),
        Raw.Num(t) => out.push_str(t),
        Raw.Str(s) => write_string(mut out, s),
    }
}

/// A string as Python's `json.dumps(s, ensure_ascii=False)` writes it: in double quotes, with `"`,
/// `\` and the control characters escaped, and everything else as itself.
pub fn write_string(out: mut String, s: String) {
    out.push_str("\"")
    var start: usize = 0
    for i in 0..s.len() {
        let b = s.byte_at(i)
        if b >= 0x20 and b != 34 and b != 92 {
            continue
        }
        out.push_str(s[start..i])
        start = i + 1
        if b == 34 {
            out.push_str("\\\"")
        } else if b == 92 {
            out.push_str("\\\\")
        } else if b == 10 {
            out.push_str("\\n")
        } else if b == 13 {
            out.push_str("\\r")
        } else if b == 9 {
            out.push_str("\\t")
        } else if b == 8 {
            out.push_str("\\b")
        } else if b == 12 {
            out.push_str("\\f")
        } else {
            out.push_str("\\u{u32(b):04x}")
        }
    }
    out.push_str(s[start..])
    out.push_str("\"")
}
