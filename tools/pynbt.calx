module tools.pynbt

// std.nbt tags compared and written as the rig's Python tools had them (CAL-253):
// rig/runner/nbt.py read a tag into Python's own values, a compound into a dict, a list or an
// array into a list, and a number into an `int` or a `float`, so `==` took a byte and an int of
// the same value as the same, as it did a float and a double, a list and an array, and two
// compounds in any order; and the tools' messages quote values with `repr`,
// `{'id': 'minecraft:chest', 'Items': [], 'x': 1}`.

import std.nbt.{Tag}
import std.text.python.{repr_float_into, repr_str_into}

/// The tag's number, if it's an integer of any kind.
fn integer(t: Tag) -> i64? {
    return match t {
        Tag.Byte(v) => some(i64(v)),
        Tag.Short(v) => some(i64(v)),
        Tag.Int(v) => some(i64(v)),
        Tag.Long(v) => some(v),
        _ => none,
    }
}

/// The tag's number, if it's a float or a double, as Python held either: an `f64`.
fn floating(t: Tag) -> f64? {
    return match t {
        Tag.Float(v) => some(f64(v)),
        Tag.Double(v) => some(v),
        _ => none,
    }
}

/// Whether a Python `int` and `float` are equal: exactly, so the float must be that whole number.
fn int_is_float(i: i64, f: f64) -> bool {
    return f.is_finite() and f.floor() == f and f >= -9.223372036854775808e18 and f < 9.223372036854775808e18 and i64.saturate(f) == i
}

/// A list's or an array's elements as tags, or none for anything else.
pub fn elements(t: Tag) -> List<Tag>? {
    return match t {
        Tag.List(xs) => some(xs.copy()),
        Tag.ByteArray(xs) => {
            var out: List<Tag> = []
            for x in xs {
                out.push(Tag.Byte(x))
            }
            some(out)
        }
        Tag.IntArray(xs) => {
            var out: List<Tag> = []
            for x in xs {
                out.push(Tag.Int(x))
            }
            some(out)
        }
        Tag.LongArray(xs) => {
            var out: List<Tag> = []
            for x in xs {
                out.push(Tag.Long(x))
            }
            some(out)
        }
        _ => none,
    }
}

/// Whether Python's `==` took the two as the same.
pub fn same(a: Tag, b: Tag) -> bool {
    if let i = integer(a) {
        if let j = integer(b) {
            return i == j
        }
        if let g = floating(b) {
            return int_is_float(i, g)
        }
        return false
    }
    if let f = floating(a) {
        if let g = floating(b) {
            return f == g
        }
        if let j = integer(b) {
            return int_is_float(j, f)
        }
        return false
    }
    // The arrays, the commonest case of all, without making tags of their numbers.
    if let Tag.ByteArray(xs) = a {
        if let Tag.ByteArray(ys) = b {
            return xs == ys
        }
    }
    if let Tag.IntArray(xs) = a {
        if let Tag.IntArray(ys) = b {
            return xs == ys
        }
    }
    if let Tag.LongArray(xs) = a {
        if let Tag.LongArray(ys) = b {
            return xs == ys
        }
    }
    match a {
        Tag.String(s) => {
            return match b {
                Tag.String(t) => s == t,
                _ => false,
            }
        }
        Tag.Compound(m) => {
            let Tag.Compound(n) = b else {
                return false
            }
            if m.len() != n.len() {
                return false
            }
            for (k, x) in m {
                let y = n.find(k) else {
                    return false
                }
                if not same(x, y) {
                    return false
                }
            }
            return true
        }
        Tag.End => {
            return match b {
                Tag.End => true,
                _ => false,
            }
        }
        _ => {}
    }
    let xs = elements(a) else {
        return false
    }
    let ys = elements(b) else {
        return false
    }
    if xs.len() != ys.len() {
        return false
    }
    for i in 0..xs.len() {
        if not same(xs[i], ys[i]) {
            return false
        }
    }
    return true
}

/// Whether Python's `==` took the two as the same, where none is Python's `None`.
pub fn same_or_none(a: Tag?, b: Tag?) -> bool {
    if let x = a {
        if let y = b {
            return same(x, y)
        }
        return false
    }
    return b == none
}

/// Python's `repr` of the value nbt.py read `t` as.
pub fn py_repr(t: Tag) -> String {
    var out = String()
    write_repr(mut out, t)
    return out
}

/// Python's `repr`, or `None`.
pub fn py_repr_or_none(t: Tag?) -> String {
    if let x = t {
        return py_repr(x)
    }
    return String("None")
}

/// Python's `str` of the value nbt.py read `t` as, as an f-string writes it: a string as it is,
/// anything else as `repr` writes it.
pub fn py_str(t: Tag) -> String {
    if let Tag.String(s) = t {
        return s.copy()
    }
    return py_repr(t)
}

/// Python's `str`, or `None`.
pub fn py_str_or_none(t: Tag?) -> String {
    if let x = t {
        return py_str(x)
    }
    return String("None")
}

fn write_numbers<T: Display>(out: mut String, xs: List<T>) {
    out.push_str("[")
    for (i, x) in xs.enumerate() {
        if i > 0 {
            out.push_str(", ")
        }
        out.push_str("{x}")
    }
    out.push_str("]")
}

fn write_repr(out: mut String, t: Tag) {
    match t {
        Tag.End => out.push_str("None"),
        Tag.Byte(v) => out.push_str("{v}"),
        Tag.Short(v) => out.push_str("{v}"),
        Tag.Int(v) => out.push_str("{v}"),
        Tag.Long(v) => out.push_str("{v}"),
        Tag.Float(v) => repr_float_into(mut out, f64(v)),
        Tag.Double(v) => repr_float_into(mut out, v),
        Tag.String(s) => repr_str_into(mut out, s),
        Tag.ByteArray(xs) => write_numbers(mut out, xs),
        Tag.IntArray(xs) => write_numbers(mut out, xs),
        Tag.LongArray(xs) => write_numbers(mut out, xs),
        Tag.List(xs) => {
            out.push_str("[")
            for (i, x) in xs.enumerate() {
                if i > 0 {
                    out.push_str(", ")
                }
                write_repr(mut out, x)
            }
            out.push_str("]")
        }
        Tag.Compound(m) => {
            out.push_str("\{")
            var first = true
            for (k, x) in m {
                if not first {
                    out.push_str(", ")
                }
                first = false
                repr_str_into(mut out, k)
                out.push_str(": ")
                write_repr(mut out, x)
            }
            out.push_str("\}")
        }
    }
}

/// Python's `repr` of a list of strings: `['a', 'b']`.
pub fn repr_strings(xs: List<String>) -> String {
    var out = String("[")
    for (i, x) in xs.enumerate() {
        if i > 0 {
            out.push_str(", ")
        }
        repr_str_into(mut out, x)
    }
    out.push_str("]")
    return out
}

/// The first `n` characters of `s`, as Python's `{x:.n}` keeps them.
pub fn cut(s: String, n: usize) -> String {
    var out = String()
    var count = 0usize
    for r in s.runes() {
        if count == n {
            break
        }
        out.push(r)
        count += 1
    }
    return out
}
