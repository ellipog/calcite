module tools.pyfmt

// Python's ways of writing a float that Calx's formats don't have (CAL-253): `format(x, "g")`
// and `float.hex()`, for the tools whose reports name values as their Python did.

/// `format(x, "g")`: six significant digits, in fixed notation from 1e-4 up to 1e6 and with a
/// signed exponent of two digits or more outside that, and no zeros after the last digit.
pub fn g(x: f64) -> String {
    if x.is_nan() {
        return String("nan")
    }
    if x.is_infinite() {
        return String(if x > 0.0 { "inf" } else { "-inf" })
    }
    if x == 0.0 {
        return String(if x.to_bits() >> 63 == 1 { "-0" } else { "0" })
    }
    // The exponent after rounding to six digits, as `%e` with five after the point gives it.
    let sci = "{x:.5e}"
    let at = sci.find("e") ?? sci.len()
    let exponent = i64.parse(sci[at + 1..]) ?? 0
    if exponent >= -4 and exponent < 6 {
        return strip_zeros(fixed(x, 5 - exponent))
    }
    let mantissa = strip_zeros(sci[..at])
    let sign = if exponent < 0 { "-" } else { "+" }
    let magnitude = exponent.abs()
    return "{mantissa}e{sign}{magnitude:02}"
}

/// `x` with `digits` after the point, 0 to 9, as a format's precision can't be a variable.
fn fixed(x: f64, digits: i64) -> String {
    return match digits {
        0 => "{x:.0}",
        1 => "{x:.1}",
        2 => "{x:.2}",
        3 => "{x:.3}",
        4 => "{x:.4}",
        5 => "{x:.5}",
        6 => "{x:.6}",
        7 => "{x:.7}",
        8 => "{x:.8}",
        _ => "{x:.9}",
    }
}

/// The text without the zeros after the point's last digit, nor the point if nothing's after it.
fn strip_zeros(s: own String) -> String {
    if not s.contains(".") {
        return s
    }
    var end = s.len()
    while end > 0 and s.byte_at(end - 1) == 48 {
        end -= 1
    }
    if end > 0 and s.byte_at(end - 1) == 46 {
        end -= 1
    }
    return s[..end]
}

/// `float.hex()`: `0x1.921fb54442d18p+1`, thirteen hex digits after the point, a subnormal as
/// `0x0.` and its digits with `p-1022`, zero as `0x0.0p+0`.
pub fn float_hex(x: f64) -> String {
    let bits = x.to_bits()
    let sign = if bits >> 63 == 1 { "-" } else { "" }
    let e = i64.wrap((bits >> 52) & 0x7FF)
    let m = bits & 0xFFFFFFFFFFFFF
    if e == 0x7FF {
        if m != 0 {
            return String("nan")
        }
        return "{sign}inf"
    }
    if e == 0 {
        if m == 0 {
            return "{sign}0x0.0p+0"
        }
        return "{sign}0x0.{m:013x}p-1022"
    }
    return "{sign}0x1.{m:013x}p{e - 1023:+}"
}
